[2026-01-29T23:29:10.077Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M483okjFC8X98kRZmqX37k","type":"tool_result","content":"     1→\"\"\"Financial analysis research template.\"\"\"\n     2→\n     3→from typing import List, Dict, Any, Optional\n     4→\n     5→from .base import BaseTemplate\n     6→from ..services.report_components import (\n     7→    ComponentType, ComponentConfig, ReportHints, get_report_hints\n     8→)\n     9→\n    10→\n    11→class FinancialTemplate(BaseTemplate):\n    12→    \"\"\"Template for financial and stock analysis research.\"\"\"\n    13→\n    14→    template_id = \"financial\"\n    15→    template_name = \"Financial Analysis\"\n    16→    description = \"Stock and financial analysis for investment research\"\n    17→\n    18→    # Report hints for component-based rendering\n    19→    report_hints = ReportHints(\n    20→        template_type=\"financial\",\n    21→        structure=\"quantitative_first\",\n    22→        findings_grouping=\"sentiment\",\n    23→        tone=\"analytical\",\n    24→        decision_format=\"thesis\",\n    25→        emphasis=[\"valuation\", \"risk_assessment\", \"financial_metrics\"],\n    26→        required_components=[\n    27→            ComponentType.INVESTMENT_THESIS,\n    28→            ComponentType.METRIC_CARDS,\n    29→            ComponentType.RISK_MATRIX,\n    30→        ],\n    31→        optional_components=[\n    32→            ComponentType.FINDINGS_TABLE,\n    33→            ComponentType.PREDICTION_CARDS,\n    34→            ComponentType.COMPARISON_TABLE,\n    35→            ComponentType.CONFIDENCE_GAUGE,\n    36→        ],\n    37→        visualization_preference=[\"financial_metrics\", \"risk_matrix\", \"peer_comparison\"],\n    38→        custom_sections={\n    39→            \"show_bull_bear_cases\": True,\n    40→            \"price_targets\": True,\n    41→            \"risk_factors_prominent\": True,\n    42→        }\n    43→    )\n    44→\n    45→    # Expert perspectives for deep financial analysis\n    46→    default_perspectives = [\n    47→        \"institutional_investor\",   # Long-term value creation, moats, management\n    48→        \"short_seller\",             # Red flags, fraud detection, skeptical analysis\n    49→        \"quantitative_risk\",        # Tail risks, stress testing, correlations\n    50→        \"activist_investor\",        # Value creation levers, governance, catalysts\n    51→        \"macro_strategist\",         # Economic cycles, policy risks, global context\n    52→    ]\n    53→\n    54→    default_max_searches = 8\n    55→\n    56→    # Financial analysis needs rigorous verification\n    57→    # Analysts have conflicts, numbers must be verified, projections questioned\n    58→    verification_config = {\n    59→        \"cross_reference\": \"thorough\",      # Verify financial numbers across sources\n    60→        \"bias_detection\": \"thorough\",       # Analyst conflicts, investment banking ties\n    61→        \"expert_sanity_check\": \"thorough\",  # Flag unrealistic valuations/projections\n    62→        \"source_quality\": \"standard\",       # SEC filings are reliable, analyst reports vary\n    63→    }\n    64→\n    65→    async def generate_search_queries(\n    66→        self,\n    67→        query: str,\n    68→        max_searches: int,\n    69→        granularity: str = \"standard\",\n    70→    ) -> List[str]:\n    71→        \"\"\"Generate financial analysis search queries.\"\"\"\n    72→        prompt = f\"\"\"\n    73→You are a financial analyst planning comprehensive research for investment analysis.\n    74→\n    75→Research Topic: {query}\n    76→\n    77→Depth Level: {granularity}\n    78→\n    79→Generate search queries covering these financial analysis angles:\n    80→\n    81→1. EARNINGS AND FUNDAMENTALS\n    82→   - Recent quarterly and annual earnings reports\n    83→   - Revenue trends, margins, profitability metrics\n    84→   - Earnings beats/misses, guidance changes\n    85→   - Balance sheet strength, cash flow analysis\n    86→\n    87→2. ANALYST COVERAGE\n    88→   - Wall Street analyst ratings and price targets\n    89→   - Buy/hold/sell recommendations\n    90→   - Earnings estimates and revisions\n    91→   - Recent analyst upgrades/downgrades\n    92→\n    93→3. MARKET POSITION\n    94→   - Competitive landscape and market share\n    95→   - Industry trends and tailwinds/headwinds\n    96→   - Customer concentration and diversification\n    97→   - Geographic revenue breakdown\n    98→\n    99→4. RISK FACTORS\n   100→   - Regulatory and compliance risks\n   101→   - Macro economic exposure\n   102→   - Supply chain dependencies\n   103→   - Legal and litigation issues\n   104→\n   105→5. VALUATION\n   106→   - Current valuation multiples (P/E, EV/EBITDA, P/S)\n   107→   - Historical valuation ranges\n   108→   - Peer comparison valuations\n   109→   - DCF and fair value estimates\n   110→\n   111→6. NEWS AND CATALYSTS\n   112→   - Recent company announcements\n   113→   - Product launches, partnerships, M&A\n   114→   - Management changes, insider transactions\n   115→   - Upcoming events (earnings, conferences)\n   116→\n   117→7. ECOSYSTEM ANALYSIS (Upstream/Downstream) - MANDATORY\n   118→   You MUST include at least 1-2 dedicated ecosystem queries:\n   119→   - Top customers: \"[COMPANY] top customers revenue concentration 2024 2025\"\n   120→   - Competitors: \"[COMPANY] vs [COMPETITOR] market share comparison\"\n   121→   - For AI/chip companies: \"[COMPANY] hyperscaler capex Microsoft Google Amazon spending\"\n   122→   - Supplier dependencies: \"[COMPANY] supply chain dependencies risks\"\n   123→\n   124→8. BEAR CASE RESEARCH\n   125→   - Include at least one query for contrarian/bearish analysis:\n   126→   - \"[COMPANY] short seller thesis bear case risks\"\n   127→   - \"[COMPANY] stock overvalued concerns\"\n   128→\n   129→For a \"{granularity}\" depth level:\n   130→- \"quick\": 4-5 searches on key fundamentals and analyst sentiment\n   131→- \"standard\": 8-10 searches covering all areas INCLUDING ecosystem and bear case\n   132→- \"deep\": 12+ searches with comprehensive coverage including technicals\n   133→\n   134→CRITICAL: You MUST include at least ONE ecosystem query and ONE bear case query regardless of depth level.\n   135→\n   136→Return a JSON array of exactly {max_searches} search query strings, ordered by importance.\n   137→Example: [\"NVIDIA Q4 2025 earnings analysis\", \"NVIDIA stock analyst ratings price target 2025\", \"NVIDIA top customers hyperscaler capex Microsoft Google Amazon\", \"NVIDIA bear case short seller thesis risks\", ...]\n   138→\"\"\"\n   139→\n   140→        result = await self._call_gemini_json(prompt)\n   141→\n   142→        if isinstance(result, list):\n   143→            return result[:max_searches]\n   144→        return []\n   145→\n   146→    async def extract_findings(\n   147→        self,\n   148→        query: str,\n   149→        sources: List[Dict[str, Any]],\n   150→        synthesized_content: str,\n   151→        granularity: str = \"standard\",\n   152→    ) -> List[Dict[str, Any]]:\n   153→        \"\"\"Extract financial findings with component-aligned types.\"\"\"\n   154→        # Build source context\n   155→        source_context = \"\\n\\n\".join([\n   156→            f\"Source: {s.get('title', 'Unknown')} ({s.get('url', '')})\\n\"\n   157→            f\"Credibility: {s.get('credibility_score', 'Unknown')}\\n\"\n   158→            f\"Domain: {s.get('domain', '')}\"\n   159→            for s in sources[:20]\n   160→        ])\n   161→\n   162→        prompt = f\"\"\"\n   163→You are a financial analyst extracting key findings for investment research.\n   164→CRITICAL: Use EXACT finding_type values specified below - they map to UI components.\n   165→\n   166→Research Topic: {query}\n   167→\n   168→Synthesized Research Content:\n   169→{synthesized_content[:15000]}\n   170→\n   171→Sources Referenced:\n   172→{source_context}\n   173→\n   174→=== USE ONLY THESE finding_type VALUES ===\n   175→\n   176→1. BULLISH SIGNALS (finding_type: \"bullish_signal\")\n   177→   - Positive earnings surprises, revenue beats, margin expansion\n   178→   - Analyst upgrades, price target increases\n   179→   - Growth acceleration, market share gains\n   180→   - Strong guidance, positive management commentary\n   181→\n   182→2. BEARISH SIGNALS (finding_type: \"bearish_signal\")\n   183→   - Earnings misses, revenue declines, margin compression\n   184→   - Analyst downgrades, price target cuts\n   185→   - Growth deceleration, market share losses\n   186→   - Weak guidance, negative management tone\n   187→\n   188→3. RISK FACTORS (finding_type: \"risk\")\n   189→   - Business, market, regulatory, competitive risks\n   190→   - Debt concerns, liquidity issues, concentration risks\n   191→   - Key person dependencies, governance issues\n   192→\n   193→4. RED FLAGS (finding_type: \"red_flag\")\n   194→   - Accounting irregularities, restatements\n   195→   - Insider selling, executive departures\n   196→   - SEC investigations, legal issues, guidance cuts\n   197→\n   198→5. FINANCIAL METRICS (finding_type: \"financial_metric\")\n   199→   - Revenue, EPS, margins with specific numbers\n   200→   - Valuation multiples (P/E, EV/EBITDA)\n   201→   - Price targets with analyst attribution\n   202→\n   203→6. PREDICTIONS (finding_type: \"prediction\")\n   204→   - Forward guidance, analyst forecasts\n   205→   - Industry trend predictions\n   206→\n   207→=== STRICT JSON OUTPUT FORMAT ===\n   208→\n   209→Return JSON array with EXACT structure. CRITICAL: Include \"analysis\" field with YOUR analytical commentary.\n   210→[\n   211→  {{\n   212→    \"finding_type\": \"bullish_signal\",\n   213→    \"summary\": \"NVIDIA data center revenue surged 409% YoY to $18.4B\",\n   214→    \"content\": \"Detailed explanation with numbers, dates, sources...\",\n   215→    \"analysis\": \"This exceptional growth rate significantly outpaces the broader semiconductor industry. The data center segment now represents 78% of total revenue, validating the AI infrastructure investment thesis. However, maintaining such growth rates will be increasingly difficult as the base grows larger.\",\n   216→    \"confidence_score\": 0.95,\n   217→    \"date_referenced\": \"Q3 FY2024\",\n   218→    \"extracted_data\": {{\"metric\": \"Data Center Revenue\", \"value\": \"$18.4B\", \"change\": \"+409% YoY\"}}\n   219→  }},\n   220→  {{\n   221→    \"finding_type\": \"risk\",\n   222→    \"summary\": \"China export restrictions pose 20-25% revenue risk\",\n   223→    \"content\": \"US government export controls on AI chips...\",\n   224→    \"analysis\": \"This is a structural headwind that could persist for years. While NVIDIA has developed compliant alternatives, ASPs are lower. Investors should model a 15-20% China revenue haircut as the new normal rather than expecting policy relaxation.\",\n   225→    \"confidence_score\": 0.85,\n   226→    \"date_referenced\": \"2024\",\n   227→    \"extracted_data\": {{\"risk_type\": \"regulatory\", \"severity\": \"high\"}}\n   228→  }},\n   229→  {{\n   230→    \"finding_type\": \"financial_metric\",\n   231→    \"summary\": \"Morgan Stanley: Overweight rating, $180 target\",\n   232→    \"content\": \"Morgan Stanley analyst Joseph Moore...\",\n   233→    \"analysis\": \"This price target implies ~25% upside from current levels. Morgan Stanley has historically been accurate on semiconductor calls. Their thesis centers on continued hyperscaler CapEx expansion, which aligns with recent guidance from major cloud providers.\",\n   234→    \"confidence_score\": 0.90,\n   235→    \"date_referenced\": \"January 2025\",\n   236→    \"extracted_data\": {{\"analyst\": \"Morgan Stanley\", \"rating\": \"Overweight\", \"target_price\": \"$180\"}}\n   237→  }}\n   238→]\n   239→\n   240→IMPORTANT: The \"analysis\" field should contain YOUR expert analytical commentary explaining:\n   241→- Why this finding matters for the investment thesis\n   242→- What it implies for the future\n   243→- Any caveats or nuances investors should consider\n   244→\n   245→Extract 8-15 findings covering bullish_signal, bearish_signal, risk, red_flag, financial_metric, prediction.\n   246→Return ONLY the JSON array.\n   247→\"\"\"\n   248→\n   249→        result = await self._call_gemini_json(prompt)\n   250→\n   251→        findings = []\n   252→        if isinstance(result, list):\n   253→            for f in result:\n   254→                if isinstance(f, dict):\n   255→                    finding = {\n   256→                        \"finding_type\": f.get(\"finding_type\", \"fact\"),\n   257→                        \"content\": f.get(\"content\", \"\"),\n   258→                        \"summary\": f.get(\"summary\"),\n   259→                        \"analysis\": f.get(\"analysis\", \"\"),  # LLM's analytical commentary\n   260→                        \"confidence_score\": f.get(\"confidence_score\", 0.5),\n   261→                        \"temporal_context\": f.get(\"temporal_context\", \"present\"),\n   262→                        \"date_referenced\": f.get(\"date_referenced\", \"\"),\n   263→                        \"extracted_data\": f.get(\"extracted_data\"),\n   264→                    }\n   265→\n   266→                    # Validate analysis field - generate fallback if too short/empty\n   267→                    analysis = finding.get(\"analysis\", \"\")\n   268→                    if not analysis or len(analysis) < 30:\n   269→                        finding_type = finding.get(\"finding_type\", \"fact\")\n   270→                        content = finding.get(\"content\", \"\")[:200]\n   271→                        summary = finding.get(\"summary\", \"\")\n   272→\n   273→                        # Generate contextual fallback analysis based on finding type\n   274→                        type_context = {\n   275→                            \"bullish_signal\": \"This positive indicator suggests favorable conditions for the investment thesis.\",\n   276→                            \"bearish_signal\": \"This concerning signal warrants caution and may indicate downside risk.\",\n   277→                            \"risk\": \"This risk factor should be monitored as part of ongoing position management.\",\n   278→                            \"red_flag\": \"This red flag requires careful attention and may warrant reducing position size.\",\n   279→                            \"financial_metric\": \"This metric provides insight into the company's financial health and trajectory.\",\n   280→                            \"prediction\": \"This forward-looking indicator may help inform investment timing decisions.\",\n   281→                            \"earnings_data\": \"This earnings data provides context for evaluating company performance.\",\n   282→                            \"valuation\": \"This valuation metric helps assess whether the stock is fairly priced.\",\n   283→                        }\n   284→                        finding[\"analysis\"] = type_context.get(finding_type, \"This finding provides relevant context for the investment thesis.\")\n   285→\n   286→                    findings.append(finding)\n   287→\n   288→        return findings\n   289→\n   290→    # ========== FINANCIAL-SPECIFIC REPORT GENERATION ==========\n   291→\n   292→    def get_supported_report_variants(self) -> List[str]:\n   293→        \"\"\"Financial template supports investment_thesis variant.\"\"\"\n   294→        return [\"full_report\", \"executive_summary\", \"investment_thesis\"]\n   295→\n   296→    def generate_investment_thesis(\n   297→        self,\n   298→        result: Dict[str, Any],\n   299→        title: Optional[str] = None,\n   300→    ) -> str:\n   301→        \"\"\"Generate investment thesis report - financial-specific variant.\"\"\"\n   302→        from datetime import datetime\n   303→\n   304→        query = result.get(\"query\", \"Unknown\")\n   305→        report_title = title or f\"Investment Thesis: {query[:40]}\"\n   306→\n   307→        sections = []\n   308→        sections.append(f\"# {report_title}\")\n   309→        sections.append(\"\")\n   310→        sections.append(f\"**Subject:** {query}\")\n   311→        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n   312→        sections.append(\"\")\n   313→        sections.append(\"---\")\n   314→        sections.append(\"\")\n   315→\n   316→        # Thesis summary\n   317→        sections.append(\"## Investment Thesis\")\n   318→        sections.append(\"\")\n   319→\n   320→        # Extract valuation perspective\n   321→        perspectives = result.get(\"perspectives\", [])\n   322→        valuation = next((p for p in perspectives if \"valuation\" in p.get(\"perspective_type\", \"\").lower()), None)\n   323→        investor = next((p for p in perspectives if \"investor\" in p.get(\"perspective_type\", \"\").lower()), None)\n   324→\n   325→        if valuation:\n   326→            sections.append(valuation.get(\"analysis_text\", \"\"))\n   327→            sections.append(\"\")\n   328→        elif investor:\n   329→            sections.append(investor.get(\"analysis_text\", \"\"))\n   330→            sections.append(\"\")\n   331→\n   332→        # Bull case\n   333→        sections.append(\"## Bull Case\")\n   334→        sections.append(\"\")\n   335→        findings = result.get(\"findings\", [])\n   336→        positive = [f for f in findings if f.get(\"confidence_score\", 0) >= 0.7]\n   337→        for f in positive[:5]:\n   338→            sections.append(f\"- {f.get('summary') or f.get('content', '')[:100]}\")\n   339→        sections.append(\"\")\n   340→\n   341→        # Bear case\n   342→        sections.append(\"## Bear Case / Risks\")\n   343→        sections.append(\"\")\n   344→        risks = [f for f in findings if f.get(\"finding_type\") in [\"pattern\", \"gap\", \"risk\"]]\n   345→        if not risks:\n   346→            risks = [f for f in findings if f.get(\"confidence_score\", 0) < 0.6]\n   347→        for f in risks[:5]:\n   348→            sections.append(f\"- {f.get('summary') or f.get('content', '')[:100]}\")\n   349→        sections.append(\"\")\n   350→\n   351→        # Key metrics\n   352→        metrics = [f for f in findings if f.get(\"finding_type\") == \"fact\"]\n   353→        if metrics:\n   354→            sections.append(\"## Key Financial Metrics\")\n   355→            sections.append(\"\")\n   356→            for m in metrics[:8]:\n   357→                extracted = m.get(\"extracted_data\", {})\n   358→                if extracted and isinstance(extracted, dict):\n   359→                    metric = extracted.get(\"metric\", \"\")\n   360→                    value = extracted.get(\"value\", \"\")\n   361→                    if metric and value:\n   362→                        sections.append(f\"- **{metric}:** {value}\")\n   363→                else:\n   364→                    sections.append(f\"- {m.get('summary') or m.get('content', '')[:80]}\")\n   365→            sections.append(\"\")\n   366→\n   367→        # Recommendations\n   368→        sections.append(\"## Recommendations\")\n   369→        sections.append(\"\")\n   370→        for p in perspectives:\n   371→            recs = p.get(\"recommendations\", [])\n   372→            for rec in recs[:2]:\n   373→                sections.append(f\"- {rec}\")\n   374→        sections.append(\"\")\n   375→\n   376→        # Warnings\n   377→        all_warnings = []\n   378→        for p in perspectives:\n   379→            all_warnings.extend(p.get(\"warnings\", []))\n   380→        if all_warnings:\n   381→            sections.append(\"## Risk Warnings\")\n   382→            sections.append(\"\")\n   383→            for warning in all_warnings[:5]:\n   384→                sections.append(f\"- {warning}\")\n   385→            sections.append(\"\")\n   386→\n   387→        return \"\\n\".join(sections)\n   388→\n   389→    def _get_priority_findings(self, findings: List[Dict[str, Any]]) -> List[Dict[str, Any]]:\n   390→        \"\"\"Financial template prioritizes facts and evidence with high confidence.\"\"\"\n   391→        # Prioritize financial metrics and evidence\n   392→        priority_types = [\"fact\", \"evidence\", \"prediction\"]\n   393→        prioritized = []\n   394→\n   395→        for ftype in priority_types:\n   396→            type_findings = [f for f in findings if f.get(\"finding_type\") == ftype]\n   397→            prioritized.extend(sorted(\n   398→                type_findings,\n   399→                key=lambda x: x.get(\"confidence_score\", 0),\n   400→                reverse=True\n   401→            ))\n   402→\n   403→        # Add remaining high-confidence findings\n   404→        remaining = [f for f in findings if f not in prioritized and f.get(\"confidence_score\", 0) >= 0.6]\n   405→        prioritized.extend(sorted(remaining, key=lambda x: x.get(\"confidence_score\", 0), reverse=True))\n   406→\n   407→        return prioritized\n   408→\n   409→    def _generate_key_sections(self, result: Dict[str, Any]) -> str:\n   410→        \"\"\"Generate financial-specific key sections: Bull/Bear case summary.\"\"\"\n   411→        findings = result.get(\"findings\", [])\n   412→        sections = []\n   413→\n   414→        # Valuation Summary\n   415→        valuations = [f for f in findings if f.get(\"finding_type\") == \"evidence\"\n   416→                      and \"valuation\" in f.get(\"content\", \"\").lower()]\n   417→        if valuations:\n   418→            sections.append(\"## Valuation Summary\")\n   419→            sections.append(\"\")\n   420→            for v in valuations[:3]:\n   421→                sections.append(f\"- {v.get('summary') or v.get('content', '')[:100]}\")\n   422→            sections.append(\"\")\n   423→\n   424→        # Risk Factors Summary\n   425→        risks = [f for f in findings if f.get(\"finding_type\") in [\"pattern\", \"gap\"]]\n   426→        if risks:\n   427→            sections.append(\"## Key Risk Factors\")\n   428→            sections.append(\"\")\n   429→            for r in risks[:4]:\n   430→                sections.append(f\"- {r.get('summary') or r.get('content', '')[:100]}\")\n   431→            sections.append(\"\")\n   432→\n   433→        return \"\\n\".join(sections)\n   434→\n   435→    def _generate_executive_highlights(self, result: Dict[str, Any]) -> str:\n   436→        \"\"\"Generate financial-specific executive highlights.\"\"\"\n   437→        findings = result.get(\"findings\", [])\n   438→        sections = []\n   439→\n   440→        # Key metrics highlight\n   441→        metrics = [f for f in findings if f.get(\"finding_type\") == \"fact\"]\n   442→        if metrics:\n   443→            sections.append(\"## Key Metrics\")\n   444→            sections.append(\"\")\n   445→            for m in metrics[:4]:\n   446→                sections.append(f\"- {m.get('summary') or m.get('content', '')[:100]}\")\n   447→            sections.append(\"\")\n   448→\n   449→        return \"\\n\".join(sections)\n   450→\n   451→    def generate_kill_criteria(self, result: Dict[str, Any]) -> Dict[str, Any]:\n   452→        \"\"\"Extract kill criteria - specific signals that would invalidate the investment thesis.\n   453→\n   454→        Returns dict with:\n   455→        - criteria: List of specific, measurable exit signals\n   456→        - monitoring_items: What to watch for each criterion\n   457→        - severity: How quickly to act if triggered\n   458→        \"\"\"\n   459→        findings = result.get(\"findings\", [])\n   460→        perspectives = result.get(\"perspectives\", [])\n   461→\n   462→        # Default kill criteria structure\n   463→        kill_criteria = {\n   464→            \"criteria\": [],\n   465→            \"summary\": \"Exit or reverse position if any of these conditions materialize\",\n   466→            \"update_frequency\": \"Review weekly, act immediately on major triggers\"\n   467→        }\n   468→\n   469→        # Extract from risk findings\n   470→        risks = [f for f in findings if f.get(\"finding_type\") in [\"risk\", \"red_flag\", \"bearish_signal\"]]\n   471→        for risk in risks[:5]:\n   472→            content = risk.get(\"content\", \"\")\n   473→            summary = risk.get(\"summary\", \"\")\n   474→\n   475→            # Create kill criterion from risk\n   476→            criterion = {\n   477→                \"trigger\": summary[:100] if summary else content[:100],\n   478→                \"threshold\": \"Significant deterioration from current levels\",\n   479→                \"action\": \"Reduce position by 50% immediately, exit fully if trend continues\",\n   480→                \"monitoring\": \"Track in earnings reports and news flow\",\n   481→                \"severity\": \"high\" if risk.get(\"confidence_score\", 0) > 0.8 else \"medium\"\n   482→            }\n   483→            kill_criteria[\"criteria\"].append(criterion)\n   484→\n   485→        # Extract from short seller perspective warnings\n   486→        short_seller = next((p for p in perspectives if \"short\" in p.get(\"perspective_type\", \"\").lower()), None)\n   487→        if short_seller:\n   488→            for warning in short_seller.get(\"warnings\", [])[:3]:\n   489→                criterion = {\n   490→                    \"trigger\": warning[:100],\n   491→                    \"threshold\": \"Evidence of materialization\",\n   492→                    \"action\": \"Exit position\",\n   493→                    \"monitoring\": \"Track via SEC filings and investigative reporting\",\n   494→                    \"severity\": \"critical\"\n   495→                }\n   496→                kill_criteria[\"criteria\"].append(criterion)\n   497→\n   498→        # Add standard financial kill criteria if not enough specific ones\n   499→        if len(kill_criteria[\"criteria\"]) < 3:\n   500→            standard_criteria = [\n   501→                {\n   502→                    \"trigger\": \"Revenue growth decelerates to below industry average\",\n   503→                    \"threshold\": \"<10% YoY growth for 2 consecutive quarters\",\n   504→                    \"action\": \"Reduce position, reassess thesis\",\n   505→                    \"monitoring\": \"Quarterly earnings reports\",\n   506→                    \"severity\": \"high\"\n   507→                },\n   508→                {\n   509→                    \"trigger\": \"Gross margin compression beyond guidance\",\n   510→                    \"threshold\": \">500bps decline from peak margins\",\n   511→                    \"action\": \"Exit 50% of position\",\n   512→                    \"monitoring\": \"Quarterly earnings, competitive pricing data\",\n   513→                    \"severity\": \"high\"\n   514→                },\n   515→                {\n   516→                    \"trigger\": \"Key customer concentration increases or major customer loss\",\n   517→                    \"threshold\": \"Top customer >40% of revenue OR loss of top-5 customer\",\n   518→                    \"action\": \"Reassess position size, consider hedging\",\n   519→                    \"monitoring\": \"10-K filings, customer announcements\",\n   520→                    \"severity\": \"medium\"\n   521→                }\n   522→            ]\n   523→            kill_criteria[\"criteria\"].extend(standard_criteria[:3 - len(kill_criteria[\"criteria\"])])\n   524→\n   525→        return kill_criteria\n   526→\n   527→    def generate_ecosystem_analysis(self, result: Dict[str, Any]) -> Dict[str, Any]:\n   528→        \"\"\"Generate upstream/downstream ecosystem analysis.\n   529→\n   530→        Returns dict with:\n   531→        - customers: Top customers and their outlook\n   532→        - competitors: Key competitors and momentum\n   533→        - suppliers: Critical dependencies\n   534→        - implications: What ecosystem dynamics mean for investment\n   535→        \"\"\"\n   536→        findings = result.get(\"findings\", [])\n   537→        perspectives = result.get(\"perspectives\", [])\n   538→\n   539→        ecosystem = {\n   540→            \"customers\": [],\n   541→            \"competitors\": [],\n   542→            \"suppliers\": [],\n   543→            \"implications\": []\n   544→        }\n   545→\n   546→        # Extract customer/competitor mentions from findings\n   547→        for f in findings:\n   548→            content = (f.get(\"content\", \"\") + \" \" + f.get(\"summary\", \"\")).lower()\n   549→\n   550→            if any(word in content for word in [\"customer\", \"client\", \"buyer\", \"revenue from\"]):\n   551→                ecosystem[\"customers\"].append({\n   552→                    \"mention\": f.get(\"summary\", f.get(\"content\", \"\"))[:150],\n   553→                    \"source\": \"research_finding\"\n   554→                })\n   555→\n   556→            if any(word in content for word in [\"competitor\", \"competition\", \"rival\", \"market share\"]):\n   557→                ecosystem[\"competitors\"].append({\n   558→                    \"mention\": f.get(\"summary\", f.get(\"content\", \"\"))[:150],\n   559→                    \"source\": \"research_finding\"\n   560→                })\n   561→\n   562→            if any(word in content for word in [\"supplier\", \"supply chain\", \"dependency\", \"vendor\"]):\n   563→                ecosystem[\"suppliers\"].append({\n   564→                    \"mention\": f.get(\"summary\", f.get(\"content\", \"\"))[:150],\n   565→                    \"source\": \"research_finding\"\n   566→                })\n   567→\n   568→        # Generate implications based on ecosystem data\n   569→        if ecosystem[\"customers\"]:\n   570→            ecosystem[\"implications\"].append(\n   571→                f\"Customer concentration/health is a key driver. Monitor top customer spending patterns.\"\n   572→            )\n   573→        if ecosystem[\"competitors\"]:\n   574→            ecosystem[\"implications\"].append(\n   575→                f\"Competitive dynamics identified. Track market share shifts quarterly.\"\n   576→            )\n   577→        if ecosystem[\"suppliers\"]:\n   578→            ecosystem[\"implications\"].append(\n   579→                f\"Supply chain dependencies exist. Monitor for disruption risks.\"\n   580→            )\n   581→\n   582→        return ecosystem\n   583→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"05d3e4f1-2259-4f3e-a055-8040a34c8b02","uuid":"7fd83c88-87a0-4b52-abac-982c51fa98c1","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\actor\\src\\templates\\financial.py","content":"\"\"\"Financial analysis research template.\"\"\"\n\nfrom typing import List, Dict, Any, Optional\n\nfrom .base import BaseTemplate\nfrom ..services.report_components import (\n    ComponentType, ComponentConfig, ReportHints, get_report_hints\n)\n\n\nclass FinancialTemplate(BaseTemplate):\n    \"\"\"Template for financial and stock analysis research.\"\"\"\n\n    template_id = \"financial\"\n    template_name = \"Financial Analysis\"\n    description = \"Stock and financial analysis for investment research\"\n\n    # Report hints for component-based rendering\n    report_hints = ReportHints(\n        template_type=\"financial\",\n        structure=\"quantitative_first\",\n        findings_grouping=\"sentiment\",\n        tone=\"analytical\",\n        decision_format=\"thesis\",\n        emphasis=[\"valuation\", \"risk_assessment\", \"financial_metrics\"],\n        required_components=[\n            ComponentType.INVESTMENT_THESIS,\n            ComponentType.METRIC_CARDS,\n            ComponentType.RISK_MATRIX,\n        ],\n        optional_components=[\n            ComponentType.FINDINGS_TABLE,\n            ComponentType.PREDICTION_CARDS,\n            ComponentType.COMPARISON_TABLE,\n            ComponentType.CONFIDENCE_GAUGE,\n        ],\n        visualization_preference=[\"financial_metrics\", \"risk_matrix\", \"peer_comparison\"],\n        custom_sections={\n            \"show_bull_bear_cases\": True,\n            \"price_targets\": True,\n            \"risk_factors_prominent\": True,\n        }\n    )\n\n    # Expert perspectives for deep financial analysis\n    default_perspectives = [\n        \"institutional_investor\",   # Long-term value creation, moats, management\n        \"short_seller\",             # Red flags, fraud detection, skeptical analysis\n        \"quantitative_risk\",        # Tail risks, stress testing, correlations\n        \"activist_investor\",        # Value creation levers, governance, catalysts\n        \"macro_strategist\",         # Economic cycles, policy risks, global context\n    ]\n\n    default_max_searches = 8\n\n    # Financial analysis needs rigorous verification\n    # Analysts have conflicts, numbers must be verified, projections questioned\n    verification_config = {\n        \"cross_reference\": \"thorough\",      # Verify financial numbers across sources\n        \"bias_detection\": \"thorough\",       # Analyst conflicts, investment banking ties\n        \"expert_sanity_check\": \"thorough\",  # Flag unrealistic valuations/projections\n        \"source_quality\": \"standard\",       # SEC filings are reliable, analyst reports vary\n    }\n\n    async def generate_search_queries(\n        self,\n        query: str,\n        max_searches: int,\n        granularity: str = \"standard\",\n    ) -> List[str]:\n        \"\"\"Generate financial analysis search queries.\"\"\"\n        prompt = f\"\"\"\nYou are a financial analyst planning comprehensive research for investment analysis.\n\nResearch Topic: {query}\n\nDepth Level: {granularity}\n\nGenerate search queries covering these financial analysis angles:\n\n1. EARNINGS AND FUNDAMENTALS\n   - Recent quarterly and annual earnings reports\n   - Revenue trends, margins, profitability metrics\n   - Earnings beats/misses, guidance changes\n   - Balance sheet strength, cash flow analysis\n\n2. ANALYST COVERAGE\n   - Wall Street analyst ratings and price targets\n   - Buy/hold/sell recommendations\n   - Earnings estimates and revisions\n   - Recent analyst upgrades/downgrades\n\n3. MARKET POSITION\n   - Competitive landscape and market share\n   - Industry trends and tailwinds/headwinds\n   - Customer concentration and diversification\n   - Geographic revenue breakdown\n\n4. RISK FACTORS\n   - Regulatory and compliance risks\n   - Macro economic exposure\n   - Supply chain dependencies\n   - Legal and litigation issues\n\n5. VALUATION\n   - Current valuation multiples (P/E, EV/EBITDA, P/S)\n   - Historical valuation ranges\n   - Peer comparison valuations\n   - DCF and fair value estimates\n\n6. NEWS AND CATALYSTS\n   - Recent company announcements\n   - Product launches, partnerships, M&A\n   - Management changes, insider transactions\n   - Upcoming events (earnings, conferences)\n\n7. ECOSYSTEM ANALYSIS (Upstream/Downstream) - MANDATORY\n   You MUST include at least 1-2 dedicated ecosystem queries:\n   - Top customers: \"[COMPANY] top customers revenue concentration 2024 2025\"\n   - Competitors: \"[COMPANY] vs [COMPETITOR] market share comparison\"\n   - For AI/chip companies: \"[COMPANY] hyperscaler capex Microsoft Google Amazon spending\"\n   - Supplier dependencies: \"[COMPANY] supply chain dependencies risks\"\n\n8. BEAR CASE RESEARCH\n   - Include at least one query for contrarian/bearish analysis:\n   - \"[COMPANY] short seller thesis bear case risks\"\n   - \"[COMPANY] stock overvalued concerns\"\n\nFor a \"{granularity}\" depth level:\n- \"quick\": 4-5 searches on key fundamentals and analyst sentiment\n- \"standard\": 8-10 searches covering all areas INCLUDING ecosystem and bear case\n- \"deep\": 12+ searches with comprehensive coverage including technicals\n\nCRITICAL: You MUST include at least ONE ecosystem query and ONE bear case query regardless of depth level.\n\nReturn a JSON array of exactly {max_searches} search query strings, ordered by importance.\nExample: [\"NVIDIA Q4 2025 earnings analysis\", \"NVIDIA stock analyst ratings price target 2025\", \"NVIDIA top customers hyperscaler capex Microsoft Google Amazon\", \"NVIDIA bear case short seller thesis risks\", ...]\n\"\"\"\n\n        result = await self._call_gemini_json(prompt)\n\n        if isinstance(result, list):\n            return result[:max_searches]\n        return []\n\n    async def extract_findings(\n        self,\n        query: str,\n        sources: List[Dict[str, Any]],\n        synthesized_content: str,\n        granularity: str = \"standard\",\n    ) -> List[Dict[str, Any]]:\n        \"\"\"Extract financial findings with component-aligned types.\"\"\"\n        # Build source context\n        source_context = \"\\n\\n\".join([\n            f\"Source: {s.get('title', 'Unknown')} ({s.get('url', '')})\\n\"\n            f\"Credibility: {s.get('credibility_score', 'Unknown')}\\n\"\n            f\"Domain: {s.get('domain', '')}\"\n            for s in sources[:20]\n        ])\n\n        prompt = f\"\"\"\nYou are a financial analyst extracting key findings for investment research.\nCRITICAL: Use EXACT finding_type values specified below - they map to UI components.\n\nResearch Topic: {query}\n\nSynthesized Research Content:\n{synthesized_content[:15000]}\n\nSources Referenced:\n{source_context}\n\n=== USE ONLY THESE finding_type VALUES ===\n\n1. BULLISH SIGNALS (finding_type: \"bullish_signal\")\n   - Positive earnings surprises, revenue beats, margin expansion\n   - Analyst upgrades, price target increases\n   - Growth acceleration, market share gains\n   - Strong guidance, positive management commentary\n\n2. BEARISH SIGNALS (finding_type: \"bearish_signal\")\n   - Earnings misses, revenue declines, margin compression\n   - Analyst downgrades, price target cuts\n   - Growth deceleration, market share losses\n   - Weak guidance, negative management tone\n\n3. RISK FACTORS (finding_type: \"risk\")\n   - Business, market, regulatory, competitive risks\n   - Debt concerns, liquidity issues, concentration risks\n   - Key person dependencies, governance issues\n\n4. RED FLAGS (finding_type: \"red_flag\")\n   - Accounting irregularities, restatements\n   - Insider selling, executive departures\n   - SEC investigations, legal issues, guidance cuts\n\n5. FINANCIAL METRICS (finding_type: \"financial_metric\")\n   - Revenue, EPS, margins with specific numbers\n   - Valuation multiples (P/E, EV/EBITDA)\n   - Price targets with analyst attribution\n\n6. PREDICTIONS (finding_type: \"prediction\")\n   - Forward guidance, analyst forecasts\n   - Industry trend predictions\n\n=== STRICT JSON OUTPUT FORMAT ===\n\nReturn JSON array with EXACT structure. CRITICAL: Include \"analysis\" field with YOUR analytical commentary.\n[\n  {{\n    \"finding_type\": \"bullish_signal\",\n    \"summary\": \"NVIDIA data center revenue surged 409% YoY to $18.4B\",\n    \"content\": \"Detailed explanation with numbers, dates, sources...\",\n    \"analysis\": \"This exceptional growth rate significantly outpaces the broader semiconductor industry. The data center segment now represents 78% of total revenue, validating the AI infrastructure investment thesis. However, maintaining such growth rates will be increasingly difficult as the base grows larger.\",\n    \"confidence_score\": 0.95,\n    \"date_referenced\": \"Q3 FY2024\",\n    \"extracted_data\": {{\"metric\": \"Data Center Revenue\", \"value\": \"$18.4B\", \"change\": \"+409% YoY\"}}\n  }},\n  {{\n    \"finding_type\": \"risk\",\n    \"summary\": \"China export restrictions pose 20-25% revenue risk\",\n    \"content\": \"US government export controls on AI chips...\",\n    \"analysis\": \"This is a structural headwind that could persist for years. While NVIDIA has developed compliant alternatives, ASPs are lower. Investors should model a 15-20% China revenue haircut as the new normal rather than expecting policy relaxation.\",\n    \"confidence_score\": 0.85,\n    \"date_referenced\": \"2024\",\n    \"extracted_data\": {{\"risk_type\": \"regulatory\", \"severity\": \"high\"}}\n  }},\n  {{\n    \"finding_type\": \"financial_metric\",\n    \"summary\": \"Morgan Stanley: Overweight rating, $180 target\",\n    \"content\": \"Morgan Stanley analyst Joseph Moore...\",\n    \"analysis\": \"This price target implies ~25% upside from current levels. Morgan Stanley has historically been accurate on semiconductor calls. Their thesis centers on continued hyperscaler CapEx expansion, which aligns with recent guidance from major cloud providers.\",\n    \"confidence_score\": 0.90,\n    \"date_referenced\": \"January 2025\",\n    \"extracted_data\": {{\"analyst\": \"Morgan Stanley\", \"rating\": \"Overweight\", \"target_price\": \"$180\"}}\n  }}\n]\n\nIMPORTANT: The \"analysis\" field should contain YOUR expert analytical commentary explaining:\n- Why this finding matters for the investment thesis\n- What it implies for the future\n- Any caveats or nuances investors should consider\n\nExtract 8-15 findings covering bullish_signal, bearish_signal, risk, red_flag, financial_metric, prediction.\nReturn ONLY the JSON array.\n\"\"\"\n\n        result = await self._call_gemini_json(prompt)\n\n        findings = []\n        if isinstance(result, list):\n            for f in result:\n                if isinstance(f, dict):\n                    finding = {\n                        \"finding_type\": f.get(\"finding_type\", \"fact\"),\n                        \"content\": f.get(\"content\", \"\"),\n                        \"summary\": f.get(\"summary\"),\n                        \"analysis\": f.get(\"analysis\", \"\"),  # LLM's analytical commentary\n                        \"confidence_score\": f.get(\"confidence_score\", 0.5),\n                        \"temporal_context\": f.get(\"temporal_context\", \"present\"),\n                        \"date_referenced\": f.get(\"date_referenced\", \"\"),\n                        \"extracted_data\": f.get(\"extracted_data\"),\n                    }\n\n                    # Validate analysis field - generate fallback if too short/empty\n                    analysis = finding.get(\"analysis\", \"\")\n                    if not analysis or len(analysis) < 30:\n                        finding_type = finding.get(\"finding_type\", \"fact\")\n                        content = finding.get(\"content\", \"\")[:200]\n                        summary = finding.get(\"summary\", \"\")\n\n                        # Generate contextual fallback analysis based on finding type\n                        type_context = {\n                            \"bullish_signal\": \"This positive indicator suggests favorable conditions for the investment thesis.\",\n                            \"bearish_signal\": \"This concerning signal warrants caution and may indicate downside risk.\",\n                            \"risk\": \"This risk factor should be monitored as part of ongoing position management.\",\n                            \"red_flag\": \"This red flag requires careful attention and may warrant reducing position size.\",\n                            \"financial_metric\": \"This metric provides insight into the company's financial health and trajectory.\",\n                            \"prediction\": \"This forward-looking indicator may help inform investment timing decisions.\",\n                            \"earnings_data\": \"This earnings data provides context for evaluating company performance.\",\n                            \"valuation\": \"This valuation metric helps assess whether the stock is fairly priced.\",\n                        }\n                        finding[\"analysis\"] = type_context.get(finding_type, \"This finding provides relevant context for the investment thesis.\")\n\n                    findings.append(finding)\n\n        return findings\n\n    # ========== FINANCIAL-SPECIFIC REPORT GENERATION ==========\n\n    def get_supported_report_variants(self) -> List[str]:\n        \"\"\"Financial template supports investment_thesis variant.\"\"\"\n        return [\"full_report\", \"executive_summary\", \"investment_thesis\"]\n\n    def generate_investment_thesis(\n        self,\n        result: Dict[str, Any],\n        title: Optional[str] = None,\n    ) -> str:\n        \"\"\"Generate investment thesis report - financial-specific variant.\"\"\"\n        from datetime import datetime\n\n        query = result.get(\"query\", \"Unknown\")\n        report_title = title or f\"Investment Thesis: {query[:40]}\"\n\n        sections = []\n        sections.append(f\"# {report_title}\")\n        sections.append(\"\")\n        sections.append(f\"**Subject:** {query}\")\n        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n        sections.append(\"\")\n        sections.append(\"---\")\n        sections.append(\"\")\n\n        # Thesis summary\n        sections.append(\"## Investment Thesis\")\n        sections.append(\"\")\n\n        # Extract valuation perspective\n        perspectives = result.get(\"perspectives\", [])\n        valuation = next((p for p in perspectives if \"valuation\" in p.get(\"perspective_type\", \"\").lower()), None)\n        investor = next((p for p in perspectives if \"investor\" in p.get(\"perspective_type\", \"\").lower()), None)\n\n        if valuation:\n            sections.append(valuation.get(\"analysis_text\", \"\"))\n            sections.append(\"\")\n        elif investor:\n            sections.append(investor.get(\"analysis_text\", \"\"))\n            sections.append(\"\")\n\n        # Bull case\n        sections.append(\"## Bull Case\")\n        sections.append(\"\")\n        findings = result.get(\"findings\", [])\n        positive = [f for f in findings if f.get(\"confidence_score\", 0) >= 0.7]\n        for f in positive[:5]:\n            sections.append(f\"- {f.get('summary') or f.get('content', '')[:100]}\")\n        sections.append(\"\")\n\n        # Bear case\n        sections.append(\"## Bear Case / Risks\")\n        sections.append(\"\")\n        risks = [f for f in findings if f.get(\"finding_type\") in [\"pattern\", \"gap\", \"risk\"]]\n        if not risks:\n            risks = [f for f in findings if f.get(\"confidence_score\", 0) < 0.6]\n        for f in risks[:5]:\n            sections.append(f\"- {f.get('summary') or f.get('content', '')[:100]}\")\n        sections.append(\"\")\n\n        # Key metrics\n        metrics = [f for f in findings if f.get(\"finding_type\") == \"fact\"]\n        if metrics:\n            sections.append(\"## Key Financial Metrics\")\n            sections.append(\"\")\n            for m in metrics[:8]:\n                extracted = m.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    metric = extracted.get(\"metric\", \"\")\n                    value = extracted.get(\"value\", \"\")\n                    if metric and value:\n                        sections.append(f\"- **{metric}:** {value}\")\n                else:\n                    sections.append(f\"- {m.get('summary') or m.get('content', '')[:80]}\")\n            sections.append(\"\")\n\n        # Recommendations\n        sections.append(\"## Recommendations\")\n        sections.append(\"\")\n        for p in perspectives:\n            recs = p.get(\"recommendations\", [])\n            for rec in recs[:2]:\n                sections.append(f\"- {rec}\")\n        sections.append(\"\")\n\n        # Warnings\n        all_warnings = []\n        for p in perspectives:\n            all_warnings.extend(p.get(\"warnings\", []))\n        if all_warnings:\n            sections.append(\"## Risk Warnings\")\n            sections.append(\"\")\n            for warning in all_warnings[:5]:\n                sections.append(f\"- {warning}\")\n            sections.append(\"\")\n\n        return \"\\n\".join(sections)\n\n    def _get_priority_findings(self, findings: List[Dict[str, Any]]) -> List[Dict[str, Any]]:\n        \"\"\"Financial template prioritizes facts and evidence with high confidence.\"\"\"\n        # Prioritize financial metrics and evidence\n        priority_types = [\"fact\", \"evidence\", \"prediction\"]\n        prioritized = []\n\n        for ftype in priority_types:\n            type_findings = [f for f in findings if f.get(\"finding_type\") == ftype]\n            prioritized.extend(sorted(\n                type_findings,\n                key=lambda x: x.get(\"confidence_score\", 0),\n                reverse=True\n            ))\n\n        # Add remaining high-confidence findings\n        remaining = [f for f in findings if f not in prioritized and f.get(\"confidence_score\", 0) >= 0.6]\n        prioritized.extend(sorted(remaining, key=lambda x: x.get(\"confidence_score\", 0), reverse=True))\n\n        return prioritized\n\n    def _generate_key_sections(self, result: Dict[str, Any]) -> str:\n        \"\"\"Generate financial-specific key sections: Bull/Bear case summary.\"\"\"\n        findings = result.get(\"findings\", [])\n        sections = []\n\n        # Valuation Summary\n        valuations = [f for f in findings if f.get(\"finding_type\") == \"evidence\"\n                      and \"valuation\" in f.get(\"content\", \"\").lower()]\n        if valuations:\n            sections.append(\"## Valuation Summary\")\n            sections.append(\"\")\n            for v in valuations[:3]:\n                sections.append(f\"- {v.get('summary') or v.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Risk Factors Summary\n        risks = [f for f in findings if f.get(\"finding_type\") in [\"pattern\", \"gap\"]]\n        if risks:\n            sections.append(\"## Key Risk Factors\")\n            sections.append(\"\")\n            for r in risks[:4]:\n                sections.append(f\"- {r.get('summary') or r.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        return \"\\n\".join(sections)\n\n    def _generate_executive_highlights(self, result: Dict[str, Any]) -> str:\n        \"\"\"Generate financial-specific executive highlights.\"\"\"\n        findings = result.get(\"findings\", [])\n        sections = []\n\n        # Key metrics highlight\n        metrics = [f for f in findings if f.get(\"finding_type\") == \"fact\"]\n        if metrics:\n            sections.append(\"## Key Metrics\")\n            sections.append(\"\")\n            for m in metrics[:4]:\n                sections.append(f\"- {m.get('summary') or m.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        return \"\\n\".join(sections)\n\n    def generate_kill_criteria(self, result: Dict[str, Any]) -> Dict[str, Any]:\n        \"\"\"Extract kill criteria - specific signals that would invalidate the investment thesis.\n\n        Returns dict with:\n        - criteria: List of specific, measurable exit signals\n        - monitoring_items: What to watch for each criterion\n        - severity: How quickly to act if triggered\n        \"\"\"\n        findings = result.get(\"findings\", [])\n        perspectives = result.get(\"perspectives\", [])\n\n        # Default kill criteria structure\n        kill_criteria = {\n            \"criteria\": [],\n            \"summary\": \"Exit or reverse position if any of these conditions materialize\",\n            \"update_frequency\": \"Review weekly, act immediately on major triggers\"\n        }\n\n        # Extract from risk findings\n        risks = [f for f in findings if f.get(\"finding_type\") in [\"risk\", \"red_flag\", \"bearish_signal\"]]\n        for risk in risks[:5]:\n            content = risk.get(\"content\", \"\")\n            summary = risk.get(\"summary\", \"\")\n\n            # Create kill criterion from risk\n            criterion = {\n                \"trigger\": summary[:100] if summary else content[:100],\n                \"threshold\": \"Significant deterioration from current levels\",\n                \"action\": \"Reduce position by 50% immediately, exit fully if trend continues\",\n                \"monitoring\": \"Track in earnings reports and news flow\",\n                \"severity\": \"high\" if risk.get(\"confidence_score\", 0) > 0.8 else \"medium\"\n            }\n            kill_criteria[\"criteria\"].append(criterion)\n\n        # Extract from short seller perspective warnings\n        short_seller = next((p for p in perspectives if \"short\" in p.get(\"perspective_type\", \"\").lower()), None)\n        if short_seller:\n            for warning in short_seller.get(\"warnings\", [])[:3]:\n                criterion = {\n                    \"trigger\": warning[:100],\n                    \"threshold\": \"Evidence of materialization\",\n                    \"action\": \"Exit position\",\n                    \"monitoring\": \"Track via SEC filings and investigative reporting\",\n                    \"severity\": \"critical\"\n                }\n                kill_criteria[\"criteria\"].append(criterion)\n\n        # Add standard financial kill criteria if not enough specific ones\n        if len(kill_criteria[\"criteria\"]) < 3:\n            standard_criteria = [\n                {\n                    \"trigger\": \"Revenue growth decelerates to below industry average\",\n                    \"threshold\": \"<10% YoY growth for 2 consecutive quarters\",\n                    \"action\": \"Reduce position, reassess thesis\",\n                    \"monitoring\": \"Quarterly earnings reports\",\n                    \"severity\": \"high\"\n                },\n                {\n                    \"trigger\": \"Gross margin compression beyond guidance\",\n                    \"threshold\": \">500bps decline from peak margins\",\n                    \"action\": \"Exit 50% of position\",\n                    \"monitoring\": \"Quarterly earnings, competitive pricing data\",\n                    \"severity\": \"high\"\n                },\n                {\n                    \"trigger\": \"Key customer concentration increases or major customer loss\",\n                    \"threshold\": \"Top customer >40% of revenue OR loss of top-5 customer\",\n                    \"action\": \"Reassess position size, consider hedging\",\n                    \"monitoring\": \"10-K filings, customer announcements\",\n                    \"severity\": \"medium\"\n                }\n            ]\n            kill_criteria[\"criteria\"].extend(standard_criteria[:3 - len(kill_criteria[\"criteria\"])])\n\n        return kill_criteria\n\n    def generate_ecosystem_analysis(self, result: Dict[str, Any]) -> Dict[str, Any]:\n        \"\"\"Generate upstream/downstream ecosystem analysis.\n\n        Returns dict with:\n        - customers: Top customers and their outlook\n        - competitors: Key competitors and momentum\n        - suppliers: Critical dependencies\n        - implications: What ecosystem dynamics mean for investment\n        \"\"\"\n        findings = result.get(\"findings\", [])\n        perspectives = result.get(\"perspectives\", [])\n\n        ecosystem = {\n            \"customers\": [],\n            \"competitors\": [],\n            \"suppliers\": [],\n            \"implications\": []\n        }\n\n        # Extract customer/competitor mentions from findings\n        for f in findings:\n            content = (f.get(\"content\", \"\") + \" \" + f.get(\"summary\", \"\")).lower()\n\n            if any(word in content for word in [\"customer\", \"client\", \"buyer\", \"revenue from\"]):\n                ecosystem[\"customers\"].append({\n                    \"mention\": f.get(\"summary\", f.get(\"content\", \"\"))[:150],\n                    \"source\": \"research_finding\"\n                })\n\n            if any(word in content for word in [\"competitor\", \"competition\", \"rival\", \"market share\"]):\n                ecosystem[\"competitors\"].append({\n                    \"mention\": f.get(\"summary\", f.get(\"content\", \"\"))[:150],\n                    \"source\": \"research_finding\"\n                })\n\n            if any(word in content for word in [\"supplier\", \"supply chain\", \"dependency\", \"vendor\"]):\n                ecosystem[\"suppliers\"].append({\n                    \"mention\": f.get(\"summary\", f.get(\"content\", \"\"))[:150],\n                    \"source\": \"research_finding\"\n                })\n\n        # Generate implications based on ecosystem data\n        if ecosystem[\"customers\"]:\n            ecosystem[\"implications\"].append(\n                f\"Customer concentration/health is a key driver. Monitor top customer spending patterns.\"\n            )\n        if ecosystem[\"competitors\"]:\n            ecosystem[\"implications\"].append(\n                f\"Competitive dynamics identified. Track market share shifts quarterly.\"\n            )\n        if ecosystem[\"suppliers\"]:\n            ecosystem[\"implications\"].append(\n                f\"Supply chain dependencies exist. Monitor for disruption risks.\"\n            )\n\n        return ecosystem\n","numLines":583,"startLine":1,"totalLines":583}}}
