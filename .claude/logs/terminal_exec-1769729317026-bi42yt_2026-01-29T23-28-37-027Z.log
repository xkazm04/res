[2026-01-29T23:29:19.992Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ETZGK7MBYPb9BCZ4LGPBB2","type":"tool_result","content":"     1→\"\"\"Interactive HTML report generation with Alpine.js.\"\"\"\n     2→\n     3→from typing import Dict, Any, List\n     4→from datetime import datetime\n     5→import html as html_mod\n     6→import json\n     7→\n     8→from .visualizations import (\n     9→    NetworkVisualization, TimelineVisualization, MoneyFlowVisualization,\n    10→    StakeholderImpactMatrix, PredictionTimeline, FinancialTables,\n    11→    FeatureComparisonMatrix, ContractPricingTable, EvidenceChain\n    12→)\n    13→\n    14→\n    15→def _generate_visualizations_html(result: Dict[str, Any]) -> str:\n    16→    \"\"\"Generate visualization sections based on template type and available data.\"\"\"\n    17→    template = result.get(\"template\", \"unknown\")\n    18→    findings = result.get(\"findings\", [])\n    19→\n    20→    viz_sections = []\n    21→\n    22→    # Network visualization for investigative/competitive templates\n    23→    if template in [\"investigative\", \"competitive\", \"legal\"]:\n    24→        actors, relationships = NetworkVisualization.extract_network_data(findings)\n    25→        if actors:\n    26→            viz_sections.append('''\n    27→                <div class=\"section\">\n    28→                    <div class=\"section-header\">\n    29→                        <span class=\"section-title\">Actor Network</span>\n    30→                        <span class=\"section-count\">''' + str(len(actors)) + ''' actors</span>\n    31→                    </div>\n    32→                    <div class=\"section-body\">\n    33→                        ''' + NetworkVisualization.generate_network_html(actors, relationships) + '''\n    34→                    </div>\n    35→                </div>\n    36→            ''')\n    37→\n    38→    # Timeline visualization for investigative/financial/legal\n    39→    if template in [\"investigative\", \"financial\", \"legal\", \"contract\"]:\n    40→        streams = TimelineVisualization.extract_timeline_data(findings)\n    41→        if streams:\n    42→            total_events = sum(len(events) for events in streams.values())\n    43→            viz_sections.append('''\n    44→                <div class=\"section\">\n    45→                    <div class=\"section-header\">\n    46→                        <span class=\"section-title\">Event Timeline</span>\n    47→                        <span class=\"section-count\">''' + str(total_events) + ''' events</span>\n    48→                    </div>\n    49→                    <div class=\"section-body\">\n    50→                        ''' + TimelineVisualization.generate_timeline_html(streams) + '''\n    51→                    </div>\n    52→                </div>\n    53→            ''')\n    54→\n    55→    # Money flow for investigative/financial/contract\n    56→    if template in [\"investigative\", \"financial\", \"contract\"]:\n    57→        flows = MoneyFlowVisualization.extract_flow_data(findings)\n    58→        if flows:\n    59→            viz_sections.append('''\n    60→                <div class=\"section\">\n    61→                    <div class=\"section-header\">\n    62→                        <span class=\"section-title\">Financial Flows</span>\n    63→                        <span class=\"section-count\">''' + str(len(flows)) + ''' transactions</span>\n    64→                    </div>\n    65→                    <div class=\"section-body\">\n    66→                        ''' + MoneyFlowVisualization.generate_flow_html(flows) + '''\n    67→                    </div>\n    68→                </div>\n    69→            ''')\n    70→\n    71→    # Stakeholder Impact Matrix for competitive/financial/legal\n    72→    perspectives = result.get(\"perspectives\", [])\n    73→    if template in [\"competitive\", \"financial\", \"legal\", \"tech_market\"]:\n    74→        stakeholders = StakeholderImpactMatrix.extract_stakeholders(findings, perspectives)\n    75→        if stakeholders and len(findings) > 0:\n    76→            impact_data = StakeholderImpactMatrix.analyze_impacts(findings, stakeholders)\n    77→            if impact_data:\n    78→                viz_sections.append('''\n    79→                <div class=\"section\">\n    80→                    <div class=\"section-header\">\n    81→                        <span class=\"section-title\">Stakeholder Impact Analysis</span>\n    82→                        <span class=\"section-count\">''' + str(len(stakeholders)) + ''' stakeholders</span>\n    83→                    </div>\n    84→                    <div class=\"section-body\">\n    85→                        ''' + StakeholderImpactMatrix.generate_matrix_html(impact_data, stakeholders) + '''\n    86→                    </div>\n    87→                </div>\n    88→            ''')\n    89→\n    90→    # Prediction Timeline for tech_market/financial\n    91→    if template in [\"tech_market\", \"financial\", \"competitive\"]:\n    92→        grouped_predictions = PredictionTimeline.group_predictions_by_timeline(perspectives)\n    93→        if grouped_predictions:\n    94→            total_preds = sum(len(preds) for preds in grouped_predictions.values())\n    95→            viz_sections.append('''\n    96→                <div class=\"section\">\n    97→                    <div class=\"section-header\">\n    98→                        <span class=\"section-title\">Prediction Timeline</span>\n    99→                        <span class=\"section-count\">''' + str(total_preds) + ''' predictions</span>\n   100→                    </div>\n   101→                    <div class=\"section-body\">\n   102→                        ''' + PredictionTimeline.generate_timeline_html(grouped_predictions) + '''\n   103→                    </div>\n   104→                </div>\n   105→            ''')\n   106→\n   107→    # Financial Tables for financial template\n   108→    if template == \"financial\":\n   109→        metrics = FinancialTables.extract_financial_metrics(findings)\n   110→        if any(metrics.values()):\n   111→            viz_sections.append('''\n   112→                <div class=\"section\">\n   113→                    <div class=\"section-header\">\n   114→                        <span class=\"section-title\">Financial Metrics</span>\n   115→                    </div>\n   116→                    <div class=\"section-body\">\n   117→                        ''' + FinancialTables.generate_financial_table_html(metrics) + '''\n   118→                    </div>\n   119→                </div>\n   120→            ''')\n   121→\n   122→    # Feature Comparison Matrix for tech_market\n   123→    if template == \"tech_market\":\n   124→        products = FeatureComparisonMatrix.extract_features(findings)\n   125→        if products:\n   126→            viz_sections.append('''\n   127→                <div class=\"section\">\n   128→                    <div class=\"section-header\">\n   129→                        <span class=\"section-title\">Feature Comparison</span>\n   130→                        <span class=\"section-count\">''' + str(len(products)) + ''' products</span>\n   131→                    </div>\n   132→                    <div class=\"section-body\">\n   133→                        ''' + FeatureComparisonMatrix.generate_comparison_html(products) + '''\n   134→                    </div>\n   135→                </div>\n   136→            ''')\n   137→\n   138→    # Contract Pricing Table for contract template\n   139→    if template == \"contract\":\n   140→        pricing = ContractPricingTable.extract_pricing_data(findings)\n   141→        if pricing:\n   142→            viz_sections.append('''\n   143→                <div class=\"section\">\n   144→                    <div class=\"section-header\">\n   145→                        <span class=\"section-title\">Pricing Analysis</span>\n   146→                        <span class=\"section-count\">''' + str(len(pricing)) + ''' items</span>\n   147→                    </div>\n   148→                    <div class=\"section-body\">\n   149→                        ''' + ContractPricingTable.generate_pricing_table_html(pricing) + '''\n   150→                    </div>\n   151→                </div>\n   152→            ''')\n   153→\n   154→    # Evidence Chain for investigative template\n   155→    if template == \"investigative\":\n   156→        chain = EvidenceChain.build_evidence_chain(findings)\n   157→        if chain:\n   158→            viz_sections.append('''\n   159→                <div class=\"section\">\n   160→                    <div class=\"section-header\">\n   161→                        <span class=\"section-title\">Evidence Chain</span>\n   162→                        <span class=\"section-count\">''' + str(len(chain)) + ''' claims</span>\n   163→                    </div>\n   164→                    <div class=\"section-body\">\n   165→                        ''' + EvidenceChain.generate_chain_html(chain) + '''\n   166→                    </div>\n   167→                </div>\n   168→            ''')\n   169→\n   170→    if not viz_sections:\n   171→        return '<div class=\"empty-state\">No visualization data available for this research type</div>'\n   172→\n   173→    return '\\n'.join(viz_sections)\n   174→\n   175→\n   176→def _has_visualization_data(result: Dict[str, Any]) -> bool:\n   177→    \"\"\"Check if there's data available for visualizations.\"\"\"\n   178→    template = result.get(\"template\", \"unknown\")\n   179→    findings = result.get(\"findings\", [])\n   180→\n   181→    # Check for actor/relationship data\n   182→    if template in [\"investigative\", \"competitive\", \"legal\"]:\n   183→        actors, _ = NetworkVisualization.extract_network_data(findings)\n   184→        if actors:\n   185→            return True\n   186→\n   187→    # Check for timeline data\n   188→    if template in [\"investigative\", \"financial\", \"legal\", \"contract\"]:\n   189→        streams = TimelineVisualization.extract_timeline_data(findings)\n   190→        if streams:\n   191→            return True\n   192→\n   193→    # Check for money flow data\n   194→    if template in [\"investigative\", \"financial\", \"contract\"]:\n   195→        flows = MoneyFlowVisualization.extract_flow_data(findings)\n   196→        if flows:\n   197→            return True\n   198→\n   199→    # Check for stakeholder impact data\n   200→    perspectives = result.get(\"perspectives\", [])\n   201→    if template in [\"competitive\", \"financial\", \"legal\", \"tech_market\"]:\n   202→        stakeholders = StakeholderImpactMatrix.extract_stakeholders(findings, perspectives)\n   203→        if stakeholders and len(findings) > 0:\n   204→            return True\n   205→\n   206→    return False\n   207→\n   208→\n   209→def _generate_decision_summary_html(result: Dict[str, Any], findings: List[Dict], perspectives: List[Dict], red_flags: List[Dict], avg_conf: float) -> str:\n   210→    \"\"\"Generate Executive Decision Summary - the first thing busy decision-makers see.\n   211→\n   212→    This summary provides:\n   213→    1. Bottom line recommendation\n   214→    2. Confidence level\n   215→    3. Key assumptions (what must be true)\n   216→    4. Kill criteria (when to reverse)\n   217→    5. Suggested action\n   218→    \"\"\"\n   219→    template = result.get(\"template\", \"unknown\")\n   220→    query = result.get(\"query\", \"\")\n   221→\n   222→    # Only show decision summary for actionable templates\n   223→    actionable_templates = [\"financial\", \"tech_market\", \"competitive\", \"due_diligence\", \"purchase_decision\"]\n   224→    if template not in actionable_templates:\n   225→        return \"\"\n   226→\n   227→    # Determine sentiment from findings\n   228→    bullish = [f for f in findings if f.get(\"finding_type\") in [\"bullish_signal\", \"positive\", \"strength\", \"opportunity\"]]\n   229→    bearish = [f for f in findings if f.get(\"finding_type\") in [\"bearish_signal\", \"risk\", \"red_flag\", \"weakness\", \"threat\"]]\n   230→\n   231→    # Calculate sentiment score\n   232→    bullish_weight = len(bullish) * 1.0\n   233→    bearish_weight = len(bearish) * 1.5  # Weight bearish signals higher for conservatism\n   234→    red_flag_weight = len(red_flags) * 2.0\n   235→\n   236→    if bullish_weight + bearish_weight + red_flag_weight == 0:\n   237→        sentiment_score = 0.5\n   238→    else:\n   239→        sentiment_score = bullish_weight / (bullish_weight + bearish_weight + red_flag_weight)\n   240→\n   241→    # Determine recommendation\n   242→    if len(red_flags) >= 3:\n   243→        recommendation = \"AVOID\"\n   244→        rec_class = \"avoid\"\n   245→        rec_detail = \"Multiple red flags detected - proceed with extreme caution\"\n   246→    elif sentiment_score >= 0.7 and avg_conf >= 0.7:\n   247→        recommendation = \"POSITIVE\"\n   248→        rec_class = \"positive\"\n   249→        rec_detail = \"Strong positive signals with high confidence\"\n   250→    elif sentiment_score >= 0.5:\n   251→        recommendation = \"NEUTRAL\"\n   252→        rec_class = \"neutral\"\n   253→        rec_detail = \"Mixed signals - additional research recommended\"\n   254→    else:\n   255→        recommendation = \"CAUTIOUS\"\n   256→        rec_class = \"cautious\"\n   257→        rec_detail = \"Significant concerns identified\"\n   258→\n   259→    # Confidence level\n   260→    conf_pct = int(avg_conf * 100)\n   261→    conf_label = \"High\" if avg_conf >= 0.8 else \"Medium\" if avg_conf >= 0.6 else \"Low\"\n   262→\n   263→    # Extract key assumptions from high-confidence positive findings\n   264→    assumptions = []\n   265→    for f in bullish[:3]:\n   266→        summary = f.get(\"summary\") or f.get(\"content\", \"\")[:200]\n   267→        if summary:\n   268→            assumptions.append(html_mod.escape(summary))\n   269→\n   270→    # Extract kill criteria from risks and warnings\n   271→    kill_criteria = []\n   272→    for f in (bearish + red_flags)[:3]:\n   273→        summary = f.get(\"summary\") or f.get(\"content\", \"\")[:200]\n   274→        if summary:\n   275→            kill_criteria.append(html_mod.escape(summary))\n   276→\n   277→    # Also check short seller perspective for kill criteria\n   278→    short_seller = next((p for p in perspectives if \"short\" in p.get(\"perspective_type\", \"\").lower()), None)\n   279→    if short_seller:\n   280→        for warning in short_seller.get(\"warnings\", [])[:2]:\n   281→            kill_criteria.append(html_mod.escape(warning))\n   282→\n   283→    # Build assumptions HTML\n   284→    assumptions_html = \"\"\n   285→    if assumptions:\n   286→        assumptions_items = \"\".join([f'<li>{a}</li>' for a in assumptions[:3]])\n   287→        assumptions_html = f'<div class=\"ds-section\"><div class=\"ds-section-title\">Key Assumptions</div><ul class=\"ds-list\">{assumptions_items}</ul></div>'\n   288→\n   289→    # Build kill criteria HTML\n   290→    kill_html = \"\"\n   291→    if kill_criteria:\n   292→        kill_items = \"\".join([f'<li>{k}</li>' for k in kill_criteria[:3]])\n   293→        kill_html = f'<div class=\"ds-section\"><div class=\"ds-section-title\">Kill Criteria (Reverse If...)</div><ul class=\"ds-list ds-list-warning\">{kill_items}</ul></div>'\n   294→\n   295→    return f'''\n   296→    <div class=\"decision-summary\">\n   297→        <div class=\"ds-header\">\n   298→            <div class=\"ds-title\">\n   299→                <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"/><polyline points=\"22 4 12 14.01 9 11.01\"/></svg>\n   300→                Decision Summary\n   301→            </div>\n   302→            <div class=\"ds-badge ds-badge-{rec_class}\">{recommendation}</div>\n   303→        </div>\n   304→        <div class=\"ds-body\">\n   305→            <div class=\"ds-main\">\n   306→                <div class=\"ds-recommendation\">\n   307→                    <span class=\"ds-rec-label\">Assessment:</span>\n   308→                    <span class=\"ds-rec-value\">{rec_detail}</span>\n   309→                </div>\n   310→                <div class=\"ds-confidence\">\n   311→                    <span class=\"ds-conf-label\">Confidence:</span>\n   312→                    <span class=\"ds-conf-value\">{conf_label} ({conf_pct}%)</span>\n   313→                    <div class=\"ds-conf-bar\"><div class=\"ds-conf-fill ds-conf-{conf_label.lower()}\" style=\"width: {conf_pct}%\"></div></div>\n   314→                </div>\n   315→            </div>\n   316→            <div class=\"ds-details\">\n   317→                {assumptions_html}\n   318→                {kill_html}\n   319→            </div>\n   320→        </div>\n   321→        <div class=\"ds-footer\">\n   322→            <span>Based on {len(findings)} findings from {len(result.get(\"sources\", []))} sources</span>\n   323→            <span class=\"ds-footer-note\">Review full analysis below for complete context</span>\n   324→        </div>\n   325→    </div>\n   326→    '''\n   327→\n   328→\n   329→def generate_interactive_html(result: Dict[str, Any], title: str, current_date: str = None) -> str:\n   330→    \"\"\"Generate interactive HTML report with tabs, filters, search, and compact table views.\n   331→\n   332→    Args:\n   333→        result: Research result dictionary\n   334→        title: Report title\n   335→        current_date: Current date string for date-aware content (e.g., \"January 2025\")\n   336→    \"\"\"\n   337→    if current_date is None:\n   338→        current_date = datetime.now().strftime(\"%B %Y\")\n   339→\n   340→    query = result.get(\"query\", \"Unknown Query\")\n   341→    template = result.get(\"template\", \"unknown\")\n   342→    status = result.get(\"status\", \"unknown\")\n   343→    findings = result.get(\"findings\", [])\n   344→    perspectives = result.get(\"perspectives\", [])\n   345→    sources = result.get(\"sources\", [])\n   346→    cost = result.get(\"cost_summary\", {})\n   347→    search_queries = result.get(\"search_queries_executed\", [])\n   348→\n   349→    # Calculate metrics\n   350→    high_conf = len([f for f in findings if f.get(\"confidence_score\", 0) >= 0.8])\n   351→    med_conf = len([f for f in findings if 0.6 <= f.get(\"confidence_score\", 0) < 0.8])\n   352→    low_conf = len([f for f in findings if f.get(\"confidence_score\", 0) < 0.6])\n   353→    red_flags = [f for f in findings if f.get(\"finding_type\") in [\"red_flag\", \"suspicious_element\"]]\n   354→    high_cred = len([s for s in sources if s.get(\"credibility_score\", 0) >= 0.8])\n   355→\n   356→    # Calculate average confidence\n   357→    avg_conf = sum(f.get(\"confidence_score\", 0.5) for f in findings) / max(len(findings), 1)\n   358→    avg_conf_pct = int(avg_conf * 100)\n   359→    avg_conf_label = \"high\" if avg_conf >= 0.8 else \"medium\" if avg_conf >= 0.6 else \"low\"\n   360→\n   361→    exec_time = result.get(\"execution_time_seconds\", 0)\n   362→    total_cost = cost.get(\"total_cost_usd\", 0)\n   363→    total_tokens = cost.get(\"total_tokens\", 0)\n   364→\n   365→    # Collect predictions with source attribution\n   366→    raw_predictions = []\n   367→    for p in perspectives:\n   368→        perspective_type = p.get(\"perspective_type\", \"analyst\")\n   369→        for pred in p.get(\"predictions\", []):\n   370→            if isinstance(pred, dict):\n   371→                pred_with_source = pred.copy()\n   372→                pred_with_source[\"source_perspective\"] = perspective_type\n   373→            else:\n   374→                pred_with_source = {\"prediction\": str(pred), \"source_perspective\": perspective_type}\n   375→            raw_predictions.append(pred_with_source)\n   376→\n   377→    # Deduplicate predictions by grouping similar ones\n   378→    seen_predictions = {}\n   379→    for pred in raw_predictions:\n   380→        pred_text = pred.get(\"prediction\", \"\")\n   381→        # Create a normalized key for comparison (first 50 chars, lowercase, stripped)\n   382→        key = pred_text[:50].lower().strip()\n   383→        if key in seen_predictions:\n   384→            # Add this perspective to existing prediction\n   385→            existing = seen_predictions[key]\n   386→            existing_perspectives = existing.get(\"agreeing_perspectives\", [existing.get(\"source_perspective\", \"analyst\")])\n   387→            new_perspective = pred.get(\"source_perspective\", \"analyst\")\n   388→            if new_perspective not in existing_perspectives:\n   389→                existing_perspectives.append(new_perspective)\n   390→            existing[\"agreeing_perspectives\"] = existing_perspectives\n   391→            # Keep the higher confidence\n   392→            new_conf = pred.get(\"confidence\", \"medium\")\n   393→            existing_conf = existing.get(\"confidence\", \"medium\")\n   394→            conf_order = {\"high\": 3, \"medium\": 2, \"low\": 1}\n   395→            if conf_order.get(new_conf, 2) > conf_order.get(existing_conf, 2):\n   396→                existing[\"confidence\"] = new_conf\n   397→        else:\n   398→            pred[\"agreeing_perspectives\"] = [pred.get(\"source_perspective\", \"analyst\")]\n   399→            seen_predictions[key] = pred\n   400→\n   401→    all_predictions = list(seen_predictions.values())\n   402→\n   403→    # Get intelligence analysis results\n   404→    contradictions = result.get(\"contradictions\", [])\n   405→    role_summaries = result.get(\"role_summaries\", {})\n   406→\n   407→    # Get unique finding types for filter\n   408→    finding_types = sorted(set(f.get(\"finding_type\", \"other\") for f in findings))\n   409→\n   410→    # Prepare data for Alpine.js\n   411→    findings_data = []\n   412→    for i, f in enumerate(findings):\n   413→        conf = f.get(\"confidence_score\", 0.5)\n   414→        extracted = f.get(\"extracted_data\", {}) or {}\n   415→        # Build evidence details for drawers\n   416→        evidence_items = []\n   417→        if extracted.get(\"quotes\"):\n   418→            for q in extracted.get(\"quotes\", [])[:3]:\n   419→                evidence_items.append({\"type\": \"quote\", \"text\": q})\n   420→        if extracted.get(\"evidence\"):\n   421→            evidence_items.append({\"type\": \"evidence\", \"text\": str(extracted.get(\"evidence\"))})\n   422→        if extracted.get(\"source_text\"):\n   423→            evidence_items.append({\"type\": \"source_text\", \"text\": extracted.get(\"source_text\")[:300]})\n   424→\n   425→        findings_data.append({\n   426→            \"id\": i, \"type\": f.get(\"finding_type\", \"other\"),\n   427→            \"summary\": f.get(\"summary\") or f.get(\"content\", \"\")[:200],\n   428→            \"analysis\": f.get(\"analysis\", \"\"),  # Expert analytical commentary\n   429→            \"content\": f.get(\"content\", \"\"), \"confidence\": conf,\n   430→            \"conf_label\": \"high\" if conf >= 0.8 else \"medium\" if conf >= 0.6 else \"low\",\n   431→            \"date\": f.get(\"date_referenced\") or f.get(\"date_range\") or \"\",\n   432→            \"sources\": f.get(\"supporting_sources\", [])[:3],\n   433→            \"evidence\": evidence_items,\n   434→            \"extracted\": {\n   435→                \"amount\": extracted.get(\"amount\", \"\"),\n   436→                \"entity\": extracted.get(\"entity\", extracted.get(\"name\", \"\")),\n   437→                \"location\": extracted.get(\"location\", \"\"),\n   438→                \"metric\": extracted.get(\"metric\", \"\"),\n   439→            },\n   440→        })\n   441→\n   442→    sources_data = []\n   443→    for i, s in enumerate(sources):\n   444→        cred = s.get(\"credibility_score\", 0.5)\n   445→        sources_data.append({\n   446→            \"id\": i, \"url\": s.get(\"url\", \"#\"), \"title\": s.get(\"title\", \"Unknown\")[:60],\n   447→            \"domain\": s.get(\"domain\", \"\"), \"snippet\": s.get(\"snippet\", \"\")[:150],\n   448→            \"credibility\": cred,\n   449→            \"cred_label\": \"high\" if cred >= 0.8 else \"medium\" if cred >= 0.6 else \"low\",\n   450→            \"type\": s.get(\"source_type\", \"web\"),\n   451→        })\n   452→\n   453→    perspectives_data = []\n   454→    perspective_idx = 0\n   455→    for p in perspectives:\n   456→        analysis = p.get(\"analysis_text\", \"\")\n   457→        # Skip perspectives without valid analysis\n   458→        if not analysis or analysis.strip() == \"\" or analysis.lower() == \"analysis not available\":\n   459→            continue\n   460→        perspectives_data.append({\n   461→            \"id\": perspective_idx, \"type\": p.get(\"perspective_type\", \"unknown\"),\n   462→            \"analysis\": analysis,\n   463→            \"insights\": p.get(\"key_insights\", [])[:5],\n   464→            \"predictions\": p.get(\"predictions\", [])[:4],\n   465→            \"warnings\": p.get(\"warnings\", [])[:3],\n   466→            \"confidence\": p.get(\"confidence\", 0.5),\n   467→        })\n   468→        perspective_idx += 1\n   469→\n   470→    predictions_data = []\n   471→    for i, pred in enumerate(all_predictions[:12]):\n   472→        if isinstance(pred, dict):\n   473→            conf = pred.get(\"confidence\", \"medium\")\n   474→            if isinstance(conf, (int, float)):\n   475→                conf_label = \"high\" if conf >= 0.8 else \"medium\" if conf >= 0.5 else \"low\"\n   476→            else:\n   477→                conf_label = str(conf).lower() if conf else \"medium\"\n   478→            # Get supporting sources as list\n   479→            supporting_sources = pred.get(\"supporting_sources\", [])\n   480→            if isinstance(supporting_sources, str):\n   481→                supporting_sources = [supporting_sources]\n   482→            # Get agreeing perspectives (from deduplication)\n   483→            agreeing = pred.get(\"agreeing_perspectives\", [pred.get(\"source_perspective\", \"analyst\")])\n   484→            predictions_data.append({\n   485→                \"id\": i,\n   486→                \"prediction\": pred.get(\"prediction\", \"\"),\n   487→                \"rationale\": pred.get(\"rationale\", \"\"),\n   488→                \"confidence\": conf_label,\n   489→                \"timeline\": pred.get(\"timeline\", \"\"),\n   490→                \"source_perspective\": pred.get(\"source_perspective\", \"analyst\"),\n   491→                \"agreeing_perspectives\": agreeing,\n   492→                \"consensus_count\": len(agreeing),\n   493→                \"supporting_sources\": supporting_sources[:3],\n   494→            })\n   495→        else:\n   496→            predictions_data.append({\n   497→                \"id\": i, \"prediction\": str(pred), \"rationale\": \"\",\n   498→                \"confidence\": \"medium\", \"timeline\": \"\",\n   499→                \"source_perspective\": \"analyst\", \"agreeing_perspectives\": [\"analyst\"],\n   500→                \"consensus_count\": 1, \"supporting_sources\": []\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"05d3e4f1-2259-4f3e-a055-8040a34c8b02","uuid":"5fa199b5-d2b9-494b-866f-36fed56cf342","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\actor\\src\\services\\report_interactive.py","content":"\"\"\"Interactive HTML report generation with Alpine.js.\"\"\"\n\nfrom typing import Dict, Any, List\nfrom datetime import datetime\nimport html as html_mod\nimport json\n\nfrom .visualizations import (\n    NetworkVisualization, TimelineVisualization, MoneyFlowVisualization,\n    StakeholderImpactMatrix, PredictionTimeline, FinancialTables,\n    FeatureComparisonMatrix, ContractPricingTable, EvidenceChain\n)\n\n\ndef _generate_visualizations_html(result: Dict[str, Any]) -> str:\n    \"\"\"Generate visualization sections based on template type and available data.\"\"\"\n    template = result.get(\"template\", \"unknown\")\n    findings = result.get(\"findings\", [])\n\n    viz_sections = []\n\n    # Network visualization for investigative/competitive templates\n    if template in [\"investigative\", \"competitive\", \"legal\"]:\n        actors, relationships = NetworkVisualization.extract_network_data(findings)\n        if actors:\n            viz_sections.append('''\n                <div class=\"section\">\n                    <div class=\"section-header\">\n                        <span class=\"section-title\">Actor Network</span>\n                        <span class=\"section-count\">''' + str(len(actors)) + ''' actors</span>\n                    </div>\n                    <div class=\"section-body\">\n                        ''' + NetworkVisualization.generate_network_html(actors, relationships) + '''\n                    </div>\n                </div>\n            ''')\n\n    # Timeline visualization for investigative/financial/legal\n    if template in [\"investigative\", \"financial\", \"legal\", \"contract\"]:\n        streams = TimelineVisualization.extract_timeline_data(findings)\n        if streams:\n            total_events = sum(len(events) for events in streams.values())\n            viz_sections.append('''\n                <div class=\"section\">\n                    <div class=\"section-header\">\n                        <span class=\"section-title\">Event Timeline</span>\n                        <span class=\"section-count\">''' + str(total_events) + ''' events</span>\n                    </div>\n                    <div class=\"section-body\">\n                        ''' + TimelineVisualization.generate_timeline_html(streams) + '''\n                    </div>\n                </div>\n            ''')\n\n    # Money flow for investigative/financial/contract\n    if template in [\"investigative\", \"financial\", \"contract\"]:\n        flows = MoneyFlowVisualization.extract_flow_data(findings)\n        if flows:\n            viz_sections.append('''\n                <div class=\"section\">\n                    <div class=\"section-header\">\n                        <span class=\"section-title\">Financial Flows</span>\n                        <span class=\"section-count\">''' + str(len(flows)) + ''' transactions</span>\n                    </div>\n                    <div class=\"section-body\">\n                        ''' + MoneyFlowVisualization.generate_flow_html(flows) + '''\n                    </div>\n                </div>\n            ''')\n\n    # Stakeholder Impact Matrix for competitive/financial/legal\n    perspectives = result.get(\"perspectives\", [])\n    if template in [\"competitive\", \"financial\", \"legal\", \"tech_market\"]:\n        stakeholders = StakeholderImpactMatrix.extract_stakeholders(findings, perspectives)\n        if stakeholders and len(findings) > 0:\n            impact_data = StakeholderImpactMatrix.analyze_impacts(findings, stakeholders)\n            if impact_data:\n                viz_sections.append('''\n                <div class=\"section\">\n                    <div class=\"section-header\">\n                        <span class=\"section-title\">Stakeholder Impact Analysis</span>\n                        <span class=\"section-count\">''' + str(len(stakeholders)) + ''' stakeholders</span>\n                    </div>\n                    <div class=\"section-body\">\n                        ''' + StakeholderImpactMatrix.generate_matrix_html(impact_data, stakeholders) + '''\n                    </div>\n                </div>\n            ''')\n\n    # Prediction Timeline for tech_market/financial\n    if template in [\"tech_market\", \"financial\", \"competitive\"]:\n        grouped_predictions = PredictionTimeline.group_predictions_by_timeline(perspectives)\n        if grouped_predictions:\n            total_preds = sum(len(preds) for preds in grouped_predictions.values())\n            viz_sections.append('''\n                <div class=\"section\">\n                    <div class=\"section-header\">\n                        <span class=\"section-title\">Prediction Timeline</span>\n                        <span class=\"section-count\">''' + str(total_preds) + ''' predictions</span>\n                    </div>\n                    <div class=\"section-body\">\n                        ''' + PredictionTimeline.generate_timeline_html(grouped_predictions) + '''\n                    </div>\n                </div>\n            ''')\n\n    # Financial Tables for financial template\n    if template == \"financial\":\n        metrics = FinancialTables.extract_financial_metrics(findings)\n        if any(metrics.values()):\n            viz_sections.append('''\n                <div class=\"section\">\n                    <div class=\"section-header\">\n                        <span class=\"section-title\">Financial Metrics</span>\n                    </div>\n                    <div class=\"section-body\">\n                        ''' + FinancialTables.generate_financial_table_html(metrics) + '''\n                    </div>\n                </div>\n            ''')\n\n    # Feature Comparison Matrix for tech_market\n    if template == \"tech_market\":\n        products = FeatureComparisonMatrix.extract_features(findings)\n        if products:\n            viz_sections.append('''\n                <div class=\"section\">\n                    <div class=\"section-header\">\n                        <span class=\"section-title\">Feature Comparison</span>\n                        <span class=\"section-count\">''' + str(len(products)) + ''' products</span>\n                    </div>\n                    <div class=\"section-body\">\n                        ''' + FeatureComparisonMatrix.generate_comparison_html(products) + '''\n                    </div>\n                </div>\n            ''')\n\n    # Contract Pricing Table for contract template\n    if template == \"contract\":\n        pricing = ContractPricingTable.extract_pricing_data(findings)\n        if pricing:\n            viz_sections.append('''\n                <div class=\"section\">\n                    <div class=\"section-header\">\n                        <span class=\"section-title\">Pricing Analysis</span>\n                        <span class=\"section-count\">''' + str(len(pricing)) + ''' items</span>\n                    </div>\n                    <div class=\"section-body\">\n                        ''' + ContractPricingTable.generate_pricing_table_html(pricing) + '''\n                    </div>\n                </div>\n            ''')\n\n    # Evidence Chain for investigative template\n    if template == \"investigative\":\n        chain = EvidenceChain.build_evidence_chain(findings)\n        if chain:\n            viz_sections.append('''\n                <div class=\"section\">\n                    <div class=\"section-header\">\n                        <span class=\"section-title\">Evidence Chain</span>\n                        <span class=\"section-count\">''' + str(len(chain)) + ''' claims</span>\n                    </div>\n                    <div class=\"section-body\">\n                        ''' + EvidenceChain.generate_chain_html(chain) + '''\n                    </div>\n                </div>\n            ''')\n\n    if not viz_sections:\n        return '<div class=\"empty-state\">No visualization data available for this research type</div>'\n\n    return '\\n'.join(viz_sections)\n\n\ndef _has_visualization_data(result: Dict[str, Any]) -> bool:\n    \"\"\"Check if there's data available for visualizations.\"\"\"\n    template = result.get(\"template\", \"unknown\")\n    findings = result.get(\"findings\", [])\n\n    # Check for actor/relationship data\n    if template in [\"investigative\", \"competitive\", \"legal\"]:\n        actors, _ = NetworkVisualization.extract_network_data(findings)\n        if actors:\n            return True\n\n    # Check for timeline data\n    if template in [\"investigative\", \"financial\", \"legal\", \"contract\"]:\n        streams = TimelineVisualization.extract_timeline_data(findings)\n        if streams:\n            return True\n\n    # Check for money flow data\n    if template in [\"investigative\", \"financial\", \"contract\"]:\n        flows = MoneyFlowVisualization.extract_flow_data(findings)\n        if flows:\n            return True\n\n    # Check for stakeholder impact data\n    perspectives = result.get(\"perspectives\", [])\n    if template in [\"competitive\", \"financial\", \"legal\", \"tech_market\"]:\n        stakeholders = StakeholderImpactMatrix.extract_stakeholders(findings, perspectives)\n        if stakeholders and len(findings) > 0:\n            return True\n\n    return False\n\n\ndef _generate_decision_summary_html(result: Dict[str, Any], findings: List[Dict], perspectives: List[Dict], red_flags: List[Dict], avg_conf: float) -> str:\n    \"\"\"Generate Executive Decision Summary - the first thing busy decision-makers see.\n\n    This summary provides:\n    1. Bottom line recommendation\n    2. Confidence level\n    3. Key assumptions (what must be true)\n    4. Kill criteria (when to reverse)\n    5. Suggested action\n    \"\"\"\n    template = result.get(\"template\", \"unknown\")\n    query = result.get(\"query\", \"\")\n\n    # Only show decision summary for actionable templates\n    actionable_templates = [\"financial\", \"tech_market\", \"competitive\", \"due_diligence\", \"purchase_decision\"]\n    if template not in actionable_templates:\n        return \"\"\n\n    # Determine sentiment from findings\n    bullish = [f for f in findings if f.get(\"finding_type\") in [\"bullish_signal\", \"positive\", \"strength\", \"opportunity\"]]\n    bearish = [f for f in findings if f.get(\"finding_type\") in [\"bearish_signal\", \"risk\", \"red_flag\", \"weakness\", \"threat\"]]\n\n    # Calculate sentiment score\n    bullish_weight = len(bullish) * 1.0\n    bearish_weight = len(bearish) * 1.5  # Weight bearish signals higher for conservatism\n    red_flag_weight = len(red_flags) * 2.0\n\n    if bullish_weight + bearish_weight + red_flag_weight == 0:\n        sentiment_score = 0.5\n    else:\n        sentiment_score = bullish_weight / (bullish_weight + bearish_weight + red_flag_weight)\n\n    # Determine recommendation\n    if len(red_flags) >= 3:\n        recommendation = \"AVOID\"\n        rec_class = \"avoid\"\n        rec_detail = \"Multiple red flags detected - proceed with extreme caution\"\n    elif sentiment_score >= 0.7 and avg_conf >= 0.7:\n        recommendation = \"POSITIVE\"\n        rec_class = \"positive\"\n        rec_detail = \"Strong positive signals with high confidence\"\n    elif sentiment_score >= 0.5:\n        recommendation = \"NEUTRAL\"\n        rec_class = \"neutral\"\n        rec_detail = \"Mixed signals - additional research recommended\"\n    else:\n        recommendation = \"CAUTIOUS\"\n        rec_class = \"cautious\"\n        rec_detail = \"Significant concerns identified\"\n\n    # Confidence level\n    conf_pct = int(avg_conf * 100)\n    conf_label = \"High\" if avg_conf >= 0.8 else \"Medium\" if avg_conf >= 0.6 else \"Low\"\n\n    # Extract key assumptions from high-confidence positive findings\n    assumptions = []\n    for f in bullish[:3]:\n        summary = f.get(\"summary\") or f.get(\"content\", \"\")[:200]\n        if summary:\n            assumptions.append(html_mod.escape(summary))\n\n    # Extract kill criteria from risks and warnings\n    kill_criteria = []\n    for f in (bearish + red_flags)[:3]:\n        summary = f.get(\"summary\") or f.get(\"content\", \"\")[:200]\n        if summary:\n            kill_criteria.append(html_mod.escape(summary))\n\n    # Also check short seller perspective for kill criteria\n    short_seller = next((p for p in perspectives if \"short\" in p.get(\"perspective_type\", \"\").lower()), None)\n    if short_seller:\n        for warning in short_seller.get(\"warnings\", [])[:2]:\n            kill_criteria.append(html_mod.escape(warning))\n\n    # Build assumptions HTML\n    assumptions_html = \"\"\n    if assumptions:\n        assumptions_items = \"\".join([f'<li>{a}</li>' for a in assumptions[:3]])\n        assumptions_html = f'<div class=\"ds-section\"><div class=\"ds-section-title\">Key Assumptions</div><ul class=\"ds-list\">{assumptions_items}</ul></div>'\n\n    # Build kill criteria HTML\n    kill_html = \"\"\n    if kill_criteria:\n        kill_items = \"\".join([f'<li>{k}</li>' for k in kill_criteria[:3]])\n        kill_html = f'<div class=\"ds-section\"><div class=\"ds-section-title\">Kill Criteria (Reverse If...)</div><ul class=\"ds-list ds-list-warning\">{kill_items}</ul></div>'\n\n    return f'''\n    <div class=\"decision-summary\">\n        <div class=\"ds-header\">\n            <div class=\"ds-title\">\n                <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"/><polyline points=\"22 4 12 14.01 9 11.01\"/></svg>\n                Decision Summary\n            </div>\n            <div class=\"ds-badge ds-badge-{rec_class}\">{recommendation}</div>\n        </div>\n        <div class=\"ds-body\">\n            <div class=\"ds-main\">\n                <div class=\"ds-recommendation\">\n                    <span class=\"ds-rec-label\">Assessment:</span>\n                    <span class=\"ds-rec-value\">{rec_detail}</span>\n                </div>\n                <div class=\"ds-confidence\">\n                    <span class=\"ds-conf-label\">Confidence:</span>\n                    <span class=\"ds-conf-value\">{conf_label} ({conf_pct}%)</span>\n                    <div class=\"ds-conf-bar\"><div class=\"ds-conf-fill ds-conf-{conf_label.lower()}\" style=\"width: {conf_pct}%\"></div></div>\n                </div>\n            </div>\n            <div class=\"ds-details\">\n                {assumptions_html}\n                {kill_html}\n            </div>\n        </div>\n        <div class=\"ds-footer\">\n            <span>Based on {len(findings)} findings from {len(result.get(\"sources\", []))} sources</span>\n            <span class=\"ds-footer-note\">Review full analysis below for complete context</span>\n        </div>\n    </div>\n    '''\n\n\ndef generate_interactive_html(result: Dict[str, Any], title: str, current_date: str = None) -> str:\n    \"\"\"Generate interactive HTML report with tabs, filters, search, and compact table views.\n\n    Args:\n        result: Research result dictionary\n        title: Report title\n        current_date: Current date string for date-aware content (e.g., \"January 2025\")\n    \"\"\"\n    if current_date is None:\n        current_date = datetime.now().strftime(\"%B %Y\")\n\n    query = result.get(\"query\", \"Unknown Query\")\n    template = result.get(\"template\", \"unknown\")\n    status = result.get(\"status\", \"unknown\")\n    findings = result.get(\"findings\", [])\n    perspectives = result.get(\"perspectives\", [])\n    sources = result.get(\"sources\", [])\n    cost = result.get(\"cost_summary\", {})\n    search_queries = result.get(\"search_queries_executed\", [])\n\n    # Calculate metrics\n    high_conf = len([f for f in findings if f.get(\"confidence_score\", 0) >= 0.8])\n    med_conf = len([f for f in findings if 0.6 <= f.get(\"confidence_score\", 0) < 0.8])\n    low_conf = len([f for f in findings if f.get(\"confidence_score\", 0) < 0.6])\n    red_flags = [f for f in findings if f.get(\"finding_type\") in [\"red_flag\", \"suspicious_element\"]]\n    high_cred = len([s for s in sources if s.get(\"credibility_score\", 0) >= 0.8])\n\n    # Calculate average confidence\n    avg_conf = sum(f.get(\"confidence_score\", 0.5) for f in findings) / max(len(findings), 1)\n    avg_conf_pct = int(avg_conf * 100)\n    avg_conf_label = \"high\" if avg_conf >= 0.8 else \"medium\" if avg_conf >= 0.6 else \"low\"\n\n    exec_time = result.get(\"execution_time_seconds\", 0)\n    total_cost = cost.get(\"total_cost_usd\", 0)\n    total_tokens = cost.get(\"total_tokens\", 0)\n\n    # Collect predictions with source attribution\n    raw_predictions = []\n    for p in perspectives:\n        perspective_type = p.get(\"perspective_type\", \"analyst\")\n        for pred in p.get(\"predictions\", []):\n            if isinstance(pred, dict):\n                pred_with_source = pred.copy()\n                pred_with_source[\"source_perspective\"] = perspective_type\n            else:\n                pred_with_source = {\"prediction\": str(pred), \"source_perspective\": perspective_type}\n            raw_predictions.append(pred_with_source)\n\n    # Deduplicate predictions by grouping similar ones\n    seen_predictions = {}\n    for pred in raw_predictions:\n        pred_text = pred.get(\"prediction\", \"\")\n        # Create a normalized key for comparison (first 50 chars, lowercase, stripped)\n        key = pred_text[:50].lower().strip()\n        if key in seen_predictions:\n            # Add this perspective to existing prediction\n            existing = seen_predictions[key]\n            existing_perspectives = existing.get(\"agreeing_perspectives\", [existing.get(\"source_perspective\", \"analyst\")])\n            new_perspective = pred.get(\"source_perspective\", \"analyst\")\n            if new_perspective not in existing_perspectives:\n                existing_perspectives.append(new_perspective)\n            existing[\"agreeing_perspectives\"] = existing_perspectives\n            # Keep the higher confidence\n            new_conf = pred.get(\"confidence\", \"medium\")\n            existing_conf = existing.get(\"confidence\", \"medium\")\n            conf_order = {\"high\": 3, \"medium\": 2, \"low\": 1}\n            if conf_order.get(new_conf, 2) > conf_order.get(existing_conf, 2):\n                existing[\"confidence\"] = new_conf\n        else:\n            pred[\"agreeing_perspectives\"] = [pred.get(\"source_perspective\", \"analyst\")]\n            seen_predictions[key] = pred\n\n    all_predictions = list(seen_predictions.values())\n\n    # Get intelligence analysis results\n    contradictions = result.get(\"contradictions\", [])\n    role_summaries = result.get(\"role_summaries\", {})\n\n    # Get unique finding types for filter\n    finding_types = sorted(set(f.get(\"finding_type\", \"other\") for f in findings))\n\n    # Prepare data for Alpine.js\n    findings_data = []\n    for i, f in enumerate(findings):\n        conf = f.get(\"confidence_score\", 0.5)\n        extracted = f.get(\"extracted_data\", {}) or {}\n        # Build evidence details for drawers\n        evidence_items = []\n        if extracted.get(\"quotes\"):\n            for q in extracted.get(\"quotes\", [])[:3]:\n                evidence_items.append({\"type\": \"quote\", \"text\": q})\n        if extracted.get(\"evidence\"):\n            evidence_items.append({\"type\": \"evidence\", \"text\": str(extracted.get(\"evidence\"))})\n        if extracted.get(\"source_text\"):\n            evidence_items.append({\"type\": \"source_text\", \"text\": extracted.get(\"source_text\")[:300]})\n\n        findings_data.append({\n            \"id\": i, \"type\": f.get(\"finding_type\", \"other\"),\n            \"summary\": f.get(\"summary\") or f.get(\"content\", \"\")[:200],\n            \"analysis\": f.get(\"analysis\", \"\"),  # Expert analytical commentary\n            \"content\": f.get(\"content\", \"\"), \"confidence\": conf,\n            \"conf_label\": \"high\" if conf >= 0.8 else \"medium\" if conf >= 0.6 else \"low\",\n            \"date\": f.get(\"date_referenced\") or f.get(\"date_range\") or \"\",\n            \"sources\": f.get(\"supporting_sources\", [])[:3],\n            \"evidence\": evidence_items,\n            \"extracted\": {\n                \"amount\": extracted.get(\"amount\", \"\"),\n                \"entity\": extracted.get(\"entity\", extracted.get(\"name\", \"\")),\n                \"location\": extracted.get(\"location\", \"\"),\n                \"metric\": extracted.get(\"metric\", \"\"),\n            },\n        })\n\n    sources_data = []\n    for i, s in enumerate(sources):\n        cred = s.get(\"credibility_score\", 0.5)\n        sources_data.append({\n            \"id\": i, \"url\": s.get(\"url\", \"#\"), \"title\": s.get(\"title\", \"Unknown\")[:60],\n            \"domain\": s.get(\"domain\", \"\"), \"snippet\": s.get(\"snippet\", \"\")[:150],\n            \"credibility\": cred,\n            \"cred_label\": \"high\" if cred >= 0.8 else \"medium\" if cred >= 0.6 else \"low\",\n            \"type\": s.get(\"source_type\", \"web\"),\n        })\n\n    perspectives_data = []\n    perspective_idx = 0\n    for p in perspectives:\n        analysis = p.get(\"analysis_text\", \"\")\n        # Skip perspectives without valid analysis\n        if not analysis or analysis.strip() == \"\" or analysis.lower() == \"analysis not available\":\n            continue\n        perspectives_data.append({\n            \"id\": perspective_idx, \"type\": p.get(\"perspective_type\", \"unknown\"),\n            \"analysis\": analysis,\n            \"insights\": p.get(\"key_insights\", [])[:5],\n            \"predictions\": p.get(\"predictions\", [])[:4],\n            \"warnings\": p.get(\"warnings\", [])[:3],\n            \"confidence\": p.get(\"confidence\", 0.5),\n        })\n        perspective_idx += 1\n\n    predictions_data = []\n    for i, pred in enumerate(all_predictions[:12]):\n        if isinstance(pred, dict):\n            conf = pred.get(\"confidence\", \"medium\")\n            if isinstance(conf, (int, float)):\n                conf_label = \"high\" if conf >= 0.8 else \"medium\" if conf >= 0.5 else \"low\"\n            else:\n                conf_label = str(conf).lower() if conf else \"medium\"\n            # Get supporting sources as list\n            supporting_sources = pred.get(\"supporting_sources\", [])\n            if isinstance(supporting_sources, str):\n                supporting_sources = [supporting_sources]\n            # Get agreeing perspectives (from deduplication)\n            agreeing = pred.get(\"agreeing_perspectives\", [pred.get(\"source_perspective\", \"analyst\")])\n            predictions_data.append({\n                \"id\": i,\n                \"prediction\": pred.get(\"prediction\", \"\"),\n                \"rationale\": pred.get(\"rationale\", \"\"),\n                \"confidence\": conf_label,\n                \"timeline\": pred.get(\"timeline\", \"\"),\n                \"source_perspective\": pred.get(\"source_perspective\", \"analyst\"),\n                \"agreeing_perspectives\": agreeing,\n                \"consensus_count\": len(agreeing),\n                \"supporting_sources\": supporting_sources[:3],\n            })\n        else:\n            predictions_data.append({\n                \"id\": i, \"prediction\": str(pred), \"rationale\": \"\",\n                \"confidence\": \"medium\", \"timeline\": \"\",\n                \"source_perspective\": \"analyst\", \"agreeing_perspectives\": [\"analyst\"],\n                \"consensus_count\": 1, \"supporting_sources\": []","numLines":500,"startLine":1,"totalLines":1297}}}
