[2026-01-29T23:29:03.331Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PwoM4osACtGn5z5xFMtxXQ","type":"tool_result","content":"     1→\"\"\"Deep Research Actor - Main entry point.\n     2→\n     3→This actor performs AI-powered deep research using Gemini with Google Search grounding.\n     4→\"\"\"\n     5→\n     6→import asyncio\n     7→import base64\n     8→import logging\n     9→import os\n    10→from datetime import datetime\n    11→from typing import Optional\n    12→\n    13→from .config import override_settings, get_settings\n    14→from .schemas import ActorInput, ActorOutput, ExecutiveSummary, Finding, Source, Perspective, Prediction, CostSummary\n    15→from .clients import GeminiClient, OpenRouterClient, SupabaseClient, ResendClient, CloudRunClient, R2Client\n    16→from .services import OCRService, ResearchService, ReportService, ProgressEmitter, StateManager\n    17→from .services.transform import transform_research_result\n    18→\n    19→\n    20→# Auto-select best report variant for each template\n    21→TEMPLATE_REPORT_VARIANTS = {\n    22→    \"tech_market\": \"full_report\",\n    23→    \"financial\": \"investment_thesis\",\n    24→    \"competitive\": \"full_report\",\n    25→    \"investigative\": \"full_report\",\n    26→    \"legal\": \"full_report\",\n    27→    \"contract\": \"decision_brief\",\n    28→    \"understanding\": \"credibility_report\",\n    29→    \"due_diligence\": \"risk_summary\",\n    30→    \"purchase_decision\": \"buyer_guide\",\n    31→    \"reputation\": \"trust_report\",\n    32→}\n    33→\n    34→\n    35→def get_report_variant_for_template(template: str) -> str:\n    36→    \"\"\"Get the best report variant for a given template.\"\"\"\n    37→    return TEMPLATE_REPORT_VARIANTS.get(template, \"full_report\")\n    38→\n    39→# Configure logging\n    40→logging.basicConfig(\n    41→    level=logging.INFO,\n    42→    format=\"%(asctime)s [%(levelname)s] %(name)s: %(message)s\"\n    43→)\n    44→logger = logging.getLogger(__name__)\n    45→\n    46→\n    47→def build_executive_summary(output: ActorOutput) -> ExecutiveSummary:\n    48→    \"\"\"Build executive summary from actor output.\"\"\"\n    49→    # Count high confidence findings\n    50→    high_conf_findings = [f for f in output.findings if f.confidence_score >= 0.8]\n    51→\n    52→    # Count high credibility sources\n    53→    high_cred_sources = [s for s in output.sources if s.credibility_score and s.credibility_score >= 0.8]\n    54→\n    55→    # Get top 5 findings by confidence\n    56→    sorted_findings = sorted(output.findings, key=lambda f: f.confidence_score, reverse=True)\n    57→    top_findings = [\n    58→        f.summary or f.content[:100] + \"...\" if len(f.content) > 100 else f.content\n    59→        for f in sorted_findings[:5]\n    60→    ]\n    61→\n    62→    # Aggregate expert recommendations, warnings, insights\n    63→    all_recommendations = []\n    64→    all_warnings = []\n    65→    all_insights = []\n    66→\n    67→    for p in output.perspectives:\n    68→        all_recommendations.extend(p.recommendations[:2])  # Top 2 per perspective\n    69→        all_warnings.extend(p.warnings[:1])  # Top 1 per perspective\n    70→        all_insights.extend(p.key_insights[:2])  # Top 2 per perspective\n    71→\n    72→    # Deduplicate and limit\n    73→    seen_recs = set()\n    74→    unique_recommendations = []\n    75→    for r in all_recommendations:\n    76→        if r.lower() not in seen_recs:\n    77→            seen_recs.add(r.lower())\n    78→            unique_recommendations.append(r)\n    79→            if len(unique_recommendations) >= 5:\n    80→                break\n    81→\n    82→    seen_warnings = set()\n    83→    unique_warnings = []\n    84→    for w in all_warnings:\n    85→        if w.lower() not in seen_warnings:\n    86→            seen_warnings.add(w.lower())\n    87→            unique_warnings.append(w)\n    88→            if len(unique_warnings) >= 3:\n    89→                break\n    90→\n    91→    seen_insights = set()\n    92→    unique_insights = []\n    93→    for i in all_insights:\n    94→        if i.lower() not in seen_insights:\n    95→            seen_insights.add(i.lower())\n    96→            unique_insights.append(i)\n    97→            if len(unique_insights) >= 5:\n    98→                break\n    99→\n   100→    # Report preview\n   101→    report_preview = \"\"\n   102→    if output.report_markdown:\n   103→        report_preview = output.report_markdown[:500]\n   104→        if len(output.report_markdown) > 500:\n   105→            report_preview += \"...\"\n   106→\n   107→    return ExecutiveSummary(\n   108→        session_id=output.session_id,\n   109→        query=output.query,\n   110→        template=output.template,\n   111→        status=output.status,\n   112→        findings_count=len(output.findings),\n   113→        high_confidence_findings=len(high_conf_findings),\n   114→        sources_count=len(output.sources),\n   115→        high_credibility_sources=len(high_cred_sources),\n   116→        perspectives_count=len(output.perspectives),\n   117→        top_findings=top_findings,\n   118→        expert_recommendations=unique_recommendations,\n   119→        expert_warnings=unique_warnings,\n   120→        key_insights=unique_insights,\n   121→        report_preview=report_preview,\n   122→        total_cost_usd=output.cost_summary.total_cost_usd,\n   123→        execution_time_seconds=output.execution_time_seconds,\n   124→        completed_at=output.completed_at,\n   125→    )\n   126→\n   127→\n   128→async def run_actor(\n   129→    actor_input: ActorInput,\n   130→    progress_emitter: Optional[ProgressEmitter] = None,\n   131→) -> ActorOutput:\n   132→    \"\"\"\n   133→    Execute the Deep Research Actor.\n   134→\n   135→    Args:\n   136→        actor_input: Validated input parameters\n   137→        progress_emitter: Optional unified progress emitter for status and webhook events\n   138→\n   139→    Returns:\n   140→        ActorOutput with research results\n   141→    \"\"\"\n   142→    started_at = datetime.utcnow()\n   143→    logger.info(f\"Starting research: {actor_input.query[:50]}...\")\n   144→\n   145→    # Get settings with overrides\n   146→    settings = override_settings(\n   147→        google_api_key=actor_input.google_api_key,\n   148→        openrouter_api_key=actor_input.openrouter_api_key,\n   149→        supabase_url=actor_input.supabase_url,\n   150→        supabase_key=actor_input.supabase_key,\n   151→        resend_api_key=actor_input.resend_api_key,\n   152→        cloud_run_url=actor_input.cloud_run_url,\n   153→    )\n   154→\n   155→    # Validate required API key\n   156→    if not settings.google_api_key:\n   157→        return ActorOutput(\n   158→            session_id=\"error\",\n   159→            query=actor_input.query,\n   160→            template=actor_input.template,\n   161→            status=\"failed\",\n   162→            errors=[\"Google API key is required. Set GOOGLE_API_KEY env var or provide in input.\"],\n   163→            started_at=started_at,\n   164→            completed_at=datetime.utcnow(),\n   165→        )\n   166→\n   167→    \n   168→    # === CLOUD RUN DISPATCH (fire-and-forget mode) ===\n   169→    # Dispatch to Cloud Run and return immediately - Cloud Run handles everything\n   170→    if settings.cloud_run_url:\n   171→        logger.info(f\"Dispatching to Cloud Run (fire-and-forget): {settings.cloud_run_url}\")\n   172→\n   173→        try:\n   174→            # Initialize R2 client for report storage (if configured)\n   175→            r2_client = None\n   176→            report_url = None\n   177→            job_id = None\n   178→\n   179→            if settings.r2_account_id and settings.r2_access_key_id and settings.r2_secret_access_key:\n   180→                try:\n   181→                    r2_client = R2Client(\n   182→                        account_id=settings.r2_account_id,\n   183→                        access_key_id=settings.r2_access_key_id,\n   184→                        secret_access_key=settings.r2_secret_access_key,\n   185→                        bucket_name=settings.r2_bucket_name,\n   186→                        public_url_base=settings.r2_public_url or None,\n   187→                    )\n   188→\n   189→                    # Generate job_id and upload placeholder\n   190→                    job_id = r2_client.generate_job_id(actor_input.query, actor_input.template)\n   191→                    report_url = r2_client.upload_placeholder(\n   192→                        job_id=job_id,\n   193→                        query=actor_input.query,\n   194→                        template=actor_input.template,\n   195→                    )\n   196→                    logger.info(f\"Placeholder uploaded to R2: {report_url}\")\n   197→\n   198→                except Exception as e:\n   199→                    logger.warning(f\"R2 placeholder upload failed (continuing without): {e}\")\n   200→                    r2_client = None\n   201→\n   202→            cloud_run_client = CloudRunClient(\n   203→                service_url=settings.cloud_run_url,\n   204→                dispatch_timeout=15,  # Short timeout for acknowledgment only\n   205→            )\n   206→\n   207→            # Auto-select best report variant for template\n   208→            report_variant = get_report_variant_for_template(actor_input.template)\n   209→\n   210→            # Fire-and-forget dispatch - Cloud Run handles research, report, email, R2 upload\n   211→            dispatch_result = await cloud_run_client.dispatch_async(\n   212→                query=actor_input.query,\n   213→                template=actor_input.template,\n   214→                granularity=actor_input.granularity,\n   215→                max_searches=actor_input.get_max_searches(),\n   216→                perspectives=actor_input.perspectives,\n   217→                input_file_url=actor_input.input_file_url,\n   218→                input_text=actor_input.input_text,\n   219→                workspace_id=actor_input.workspace_id,\n   220→                gemini_api_key=settings.google_api_key,\n   221→                supabase_url=settings.supabase_url,\n   222→                supabase_key=settings.supabase_key,\n   223→                resend_api_key=settings.resend_api_key,\n   224→                # Report options\n   225→                generate_report=actor_input.generate_report,\n   226→                report_format=actor_input.report_format,\n   227→                report_variant=report_variant,\n   228→                report_title=actor_input.report_title,\n   229→                # Email options\n   230→                send_email=actor_input.send_email,\n   231→                email_to=actor_input.email_to,\n   232→                email_subject=actor_input.email_subject,\n   233→                # Progress webhook\n   234→                callback_url=actor_input.progress_webhook_url,\n   235→                # R2 config for Cloud Run to upload final report\n   236→                r2_job_id=job_id,\n   237→                r2_account_id=settings.r2_account_id if r2_client else None,\n   238→                r2_access_key_id=settings.r2_access_key_id if r2_client else None,\n   239→                r2_secret_access_key=settings.r2_secret_access_key if r2_client else None,\n   240→                r2_bucket_name=settings.r2_bucket_name if r2_client else None,\n   241→                r2_public_url=settings.r2_public_url if r2_client else None,\n   242→            )\n   243→\n   244→            await cloud_run_client.close()\n   245→\n   246→            # Use job_id from R2 if available, otherwise from dispatch result\n   247→            final_job_id = job_id or dispatch_result.get(\"job_id\", \"unknown\")\n   248→            logger.info(f\"Cloud Run job dispatched: {final_job_id}\")\n   249→\n   250→            # Return immediately with dispatched status and report URL\n   251→            return ActorOutput(\n   252→                session_id=final_job_id,\n   253→                query=actor_input.query,\n   254→                template=actor_input.template,\n   255→                status=\"processing\",  # More accurate than \"dispatched\"\n   256→                findings=[],\n   257→                perspectives=[],\n   258→                sources=[],\n   259→                search_queries_executed=[],\n   260→                report_markdown=None,\n   261→                report_html=None,\n   262→                report_url=report_url,  # Pre-generated URL with placeholder\n   263→                cost_summary=CostSummary(\n   264→                    total_cost_usd=0.005,  # Minimal Apify compute cost\n   265→                    gemini_cost_usd=0,\n   266→                    gemini_tokens_used=0,\n   267→                    searches_performed=0,\n   268→                ),\n   269→                execution_time_seconds=0,\n   270→                errors=[],\n   271→                warnings=[\"Research is processing. Visit report_url to view results when ready.\" if report_url else \"Research dispatched to Cloud Run.\"],\n   272→                started_at=started_at,\n   273→                completed_at=datetime.utcnow(),\n   274→                cache_hit=False,\n   275→                cache_extended=False,\n   276→            )\n   277→\n   278→        except Exception as e:\n   279→            logger.warning(f\"Cloud Run dispatch failed, falling back to local: {e}\")\n   280→            # Fall through to local execution\n   281→\n   282→    # === LOCAL EXECUTION (fallback or when Cloud Run not configured) ===\n   283→    # Initialize clients\n   284→    try:\n   285→        gemini_client = GeminiClient(\n   286→            api_key=settings.google_api_key,\n   287→            model=settings.gemini_model,\n   288→        )\n   289→    except Exception as e:\n   290→        return ActorOutput(\n   291→            session_id=\"error\",\n   292→            query=actor_input.query,\n   293→            template=actor_input.template,\n   294→            status=\"failed\",\n   295→            errors=[f\"Failed to initialize Gemini client: {str(e)}\"],\n   296→            started_at=started_at,\n   297→            completed_at=datetime.utcnow(),\n   298→        )\n   299→\n   300→    # Optional: OpenRouter for OCR\n   301→    ocr_service = None\n   302→    if settings.openrouter_api_key:\n   303→        try:\n   304→            openrouter_client = OpenRouterClient(\n   305→                api_key=settings.openrouter_api_key,\n   306→                base_url=settings.openrouter_base_url,\n   307→                model=settings.openrouter_ocr_model,\n   308→            )\n   309→            ocr_service = OCRService(openrouter_client)\n   310→        except Exception as e:\n   311→            logger.warning(f\"Failed to initialize OCR service: {e}\")\n   312→\n   313→    # Optional: Supabase for persistence\n   314→    supabase_client = None\n   315→    if actor_input.save_to_supabase and settings.supabase_url and settings.supabase_key:\n   316→        try:\n   317→            supabase_client = SupabaseClient(\n   318→                url=settings.supabase_url,\n   319→                key=settings.supabase_key,\n   320→                workspace_id=actor_input.workspace_id,\n   321→            )\n   322→        except Exception as e:\n   323→            logger.warning(f\"Failed to initialize Supabase client: {e}\")\n   324→\n   325→    # Initialize research service with progress emitter\n   326→    research_service = ResearchService(\n   327→        gemini_client=gemini_client,\n   328→        supabase_client=supabase_client,\n   329→        ocr_service=ocr_service,\n   330→        progress_emitter=progress_emitter,\n   331→    )\n   332→\n   333→    # Execute research\n   334→    try:\n   335→        # Get intent configuration for tailored research\n   336→        intent_config = actor_input.get_intent_config() if actor_input.intent else None\n   337→\n   338→        result = await research_service.execute_research(\n   339→            query=actor_input.query,\n   340→            template_type=actor_input.template,\n   341→            granularity=actor_input.granularity,\n   342→            max_searches=actor_input.max_searches,\n   343→            perspectives=actor_input.perspectives,\n   344→            input_file_url=actor_input.input_file_url,\n   345→            input_text=actor_input.input_text,\n   346→            save_to_db=actor_input.save_to_supabase and supabase_client is not None,\n   347→            workspace_id=actor_input.workspace_id,\n   348→            use_cache=actor_input.use_cache,\n   349→            extend_cache=actor_input.extend_cache,\n   350→            intent=actor_input.intent,\n   351→            intent_config=intent_config,\n   352→        )\n   353→    except Exception as e:\n   354→        logger.error(f\"Research failed: {e}\")\n   355→        return ActorOutput(\n   356→            session_id=\"error\",\n   357→            query=actor_input.query,\n   358→            template=actor_input.template,\n   359→            status=\"failed\",\n   360→            errors=[f\"Research execution failed: {str(e)}\"],\n   361→            started_at=started_at,\n   362→            completed_at=datetime.utcnow(),\n   363→        )\n   364→\n   365→    # Generate report if requested\n   366→    report_markdown = None\n   367→    report_html = None\n   368→\n   369→    if actor_input.generate_report:\n   370→        try:\n   371→            # Emit report started\n   372→            if progress_emitter:\n   373→                await progress_emitter.report_started(actor_input.report_variant, actor_input.report_format)\n   374→\n   375→            report_service = ReportService()\n   376→            report_markdown = report_service.generate_markdown(\n   377→                research_result=result,\n   378→                variant=actor_input.report_variant,\n   379→                title=actor_input.report_title,\n   380→            )\n   381→\n   382→            if actor_input.report_format == \"html\":\n   383→                report_html = report_service.generate_html(\n   384→                    markdown_content=report_markdown,\n   385→                    title=actor_input.report_title or f\"Research: {actor_input.query[:40]}\",\n   386→                    research_result=result,\n   387→                )\n   388→\n   389→            # Emit report completed\n   390→            if progress_emitter:\n   391→                await progress_emitter.report_completed(len(report_markdown) if report_markdown else 0)\n   392→        except Exception as e:\n   393→            logger.warning(f\"Report generation failed: {e}\")\n   394→            result.setdefault(\"warnings\", []).append(f\"Report generation failed: {str(e)}\")\n   395→\n   396→    # Build output using transform pipeline\n   397→    completed_at = datetime.utcnow()\n   398→    transformed = transform_research_result(result)\n   399→\n   400→    return ActorOutput(\n   401→        session_id=result.get(\"session_id\", \"unknown\"),\n   402→        query=actor_input.query,\n   403→        template=actor_input.template,\n   404→        status=result.get(\"status\", \"completed\"),\n   405→        findings=transformed.findings,\n   406→        perspectives=transformed.perspectives,\n   407→        sources=transformed.sources,\n   408→        search_queries_executed=result.get(\"search_queries_executed\", []),\n   409→        report_markdown=report_markdown,\n   410→        report_html=report_html,\n   411→        cost_summary=transformed.cost_summary,\n   412→        execution_time_seconds=result.get(\"execution_time_seconds\", 0),\n   413→        supabase_session_id=result.get(\"supabase_session_id\"),\n   414→        errors=result.get(\"errors\", []),\n   415→        warnings=result.get(\"warnings\", []),\n   416→        started_at=started_at,\n   417→        completed_at=completed_at,\n   418→        cache_hit=result.get(\"cache_hit\", False),\n   419→        cache_extended=result.get(\"cache_extended\", False),\n   420→        original_cached_at=result.get(\"original_cached_at\"),\n   421→        # Intelligence analysis results\n   422→        contradictions=result.get(\"contradictions\", []),\n   423→        knowledge_gaps=result.get(\"knowledge_gaps\", []),\n   424→        role_summaries=result.get(\"role_summaries\", {}),\n   425→    )\n   426→\n   427→\n   428→async def main():\n   429→    \"\"\"Main entry point for Apify actor.\"\"\"\n   430→    try:\n   431→        from apify import Actor\n   432→        APIFY_AVAILABLE = True\n   433→    except ImportError:\n   434→        APIFY_AVAILABLE = False\n   435→        Actor = None\n   436→\n   437→    if APIFY_AVAILABLE:\n   438→        async with Actor:\n   439→            # Get actor run context\n   440→            actor_info = Actor.get_env() or {}\n   441→            apify_run_id = actor_info.get(\"actor_run_id\", \"unknown\")\n   442→\n   443→            # Get input from Apify\n   444→            actor_input_raw = await Actor.get_input() or {}\n   445→            actor_input = ActorInput(**actor_input_raw)\n   446→\n   447→            # Generate session ID\n   448→            session_id = f\"session_{apify_run_id[:12]}\"\n   449→\n   450→            # Initialize unified progress emitter\n   451→            progress_emitter = ProgressEmitter(\n   452→                session_id=session_id,\n   453→                apify_run_id=apify_run_id,\n   454→                webhook_url=actor_input.progress_webhook_url,\n   455→            )\n   456→            await progress_emitter.initialize()\n   457→\n   458→            # Initialize state manager for migration recovery\n   459→            state_manager = StateManager(session_id)\n   460→            await state_manager.initialize()\n   461→\n   462→            # Run research with progress emitter\n   463→            output = await run_actor(actor_input, progress_emitter)\n   464→\n   465→            # Build executive summary\n   466→            exec_summary = build_executive_summary(output)\n   467→\n   468→            # Store full output\n   469→            await Actor.set_value(\"OUTPUT\", output.model_dump())\n   470→\n   471→            # Store executive summary\n   472→            await Actor.set_value(\"EXECUTIVE_SUMMARY\", exec_summary.model_dump())\n   473→\n   474→            # Store report if generated\n   475→            if output.report_markdown:\n   476→                await Actor.set_value(\"REPORT.md\", output.report_markdown)\n   477→            if output.report_html:\n   478→                await Actor.set_value(\"REPORT.html\", output.report_html)\n   479→\n   480→            # === MULTI-RECORD DATASET PUSH ===\n   481→\n   482→            # 1. Summary record (overview)\n   483→            await Actor.push_data({\n   484→                \"record_type\": \"summary\",\n   485→                \"session_id\": output.session_id,\n   486→                \"query\": output.query,\n   487→                \"template\": output.template,\n   488→                \"status\": output.status,\n   489→                \"total_findings\": len(output.findings),\n   490→                \"total_perspectives\": len(output.perspectives),\n   491→                \"total_sources\": len(output.sources),\n   492→                \"execution_time_seconds\": output.execution_time_seconds,\n   493→                \"total_cost_usd\": output.cost_summary.total_cost_usd,\n   494→                \"report_available\": output.report_markdown is not None,\n   495→                \"high_confidence_findings\": exec_summary.high_confidence_findings,\n   496→                \"high_credibility_sources\": exec_summary.high_credibility_sources,\n   497→            })\n   498→\n   499→            # 2. Finding records\n   500→            for finding in output.findings:\n   501→                await Actor.push_data({\n   502→                    \"record_type\": \"finding\",\n   503→                    \"session_id\": output.session_id,\n   504→                    **finding.model_dump()\n   505→                })\n   506→\n   507→            # 3. Perspective records\n   508→            for perspective in output.perspectives:\n   509→                await Actor.push_data({\n   510→                    \"record_type\": \"perspective\",\n   511→                    \"session_id\": output.session_id,\n   512→                    **perspective.model_dump()\n   513→                })\n   514→\n   515→            # 4. Source records\n   516→            for source in output.sources:\n   517→                await Actor.push_data({\n   518→                    \"record_type\": \"source\",\n   519→                    \"session_id\": output.session_id,\n   520→                    **source.model_dump()\n   521→                })\n   522→\n   523→            # 5. Metrics record\n   524→            await Actor.push_data({\n   525→                \"record_type\": \"metrics\",\n   526→                \"session_id\": output.session_id,\n   527→                **output.cost_summary.model_dump(),\n   528→                \"execution_time_seconds\": output.execution_time_seconds,\n   529→                \"search_queries_executed\": len(output.search_queries_executed),\n   530→            })\n   531→\n   532→            logger.info(\n   533→                f\"Research completed: {len(output.findings)} findings, \"\n   534→                f\"{len(output.perspectives)} perspectives, {len(output.sources)} sources\"\n   535→            )\n   536→\n   537→            # === EMAIL DELIVERY (optional, non-blocking) ===\n   538→            if actor_input.send_email and actor_input.email_to:\n   539→                try:\n   540→                    # Get settings for resend API key\n   541→                    settings = override_settings(resend_api_key=actor_input.resend_api_key)\n   542→\n   543→                    if settings.resend_api_key:\n   544→                        resend_client = ResendClient(api_key=settings.resend_api_key)\n   545→\n   546→                        # Prepare findings with sources for email (top 5 with source URLs)\n   547→                        findings_with_sources = [\n   548→                            {\n   549→                                \"summary\": f.summary,\n   550→                                \"content\": f.content,\n   551→                                \"supporting_sources\": f.supporting_sources,\n   552→                                \"date_referenced\": f.date_referenced,\n   553→                                \"date_range\": f.date_range,\n   554→                            }\n   555→                            for f in sorted(output.findings, key=lambda x: x.confidence_score, reverse=True)[:5]\n   556→                        ]\n   557→\n   558→                        # Collect all predictions from perspectives\n   559→                        all_predictions = []\n   560→                        for p in output.perspectives:\n   561→                            for pred in p.predictions[:2]:  # Top 2 per perspective\n   562→                                all_predictions.append(pred.model_dump())\n   563→                        # Deduplicate and limit\n   564→                        seen_preds = set()\n   565→                        unique_predictions = []\n   566→                        for pred in all_predictions:\n   567→                            pred_key = pred.get(\"prediction\", \"\")[:50].lower()\n   568→                            if pred_key not in seen_preds:\n   569→                                seen_preds.add(pred_key)\n   570→                                unique_predictions.append(pred)\n   571→                                if len(unique_predictions) >= 5:\n   572→                                    break\n   573→\n   574→                        # Build email content with new parameters\n   575→                        email_content = resend_client.build_report_email(\n   576→                            query=output.query,\n   577→                            template=output.template,\n   578→                            executive_summary=exec_summary.model_dump(),\n   579→                            report_html=output.report_html,\n   580→                            report_markdown=output.report_markdown,\n   581→                            findings_with_sources=findings_with_sources,\n   582→                            predictions=unique_predictions,\n   583→                        )\n   584→\n   585→                        # Prepare attachments (both markdown and HTML)\n   586→                        attachments = []\n   587→                        if output.report_markdown:\n   588→                            attachments.append({\n   589→                                \"filename\": \"research_report.md\",\n   590→                                \"content\": base64.b64encode(output.report_markdown.encode()).decode(),\n   591→                            })\n   592→                        if output.report_html:\n   593→                            attachments.append({\n   594→                                \"filename\": \"research_report.html\",\n   595→                                \"content\": base64.b64encode(output.report_html.encode()).decode(),\n   596→                            })\n   597→\n   598→                        # Send email\n   599→                        email_result = await resend_client.send_report(\n   600→                            to_email=actor_input.email_to,\n   601→                            subject=actor_input.email_subject or email_content[\"subject\"],\n   602→                            html_content=email_content[\"html\"],\n   603→                            text_content=email_content[\"text\"],\n   604→                            attachments=attachments if attachments else None,\n   605→                        )\n   606→\n   607→                        if email_result[\"success\"]:\n   608→                            logger.info(f\"Email sent successfully to {actor_input.email_to}\")\n   609→                        else:\n   610→                            logger.warning(f\"Email send failed: {email_result.get('error')}\")\n   611→                    else:\n   612→                        logger.warning(\"Email requested but RESEND_API_KEY not configured\")\n   613→\n   614→                except Exception as e:\n   615→                    # Non-blocking - log error but don't fail the actor\n   616→                    logger.warning(f\"Email delivery failed (non-blocking): {str(e)}\")\n   617→\n   618→            # === FINAL PROGRESS EMISSION ===\n   619→            if output.status == \"completed\":\n   620→                # Emit completion via unified progress emitter\n   621→                kv_store = await Actor.open_key_value_store()\n   622→                results_url = f\"https://api.apify.com/v2/key-value-stores/{kv_store.id}/records/OUTPUT\"\n   623→\n   624→                await progress_emitter.completed(\n   625→                    findings_count=len(output.findings),\n   626→                    sources_count=len(output.sources),\n   627→                    total_cost_usd=output.cost_summary.total_cost_usd,\n   628→                    perspectives_count=len(output.perspectives),\n   629→                    execution_time_seconds=output.execution_time_seconds,\n   630→                    results_url=results_url,\n   631→                )\n   632→\n   633→                # Clear state after successful completion\n   634→                await state_manager.clear()\n   635→            else:\n   636→                # Emit failure via unified progress emitter\n   637→                error_msg = \"; \".join(output.errors) if output.errors else \"Unknown error\"\n   638→                await progress_emitter.failed(error_msg, \"RESEARCH_FAILED\", \"execution\")\n   639→\n   640→    else:\n   641→        # Local execution for testing\n   642→        logger.info(\"Running in local mode (Apify SDK not available)\")\n   643→\n   644→        # Example input for testing\n   645→        test_input = ActorInput(\n   646→            query=\"What is Apple's current financial position and stock outlook?\",\n   647→            template=\"financial\",\n   648→            granularity=\"quick\",\n   649→            max_searches=3,\n   650→            generate_report=True,\n   651→            save_to_supabase=False,\n   652→        )\n   653→\n   654→        output = await run_actor(test_input)\n   655→        exec_summary = build_executive_summary(output)\n   656→\n   657→        print(f\"\\nResults: {len(output.findings)} findings, {len(output.sources)} sources\")\n   658→        print(f\"Status: {output.status}\")\n   659→        print(f\"Execution time: {output.execution_time_seconds:.1f}s\")\n   660→        print(f\"High confidence findings: {exec_summary.high_confidence_findings}\")\n   661→\n   662→        if output.errors:\n   663→            print(f\"Errors: {output.errors}\")\n   664→\n   665→        if exec_summary.top_findings:\n   666→            print(\"\\nTop Findings:\")\n   667→            for i, f in enumerate(exec_summary.top_findings[:3], 1):\n   668→                print(f\"  {i}. {f}\")\n   669→\n   670→        if output.report_markdown:\n   671→            print(\"\\n\" + \"=\"*50)\n   672→            print(output.report_markdown[:2000])\n   673→\n   674→\n   675→if __name__ == \"__main__\":\n   676→    asyncio.run(main())\n   677→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"05d3e4f1-2259-4f3e-a055-8040a34c8b02","uuid":"92878d14-829f-4900-b9fa-ca602523fb62","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\actor\\src\\main.py","content":"\"\"\"Deep Research Actor - Main entry point.\n\nThis actor performs AI-powered deep research using Gemini with Google Search grounding.\n\"\"\"\n\nimport asyncio\nimport base64\nimport logging\nimport os\nfrom datetime import datetime\nfrom typing import Optional\n\nfrom .config import override_settings, get_settings\nfrom .schemas import ActorInput, ActorOutput, ExecutiveSummary, Finding, Source, Perspective, Prediction, CostSummary\nfrom .clients import GeminiClient, OpenRouterClient, SupabaseClient, ResendClient, CloudRunClient, R2Client\nfrom .services import OCRService, ResearchService, ReportService, ProgressEmitter, StateManager\nfrom .services.transform import transform_research_result\n\n\n# Auto-select best report variant for each template\nTEMPLATE_REPORT_VARIANTS = {\n    \"tech_market\": \"full_report\",\n    \"financial\": \"investment_thesis\",\n    \"competitive\": \"full_report\",\n    \"investigative\": \"full_report\",\n    \"legal\": \"full_report\",\n    \"contract\": \"decision_brief\",\n    \"understanding\": \"credibility_report\",\n    \"due_diligence\": \"risk_summary\",\n    \"purchase_decision\": \"buyer_guide\",\n    \"reputation\": \"trust_report\",\n}\n\n\ndef get_report_variant_for_template(template: str) -> str:\n    \"\"\"Get the best report variant for a given template.\"\"\"\n    return TEMPLATE_REPORT_VARIANTS.get(template, \"full_report\")\n\n# Configure logging\nlogging.basicConfig(\n    level=logging.INFO,\n    format=\"%(asctime)s [%(levelname)s] %(name)s: %(message)s\"\n)\nlogger = logging.getLogger(__name__)\n\n\ndef build_executive_summary(output: ActorOutput) -> ExecutiveSummary:\n    \"\"\"Build executive summary from actor output.\"\"\"\n    # Count high confidence findings\n    high_conf_findings = [f for f in output.findings if f.confidence_score >= 0.8]\n\n    # Count high credibility sources\n    high_cred_sources = [s for s in output.sources if s.credibility_score and s.credibility_score >= 0.8]\n\n    # Get top 5 findings by confidence\n    sorted_findings = sorted(output.findings, key=lambda f: f.confidence_score, reverse=True)\n    top_findings = [\n        f.summary or f.content[:100] + \"...\" if len(f.content) > 100 else f.content\n        for f in sorted_findings[:5]\n    ]\n\n    # Aggregate expert recommendations, warnings, insights\n    all_recommendations = []\n    all_warnings = []\n    all_insights = []\n\n    for p in output.perspectives:\n        all_recommendations.extend(p.recommendations[:2])  # Top 2 per perspective\n        all_warnings.extend(p.warnings[:1])  # Top 1 per perspective\n        all_insights.extend(p.key_insights[:2])  # Top 2 per perspective\n\n    # Deduplicate and limit\n    seen_recs = set()\n    unique_recommendations = []\n    for r in all_recommendations:\n        if r.lower() not in seen_recs:\n            seen_recs.add(r.lower())\n            unique_recommendations.append(r)\n            if len(unique_recommendations) >= 5:\n                break\n\n    seen_warnings = set()\n    unique_warnings = []\n    for w in all_warnings:\n        if w.lower() not in seen_warnings:\n            seen_warnings.add(w.lower())\n            unique_warnings.append(w)\n            if len(unique_warnings) >= 3:\n                break\n\n    seen_insights = set()\n    unique_insights = []\n    for i in all_insights:\n        if i.lower() not in seen_insights:\n            seen_insights.add(i.lower())\n            unique_insights.append(i)\n            if len(unique_insights) >= 5:\n                break\n\n    # Report preview\n    report_preview = \"\"\n    if output.report_markdown:\n        report_preview = output.report_markdown[:500]\n        if len(output.report_markdown) > 500:\n            report_preview += \"...\"\n\n    return ExecutiveSummary(\n        session_id=output.session_id,\n        query=output.query,\n        template=output.template,\n        status=output.status,\n        findings_count=len(output.findings),\n        high_confidence_findings=len(high_conf_findings),\n        sources_count=len(output.sources),\n        high_credibility_sources=len(high_cred_sources),\n        perspectives_count=len(output.perspectives),\n        top_findings=top_findings,\n        expert_recommendations=unique_recommendations,\n        expert_warnings=unique_warnings,\n        key_insights=unique_insights,\n        report_preview=report_preview,\n        total_cost_usd=output.cost_summary.total_cost_usd,\n        execution_time_seconds=output.execution_time_seconds,\n        completed_at=output.completed_at,\n    )\n\n\nasync def run_actor(\n    actor_input: ActorInput,\n    progress_emitter: Optional[ProgressEmitter] = None,\n) -> ActorOutput:\n    \"\"\"\n    Execute the Deep Research Actor.\n\n    Args:\n        actor_input: Validated input parameters\n        progress_emitter: Optional unified progress emitter for status and webhook events\n\n    Returns:\n        ActorOutput with research results\n    \"\"\"\n    started_at = datetime.utcnow()\n    logger.info(f\"Starting research: {actor_input.query[:50]}...\")\n\n    # Get settings with overrides\n    settings = override_settings(\n        google_api_key=actor_input.google_api_key,\n        openrouter_api_key=actor_input.openrouter_api_key,\n        supabase_url=actor_input.supabase_url,\n        supabase_key=actor_input.supabase_key,\n        resend_api_key=actor_input.resend_api_key,\n        cloud_run_url=actor_input.cloud_run_url,\n    )\n\n    # Validate required API key\n    if not settings.google_api_key:\n        return ActorOutput(\n            session_id=\"error\",\n            query=actor_input.query,\n            template=actor_input.template,\n            status=\"failed\",\n            errors=[\"Google API key is required. Set GOOGLE_API_KEY env var or provide in input.\"],\n            started_at=started_at,\n            completed_at=datetime.utcnow(),\n        )\n\n    \n    # === CLOUD RUN DISPATCH (fire-and-forget mode) ===\n    # Dispatch to Cloud Run and return immediately - Cloud Run handles everything\n    if settings.cloud_run_url:\n        logger.info(f\"Dispatching to Cloud Run (fire-and-forget): {settings.cloud_run_url}\")\n\n        try:\n            # Initialize R2 client for report storage (if configured)\n            r2_client = None\n            report_url = None\n            job_id = None\n\n            if settings.r2_account_id and settings.r2_access_key_id and settings.r2_secret_access_key:\n                try:\n                    r2_client = R2Client(\n                        account_id=settings.r2_account_id,\n                        access_key_id=settings.r2_access_key_id,\n                        secret_access_key=settings.r2_secret_access_key,\n                        bucket_name=settings.r2_bucket_name,\n                        public_url_base=settings.r2_public_url or None,\n                    )\n\n                    # Generate job_id and upload placeholder\n                    job_id = r2_client.generate_job_id(actor_input.query, actor_input.template)\n                    report_url = r2_client.upload_placeholder(\n                        job_id=job_id,\n                        query=actor_input.query,\n                        template=actor_input.template,\n                    )\n                    logger.info(f\"Placeholder uploaded to R2: {report_url}\")\n\n                except Exception as e:\n                    logger.warning(f\"R2 placeholder upload failed (continuing without): {e}\")\n                    r2_client = None\n\n            cloud_run_client = CloudRunClient(\n                service_url=settings.cloud_run_url,\n                dispatch_timeout=15,  # Short timeout for acknowledgment only\n            )\n\n            # Auto-select best report variant for template\n            report_variant = get_report_variant_for_template(actor_input.template)\n\n            # Fire-and-forget dispatch - Cloud Run handles research, report, email, R2 upload\n            dispatch_result = await cloud_run_client.dispatch_async(\n                query=actor_input.query,\n                template=actor_input.template,\n                granularity=actor_input.granularity,\n                max_searches=actor_input.get_max_searches(),\n                perspectives=actor_input.perspectives,\n                input_file_url=actor_input.input_file_url,\n                input_text=actor_input.input_text,\n                workspace_id=actor_input.workspace_id,\n                gemini_api_key=settings.google_api_key,\n                supabase_url=settings.supabase_url,\n                supabase_key=settings.supabase_key,\n                resend_api_key=settings.resend_api_key,\n                # Report options\n                generate_report=actor_input.generate_report,\n                report_format=actor_input.report_format,\n                report_variant=report_variant,\n                report_title=actor_input.report_title,\n                # Email options\n                send_email=actor_input.send_email,\n                email_to=actor_input.email_to,\n                email_subject=actor_input.email_subject,\n                # Progress webhook\n                callback_url=actor_input.progress_webhook_url,\n                # R2 config for Cloud Run to upload final report\n                r2_job_id=job_id,\n                r2_account_id=settings.r2_account_id if r2_client else None,\n                r2_access_key_id=settings.r2_access_key_id if r2_client else None,\n                r2_secret_access_key=settings.r2_secret_access_key if r2_client else None,\n                r2_bucket_name=settings.r2_bucket_name if r2_client else None,\n                r2_public_url=settings.r2_public_url if r2_client else None,\n            )\n\n            await cloud_run_client.close()\n\n            # Use job_id from R2 if available, otherwise from dispatch result\n            final_job_id = job_id or dispatch_result.get(\"job_id\", \"unknown\")\n            logger.info(f\"Cloud Run job dispatched: {final_job_id}\")\n\n            # Return immediately with dispatched status and report URL\n            return ActorOutput(\n                session_id=final_job_id,\n                query=actor_input.query,\n                template=actor_input.template,\n                status=\"processing\",  # More accurate than \"dispatched\"\n                findings=[],\n                perspectives=[],\n                sources=[],\n                search_queries_executed=[],\n                report_markdown=None,\n                report_html=None,\n                report_url=report_url,  # Pre-generated URL with placeholder\n                cost_summary=CostSummary(\n                    total_cost_usd=0.005,  # Minimal Apify compute cost\n                    gemini_cost_usd=0,\n                    gemini_tokens_used=0,\n                    searches_performed=0,\n                ),\n                execution_time_seconds=0,\n                errors=[],\n                warnings=[\"Research is processing. Visit report_url to view results when ready.\" if report_url else \"Research dispatched to Cloud Run.\"],\n                started_at=started_at,\n                completed_at=datetime.utcnow(),\n                cache_hit=False,\n                cache_extended=False,\n            )\n\n        except Exception as e:\n            logger.warning(f\"Cloud Run dispatch failed, falling back to local: {e}\")\n            # Fall through to local execution\n\n    # === LOCAL EXECUTION (fallback or when Cloud Run not configured) ===\n    # Initialize clients\n    try:\n        gemini_client = GeminiClient(\n            api_key=settings.google_api_key,\n            model=settings.gemini_model,\n        )\n    except Exception as e:\n        return ActorOutput(\n            session_id=\"error\",\n            query=actor_input.query,\n            template=actor_input.template,\n            status=\"failed\",\n            errors=[f\"Failed to initialize Gemini client: {str(e)}\"],\n            started_at=started_at,\n            completed_at=datetime.utcnow(),\n        )\n\n    # Optional: OpenRouter for OCR\n    ocr_service = None\n    if settings.openrouter_api_key:\n        try:\n            openrouter_client = OpenRouterClient(\n                api_key=settings.openrouter_api_key,\n                base_url=settings.openrouter_base_url,\n                model=settings.openrouter_ocr_model,\n            )\n            ocr_service = OCRService(openrouter_client)\n        except Exception as e:\n            logger.warning(f\"Failed to initialize OCR service: {e}\")\n\n    # Optional: Supabase for persistence\n    supabase_client = None\n    if actor_input.save_to_supabase and settings.supabase_url and settings.supabase_key:\n        try:\n            supabase_client = SupabaseClient(\n                url=settings.supabase_url,\n                key=settings.supabase_key,\n                workspace_id=actor_input.workspace_id,\n            )\n        except Exception as e:\n            logger.warning(f\"Failed to initialize Supabase client: {e}\")\n\n    # Initialize research service with progress emitter\n    research_service = ResearchService(\n        gemini_client=gemini_client,\n        supabase_client=supabase_client,\n        ocr_service=ocr_service,\n        progress_emitter=progress_emitter,\n    )\n\n    # Execute research\n    try:\n        # Get intent configuration for tailored research\n        intent_config = actor_input.get_intent_config() if actor_input.intent else None\n\n        result = await research_service.execute_research(\n            query=actor_input.query,\n            template_type=actor_input.template,\n            granularity=actor_input.granularity,\n            max_searches=actor_input.max_searches,\n            perspectives=actor_input.perspectives,\n            input_file_url=actor_input.input_file_url,\n            input_text=actor_input.input_text,\n            save_to_db=actor_input.save_to_supabase and supabase_client is not None,\n            workspace_id=actor_input.workspace_id,\n            use_cache=actor_input.use_cache,\n            extend_cache=actor_input.extend_cache,\n            intent=actor_input.intent,\n            intent_config=intent_config,\n        )\n    except Exception as e:\n        logger.error(f\"Research failed: {e}\")\n        return ActorOutput(\n            session_id=\"error\",\n            query=actor_input.query,\n            template=actor_input.template,\n            status=\"failed\",\n            errors=[f\"Research execution failed: {str(e)}\"],\n            started_at=started_at,\n            completed_at=datetime.utcnow(),\n        )\n\n    # Generate report if requested\n    report_markdown = None\n    report_html = None\n\n    if actor_input.generate_report:\n        try:\n            # Emit report started\n            if progress_emitter:\n                await progress_emitter.report_started(actor_input.report_variant, actor_input.report_format)\n\n            report_service = ReportService()\n            report_markdown = report_service.generate_markdown(\n                research_result=result,\n                variant=actor_input.report_variant,\n                title=actor_input.report_title,\n            )\n\n            if actor_input.report_format == \"html\":\n                report_html = report_service.generate_html(\n                    markdown_content=report_markdown,\n                    title=actor_input.report_title or f\"Research: {actor_input.query[:40]}\",\n                    research_result=result,\n                )\n\n            # Emit report completed\n            if progress_emitter:\n                await progress_emitter.report_completed(len(report_markdown) if report_markdown else 0)\n        except Exception as e:\n            logger.warning(f\"Report generation failed: {e}\")\n            result.setdefault(\"warnings\", []).append(f\"Report generation failed: {str(e)}\")\n\n    # Build output using transform pipeline\n    completed_at = datetime.utcnow()\n    transformed = transform_research_result(result)\n\n    return ActorOutput(\n        session_id=result.get(\"session_id\", \"unknown\"),\n        query=actor_input.query,\n        template=actor_input.template,\n        status=result.get(\"status\", \"completed\"),\n        findings=transformed.findings,\n        perspectives=transformed.perspectives,\n        sources=transformed.sources,\n        search_queries_executed=result.get(\"search_queries_executed\", []),\n        report_markdown=report_markdown,\n        report_html=report_html,\n        cost_summary=transformed.cost_summary,\n        execution_time_seconds=result.get(\"execution_time_seconds\", 0),\n        supabase_session_id=result.get(\"supabase_session_id\"),\n        errors=result.get(\"errors\", []),\n        warnings=result.get(\"warnings\", []),\n        started_at=started_at,\n        completed_at=completed_at,\n        cache_hit=result.get(\"cache_hit\", False),\n        cache_extended=result.get(\"cache_extended\", False),\n        original_cached_at=result.get(\"original_cached_at\"),\n        # Intelligence analysis results\n        contradictions=result.get(\"contradictions\", []),\n        knowledge_gaps=result.get(\"knowledge_gaps\", []),\n        role_summaries=result.get(\"role_summaries\", {}),\n    )\n\n\nasync def main():\n    \"\"\"Main entry point for Apify actor.\"\"\"\n    try:\n        from apify import Actor\n        APIFY_AVAILABLE = True\n    except ImportError:\n        APIFY_AVAILABLE = False\n        Actor = None\n\n    if APIFY_AVAILABLE:\n        async with Actor:\n            # Get actor run context\n            actor_info = Actor.get_env() or {}\n            apify_run_id = actor_info.get(\"actor_run_id\", \"unknown\")\n\n            # Get input from Apify\n            actor_input_raw = await Actor.get_input() or {}\n            actor_input = ActorInput(**actor_input_raw)\n\n            # Generate session ID\n            session_id = f\"session_{apify_run_id[:12]}\"\n\n            # Initialize unified progress emitter\n            progress_emitter = ProgressEmitter(\n                session_id=session_id,\n                apify_run_id=apify_run_id,\n                webhook_url=actor_input.progress_webhook_url,\n            )\n            await progress_emitter.initialize()\n\n            # Initialize state manager for migration recovery\n            state_manager = StateManager(session_id)\n            await state_manager.initialize()\n\n            # Run research with progress emitter\n            output = await run_actor(actor_input, progress_emitter)\n\n            # Build executive summary\n            exec_summary = build_executive_summary(output)\n\n            # Store full output\n            await Actor.set_value(\"OUTPUT\", output.model_dump())\n\n            # Store executive summary\n            await Actor.set_value(\"EXECUTIVE_SUMMARY\", exec_summary.model_dump())\n\n            # Store report if generated\n            if output.report_markdown:\n                await Actor.set_value(\"REPORT.md\", output.report_markdown)\n            if output.report_html:\n                await Actor.set_value(\"REPORT.html\", output.report_html)\n\n            # === MULTI-RECORD DATASET PUSH ===\n\n            # 1. Summary record (overview)\n            await Actor.push_data({\n                \"record_type\": \"summary\",\n                \"session_id\": output.session_id,\n                \"query\": output.query,\n                \"template\": output.template,\n                \"status\": output.status,\n                \"total_findings\": len(output.findings),\n                \"total_perspectives\": len(output.perspectives),\n                \"total_sources\": len(output.sources),\n                \"execution_time_seconds\": output.execution_time_seconds,\n                \"total_cost_usd\": output.cost_summary.total_cost_usd,\n                \"report_available\": output.report_markdown is not None,\n                \"high_confidence_findings\": exec_summary.high_confidence_findings,\n                \"high_credibility_sources\": exec_summary.high_credibility_sources,\n            })\n\n            # 2. Finding records\n            for finding in output.findings:\n                await Actor.push_data({\n                    \"record_type\": \"finding\",\n                    \"session_id\": output.session_id,\n                    **finding.model_dump()\n                })\n\n            # 3. Perspective records\n            for perspective in output.perspectives:\n                await Actor.push_data({\n                    \"record_type\": \"perspective\",\n                    \"session_id\": output.session_id,\n                    **perspective.model_dump()\n                })\n\n            # 4. Source records\n            for source in output.sources:\n                await Actor.push_data({\n                    \"record_type\": \"source\",\n                    \"session_id\": output.session_id,\n                    **source.model_dump()\n                })\n\n            # 5. Metrics record\n            await Actor.push_data({\n                \"record_type\": \"metrics\",\n                \"session_id\": output.session_id,\n                **output.cost_summary.model_dump(),\n                \"execution_time_seconds\": output.execution_time_seconds,\n                \"search_queries_executed\": len(output.search_queries_executed),\n            })\n\n            logger.info(\n                f\"Research completed: {len(output.findings)} findings, \"\n                f\"{len(output.perspectives)} perspectives, {len(output.sources)} sources\"\n            )\n\n            # === EMAIL DELIVERY (optional, non-blocking) ===\n            if actor_input.send_email and actor_input.email_to:\n                try:\n                    # Get settings for resend API key\n                    settings = override_settings(resend_api_key=actor_input.resend_api_key)\n\n                    if settings.resend_api_key:\n                        resend_client = ResendClient(api_key=settings.resend_api_key)\n\n                        # Prepare findings with sources for email (top 5 with source URLs)\n                        findings_with_sources = [\n                            {\n                                \"summary\": f.summary,\n                                \"content\": f.content,\n                                \"supporting_sources\": f.supporting_sources,\n                                \"date_referenced\": f.date_referenced,\n                                \"date_range\": f.date_range,\n                            }\n                            for f in sorted(output.findings, key=lambda x: x.confidence_score, reverse=True)[:5]\n                        ]\n\n                        # Collect all predictions from perspectives\n                        all_predictions = []\n                        for p in output.perspectives:\n                            for pred in p.predictions[:2]:  # Top 2 per perspective\n                                all_predictions.append(pred.model_dump())\n                        # Deduplicate and limit\n                        seen_preds = set()\n                        unique_predictions = []\n                        for pred in all_predictions:\n                            pred_key = pred.get(\"prediction\", \"\")[:50].lower()\n                            if pred_key not in seen_preds:\n                                seen_preds.add(pred_key)\n                                unique_predictions.append(pred)\n                                if len(unique_predictions) >= 5:\n                                    break\n\n                        # Build email content with new parameters\n                        email_content = resend_client.build_report_email(\n                            query=output.query,\n                            template=output.template,\n                            executive_summary=exec_summary.model_dump(),\n                            report_html=output.report_html,\n                            report_markdown=output.report_markdown,\n                            findings_with_sources=findings_with_sources,\n                            predictions=unique_predictions,\n                        )\n\n                        # Prepare attachments (both markdown and HTML)\n                        attachments = []\n                        if output.report_markdown:\n                            attachments.append({\n                                \"filename\": \"research_report.md\",\n                                \"content\": base64.b64encode(output.report_markdown.encode()).decode(),\n                            })\n                        if output.report_html:\n                            attachments.append({\n                                \"filename\": \"research_report.html\",\n                                \"content\": base64.b64encode(output.report_html.encode()).decode(),\n                            })\n\n                        # Send email\n                        email_result = await resend_client.send_report(\n                            to_email=actor_input.email_to,\n                            subject=actor_input.email_subject or email_content[\"subject\"],\n                            html_content=email_content[\"html\"],\n                            text_content=email_content[\"text\"],\n                            attachments=attachments if attachments else None,\n                        )\n\n                        if email_result[\"success\"]:\n                            logger.info(f\"Email sent successfully to {actor_input.email_to}\")\n                        else:\n                            logger.warning(f\"Email send failed: {email_result.get('error')}\")\n                    else:\n                        logger.warning(\"Email requested but RESEND_API_KEY not configured\")\n\n                except Exception as e:\n                    # Non-blocking - log error but don't fail the actor\n                    logger.warning(f\"Email delivery failed (non-blocking): {str(e)}\")\n\n            # === FINAL PROGRESS EMISSION ===\n            if output.status == \"completed\":\n                # Emit completion via unified progress emitter\n                kv_store = await Actor.open_key_value_store()\n                results_url = f\"https://api.apify.com/v2/key-value-stores/{kv_store.id}/records/OUTPUT\"\n\n                await progress_emitter.completed(\n                    findings_count=len(output.findings),\n                    sources_count=len(output.sources),\n                    total_cost_usd=output.cost_summary.total_cost_usd,\n                    perspectives_count=len(output.perspectives),\n                    execution_time_seconds=output.execution_time_seconds,\n                    results_url=results_url,\n                )\n\n                # Clear state after successful completion\n                await state_manager.clear()\n            else:\n                # Emit failure via unified progress emitter\n                error_msg = \"; \".join(output.errors) if output.errors else \"Unknown error\"\n                await progress_emitter.failed(error_msg, \"RESEARCH_FAILED\", \"execution\")\n\n    else:\n        # Local execution for testing\n        logger.info(\"Running in local mode (Apify SDK not available)\")\n\n        # Example input for testing\n        test_input = ActorInput(\n            query=\"What is Apple's current financial position and stock outlook?\",\n            template=\"financial\",\n            granularity=\"quick\",\n            max_searches=3,\n            generate_report=True,\n            save_to_supabase=False,\n        )\n\n        output = await run_actor(test_input)\n        exec_summary = build_executive_summary(output)\n\n        print(f\"\\nResults: {len(output.findings)} findings, {len(output.sources)} sources\")\n        print(f\"Status: {output.status}\")\n        print(f\"Execution time: {output.execution_time_seconds:.1f}s\")\n        print(f\"High confidence findings: {exec_summary.high_confidence_findings}\")\n\n        if output.errors:\n            print(f\"Errors: {output.errors}\")\n\n        if exec_summary.top_findings:\n            print(\"\\nTop Findings:\")\n            for i, f in enumerate(exec_summary.top_findings[:3], 1):\n                print(f\"  {i}. {f}\")\n\n        if output.report_markdown:\n            print(\"\\n\" + \"=\"*50)\n            print(output.report_markdown[:2000])\n\n\nif __name__ == \"__main__\":\n    asyncio.run(main())\n","numLines":677,"startLine":1,"totalLines":677}}}
[2026-01-29T23:29:03.588Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QsKiN5hMwQ3NTwddH6mBYH","type":"tool_result","content":"     1→\"\"\"Base research template.\"\"\"\n     2→\n     3→from abc import ABC, abstractmethod\n     4→from typing import List, Dict, Any, Optional\n     5→\n     6→from ..clients.gemini import GeminiClient\n     7→\n     8→\n     9→class BaseTemplate(ABC):\n    10→    \"\"\"Abstract base class for research templates.\"\"\"\n    11→\n    12→    template_id: str = \"base\"\n    13→    template_name: str = \"Base Research\"\n    14→    description: str = \"Base research template\"\n    15→\n    16→    # Default perspectives for multi-perspective analysis\n    17→    default_perspectives: List[str] = [\"historical\", \"economic\", \"political\"]\n    18→\n    19→    # Resource limits\n    20→    default_max_searches: int = 5\n    21→    default_max_sources_per_search: int = 10\n    22→\n    23→    # Verification configuration - override in subclasses\n    24→    # Levels: \"none\", \"light\", \"standard\", \"thorough\"\n    25→    verification_config: Dict[str, str] = {\n    26→        \"cross_reference\": \"standard\",\n    27→        \"bias_detection\": \"standard\",\n    28→        \"expert_sanity_check\": \"standard\",\n    29→        \"source_quality\": \"standard\",\n    30→    }\n    31→\n    32→    def __init__(self):\n    33→        self.gemini_client: Optional[GeminiClient] = None\n    34→\n    35→    def set_client(self, client: GeminiClient) -> None:\n    36→        \"\"\"Set the Gemini client for API calls.\"\"\"\n    37→        self.gemini_client = client\n    38→\n    39→    @abstractmethod\n    40→    async def generate_search_queries(\n    41→        self,\n    42→        query: str,\n    43→        max_searches: int,\n    44→        granularity: str = \"standard\",\n    45→    ) -> List[str]:\n    46→        \"\"\"Generate search queries for the research question.\"\"\"\n    47→        pass\n    48→\n    49→    @abstractmethod\n    50→    async def extract_findings(\n    51→        self,\n    52→        query: str,\n    53→        sources: List[Dict[str, Any]],\n    54→        synthesized_content: str,\n    55→        granularity: str = \"standard\",\n    56→    ) -> List[Dict[str, Any]]:\n    57→        \"\"\"Extract structured findings from research content.\"\"\"\n    58→        pass\n    59→\n    60→    # Expert perspective prompts for deep analysis\n    61→    PERSPECTIVE_PROMPTS: Dict[str, str] = {\n    62→        # ===== INVESTIGATIVE PERSPECTIVES =====\n    63→        \"forensic_financial\": \"\"\"You are a FORENSIC ACCOUNTANT and FINANCIAL INVESTIGATOR with 20+ years experience uncovering fraud, embezzlement, and financial crimes. You've worked with the FBI, SEC, and major law firms on white-collar crime cases.\n    64→\n    65→Your analytical approach:\n    66→- Follow the money: Trace every transaction, payment, and financial flow\n    67→- Look for shell companies, layered transactions, unusual timing of payments\n    68→- Identify discrepancies between public statements and financial reality\n    69→- Spot patterns consistent with money laundering, bribery, or tax evasion\n    70→- Examine related-party transactions and conflicts of interest\n    71→- Question large round-number transactions and those just under reporting thresholds\n    72→\n    73→Provide your forensic financial analysis covering:\n    74→1. FINANCIAL RED FLAGS: Suspicious patterns in any financial transactions mentioned\n    75→2. TRANSACTION ANALYSIS: What do the money flows tell us about relationships and intent?\n    76→3. HIDDEN CONNECTIONS: Financial links that reveal undisclosed relationships\n    77→4. INVESTIGATIVE LEADS: What financial records should be subpoenaed or examined?\n    78→5. CRIMINAL LIABILITY INDICATORS: Patterns suggesting potential fraud or illegality\"\"\",\n    79→\n    80→        \"power_network\": \"\"\"You are a POLITICAL SCIENTIST and POWER DYNAMICS EXPERT specializing in network analysis of influence, corruption, and institutional capture. You've advised governments and NGOs on understanding shadowy power structures.\n    81→\n    82→Your analytical approach:\n    83→- Map formal and informal power networks (who influences whom)\n    84→- Identify gatekeepers, brokers, and nodes of concentrated power\n    85→- Recognize patterns of regulatory capture and revolving door dynamics\n    86→- Trace how decisions actually get made (vs. how they officially get made)\n    87→- Spot quid pro quo relationships and mutual protection arrangements\n    88→- Analyze how power is maintained, transferred, or challenged\n    89→\n    90→Provide your power network analysis covering:\n    91→1. POWER MAP: Key actors and their actual (not just formal) power relationships\n    92→2. INFLUENCE MECHANISMS: How is influence being exercised? (lobbying, donations, relationships)\n    93→3. HIDDEN INTERESTS: Whose interests are really being served vs. stated beneficiaries\n    94→4. INSTITUTIONAL VULNERABILITIES: How are institutions being co-opted or weakened\n    95→5. ACCOUNTABILITY GAPS: Where are checks and balances failing?\"\"\",\n    96→\n    97→        \"psychological_behavioral\": \"\"\"You are a BEHAVIORAL PSYCHOLOGIST and PROFILER who analyzes decision-making, motivations, and behavioral patterns. You've worked with intelligence agencies and major corporations on understanding human behavior.\n    98→\n    99→Your analytical approach:\n   100→- Analyze stated motivations vs. revealed preferences (what people do vs. say)\n   101→- Identify cognitive biases and emotional drivers influencing decisions\n   102→- Look for patterns of deception, rationalization, or self-serving behavior\n   103→- Assess credibility based on consistency, specificity, and corroboration\n   104→- Understand group dynamics, peer pressure, and institutional cultures\n   105→- Predict future behavior based on past patterns\n   106→\n   107→Provide your behavioral analysis covering:\n   108→1. MOTIVATION ANALYSIS: What are the true underlying motivations vs. stated ones?\n   109→2. BEHAVIORAL PATTERNS: What recurring behaviors reveal about character and intent?\n   110→3. CREDIBILITY ASSESSMENT: Who is credible and who is likely being deceptive? Why?\n   111→4. PREDICTION: Based on behavioral patterns, what actions are likely next?\n   112→5. PSYCHOLOGICAL VULNERABILITIES: What pressures or incentives could change behavior?\"\"\",\n   113→\n   114→        \"geopolitical_strategic\": \"\"\"You are a GEOPOLITICAL STRATEGIST and former intelligence analyst who has briefed heads of state. You understand how nations, corporations, and powerful actors pursue their strategic interests.\n   115→\n   116→Your analytical approach:\n   117→- Analyze through the lens of national interests, not stated positions\n   118→- Identify strategic assets, chokepoints, and leverage\n   119→- Understand proxy relationships and indirect influence operations\n   120→- Recognize information warfare and narrative manipulation\n   121→- Map alliances, dependencies, and potential conflicts\n   122→- Assess long-term strategic implications vs. short-term appearances\n   123→\n   124→Provide your geopolitical analysis covering:\n   125→1. STRATEGIC INTERESTS: What national/organizational interests are really at play?\n   126→2. LEVERAGE ANALYSIS: Who has leverage over whom and how might they use it?\n   127→3. INFORMATION OPERATIONS: What narratives are being pushed and by whom?\n   128→4. ALLIANCE DYNAMICS: How do relationships and alliances affect the situation?\n   129→5. STRATEGIC IMPLICATIONS: What are the long-term geopolitical consequences?\"\"\",\n   130→\n   131→        \"legal_liability\": \"\"\"You are a LITIGATION ATTORNEY and LEGAL RISK ANALYST who has handled major cases involving corporate misconduct, fraud, and regulatory violations. You've won cases against Fortune 500 companies.\n   132→\n   133→Your analytical approach:\n   134→- Identify potential civil and criminal liability for each actor\n   135→- Assess strength of evidence and admissibility\n   136→- Consider statute of limitations and jurisdictional issues\n   137→- Analyze regulatory exposure (SEC, DOJ, FTC, state AGs)\n   138→- Evaluate potential class action or qui tam exposure\n   139→- Consider reputational and consequential damages\n   140→\n   141→Provide your legal analysis covering:\n   142→1. LIABILITY EXPOSURE: Who faces potential civil/criminal liability and for what?\n   143→2. EVIDENCE STRENGTH: How strong is the evidence for each potential claim?\n   144→3. REGULATORY RISK: Which regulators might take action and on what grounds?\n   145→4. LEGAL VULNERABILITIES: Where are actors most exposed to legal consequences?\n   146→5. LITIGATION PREDICTION: What lawsuits or enforcement actions are likely?\"\"\",\n   147→\n   148→        # ===== FINANCIAL/INVESTMENT PERSPECTIVES =====\n   149→        \"institutional_investor\": \"\"\"You are a SENIOR PORTFOLIO MANAGER at a top-tier institutional fund managing $50B+ AUM. You've generated alpha through deep fundamental research and contrarian thinking.\n   150→\n   151→Your analytical approach:\n   152→- Focus on long-term value creation, not short-term noise\n   153→- Analyze management quality, capital allocation, and incentive alignment\n   154→- Assess competitive moats and their durability\n   155→- Evaluate returns on invested capital and reinvestment opportunities\n   156→- Consider position sizing based on conviction and risk/reward\n   157→- Think in terms of enterprise value and owner earnings\n   158→\n   159→Provide your institutional investor analysis covering:\n   160→1. INVESTMENT THESIS: What is the core long-term investment thesis?\n   161→2. MANAGEMENT ASSESSMENT: How capable and aligned is the management team?\n   162→3. MOAT ANALYSIS: How durable are competitive advantages? What could erode them?\n   163→4. CAPITAL ALLOCATION: How well does management deploy capital?\n   164→5. POSITION RECOMMENDATION: Size, entry strategy, and catalyst timeline\"\"\",\n   165→\n   166→        \"short_seller\": \"\"\"You are a PROFESSIONAL SHORT SELLER and forensic researcher known for uncovering frauds before they become public. You've published research that exposed major frauds and made substantial returns.\n   167→\n   168→Your analytical approach:\n   169→- Extreme skepticism of management claims and projections\n   170→- Deep forensic accounting analysis of financial statements\n   171→- Analysis of insider selling, dilution, and related-party transactions\n   172→- Investigation of customer/supplier verification and channel checks\n   173→- Red flag analysis: revenue recognition, reserves, non-GAAP adjustments\n   174→- Assessment of promotional activity and narrative vs. fundamentals\n   175→\n   176→Provide your skeptical analysis covering:\n   177→1. RED FLAGS: What accounting or business red flags are present?\n   178→2. VERIFICATION GAPS: What claims cannot be independently verified?\n   179→3. INSIDER BEHAVIOR: What does insider trading and compensation tell us?\n   180→4. SUSTAINABILITY QUESTIONS: What about the business model is unsustainable?\n   181→5. FRAUD PROBABILITY: How likely is significant fraud or value destruction?\n   182→\n   183→MANDATORY BEAR CASE (You MUST provide this structured analysis):\n   184→6. BEAR CASE SCENARIO: Provide a specific, detailed bear case including:\n   185→   - What the bulls are missing or underweighting\n   186→   - The specific trigger events that would cause the thesis to fail\n   187→   - Probability estimate (X%) for this bear scenario materializing\n   188→   - Expected downside magnitude (stock drops X%, revenue declines X%)\n   189→   - Timeline: When would warning signs appear?\n   190→   - KILL TRIGGERS: Specific observable events that signal the bear case is playing out\n   191→     (e.g., \"Exit if customer concentration exceeds 40%\", \"Reverse if gross margins fall below 60%\")\n   192→\n   193→Format your bear case as:\n   194→BEAR CASE ([X]% probability): [One sentence summary of the scenario]\n   195→- Trigger: [What starts the decline]\n   196→- Magnitude: [Expected impact on stock/revenue/margins]\n   197→- Timeline: [When this plays out]\n   198→- Kill Signals: [3-5 specific, measurable warning signs to watch]\"\"\",\n   199→\n   200→        \"quantitative_risk\": \"\"\"You are a QUANTITATIVE RISK ANALYST and former derivatives trader who builds risk models. You understand tail risks, correlations, and how risks cascade through systems.\n   201→\n   202→Your analytical approach:\n   203→- Model probability distributions, not just expected values\n   204→- Identify hidden correlations and concentration risks\n   205→- Stress test against historical analogues and fat-tail events\n   206→- Assess liquidity risk and forced selling scenarios\n   207→- Evaluate counterparty and contagion risks\n   208→- Calculate position-specific and portfolio-level VaR\n   209→\n   210→Provide your risk analysis covering:\n   211→1. RISK FACTORS: Enumerate all material risk factors and their probability\n   212→2. TAIL RISKS: What are the low-probability high-impact scenarios?\n   213→3. CORRELATION RISKS: How might risks compound or cascade?\n   214→4. STRESS SCENARIOS: How would position perform in 2008/2020-type events?\n   215→5. RISK MITIGATION: Hedging strategies and risk reduction opportunities\"\"\",\n   216→\n   217→        \"activist_investor\": \"\"\"You are an ACTIVIST INVESTOR who has run successful campaigns to unlock value at underperforming companies. You understand corporate governance, proxy fights, and value creation levers.\n   218→\n   219→Your analytical approach:\n   220→- Identify operational inefficiencies and margin improvement opportunities\n   221→- Assess capital structure optimization (leverage, buybacks, dividends)\n   222→- Evaluate portfolio rationalization and divestiture opportunities\n   223→- Analyze governance weaknesses and board composition\n   224→- Identify catalysts that could unlock hidden value\n   225→- Consider strategic alternatives including M&A\n   226→\n   227→Provide your activist analysis covering:\n   228→1. VALUE CREATION LEVERS: What changes could unlock significant value?\n   229→2. OPERATIONAL IMPROVEMENTS: Where are margins below potential and why?\n   230→3. CAPITAL ALLOCATION CRITIQUE: How should capital strategy change?\n   231→4. GOVERNANCE ISSUES: What governance changes would improve outcomes?\n   232→5. ACTIVISM PLAYBOOK: What would a campaign look like and likely outcomes?\"\"\",\n   233→\n   234→        \"macro_strategist\": \"\"\"You are a GLOBAL MACRO STRATEGIST who manages money based on economic cycles, policy changes, and global capital flows. You've successfully navigated multiple economic crises.\n   235→\n   236→Your analytical approach:\n   237→- Analyze position within economic and credit cycles\n   238→- Assess sensitivity to interest rates, inflation, and currency moves\n   239→- Evaluate policy risks (monetary, fiscal, regulatory)\n   240→- Consider global supply chain and trade dependencies\n   241→- Model scenarios based on different macro environments\n   242→- Identify secular trends vs. cyclical dynamics\n   243→\n   244→Provide your macro analysis covering:\n   245→1. CYCLE POSITIONING: Where are we in economic/credit cycles and implications?\n   246→2. MACRO SENSITIVITIES: Key macro variables affecting the investment\n   247→3. POLICY RISKS: How might policy changes (rates, regulation, tax) impact?\n   248→4. GLOBAL CONTEXT: International factors and dependencies\n   249→5. SCENARIO ANALYSIS: Performance across different macro scenarios\"\"\",\n   250→\n   251→        # ===== COMPETITIVE ANALYSIS PERSPECTIVES =====\n   252→        \"strategy_consultant\": \"\"\"You are a MCKINSEY/BCG-level STRATEGY CONSULTANT who has advised Fortune 100 CEOs on competitive strategy. You use rigorous frameworks and data to assess competitive dynamics.\n   253→\n   254→Your analytical approach:\n   255→- Apply Porter's Five Forces systematically\n   256→- Analyze value chain positioning and make-vs-buy decisions\n   257→- Assess competitive advantages and their sustainability\n   258→- Evaluate strategic options using decision trees and scenario planning\n   259→- Consider game theory dynamics between competitors\n   260→- Focus on execution capabilities, not just strategic intent\n   261→\n   262→Provide your strategic analysis covering:\n   263→1. COMPETITIVE POSITIONING: Where does each player sit and why?\n   264→2. STRATEGIC OPTIONS: What are the viable strategic paths forward?\n   265→3. CAPABILITY ASSESSMENT: What capabilities determine winners vs. losers?\n   266→4. DISRUPTIVE THREATS: What could fundamentally change the competitive landscape?\n   267→5. STRATEGIC RECOMMENDATIONS: Recommended actions with rationale\"\"\",\n   268→\n   269→        \"industry_insider\": \"\"\"You are a 20-YEAR INDUSTRY VETERAN who has worked at multiple companies in this space. You understand the operational realities that outsiders miss.\n   270→\n   271→Your analytical approach:\n   272→- Focus on what actually matters operationally, not analyst narratives\n   273→- Understand customer decision-making and switching costs\n   274→- Know where value is really created vs. captured\n   275→- Recognize talent dynamics and cultural factors\n   276→- Understand regulatory relationships and political dynamics\n   277→- Identify operational metrics that predict success\n   278→\n   279→Provide your insider analysis covering:\n   280→1. OPERATIONAL REALITY: What do outsiders misunderstand about this industry?\n   281→2. CUSTOMER DYNAMICS: How do customers really make decisions?\n   282→3. TALENT AND CULTURE: What cultural/talent factors drive success?\n   283→4. HIDDEN METRICS: What operational metrics should be tracked?\n   284→5. INDUSTRY PREDICTIONS: Where is the industry really headed?\"\"\",\n   285→\n   286→        # ===== LEGAL RESEARCH PERSPECTIVES =====\n   287→        \"regulatory_expert\": \"\"\"You are a FORMER SENIOR REGULATOR who has shaped and enforced major regulations. You understand how regulators think, prioritize, and act.\n   288→\n   289→Your analytical approach:\n   290→- Understand regulatory priorities and enforcement trends\n   291→- Assess compliance gaps and their materiality\n   292→- Evaluate regulatory relationships and history\n   293→- Predict enforcement likelihood based on precedent\n   294→- Consider political factors affecting regulatory action\n   295→- Analyze remediation options and their effectiveness\n   296→\n   297→Provide your regulatory analysis covering:\n   298→1. COMPLIANCE ASSESSMENT: Where are compliance gaps and how material are they?\n   299→2. ENFORCEMENT RISK: How likely is enforcement action and what would trigger it?\n   300→3. REGULATORY RELATIONSHIPS: What is the history with regulators?\n   301→4. POLITICAL FACTORS: How do politics affect regulatory outcomes?\n   302→5. REMEDIATION PATH: What steps would reduce regulatory risk?\"\"\",\n   303→\n   304→        \"litigation_strategist\": \"\"\"You are a TOP LITIGATOR who has tried high-stakes cases. You understand how cases develop, what makes arguments persuasive, and how litigation actually works.\n   305→\n   306→Your analytical approach:\n   307→- Assess factual and legal strength of each claim\n   308→- Identify discovery that would strengthen or weaken positions\n   309→- Evaluate judge and jury dynamics\n   310→- Consider settlement dynamics and negotiation leverage\n   311→- Assess reputational and precedential impacts\n   312→- Analyze litigation as strategic tool, not just legal process\n   313→\n   314→Provide your litigation analysis covering:\n   315→1. CASE STRENGTH: How strong are the claims/defenses on the merits?\n   316→2. DISCOVERY ANALYSIS: What discovery would be most impactful?\n   317→3. LITIGATION STRATEGY: What strategic approach would you recommend?\n   318→4. SETTLEMENT ANALYSIS: What are realistic settlement ranges and dynamics?\n   319→5. OUTCOME PREDICTION: Most likely outcomes and their probabilities\"\"\",\n   320→\n   321→        # ===== TECH MARKET PERSPECTIVES (VC & STARTUP) =====\n   322→        \"venture_capitalist\": \"\"\"You are a PARTNER at a top-tier venture capital firm (Sequoia/a16z/Benchmark level) specializing in developer tools, infrastructure, and enterprise software. You have deployed $500M+ and seen 3 unicorn exits in the dev tools space.\n   323→\n   324→Your analytical approach:\n   325→- Assess total addressable market (TAM) and market timing\n   326→- Evaluate product-market fit signals and developer adoption curves\n   327→- Analyze competitive moats: network effects, switching costs, data advantages\n   328→- Identify expansion opportunities (land-and-expand, platform plays)\n   329→- Evaluate founding team and technical execution capability\n   330→- Consider exit potential: IPO readiness, strategic acquirer universe\n   331→\n   332→Provide your VC analysis covering:\n   333→1. MARKET OPPORTUNITY: TAM sizing, growth drivers, and timing analysis\n   334→2. COMPETITIVE DYNAMICS: Who wins and why? What creates defensibility?\n   335→3. ADOPTION SIGNALS: Developer sentiment, GitHub stars, community momentum\n   336→4. BUSINESS MODEL: Monetization strategy, unit economics, expansion revenue\n   337→5. INVESTMENT THESIS: Why invest now? What are the key milestones to watch?\n   338→6. RISKS: Technical, market, and competitive risks to monitor\"\"\",\n   339→\n   340→        \"startup_founder\": \"\"\"You are a SERIAL FOUNDER who has built and exited two developer tools companies. You understand the developer market intimately - both what developers say they want and what they actually adopt.\n   341→\n   342→Your analytical approach:\n   343→- Focus on developer experience (DX) and reducing friction\n   344→- Understand open-source dynamics and community building\n   345→- Know how to navigate from individual developers to enterprise sales\n   346→- Recognize the importance of documentation, tutorials, and onboarding\n   347→- Evaluate technical architecture decisions for scalability\n   348→- Understand developer marketing and word-of-mouth growth\n   349→\n   350→Provide your founder analysis covering:\n   351→1. DX ANALYSIS: What makes developers love or hate these tools?\n   352→2. GO-TO-MARKET: How would you acquire your first 1000 developers?\n   353→3. COMMUNITY STRATEGY: Open source vs proprietary, community building approach\n   354→4. ENTERPRISE READINESS: What's needed to sell to enterprises?\n   355→5. COMPETITIVE POSITIONING: How would you differentiate and win?\n   356→6. EXECUTION RISKS: What could go wrong in building this?\"\"\",\n   357→\n   358→        \"product_manager\": \"\"\"You are a SENIOR PRODUCT MANAGER at a leading developer platform (GitHub, GitLab, Atlassian level). You've shipped products used by millions of developers and understand the nuances of developer-focused product development.\n   359→\n   360→Your analytical approach:\n   361→- Define clear user personas and jobs-to-be-done\n   362→- Prioritize features based on developer impact vs. effort\n   363→- Understand developer workflows and pain points deeply\n   364→- Balance developer wants with enterprise buyer needs\n   365→- Use data-driven decision making with qualitative developer feedback\n   366→- Think in terms of platforms and ecosystems, not just point solutions\n   367→\n   368→Provide your product analysis covering:\n   369→1. USER NEEDS: What pain points are being addressed? How severe are they?\n   370→2. FEATURE PRIORITIES: What features matter most? What's table stakes vs. differentiating?\n   371→3. USER EXPERIENCE: How intuitive is the experience? Where is friction?\n   372→4. PLATFORM POTENTIAL: Is this a point solution or platform opportunity?\n   373→5. ROADMAP OPPORTUNITIES: What features would you prioritize for 2026?\n   374→6. METRICS: What KPIs would you track for success?\"\"\",\n   375→\n   376→        \"developer_advocate\": \"\"\"You are a SENIOR DEVELOPER ADVOCATE at a major tech company who has built communities around developer tools. You speak at conferences, create content, and deeply understand what makes developers excited about technology.\n   377→\n   378→Your analytical approach:\n   379→- Evaluate technologies from a developer experience perspective\n   380→- Understand what creates buzz vs. what has lasting value\n   381→- Know how to explain complex technologies accessibly\n   382→- Recognize community dynamics and influencer networks\n   383→- Assess documentation quality, learning curves, and onboarding\n   384→- Understand developer content (blogs, videos, tutorials) effectiveness\n   385→\n   386→Provide your developer advocate analysis covering:\n   387→1. DEVELOPER APPEAL: What makes this exciting or boring to developers?\n   388→2. LEARNING CURVE: How easy is adoption? What are the barriers?\n   389→3. DOCUMENTATION: How good is the documentation and learning resources?\n   390→4. COMMUNITY HEALTH: Is there a vibrant community? What's the engagement like?\n   391→5. CONTENT STRATEGY: What content would resonate with developers?\n   392→6. HYPE VS REALITY: Is the excitement justified or overblown?\"\"\",\n   393→\n   394→        # ===== TECH MARKET PERSPECTIVES (DEVELOPER COMMUNITY) =====\n   395→        \"open_source_maintainer\": \"\"\"You are a PRINCIPAL OPEN SOURCE MAINTAINER who has led projects with 50,000+ GitHub stars. You understand sustainable open source, governance, and building communities that last decades.\n   396→\n   397→Your analytical approach:\n   398→- Evaluate project health: contributors, commit frequency, issue responsiveness\n   399→- Assess governance models and long-term sustainability\n   400→- Understand licensing implications and corporate backing dynamics\n   401→- Recognize contributor experience and onboarding\n   402→- Analyze fork risks and community fragmentation\n   403→- Evaluate code quality, testing, and release practices\n   404→\n   405→Provide your maintainer analysis covering:\n   406→1. PROJECT HEALTH: Contributor diversity, bus factor, governance quality\n   407→2. SUSTAINABILITY: Funding model, corporate backing, burnout risks\n   408→3. COMMUNITY: How welcoming is the community? How are decisions made?\n   409→4. CODE QUALITY: Architecture, testing, documentation standards\n   410→5. ECOSYSTEM FIT: How does this fit with other tools developers use?\n   411→6. LONG-TERM VIABILITY: Will this project exist in 5 years? 10 years?\"\"\",\n   412→\n   413→        \"devrel_engineer\": \"\"\"You are a DEVREL ENGINEER who bridges the gap between product teams and the developer community. You build SDKs, write documentation, create sample apps, and gather developer feedback to influence product direction.\n   414→\n   415→Your analytical approach:\n   416→- Evaluate API design and SDK quality\n   417→- Assess time-to-first-success for new developers\n   418→- Understand integration patterns with existing tools\n   419→- Recognize documentation completeness and accuracy\n   420→- Analyze developer support channels and responsiveness\n   421→- Evaluate sample code and quickstart quality\n   422→\n   423→Provide your devrel analysis covering:\n   424→1. API/SDK QUALITY: How well-designed is the developer interface?\n   425→2. ONBOARDING EXPERIENCE: How quickly can developers get value?\n   426→3. INTEGRATION: How well does this fit existing developer workflows?\n   427→4. SUPPORT: How are developer questions and issues handled?\n   428→5. FEEDBACK LOOP: How does developer feedback reach product teams?\n   429→6. COMPETITIVE COMPARISON: How does the DX compare to alternatives?\"\"\",\n   430→\n   431→        \"senior_engineer\": \"\"\"You are a STAFF/PRINCIPAL ENGINEER at a FAANG company who has built systems handling millions of requests per second. You evaluate technologies based on production readiness, scalability, and long-term maintainability.\n   432→\n   433→Your analytical approach:\n   434→- Assess architectural soundness and scalability characteristics\n   435→- Evaluate operational complexity and maintenance burden\n   436→- Consider performance characteristics and resource efficiency\n   437→- Analyze security posture and compliance readiness\n   438→- Review testing, monitoring, and debugging capabilities\n   439→- Evaluate team skill requirements and learning investment\n   440→\n   441→Provide your senior engineer analysis covering:\n   442→1. ARCHITECTURE: How sound is the technical architecture?\n   443→2. SCALABILITY: Can this handle production scale? What are the limits?\n   444→3. OPERATIONS: What's the operational burden? On-call implications?\n   445→4. SECURITY: What security considerations are there?\n   446→5. TEAM FIT: What skills does the team need? What's the ramp-up time?\n   447→6. TECHNICAL DEBT: What are the long-term maintenance implications?\"\"\",\n   448→\n   449→        \"platform_engineer\": \"\"\"You are a PLATFORM ENGINEER who builds internal developer platforms (IDPs) and enables other developers to ship faster. You think about golden paths, self-service, and reducing cognitive load for application developers.\n   450→\n   451→Your analytical approach:\n   452→- Evaluate fit within a broader platform architecture\n   453→- Assess self-service capabilities and automation potential\n   454→- Consider standardization and golden path implications\n   455→- Analyze observability, debugging, and troubleshooting\n   456→- Evaluate security, compliance, and governance integration\n   457→- Consider multi-tenancy and isolation requirements\n   458→\n   459→Provide your platform engineer analysis covering:\n   460→1. PLATFORM FIT: How does this fit in a modern IDP architecture?\n   461→2. SELF-SERVICE: Can developers use this without platform team involvement?\n   462→3. STANDARDIZATION: Does this enable or complicate standardization?\n   463→4. OBSERVABILITY: What insights do operators get? What's missing?\n   464→5. SECURITY/COMPLIANCE: How does this integrate with security controls?\n   465→6. MIGRATION PATH: How would you roll this out to existing systems?\"\"\",\n   466→\n   467→        # ===== CONTRACT ANALYSIS PERSPECTIVES =====\n   468→        \"contract_auditor\": \"\"\"You are a SENIOR GOVERNMENT CONTRACT AUDITOR with 25+ years experience at the GAO and major accounting firms. You've audited billions in federal and state contracts and uncovered numerous cases of overpricing, waste, and fraud.\n   469→\n   470→Your analytical approach:\n   471→- Analyze pricing against industry benchmarks and historical contracts\n   472→- Identify cost padding, inflated rates, and unnecessary line items\n   473→- Check for scope creep, change order abuse, and contract modifications\n   474→- Flag sole-source justifications that seem manufactured or weak\n   475→- Evaluate labor rates, materials costs, and overhead percentages\n   476→- Look for round-number pricing that suggests estimates rather than actual costs\n   477→\n   478→Provide your contract audit analysis covering:\n   479→1. PRICING ANALYSIS: Are the contract rates reasonable compared to market? What's the potential overpricing?\n   480→2. COST BREAKDOWN: Which line items seem inflated or unjustified?\n   481→3. CHANGE ORDER PATTERNS: Are modifications following expected patterns or suggesting abuse?\n   482→4. SOLE SOURCE CONCERNS: If sole-source, is the justification legitimate?\n   483→5. BENCHMARKING: How does this compare to similar contracts in the sector?\n   484→6. RED FLAGS: Specific audit concerns that warrant deeper investigation\"\"\",\n   485→\n   486→        \"procurement_investigator\": \"\"\"You are a PROCUREMENT FRAUD INVESTIGATOR who has worked with the FBI, OIG, and state attorneys general on major corruption cases. You specialize in bid rigging, kickbacks, and procurement manipulation schemes.\n   487→\n   488→Your analytical approach:\n   489→- Analyze bid process for irregularities and manipulation\n   490→- Identify connected entities, shell companies, and straw bidders\n   491→- Check for rotation schemes, market allocation, and collusive patterns\n   492→- Flag unusually narrow specifications designed for one vendor\n   493→- Look for relationships between contractors and government officials\n   494→- Examine timing patterns in bids and awards\n   495→\n   496→Provide your investigative analysis covering:\n   497→1. BID PROCESS INTEGRITY: Were there irregularities in how bids were solicited or evaluated?\n   498→2. CONNECTED ENTITIES: Are there hidden relationships between bidders or with officials?\n   499→3. COLLUSION INDICATORS: Signs of bid rigging, rotation schemes, or market allocation?\n   500→4. SPECIFICATION MANIPULATION: Were specs written to favor a particular vendor?\n   501→5. CONFLICT OF INTEREST: Any relationships between decision-makers and contractors?\n   502→6. INVESTIGATIVE LEADS: What should investigators examine further?\"\"\",\n   503→\n   504→        \"forensic_accountant\": \"\"\"You are a FORENSIC ACCOUNTANT specializing in government fraud, embezzlement, and white-collar crime. You've testified as an expert witness in major corruption trials and recovered hundreds of millions in fraudulent payments.\n   505→\n   506→Your analytical approach:\n   507→- Trace money flows and payment patterns for anomalies\n   508→- Identify related-party transactions and layered payments\n   509→- Check vendor ownership, beneficial owners, and corporate structures\n   510→- Flag unusual payment terms, prepayments, or milestone gaming\n   511→- Look for round-number invoices and timing patterns\n   512→- Analyze subcontractor relationships and pass-through arrangements\n   513→\n   514→Provide your forensic analysis covering:\n   515→1. PAYMENT PATTERNS: Are there unusual timing, amounts, or frequency patterns?\n   516→2. BENEFICIAL OWNERSHIP: Who ultimately controls the contracting entities?\n   517→3. RELATED PARTIES: Are there undisclosed relationships between parties?\n   518→4. INVOICE ANALYSIS: Do invoices show signs of manipulation or fabrication?\n   519→5. SUBCONTRACTOR FLOW: Is money flowing to suspicious subcontractors?\n   520→6. FRAUD INDICATORS: Specific patterns consistent with known fraud schemes\"\"\",\n   521→\n   522→        \"regulatory_compliance\": \"\"\"You are a GOVERNMENT CONTRACTING COMPLIANCE EXPERT who has worked at the SBA, GSA, and as compliance counsel for major contractors. You know FAR regulations, state procurement rules, and compliance requirements inside and out.\n   523→\n   524→Your analytical approach:\n   525→- Check adherence to FAR, DFARS, and applicable state regulations\n   526→- Identify missing required documentation and certifications\n   527→- Verify small business set-aside compliance and certification validity\n   528→- Assess False Claims Act exposure and compliance program adequacy\n   529→- Review required disclosures, representations, and certifications\n   530→- Evaluate DBE/MBE/WBE compliance if applicable\n   531→\n   532→Provide your compliance analysis covering:\n   533→1. REGULATORY COMPLIANCE: What procurement regulations may have been violated?\n   534→2. DOCUMENTATION GAPS: What required documentation is missing or inadequate?\n   535→3. CERTIFICATION ISSUES: Are contractor certifications valid and accurate?\n   536→4. SET-ASIDE COMPLIANCE: If applicable, is the set-aside requirement being met legitimately?\n   537→5. FALSE CLAIMS EXPOSURE: What False Claims Act liability might exist?\n   538→6. REMEDIATION NEEDS: What compliance issues need to be addressed?\"\"\",\n   539→\n   540→        \"industry_benchmarker\": \"\"\"You are an INDUSTRY ANALYST specializing in government IT and construction contract pricing. You maintain extensive databases of contract rates, labor costs, and materials pricing across government sectors.\n   541→\n   542→Your analytical approach:\n   543→- Compare contract rates to GSA schedules and market rates\n   544→- Analyze labor categories and rates against BLS and industry data\n   545→- Evaluate materials costs against manufacturer pricing and market indices\n   546→- Assess overhead and profit margins against industry norms\n   547→- Consider geographic factors and complexity adjustments\n   548→- Benchmark against similar contracts in the same agency and sector\n   549→\n   550→Provide your benchmarking analysis covering:\n   551→1. RATE COMPARISON: How do labor rates compare to GSA schedules and market?\n   552→2. MATERIALS PRICING: Are materials costs in line with market prices?\n   553→3. OVERHEAD ANALYSIS: Are overhead rates reasonable for this type of work?\n   554→4. PROFIT MARGINS: Is the profit margin within acceptable ranges?\n   555→5. COMPARABLE CONTRACTS: How does this compare to similar recent contracts?\n   556→6. VALUE ASSESSMENT: Is the government getting fair value for this contract?\"\"\",\n   557→\n   558→        # ===== EVENT UNDERSTANDING PERSPECTIVES =====\n   559→        \"media_analyst\": \"\"\"You are a SENIOR MEDIA ANALYST and former investigative journalist with 20+ years experience studying media ecosystems, propaganda, and narrative manipulation. You've worked at major news organizations and academic institutions studying media bias.\n   560→\n   561→Your analytical approach:\n   562→- Track how narratives evolve across different media ecosystems (mainstream, alternative, state-backed, social)\n   563→- Identify ownership structures and their influence on coverage\n   564→- Analyze framing techniques, story selection, and omissions\n   565→- Compare coverage across time to assess historical accuracy\n   566→- Detect coordinated narrative campaigns and their sources\n   567→- Evaluate source-citing practices and verification standards\n   568→\n   569→Provide your media analysis covering:\n   570→1. NARRATIVE MAPPING: How have different media ecosystems framed this story? What are the key divergences?\n   571→2. COVERAGE PATTERNS: What's being emphasized vs. omitted? What stories are not being told?\n   572→3. HISTORICAL ACCURACY: How accurate were these sources on similar past events?\n   573→4. OWNERSHIP/BIAS ANALYSIS: How do ownership structures and editorial policies affect coverage?\n   574→5. COORDINATION DETECTION: Are there signs of coordinated narrative pushing? By whom?\n   575→6. SOURCE QUALITY: Which sources are citing primary evidence vs. each other?\"\"\",\n   576→\n   577→        \"fact_checker\": \"\"\"You are a SENIOR FACT-CHECKER and verification specialist who has worked at leading fact-checking organizations. You specialize in debunking misinformation and verifying claims in complex, politicized topics.\n   578→\n   579→Your analytical approach:\n   580→- Verify claims against primary sources and official records\n   581→- Identify manipulation techniques: cherry-picking, out-of-context quotes, doctored media\n   582→- Track the origin and spread of false claims\n   583→- Distinguish between outright falsehoods, misleading framing, and unverified claims\n   584→- Assess the burden of proof for extraordinary claims\n   585→- Identify what CAN be verified vs. what remains unknowable\n   586→\n   587→Provide your fact-check analysis covering:\n   588→1. VERIFIED FACTS: What claims are supported by primary evidence?\n   589→2. DEBUNKED CLAIMS: What claims are demonstrably false? What's the evidence?\n   590→3. UNVERIFIED CLAIMS: What claims cannot be verified either way? Why?\n   591→4. MANIPULATION TECHNIQUES: What propaganda techniques are being used?\n   592→5. ORIGIN TRACING: Where did key narratives originate? How did they spread?\n   593→6. EVIDENTIARY GAPS: What evidence would be needed to verify key claims?\"\"\",\n   594→\n   595→        \"historian\": \"\"\"You are a HISTORIAN specializing in modern history, geopolitics, and media studies. You have deep knowledge of historical parallels, how events unfold over time, and the long-term consequences of major decisions.\n   596→\n   597→Your analytical approach:\n   598→- Identify historical parallels and patterns across similar events\n   599→- Understand how past events provide context for current ones\n   600→- Recognize propaganda patterns that recur throughout history\n   601→- Assess long-term consequences based on historical precedent\n   602→- Distinguish genuinely novel situations from familiar patterns\n   603→- Apply lessons from similar historical crises\n   604→\n   605→Provide your historical analysis covering:\n   606→1. HISTORICAL PARALLELS: What past events are most similar? What can we learn from them?\n   607→2. PATTERN RECOGNITION: What recurring patterns are present (political, military, economic)?\n   608→3. HISTORICAL CONTEXT: What background is essential for understanding this event?\n   609→4. PROPAGANDA PATTERNS: How do current narratives compare to historical propaganda patterns?\n   610→5. LONG-TERM IMPLICATIONS: Based on history, what are likely long-term consequences?\n   611→6. WHAT'S DIFFERENT: What makes this situation genuinely novel vs. repeating history?\"\"\",\n   612→\n   613→        \"intelligence_analyst\": \"\"\"You are a FORMER INTELLIGENCE ANALYST who has worked on information operations, psychological warfare, and strategic communications analysis. You understand how state and non-state actors manipulate information.\n   614→\n   615→Your analytical approach:\n   616→- Identify information operations and their likely sponsors\n   617→- Analyze propaganda techniques and psychological manipulation\n   618→- Assess the strategic objectives behind narrative campaigns\n   619→- Detect coordinated inauthentic behavior and bot networks\n   620→- Evaluate cui bono (who benefits) from different narratives\n   621→- Distinguish organic discourse from manufactured consensus\n   622→\n   623→Provide your intelligence analysis covering:\n   624→1. INFORMATION OPERATIONS: Are there active influence campaigns? Who's behind them?\n   625→2. STRATEGIC OBJECTIVES: What are the strategic goals behind different narratives?\n   626→3. PROPAGANDA TECHNIQUES: What specific techniques are being employed?\n   627→4. ACTOR ANALYSIS: Which actors benefit from different outcomes? What are their capabilities?\n   628→5. DECEPTION INDICATORS: What signs suggest deliberate deception vs. organic error?\n   629→6. ASSESSMENT CONFIDENCE: How confident can we be in our understanding? What are the key unknowns?\"\"\",\n   630→\n   631→        # ===== DUE DILIGENCE PERSPECTIVES =====\n   632→        \"due_diligence_analyst\": \"\"\"You are a PROFESSIONAL DUE DILIGENCE ANALYST with 15+ years experience vetting companies for M&A transactions, partnerships, and investments. You've uncovered hidden liabilities and saved clients millions.\n   633→\n   634→Your analytical approach:\n   635→- Verify all claimed credentials and registrations\n   636→- Check for litigation history and regulatory actions\n   637→- Analyze financial health indicators and stability\n   638→- Research key personnel backgrounds and track records\n   639→- Identify undisclosed relationships and conflicts of interest\n   640→- Look for patterns that suggest misrepresentation\n   641→\n   642→Provide your due diligence analysis covering:\n   643→1. VERIFICATION STATUS: What claims can be verified vs. unverified?\n   644→2. RED FLAGS: What warning signs should concern a potential partner/customer?\n   645→3. FINANCIAL INDICATORS: What does available financial information suggest?\n   646→4. LEADERSHIP ASSESSMENT: What is known about key people and their track records?\n   647→5. RISK SUMMARY: What are the key risks of engaging with this entity?\n   648→6. RECOMMENDATION: Would you recommend proceeding? Under what conditions?\"\"\",\n   649→\n   650→        # ===== PURCHASE DECISION PERSPECTIVES =====\n   651→        \"consumer_advocate\": \"\"\"You are a CONSUMER ADVOCATE and product researcher who has helped thousands of buyers avoid bad purchases. You work for a consumer protection organization and prioritize buyer interests.\n   652→\n   653→Your analytical approach:\n   654→- Prioritize real user experiences over marketing claims\n   655→- Identify common problems and failure patterns\n   656→- Calculate true cost of ownership including hidden costs\n   657→- Evaluate warranty, support, and return policies\n   658→- Compare value against alternatives\n   659→- Flag manipulative sales tactics or misleading claims\n   660→\n   661→Provide your consumer advocate analysis covering:\n   662→1. BUYER BEWARE: What should buyers watch out for?\n   663→2. REAL-WORLD ISSUES: What problems do actual owners report?\n   664→3. TRUE COST: What's the real total cost including hidden expenses?\n   665→4. ALTERNATIVES: What other options should buyers consider?\n   666→5. VALUE ASSESSMENT: Is this a good value for the money?\n   667→6. RECOMMENDATION: Should buyers proceed, wait, or look elsewhere?\"\"\",\n   668→\n   669→        \"technical_expert\": \"\"\"You are a TECHNICAL EXPERT and product specialist who evaluates products based on specifications, build quality, and performance. You write detailed technical reviews and understand what makes products succeed or fail.\n   670→\n   671→Your analytical approach:\n   672→- Evaluate specifications and technical capabilities\n   673→- Assess build quality and durability\n   674→- Compare performance against competitors\n   675→- Identify design flaws or limitations\n   676→- Consider repairability and longevity\n   677→- Evaluate technical support and updates\n   678→\n   679→Provide your technical analysis covering:\n   680→1. TECHNICAL ASSESSMENT: How do the specs and capabilities measure up?\n   681→2. BUILD QUALITY: What's the quality of materials and construction?\n   682→3. PERFORMANCE: How does it perform in real-world use?\n   683→4. LIMITATIONS: What are the technical limitations or design flaws?\n   684→5. LONGEVITY: How long should this product last?\n   685→6. TECHNICAL VERDICT: Is this technically sound?\"\"\",\n   686→\n   687→        \"value_analyst\": \"\"\"You are a VALUE ANALYST who specializes in cost-benefit analysis for consumer purchases. You help buyers understand whether they're getting good value and identify the sweet spots in product lineups.\n   688→\n   689→Your analytical approach:\n   690→- Compare price to features and quality\n   691→- Identify the best value options in each category\n   692→- Calculate cost per use or cost over lifetime\n   693→- Consider resale value and depreciation\n   694→- Evaluate whether premium features justify premium prices\n   695→- Identify when to buy (sales cycles, new model releases)\n   696→\n   697→Provide your value analysis covering:\n   698→1. PRICE ANALYSIS: Is the price fair for what you get?\n   699→2. VALUE COMPARISON: How does value compare to alternatives?\n   700→3. COST OVER TIME: What's the total cost of ownership?\n   701→4. SWEET SPOT: What's the best value option in this category?\n   702→5. TIMING: When is the best time to buy?\n   703→6. VALUE VERDICT: Is this good value for money?\"\"\",\n   704→\n   705→        \"long_term_owner\": \"\"\"You are a PRODUCT REVIEWER who specializes in long-term ownership experiences. You follow up with owners after 6 months, 1 year, and 2 years to understand how products hold up over time.\n   706→\n   707→Your analytical approach:\n   708→- Focus on durability and reliability over time\n   709→- Track how satisfaction changes after the honeymoon period\n   710→- Identify issues that only emerge with extended use\n   711→- Evaluate long-term support and parts availability\n   712→- Consider how well products age with software updates\n   713→- Assess whether owners would buy again\n   714→\n   715→Provide your long-term owner analysis covering:\n   716→1. DURABILITY: How well does this hold up over time?\n   717→2. SATISFACTION TRAJECTORY: How does satisfaction change over time?\n   718→3. EMERGING ISSUES: What problems appear after extended use?\n   719→4. SUPPORT QUALITY: How is long-term support and parts availability?\n   720→5. AGING: How well does this age (software updates, obsolescence)?\n   721→6. REPURCHASE: Would long-term owners buy this again?\"\"\",\n   722→\n   723→        # ===== REPUTATION CHECK PERSPECTIVES =====\n   724→        \"consumer_protection\": \"\"\"You are a CONSUMER PROTECTION SPECIALIST who investigates scams, fraud, and deceptive business practices. You've helped expose numerous scam operations and protect consumers from bad actors.\n   725→\n   726→Your analytical approach:\n   727→- Identify classic scam patterns and red flags\n   728→- Verify business legitimacy through official records\n   729→- Check for regulatory actions and consumer complaints\n   730→- Analyze review authenticity (fake review detection)\n   731→- Investigate ownership and corporate structure\n   732→- Assess whether business practices are sustainable\n   733→\n   734→Provide your consumer protection analysis covering:\n   735→1. SCAM INDICATORS: Are there signs this could be a scam?\n   736→2. LEGITIMACY CHECK: Can the business legitimacy be verified?\n   737→3. COMPLAINT ANALYSIS: What patterns emerge from complaints?\n   738→4. REVIEW AUTHENTICITY: Do the reviews appear genuine?\n   739→5. BUSINESS MODEL: Is the business model sustainable and legitimate?\n   740→6. SAFETY VERDICT: Is it safe to engage with this entity?\"\"\",\n   741→\n   742→        \"reputation_analyst\": \"\"\"You are a REPUTATION ANALYST who tracks and analyzes the reputations of businesses and individuals. You understand how reputations are built, damaged, and recovered.\n   743→\n   744→Your analytical approach:\n   745→- Track reputation across multiple platforms and sources\n   746→- Identify patterns in feedback and reviews\n   747→- Analyze how entities respond to criticism\n   748→- Detect reputation management and astroturfing\n   749→- Assess trajectory (improving or declining)\n   750→- Compare reputation to industry peers\n   751→\n   752→Provide your reputation analysis covering:\n   753→1. REPUTATION OVERVIEW: What is the overall reputation?\n   754→2. PATTERN ANALYSIS: What patterns emerge from reviews and feedback?\n   755→3. RESPONSE QUALITY: How does the entity respond to criticism?\n   756→4. AUTHENTICITY: Are reviews and testimonials genuine?\n   757→5. TRAJECTORY: Is reputation improving or declining?\n   758→6. PEER COMPARISON: How does reputation compare to peers?\"\"\",\n   759→    }\n   760→\n   761→    async def analyze_perspective(\n   762→        self,\n   763→        perspective_type: str,\n   764→        findings: List[Dict[str, Any]],\n   765→        sources: List[Dict[str, Any]],\n   766→        original_query: str,\n   767→    ) -> Dict[str, Any]:\n   768→        \"\"\"Analyze findings from a specific expert perspective.\"\"\"\n   769→        if not self.gemini_client:\n   770→            raise ValueError(\"Gemini client not set\")\n   771→\n   772→        # Build detailed context\n   773→        findings_text = \"\\n\".join([\n   774→            f\"- [{f.get('finding_type', 'fact').upper()}] {f.get('summary', '')} | {f.get('content', '')[:300]}\"\n   775→            for f in findings[:25]\n   776→        ])\n   777→\n   778→        sources_text = \"\\n\".join([\n   779→            f\"- {s.get('title', 'Unknown')} ({s.get('domain', '')})\"\n   780→            for s in sources[:15]\n   781→        ])\n   782→\n   783→        # Get specialized prompt or use default\n   784→        expert_prompt = self.PERSPECTIVE_PROMPTS.get(perspective_type, f\"\"\"\n   785→You are an expert analyst providing deep {perspective_type} analysis.\n   786→Apply your specialized expertise to uncover insights that a generalist would miss.\n   787→Be specific, actionable, and provide evidence-based conclusions.\n   788→\"\"\")\n   789→\n   790→        prompt = f\"\"\"{expert_prompt}\n   791→\n   792→=== RESEARCH QUESTION ===\n   793→{original_query}\n   794→\n   795→=== KEY FINDINGS FROM RESEARCH ===\n   796→{findings_text}\n   797→\n   798→=== SOURCES CONSULTED ===\n   799→{sources_text}\n   800→\n   801→=== YOUR ANALYSIS ===\n   802→Based on your specialized expertise, provide:\n   803→\n   804→1. CORE ANALYSIS: Deep expert analysis from your perspective (3-4 detailed paragraphs)\n   805→   - Explain the reasoning behind each major point\n   806→   - Connect observations to broader patterns or trends\n   807→   - Reference specific findings that support your analysis\n   808→\n   809→2. HIDDEN INSIGHTS: 5-7 insights that only someone with your expertise would notice\n   810→   Each insight MUST include:\n   811→   - The insight itself\n   812→   - WHY this matters (the \"so what?\")\n   813→   - EVIDENCE from the findings that supports this\n   814→   Example: \"Customer concentration risk is higher than it appears because [evidence]. This matters because [implication].\"\n   815→\n   816→3. ACTIONABLE RECOMMENDATIONS: 3-5 specific, actionable recommendations\n   817→   Each recommendation MUST explain:\n   818→   - WHAT to do\n   819→   - WHY this action is warranted (the reasoning)\n   820→   - WHAT EVIDENCE supports this recommendation\n   821→\n   822→4. PREDICTIONS: 2-4 predictions about future developments, each with DETAILED rationale:\n   823→   - prediction: What will likely happen (specific and measurable)\n   824→   - rationale: DETAILED explanation (3-5 sentences) of WHY you predict this, including:\n   825→     * The causal mechanism or logic chain\n   826→     * Historical precedents or patterns that inform this\n   827→     * Key assumptions underlying the prediction\n   828→     * What would need to be true for this to occur\n   829→   - confidence: high/medium/low with EXPLANATION of confidence level\n   830→   - timeline: When this is expected (e.g., \"Q1 2025\", \"6-12 months\")\n   831→   - supporting_evidence: Specific findings or data points that support this\n   832→   - what_could_change_this: Factors that could invalidate the prediction\n   833→\n   834→5. CRITICAL WARNINGS: Important risks or red flags from your perspective\n   835→   Each warning MUST include:\n   836→   - The risk/warning\n   837→   - WHY this is concerning (the mechanism of harm)\n   838→   - What to watch for (leading indicators)\n   839→\n   840→6. KNOWLEDGE GAPS: What additional information would strengthen this analysis?\n   841→   For each gap, explain WHY this information matters and HOW it would change conclusions.\n   842→\n   843→7. CONTRARIAN VIEW: What is the opposite view and why might it be right?\n   844→   Provide genuine steel-man argument with supporting logic.\n   845→\n   846→CRITICAL: Every statement must have supporting reasoning. No unsupported assertions.\n   847→Be specific and cite evidence from the findings. Avoid generic statements.\n   848→\n   849→Return as JSON with keys:\n   850→- analysis_text (string)\n   851→- key_insights (array of strings - each insight should include reasoning)\n   852→- recommendations (array of strings - each with reasoning)\n   853→- predictions (array of objects with: prediction, rationale, confidence, timeline, supporting_evidence, what_could_change_this)\n   854→- warnings (array of strings - each with reasoning)\n   855→- knowledge_gaps (array of strings - each explaining why it matters)\n   856→- contrarian_view (string - with supporting logic)\n   857→- confidence (0.0-1.0)\n   858→- bear_case (object, REQUIRED for short_seller perspective): {{\n   859→    \"probability\": 0.25,\n   860→    \"summary\": \"One sentence summary of bear scenario\",\n   861→    \"trigger\": \"What event/condition would cause the negative outcome\",\n   862→    \"magnitude\": \"Expected impact (e.g., 'stock drops 40%', 'revenue declines 30%')\",\n   863→    \"timeline\": \"When this could materialize (e.g., 'H2 2025', '12-18 months')\",\n   864→    \"kill_signals\": [\"Signal 1 to watch\", \"Signal 2 to watch\", \"Signal 3 to watch\"]\n   865→  }}\n   866→\"\"\"\n   867→\n   868→        result, _ = await self.gemini_client.generate_json(prompt, temperature=0.4)\n   869→\n   870→        # Ensure result is a dict (LLM might return a list or other type)\n   871→        if not isinstance(result, dict):\n   872→            result = {\n   873→                \"analysis_text\": \"Analysis not available\",\n   874→                \"key_insights\": [],\n   875→                \"recommendations\": [],\n   876→                \"predictions\": [],\n   877→                \"warnings\": [],\n   878→                \"knowledge_gaps\": [],\n   879→                \"contrarian_view\": \"\",\n   880→                \"confidence\": 0.3,\n   881→                \"bear_case\": None,\n   882→            }\n   883→\n   884→        # Ensure predictions field exists and is properly structured\n   885→        if \"predictions\" not in result:\n   886→            result[\"predictions\"] = []\n   887→        # Convert old-style string predictions to structured format if needed\n   888→        elif isinstance(result[\"predictions\"], list) and result[\"predictions\"]:\n   889→            if isinstance(result[\"predictions\"][0], str):\n   890→                result[\"predictions\"] = [\n   891→                    {\n   892→                        \"prediction\": p,\n   893→                        \"rationale\": \"Based on research findings\",\n   894→                        \"confidence\": \"medium\",\n   895→                        \"timeline\": \"2025-2026\",\n   896→                        \"supporting_sources\": []\n   897→                    }\n   898→                    for p in result[\"predictions\"]\n   899→                ]\n   900→\n   901→        # Ensure bear_case is properly structured for short_seller perspective\n   902→        if perspective_type == \"short_seller\":\n   903→            if \"bear_case\" not in result or not isinstance(result.get(\"bear_case\"), dict):\n   904→                # Try to extract bear case summary from analysis_text\n   905→                analysis_text = result.get(\"analysis_text\", \"\")\n   906→                contrarian_view = result.get(\"contrarian_view\", \"\")\n   907→                warnings = result.get(\"warnings\", [])\n   908→\n   909→                # Build a meaningful summary from available data\n   910→                summary = \"\"\n   911→                if contrarian_view:\n   912→                    summary = contrarian_view[:200]\n   913→                elif warnings:\n   914→                    summary = f\"Key risks: {'; '.join(warnings[:2])}\"\n   915→                elif analysis_text:\n   916→                    # Extract first substantive sentence\n   917→                    sentences = analysis_text.split(\". \")\n   918→                    summary = sentences[0][:200] if sentences else \"See analysis for bear case details\"\n   919→\n   920→                result[\"bear_case\"] = {\n   921→                    \"probability\": 0.25,\n   922→                    \"summary\": summary,\n   923→                    \"trigger\": warnings[0] if warnings else \"Multiple risk factors could materialize\",\n   924→                    \"magnitude\": \"Significant downside potential - see analysis\",\n   925→                    \"timeline\": \"6-18 months\",\n   926→                    \"kill_signals\": warnings[:5] if warnings else [\"Monitor key risk factors\"]\n   927→                }\n   928→            else:\n   929→                # Ensure all fields exist with meaningful defaults\n   930→                bear_case = result[\"bear_case\"]\n   931→                warnings = result.get(\"warnings\", [])\n   932→\n   933→                if not bear_case.get(\"probability\"):\n   934→                    bear_case[\"probability\"] = 0.25\n   935→                if not bear_case.get(\"summary\"):\n   936→                    bear_case[\"summary\"] = result.get(\"contrarian_view\", \"\")[:200] or \"See analysis\"\n   937→                if not bear_case.get(\"trigger\"):\n   938→                    bear_case[\"trigger\"] = warnings[0] if warnings else \"\"\n   939→                if not bear_case.get(\"magnitude\"):\n   940→                    bear_case[\"magnitude\"] = \"\"\n   941→                if not bear_case.get(\"timeline\"):\n   942→                    bear_case[\"timeline\"] = \"6-18 months\"\n   943→                if not bear_case.get(\"kill_signals\"):\n   944→                    bear_case[\"kill_signals\"] = warnings[:5] if warnings else []\n   945→\n   946→        result[\"perspective_type\"] = perspective_type\n   947→        return result\n   948→\n   949→    async def _call_gemini_json(self, prompt: str) -> Any:\n   950→        \"\"\"Call Gemini with JSON response format.\"\"\"\n   951→        if not self.gemini_client:\n   952→            raise ValueError(\"Gemini client not set\")\n   953→\n   954→        result, response = await self.gemini_client.generate_json(prompt)\n   955→        return result\n   956→\n   957→    def get_query_generation_prompt(self, query: str, max_searches: int) -> str:\n   958→        \"\"\"Get default prompt for query generation.\"\"\"\n   959→        return f\"\"\"\n   960→You are a research strategist. Generate {max_searches} search queries for comprehensive research.\n   961→\n   962→Research Question: {query}\n   963→\n   964→Guidelines:\n   965→1. Start broad to understand the landscape\n   966→2. Include specific queries for key entities/events\n   967→3. Include queries for different perspectives\n   968→4. Include queries for recent news/developments\n   969→5. Include queries for authoritative sources\n   970→\n   971→Return a JSON array of search query strings.\n   972→Example: [\"query 1\", \"query 2\", \"query 3\"]\n   973→\"\"\"\n   974→\n   975→    # ========== SOURCE VERIFICATION METHODS ==========\n   976→\n   977→    async def verify_findings(\n   978→        self,\n   979→        findings: List[Dict[str, Any]],\n   980→        sources: List[Dict[str, Any]],\n   981→        original_query: str,\n   982→    ) -> List[Dict[str, Any]]:\n   983→        \"\"\"\n   984→        Run verification layer on extracted findings.\n   985→        Returns findings enriched with verification metadata and Bayesian confidence.\n   986→\n   987→        The confidence calculation uses a proper Bayesian network where:\n   988→        - P(finding is true) depends on P(sources are credible)\n   989→        - P(source is credible) depends on P(domain is authoritative)\n   990→        - Multiple sources are combined using proper probability theory\n   991→        - Bias detection and expert checks provide likelihood ratios\n   992→\n   993→        This makes confidence scores interpretable and explainable:\n   994→        'This finding has 73% confidence because source A (85% credible)\n   995→        corroborates source B (60% credible) but contradicts source C.'\n   996→        \"\"\"\n   997→        if not self.gemini_client:\n   998→            return findings\n   999→\n  1000→        from ..services.bayesian_confidence import calculate_bayesian_confidence\n  1001→\n  1002→        config = self.verification_config\n  1003→        verified_findings = []\n  1004→\n  1005→        for finding in findings:\n  1006→            verification = {}\n  1007→\n  1008→            # Run applicable verification checks based on config\n  1009→            if config.get(\"bias_detection\") != \"none\":\n  1010→
[2026-01-29T23:29:03.589Z] [STDOUT] bias_result = await self._detect_bias(finding, sources)\n  1011→                verification[\"bias\"] = bias_result\n  1012→\n  1013→            if config.get(\"expert_sanity_check\") != \"none\":\n  1014→                sanity_result = await self._expert_sanity_check(finding, original_query)\n  1015→                verification[\"expert_check\"] = sanity_result\n  1016→\n  1017→            # Calculate Bayesian confidence with full context\n  1018→            # This uses proper probability inference instead of additive adjustments\n  1019→            adjusted_confidence, confidence_explanation = calculate_bayesian_confidence(\n  1020→                finding=finding,\n  1021→                sources=sources,\n  1022→                verification=verification,\n  1023→            )\n  1024→\n  1025→            # Enrich finding with verification and Bayesian confidence\n  1026→            verified_finding = {**finding}\n  1027→            verified_finding[\"verification\"] = verification\n  1028→            verified_finding[\"adjusted_confidence\"] = adjusted_confidence\n  1029→\n  1030→            # Add confidence explanation for interpretability\n  1031→            verified_finding[\"confidence_explanation\"] = confidence_explanation.to_dict()\n  1032→            verified_finding[\"confidence_narrative\"] = confidence_explanation.generate_narrative()\n  1033→\n  1034→            verified_findings.append(verified_finding)\n  1035→\n  1036→        # Run cross-reference analysis on all findings together\n  1037→        if config.get(\"cross_reference\") != \"none\" and len(verified_findings) > 1:\n  1038→            cross_ref_results = await self._cross_reference_findings(verified_findings, sources)\n  1039→            for i, finding in enumerate(verified_findings):\n  1040→                if i < len(cross_ref_results):\n  1041→                    finding[\"verification\"][\"cross_reference\"] = cross_ref_results[i]\n  1042→\n  1043→                    # Recalculate confidence with cross-reference data\n  1044→                    # This updates the Bayesian network with corroboration evidence\n  1045→                    updated_confidence, updated_explanation = calculate_bayesian_confidence(\n  1046→                        finding=finding,\n  1047→                        sources=sources,\n  1048→                        verification=finding[\"verification\"],\n  1049→                    )\n  1050→                    finding[\"adjusted_confidence\"] = updated_confidence\n  1051→                    finding[\"confidence_explanation\"] = updated_explanation.to_dict()\n  1052→                    finding[\"confidence_narrative\"] = updated_explanation.generate_narrative()\n  1053→\n  1054→        return verified_findings\n  1055→\n  1056→    async def _detect_bias(\n  1057→        self,\n  1058→        finding: Dict[str, Any],\n  1059→        sources: List[Dict[str, Any]],\n  1060→    ) -> Dict[str, Any]:\n  1061→        \"\"\"Detect bias and 'skin in the game' for a finding.\"\"\"\n  1062→        # Find sources that might support this finding\n  1063→        finding_content = finding.get(\"content\", \"\")[:500]\n  1064→\n  1065→        prompt = f\"\"\"You are an investigative analyst detecting bias and conflicts of interest.\n  1066→\n  1067→FINDING TO ANALYZE:\n  1068→{finding_content}\n  1069→\n  1070→FINDING TYPE: {finding.get(\"finding_type\", \"unknown\")}\n  1071→\n  1072→Perform BIAS DETECTION:\n  1073→\n  1074→1. SKIN IN THE GAME\n  1075→   Who benefits if this claim is believed?\n  1076→   - VENDOR SELF-PROMOTION: Is this a company praising their own product?\n  1077→   - ANALYST CONFLICTS: Could the source have financial relationships?\n  1078→   - COMPETITIVE POSITIONING: Is someone trashing a competitor?\n  1079→   - INVESTMENT TALKING BOOK: Is source long/short a related stock?\n  1080→\n  1081→2. LINGUISTIC RED FLAGS\n  1082→   Check for weasel words and marketing language:\n  1083→   - \"Up to X%\" (cherry-picked best case)\n  1084→   - \"Studies show\" without citation\n  1085→   - \"Industry-leading\" (unmeasured claim)\n  1086→   - \"Revolutionary\" (marketing hyperbole)\n  1087→   - Lack of specific numbers\n  1088→\n  1089→3. METHODOLOGY CONCERNS\n  1090→   - Is sample size mentioned? Is it adequate?\n  1091→   - Is the methodology transparent?\n  1092→   - Could there be selection/survivorship bias?\n  1093→   - Are definitions clear (e.g., \"adoption\" = trial or daily use)?\n  1094→\n  1095→Return JSON:\n  1096→{{\n  1097→  \"bias_detected\": true/false,\n  1098→  \"bias_score\": 0.0-1.0 (0=unbiased, 1=heavily biased),\n  1099→  \"bias_type\": \"vendor_marketing\" | \"analyst_conflict\" | \"competitive_attack\" | \"selection_bias\" | \"none\",\n  1100→  \"skin_in_the_game\": \"Brief description of who benefits\" or null,\n  1101→  \"red_flags\": [\"list of specific red flags found\"],\n  1102→  \"confidence_adjustment\": -0.3 to 0.0 (suggested adjustment to confidence)\n  1103→}}\n  1104→\"\"\"\n  1105→\n  1106→        try:\n  1107→            result = await self._call_gemini_json(prompt)\n  1108→            if isinstance(result, dict):\n  1109→                return result\n  1110→        except Exception:\n  1111→            pass\n  1112→\n  1113→        return {\n  1114→            \"bias_detected\": False,\n  1115→            \"bias_score\": 0.0,\n  1116→            \"bias_type\": \"none\",\n  1117→            \"skin_in_the_game\": None,\n  1118→            \"red_flags\": [],\n  1119→            \"confidence_adjustment\": 0.0\n  1120→        }\n  1121→\n  1122→    async def _expert_sanity_check(\n  1123→        self,\n  1124→        finding: Dict[str, Any],\n  1125→        original_query: str,\n  1126→    ) -> Dict[str, Any]:\n  1127→        \"\"\"Use LLM expertise to sanity-check claims.\"\"\"\n  1128→        finding_content = finding.get(\"content\", \"\")[:800]\n  1129→        finding_type = finding.get(\"finding_type\", \"unknown\")\n  1130→        extracted_data = finding.get(\"extracted_data\", {})\n  1131→\n  1132→        prompt = f\"\"\"You are a senior analyst with 20+ years of domain expertise. Apply your knowledge to evaluate this claim.\n  1133→\n  1134→RESEARCH CONTEXT: {original_query[:200]}\n  1135→\n  1136→FINDING TO EVALUATE:\n  1137→Type: {finding_type}\n  1138→Content: {finding_content}\n  1139→Data: {extracted_data}\n  1140→\n  1141→Apply EXPERT JUDGMENT:\n  1142→\n  1143→1. PLAUSIBILITY CHECK\n  1144→   Based on your knowledge:\n  1145→   - Does this claim seem reasonable?\n  1146→   - Are the numbers/percentages realistic?\n  1147→   - Does it align with known market dynamics?\n  1148→\n  1149→   Common implausible patterns:\n  1150→   - \"40% adoption\" for products launched recently\n  1151→   - Productivity gains >50% (realistic is 10-30%)\n  1152→   - \"100% of X\" claims (nothing is 100%)\n  1153→   - Growth rates >200% in mature markets\n  1154→\n  1155→2. HISTORICAL PATTERN\n  1156→   - Does this match how similar situations played out?\n  1157→   - What's the typical timeline for such claims?\n  1158→   - Are there precedents that support or contradict this?\n  1159→\n  1160→3. MISSING CONTEXT\n  1161→   - What important context is missing?\n  1162→   - \"Grew 200%\" - from what base?\n  1163→   - \"Faster than X\" - by what measure?\n  1164→\n  1165→4. EXTRAORDINARY CLAIMS FLAG\n  1166→   Flag if this requires extraordinary evidence:\n  1167→   - >50% productivity improvement\n  1168→   - >80% adoption rate\n  1169→   - \"First ever\" or \"only solution\" claims\n  1170→\n  1171→Return JSON:\n  1172→{{\n  1173→  \"plausibility\": \"plausible\" | \"questionable\" | \"implausible\",\n  1174→  \"plausibility_score\": 0.0-1.0 (1=highly plausible),\n  1175→  \"expert_reasoning\": \"2-3 sentence explanation\",\n  1176→  \"historical_precedent\": \"How does this compare to similar claims historically?\",\n  1177→  \"missing_context\": [\"list of missing context that would help evaluate\"],\n  1178→  \"adjusted_estimate\": \"What's a more realistic interpretation?\" or null,\n  1179→  \"extraordinary_claim\": true/false,\n  1180→  \"confidence_adjustment\": -0.3 to 0.1 (negative if questionable, small positive if strongly supported)\n  1181→}}\n  1182→\"\"\"\n  1183→\n  1184→        try:\n  1185→            result = await self._call_gemini_json(prompt)\n  1186→            if isinstance(result, dict):\n  1187→                return result\n  1188→        except Exception:\n  1189→            pass\n  1190→\n  1191→        return {\n  1192→            \"plausibility\": \"plausible\",\n  1193→            \"plausibility_score\": 0.7,\n  1194→            \"expert_reasoning\": \"Unable to perform detailed sanity check\",\n  1195→            \"historical_precedent\": None,\n  1196→            \"missing_context\": [],\n  1197→            \"adjusted_estimate\": None,\n  1198→            \"extraordinary_claim\": False,\n  1199→            \"confidence_adjustment\": 0.0\n  1200→        }\n  1201→\n  1202→    async def _cross_reference_findings(\n  1203→        self,\n  1204→        findings: List[Dict[str, Any]],\n  1205→        sources: List[Dict[str, Any]],\n  1206→    ) -> List[Dict[str, Any]]:\n  1207→        \"\"\"Cross-reference findings to identify agreements and contradictions.\"\"\"\n  1208→        # Build findings summary for cross-reference\n  1209→        findings_summary = []\n  1210→        for i, f in enumerate(findings[:15]):  # Limit to avoid token overflow\n  1211→            findings_summary.append({\n  1212→                \"index\": i,\n  1213→                \"type\": f.get(\"finding_type\"),\n  1214→                \"summary\": f.get(\"summary\", \"\")[:100],\n  1215→                \"content\": f.get(\"content\", \"\")[:200],\n  1216→                \"confidence\": f.get(\"confidence_score\", 0.5)\n  1217→            })\n  1218→\n  1219→        prompt = f\"\"\"You are a research verification analyst cross-referencing findings.\n  1220→\n  1221→FINDINGS TO CROSS-REFERENCE:\n  1222→{findings_summary}\n  1223→\n  1224→NUMBER OF SOURCES: {len(sources)}\n  1225→\n  1226→For each finding, analyze:\n  1227→\n  1228→1. CORROBORATION\n  1229→   - Do other findings support or contradict this one?\n  1230→   - Would multiple sources logically cover this claim?\n  1231→\n  1232→2. INTERNAL CONSISTENCY\n  1233→   - Do any findings contradict each other?\n  1234→   - Are there logical inconsistencies?\n  1235→\n  1236→3. SOURCE DIVERSITY\n  1237→   - Is this claim likely from a single source or multiple?\n  1238→   - Primary data vs secondary citation?\n  1239→\n  1240→Return JSON array with one object per finding (same order as input):\n  1241→[\n  1242→  {{\n  1243→    \"finding_index\": 0,\n  1244→    \"corroboration_level\": \"strong\" | \"moderate\" | \"weak\" | \"uncorroborated\",\n  1245→    \"supporting_findings\": [list of finding indices that support this],\n  1246→    \"contradicting_findings\": [list of finding indices that contradict this],\n  1247→    \"likely_source_diversity\": \"single\" | \"few\" | \"multiple\",\n  1248→    \"verification_notes\": \"Brief note on verification status\",\n  1249→    \"confidence_adjustment\": -0.2 to 0.1\n  1250→  }}\n  1251→]\n  1252→\"\"\"\n  1253→\n  1254→        try:\n  1255→            result = await self._call_gemini_json(prompt)\n  1256→            if isinstance(result, list):\n  1257→                return result\n  1258→        except Exception:\n  1259→            pass\n  1260→\n  1261→        # Return empty cross-reference for each finding\n  1262→        return [{\"corroboration_level\": \"unknown\", \"confidence_adjustment\": 0.0} for _ in findings]\n  1263→\n  1264→    def _calculate_adjusted_confidence(\n  1265→        self,\n  1266→        original_confidence: float,\n  1267→        verification: Dict[str, Any],\n  1268→        finding: Optional[Dict[str, Any]] = None,\n  1269→        sources: Optional[List[Dict[str, Any]]] = None,\n  1270→    ) -> float:\n  1271→        \"\"\"Calculate adjusted confidence score using Bayesian inference.\n  1272→\n  1273→        This replaces the additive adjustment model with proper probabilistic\n  1274→        inference. Instead of summing adjustments (which can violate probability\n  1275→        rules), we use Bayes' theorem to properly combine evidence.\n  1276→\n  1277→        The Bayesian approach provides:\n  1278→        1. Interpretable confidence scores (true probabilities)\n  1279→        2. Explainable reasoning chain (why confidence changed)\n  1280→        3. Proper handling of corroborating/contradicting evidence\n  1281→        4. Insights into what would change the conclusion\n  1282→\n  1283→        Args:\n  1284→            original_confidence: Base confidence from finding extraction\n  1285→            verification: Verification results (bias, expert_check, cross_reference)\n  1286→            finding: Optional finding dict for full Bayesian calculation\n  1287→            sources: Optional sources list for credibility assessment\n  1288→\n  1289→        Returns:\n  1290→            Adjusted confidence score (probability) between 0.1 and 0.95\n  1291→        \"\"\"\n  1292→        from ..services.bayesian_confidence import calculate_bayesian_confidence\n  1293→\n  1294→        # If we have the full context, use the comprehensive Bayesian model\n  1295→        if finding is not None and sources is not None:\n  1296→            # Create a finding dict with the original confidence\n  1297→            finding_with_conf = {**finding, \"confidence_score\": original_confidence}\n  1298→            adjusted, _ = calculate_bayesian_confidence(\n  1299→                finding_with_conf, sources, verification\n  1300→            )\n  1301→            return adjusted\n  1302→\n  1303→        # Fallback: Use simplified Bayesian update for just verification data\n  1304→        return self._calculate_adjusted_confidence_legacy(\n  1305→            original_confidence, verification\n  1306→        )\n  1307→\n  1308→    def _calculate_adjusted_confidence_legacy(\n  1309→        self,\n  1310→        original_confidence: float,\n  1311→        verification: Dict[str, Any],\n  1312→    ) -> float:\n  1313→        \"\"\"Legacy additive confidence calculation (for backwards compatibility).\n  1314→\n  1315→        Note: This is a fallback when full Bayesian calculation isn't possible.\n  1316→        The additive model doesn't properly handle probability combination,\n  1317→        but is kept for cases where we don't have full source data.\n  1318→        \"\"\"\n  1319→        adjusted = original_confidence\n  1320→\n  1321→        # Apply bias adjustment\n  1322→        if \"bias\" in verification:\n  1323→            bias_adj = verification[\"bias\"].get(\"confidence_adjustment\", 0.0)\n  1324→            adjusted += bias_adj\n  1325→\n  1326→        # Apply expert sanity check adjustment\n  1327→        if \"expert_check\" in verification:\n  1328→            expert_adj = verification[\"expert_check\"].get(\"confidence_adjustment\", 0.0)\n  1329→            adjusted += expert_adj\n  1330→\n  1331→        # Apply cross-reference adjustment\n  1332→        if \"cross_reference\" in verification:\n  1333→            cross_adj = verification[\"cross_reference\"].get(\"confidence_adjustment\", 0.0)\n  1334→            adjusted += cross_adj\n  1335→\n  1336→        # Clamp to valid range\n  1337→        return max(0.1, min(1.0, adjusted))\n  1338→\n  1339→    # ========== REPORT GENERATION METHODS ==========\n  1340→\n  1341→    def get_supported_report_variants(self) -> List[str]:\n  1342→        \"\"\"Get list of report variants supported by this template.\n  1343→\n  1344→        Subclasses can override to add domain-specific variants.\n  1345→        \"\"\"\n  1346→        return [\"full_report\", \"executive_summary\", \"decision_brief\"]\n  1347→\n  1348→    def generate_report(\n  1349→        self,\n  1350→        result: Dict[str, Any],\n  1351→        variant: str = \"full_report\",\n  1352→        title: Optional[str] = None,\n  1353→    ) -> str:\n  1354→        \"\"\"Generate a report in the specified variant.\n  1355→\n  1356→        This is the main entry point for report generation.\n  1357→        Templates can override specific variant methods for domain-specific rendering.\n  1358→\n  1359→        Args:\n  1360→            result: Research result dictionary\n  1361→            variant: Report variant (full_report, executive_summary, or template-specific)\n  1362→            title: Optional custom title\n  1363→\n  1364→        Returns:\n  1365→            Formatted markdown string\n  1366→        \"\"\"\n  1367→        if variant == \"executive_summary\":\n  1368→            return self.generate_executive_summary(result, title)\n  1369→        elif variant == \"full_report\":\n  1370→            return self.generate_full_report(result, title)\n  1371→        elif variant == \"decision_brief\":\n  1372→            return self.generate_decision_brief(result, title)\n  1373→        else:\n  1374→            # Check for template-specific variants\n  1375→            method_name = f\"generate_{variant}\"\n  1376→            if hasattr(self, method_name):\n  1377→                return getattr(self, method_name)(result, title)\n  1378→            # Fall back to full report for unknown variants\n  1379→            return self.generate_full_report(result, title)\n  1380→\n  1381→    def generate_full_report(\n  1382→        self,\n  1383→        result: Dict[str, Any],\n  1384→        title: Optional[str] = None,\n  1385→    ) -> str:\n  1386→        \"\"\"Generate full detailed report.\n  1387→\n  1388→        This provides a default implementation. Subclasses can override\n  1389→        for domain-specific full report formatting.\n  1390→        \"\"\"\n  1391→        from datetime import datetime\n  1392→\n  1393→        query = result.get(\"query\", \"Unknown Query\")\n  1394→        template = result.get(\"template\", self.template_id)\n  1395→        report_title = title or f\"Research Report: {query[:50]}\"\n  1396→\n  1397→        sections = []\n  1398→\n  1399→        # Header\n  1400→        sections.append(f\"# {report_title}\")\n  1401→        sections.append(\"\")\n  1402→        sections.append(f\"**Research Query:** {query}\")\n  1403→        sections.append(f\"**Template:** {template.replace('_', ' ').title()} Research\")\n  1404→        sections.append(f\"**Generated:** {datetime.now().strftime('%B %d, %Y at %H:%M')}\")\n  1405→        sections.append(f\"**Status:** {result.get('status', 'unknown').title()}\")\n  1406→        sections.append(\"\")\n  1407→        sections.append(\"---\")\n  1408→        sections.append(\"\")\n  1409→\n  1410→        # Template-specific header content\n  1411→        header_content = self._generate_report_header(result)\n  1412→        if header_content:\n  1413→            sections.append(header_content)\n  1414→            sections.append(\"\")\n  1415→            sections.append(\"---\")\n  1416→            sections.append(\"\")\n  1417→\n  1418→        # Executive Summary section\n  1419→        sections.append(\"## Executive Summary\")\n  1420→        sections.append(\"\")\n  1421→        findings = result.get(\"findings\", [])\n  1422→        if findings:\n  1423→            high_conf = [f for f in findings if f.get(\"confidence_score\", 0) >= 0.7]\n  1424→            sections.append(f\"This research identified **{len(findings)}** key findings across multiple categories.\")\n  1425→            sections.append(f\"**{len(high_conf)}** findings have high confidence (>70%).\")\n  1426→            sections.append(\"\")\n  1427→\n  1428→            # Key findings summary (template can customize via _get_priority_findings)\n  1429→            priority_findings = self._get_priority_findings(findings)\n  1430→            for finding in priority_findings[:5]:\n  1431→                ftype = finding.get(\"finding_type\", \"fact\").upper()\n  1432→                summary = finding.get(\"summary\") or finding.get(\"content\", \"\")[:100]\n  1433→                sections.append(f\"- **[{ftype}]** {summary}\")\n  1434→            sections.append(\"\")\n  1435→        else:\n  1436→            sections.append(\"No significant findings were extracted.\")\n  1437→            sections.append(\"\")\n  1438→\n  1439→        sections.append(\"---\")\n  1440→        sections.append(\"\")\n  1441→\n  1442→        # Template-specific key sections\n  1443→        key_sections = self._generate_key_sections(result)\n  1444→        if key_sections:\n  1445→            sections.append(key_sections)\n  1446→            sections.append(\"\")\n  1447→            sections.append(\"---\")\n  1448→            sections.append(\"\")\n  1449→\n  1450→        # Detailed Findings\n  1451→        sections.append(\"## Detailed Findings\")\n  1452→        sections.append(\"\")\n  1453→\n  1454→        # Group by type (template can customize grouping)\n  1455→        grouped_findings = self._group_findings(findings)\n  1456→\n  1457→        for ftype, type_findings in grouped_findings.items():\n  1458→            sections.append(f\"### {ftype.replace('_', ' ').title()} ({len(type_findings)})\")\n  1459→            sections.append(\"\")\n  1460→\n  1461→            for finding in type_findings:\n  1462→                conf = finding.get(\"confidence_score\", 0.5)\n  1463→                conf_label = \"High\" if conf >= 0.8 else \"Medium\" if conf >= 0.6 else \"Low\"\n  1464→                sections.append(f\"#### {finding.get('summary', finding.get('content', '')[:60])}\")\n  1465→                sections.append(\"\")\n  1466→                sections.append(finding.get(\"content\", \"\"))\n  1467→                sections.append(\"\")\n  1468→                sections.append(f\"*Confidence: {conf_label} ({conf:.0%})*\")\n  1469→                sections.append(\"\")\n  1470→\n  1471→        sections.append(\"---\")\n  1472→        sections.append(\"\")\n  1473→\n  1474→        # Perspectives\n  1475→        perspectives = result.get(\"perspectives\", [])\n  1476→        if perspectives:\n  1477→            sections.append(\"## Multi-Perspective Analysis\")\n  1478→            sections.append(\"\")\n  1479→\n  1480→            for perspective in perspectives:\n  1481→                ptype = perspective.get(\"perspective_type\", \"unknown\").replace(\"_\", \" \").title()\n  1482→                sections.append(f\"### {ptype} Perspective\")\n  1483→                sections.append(\"\")\n  1484→                sections.append(perspective.get(\"analysis_text\", \"\"))\n  1485→                sections.append(\"\")\n  1486→\n  1487→                insights = perspective.get(\"key_insights\", [])\n  1488→                if insights:\n  1489→                    sections.append(\"**Key Insights:**\")\n  1490→                    for insight in insights:\n  1491→                        sections.append(f\"- {insight}\")\n  1492→                    sections.append(\"\")\n  1493→\n  1494→                recs = perspective.get(\"recommendations\", [])\n  1495→                if recs:\n  1496→                    sections.append(\"**Recommendations:**\")\n  1497→                    for rec in recs:\n  1498→                        sections.append(f\"- {rec}\")\n  1499→                    sections.append(\"\")\n  1500→\n  1501→                warnings = perspective.get(\"warnings\", [])\n  1502→                if warnings:\n  1503→                    sections.append(\"**Warnings:**\")\n  1504→                    for warning in warnings:\n  1505→                        sections.append(f\"- {warning}\")\n  1506→                    sections.append(\"\")\n  1507→\n  1508→            sections.append(\"---\")\n  1509→            sections.append(\"\")\n  1510→\n  1511→        # Template-specific additional sections\n  1512→        additional = self._generate_additional_sections(result)\n  1513→        if additional:\n  1514→            sections.append(additional)\n  1515→            sections.append(\"\")\n  1516→            sections.append(\"---\")\n  1517→            sections.append(\"\")\n  1518→\n  1519→        # Sources\n  1520→        sources = result.get(\"sources\", [])\n  1521→        if sources:\n  1522→            sections.append(\"## Sources\")\n  1523→            sections.append(\"\")\n  1524→\n  1525→            for source in sources[:20]:\n  1526→                title_text = source.get(\"title\", source.get(\"url\", \"Unknown\"))\n  1527→                url = source.get(\"url\", \"#\")\n  1528→                cred = source.get(\"credibility_score\", 0.5)\n  1529→                sections.append(f\"- [{title_text}]({url}) - Credibility: {cred:.0%}\")\n  1530→\n  1531→            sections.append(\"\")\n  1532→            sections.append(\"---\")\n  1533→            sections.append(\"\")\n  1534→\n  1535→        # Metadata\n  1536→        sections.append(\"## Research Metadata\")\n  1537→        sections.append(\"\")\n  1538→        sections.append(f\"- **Session ID:** {result.get('session_id', 'N/A')}\")\n  1539→        sections.append(f\"- **Execution Time:** {result.get('execution_time_seconds', 0):.1f} seconds\")\n  1540→\n  1541→        cost = result.get(\"cost_summary\", {})\n  1542→        if cost:\n  1543→            sections.append(f\"- **Total Tokens:** {cost.get('total_tokens', 0):,}\")\n  1544→            sections.append(f\"- **Total Cost:** ${cost.get('total_cost_usd', 0):.4f}\")\n  1545→\n  1546→        queries = result.get(\"search_queries_executed\", [])\n  1547→        if queries:\n  1548→            sections.append(f\"- **Searches Executed:** {len(queries)}\")\n  1549→\n  1550→        return \"\\n\".join(sections)\n  1551→\n  1552→    def generate_executive_summary(\n  1553→        self,\n  1554→        result: Dict[str, Any],\n  1555→        title: Optional[str] = None,\n  1556→    ) -> str:\n  1557→        \"\"\"Generate brief executive summary.\n  1558→\n  1559→        This provides a default implementation. Subclasses can override\n  1560→        for domain-specific executive summary formatting.\n  1561→        \"\"\"\n  1562→        from datetime import datetime\n  1563→\n  1564→        query = result.get(\"query\", \"Unknown Query\")\n  1565→        report_title = title or f\"Executive Summary: {query[:40]}\"\n  1566→\n  1567→        sections = []\n  1568→        sections.append(f\"# {report_title}\")\n  1569→        sections.append(\"\")\n  1570→        sections.append(f\"**Research Query:** {query}\")\n  1571→        sections.append(f\"**Generated:** {datetime.now().strftime('%B %d, %Y')}\")\n  1572→        sections.append(\"\")\n  1573→        sections.append(\"---\")\n  1574→        sections.append(\"\")\n  1575→\n  1576→        # Key findings\n  1577→        sections.append(\"## Key Findings\")\n  1578→        sections.append(\"\")\n  1579→\n  1580→        findings = result.get(\"findings\", [])\n  1581→        priority_findings = self._get_priority_findings(findings)\n  1582→\n  1583→        for finding in priority_findings[:7]:\n  1584→            ftype = finding.get(\"finding_type\", \"fact\").upper()\n  1585→            summary = finding.get(\"summary\") or finding.get(\"content\", \"\")[:150]\n  1586→            sections.append(f\"- **[{ftype}]** {summary}\")\n  1587→\n  1588→        sections.append(\"\")\n  1589→\n  1590→        # Template-specific executive highlights\n  1591→        highlights = self._generate_executive_highlights(result)\n  1592→        if highlights:\n  1593→            sections.append(highlights)\n  1594→            sections.append(\"\")\n  1595→\n  1596→        # Key perspectives\n  1597→        perspectives = result.get(\"perspectives\", [])\n  1598→        if perspectives:\n  1599→            sections.append(\"## Expert Perspectives\")\n  1600→            sections.append(\"\")\n  1601→\n  1602→            for p in perspectives:\n  1603→                ptype = p.get(\"perspective_type\", \"\").replace(\"_\", \" \").title()\n  1604→                insights = p.get(\"key_insights\", [])\n  1605→                if insights:\n  1606→                    sections.append(f\"**{ptype}:** {insights[0]}\")\n  1607→\n  1608→            sections.append(\"\")\n  1609→\n  1610→        sections.append(\"---\")\n  1611→        sections.append(\"\")\n  1612→        sections.append(f\"*Full report contains {len(findings)} findings from {len(result.get('sources', []))} sources.*\")\n  1613→\n  1614→        return \"\\n\".join(sections)\n  1615→\n  1616→    def generate_decision_brief(\n  1617→        self,\n  1618→        result: Dict[str, Any],\n  1619→        title: Optional[str] = None,\n  1620→    ) -> str:\n  1621→        \"\"\"Generate focused one-page decision brief.\n  1622→\n  1623→        This is a highly condensed format focused on actionable insights\n  1624→        for busy executives. Maximum one page when printed.\n  1625→        \"\"\"\n  1626→        from datetime import datetime\n  1627→\n  1628→        query = result.get(\"query\", \"Unknown Query\")\n  1629→        report_title = title or f\"Decision Brief: {query[:35]}\"\n  1630→        findings = result.get(\"findings\", [])\n  1631→        perspectives = result.get(\"perspectives\", [])\n  1632→\n  1633→        sections = []\n  1634→\n  1635→        # Header - compact\n  1636→        sections.append(f\"# {report_title}\")\n  1637→        sections.append(f\"*{datetime.now().strftime('%B %d, %Y')} | {len(findings)} findings | Confidence: {self._calculate_avg_confidence(findings):.0%}*\")\n  1638→        sections.append(\"\")\n  1639→        sections.append(\"---\")\n  1640→        sections.append(\"\")\n  1641→\n  1642→        # Bottom Line Up Front (BLUF)\n  1643→        sections.append(\"## Bottom Line\")\n  1644→        sections.append(\"\")\n  1645→        priority = self._get_priority_findings(findings)\n  1646→        if priority:\n  1647→            top_finding = priority[0]\n  1648→            sections.append(f\"> {top_finding.get('summary') or top_finding.get('content', '')[:200]}\")\n  1649→        sections.append(\"\")\n  1650→\n  1651→        # Key Facts (3-5 bullets max)\n  1652→        sections.append(\"## Key Facts\")\n  1653→        sections.append(\"\")\n  1654→        facts = [f for f in findings if f.get(\"finding_type\") == \"fact\"][:5]\n  1655→        if not facts:\n  1656→            facts = priority[:5]\n  1657→        for f in facts:\n  1658→            conf = f.get(\"confidence_score\", 0.5)\n  1659→            conf_icon = \"\" if conf >= 0.8 else \"\" if conf >= 0.6 else \"\"\n  1660→            sections.append(f\"- {conf_icon} {f.get('summary') or f.get('content', '')[:100]}\")\n  1661→        sections.append(\"\")\n  1662→\n  1663→        # Risk Callout Box\n  1664→        red_flags = [f for f in findings if f.get(\"finding_type\") in [\"red_flag\", \"suspicious_element\", \"risk\"]]\n  1665→        if red_flags:\n  1666→            sections.append(\"## Risks & Red Flags\")\n  1667→            sections.append(\"\")\n  1668→            for rf in red_flags[:3]:\n  1669→                sections.append(f\"- {rf.get('summary') or rf.get('content', '')[:80]}\")\n  1670→            sections.append(\"\")\n  1671→\n  1672→        # Recommendations (from perspectives)\n  1673→        all_recs = []\n  1674→        for p in perspectives:\n  1675→            recs = p.get(\"recommendations\", [])\n  1676→            all_recs.extend(recs[:2])\n  1677→        if all_recs:\n  1678→            sections.append(\"## Recommended Actions\")\n  1679→            sections.append(\"\")\n  1680→            for rec in all_recs[:4]:\n  1681→                if isinstance(rec, str):\n  1682→                    sections.append(f\"- {rec[:100]}\")\n  1683→            sections.append(\"\")\n  1684→\n  1685→        # Knowledge Gaps (brief)\n  1686→        gaps = [f for f in findings if f.get(\"finding_type\") == \"gap\"]\n  1687→        if gaps:\n  1688→            sections.append(\"## Open Questions\")\n  1689→            sections.append(\"\")\n  1690→            for g in gaps[:2]:\n  1691→                sections.append(f\"- {g.get('summary') or g.get('content', '')[:80]}\")\n  1692→            sections.append(\"\")\n  1693→\n  1694→        # Footer\n  1695→        sections.append(\"---\")\n  1696→        sections.append(f\"*Based on {len(result.get('sources', []))} sources. See full report for details.*\")\n  1697→\n  1698→        return \"\\n\".join(sections)\n  1699→\n  1700→    def _calculate_avg_confidence(self, findings: List[Dict[str, Any]]) -> float:\n  1701→        \"\"\"Calculate average confidence across findings.\"\"\"\n  1702→        if not findings:\n  1703→            return 0.0\n  1704→        total = sum(f.get(\"confidence_score\", 0.5) for f in findings)\n  1705→        return total / len(findings)\n  1706→\n  1707→    # ========== TEMPLATE HOOKS FOR CUSTOMIZATION ==========\n  1708→\n  1709→    def _generate_report_header(self, result: Dict[str, Any]) -> str:\n  1710→        \"\"\"Generate template-specific header content.\n  1711→\n  1712→        Override in subclasses to add domain-specific header sections.\n  1713→        \"\"\"\n  1714→        return \"\"\n  1715→\n  1716→    def _get_priority_findings(self, findings: List[Dict[str, Any]]) -> List[Dict[str, Any]]:\n  1717→        \"\"\"Get priority-sorted findings for summary sections.\n  1718→\n  1719→        Override in subclasses to customize finding priority for domain.\n  1720→        Default: high confidence findings sorted by confidence.\n  1721→        \"\"\"\n  1722→        high_conf = sorted(\n  1723→            [f for f in findings if f.get(\"confidence_score\", 0) >= 0.6],\n  1724→            key=lambda x: x.get(\"confidence_score\", 0),\n  1725→            reverse=True\n  1726→        )\n  1727→        return high_conf\n  1728→\n  1729→    def _group_findings(self, findings: List[Dict[str, Any]]) -> Dict[str, List[Dict[str, Any]]]:\n  1730→        \"\"\"Group findings by type for detailed sections.\n  1731→\n  1732→        Override in subclasses to customize grouping for domain.\n  1733→        \"\"\"\n  1734→        grouped: Dict[str, List[Dict[str, Any]]] = {}\n  1735→        for f in findings:\n  1736→            ftype = f.get(\"finding_type\", \"other\")\n  1737→            if ftype not in grouped:\n  1738→                grouped[ftype] = []\n  1739→            grouped[ftype].append(f)\n  1740→        return grouped\n  1741→\n  1742→    def _generate_key_sections(self, result: Dict[str, Any]) -> str:\n  1743→        \"\"\"Generate template-specific key sections.\n  1744→\n  1745→        Override in subclasses for domain-specific sections like:\n  1746→        - Financial: Bull/Bear case, Valuation summary\n  1747→        - Investigative: Risk assessment, Actor map\n  1748→        - Contract: Red flags summary, Pricing analysis\n  1749→        \"\"\"\n  1750→        return \"\"\n  1751→\n  1752→    def _generate_additional_sections(self, result: Dict[str, Any]) -> str:\n  1753→        \"\"\"Generate additional template-specific sections.\n  1754→\n  1755→        Override in subclasses for sections that come after perspectives.\n  1756→        \"\"\"\n  1757→        return \"\"\n  1758→\n  1759→    def _generate_executive_highlights(self, result: Dict[str, Any]) -> str:\n  1760→        \"\"\"Generate template-specific executive summary highlights.\n  1761→\n  1762→        Override in subclasses for domain-specific executive highlights.\n  1763→        \"\"\"\n  1764→        return \"\"\n  1765→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"05d3e4f1-2259-4f3e-a055-8040a34c8b02","uuid":"52a9af04-4b1b-4b9a-9fc7-16668922350e","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\actor\\src\\templates\\base.py","content":"\"\"\"Base research template.\"\"\"\n\nfrom abc import ABC, abstractmethod\nfrom typing import List, Dict, Any, Optional\n\nfrom ..clients.gemini import GeminiClient\n\n\nclass BaseTemplate(ABC):\n    \"\"\"Abstract base class for research templates.\"\"\"\n\n    template_id: str = \"base\"\n    template_name: str = \"Base Research\"\n    description: str = \"Base research template\"\n\n    # Default perspectives for multi-perspective analysis\n    default_perspectives: List[str] = [\"historical\", \"economic\", \"political\"]\n\n    # Resource limits\n    default_max_searches: int = 5\n    default_max_sources_per_search: int = 10\n\n    # Verification configuration - override in subclasses\n    # Levels: \"none\", \"light\", \"standard\", \"thorough\"\n    verification_config: Dict[str, str] = {\n        \"cross_reference\": \"standard\",\n        \"bias_detection\": \"standard\",\n        \"expert_sanity_check\": \"standard\",\n        \"source_quality\": \"standard\",\n    }\n\n    def __init__(self):\n        self.gemini_client: Optional[GeminiClient] = None\n\n    def set_client(self, client: GeminiClient) -> None:\n        \"\"\"Set the Gemini client for API calls.\"\"\"\n        self.gemini_client = client\n\n    @abstractmethod\n    async def generate_search_queries(\n        self,\n        query: str,\n        max_searches: int,\n        granularity: str = \"standard\",\n    ) -> List[str]:\n        \"\"\"Generate search queries for the research question.\"\"\"\n        pass\n\n    @abstractmethod\n    async def extract_findings(\n        self,\n        query: str,\n        sources: List[Dict[str, Any]],\n        synthesized_content: str,\n        granularity: str = \"standard\",\n    ) -> List[Dict[str, Any]]:\n        \"\"\"Extract structured findings from research content.\"\"\"\n        pass\n\n    # Expert perspective prompts for deep analysis\n    PERSPECTIVE_PROMPTS: Dict[str, str] = {\n        # ===== INVESTIGATIVE PERSPECTIVES =====\n        \"forensic_financial\": \"\"\"You are a FORENSIC ACCOUNTANT and FINANCIAL INVESTIGATOR with 20+ years experience uncovering fraud, embezzlement, and financial crimes. You've worked with the FBI, SEC, and major law firms on white-collar crime cases.\n\nYour analytical approach:\n- Follow the money: Trace every transaction, payment, and financial flow\n- Look for shell companies, layered transactions, unusual timing of payments\n- Identify discrepancies between public statements and financial reality\n- Spot patterns consistent with money laundering, bribery, or tax evasion\n- Examine related-party transactions and conflicts of interest\n- Question large round-number transactions and those just under reporting thresholds\n\nProvide your forensic financial analysis covering:\n1. FINANCIAL RED FLAGS: Suspicious patterns in any financial transactions mentioned\n2. TRANSACTION ANALYSIS: What do the money flows tell us about relationships and intent?\n3. HIDDEN CONNECTIONS: Financial links that reveal undisclosed relationships\n4. INVESTIGATIVE LEADS: What financial records should be subpoenaed or examined?\n5. CRIMINAL LIABILITY INDICATORS: Patterns suggesting potential fraud or illegality\"\"\",\n\n        \"power_network\": \"\"\"You are a POLITICAL SCIENTIST and POWER DYNAMICS EXPERT specializing in network analysis of influence, corruption, and institutional capture. You've advised governments and NGOs on understanding shadowy power structures.\n\nYour analytical approach:\n- Map formal and informal power networks (who influences whom)\n- Identify gatekeepers, brokers, and nodes of concentrated power\n- Recognize patterns of regulatory capture and revolving door dynamics\n- Trace how decisions actually get made (vs. how they officially get made)\n- Spot quid pro quo relationships and mutual protection arrangements\n- Analyze how power is maintained, transferred, or challenged\n\nProvide your power network analysis covering:\n1. POWER MAP: Key actors and their actual (not just formal) power relationships\n2. INFLUENCE MECHANISMS: How is influence being exercised? (lobbying, donations, relationships)\n3. HIDDEN INTERESTS: Whose interests are really being served vs. stated beneficiaries\n4. INSTITUTIONAL VULNERABILITIES: How are institutions being co-opted or weakened\n5. ACCOUNTABILITY GAPS: Where are checks and balances failing?\"\"\",\n\n        \"psychological_behavioral\": \"\"\"You are a BEHAVIORAL PSYCHOLOGIST and PROFILER who analyzes decision-making, motivations, and behavioral patterns. You've worked with intelligence agencies and major corporations on understanding human behavior.\n\nYour analytical approach:\n- Analyze stated motivations vs. revealed preferences (what people do vs. say)\n- Identify cognitive biases and emotional drivers influencing decisions\n- Look for patterns of deception, rationalization, or self-serving behavior\n- Assess credibility based on consistency, specificity, and corroboration\n- Understand group dynamics, peer pressure, and institutional cultures\n- Predict future behavior based on past patterns\n\nProvide your behavioral analysis covering:\n1. MOTIVATION ANALYSIS: What are the true underlying motivations vs. stated ones?\n2. BEHAVIORAL PATTERNS: What recurring behaviors reveal about character and intent?\n3. CREDIBILITY ASSESSMENT: Who is credible and who is likely being deceptive? Why?\n4. PREDICTION: Based on behavioral patterns, what actions are likely next?\n5. PSYCHOLOGICAL VULNERABILITIES: What pressures or incentives could change behavior?\"\"\",\n\n        \"geopolitical_strategic\": \"\"\"You are a GEOPOLITICAL STRATEGIST and former intelligence analyst who has briefed heads of state. You understand how nations, corporations, and powerful actors pursue their strategic interests.\n\nYour analytical approach:\n- Analyze through the lens of national interests, not stated positions\n- Identify strategic assets, chokepoints, and leverage\n- Understand proxy relationships and indirect influence operations\n- Recognize information warfare and narrative manipulation\n- Map alliances, dependencies, and potential conflicts\n- Assess long-term strategic implications vs. short-term appearances\n\nProvide your geopolitical analysis covering:\n1. STRATEGIC INTERESTS: What national/organizational interests are really at play?\n2. LEVERAGE ANALYSIS: Who has leverage over whom and how might they use it?\n3. INFORMATION OPERATIONS: What narratives are being pushed and by whom?\n4. ALLIANCE DYNAMICS: How do relationships and alliances affect the situation?\n5. STRATEGIC IMPLICATIONS: What are the long-term geopolitical consequences?\"\"\",\n\n        \"legal_liability\": \"\"\"You are a LITIGATION ATTORNEY and LEGAL RISK ANALYST who has handled major cases involving corporate misconduct, fraud, and regulatory violations. You've won cases against Fortune 500 companies.\n\nYour analytical approach:\n- Identify potential civil and criminal liability for each actor\n- Assess strength of evidence and admissibility\n- Consider statute of limitations and jurisdictional issues\n- Analyze regulatory exposure (SEC, DOJ, FTC, state AGs)\n- Evaluate potential class action or qui tam exposure\n- Consider reputational and consequential damages\n\nProvide your legal analysis covering:\n1. LIABILITY EXPOSURE: Who faces potential civil/criminal liability and for what?\n2. EVIDENCE STRENGTH: How strong is the evidence for each potential claim?\n3. REGULATORY RISK: Which regulators might take action and on what grounds?\n4. LEGAL VULNERABILITIES: Where are actors most exposed to legal consequences?\n5. LITIGATION PREDICTION: What lawsuits or enforcement actions are likely?\"\"\",\n\n        # ===== FINANCIAL/INVESTMENT PERSPECTIVES =====\n        \"institutional_investor\": \"\"\"You are a SENIOR PORTFOLIO MANAGER at a top-tier institutional fund managing $50B+ AUM. You've generated alpha through deep fundamental research and contrarian thinking.\n\nYour analytical approach:\n- Focus on long-term value creation, not short-term noise\n- Analyze management quality, capital allocation, and incentive alignment\n- Assess competitive moats and their durability\n- Evaluate returns on invested capital and reinvestment opportunities\n- Consider position sizing based on conviction and risk/reward\n- Think in terms of enterprise value and owner earnings\n\nProvide your institutional investor analysis covering:\n1. INVESTMENT THESIS: What is the core long-term investment thesis?\n2. MANAGEMENT ASSESSMENT: How capable and aligned is the management team?\n3. MOAT ANALYSIS: How durable are competitive advantages? What could erode them?\n4. CAPITAL ALLOCATION: How well does management deploy capital?\n5. POSITION RECOMMENDATION: Size, entry strategy, and catalyst timeline\"\"\",\n\n        \"short_seller\": \"\"\"You are a PROFESSIONAL SHORT SELLER and forensic researcher known for uncovering frauds before they become public. You've published research that exposed major frauds and made substantial returns.\n\nYour analytical approach:\n- Extreme skepticism of management claims and projections\n- Deep forensic accounting analysis of financial statements\n- Analysis of insider selling, dilution, and related-party transactions\n- Investigation of customer/supplier verification and channel checks\n- Red flag analysis: revenue recognition, reserves, non-GAAP adjustments\n- Assessment of promotional activity and narrative vs. fundamentals\n\nProvide your skeptical analysis covering:\n1. RED FLAGS: What accounting or business red flags are present?\n2. VERIFICATION GAPS: What claims cannot be independently verified?\n3. INSIDER BEHAVIOR: What does insider trading and compensation tell us?\n4. SUSTAINABILITY QUESTIONS: What about the business model is unsustainable?\n5. FRAUD PROBABILITY: How likely is significant fraud or value destruction?\n\nMANDATORY BEAR CASE (You MUST provide this structured analysis):\n6. BEAR CASE SCENARIO: Provide a specific, detailed bear case including:\n   - What the bulls are missing or underweighting\n   - The specific trigger events that would cause the thesis to fail\n   - Probability estimate (X%) for this bear scenario materializing\n   - Expected downside magnitude (stock drops X%, revenue declines X%)\n   - Timeline: When would warning signs appear?\n   - KILL TRIGGERS: Specific observable events that signal the bear case is playing out\n     (e.g., \"Exit if customer concentration exceeds 40%\", \"Reverse if gross margins fall below 60%\")\n\nFormat your bear case as:\nBEAR CASE ([X]% probability): [One sentence summary of the scenario]\n- Trigger: [What starts the decline]\n- Magnitude: [Expected impact on stock/revenue/margins]\n- Timeline: [When this plays out]\n- Kill Signals: [3-5 specific, measurable warning signs to watch]\"\"\",\n\n        \"quantitative_risk\": \"\"\"You are a QUANTITATIVE RISK ANALYST and former derivatives trader who builds risk models. You understand tail risks, correlations, and how risks cascade through systems.\n\nYour analytical approach:\n- Model probability distributions, not just expected values\n- Identify hidden correlations and concentration risks\n- Stress test against historical analogues and fat-tail events\n- Assess liquidity risk and forced selling scenarios\n- Evaluate counterparty and contagion risks\n- Calculate position-specific and portfolio-level VaR\n\nProvide your risk analysis covering:\n1. RISK FACTORS: Enumerate all material risk factors and their probability\n2. TAIL RISKS: What are the low-probability high-impact scenarios?\n3. CORRELATION RISKS: How might risks compound or cascade?\n4. STRESS SCENARIOS: How would position perform in 2008/2020-type events?\n5. RISK MITIGATION: Hedging strategies and risk reduction opportunities\"\"\",\n\n        \"activist_investor\": \"\"\"You are an ACTIVIST INVESTOR who has run successful campaigns to unlock value at underperforming companies. You understand corporate governance, proxy fights, and value creation levers.\n\nYour analytical approach:\n- Identify operational inefficiencies and margin improvement opportunities\n- Assess capital structure optimization (leverage, buybacks, dividends)\n- Evaluate portfolio rationalization and divestiture opportunities\n- Analyze governance weaknesses and board composition\n- Identify catalysts that could unlock hidden value\n- Consider strategic alternatives including M&A\n\nProvide your activist analysis covering:\n1. VALUE CREATION LEVERS: What changes could unlock significant value?\n2. OPERATIONAL IMPROVEMENTS: Where are margins below potential and why?\n3. CAPITAL ALLOCATION CRITIQUE: How should capital strategy change?\n4. GOVERNANCE ISSUES: What governance changes would improve outcomes?\n5. ACTIVISM PLAYBOOK: What would a campaign look like and likely outcomes?\"\"\",\n\n        \"macro_strategist\": \"\"\"You are a GLOBAL MACRO STRATEGIST who manages money based on economic cycles, policy changes, and global capital flows. You've successfully navigated multiple economic crises.\n\nYour analytical approach:\n- Analyze position within economic and credit cycles\n- Assess sensitivity to interest rates, inflation, and currency moves\n- Evaluate policy risks (monetary, fiscal, regulatory)\n- Consider global supply chain and trade dependencies\n- Model scenarios based on different macro environments\n- Identify secular trends vs. cyclical dynamics\n\nProvide your macro analysis covering:\n1. CYCLE POSITIONING: Where are we in economic/credit cycles and implications?\n2. MACRO SENSITIVITIES: Key macro variables affecting the investment\n3. POLICY RISKS: How might policy changes (rates, regulation, tax) impact?\n4. GLOBAL CONTEXT: International factors and dependencies\n5. SCENARIO ANALYSIS: Performance across different macro scenarios\"\"\",\n\n        # ===== COMPETITIVE ANALYSIS PERSPECTIVES =====\n        \"strategy_consultant\": \"\"\"You are a MCKINSEY/BCG-level STRATEGY CONSULTANT who has advised Fortune 100 CEOs on competitive strategy. You use rigorous frameworks and data to assess competitive dynamics.\n\nYour analytical approach:\n- Apply Porter's Five Forces systematically\n- Analyze value chain positioning and make-vs-buy decisions\n- Assess competitive advantages and their sustainability\n- Evaluate strategic options using decision trees and scenario planning\n- Consider game theory dynamics between competitors\n- Focus on execution capabilities, not just strategic intent\n\nProvide your strategic analysis covering:\n1. COMPETITIVE POSITIONING: Where does each player sit and why?\n2. STRATEGIC OPTIONS: What are the viable strategic paths forward?\n3. CAPABILITY ASSESSMENT: What capabilities determine winners vs. losers?\n4. DISRUPTIVE THREATS: What could fundamentally change the competitive landscape?\n5. STRATEGIC RECOMMENDATIONS: Recommended actions with rationale\"\"\",\n\n        \"industry_insider\": \"\"\"You are a 20-YEAR INDUSTRY VETERAN who has worked at multiple companies in this space. You understand the operational realities that outsiders miss.\n\nYour analytical approach:\n- Focus on what actually matters operationally, not analyst narratives\n- Understand customer decision-making and switching costs\n- Know where value is really created vs. captured\n- Recognize talent dynamics and cultural factors\n- Understand regulatory relationships and political dynamics\n- Identify operational metrics that predict success\n\nProvide your insider analysis covering:\n1. OPERATIONAL REALITY: What do outsiders misunderstand about this industry?\n2. CUSTOMER DYNAMICS: How do customers really make decisions?\n3. TALENT AND CULTURE: What cultural/talent factors drive success?\n4. HIDDEN METRICS: What operational metrics should be tracked?\n5. INDUSTRY PREDICTIONS: Where is the industry really headed?\"\"\",\n\n        # ===== LEGAL RESEARCH PERSPECTIVES =====\n        \"regulatory_expert\": \"\"\"You are a FORMER SENIOR REGULATOR who has shaped and enforced major regulations. You understand how regulators think, prioritize, and act.\n\nYour analytical approach:\n- Understand regulatory priorities and enforcement trends\n- Assess compliance gaps and their materiality\n- Evaluate regulatory relationships and history\n- Predict enforcement likelihood based on precedent\n- Consider political factors affecting regulatory action\n- Analyze remediation options and their effectiveness\n\nProvide your regulatory analysis covering:\n1. COMPLIANCE ASSESSMENT: Where are compliance gaps and how material are they?\n2. ENFORCEMENT RISK: How likely is enforcement action and what would trigger it?\n3. REGULATORY RELATIONSHIPS: What is the history with regulators?\n4. POLITICAL FACTORS: How do politics affect regulatory outcomes?\n5. REMEDIATION PATH: What steps would reduce regulatory risk?\"\"\",\n\n        \"litigation_strategist\": \"\"\"You are a TOP LITIGATOR who has tried high-stakes cases. You understand how cases develop, what makes arguments persuasive, and how litigation actually works.\n\nYour analytical approach:\n- Assess factual and legal strength of each claim\n- Identify discovery that would strengthen or weaken positions\n- Evaluate judge and jury dynamics\n- Consider settlement dynamics and negotiation leverage\n- Assess reputational and precedential impacts\n- Analyze litigation as strategic tool, not just legal process\n\nProvide your litigation analysis covering:\n1. CASE STRENGTH: How strong are the claims/defenses on the merits?\n2. DISCOVERY ANALYSIS: What discovery would be most impactful?\n3. LITIGATION STRATEGY: What strategic approach would you recommend?\n4. SETTLEMENT ANALYSIS: What are realistic settlement ranges and dynamics?\n5. OUTCOME PREDICTION: Most likely outcomes and their probabilities\"\"\",\n\n        # ===== TECH MARKET PERSPECTIVES (VC & STARTUP) =====\n        \"venture_capitalist\": \"\"\"You are a PARTNER at a top-tier venture capital firm (Sequoia/a16z/Benchmark level) specializing in developer tools, infrastructure, and enterprise software. You have deployed $500M+ and seen 3 unicorn exits in the dev tools space.\n\nYour analytical approach:\n- Assess total addressable market (TAM) and market timing\n- Evaluate product-market fit signals and developer adoption curves\n- Analyze competitive moats: network effects, switching costs, data advantages\n- Identify expansion opportunities (land-and-expand, platform plays)\n- Evaluate founding team and technical execution capability\n- Consider exit potential: IPO readiness, strategic acquirer universe\n\nProvide your VC analysis covering:\n1. MARKET OPPORTUNITY: TAM sizing, growth drivers, and timing analysis\n2. COMPETITIVE DYNAMICS: Who wins and why? What creates defensibility?\n3. ADOPTION SIGNALS: Developer sentiment, GitHub stars, community momentum\n4. BUSINESS MODEL: Monetization strategy, unit economics, expansion revenue\n5. INVESTMENT THESIS: Why invest now? What are the key milestones to watch?\n6. RISKS: Technical, market, and competitive risks to monitor\"\"\",\n\n        \"startup_founder\": \"\"\"You are a SERIAL FOUNDER who has built and exited two developer tools companies. You understand the developer market intimately - both what developers say they want and what they actually adopt.\n\nYour analytical approach:\n- Focus on developer experience (DX) and reducing friction\n- Understand open-source dynamics and community building\n- Know how to navigate from individual developers to enterprise sales\n- Recognize the importance of documentation, tutorials, and onboarding\n- Evaluate technical architecture decisions for scalability\n- Understand developer marketing and word-of-mouth growth\n\nProvide your founder analysis covering:\n1. DX ANALYSIS: What makes developers love or hate these tools?\n2. GO-TO-MARKET: How would you acquire your first 1000 developers?\n3. COMMUNITY STRATEGY: Open source vs proprietary, community building approach\n4. ENTERPRISE READINESS: What's needed to sell to enterprises?\n5. COMPETITIVE POSITIONING: How would you differentiate and win?\n6. EXECUTION RISKS: What could go wrong in building this?\"\"\",\n\n        \"product_manager\": \"\"\"You are a SENIOR PRODUCT MANAGER at a leading developer platform (GitHub, GitLab, Atlassian level). You've shipped products used by millions of developers and understand the nuances of developer-focused product development.\n\nYour analytical approach:\n- Define clear user personas and jobs-to-be-done\n- Prioritize features based on developer impact vs. effort\n- Understand developer workflows and pain points deeply\n- Balance developer wants with enterprise buyer needs\n- Use data-driven decision making with qualitative developer feedback\n- Think in terms of platforms and ecosystems, not just point solutions\n\nProvide your product analysis covering:\n1. USER NEEDS: What pain points are being addressed? How severe are they?\n2. FEATURE PRIORITIES: What features matter most? What's table stakes vs. differentiating?\n3. USER EXPERIENCE: How intuitive is the experience? Where is friction?\n4. PLATFORM POTENTIAL: Is this a point solution or platform opportunity?\n5. ROADMAP OPPORTUNITIES: What features would you prioritize for 2026?\n6. METRICS: What KPIs would you track for success?\"\"\",\n\n        \"developer_advocate\": \"\"\"You are a SENIOR DEVELOPER ADVOCATE at a major tech company who has built communities around developer tools. You speak at conferences, create content, and deeply understand what makes developers excited about technology.\n\nYour analytical approach:\n- Evaluate technologies from a developer experience perspective\n- Understand what creates buzz vs. what has lasting value\n- Know how to explain complex technologies accessibly\n- Recognize community dynamics and influencer networks\n- Assess documentation quality, learning curves, and onboarding\n- Understand developer content (blogs, videos, tutorials) effectiveness\n\nProvide your developer advocate analysis covering:\n1. DEVELOPER APPEAL: What makes this exciting or boring to developers?\n2. LEARNING CURVE: How easy is adoption? What are the barriers?\n3. DOCUMENTATION: How good is the documentation and learning resources?\n4. COMMUNITY HEALTH: Is there a vibrant community? What's the engagement like?\n5. CONTENT STRATEGY: What content would resonate with developers?\n6. HYPE VS REALITY: Is the excitement justified or overblown?\"\"\",\n\n        # ===== TECH MARKET PERSPECTIVES (DEVELOPER COMMUNITY) =====\n        \"open_source_maintainer\": \"\"\"You are a PRINCIPAL OPEN SOURCE MAINTAINER who has led projects with 50,000+ GitHub stars. You understand sustainable open source, governance, and building communities that last decades.\n\nYour analytical approach:\n- Evaluate project health: contributors, commit frequency, issue responsiveness\n- Assess governance models and long-term sustainability\n- Understand licensing implications and corporate backing dynamics\n- Recognize contributor experience and onboarding\n- Analyze fork risks and community fragmentation\n- Evaluate code quality, testing, and release practices\n\nProvide your maintainer analysis covering:\n1. PROJECT HEALTH: Contributor diversity, bus factor, governance quality\n2. SUSTAINABILITY: Funding model, corporate backing, burnout risks\n3. COMMUNITY: How welcoming is the community? How are decisions made?\n4. CODE QUALITY: Architecture, testing, documentation standards\n5. ECOSYSTEM FIT: How does this fit with other tools developers use?\n6. LONG-TERM VIABILITY: Will this project exist in 5 years? 10 years?\"\"\",\n\n        \"devrel_engineer\": \"\"\"You are a DEVREL ENGINEER who bridges the gap between product teams and the developer community. You build SDKs, write documentation, create sample apps, and gather developer feedback to influence product direction.\n\nYour analytical approach:\n- Evaluate API design and SDK quality\n- Assess time-to-first-success for new developers\n- Understand integration patterns with existing tools\n- Recognize documentation completeness and accuracy\n- Analyze developer support channels and responsiveness\n- Evaluate sample code and quickstart quality\n\nProvide your devrel analysis covering:\n1. API/SDK QUALITY: How well-designed is the developer interface?\n2. ONBOARDING EXPERIENCE: How quickly can developers get value?\n3. INTEGRATION: How well does this fit existing developer workflows?\n4. SUPPORT: How are developer questions and issues handled?\n5. FEEDBACK LOOP: How does developer feedback reach product teams?\n6. COMPETITIVE COMPARISON: How does the DX compare to alternatives?\"\"\",\n\n        \"senior_engineer\": \"\"\"You are a STAFF/PRINCIPAL ENGINEER at a FAANG company who has built systems handling millions of requests per second. You evaluate technologies based on production readiness, scalability, and long-term maintainability.\n\nYour analytical approach:\n- Assess architectural soundness and scalability characteristics\n- Evaluate operational complexity and maintenance burden\n- Consider performance characteristics and resource efficiency\n- Analyze security posture and compliance readiness\n- Review testing, monitoring, and debugging capabilities\n- Evaluate team skill requirements and learning investment\n\nProvide your senior engineer analysis covering:\n1. ARCHITECTURE: How sound is the technical architecture?\n2. SCALABILITY: Can this handle production scale? What are the limits?\n3. OPERATIONS: What's the operational burden? On-call implications?\n4. SECURITY: What security considerations are there?\n5. TEAM FIT: What skills does the team need? What's the ramp-up time?\n6. TECHNICAL DEBT: What are the long-term maintenance implications?\"\"\",\n\n        \"platform_engineer\": \"\"\"You are a PLATFORM ENGINEER who builds internal developer platforms (IDPs) and enables other developers to ship faster. You think about golden paths, self-service, and reducing cognitive load for application developers.\n\nYour analytical approach:\n- Evaluate fit within a broader platform architecture\n- Assess self-service capabilities and automation potential\n- Consider standardization and golden path implications\n- Analyze observability, debugging, and troubleshooting\n- Evaluate security, compliance, and governance integration\n- Consider multi-tenancy and isolation requirements\n\nProvide your platform engineer analysis covering:\n1. PLATFORM FIT: How does this fit in a modern IDP architecture?\n2. SELF-SERVICE: Can developers use this without platform team involvement?\n3. STANDARDIZATION: Does this enable or complicate standardization?\n4. OBSERVABILITY: What insights do operators get? What's missing?\n5. SECURITY/COMPLIANCE: How does this integrate with security controls?\n6. MIGRATION PATH: How would you roll this out to existing systems?\"\"\",\n\n        # ===== CONTRACT ANALYSIS PERSPECTIVES =====\n        \"contract_auditor\": \"\"\"You are a SENIOR GOVERNMENT CONTRACT AUDITOR with 25+ years experience at the GAO and major accounting firms. You've audited billions in federal and state contracts and uncovered numerous cases of overpricing, waste, and fraud.\n\nYour analytical approach:\n- Analyze pricing against industry benchmarks and historical contracts\n- Identify cost padding, inflated rates, and unnecessary line items\n- Check for scope creep, change order abuse, and contract modifications\n- Flag sole-source justifications that seem manufactured or weak\n- Evaluate labor rates, materials costs, and overhead percentages\n- Look for round-number pricing that suggests estimates rather than actual costs\n\nProvide your contract audit analysis covering:\n1. PRICING ANALYSIS: Are the contract rates reasonable compared to market? What's the potential overpricing?\n2. COST BREAKDOWN: Whi
[2026-01-29T23:29:03.589Z] [STDOUT] ch line items seem inflated or unjustified?\n3. CHANGE ORDER PATTERNS: Are modifications following expected patterns or suggesting abuse?\n4. SOLE SOURCE CONCERNS: If sole-source, is the justification legitimate?\n5. BENCHMARKING: How does this compare to similar contracts in the sector?\n6. RED FLAGS: Specific audit concerns that warrant deeper investigation\"\"\",\n\n        \"procurement_investigator\": \"\"\"You are a PROCUREMENT FRAUD INVESTIGATOR who has worked with the FBI, OIG, and state attorneys general on major corruption cases. You specialize in bid rigging, kickbacks, and procurement manipulation schemes.\n\nYour analytical approach:\n- Analyze bid process for irregularities and manipulation\n- Identify connected entities, shell companies, and straw bidders\n- Check for rotation schemes, market allocation, and collusive patterns\n- Flag unusually narrow specifications designed for one vendor\n- Look for relationships between contractors and government officials\n- Examine timing patterns in bids and awards\n\nProvide your investigative analysis covering:\n1. BID PROCESS INTEGRITY: Were there irregularities in how bids were solicited or evaluated?\n2. CONNECTED ENTITIES: Are there hidden relationships between bidders or with officials?\n3. COLLUSION INDICATORS: Signs of bid rigging, rotation schemes, or market allocation?\n4. SPECIFICATION MANIPULATION: Were specs written to favor a particular vendor?\n5. CONFLICT OF INTEREST: Any relationships between decision-makers and contractors?\n6. INVESTIGATIVE LEADS: What should investigators examine further?\"\"\",\n\n        \"forensic_accountant\": \"\"\"You are a FORENSIC ACCOUNTANT specializing in government fraud, embezzlement, and white-collar crime. You've testified as an expert witness in major corruption trials and recovered hundreds of millions in fraudulent payments.\n\nYour analytical approach:\n- Trace money flows and payment patterns for anomalies\n- Identify related-party transactions and layered payments\n- Check vendor ownership, beneficial owners, and corporate structures\n- Flag unusual payment terms, prepayments, or milestone gaming\n- Look for round-number invoices and timing patterns\n- Analyze subcontractor relationships and pass-through arrangements\n\nProvide your forensic analysis covering:\n1. PAYMENT PATTERNS: Are there unusual timing, amounts, or frequency patterns?\n2. BENEFICIAL OWNERSHIP: Who ultimately controls the contracting entities?\n3. RELATED PARTIES: Are there undisclosed relationships between parties?\n4. INVOICE ANALYSIS: Do invoices show signs of manipulation or fabrication?\n5. SUBCONTRACTOR FLOW: Is money flowing to suspicious subcontractors?\n6. FRAUD INDICATORS: Specific patterns consistent with known fraud schemes\"\"\",\n\n        \"regulatory_compliance\": \"\"\"You are a GOVERNMENT CONTRACTING COMPLIANCE EXPERT who has worked at the SBA, GSA, and as compliance counsel for major contractors. You know FAR regulations, state procurement rules, and compliance requirements inside and out.\n\nYour analytical approach:\n- Check adherence to FAR, DFARS, and applicable state regulations\n- Identify missing required documentation and certifications\n- Verify small business set-aside compliance and certification validity\n- Assess False Claims Act exposure and compliance program adequacy\n- Review required disclosures, representations, and certifications\n- Evaluate DBE/MBE/WBE compliance if applicable\n\nProvide your compliance analysis covering:\n1. REGULATORY COMPLIANCE: What procurement regulations may have been violated?\n2. DOCUMENTATION GAPS: What required documentation is missing or inadequate?\n3. CERTIFICATION ISSUES: Are contractor certifications valid and accurate?\n4. SET-ASIDE COMPLIANCE: If applicable, is the set-aside requirement being met legitimately?\n5. FALSE CLAIMS EXPOSURE: What False Claims Act liability might exist?\n6. REMEDIATION NEEDS: What compliance issues need to be addressed?\"\"\",\n\n        \"industry_benchmarker\": \"\"\"You are an INDUSTRY ANALYST specializing in government IT and construction contract pricing. You maintain extensive databases of contract rates, labor costs, and materials pricing across government sectors.\n\nYour analytical approach:\n- Compare contract rates to GSA schedules and market rates\n- Analyze labor categories and rates against BLS and industry data\n- Evaluate materials costs against manufacturer pricing and market indices\n- Assess overhead and profit margins against industry norms\n- Consider geographic factors and complexity adjustments\n- Benchmark against similar contracts in the same agency and sector\n\nProvide your benchmarking analysis covering:\n1. RATE COMPARISON: How do labor rates compare to GSA schedules and market?\n2. MATERIALS PRICING: Are materials costs in line with market prices?\n3. OVERHEAD ANALYSIS: Are overhead rates reasonable for this type of work?\n4. PROFIT MARGINS: Is the profit margin within acceptable ranges?\n5. COMPARABLE CONTRACTS: How does this compare to similar recent contracts?\n6. VALUE ASSESSMENT: Is the government getting fair value for this contract?\"\"\",\n\n        # ===== EVENT UNDERSTANDING PERSPECTIVES =====\n        \"media_analyst\": \"\"\"You are a SENIOR MEDIA ANALYST and former investigative journalist with 20+ years experience studying media ecosystems, propaganda, and narrative manipulation. You've worked at major news organizations and academic institutions studying media bias.\n\nYour analytical approach:\n- Track how narratives evolve across different media ecosystems (mainstream, alternative, state-backed, social)\n- Identify ownership structures and their influence on coverage\n- Analyze framing techniques, story selection, and omissions\n- Compare coverage across time to assess historical accuracy\n- Detect coordinated narrative campaigns and their sources\n- Evaluate source-citing practices and verification standards\n\nProvide your media analysis covering:\n1. NARRATIVE MAPPING: How have different media ecosystems framed this story? What are the key divergences?\n2. COVERAGE PATTERNS: What's being emphasized vs. omitted? What stories are not being told?\n3. HISTORICAL ACCURACY: How accurate were these sources on similar past events?\n4. OWNERSHIP/BIAS ANALYSIS: How do ownership structures and editorial policies affect coverage?\n5. COORDINATION DETECTION: Are there signs of coordinated narrative pushing? By whom?\n6. SOURCE QUALITY: Which sources are citing primary evidence vs. each other?\"\"\",\n\n        \"fact_checker\": \"\"\"You are a SENIOR FACT-CHECKER and verification specialist who has worked at leading fact-checking organizations. You specialize in debunking misinformation and verifying claims in complex, politicized topics.\n\nYour analytical approach:\n- Verify claims against primary sources and official records\n- Identify manipulation techniques: cherry-picking, out-of-context quotes, doctored media\n- Track the origin and spread of false claims\n- Distinguish between outright falsehoods, misleading framing, and unverified claims\n- Assess the burden of proof for extraordinary claims\n- Identify what CAN be verified vs. what remains unknowable\n\nProvide your fact-check analysis covering:\n1. VERIFIED FACTS: What claims are supported by primary evidence?\n2. DEBUNKED CLAIMS: What claims are demonstrably false? What's the evidence?\n3. UNVERIFIED CLAIMS: What claims cannot be verified either way? Why?\n4. MANIPULATION TECHNIQUES: What propaganda techniques are being used?\n5. ORIGIN TRACING: Where did key narratives originate? How did they spread?\n6. EVIDENTIARY GAPS: What evidence would be needed to verify key claims?\"\"\",\n\n        \"historian\": \"\"\"You are a HISTORIAN specializing in modern history, geopolitics, and media studies. You have deep knowledge of historical parallels, how events unfold over time, and the long-term consequences of major decisions.\n\nYour analytical approach:\n- Identify historical parallels and patterns across similar events\n- Understand how past events provide context for current ones\n- Recognize propaganda patterns that recur throughout history\n- Assess long-term consequences based on historical precedent\n- Distinguish genuinely novel situations from familiar patterns\n- Apply lessons from similar historical crises\n\nProvide your historical analysis covering:\n1. HISTORICAL PARALLELS: What past events are most similar? What can we learn from them?\n2. PATTERN RECOGNITION: What recurring patterns are present (political, military, economic)?\n3. HISTORICAL CONTEXT: What background is essential for understanding this event?\n4. PROPAGANDA PATTERNS: How do current narratives compare to historical propaganda patterns?\n5. LONG-TERM IMPLICATIONS: Based on history, what are likely long-term consequences?\n6. WHAT'S DIFFERENT: What makes this situation genuinely novel vs. repeating history?\"\"\",\n\n        \"intelligence_analyst\": \"\"\"You are a FORMER INTELLIGENCE ANALYST who has worked on information operations, psychological warfare, and strategic communications analysis. You understand how state and non-state actors manipulate information.\n\nYour analytical approach:\n- Identify information operations and their likely sponsors\n- Analyze propaganda techniques and psychological manipulation\n- Assess the strategic objectives behind narrative campaigns\n- Detect coordinated inauthentic behavior and bot networks\n- Evaluate cui bono (who benefits) from different narratives\n- Distinguish organic discourse from manufactured consensus\n\nProvide your intelligence analysis covering:\n1. INFORMATION OPERATIONS: Are there active influence campaigns? Who's behind them?\n2. STRATEGIC OBJECTIVES: What are the strategic goals behind different narratives?\n3. PROPAGANDA TECHNIQUES: What specific techniques are being employed?\n4. ACTOR ANALYSIS: Which actors benefit from different outcomes? What are their capabilities?\n5. DECEPTION INDICATORS: What signs suggest deliberate deception vs. organic error?\n6. ASSESSMENT CONFIDENCE: How confident can we be in our understanding? What are the key unknowns?\"\"\",\n\n        # ===== DUE DILIGENCE PERSPECTIVES =====\n        \"due_diligence_analyst\": \"\"\"You are a PROFESSIONAL DUE DILIGENCE ANALYST with 15+ years experience vetting companies for M&A transactions, partnerships, and investments. You've uncovered hidden liabilities and saved clients millions.\n\nYour analytical approach:\n- Verify all claimed credentials and registrations\n- Check for litigation history and regulatory actions\n- Analyze financial health indicators and stability\n- Research key personnel backgrounds and track records\n- Identify undisclosed relationships and conflicts of interest\n- Look for patterns that suggest misrepresentation\n\nProvide your due diligence analysis covering:\n1. VERIFICATION STATUS: What claims can be verified vs. unverified?\n2. RED FLAGS: What warning signs should concern a potential partner/customer?\n3. FINANCIAL INDICATORS: What does available financial information suggest?\n4. LEADERSHIP ASSESSMENT: What is known about key people and their track records?\n5. RISK SUMMARY: What are the key risks of engaging with this entity?\n6. RECOMMENDATION: Would you recommend proceeding? Under what conditions?\"\"\",\n\n        # ===== PURCHASE DECISION PERSPECTIVES =====\n        \"consumer_advocate\": \"\"\"You are a CONSUMER ADVOCATE and product researcher who has helped thousands of buyers avoid bad purchases. You work for a consumer protection organization and prioritize buyer interests.\n\nYour analytical approach:\n- Prioritize real user experiences over marketing claims\n- Identify common problems and failure patterns\n- Calculate true cost of ownership including hidden costs\n- Evaluate warranty, support, and return policies\n- Compare value against alternatives\n- Flag manipulative sales tactics or misleading claims\n\nProvide your consumer advocate analysis covering:\n1. BUYER BEWARE: What should buyers watch out for?\n2. REAL-WORLD ISSUES: What problems do actual owners report?\n3. TRUE COST: What's the real total cost including hidden expenses?\n4. ALTERNATIVES: What other options should buyers consider?\n5. VALUE ASSESSMENT: Is this a good value for the money?\n6. RECOMMENDATION: Should buyers proceed, wait, or look elsewhere?\"\"\",\n\n        \"technical_expert\": \"\"\"You are a TECHNICAL EXPERT and product specialist who evaluates products based on specifications, build quality, and performance. You write detailed technical reviews and understand what makes products succeed or fail.\n\nYour analytical approach:\n- Evaluate specifications and technical capabilities\n- Assess build quality and durability\n- Compare performance against competitors\n- Identify design flaws or limitations\n- Consider repairability and longevity\n- Evaluate technical support and updates\n\nProvide your technical analysis covering:\n1. TECHNICAL ASSESSMENT: How do the specs and capabilities measure up?\n2. BUILD QUALITY: What's the quality of materials and construction?\n3. PERFORMANCE: How does it perform in real-world use?\n4. LIMITATIONS: What are the technical limitations or design flaws?\n5. LONGEVITY: How long should this product last?\n6. TECHNICAL VERDICT: Is this technically sound?\"\"\",\n\n        \"value_analyst\": \"\"\"You are a VALUE ANALYST who specializes in cost-benefit analysis for consumer purchases. You help buyers understand whether they're getting good value and identify the sweet spots in product lineups.\n\nYour analytical approach:\n- Compare price to features and quality\n- Identify the best value options in each category\n- Calculate cost per use or cost over lifetime\n- Consider resale value and depreciation\n- Evaluate whether premium features justify premium prices\n- Identify when to buy (sales cycles, new model releases)\n\nProvide your value analysis covering:\n1. PRICE ANALYSIS: Is the price fair for what you get?\n2. VALUE COMPARISON: How does value compare to alternatives?\n3. COST OVER TIME: What's the total cost of ownership?\n4. SWEET SPOT: What's the best value option in this category?\n5. TIMING: When is the best time to buy?\n6. VALUE VERDICT: Is this good value for money?\"\"\",\n\n        \"long_term_owner\": \"\"\"You are a PRODUCT REVIEWER who specializes in long-term ownership experiences. You follow up with owners after 6 months, 1 year, and 2 years to understand how products hold up over time.\n\nYour analytical approach:\n- Focus on durability and reliability over time\n- Track how satisfaction changes after the honeymoon period\n- Identify issues that only emerge with extended use\n- Evaluate long-term support and parts availability\n- Consider how well products age with software updates\n- Assess whether owners would buy again\n\nProvide your long-term owner analysis covering:\n1. DURABILITY: How well does this hold up over time?\n2. SATISFACTION TRAJECTORY: How does satisfaction change over time?\n3. EMERGING ISSUES: What problems appear after extended use?\n4. SUPPORT QUALITY: How is long-term support and parts availability?\n5. AGING: How well does this age (software updates, obsolescence)?\n6. REPURCHASE: Would long-term owners buy this again?\"\"\",\n\n        # ===== REPUTATION CHECK PERSPECTIVES =====\n        \"consumer_protection\": \"\"\"You are a CONSUMER PROTECTION SPECIALIST who investigates scams, fraud, and deceptive business practices. You've helped expose numerous scam operations and protect consumers from bad actors.\n\nYour analytical approach:\n- Identify classic scam patterns and red flags\n- Verify business legitimacy through official records\n- Check for regulatory actions and consumer complaints\n- Analyze review authenticity (fake review detection)\n- Investigate ownership and corporate structure\n- Assess whether business practices are sustainable\n\nProvide your consumer protection analysis covering:\n1. SCAM INDICATORS: Are there signs this could be a scam?\n2. LEGITIMACY CHECK: Can the business legitimacy be verified?\n3. COMPLAINT ANALYSIS: What patterns emerge from complaints?\n4. REVIEW AUTHENTICITY: Do the reviews appear genuine?\n5. BUSINESS MODEL: Is the business model sustainable and legitimate?\n6. SAFETY VERDICT: Is it safe to engage with this entity?\"\"\",\n\n        \"reputation_analyst\": \"\"\"You are a REPUTATION ANALYST who tracks and analyzes the reputations of businesses and individuals. You understand how reputations are built, damaged, and recovered.\n\nYour analytical approach:\n- Track reputation across multiple platforms and sources\n- Identify patterns in feedback and reviews\n- Analyze how entities respond to criticism\n- Detect reputation management and astroturfing\n- Assess trajectory (improving or declining)\n- Compare reputation to industry peers\n\nProvide your reputation analysis covering:\n1. REPUTATION OVERVIEW: What is the overall reputation?\n2. PATTERN ANALYSIS: What patterns emerge from reviews and feedback?\n3. RESPONSE QUALITY: How does the entity respond to criticism?\n4. AUTHENTICITY: Are reviews and testimonials genuine?\n5. TRAJECTORY: Is reputation improving or declining?\n6. PEER COMPARISON: How does reputation compare to peers?\"\"\",\n    }\n\n    async def analyze_perspective(\n        self,\n        perspective_type: str,\n        findings: List[Dict[str, Any]],\n        sources: List[Dict[str, Any]],\n        original_query: str,\n    ) -> Dict[str, Any]:\n        \"\"\"Analyze findings from a specific expert perspective.\"\"\"\n        if not self.gemini_client:\n            raise ValueError(\"Gemini client not set\")\n\n        # Build detailed context\n        findings_text = \"\\n\".join([\n            f\"- [{f.get('finding_type', 'fact').upper()}] {f.get('summary', '')} | {f.get('content', '')[:300]}\"\n            for f in findings[:25]\n        ])\n\n        sources_text = \"\\n\".join([\n            f\"- {s.get('title', 'Unknown')} ({s.get('domain', '')})\"\n            for s in sources[:15]\n        ])\n\n        # Get specialized prompt or use default\n        expert_prompt = self.PERSPECTIVE_PROMPTS.get(perspective_type, f\"\"\"\nYou are an expert analyst providing deep {perspective_type} analysis.\nApply your specialized expertise to uncover insights that a generalist would miss.\nBe specific, actionable, and provide evidence-based conclusions.\n\"\"\")\n\n        prompt = f\"\"\"{expert_prompt}\n\n=== RESEARCH QUESTION ===\n{original_query}\n\n=== KEY FINDINGS FROM RESEARCH ===\n{findings_text}\n\n=== SOURCES CONSULTED ===\n{sources_text}\n\n=== YOUR ANALYSIS ===\nBased on your specialized expertise, provide:\n\n1. CORE ANALYSIS: Deep expert analysis from your perspective (3-4 detailed paragraphs)\n   - Explain the reasoning behind each major point\n   - Connect observations to broader patterns or trends\n   - Reference specific findings that support your analysis\n\n2. HIDDEN INSIGHTS: 5-7 insights that only someone with your expertise would notice\n   Each insight MUST include:\n   - The insight itself\n   - WHY this matters (the \"so what?\")\n   - EVIDENCE from the findings that supports this\n   Example: \"Customer concentration risk is higher than it appears because [evidence]. This matters because [implication].\"\n\n3. ACTIONABLE RECOMMENDATIONS: 3-5 specific, actionable recommendations\n   Each recommendation MUST explain:\n   - WHAT to do\n   - WHY this action is warranted (the reasoning)\n   - WHAT EVIDENCE supports this recommendation\n\n4. PREDICTIONS: 2-4 predictions about future developments, each with DETAILED rationale:\n   - prediction: What will likely happen (specific and measurable)\n   - rationale: DETAILED explanation (3-5 sentences) of WHY you predict this, including:\n     * The causal mechanism or logic chain\n     * Historical precedents or patterns that inform this\n     * Key assumptions underlying the prediction\n     * What would need to be true for this to occur\n   - confidence: high/medium/low with EXPLANATION of confidence level\n   - timeline: When this is expected (e.g., \"Q1 2025\", \"6-12 months\")\n   - supporting_evidence: Specific findings or data points that support this\n   - what_could_change_this: Factors that could invalidate the prediction\n\n5. CRITICAL WARNINGS: Important risks or red flags from your perspective\n   Each warning MUST include:\n   - The risk/warning\n   - WHY this is concerning (the mechanism of harm)\n   - What to watch for (leading indicators)\n\n6. KNOWLEDGE GAPS: What additional information would strengthen this analysis?\n   For each gap, explain WHY this information matters and HOW it would change conclusions.\n\n7. CONTRARIAN VIEW: What is the opposite view and why might it be right?\n   Provide genuine steel-man argument with supporting logic.\n\nCRITICAL: Every statement must have supporting reasoning. No unsupported assertions.\nBe specific and cite evidence from the findings. Avoid generic statements.\n\nReturn as JSON with keys:\n- analysis_text (string)\n- key_insights (array of strings - each insight should include reasoning)\n- recommendations (array of strings - each with reasoning)\n- predictions (array of objects with: prediction, rationale, confidence, timeline, supporting_evidence, what_could_change_this)\n- warnings (array of strings - each with reasoning)\n- knowledge_gaps (array of strings - each explaining why it matters)\n- contrarian_view (string - with supporting logic)\n- confidence (0.0-1.0)\n- bear_case (object, REQUIRED for short_seller perspective): {{\n    \"probability\": 0.25,\n    \"summary\": \"One sentence summary of bear scenario\",\n    \"trigger\": \"What event/condition would cause the negative outcome\",\n    \"magnitude\": \"Expected impact (e.g., 'stock drops 40%', 'revenue declines 30%')\",\n    \"timeline\": \"When this could materialize (e.g., 'H2 2025', '12-18 months')\",\n    \"kill_signals\": [\"Signal 1 to watch\", \"Signal 2 to watch\", \"Signal 3 to watch\"]\n  }}\n\"\"\"\n\n        result, _ = await self.gemini_client.generate_json(prompt, temperature=0.4)\n\n        # Ensure result is a dict (LLM might return a list or other type)\n        if not isinstance(result, dict):\n            result = {\n                \"analysis_text\": \"Analysis not available\",\n                \"key_insights\": [],\n                \"recommendations\": [],\n                \"predictions\": [],\n                \"warnings\": [],\n                \"knowledge_gaps\": [],\n                \"contrarian_view\": \"\",\n                \"confidence\": 0.3,\n                \"bear_case\": None,\n            }\n\n        # Ensure predictions field exists and is properly structured\n        if \"predictions\" not in result:\n            result[\"predictions\"] = []\n        # Convert old-style string predictions to structured format if needed\n        elif isinstance(result[\"predictions\"], list) and result[\"predictions\"]:\n            if isinstance(result[\"predictions\"][0], str):\n                result[\"predictions\"] = [\n                    {\n                        \"prediction\": p,\n                        \"rationale\": \"Based on research findings\",\n                        \"confidence\": \"medium\",\n                        \"timeline\": \"2025-2026\",\n                        \"supporting_sources\": []\n                    }\n                    for p in result[\"predictions\"]\n                ]\n\n        # Ensure bear_case is properly structured for short_seller perspective\n        if perspective_type == \"short_seller\":\n            if \"bear_case\" not in result or not isinstance(result.get(\"bear_case\"), dict):\n                # Try to extract bear case summary from analysis_text\n                analysis_text = result.get(\"analysis_text\", \"\")\n                contrarian_view = result.get(\"contrarian_view\", \"\")\n                warnings = result.get(\"warnings\", [])\n\n                # Build a meaningful summary from available data\n                summary = \"\"\n                if contrarian_view:\n                    summary = contrarian_view[:200]\n                elif warnings:\n                    summary = f\"Key risks: {'; '.join(warnings[:2])}\"\n                elif analysis_text:\n                    # Extract first substantive sentence\n                    sentences = analysis_text.split(\". \")\n                    summary = sentences[0][:200] if sentences else \"See analysis for bear case details\"\n\n                result[\"bear_case\"] = {\n                    \"probability\": 0.25,\n                    \"summary\": summary,\n                    \"trigger\": warnings[0] if warnings else \"Multiple risk factors could materialize\",\n                    \"magnitude\": \"Significant downside potential - see analysis\",\n                    \"timeline\": \"6-18 months\",\n                    \"kill_signals\": warnings[:5] if warnings else [\"Monitor key risk factors\"]\n                }\n            else:\n                # Ensure all fields exist with meaningful defaults\n                bear_case = result[\"bear_case\"]\n                warnings = result.get(\"warnings\", [])\n\n                if not bear_case.get(\"probability\"):\n                    bear_case[\"probability\"] = 0.25\n                if not bear_case.get(\"summary\"):\n                    bear_case[\"summary\"] = result.get(\"contrarian_view\", \"\")[:200] or \"See analysis\"\n                if not bear_case.get(\"trigger\"):\n                    bear_case[\"trigger\"] = warnings[0] if warnings else \"\"\n                if not bear_case.get(\"magnitude\"):\n                    bear_case[\"magnitude\"] = \"\"\n                if not bear_case.get(\"timeline\"):\n                    bear_case[\"timeline\"] = \"6-18 months\"\n                if not bear_case.get(\"kill_signals\"):\n                    bear_case[\"kill_signals\"] = warnings[:5] if warnings else []\n\n        result[\"perspective_type\"] = perspective_type\n        return result\n\n    async def _call_gemini_json(self, prompt: str) -> Any:\n        \"\"\"Call Gemini with JSON response format.\"\"\"\n        if not self.gemini_client:\n            raise ValueError(\"Gemini client not set\")\n\n        result, response = await self.gemini_client.generate_json(prompt)\n        return result\n\n    def get_query_generation_prompt(self, query: str, max_searches: int) -> str:\n        \"\"\"Get default prompt for query generation.\"\"\"\n        return f\"\"\"\nYou are a research strategist. Generate {max_searches} search queries for comprehensive research.\n\nResearch Question: {query}\n\nGuidelines:\n1. Start broad to understand the landscape\n2. Include specific queries for key entities/events\n3. Include queries for different perspectives\n4. Include queries for recent news/developments\n5. Include queries for authoritative sources\n\nReturn a JSON array of search query strings.\nExample: [\"query 1\", \"query 2\", \"query 3\"]\n\"\"\"\n\n    # ========== SOURCE VERIFICATION METHODS ==========\n\n    async def verify_findings(\n        self,\n        findings: List[Dict[str, Any]],\n        sources: List[Dict[str, Any]],\n        original_query: str,\n    ) -> List[Dict[str, Any]]:\n        \"\"\"\n        Run verification layer on extracted findings.\n        Returns findings enriched with verification metadata and Bayesian confidence.\n\n        The confidence calculation uses a proper Bayesian network where:\n        - P(finding is true) depends on P(sources are credible)\n        - P(source is credible) depends on P(domain is authoritative)\n        - Multiple sources are combined using proper probability theory\n        - Bias detection and expert checks provide likelihood ratios\n\n        This makes confidence scores interpretable and explainable:\n        'This finding has 73% confidence because source A (85% credible)\n        corroborates source B (60% credible) but contradicts source C.'\n        \"\"\"\n        if not self.gemini_client:\n            return findings\n\n        from ..services.bayesian_confidence import calculate_bayesian_confidence\n\n        config = self.verification_config\n        verified_findings = []\n\n        for finding in findings:\n            verification = {}\n\n            # Run applicable verification checks based on config\n            if config.get(\"bias_detection\") != \"none\":\n                bias_result = await self._detect_bias(finding, sources)\n                verification[\"bias\"] = bias_result\n\n            if config.get(\"expert_sanity_check\") != \"none\":\n                sanity_result = await self._expert_sanity_check(finding, original_query)\n                verification[\"expert_check\"] = sanity_result\n\n            # Calculate Bayesian confidence with full context\n            # This uses proper probability inference instead of additive adjustments\n            adjusted_confidence, confidence_explanation = calculate_bayesian_confidence(\n                finding=finding,\n                sources=sources,\n                verification=verification,\n            )\n\n            # Enrich finding with verification and Bayesian confidence\n            verified_finding = {**finding}\n            verified_finding[\"verification\"] = verification\n            verified_finding[\"adjusted_confidence\"] = adjusted_confidence\n\n            # Add confidence explanation for interpretability\n            verified_finding[\"confidence_explanation\"] = confidence_explanation.to_dict()\n            verified_finding[\"confidence_narrative\"] = confidence_explanation.generate_narrative()\n\n            verified_findings.append(verified_finding)\n\n        # Run cross-reference analysis on all findings together\n        if config.get(\"cross_reference\") != \"none\" and len(verified_findings) > 1:\n            cross_ref_results = await self._cross_reference_findings(verified_findings, sources)\n            for i, finding in enumerate(verified_findings):\n                if i < len(cross_ref_results):\n                    finding[\"verification\"][\"cross_reference\"] = cross_ref_results[i]\n\n                    # Recalculate confidence with cross-reference data\n                    # This updates the Bayesian network with corroboration evidence\n                    updated_confidence, updated_explanation = calculate_bayesian_confidence(\n                        finding=finding,\n                        sources=sources,\n                        verification=finding[\"verification\"],\n                    )\n                    finding[\"adjusted_confidence\"] = updated_confidence\n                    finding[\"confidence_explanation\"] = updated_explanation.to_dict()\n                    finding[\"confidence_narrative\"] = updated_explanation.generate_narrative()\n\n        return verified_findings\n\n    async def _detect_bias(\n        self,\n        finding: Dict[str, Any],\n        sources: List[Dict[str, Any]],\n    ) -> Dict[str, Any]:\n        \"\"\"Detect bias and 'skin in the game' for a finding.\"\"\"\n        # Find sources that might support this finding\n        finding_content = finding.get(\"content\", \"\")[:500]\n\n        prompt = f\"\"\"You are an investigative analyst detecting bias and conflicts of interest.\n\nFINDING TO ANALYZE:\n{finding_content}\n\nFINDING TYPE: {finding.get(\"finding_type\", \"unknown\")}\n\nPerform BIAS DETECTION:\n\n1. SKIN IN THE GAME\n   Who benefits if this claim is believed?\n   - VENDOR SELF-PROMOTION: Is this a company praising their own product?\n   - ANALYST CONFLICTS: Could the source have financial relationships?\n   - COMPETITIVE POSITIONING: Is someone trashing a competitor?\n   - INVESTMENT TALKING BOOK: Is source long/short a related stock?\n\n2. LINGUISTIC RED FLAGS\n   Check for weasel words and marketing language:\n   - \"Up to X%\" (cherry-picked best case)\n   - \"Studies show\" without citation\n   - \"Industry-leading\" (unmeasured claim)\n   - \"Revolutionary\" (marketing hyperbole)\n   - Lack of specific numbers\n\n3. METHODOLOGY CONCERNS\n   - Is sample size mentioned? Is it adequate?\n   - Is the methodology transparent?\n   - Could there be selection/survivorship bias?\n   - Are definitions clear (e.g., \"adoption\" = trial or daily use)?\n\nReturn JSON:\n{{\n  \"bias_detected\": true/false,\n  \"bias_score\": 0.0-1.0 (0=unbiased, 1=heavily biased),\n  \"bias_type\": \"vendor_marketing\" | \"analyst_conflict\" | \"competitive_attack\" | \"selection_bias\" | \"none\",\n  \"skin_in_the_game\": \"Brief description of who benefits\" or null,\n  \"red_flags\": [\"list of specific red flags found\"],\n  \"confidence_adjustment\": -0.3 to 0.0 (suggested adjustment to confidence)\n}}\n\"\"\"\n\n        try:\n            result = await self._call_gemini_json(prompt)\n            if isinstance(result, dict):\n                return result\n        except Exception:\n            pass\n\n        return {\n            \"bias_detected\": False,\n            \"bias_score\": 0.0,\n            \"bias_type\": \"none\",\n            \"skin_in_the_game\": None,\n            \"red_flags\": [],\n            \"confidence_adjustment\": 0.0\n        }\n\n    async def _expert_sanity_check(\n        self,\n        finding: Dict[str, Any],\n        original_query: str,\n    ) -> Dict[str, Any]:\n        \"\"\"Use LLM expertise to sanity-check claims.\"\"\"\n        finding_content = finding.get(\"content\", \"\")[:800]\n        finding_type = finding.get(\"finding_type\", \"unknown\")\n        extracted_data = finding.get(\"extracted_data\", {})\n\n        prompt = f\"\"\"You are a senior analyst with 20+ years of domain expertise. Apply your knowledge to evaluate this claim.\n\nRESEARCH CONTEXT: {original_query[:200]}\n\nFINDING TO EVALUATE:\nType: {finding_type}\nContent: {finding_content}\nData: {extracted_data}\n\nApply EXPERT JUDGMENT:\n\n1. PLAUSIBILITY CHECK\n   Based on your knowledge:\n   - Does this claim seem reasonable?\n   - Are the numbers/percentages realistic?\n   - Does it align with known market dynamics?\n\n   Common implausible patterns:\n   - \"40% adoption\" for products launched recently\n   - Productivity gains >50% (realistic is 10-30%)\n   - \"100% of X\" claims (nothing is 100%)\n   - Growth rates >200% in mature markets\n\n2. HISTORICAL PATTERN\n   - Does this match how similar situations played out?\n   - What's the typical timeline for such claims?\n   - Are there precedents that support or contradict this?\n\n3. MISSING CONTEXT\n   - What important context is missing?\n   - \"Grew 200%\" - from what base?\n   - \"Faster than X\" - by what measure?\n\n4. EXTRAORDINARY CLAIMS FLAG\n   Flag if this requires extraordinary evidence:\n   - >50% productivity improvement\n   - >80% adoption rate\n   - \"First ever\" or \"only solution\" claims\n\nReturn JSON:\n{{\n  \"plausibility\": \"plausible\" | \"questionable\" | \"implausible\",\n  \"plausibility_score\": 0.0-1.0 (1=highly plausible),\n  \"expert_reasoning\": \"2-3 sentence explanation\",\n  \"historical_precedent\": \"How does this compare to similar claims historically?\",\n  \"missing_context\": [\"list of missing context that would help evaluate\"],\n  \"adjusted_estimate\": \"What's a more realistic interpretation?\" or null,\n  \"extraordinary_claim\": true/false,\n  \"confidence_adjustment\": -0.3 to 0.1 (negative if questionable, small positive if strongly supported)\n}}\n\"\"\"\n\n        try:\n            result = await self._call_gemini_json(prompt)\n            if isinstance(result, dict):\n                return result\n        except Exception:\n            pass\n\n        return {\n            \"plausibility\": \"plausible\",\n            \"plausibility_score\": 0.7,\n            \"expert_reasoning\": \"Unable to perform detailed sanity check\",\n            \"historical_precedent\": None,\n            \"missing_context\": [],\n            \"adjusted_estimate\": None,\n            \"extraordinary_claim\": False,\n            \"confidence_adjustment\": 0.0\n        }\n\n    async def _cross_reference_findings(\n        self,\n        findings: List[Dict[str, Any]],\n        sources: List[Dict[str, Any]],\n    ) -> List[Dict[str, Any]]:\n        \"\"\"Cross-reference findings to identify agreements and contradictions.\"\"\"\n        # Build findings summary for cross-reference\n        findings_summary = []\n        for i, f in enumerate(findings[:15]):  # Limit to avoid token overflow\n            findings_summary.append({\n                \"index\": i,\n                \"type\": f.get(\"finding_type\"),\n                \"summary\": f.get(\"summary\", \"\")[:100],\n                \"content\": f.get(\"content\", \"\")[:200],\n                \"confidence\": f.get(\"confidence_score\", 0.5)\n            })\n\n        prompt = f\"\"\"You are a research verification analyst cross-referencing findings.\n\nFINDINGS TO CROSS-REFERENCE:\n{findings_summary}\n\nNUMBER OF SOURCES: {len(sources)}\n\nFor each finding, analyze:\n\n1. CORROBORATION\n   - Do other findings support or contradict this one?\n   - Would multiple sources logically cover this claim?\n\n2. INTERNAL CONSISTENCY\n   - Do any findings contradict each other?\n   - Are there logical inconsistencies?\n\n3. SOURCE DIVERSITY\n   - Is this claim likely from a single source or multiple?\n   - Primary data vs secondary citation?\n\nReturn JSON array with one object per finding (same order as input):\n[\n  {{\n    \"finding_index\": 0,\n    \"corroboration_level\": \"strong\" | \"moderate\" | \"weak\" | \"uncorroborated\",\n    \"supporting_findings\": [list of finding indices that support this],\n    \"contradicting_findings\": [list of finding indices that contradict this],\n    \"likely_source_diversity\": \"single\" | \"few\" | \"multiple\",\n    \"verification_notes\": \"Brief note on verification status\",\n    \"confidence_adjustment\": -0.2 to 0.1\n  }}\n]\n\"\"\"\n\n        try:\n            result = await self._call_gemini_json(prompt)\n            if isinstance(result, list):\n                return result\n        except Exception:\n            pass\n\n        # Return empty cross-reference for each finding\n        return [{\"corroboration_level\": \"unknown\", \"confidence_adjustment\": 0.0} for _ in findings]\n\n    def _calculate_adjusted_confidence(\n        self,\n        original_confidence: float,\n        verification: Dict[str, Any],\n        finding: Optional[Dict[str, Any]] = None,\n        sources: Optional[List[Dict[str, Any]]] = None,\n    ) -> float:\n        \"\"\"Calculate adjusted confidence score using Bayesian inference.\n\n        This replaces the additive adjustment model with proper probabilistic\n        inference. Instead of summing adjustments (which can violate probability\n        rules), we use Bayes' theorem to properly combine evidence.\n\n        The Bayesian approach provides:\n        1. Interpretable confidence scores (true probabilities)\n        2. Explainable reasoning chain (why confidence changed)\n        3. Proper handling of corroborating/contradicting evidence\n        4. Insights into what would change the conclusion\n\n        Args:\n            original_confidence: Base confidence from finding extraction\n            verification: Verification results (bias, expert_check, cross_reference)\n            finding: Optional finding dict for full Bayesian calculation\n            sources: Optional sources list for credibility assessment\n\n        Returns:\n            Adjusted confidence score (probability) between 0.1 and 0.95\n        \"\"\"\n        from ..services.bayesian_confidence import calculate_bayesian_confidence\n\n        # If we have the full context, use the comprehensive Bayesian model\n        if finding is not None and sources is not None:\n            # Create a finding dict with the original confidence\n            finding_with_conf = {**finding, \"confidence_score\": original_confidence}\n            adjusted, _ = calculate_bayesian_confidence(\n                finding_with_conf, sources, verification\n            )\n            return adjusted\n\n        # Fallback: Use simplified Bayesian update for just verification data\n        return self._calculate_adjusted_confidence_legacy(\n            original_confidence, verification\n        )\n\n    def _calculate_adjusted_confidence_legacy(\n        self,\n        original_confidence: float,\n        verification: Dict[str, Any],\n    ) -> float:\n        \"\"\"Legacy additive confidence calculation (for backwards compatibility).\n\n        Note: This is a fallback when full Bayesian calculation isn't possible.\n        The additive model doesn't properly handle probability combination,\n        but is kept for cases where we don't have full source data.\n        \"\"\"\n        adjusted = original_confidence\n\n        # Apply bias adjustment\n        if \"bias\" in verification:\n            bias_adj = verification[\"bias\"].get(\"confidence_adjustment\", 0.0)\n            adjusted += bias_adj\n\n        # Apply expert sanity check adjustment\n        if \"expert_check\" in verification:\n            expert_adj = verification[\"expert_check\"].get(\"confidence_adjustment\", 0.0)\n            adjusted += expert_adj\n\n        # Apply cross-reference adjustment\n        if \"cross_reference\" in verification:\n            cross_adj = verification[\"cross_reference\"].get(\"confidence_adjustment\", 0.0)\n            adjusted += cross_adj\n\n        # Clamp to valid range\n        return max(0.1, min(1.0, adjusted))\n\n    # ========== REPORT GENERATION METHODS ==========\n\n    def get_supported_report_variants(self) -> List[str]:\n        \"\"\"Get list of report variants supported by this template.\n\n        Subclasses can override to add domain-specific variants.\n        \"\"\"\n        return [\"full_report\", \"executive_summary\", \"decision_brief\"]\n\n    def generate_report(\n        self,\n        result: Dict[str, Any],\n        variant: str = \"full_report\",\n        title: Optional[str] = None,\n    ) -> str:\n        \"\"\"Generate a report in the specified variant.\n\n        This is the main entry point for report generation.\n        Templates can override specific variant methods for domain-specific rendering.\n\n        Args:\n            result: Research result dictionary\n            variant: Report variant (full_report, executive_summary, or template-specific)\n            title: Optional custom title\n\n        Returns:\n            Formatted markdown string\n        \"\"\"\n        if variant == \"executive_summary\":\n            return self.generate_executive_summary(result, title)\n        elif variant == \"full_report\":\n            return self.generate_full_report(result, title)\n        elif variant == \"decision_brief\":\n            return self.generate_decision_brief(result, title)\n        else:\n            # Check for template-specific variants\n            method_name = f\"generate_{variant}\"\n            if hasattr(self, method_name):\n                return getattr(self, method_name)(result, title)\n            # Fall back to full report for unknown variants\n            return self.generate_full_report(result, title)\n\n    def generate_full_report(\n        self,\n        result: Dict[str, Any],\n        title: Optional[str] = None,\n    ) -> str:\n        \"\"\"Generate full detailed report.\n\n        This provides a default implementation. Subclasses can override\n        for domain-specific full report formatting.\n        \"\"\"\n        from datetime import datetime\n\n        query = result.get(\"query\", \"Unknown Query\")\n        template = result.get(\"template\", self.template_id)\n        report_title = title or f\"Research Report: {query[:50]}\"\n\n        sections = []\n\n        # Header\n        sections.append(f\"# {report_title}\")\n        sections.append(\"\")\n        sections.append(f\"**Research Query:** {query}\")\n        sections.append(f\"**Template:** {template.replace('_', ' ').title()} Research\")\n        sections.append(f\"**Generated:** {datetime.now().strftime('%B %d, %Y at %H:%M')}\")\n        sections.append(f\"**Status:** {result.get('status', 'unknown').title()}\")\n        sections.append(\"\")\n        sections.append(\"---\")\n        sections.append(\"\")\n\n        # Template-specific header content\n        header_content = self._generate_report_header(result)\n        if header_content:\n            sections.append(header_content)\n            sections.append(\"\")\n            sections.append(\"---\")\n            sections.append(\"\")\n\n        # Executive Summary section\n        sections.append(\"## Executive Summary\")\n        sections.append(\"\")\n        findings = result.get(\"findings\", [])\n        if findings:\n            high_conf = [f for f in findings if f.get(\"confidence_score\", 0) >= 0.7]\n            sections.append(f\"This research identified **{len(findings)}** key findings across multiple categories.\")\n            sections.append(f\"**{len(high_conf)}** findings have high confidence (>70%).\")\n            sections.append(\"\")\n\n            # Key findings summary (template can customize via _get_priority_findings)\n            priority_findings = self._get_priority_findings(findings)\n            for finding in priority_findings[:5]:\n                ftype = finding.get(\"finding_type\", \"fact\").upper()\n                summary = finding.get(\"summary\") or finding.get(\"content\", \"\")[:100]\n                sections.append(f\"- **[{ftype}]** {summary}\")\n            sections.append(\"\")\n        else:\n            sections.append(\"No significant findings were extracted.\")\n            sections.append(\"\")\n\n        sections.append(\"---\")\n        sections.append(\"\")\n\n        # Template-specific key sections\n        key_sections = self._generate_key_sections(result)\n        if key_sections:\n            sections.append(key_sections)\n            sections.append(\"\")\n            sections.append(\"---\")\n            sections.append(\"\")\n\n        # Detailed Findings\n        sections.append(\"## Detailed Findings\")\n        sections.append(\"\")\n\n        # Group by type (template can customize grouping)\n        grouped_findings = self._group_findings(findings)\n\n        for ftype, type_findings in grouped_findings.items():\n            sections.append(f\"### {ftype.replace('_', ' ').title()} ({len(type_findings)})\")\n            sections.append(\"\")\n\n            for finding in type_findings:\n                conf = finding.get(\"confidence_score\", 0.5)\n                conf_label = \"High\" if conf >= 0.8 else \"Medium\" if conf >= 0.6 else \"Low\"\n                sections.append(f\"#### {finding.get('summary', finding.get('content', '')[:60])}\")\n                sections.append(\"\")\n                sections.append(finding.get(\"content\", \"\"))\n                sections.append(\"\")\n                sections.append(f\"*Confidence: {conf_label} ({conf:.0%})*\")\n                sections.append(\"\")\n\n        sections.append(\"---\")\n        sections.append(\"\")\n\n        # Perspectives\n        perspectives = result.get(\"perspectives\", [])\n        if perspectives:\n            sections.append(\"## Multi-Perspective Analysis\")\n            sections.append(\"\")\n\n            for perspective in perspectives:\n                ptype = perspective.get(\"perspective_type\", \"unknown\").replace(\"_\", \" \").title()\n                sections.append(f\"### {ptype} Perspective\")\n                sections.append(\"\")\n                sections.append(perspective.get(\"analysis_text\", \"\"))\n                sections.append(\"\")\n\n                insights = perspective.get(\"key_insights\", [])\n                if insights:\n                    sections.append(\"**Key Insights:**\")\n                    for insight in insights:\n                        sections.append(f\"- {insight}\")\n                    sections.append(\"\")\n\n                recs = perspective.get(\"recommendations\", [])\n                if recs:\n                    sections.append(\"**Recommendations:**\")\n                    for rec in recs:\n                        sections.append(f\"- {rec}\")\n                    sections.append(\"\")\n\n                warnings = perspective.get(\"warnings\", [])\n                if warnings:\n                    sections.append(\"**Warnings:**\")\n                    for warning in warnings:\n                        sections.append(f\"- {warning}\")\n                    sections.append(\"\")\n\n            sections.append(\"---\")\n            sections.append(\"\")\n\n        # Template-specific additional sections\n        additional = self._generate_additional_sections(result)\n        if additional:\n            sections.append(additional)\n            sections.append(\"\")\n            sections.append(\"---\")\n            sections.append(\"\")\n\n        # Sources\n        sources = result.get(\"sources\", [])\n        if sources:\n            sections.append(\"## Sources\")\n            sections.append(\"\")\n\n            for source in sources[:20]:\n                title_text = source.get(\"title\", source.get(\"url\", \"Unknown\"))\n                url = source.get(\"url\", \"#\")\n                cred = source.get(\"credibility_score\", 0.5)\n                sections.append(f\"- [{title_text}]({url}) - Credibility: {cred:.0%}\")\n\n            sections.append(\"\")\n            sections.append(\"---\")\n            sections.append(\"\")\n\n        # Metadata\n        sections.append(\"## Research Metadata\")\n        sections.append(\"\")\n        sections.append(f\"- **Session ID:** {result.get('session_id', 'N/A')}\")\n        sections.append(f\"- **Execution Time:** {result.get('execution_time_seconds', 0):.1f} seconds\")\n\n        cost = result.get(\"cost_summary\", {})\n        if cost:\n            sections.append(f\"- **Total Tokens:** {cost.get('total_tokens', 0):,}\")\n            sections.append(f\"- **Total Cost:** ${cost.get('total_cost_usd', 0):.4f}\")\n\n        queries = result.get(\"search_queries_executed\", [])\n        if queries:\n            sections.append(f\"- **Searches Executed:** {len(queries)}\")\n\n        return \"\\n\".join(sections)\n\n    def generate_executive_summary(\n        self,\n        result: Dict[str, Any],\n        title: Optional[str] = None,\n    ) -> str:\n        \"\"\"Generate brief executive summary.\n\n        This provides a default implementation. Subclasses can override\n        for domain-specific executive summary formatting.\n        \"\"\"\n        from datetime import datetime\n\n        query = result.get(\"query\", \"Unknown Query\")\n        report_title = title or f\"Executive Summary: {query[:40]}\"\n\n        sections = []\n        sections.append(f\"# {report_title}\")\n        sections.append(\"\")\n        sections.append(f\"**Research Query:** {query}\")\n        sections.append(f\"**Generated:** {datetime.now().strftime('%B %d, %Y')}\")\n        sections.append(\"\")\n        sections.append(\"---\")\n        sections.append(\"\")\n\n        # Key findings\n        sections.append(\"## Key Findings\")\n        sections.append(\"\")\n\n        findings = result.get(\"findings\", [])\n        priority_findings = self._get_priority_findings(findings)\n\n        for finding in priority_findings[:7]:\n            ftype = finding.get(\"finding_type\", \"fact\").upper()\n            summary = finding.get(\"summary\") or finding.get(\"content\", \"\")[:150]\n            sections.append(f\"- **[{ftype}]** {summary}\")\n\n        sections.append(\"\")\n\n        # Template-specific executive highlights\n        highlights = self._generate_executive_highlights(result)\n        if highlights:\n            sections.append(highlights)\n            sections.append(\"\")\n\n        # Key perspectives\n        perspectives = result.get(\"perspectives\", [])\n        if perspectives:\n            sections.append(\"## Expert Perspectives\")\n            sections.append(\"\")\n\n            for p in perspectives:\n                ptype = p.get(\"perspective_type\", \"\").replace(\"_\", \" \").title()\n                insights = p.get(\"key_insights\", [])\n                if insights:\n                    sections.append(f\"**{ptype}:** {insights[0]}\")\n\n            sections.append(\"\")\n\n        sections.append(\"---\")\n        sections.append(\"\")\n        sections.append(f\"*Full report contains {len(findings)} findings from {len(result.get('sources', []))} sources.*\")\n\n        return \"\\n\".join(sections)\n\n    def generate_decision_brief(\n        self,\n        result: Dict[str, Any],\n        title: Optional[str] = None,\n    ) -> str:\n        \"\"\"Generate focused one-page decision brief.\n\n        This is a highly condensed format focused on actionable insights\n        for busy executives. Maximum one page when printed.\n        \"\"\"\n        from datetime import datetime\n\n        query = result.get(\"query\", \"Unknown Query\")\n        report_title = title or f\"Decision Brief: {query[:35]}\"\n        findings = result.get(\"findings\", [])\n        perspectives = result.get(\"perspectives\", [])\n\n        sections = []\n\n        # Header - compact\n        sections.append(f\"# {report_title}\")\n        sections.append(f\"*{datetime.now().strftime('%B %d, %Y')} | {len(findings)} findings | Confidence: {self._calculate_avg_confidence(findings):.0%}*\")\n        sections.append(\"\")\n        sections.append(\"---\")\n        sections.append(\"\")\n\n        # Bottom Line Up Front (BLUF)\n        sections.append(\"## Bottom Line\")\n        sections.append(\"\")\n        priority = self._get_priority_findings(findings)\n        if priority:\n            top_finding = priority[0]\n            sections.append(f\"> {top_finding.get('summary') or top_finding.get('content', '')[:200]}\")\n        sections.append(\"\")\n\n        # Key Facts (3-5 bullets max)\n        sections.append(\"## Key Facts\")\n        sections.append(\"\")\n        facts = [f for f in findings if f.get(\"finding_type\") == \"fact\"][:5]\n        if not facts:\n            facts = priority[:5]\n        for f in facts:\n            conf = f.get(\"confidence_score\", 0.5)\n            conf_icon = \"\" if conf >= 0.8 else \"\" if conf >= 0.6 else \"\"\n            sections.append(f\"- {conf_icon} {f.get('summary') or f.get('content', '')[:100]}\")\n        sections.append(\"\")\n\n        # Risk Callout Box\n        red_flags = [f for f in findings if f.get(\"finding_type\") in [\"red_flag\", \"suspicious_element\", \"risk\"]]\n        if red_flags:\n            sections.append(\"## Risks & Red Flags\")\n            sections.append(\"\")\n            for rf in red_flags[:3]:\n                sections.append(f\"- {rf.get('summary') or rf.get('content', '')[:80]}\")\n            sections.append(\"\")\n\n        # Recommendations (from perspectives)\n        all_recs = []\n        for p in perspectives:\n            recs = p.get(\"recommendations\", [])\n            all_recs.extend(recs[:2])\n        if all_recs:\n            sections.append(\"## Recommended Actions\")\n            sections.append(\"\")\n            for rec in all_recs[:4]:\n                if isinstance(rec, str):\n                    sections.append(f\"- {rec[:100]}\")\n            sections.append(\"\")\n\n        # Knowledge Gaps (brief)\n        gaps = [f for f in findings if f.get(\"finding_type\") == \"gap\"]\n        if gaps:\n            sections.append(\"## Open Questions\")\n            sections.append(\"\")\n            for g in gaps[:2]:\n                sections.append(f\"- {g.get('summary') or g.get('content', '')[:80]}\")\n            sections.append(\"\")\n\n        # Footer\n        sections.append(\"---\")\n        sections.append(f\"*Based on {len(result.get('sources', []))} sources. See full report for details.*\")\n\n        return \"\\n\".join(sections)\n\n    def _calculate_avg_confidence(self, findings: List[Dict[str, Any]]) -> float:\n        \"\"\"Calculate average confidence across findings.\"\"\"\n        if not findings:\n            return 0.0\n        total = sum(f.get(\"confidence_score\", 0.5) for f in findings)\n        return total / len(findings)\n\n    # ========== TEMPLATE HOOKS FOR CUSTOMIZATION ==========\n\n    def _generate_report_header(self, result: Dict[str, Any]) -> str:\n        \"\"\"Generate template-specific header content.\n\n        Override in subclasses to add domain-specific header sections.\n        \"\"\"\n        return \"\"\n\n    def _get_priority_findings(self, findings: List[Dict[str, Any]]) -> List[Dict[str, Any]]:\n        \"\"\"Get priority-sorted findings for summary sections.\n\n        Override in subclasses to customize finding priority for domain.\n        Default: high confidence findings sorted by confidence.\n        \"\"\"\n        high_conf = sorted(\n            [f for f in findings if f.get(\"confidence_score\", 0) >= 0.6],\n            key=lambda x: x.get(\"confidence_score\", 0),\n            reverse=True\n        )\n        return high_conf\n\n    def _group_findings(self, findings: List[Dict[str, Any]]) -> Dict[str, List[Dict[str, Any]]]:\n        \"\"\"Group findings by type for detailed sections.\n\n        Override in subclasses to customize grouping for domain.\n        \"\"\"\n        grouped: Dict[str, List[Dict[str, Any]]] = {}\n        for f in findings:\n            ftype = f.get(\"finding_type\", \"other\")\n            if ftype not in grouped:\n                grouped[ftype] = []\n            grouped[ftype].append(f)\n        return grouped\n\n    def _generate_key_sections(self, result: Dict[str, Any]) -> str:\n        \"\"\"Generate template-specific key sections.\n\n        Override in subclasses for domain-specific sections like:\n        - Financial: Bull/Bear case, Valuation summary\n        - Investigative: Risk assessment, Actor map\n        - Contract: Red flags summary, Pricing analysis\n        \"\"\"\n        return \"\"\n\n    def _generate_additional_sections(self, result: Dict[str, Any]) -> str:\n        \"\"\"Generate additional template-specific sections.\n\n        Override in subclasses for sections that come after perspectives.\n        \"\"\"\n        return \"\"\n\n    def _generate_executive_highlights(self, result: Dict[str, Any]) -> str:\n        \"\"\"Generate template-specific executive summary highlights.\n\n        Override in subclasses for domain-specific executive highlights.\n        \"\"\"\n        return \"\"\n","numLines":1765,"startLine":1,"totalLines":1765}}}
