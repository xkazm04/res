[2026-01-29T23:29:01.433Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GNvpggU6QyeJ1cHntj7RwW","type":"tool_result","content":"     1→\"\"\"Research orchestration service.\"\"\"\n     2→\n     3→import time\n     4→import logging\n     5→from typing import List, Dict, Any, Optional, TYPE_CHECKING\n     6→from uuid import uuid4\n     7→\n     8→from ..clients.gemini import GeminiClient, Source as GeminiSource\n     9→from ..clients.supabase import SupabaseClient\n    10→from ..templates import get_template, BaseTemplate\n    11→from .cost_tracker import CostTracker\n    12→from .ocr import OCRService\n    13→from .cache import CacheService\n    14→from .transform import (\n    15→    extract_source_dict,\n    16→    enrich_source_credibility,\n    17→    enrich_findings_with_ids_and_sources,\n    18→)\n    19→\n    20→if TYPE_CHECKING:\n    21→    from .progress import ProgressEmitter\n    22→\n    23→logger = logging.getLogger(__name__)\n    24→\n    25→\n    26→class ResearchService:\n    27→    \"\"\"Orchestrates the research process.\"\"\"\n    28→\n    29→    def __init__(\n    30→        self,\n    31→        gemini_client: GeminiClient,\n    32→        supabase_client: Optional[SupabaseClient] = None,\n    33→        ocr_service: Optional[OCRService] = None,\n    34→        progress_emitter: Optional[\"ProgressEmitter\"] = None,\n    35→    ):\n    36→        self.gemini = gemini_client\n    37→        self.supabase = supabase_client\n    38→        self.ocr = ocr_service\n    39→        self.cost_tracker = CostTracker()\n    40→        self.progress = progress_emitter\n    41→\n    42→    async def execute_research(\n    43→        self,\n    44→        query: str,\n    45→        template_type: str = \"investigative\",\n    46→        granularity: str = \"standard\",\n    47→        max_searches: int = 5,\n    48→        perspectives: Optional[List[str]] = None,\n    49→        input_file_url: Optional[str] = None,\n    50→        input_text: Optional[str] = None,\n    51→        save_to_db: bool = True,\n    52→        workspace_id: str = \"apify\",\n    53→        use_cache: bool = True,\n    54→        extend_cache: bool = True,\n    55→        intent: Optional[str] = None,\n    56→        intent_config: Optional[Dict[str, Any]] = None,\n    57→    ) -> Dict[str, Any]:\n    58→        \"\"\"\n    59→        Execute a complete research session.\n    60→\n    61→        Args:\n    62→            use_cache: Check for and return cached results for identical queries\n    63→            extend_cache: If cache hit, extend with new research in background\n    64→            intent: Requestor's decision intent (investment_sizing, risk_assessment, etc.)\n    65→            intent_config: Configuration dict from ActorInput.get_intent_config()\n    66→\n    67→        Returns:\n    68→            Dict with session_id, findings, perspectives, sources, etc.\n    69→        \"\"\"\n    70→        start_time = time.time()\n    71→        session_id = str(uuid4())\n    72→        errors = []\n    73→        warnings = []\n    74→\n    75→        # Initialize cache service\n    76→        cache_service = CacheService()\n    77→        cache_key = cache_service.get_cache_key(query, template_type, granularity)\n    78→        cache_hit = False\n    79→        original_cached_at = None\n    80→\n    81→        # Check cache if enabled\n    82→        if use_cache and cache_service.is_available():\n    83→            cached = await cache_service.get_cached(cache_key)\n    84→            if cached:\n    85→                logger.info(f\"Cache hit for query: {query[:50]}...\")\n    86→                cache_hit = True\n    87→                original_cached_at = cached.get(\"cached_at\")\n    88→\n    89→                # Update access count\n    90→                await cache_service.update_access(cache_key)\n    91→\n    92→                # Return cached result with cache metadata\n    93→                cached_result = cached.get(\"result\", {})\n    94→                cached_result[\"cache_hit\"] = True\n    95→                cached_result[\"cache_extended\"] = False\n    96→                cached_result[\"original_cached_at\"] = original_cached_at\n    97→                cached_result[\"execution_time_seconds\"] = round(time.time() - start_time, 2)\n    98→\n    99→                # Log cache hit (event emitter doesn't have cache_hit method)\n   100→                logger.info(f\"Cache hit for query: {query[:50]}...\")\n   101→\n   102→                return cached_result\n   103→\n   104→        # Initialize template\n   105→        template = get_template(template_type)\n   106→        template.set_client(self.gemini)\n   107→\n   108→        # Emit initialization\n   109→        if self.progress:\n   110→            await self.progress.initialized(query, template_type, granularity, max_searches)\n   111→\n   112→        # Build context from input file/text\n   113→        context_text = \"\"\n   114→        if input_file_url and self.ocr:\n   115→            try:\n   116→                logger.info(f\"Processing input file: {input_file_url}\")\n   117→                ocr_result = await self.ocr.process_file_url(input_file_url)\n   118→                context_text = ocr_result.get(\"text\", \"\")\n   119→                self.cost_tracker.add_openrouter_usage(ocr_result.get(\"tokens\", 0))\n   120→            except Exception as e:\n   121→                warnings.append(f\"Failed to process input file: {str(e)}\")\n   122→                logger.warning(f\"OCR failed: {e}\")\n   123→\n   124→        if input_text:\n   125→            context_text = f\"{context_text}\\n\\n{input_text}\" if context_text else input_text\n   126→\n   127→        # Create session in database\n   128→        db_session = None\n   129→        if save_to_db and self.supabase:\n   130→            try:\n   131→                db_session = await self.supabase.create_session(\n   132→                    title=f\"Research: {query[:50]}...\",\n   133→                    query=query,\n   134→                    template_type=template_type,\n   135→                    parameters={\n   136→                        \"granularity\": granularity,\n   137→                        \"max_searches\": max_searches,\n   138→                        \"perspectives\": perspectives,\n   139→                    },\n   140→                )\n   141→                session_id = db_session.get(\"id\", session_id)\n   142→            except Exception as e:\n   143→                warnings.append(f\"Failed to create database session: {str(e)}\")\n   144→                logger.warning(f\"DB session creation failed: {e}\")\n   145→\n   146→        # Phase 1: Generate search queries\n   147→        logger.info(\"Generating search queries...\")\n   148→        search_queries = await template.generate_search_queries(\n   149→            query=query,\n   150→            max_searches=max_searches,\n   151→            granularity=granularity,\n   152→        )\n   153→\n   154→        if not search_queries:\n   155→            errors.append(\"Failed to generate search queries\")\n   156→            if self.progress:\n   157→                await self.progress.failed(\"Failed to generate search queries\", \"QUERY_GENERATION_FAILED\", \"query_generation\")\n   158→            return self._build_error_result(session_id, query, template_type, errors, start_time)\n   159→\n   160→        # Emit query generation\n   161→        if self.progress:\n   162→            await self.progress.queries_generated(len(search_queries), search_queries)\n   163→\n   164→        # Phase 2: Execute searches\n   165→        logger.info(f\"Executing {len(search_queries)} searches...\")\n   166→        all_sources: List[Dict[str, Any]] = []\n   167→        all_content: List[str] = []\n   168→\n   169→        # Add context if available\n   170→        if context_text:\n   171→            all_content.app