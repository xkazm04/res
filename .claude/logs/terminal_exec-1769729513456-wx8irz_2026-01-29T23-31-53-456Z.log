n    39→      : 0;\n    40→    return {\n    41→      findings: findings.length,\n    42→      sources: sources.length,\n    43→      perspectives: session.perspectives?.length || 0,\n    44→      contradictions: session.contradictions?.length || 0,\n    45→      gaps: session.gaps?.length || 0,\n    46→      avgConfidence,\n    47→      highConfidence: findings.filter(f => (f.confidence_score || 0) >= 0.8).length,\n    48→      redFlags: findings.filter(f => f.finding_type === 'gap' || f.content.toLowerCase().includes('risk')).length,\n    49→      entities: session.entities?.length || 0,\n    50→    };\n    51→  }, [session]);\n    52→\n    53→  const findingTypes = useMemo(() =>\n    54→    Array.from(new Set(session.findings?.map(f => f.finding_type) || [])),\n    55→    [session.findings]\n    56→  );\n    57→\n    58→  return (\n    59→    <ReportShell onClose={onClose}>\n    60→      <ThemedSidebar activeTab={activeTab} onTabChange={setActiveTab} stats={stats} onClose={onClose} />\n    61→\n    62→      <main className={`flex-1 flex flex-col overflow-hidden ${styles.bg}`}>\n    63→        {/* Header */}\n    64→        <header className={`px-6 py-4 border-b ${styles.border}`}>\n    65→          <motion.h1 initial={{ opacity: 0, y: -10 }} animate={{ opacity: 1, y: 0 }} className={`text-lg font-bold ${styles.text}`}>\n    66→            {session.title}\n    67→          </motion.h1>\n    68→        </header>\n    69→\n    70→        {/* Toolbar */}\n    71→        {activeTab !== 'overview' && (\n    72→          <Toolbar\n    73→            searchQuery={searchQuery}\n    74→            onSearchChange={setSearchQuery}\n    75→            filterType={filterType}\n    76→            onFilterTypeChange={setFilterType}\n    77→            filterConfidence={filterConfidence}\n    78→            onFilterConfidenceChange={setFilterConfidence}\n    79→            findingTypes={findingTypes}\n    80→            showTypeFilter={activeTab === 'findings'}\n    81→            showConfidenceFilter={activeTab === 'findings' || activeTab === 'sources'}\n    82→          />\n    83→        )}\n    84→\n    85→        {/* Content */}\n    86→        <div className=\"flex-1 overflow-y-auto p-6\">\n    87→          <div className=\"max-w-5xl mx-auto\">\n    88→            {activeTab === 'overview' && <OverviewView session={session} stats={stats} />}\n    89→            {activeTab === 'findings' && <FindingsView findings={session.findings || []} sources={session.sources || []} searchQuery={searchQuery} filterType={filterType} filterConfidence={filterConfidence} />}\n    90→            {activeTab === 'sources' && <SourcesView sources={session.sources || []} searchQuery={searchQuery} filterConfidence={filterConfidence} />}\n    91→            {activeTab === 'perspectives' && <PerspectivesView perspectives={session.perspectives || []} />}\n    92→            {activeTab === 'analysis' && <AnalysisView contradictions={session.contradictions || []} gaps={session.gaps || []} causalChains={session.causal_chains || []} />}\n    93→            {activeTab === 'entities' && <EntitiesView entities={session.entities || []} />}\n    94→          </div>\n    95→        </div>\n    96→      </main>\n    97→    </ReportShell>\n    98→  );\n    99→}\n   100→\n   101→function Toolbar({ searchQuery, onSearchChange, filterType, onFilterTypeChange, filterConfidence, onFilterConfidenceChange, findingTypes, showTypeFilter, showConfidenceFilter }: {\n   102→  searchQuery: string;\n   103→  onSearchChange: (v: string) => void;\n   104→  filterType: string;\n   105→  onFilterTypeChange: (v: string) => void;\n   106→  filterConfidence: string;\n   107→  onFilterConfidenceChange: (v: string) => void;\n   108→  findingTypes: string[];\n   109→  showTypeFilter: boolean;\n   110→  showConfidenceFilter: boolean;\n   111→}) {\n   112→  const styles = useThemeStyles();\n   113→  return (\n   114→    <div className={`px-6 py-3 border-b ${styles.border} flex flex-wrap gap-3`}>\n  