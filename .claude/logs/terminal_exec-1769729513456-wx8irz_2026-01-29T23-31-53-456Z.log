 { name: 'Summary', start: 345, end: 450 },  // 11.5-15s - Memorable close\n    53→  ],\n    54→  totalFrames: 450, // 15 seconds\n    55→};\n    56→\n    57→export function VideoOverview({ session, stats }: VideoOverviewProps) {\n    58→  const { theme } = useReportTheme();\n    59→  const isRadar = theme === 'radar';\n    60→  const [format, setFormat] = useState<VideoFormat>('standard');\n    61→  const playback = useVideoPlayback({ fps: SCENE_CONFIG.fps, durationInFrames: SCENE_CONFIG.totalFrames });\n    62→  const { frame } = playback;\n    63→  const fps = SCENE_CONFIG.fps;\n    64→  const formatConfig = FORMAT_CONFIG[format];\n    65→\n    66→  // Prepare chart data (memoized)\n    67→  const chartData = useMemo(() => {\n    68→    const findingCounts: Record<string, number> = {};\n    69→    session.findings?.forEach(f => { findingCounts[f.finding_type] = (findingCounts[f.finding_type] || 0) + 1; });\n    70→\n    71→    const sourceCounts: Record<string, number> = {};\n    72→    session.sources?.forEach(s => { sourceCounts[s.source_type || 'web'] = (sourceCounts[s.source_type || 'web'] || 0) + 1; });\n    73→    const pieColors = ['#ef4444', '#f59e0b', '#22d3ee', '#a78bfa', '#34d399'];\n    74→\n    75→    return {\n    76→      barData: Object.entries(findingCounts).slice(0, 5).map(([label, value]) => ({ label: label.slice(0, 4), value })),\n    77→      lineData: session.findings?.slice(0, 10).map(f => (f.confidence_score || 0.5) * 100) || [50],\n    78→      pieData: Object.entries(sourceCounts).slice(0, 4).map(([label, value], i) => ({ label, value, color: pieColors[i] })),\n    79→    };\n    80→  }, [session.findings, session.sources]);\n    81→\n    82→  // Extract insights\n    83→  const contentData = useMemo(() => {\n    84→    const insights: string[] = [];\n    85→    const warnings: string[] = [];\n    86→    session.perspectives?.forEach(p => {\n    87→      p.key_insights?.slice(0, 2).forEach(i => insights.push(i));\n    88→      p.warnings?.slice(0, 1).forEach(w => warnings.push(w));\n    89→    });\n    90→    return { insights: insights.slice(0, 3), warnings: warnings.slice(0, 2) };\n    91→  }, [session.perspectives]);\n    92→\n    93→  const metrics = [\n    94→    { label: 'Findings', value: stats.findings, color: 'cyan' },\n    95→    { label: 'Sources', value: stats.sources, color: 'emerald' },\n    96→    { label: 'Confidence', value: stats.avgConfidence, suffix: '%', color: 'amber' },\n    97→    { label: 'Alerts', value: stats.redFlags + stats.gaps, color: 'rose' },\n    98→  ];\n    99→\n   100→  // Calculate scene visibilities with smooth crossfade\n   101→  const getSceneOpacity = (sceneStart: number, sceneEnd: number, fadeFrames: number = 16) => {\n   102→    if (frame < sceneStart) return 0;\n   103→    if (frame > sceneEnd) return 0;\n   104→\n   105→    const fadeInEnd = sceneStart + fadeFrames;\n   106→    if (frame < fadeInEnd) {\n   107→      return spring({ frame: frame - sceneStart, fps, delay: 0, durationFrames: fadeFrames, easing: easeOutCubic });\n   108→    }\n   109→\n   110→    const fadeOutStart = sceneEnd - fadeFrames;\n   111→    if (frame > fadeOutStart) {\n   112→      return 1 - spring({ frame: frame - fadeOutStart, fps, delay: 0, durationFrames: fadeFrames, easing: easeOutCubic });\n   113→    }\n   114→\n   115→    return 1;\n   116→  };\n   117→\n   118→  // Ambient animation\n   119→  const ambientPulse = Math.sin((frame / fps) * Math.PI * 0.3) * 0.5 + 0.5;\n   120→\n   121→  // Determine template category for news style\n   122→  const templateType = session.template_type || 'analysis';\n   123→  const isUrgent = ['investigative', 'due_diligence', 'legal'].includes(templateType);\n   124→\n   125→  // News ticker text based on template type\n   126→  const tickerText = useMemo(() => {\n   127→    const base = session.query?.slice(0, 40) || 'Analysis Report';\n   128→    const extras = [\n   129→      `${stats.findings} findings verified`,\n   130→      `${stats.sources} sources analyzed`,\n   131→      `${stats.avgConfidence}% confidence`,\n   132→      stats.redFlags > 0 ? `${stats.redFlags} red flags detected` : null,\n   133→    ].filter(Boolean);\n   134→    return `${base} • ${extras.join(' • ')}`;\n   135→  }, [session.query, stats]);\n   136→\n   137→  // Ticker animation\n   138→  const tickerOffset = (frame / fps) * 50; // pixels per second\n   139→\n   140→  return (\n   141→    <div className=\"space-y-4\">\n   142→      {/* Format Selector */}\n   143→      <div className=\"flex items-center justify-between\">\n   144→        <div className=\"flex items-center gap-2\">\n   145→          {(Object.keys(FORMAT_CONFIG) as VideoFormat[]).map((f) => (\n   146→            <button\n   147→              key={f}\n   148→              onClick={() => setFormat(f)}\n   149→              className={`px-3 py-1.5 rounded-lg text-sm font-medium transition-all flex items-center gap-1.5 ${\n   150→                format === f\n   151→                  ? isRadar\n   152→                    ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/40'\n   153→                    : 'bg-stone-800 text-white'\n   154→                  : isRadar\n   155→                    ? 'text-slate-400 hover:text-white hover:bg-slate-800'\n   156→                    : 'text-stone-500 hover:text-stone-900 hover:bg-stone-200'\n   157→              }`}\n   158→            >\n   159→              <span>{FORMAT_CONFIG[f].icon}</span>\n   160→              <span>{FORMAT_CONFIG[f].label}</span>\n   161→            </button>\n   162→          ))}\n   163→        </div>\n   164→        <div className={`text-xs ${isRadar ? 'text-slate-500' : 'text-stone-400'}`}>\n   165→          {formatConfig.width}×{formatConfig.height}\n   166→        </div>\n   167→      </div>\n   168→\n   169→      {/* Video Container */}\n   170→      <div\n   171→        className=\"flex justify-center\"\n   172→        style={{ minHeight: format === 'mobile' ? 520 : 400 }}\n   173→      >\n   174→        <div\n   175→          className={`relative overflow-hidden ${isRadar ? 'bg-slate-950' : 'bg-stone-100'} ${format === 'standard' ? 'rounded-2xl' : 'rounded-3xl'}`}\n   176→          style={{\n   177→            width: formatConfig.width,\n   178→            height: formatConfig.height,\n   179→            aspectRatio: formatConfig.aspectRatio,\n   180→          }}\n   181→        >\n   182→          {/* Breaking News Banner (for urgent content) */}\n   183→          {isUrgent && (\n   184→            <div\n   185→              className=\"absolute top-0 left-0 right-0 z-20 overflow-hidden\"\n   186→              style={{ opacity: frame < 30 ? spring({ frame, fps, delay: 5, durationFrames: 15, easing: easeOutCubic }) : 1 }}\n   187→            >\n   188→              <div className={`py-1 text-center text-[10px] font-bold uppercase tracking-wider ${\n   189→                isRadar ? 'bg-red-600 text-white' : 'bg-red-600 text-white'\n   190→              }`}>\n   191→                <span className=\"animate-pulse mr-2\">●</span>\n   192→                Breaking Analysis\n   193→                <span className=\"animate-pulse ml-2\">●</span>\n   194→              </div>\n   195→            </div>\n   196→          )}\n   197→\n   198→          {/* Ambient background */}\n   199→          <div\n   200→            className={`absolute inset-0 pointer-events-none ${isRadar ? 'bg-gradient-to-br from-cyan-950/20 via-transparent to-blue-950/20' : 'bg-gradient-to-br from-stone-200/30 via-transparent to-stone-300/30'}`}\n   201→            style={{ opacity: 0.5 + ambientPulse * 0.2 }}\n   202→          />\n   203→\n   204→          {/* Noise texture */}\n   205→          <div\n   206→            className=\"absolute inset-0 pointer-events-none opacity-[0.02]\"\n   207→            style={{\n   208→              backgroundImage: 'url(\"data:image/svg+xml,%3Csvg viewBox=\\'0 0 256 256\\' xmlns=\\'http://www.w3.org/2000/svg\\'%3E%3Cfilter id=\\'noise\\'%3E%3CfeTurbulence type=\\'fractalNoise\\' baseFrequency=\\'0.65\\' numOctaves=\\'3\\' stitchTiles=\\'stitch\\'/%3E%3C/filter%3E%3Crect width=\\'100%25\\' height=\\'100%25\\' filter=\\'url(%23noise)\\'/%3E%3C/svg%3E\")',\n   209→            }}\n   210→          />\n   211→\n   212→          {/* Scene container */}\n   213→          <div className=\"absolute inset-0\">\n   214→            {/* Title Scene */}\n   215→            <div className=\"absolute inset-0\" style={{ opacity: getSceneOpacity(0, 65) }}>\n   216→              <TitleScene\n   217→                frame={frame}\n   218→                fps={fps}\n   219→                isRadar={isRadar}\n   220→                format={format}\n   221→                title={session.query?.slice(0, format === 'mobile' ? 40 : 55) || 'Research Report'}\n   222→                subtitle={session.template_type?.replace(/_/g, ' ').toUpperCase() || 'ANALYSIS'}\n   223→                date={new Date(session.created_at || Date.now()).toLocaleDateString()}\n   224→              />\n   225→            </div>\n   226→\n   227→            {/* Metrics Scene */}\n   228→            <div className=\"absolute inset-0\" style={{ opacity: getSceneOpacity(50, 140) }}>\n   229→              <MetricsScene frame={frame - 50} fps={fps} isRadar={isRadar} format={format} metrics={metrics} />\n   230→            </div>\n   231→\n   232→            {/* Charts Scene */}\n   233→            <div className=\"absolute inset-0\" style={{ opacity: getSceneOpacity(125, 255) }}>\n   234→              <ChartsScene frame={frame - 125} fps={fps} isRadar={isRadar} format={format} {...chartData} />\n   235→            </div>\n   236→\n   237→            {/* Insights Scene */}\n   238→            <div className=\"absolute inset-0\" style={{ opacity: getSceneOpacity(240, 360) }}>\n   239→              <InsightsScene frame={frame - 240} fps={fps} isRadar={isRadar} format={format} {...contentData} />\n   240→            </div>\n   241→\n   242→            {/* Summary Scene */}\n   243→            <div className=\"absolute inset-0\" style={{ opacity: getSceneOpacity(345, 450) }}>\n   244→              <SummaryScene\n   245→                frame={frame - 345}\n   246→                fps={fps}\n   247→                isRadar={isRadar}\n   248→                format={format}\n   249→                confidence={stats.avgConfidence}\n   250→                findings={stats.findings}\n   251→                sources={stats.sources}\n   252→              />\n   253→            </div>\n   254→          </div>\n   255→\n   256→          {/* Progress bar */}\n   257→          <div className={`absolute top-0 left-0 right-0 h-1 ${isUrgent ? '' : ''} ${isRadar ? 'bg-slate-900' : 'bg-stone-300'}`} style={{ top: isUrgent ? 20 : 0 }}>\n   258→            <div\n   259→              className={`h-full ${isRadar ? 'bg-gradient-to-r from-cyan-500 to-blue-500' : 'bg-gradient-to-r from-stone-600 to-stone-500'}`}\n   260→              style={{ width: `${playback.progress * 100}%`, transition: 'width 33ms linear' }}\n   261→            />\n   262→            <div\n   263→              className={`absolute top-0 h-1 blur-sm ${isRadar ? 'bg-cyan-400' : 'bg-stone-500'}`}\n   264→              style={{ width: `${playback.progress * 100}%`, opacity: 0.5 }}\n   265→            />\n   266→          </div>\n   267→\n   268→          {/* News Ticker - Bottom crawl for standard format */}\n   269→          {format === 'standard' && frame > 30 && (\n   270→            <div\n   271→              className={`absolute left-0 right-0 overflow-hidden ${isRadar ? 'bg-slate-900/90' : 'bg-stone-800/90'}`}\n   272→              style={{\n   273→                bottom: 52,\n   274→                opacity: spring({ frame: frame - 30, fps, delay: 0, durationFrames: 15, easing: easeOutCubic }),\n   275→              }}\n   276→            >\n   277→              <div className=\"flex items-center h-6\">\n   278→                <div className={`px-2 py-1 text-[9px] font-bold uppercase ${isRadar ? 'bg-red-600 text-white' : 'bg-red-600 text-white'}`}>\n   279→                  Live\n   280→                </div>\n   281→                <div className=\"flex-1 overflow-hidden\">\n   282→                  <div\n   283→                    className={`whitespace-nowrap text-[10px] font-medium ${isRadar ? 'text-cyan-300' : 'text-white'}`}\n   284→                    style={{ transform: `translateX(${300 - tickerOffset % 600}px)` }}\n   285→                  >\n   286→                    {tickerText} • {tickerText}\n   287→                  </div>\n   288→                </div>\n   289→              </div>\n   290→            </div>\n   291→          )}\n   292→\n   293→          {/* Watermark */}\n   294→          <div\n   295→            className={`absolute ${format === 'mobile' ? 'top-6 right-2' : 'top-2 right-3'} flex items-center gap-1 px-2 py-0.5 rounded ${isRadar ? 'bg-slate-900/60' : 'bg-white/60'}`}\n   296→            style={{ opacity: frame > 15 ? 0.7 : 0 }}\n   297→          >\n   298→            <div className={`w-1.5 h-1.5 rounded-full ${isRadar ? 'bg-cyan-400' : 'bg-stone-600'}`} />\n   299→            <span className={`text-[8px] font-bold tracking-wider uppercase ${isRadar ? 'text-cyan-400' : 'text-stone-600'}`}>\n   300→              Research\n   301→            </span>\n   302→          </div>\n   303→\n   304→          {/* Controls */}\n   305→          <VideoControls playback={playback} isRadar={isRadar} format={format} />\n   306→        </div>\n   307→      </div>\n   308→    </div>\n   309→  );\n   310→}\n   311→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"05d3e4f1-2259-4f3e-a055-8040a34c8b02","uuid":"43c54b8a-1fc7-43c3-a72b-9ea68491f71e","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\video\\VideoOverview.tsx","content":"'use client';\n\nimport { useMemo, useState } from 'react';\nimport type { SessionWithDetails } from '@/src/types/research';\nimport { useReportTheme } from '../core/ThemeContext';\nimport { useVideoPlayback, spring, easeOutCubic } from './useVideoPlayback';\nimport { TitleScene, MetricsScene, ChartsScene, InsightsScene, SummaryScene } from './Scenes';\nimport { VideoControls } from './VideoControls';\n\n// Video format types\nexport type VideoFormat = 'standard' | 'mobile';\n\ninterface VideoOverviewProps {\n  session: SessionWithDetails;\n  stats: {\n    findings: number;\n    sources: number;\n    perspectives: number;\n    avgConfidence: number;\n    highConfidence: number;\n    redFlags: number;\n    gaps: number;\n  };\n}\n\n// Format configurations\nconst FORMAT_CONFIG = {\n  standard: {\n    width: 640,\n    height: 360,\n    aspectRatio: '16/9',\n    label: 'YouTube',\n    icon: '📺',\n  },\n  mobile: {\n    width: 270,\n    height: 480,\n    aspectRatio: '9/16',\n    label: 'Shorts',\n    icon: '📱',\n  },\n};\n\n// Scene timeline (in frames at 30fps) - Optimized for viral content\nconst SCENE_CONFIG = {\n  fps: 30,\n  scenes: [\n    { name: 'Title', start: 0, end: 65 },       // 0-2.2s - Hook immediately\n    { name: 'Metrics', start: 50, end: 140 },   // 1.7-4.7s - Key numbers\n    { name: 'Charts', start: 125, end: 255 },   // 4.2-8.5s - Data visualization\n    { name: 'Insights', start: 240, end: 360 }, // 8-12s - Value delivery\n    { name: 'Summary', start: 345, end: 450 },  // 11.5-15s - Memorable close\n  ],\n  totalFrames: 450, // 15 seconds\n};\n\nexport function VideoOverview({ session, stats }: VideoOverviewProps) {\n  const { theme } = useReportTheme();\n  const isRadar = theme === 'radar';\n  const [format, setFormat] = useState<VideoFormat>('standard');\n  const playback = useVideoPlayback({ fps: SCENE_CONFIG.fps, durationInFrames: SCENE_CONFIG.totalFrames });\n  const { frame } = playback;\n  const fps = SCENE_CONFIG.fps;\n  const formatConfig = FORMAT_CONFIG[format];\n\n  // Prepare chart data (memoized)\n  const chartData = useMemo(() => {\n    const findingCounts: Record<string, number> = {};\n    session.findings?.forEach(f => { findingCounts[f.finding_type] = (findingCounts[f.finding_type] || 0) + 1; });\n\n    const sourceCounts: Record<string, number> = {};\n    session.sources?.forEach(s => { sourceCounts[s.source_type || 'web'] = (sourceCounts[s.source_type || 'web'] || 0) + 1; });\n    const pieColors = ['#ef4444', '#f59e0b', '#22d3ee', '#a78bfa', '#34d399'];\n\n    return {\n      barData: Object.entries(findingCounts).slice(0, 5).map(([label, value]) => ({ label: label.slice(0, 4), value })),\n      lineData: session.findings?.slice(0, 10).map(f => (f.confidence_score || 0.5) * 100) || [50],\n      pieData: Object.entries(sourceCounts).slice(0, 4).map(([label, value], i) => ({ label, value, color: pieColors[i] })),\n    };\n  }, [session.findings, session.sources]);\n\n  // Extract insights\n  const contentData = useMemo(() => {\n    const insights: string[] = [];\n    const warnings: string[] = [];\n    session.perspectives?.forEach(p => {\n      p.key_insights?.slice(0, 2).forEach(i => insights.push(i));\n      p.warnings?.slice(0, 1).forEach(w => warnings.push(w));\n    });\n    return { insights: insights.slice(0, 3), warnings: warnings.slice(0, 2) };\n  }, [session.perspectives]);\n\n  const metrics = [\n    { label: 'Findings', value: stats.findings, color: 'cyan' },\n    { label: 'Sources', value: stats.sources, color: 'emerald' },\n    { label: 'Confidence', value: stats.avgConfidence, suffix: '%', color: 'amber' },\n    { label: 'Alerts', value: stats.redFlags + stats.gaps, color: 'rose' },\n  ];\n\n  // Calculate scene visibilities with smooth crossfade\n  const getSceneOpacity = (sceneStart: number, sceneEnd: number, fadeFrames: number = 16) => {\n    if (frame < sceneStart) return 0;\n    if (frame > sceneEnd) return 0;\n\n    const fadeInEnd = sceneStart + fadeFrames;\n    if (frame < fadeInEnd) {\n      return spring({ frame: frame - sceneStart, fps, delay: 0, durationFrames: fadeFrames, easing: easeOutCubic });\n    }\n\n    const fadeOutStart = sceneEnd - fadeFrames;\n    if (frame > fadeOutStart) {\n      return 1 - spring({ frame: frame - fadeOutStart, fps, delay: 0, durationFrames: fadeFrames, easing: easeOutCubic });\n    }\n\n    return 1;\n  };\n\n  // Ambient animation\n  const ambientPulse = Math.sin((frame / fps) * Math.PI * 0.3) * 0.5 + 0.5;\n\n  // Determine template category for news style\n  const templateType = session.template_type || 'analysis';\n  const isUrgent = ['investigative', 'due_diligence', 'legal'].includes(templateType);\n\n  // News ticker text based on template type\n  const tickerText = useMemo(() => {\n    const base = session.query?.slice(0, 40) || 'Analysis Report';\n    const extras = [\n      `${stats.findings} findings verified`,\n      `${stats.sources} sources analyzed`,\n      `${stats.avgConfidence}% confidence`,\n      stats.redFlags > 0 ? `${stats.redFlags} red flags detected` : null,\n    ].filter(Boolean);\n    return `${base} • ${extras.join(' • ')}`;\n  }, [session.query, stats]);\n\n  // Ticker animation\n  const tickerOffset = (frame / fps) * 50; // pixels per second\n\n  return (\n    <div className=\"space-y-4\">\n      {/* Format Selector */}\n      <div className=\"flex items-center justify-between\">\n        <div className=\"flex items-center gap-2\">\n          {(Object.keys(FORMAT_CONFIG) as VideoFormat[]).map((f) => (\n            <button\n              key={f}\n              onClick={() => setFormat(f)}\n              className={`px-3 py-1.5 rounded-lg text-sm font-medium transition-all flex items-center gap-1.5 ${\n                format === f\n                  ? isRadar\n                    ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/40'\n                    : 'bg-stone-800 text-white'\n                  : isRadar\n                    ? 'text-slate-400 hover:text-white hover:bg-slate-800'\n                    : 'text-stone-500 hover:text-stone-900 hover:bg-stone-200'\n              }`}\n            >\n              <span>{FORMAT_CONFIG[f].icon}</span>\n              <span>{FORMAT_CONFIG[f].label}</span>\n            </button>\n          ))}\n        </div>\n        <div className={`text-xs ${isRadar ? 'text-slate-500' : 'text-stone-400'}`}>\n          {formatConfig.width}×{formatConfig.height}\n        </div>\n      </div>\n\n      {/* Video Container */}\n      <div\n        className=\"flex justify-center\"\n        style={{ minHeight: format === 'mobile' ? 520 : 400 }}\n      >\n        <div\n          className={`relative overflow-hidden ${isRadar ? 'bg-slate-950' : 'bg-stone-100'} ${format === 'standard' ? 'rounded-2xl' : 'rounded-3xl'}`}\n          style={{\n            width: formatConfig.width,\n            height: formatConfig.height,\n            aspectRatio: formatConfig.aspectRatio,\n          }}\n        >\n          {/* Breaking News Banner (for urgent content) */}\n          {isUrgent && (\n            <div\n              className=\"absolute top-0 left-0 right-0 z-20 overflow-hidden\"\n              style={{ opacity: frame < 30 ? spring({ frame, fps, delay: 5, durationFrames: 15, easing: easeOutCubic }) : 1 }}\n            >\n              <div className={`py-1 text-center text-[10px] font-bold uppercase tracking-wider ${\n                isRadar ? 'bg-red-600 text-white' : 'bg-red-600 text-white'\n              }`}>\n                <span className=\"animate-pulse mr-2\">●</span>\n                Breaking Analysis\n                <span className=\"animate-pulse ml-2\">●</span>\n              </div>\n            </div>\n          )}\n\n          {/* Ambient background */}\n          <div\n            className={`absolute inset-0 pointer-events-none ${isRadar ? 'bg-gradient-to-br from-cyan-950/20 via-transparent to-blue-950/20' : 'bg-gradient-to-br from-stone-200/30 via-transparent to-stone-300/30'}`}\n            style={{ opacity: 0.5 + ambientPulse * 0.2 }}\n          />\n\n          {/* Noise texture */}\n          <div\n            className=\"absolute inset-0 pointer-events-none opacity-[0.02]\"\n            style={{\n              backgroundImage: 'url(\"data:image/svg+xml,%3Csvg viewBox=\\'0 0 256 256\\' xmlns=\\'http://www.w3.org/2000/svg\\'%3E%3Cfilter id=\\'noise\\'%3E%3CfeTurbulence type=\\'fractalNoise\\' baseFrequency=\\'0.65\\' numOctaves=\\'3\\' stitchTiles=\\'stitch\\'/%3E%3C/filter%3E%3Crect width=\\'100%25\\' height=\\'100%25\\' filter=\\'url(%23noise)\\'/%3E%3C/svg%3E\")',\n            }}\n          />\n\n          {/* Scene container */}\n          <div className=\"absolute inset-0\">\n            {/* Title Scene */}\n            <div className=\"absolute inset-0\" style={{ opacity: getSceneOpacity(0, 65) }}>\n              <TitleScene\n                frame={frame}\n                fps={fps}\n                isRadar={isRadar}\n                format={format}\n                title={session.query?.slice(0, format === 'mobile' ? 40 : 55) || 'Research Report'}\n                subtitle={session.template_type?.replace(/_/g, ' ').toUpperCase() || 'ANALYSIS'}\n                date={new Date(session.created_at || Date.now()).toLocaleDateString()}\n              />\n            </div>\n\n            {/* Metrics Scene */}\n            <div className=\"absolute inset-0\" style={{ opacity: getSceneOpacity(50, 140) }}>\n              <MetricsScene frame={frame - 50} fps={fps} isRadar={isRadar} format={format} metrics={metrics} />\n            </div>\n\n            {/* Charts Scene */}\n            <div className=\"absolute inset-0\" style={{ opacity: getSceneOpacity(125, 255) }}>\n              <ChartsScene frame={frame - 125} fps={fps} isRadar={isRadar} format={format} {...chartData} />\n            </div>\n\n            {/* Insights Scene */}\n            <div className=\"absolute inset-0\" style={{ opacity: getSceneOpacity(240, 360) }}>\n              <InsightsScene frame={frame - 240} fps={fps} isRadar={isRadar} format={format} {...contentData} />\n            </div>\n\n            {/* Summary Scene */}\n            <div className=\"absolute inset-0\" style={{ opacity: getSceneOpacity(345, 450) }}>\n              <SummaryScene\n                frame={frame - 345}\n                fps={fps}\n                isRadar={isRadar}\n                format={format}\n                confidence={stats.avgConfidence}\n                findings={stats.findings}\n                sources={stats.sources}\n              />\n            </div>\n          </div>\n\n          {/* Progress bar */}\n          <div className={`absolute top-0 left-0 right-0 h-1 ${isUrgent ? '' : ''} ${isRadar ? 'bg-slate-900' : 'bg-stone-300'}`} style={{ top: isUrgent ? 20 : 0 }}>\n            <div\n              className={`h-full ${isRadar ? 'bg-gradient-to-r from-cyan-500 to-blue-500' : 'bg-gradient-to-r from-stone-600 to-stone-500'}`}\n              style={{ width: `${playback.progress * 100}%`, transition: 'width 33ms linear' }}\n            />\n            <div\n              className={`absolute top-0 h-1 blur-sm ${isRadar ? 'bg-cyan-400' : 'bg-stone-500'}`}\n              style={{ width: `${playback.progress * 100}%`, opacity: 0.5 }}\n            />\n          </div>\n\n          {/* News Ticker - Bottom crawl for standard format */}\n          {format === 'standard' && frame > 30 && (\n            <div\n              className={`absolute left-0 right-0 overflow-hidden ${isRadar ? 'bg-slate-900/90' : 'bg-stone-800/90'}`}\n              style={{\n                bottom: 52,\n                opacity: spring({ frame: frame - 30, fps, delay: 0, durationFrames: 15, easing: easeOutCubic }),\n              }}\n            >\n              <div className=\"flex items-center h-6\">\n                <div className={`px-2 py-1 text-[9px] font-bold uppercase ${isRadar ? 'bg-red-600 text-white' : 'bg-red-600 text-white'}`}>\n                  Live\n                </div>\n                <div className=\"flex-1 overflow-hidden\">\n                  <div\n                    className={`whitespace-nowrap text-[10px] font-medium ${isRadar ? 'text-cyan-300' : 'text-white'}`}\n                    style={{ transform: `translateX(${300 - tickerOffset % 600}px)` }}\n                  >\n                    {tickerText} • {tickerText}\n                  </div>\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* Watermark */}\n          <div\n            className={`absolute ${format === 'mobile' ? 'top-6 right-2' : 'top-2 right-3'} flex items-center gap-1 px-2 py-0.5 rounded ${isRadar ? 'bg-slate-900/60' : 'bg-white/60'}`}\n            style={{ opacity: frame > 15 ? 0.7 : 0 }}\n          >\n            <div className={`w-1.5 h-1.5 rounded-full ${isRadar ? 'bg-cyan-400' : 'bg-stone-600'}`} />\n            <span className={`text-[8px] font-bold tracking-wider uppercase ${isRadar ? 'text-cyan-400' : 'text-stone-600'}`}>\n              Research\n            </span>\n          </div>\n\n          {/* Controls */}\n          <VideoControls playback={playback} isRadar={isRadar} format={format} />\n        </div>\n      </div>\n    </div>\n  );\n}\n","numLines":311,"startLine":1,"totalLines":311}}}
