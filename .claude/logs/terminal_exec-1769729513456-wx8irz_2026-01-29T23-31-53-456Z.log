[2026-01-29T23:53:21.627Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YMk3UhVrSZd3fWHWFknzvD","type":"tool_result","content":"     1→'use client';\n     2→\n     3→import { useEffect, useRef, useState } from 'react';\n     4→import { motion } from 'framer-motion';\n     5→import { useReportTheme } from '../core/ThemeContext';\n     6→\n     7→interface Node {\n     8→  id: string;\n     9→  label: string;\n    10→  type: 'finding' | 'source' | 'entity' | 'perspective';\n    11→  value: number; // 0-1 for sizing\n    12→  x?: number;\n    13→  y?: number;\n    14→}\n    15→\n    16→interface Edge {\n    17→  source: string;\n    18→  target: string;\n    19→  strength: number; // 0-1\n    20→  type?: 'supports' | 'contradicts' | 'references';\n    21→}\n    22→\n    23→interface NetworkGraphProps {\n    24→  nodes: Node[];\n    25→  edges: Edge[];\n    26→  onNodeClick?: (nodeId: string) => void;\n    27→  highlightedNode?: string;\n    28→}\n    29→\n    30→const typeColors = {\n    31→  finding: { radar: '#22d3ee', swiss: '#0ea5e9' },\n    32→  source: { radar: '#a78bfa', swiss: '#7c3aed' },\n    33→  entity: { radar: '#fb7185', swiss: '#e11d48' },\n    34→  perspective: { radar: '#34d399', swiss: '#059669' },\n    35→};\n    36→\n    37→export function NetworkGraph({ nodes, edges, onNodeClick, highlightedNode }: NetworkGraphProps) {\n    38→  const { theme } = useReportTheme();\n    39→  const containerRef = useRef<HTMLDivElement>(null);\n    40→  const [positions, setPositions] = useState<Map<string, { x: number; y: number }>>(new Map());\n    41→  const [hoveredNode, setHoveredNode] = useState<string | null>(null);\n    42→\n    43→  // Force-directed layout simulation\n    44→  useEffect(() => {\n    45→    if (!containerRef.current || nodes.length === 0) return;\n    46→\n    47→    const width = containerRef.current.offsetWidth;\n    48→    const height = containerRef.current.offsetHeight;\n    49→    const centerX = width / 2;\n    50→    const centerY = height / 2;\n    51→\n    52→    // Initialize positions in a circle\n    53→    const newPositions = new Map<string, { x: number; y: number }>();\n    54→    nodes.forEach((node, i) => {\n    55→      const angle = (i / nodes.length) * Math.PI * 2;\n    56→      const radius = Math.min(width, height) * 0.35;\n    57→      newPositions.set(node.id, {\n    58→        x: centerX + Math.cos(angle) * radius,\n    59→        y: centerY + Math.sin(angle) * radius,\n    60→      });\n    61→    });\n    62→\n    63→    // Simple force simulation\n    64→    const iterations = 50;\n    65→    for (let iter = 0; iter < iterations; iter++) {\n    66→      // Repulsion between all nodes\n    67→      nodes.forEach((nodeA) => {\n    68→        nodes.forEach((nodeB) => {\n    69→          if (nodeA.id === nodeB.id) return;\n    70→          const posA = newPositions.get(nodeA.id)!;\n    71→          const posB = newPositions.get(nodeB.id)!;\n    72→          const dx = posA.x - posB.x;\n    73→          const dy = posA.y - posB.y;\n    74→          const dist = Math.sqrt(dx * dx + dy * dy) || 1;\n    75→          const force = 1000 / (dist * dist);\n    76→          posA.x += (dx / dist) * force * 0.1;\n    77→          posA.y += (dy / dist) * force * 0.1;\n    78→        });\n    79→      });\n    80→\n    81→      // Attraction along edges\n    82→      edges.forEach((edge) => {\n    83→        const posA = newPositions.get(edge.source);\n    84→        const posB = newPositions.get(edge.target);\n    85→        if (!posA || !posB) return;\n    86→        const dx = posB.x - posA.x;\n    87→        const dy = posB.y - posA.y;\n    88→        const dist = Math.sqrt(dx * dx + dy * dy) || 1;\n    89→        const force = dist * 0.01 * edge.strength;\n    90→        posA.x += (dx / dist) * force;\n    91→        posA.y += (dy / dist) * force;\n    92→        posB.x -= (dx / dist) * force;\n    93→        posB.y -= (dy / dist) * force;\n    94→      });\n    95→\n    96→      // Keep in bounds\n    97→      nodes.forEach((node) => {\n    98→        const pos = newPositions.get(node.id)!;\n    99→        pos.x = Math.max(40, Math.min(width - 40, pos.x));\n   100→        pos.y = Math.max(40, Math.min(height - 40, pos.y));\n   101→      });\n   102→    }\n   103→\n   104→    setPositions(newPositions);\n   105→  }, [nodes, edges]);\n   106→\n   107→  const isRadar = theme === 'radar';\n   108→\n   109→  return (\n   110→    <div\n   111→      ref={containerRef}\n   112→      className={`relative w-full h-64 rounded-xl overflow-hidden ${isRadar ? 'bg-slate-950' : 'bg-stone-100'}`}\n   113→    >\n   114→      {/* Grid pattern */}\n   115→      <svg className=\"absolute inset-0 w-full h-full opacity-10\">\n   116→        <defs>\n   117→          <pattern id=\"grid\" width=\"20\" height=\"20\" patternUnits=\"userSpaceOnUse\">\n   118→            <path d=\"M 20 0 L 0 0 0 20\" fill=\"none\" stroke={isRadar ? '#22d3ee' : '#78716c'} strokeWidth=\"0.5\" />\n   119→          </pattern>\n   120→        </defs>\n   121→        <rect width=\"100%\" height=\"100%\" fill=\"url(#grid)\" />\n   122→      </svg>\n   123→\n   124→      {/* Edges */}\n   125→      <svg className=\"absolute inset-0 w-full h-full\">\n   126→        {edges.map((edge, i) => {\n   127→          const from = positions.get(edge.source);\n   128→          const to = positions.get(edge.target);\n   129→          if (!from || !to) return null;\n   130→          const isHighlighted = hoveredNode === edge.source || hoveredNode === edge.target;\n   131→          return (\n   132→            <motion.line\n   133→              key={i}\n   134→              initial={{ pathLength: 0, opacity: 0 }}\n   135→              animate={{ pathLength: 1, opacity: isHighlighted ? 0.8 : 0.3 }}\n   136→              transition={{ duration: 0.5, delay: i * 0.02 }}\n   137→              x1={from.x}\n   138→              y1={from.y}\n   139→              x2={to.x}\n   140→              y2={to.y}\n   141→              stroke={edge.type === 'contradicts' ? '#f87171' : isRadar ? '#22d3ee' : '#78716c'}\n   142→              strokeWidth={isHighlighted ? 2 : 1}\n   143→              strokeDasharray={edge.type === 'contradicts' ? '4,4' : undefined}\n   144→            />\n   145→          );\n   146→        })}\n   147→      </svg>\n   148→\n   149→      {/* Nodes */}\n   150→      {nodes.map((node, i) => {\n   151→        const pos = positions.get(node.id);\n   152→        if (!pos) return null;\n   153→        const color = typeColors[node.type][theme];\n   154→        const size = 12 + node.value * 20;\n   155→        const isHovered = hoveredNode === node.id;\n   156→        const isHighlightedNode = highlightedNode === node.id;\n   157→\n   158→        return (\n   159→          <motion.div\n   160→            key={node.id}\n   161→            initial={{ scale: 0, opacity: 0 }}\n   162→            animate={{\n   163→              scale: isHovered || isHighlightedNode ? 1.3 : 1,\n   164→              opacity: 1,\n   165→              x: pos.x - size / 2,\n   166→              y: pos.y - size / 2,\n   167→            }}\n   168→            transition={{ type: 'spring', damping: 20, delay: i * 0.03 }}\n   169→            className=\"absolute cursor-pointer\"\n   170→            style={{ width: size, height: size }}\n   171→            onMouseEnter={() => setHoveredNode(node.id)}\n   172→            onMouseLeave={() => setHoveredNode(null)}\n   173→            onClick={() => onNodeClick?.(node.id)}\n   174→          >\n   175→            <div\n   176→              className=\"w-full h-full rounded-full flex items-center justify-center transition-shadow\"\n   177→              style={{\n   178→                backgroundColor: color,\n   179→                boxShadow: isHovered || isHighlightedNode ? `0 0 20px ${color}` : `0 0 8px ${color}50`,\n   180→              }}\n   181→            >\n   182→              {isHovered && (\n   183→                <motion.div\n   184→                  initial={{ opacity: 0, y: 10 }}\n   185→                  animate={{ opacity: 1, y: 0 }}\n   186→                  className={`absolute -bottom-8 left-1/2 -translate-x-1/2 whitespace-nowrap px-2 py-1 rounded text-[10px] font-medium ${isRadar ? 'bg-slate-800 text-white' : 'bg-white text-stone-800 shadow-lg'}`}\n   187→                >\n   188→                  {node.label}\n   189→                </motion.div>\n   190→              )}\n   191→            </div>\n   192→          </motion.div>\n   193→        );\n   194→      })}\n   195→    </div>\n   196→  );\n   197→}\n   198→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"05d3e4f1-2259-4f3e-a055-8040a34c8b02","uuid":"687355c8-e278-4848-bf0d-82339933dda0","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\visualizations\\NetworkGraph.tsx","content":"'use client';\n\nimport { useEffect, useRef, useState } from 'react';\nimport { motion } from 'framer-motion';\nimport { useReportTheme } from '../core/ThemeContext';\n\ninterface Node {\n  id: string;\n  label: string;\n  type: 'finding' | 'source' | 'entity' | 'perspective';\n  value: number; // 0-1 for sizing\n  x?: number;\n  y?: number;\n}\n\ninterface Edge {\n  source: string;\n  target: string;\n  strength: number; // 0-1\n  type?: 'supports' | 'contradicts' | 'references';\n}\n\ninterface NetworkGraphProps {\n  nodes: Node[];\n  edges: Edge[];\n  onNodeClick?: (nodeId: string) => void;\n  highlightedNode?: string;\n}\n\nconst typeColors = {\n  finding: { radar: '#22d3ee', swiss: '#0ea5e9' },\n  source: { radar: '#a78bfa', swiss: '#7c3aed' },\n  entity: { radar: '#fb7185', swiss: '#e11d48' },\n  perspective: { radar: '#34d399', swiss: '#059669' },\n};\n\nexport function NetworkGraph({ nodes, edges, onNodeClick, highlightedNode }: NetworkGraphProps) {\n  const { theme } = useReportTheme();\n  const containerRef = useRef<HTMLDivElement>(null);\n  const [positions, setPositions] = useState<Map<string, { x: number; y: number }>>(new Map());\n  const [hoveredNode, setHoveredNode] = useState<string | null>(null);\n\n  // Force-directed layout simulation\n  useEffect(() => {\n    if (!containerRef.current || nodes.length === 0) return;\n\n    const width = containerRef.current.offsetWidth;\n    const height = containerRef.current.offsetHeight;\n    const centerX = width / 2;\n    const centerY = height / 2;\n\n    // Initialize positions in a circle\n    const newPositions = new Map<string, { x: number; y: number }>();\n    nodes.forEach((node, i) => {\n      const angle = (i / nodes.length) * Math.PI * 2;\n      const radius = Math.min(width, height) * 0.35;\n      newPositions.set(node.id, {\n        x: centerX + Math.cos(angle) * radius,\n        y: centerY + Math.sin(angle) * radius,\n      });\n    });\n\n    // Simple force simulation\n    const iterations = 50;\n    for (let iter = 0; iter < iterations; iter++) {\n      // Repulsion between all nodes\n      nodes.forEach((nodeA) => {\n        nodes.forEach((nodeB) => {\n          if (nodeA.id === nodeB.id) return;\n          const posA = newPositions.get(nodeA.id)!;\n          const posB = newPositions.get(nodeB.id)!;\n          const dx = posA.x - posB.x;\n          const dy = posA.y - posB.y;\n          const dist = Math.sqrt(dx * dx + dy * dy) || 1;\n          const force = 1000 / (dist * dist);\n          posA.x += (dx / dist) * force * 0.1;\n          posA.y += (dy / dist) * force * 0.1;\n        });\n      });\n\n      // Attraction along edges\n      edges.forEach((edge) => {\n        const posA = newPositions.get(edge.source);\n        const posB = newPositions.get(edge.target);\n        if (!posA || !posB) return;\n        const dx = posB.x - posA.x;\n        const dy = posB.y - posA.y;\n        const dist = Math.sqrt(dx * dx + dy * dy) || 1;\n        const force = dist * 0.01 * edge.strength;\n        posA.x += (dx / dist) * force;\n        posA.y += (dy / dist) * force;\n        posB.x -= (dx / dist) * force;\n        posB.y -= (dy / dist) * force;\n      });\n\n      // Keep in bounds\n      nodes.forEach((node) => {\n        const pos = newPositions.get(node.id)!;\n        pos.x = Math.max(40, Math.min(width - 40, pos.x));\n        pos.y = Math.max(40, Math.min(height - 40, pos.y));\n      });\n    }\n\n    setPositions(newPositions);\n  }, [nodes, edges]);\n\n  const isRadar = theme === 'radar';\n\n  return (\n    <div\n      ref={containerRef}\n      className={`relative w-full h-64 rounded-xl overflow-hidden ${isRadar ? 'bg-slate-950' : 'bg-stone-100'}`}\n    >\n      {/* Grid pattern */}\n      <svg className=\"absolute inset-0 w-full h-full opacity-10\">\n        <defs>\n          <pattern id=\"grid\" width=\"20\" height=\"20\" patternUnits=\"userSpaceOnUse\">\n            <path d=\"M 20 0 L 0 0 0 20\" fill=\"none\" stroke={isRadar ? '#22d3ee' : '#78716c'} strokeWidth=\"0.5\" />\n          </pattern>\n        </defs>\n        <rect width=\"100%\" height=\"100%\" fill=\"url(#grid)\" />\n      </svg>\n\n      {/* Edges */}\n      <svg className=\"absolute inset-0 w-full h-full\">\n        {edges.map((edge, i) => {\n          const from = positions.get(edge.source);\n          const to = positions.get(edge.target);\n          if (!from || !to) return null;\n          const isHighlighted = hoveredNode === edge.source || hoveredNode === edge.target;\n          return (\n            <motion.line\n              key={i}\n              initial={{ pathLength: 0, opacity: 0 }}\n              animate={{ pathLength: 1, opacity: isHighlighted ? 0.8 : 0.3 }}\n              transition={{ duration: 0.5, delay: i * 0.02 }}\n              x1={from.x}\n              y1={from.y}\n              x2={to.x}\n              y2={to.y}\n              stroke={edge.type === 'contradicts' ? '#f87171' : isRadar ? '#22d3ee' : '#78716c'}\n              strokeWidth={isHighlighted ? 2 : 1}\n              strokeDasharray={edge.type === 'contradicts' ? '4,4' : undefined}\n            />\n          );\n        })}\n      </svg>\n\n      {/* Nodes */}\n      {nodes.map((node, i) => {\n        const pos = positions.get(node.id);\n        if (!pos) return null;\n        const color = typeColors[node.type][theme];\n        const size = 12 + node.value * 20;\n        const isHovered = hoveredNode === node.id;\n        const isHighlightedNode = highlightedNode === node.id;\n\n        return (\n          <motion.div\n            key={node.id}\n            initial={{ scale: 0, opacity: 0 }}\n            animate={{\n              scale: isHovered || isHighlightedNode ? 1.3 : 1,\n              opacity: 1,\n              x: pos.x - size / 2,\n              y: pos.y - size / 2,\n            }}\n            transition={{ type: 'spring', damping: 20, delay: i * 0.03 }}\n            className=\"absolute cursor-pointer\"\n            style={{ width: size, height: size }}\n            onMouseEnter={() => setHoveredNode(node.id)}\n            onMouseLeave={() => setHoveredNode(null)}\n            onClick={() => onNodeClick?.(node.id)}\n          >\n            <div\n              className=\"w-full h-full rounded-full flex items-center justify-center transition-shadow\"\n              style={{\n                backgroundColor: color,\n                boxShadow: isHovered || isHighlightedNode ? `0 0 20px ${color}` : `0 0 8px ${color}50`,\n              }}\n            >\n              {isHovered && (\n                <motion.div\n                  initial={{ opacity: 0, y: 10 }}\n                  animate={{ opacity: 1, y: 0 }}\n                  className={`absolute -bottom-8 left-1/2 -translate-x-1/2 whitespace-nowrap px-2 py-1 rounded text-[10px] font-medium ${isRadar ? 'bg-slate-800 text-white' : 'bg-white text-stone-800 shadow-lg'}`}\n                >\n                  {node.label}\n                </motion.div>\n              )}\n            </div>\n          </motion.div>\n        );\n      })}\n    </div>\n  );\n}\n","numLines":198,"startLine":1,"totalLines":198}}}
