[2026-01-29T23:36:31.769Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QuM7fJDr5mPeborRrkANT4","type":"tool_result","content":"     1→'use client';\n     2→\n     3→import { useMemo } from 'react';\n     4→import { spring, easeOutCubic, easeOutQuart } from './useVideoPlayback';\n     5→\n     6→interface BarChartProps {\n     7→  data: Array<{ label: string; value: number; color?: string }>;\n     8→  frame: number;\n     9→  fps: number;\n    10→  width?: number;\n    11→  height?: number;\n    12→  isRadar?: boolean;\n    13→}\n    14→\n    15→export function AnimatedBarChart({ data, frame, fps, width = 240, height = 140, isRadar = true }: BarChartProps) {\n    16→  const max = Math.max(...data.map(d => d.value), 1);\n    17→  const barWidth = Math.floor((width - (data.length - 1) * 10) / data.length);\n    18→\n    19→  // Pre-calculate all bar heights to avoid recalculation\n    20→  const bars = useMemo(() => {\n    21→    return data.map((item, i) => {\n    22→      const baseHeight = (item.value / max) * (height - 28);\n    23→      return {\n    24→        ...item,\n    25→        baseHeight,\n    26→        x: i * (barWidth + 10),\n    27→      };\n    28→    });\n    29→  }, [data, max, height, barWidth]);\n    30→\n    31→  // Define gradient\n    32→  const gradientId = useMemo(() => `barGrad-${Math.random().toString(36).substr(2, 9)}`, []);\n    33→\n    34→  return (\n    35→    <svg width={width} height={height} style={{ overflow: 'visible' }}>\n    36→      <defs>\n    37→        <linearGradient id={gradientId} x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n    38→          <stop offset=\"0%\" stopColor={isRadar ? '#22d3ee' : '#3b82f6'} stopOpacity=\"1\" />\n    39→          <stop offset=\"100%\" stopColor={isRadar ? '#0891b2' : '#1d4ed8'} stopOpacity=\"0.8\" />\n    40→        </linearGradient>\n    41→        <filter id=\"barGlow\" x=\"-50%\" y=\"-50%\" width=\"200%\" height=\"200%\">\n    42→          <feGaussianBlur stdDeviation=\"3\" result=\"blur\" />\n    43→          <feMerge>\n    44→            <feMergeNode in=\"blur\" />\n    45→            <feMergeNode in=\"SourceGraphic\" />\n    46→          </feMerge>\n    47→        </filter>\n    48→      </defs>\n    49→      {bars.map((bar, i) => {\n    50→        const progress = spring({ frame, fps, delay: i * 4, durationFrames: 28, easing: easeOutQuart });\n    51→        const barHeight = bar.baseHeight * progress;\n    52→\n    53→        return (\n    54→          <g key={i}>\n    55→            {/* Glow effect */}\n    56→            <rect\n    57→              x={bar.x + 2}\n    58→              y={height - 22 - barHeight}\n    59→              width={barWidth - 4}\n    60→              height={Math.max(0, barHeight)}\n    61→              fill={isRadar ? '#22d3ee' : '#3b82f6'}\n    62→              rx={4}\n    63→              opacity={0.2}\n    64→              filter=\"url(#barGlow)\"\n    65→            />\n    66→            {/* Bar */}\n    67→            <rect\n    68→              x={bar.x}\n    69→              y={height - 22 - barHeight}\n    70→              width={barWidth}\n    71→              height={Math.max(0, barHeight)}\n    72→              fill={`url(#${gradientId})`}\n    73→              rx={4}\n    74→            />\n    75→            {/* Top highlight */}\n    76→            {barHeight > 4 && (\n    77→              <rect\n    78→                x={bar.x + 2}\n    79→                y={height - 22 - barHeight + 2}\n    80→                width={barWidth - 4}\n    81→                height={3}\n    82→                fill=\"white\"\n    83→                rx={2}\n    84→                opacity={0.3}\n    85→              />\n    86→            )}\n    87→            {/* Label */}\n    88→            <text\n    89→              x={bar.x + barWidth / 2}\n    90→              y={height - 6}\n    91→              textAnchor=\"middle\"\n    92→              className={`text-[9px] font-medium ${isRadar ? 'fill-slate-400' : 'fill-stone-500'}`}\n    93→            >\n    94→              {bar.label}\n    95→            </text>\n    96→          </g>\n    97→        );\n    98→      })}\n    99→    </svg>\n   100→  );\n   101→}\n   102→\n   103→interface LineChartProps {\n   104→  data: number[];\n   105→  frame: number;\n   106→  fps: number;\n   107→  width?: number;\n   108→  height?: number;\n   109→  isRadar?: boolean;\n   110→}\n   111→\n   112→export function AnimatedLineChart({ data, frame, fps, width = 240, height = 140, isRadar = true }: LineChartProps) {\n   113→  const max = Math.max(...data, 1);\n   114→  const min = Math.min(...data, 0);\n   115→  const range = max - min || 1;\n   116→  const padding = 12;\n   117→  const chartWidth = width - padding * 2;\n   118→  const chartHeight = height - padding * 2;\n   119→\n   120→  // Pre-calculate all points\n   121→  const points = useMemo(() => {\n   122→    return data.map((v, i) => ({\n   123→      x: padding + (i / Math.max(1, data.length - 1)) * chartWidth,\n   124→      y: padding + chartHeight - ((v - min) / range) * chartHeight,\n   125→    }));\n   126→  }, [data, min, range, chartWidth, chartHeight, padding]);\n   127→\n   128→  const progress = spring({ frame, fps, delay: 0, durationFrames: 45, easing: easeOutCubic });\n   129→  const visibleCount = Math.ceil(points.length * progress);\n   130→  const visiblePoints = points.slice(0, visibleCount);\n   131→\n   132→  // Build path string\n   133→  const pathD = visiblePoints.length > 0\n   134→    ? visiblePoints.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' ')\n   135→    : '';\n   136→\n   137→  const areaD = pathD && visiblePoints.length > 1\n   138→    ? `${pathD} L ${visiblePoints[visiblePoints.length - 1].x.toFixed(1)} ${height - padding} L ${padding} ${height - padding} Z`\n   139→    : '';\n   140→\n   141→  // Gradient IDs\n   142→  const areaGradientId = useMemo(() => `areaGrad-${Math.random().toString(36).substr(2, 9)}`, []);\n   143→  const lineGradientId = useMemo(() => `lineGrad-${Math.random().toString(36).substr(2, 9)}`, []);\n   144→\n   145→  return (\n   146→    <svg width={width} height={height}>\n   147→      <defs>\n   148→        <linearGradient id={areaGradientId} x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n   149→          <stop offset=\"0%\" stopColor={isRadar ? '#22d3ee' : '#3b82f6'} stopOpacity=\"0.3\" />\n   150→          <stop offset=\"100%\" stopColor={isRadar ? '#22d3ee' : '#3b82f6'} stopOpacity=\"0.02\" />\n   151→        </linearGradient>\n   152→        <linearGradient id={lineGradientId} x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n   153→          <stop offset=\"0%\" stopColor={isRadar ? '#22d3ee' : '#3b82f6'} />\n   154→          <stop offset=\"100%\" stopColor={isRadar ? '#06b6d4' : '#2563eb'} />\n   155→        </linearGradient>\n   156→        <filter id=\"lineGlow\">\n   157→          <feGaussianBlur stdDeviation=\"2\" result=\"blur\" />\n   158→          <feMerge>\n   159→            <feMergeNode in=\"blur\" />\n   160→            <feMergeNode in=\"SourceGraphic\" />\n   161→          </feMerge>\n   162→        </filter>\n   163→      </defs>\n   164→\n   165→      {/* Grid lines with fade */}\n   166→      {[0.25, 0.5, 0.75].map((p, i) => (\n   167→        <line\n   168→          key={p}\n   169→          x1={padding}\n   170→          y1={padding + chartHeight * p}\n   171→          x2={width - padding}\n   172→          y2={padding + chartHeight * p}\n   173→          stroke={isRadar ? 'rgba(34,211,238,0.08)' : 'rgba(0,0,0,0.04)'}\n   174→          strokeDasharray=\"4 4\"\n   175→        />\n   176→      ))}\n   177→\n   178→      {/* Area fill with gradient */}\n   179→      {areaD && (\n   180→        <path d={areaD} fill={`url(#${areaGradientId})`} />\n   181→      )}\n   182→\n   183→      {/* Glow line */}\n   184→      {pathD && (\n   185→        <path\n   186→          d={pathD}\n   187→          fill=\"none\"\n   188→          stroke={isRadar ? '#22d3ee' : '#3b82f6'}\n   189→          strokeWidth={4}\n   190→          strokeLinecap=\"round\"\n   191→          strokeLinejoin=\"round\"\n   192→          opacity={0.3}\n   193→          filter=\"url(#lineGlow)\"\n   194→        />\n   195→      )}\n   196→\n   197→      {/* Main line */}\n   198→      {pathD && (\n   199→        <path\n   200→          d={pathD}\n   201→          fill=\"none\"\n   202→          stroke={`url(#${lineGradientId})`}\n   203→          strokeWidth={2.5}\n   204→          strokeLinecap=\"round\"\n   205→          strokeLinejoin=\"round\"\n   206→        />\n   207→      )}\n   208→\n   209→      {/* End point with glow */}\n   210→      {visiblePoints.length > 0 && (\n   211→        <>\n   212→          <circle\n   213→            cx={visiblePoints[visiblePoints.length - 1].x}\n   214→            cy={visiblePoints[visiblePoints.length - 1].y}\n   215→            r={8}\n   216→            fill={isRadar ? '#22d3ee' : '#3b82f6'}\n   217→            opacity={0.2}\n   218→          />\n   219→          <circle\n   220→            cx={visiblePoints[visiblePoints.length - 1].x}\n   221→            cy={visiblePoints[visiblePoints.length - 1].y}\n   222→            r={5}\n   223→            fill={isRadar ? '#0f172a' : '#fff'}\n   224→            stroke={isRadar ? '#22d3ee' : '#3b82f6'}\n   225→            strokeWidth={2.5}\n   226→          />\n   227→        </>\n   228→      )}\n   229→    </svg>\n   230→  );\n   231→}\n   232→\n   233→interface PieChartProps {\n   234→  data: Array<{ label: string; value: number; color: string }>;\n   235→  frame: number;\n   236→  fps: number;\n   237→  size?: number;\n   238→  isRadar?: boolean;\n   239→}\n   240→\n   241→export function AnimatedPieChart({ data, frame, fps, size = 120, isRadar = true }: PieChartProps) {\n   242→  const total = data.reduce((sum, d) => sum + d.value, 0) || 1;\n   243→  const progress = spring({ frame, fps, delay: 0, durationFrames: 40, easing: easeOutQuart });\n   244→\n   245→  const radius = size / 2 - 10;\n   246→  const innerRadius = radius * 0.55; // Donut style\n   247→  const cx = size / 2;\n   248→  const cy = size / 2;\n   249→\n   250→  // Pre-calculate segments\n   251→  const segments = useMemo(() => {\n   252→    let cumulative = 0;\n   253→    return data.map((item) => {\n   254→      const startAngle = cumulative;\n   255→      const angle = (item.value / total) * Math.PI * 2;\n   256→      cumulative += angle;\n   257→      return { ...item, startAngle, angle };\n   258→    });\n   259→  }, [data, total]);\n   260→\n   261→  // Create donut arc path\n   262→  const createArc = (startAngle: number, endAngle: number, outerR: number, innerR: number) => {\n   263→    const x1 = cx + Math.cos(startAngle) * outerR;\n   264→    const y1 = cy + Math.sin(startAngle) * outerR;\n   265→    const x2 = cx + Math.cos(endAngle) * outerR;\n   266→    const y2 = cy + Math.sin(endAngle) * outerR;\n   267→    const x3 = cx + Math.cos(endAngle) * innerR;\n   268→    const y3 = cy + Math.sin(endAngle) * innerR;\n   269→    const x4 = cx + Math.cos(startAngle) * innerR;\n   270→    const y4 = cy + Math.sin(startAngle) * innerR;\n   271→\n   272→    const largeArc = endAngle - startAngle > Math.PI ? 1 : 0;\n   273→\n   274→    return `M ${x1.toFixed(1)} ${y1.toFixed(1)}\n   275→            A ${outerR} ${outerR} 0 ${largeArc} 1 ${x2.toFixed(1)} ${y2.toFixed(1)}\n   276→            L ${x3.toFixed(1)} ${y3.toFixed(1)}\n   277→            A ${innerR} ${innerR} 0 ${largeArc} 0 ${x4.toFixed(1)} ${y4.toFixed(1)} Z`;\n   278→  };\n   279→\n   280→  return (\n   281→    <svg width={size} height={size}>\n   282→      <defs>\n   283→        <filter id=\"pieGlow\">\n   284→          <feGaussianBlur stdDeviation=\"2\" result=\"blur\" />\n   285→          <feMerge>\n   286→            <feMergeNode in=\"blur\" />\n   287→            <feMergeNode in=\"SourceGraphic\" />\n   288→          </feMerge>\n   289→        </filter>\n   290→      </defs>\n   291→\n   292→      {/* Background circle */}\n   293→      <circle\n   294→        cx={cx}\n   295→        cy={cy}\n   296→        r={radius + 2}\n   297→        fill=\"none\"\n   298→        stroke={isRadar ? 'rgba(34,211,238,0.1)' : 'rgba(0,0,0,0.05)'}\n   299→        strokeWidth={1}\n   300→      />\n   301→\n   302→      {segments.map((seg, i) => {\n   303→        const segProgress = spring({ frame, fps, delay: i * 3, durationFrames: 35, easing: easeOutQuart });\n   304→        const animatedAngle = seg.angle * progress * segProgress;\n   305→        const startAngle = seg.startAngle * progress - Math.PI / 2;\n   306→        const endAngle = startAngle + animatedAngle;\n   307→\n   308→        if (animatedAngle < 0.02) return null;\n   309→\n   310→        const d = createArc(startAngle, endAngle, radius, innerRadius);\n   311→\n   312→        return (\n   313→          <g key={i}>\n   314→            {/* Glow */}\n   315→            <path\n   316→              d={d}\n   317→              fill={seg.color}\n   318→              opacity={0.3}\n   319→              filter=\"url(#pieGlow)\"\n   320→            />\n   321→            {/* Segment */}\n   322→            <path\n   323→              d={d}\n   324→              fill={seg.color}\n   325→              stroke={isRadar ? '#0f172a' : '#fff'}\n   326→              strokeWidth={2}\n   327→            />\n   328→          </g>\n   329→        );\n   330→      })}\n   331→\n   332→      {/* Center text */}\n   333→      <text\n   334→        x={cx}\n   335→        y={cy - 4}\n   336→        textAnchor=\"middle\"\n   337→        className={`text-lg font-bold ${isRadar ? 'fill-white' : 'fill-stone-800'}`}\n   338→      >\n   339→        {data.length}\n   340→      </text>\n   341→      <text\n   342→        x={cx}\n   343→        y={cy + 12}\n   344→        textAnchor=\"middle\"\n   345→        className={`text-[8px] ${isRadar ? 'fill-slate-400' : 'fill-stone-500'}`}\n   346→      >\n   347→        Types\n   348→      </text>\n   349→    </svg>\n   350→  );\n   351→}\n   352→\n   353→interface CounterProps {\n   354→  value: number;\n   355→  frame: number;\n   356→  fps: number;\n   357→  delay?: number;\n   358→  suffix?: string;\n   359→  prefix?: string;\n   360→  decimals?: number;\n   361→}\n   362→\n   363→export function AnimatedCounter({ value, frame, fps, delay = 0, suffix = '', prefix = '', decimals = 0 }: CounterProps) {\n   364→  const progress = spring({ frame, fps, delay, durationFrames: 30, easing: easeOutCubic });\n   365→  const current = value * progress;\n   366→\n   367→  return (\n   368→    <span>{prefix}{current.toFixed(decimals)}{suffix}</span>\n   369→  );\n   370→}\n   371→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01RXtY2QPAvhrW5UxujdPX7p","session_id":"05d3e4f1-2259-4f3e-a055-8040a34c8b02","uuid":"8e4b89f5-4f1a-44fb-9cd1-329feb257373"}
[2026-01-29T23:36:31.870Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019KhSCgUwEFH2jicFVEAoLE","type":"tool_result","content":"     1→'use client';\n     2→\n     3→import { useRef, useState } from 'react';\n     4→import { motion } from 'framer-motion';\n     5→import { useReportTheme, useThemeStyles } from '../core/ThemeContext';\n     6→\n     7→interface TimelineEvent {\n     8→  id: string;\n     9→  date: Date;\n    10→  label: string;\n    11→  type: 'finding' | 'event' | 'prediction';\n    12→  confidence?: number;\n    13→}\n    14→\n    15→interface TimelineProps {\n    16→  events: TimelineEvent[];\n    17→  onEventClick?: (eventId: string) => void;\n    18→}\n    19→\n    20→export function Timeline({ events, onEventClick }: TimelineProps) {\n    21→  const { theme } = useReportTheme();\n    22→  const styles = useThemeStyles();\n    23→  const containerRef = useRef<HTMLDivElement>(null);\n    24→  const [hoveredEvent, setHoveredEvent] = useState<string | null>(null);\n    25→\n    26→  if (events.length === 0) return null;\n    27→\n    28→  const sortedEvents = [...events].sort((a, b) => a.date.getTime() - b.date.getTime());\n    29→  const minDate = sortedEvents[0].date.getTime();\n    30→  const maxDate = sortedEvents[sortedEvents.length - 1].date.getTime();\n    31→  const range = maxDate - minDate || 1;\n    32→\n    33→  const getPosition = (date: Date) => ((date.getTime() - minDate) / range) * 100;\n    34→\n    35→  const typeConfig = {\n    36→    finding: { color: theme === 'radar' ? '#22d3ee' : '#0ea5e9', icon: '◆' },\n    37→    event: { color: theme === 'radar' ? '#a78bfa' : '#7c3aed', icon: '●' },\n    38→    prediction: { color: theme === 'radar' ? '#fbbf24' : '#d97706', icon: '◇' },\n    39→  };\n    40→\n    41→  const isRadar = theme === 'radar';\n    42→\n    43→  return (\n    44→    <div className={`relative p-4 rounded-xl ${isRadar ? 'bg-slate-900/60' : 'bg-stone-50'}`}>\n    45→      {/* Header */}\n    46→      <div className=\"flex items-center justify-between mb-4\">\n    47→        <h4 className={`text-xs font-semibold uppercase tracking-wider ${styles.textMuted}`}>Timeline</h4>\n    48→        <div className=\"flex gap-3 text-[10px]\">\n    49→          {Object.entries(typeConfig).map(([type, config]) => (\n    50→            <span key={type} className=\"flex items-center gap-1\" style={{ color: config.color }}>\n    51→              {config.icon} {type}\n    52→            </span>\n    53→          ))}\n    54→        </div>\n    55→      </div>\n    56→\n    57→      {/* Timeline track */}\n    58→      <div ref={containerRef} className=\"relative h-20\">\n    59→        {/* Background track */}\n    60→        <div className={`absolute top-1/2 left-0 right-0 h-0.5 -translate-y-1/2 ${isRadar ? 'bg-cyan-500/20' : 'bg-stone-300'}`}>\n    61→          {/* Glow effect for radar */}\n    62→          {isRadar && <div className=\"absolute inset-0 bg-cyan-400/30 blur-sm\" />}\n    63→        </div>\n    64→\n    65→        {/* Date markers */}\n    66→        <div className=\"absolute top-full left-0 right-0 flex justify-between pt-2 text-[10px]\" style={{ color: styles.textMuted }}>\n    67→          <span>{sortedEvents[0].date.toLocaleDateString()}</span>\n    68→          <span>{sortedEvents[sortedEvents.length - 1].date.toLocaleDateString()}</span>\n    69→        </div>\n    70→\n    71→        {/* Events */}\n    72→        {sortedEvents.map((event, i) => {\n    73→          const pos = getPosition(event.date);\n    74→          const config = typeConfig[event.type];\n    75→          const isHovered = hoveredEvent === event.id;\n    76→\n    77→          return (\n    78→            <motion.div\n    79→              key={event.id}\n    80→              initial={{ scale: 0, opacity: 0 }}\n    81→              animate={{ scale: 1, opacity: 1 }}\n    82→              transition={{ delay: i * 0.05, type: 'spring' }}\n    83→              className=\"absolute top-1/2 -translate-y-1/2 cursor-pointer\"\n    84→              style={{ left: `${pos}%` }}\n    85→              onMouseEnter={() => setHoveredEvent(event.id)}\n    86→              onMouseLeave={() => setHoveredEvent(null)}\n    87→              onClick={() => onEventClick?.(event.id)}\n    88→            >\n    89→              {/* Event node */}\n    90→              <motion.div\n    91→                animate={{ scale: isHovered ? 1.5 : 1 }}\n    92→                className=\"relative w-4 h-4 -ml-2 flex items-center justify-center text-xs\"\n    93→                style={{\n    94→                  color: config.color,\n    95→                  filter: isHovered ? `drop-shadow(0 0 8px ${config.color})` : undefined,\n    96→                }}\n    97→              >\n    98→                {config.icon}\n    99→\n   100→                {/* Confidence ring */}\n   101→                {event.confidence !== undefined && (\n   102→                  <svg className=\"absolute inset-0 w-full h-full -rotate-90\">\n   103→                    <circle\n   104→                      cx=\"8\" cy=\"8\" r=\"6\"\n   105→                      fill=\"none\"\n   106→                      stroke={config.color}\n   107→                      strokeWidth=\"1\"\n   108→                      strokeDasharray={`${event.confidence * 37.7} 37.7`}\n   109→                      opacity={0.5}\n   110→                    />\n   111→                  </svg>\n   112→                )}\n   113→              </motion.div>\n   114→\n   115→              {/* Tooltip */}\n   116→              {isHovered && (\n   117→                <motion.div\n   118→                  initial={{ opacity: 0, y: 5 }}\n   119→                  animate={{ opacity: 1, y: 0 }}\n   120→                  className={`absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 rounded text-[10px] whitespace-nowrap z-10 ${isRadar ? 'bg-slate-800 text-white' : 'bg-white text-stone-800 shadow-lg'}`}\n   121→                >\n   122→                  {event.label}\n   123→                </motion.div>\n   124→              )}\n   125→            </motion.div>\n   126→          );\n   127→        })}\n   128→      </div>\n   129→    </div>\n   130→  );\n   131→}\n   132→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01HdNMS5d7ybPC7GVghCSx1u","session_id":"05d3e4f1-2259-4f3e-a055-8040a34c8b02","uuid":"36689c73-57b0-4604-81d8-fcf6772df6fb"}
[2026-01-29T23:36:31.916Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016sCZeLAUS8oy3b7DWhjTb6","type":"tool_result","content":"     1→'use client';\n     2→\n     3→import { spring, easeOutCubic, easeOutQuart, easeOutExpo, easeInOutCubic } from './useVideoPlayback';\n     4→import { AnimatedBarChart, AnimatedLineChart, AnimatedPieChart, AnimatedCounter } from './AnimatedCharts';\n     5→import type { VideoFormat } from './VideoOverview';\n     6→\n     7→interface SceneProps {\n     8→  frame: number;\n     9→  fps: number;\n    10→  isRadar: boolean;\n    11→  format: VideoFormat;\n    12→}\n    13→\n    14→// Subtle pulse effect for breathing animations\n    15→function pulse(frame: number, fps: number, speed: number = 1): number {\n    16→  return 0.97 + Math.sin((frame / fps) * Math.PI * speed) * 0.03;\n    17→}\n    18→\n    19→// ============================================\n    20→// TITLE SCENE - News-style with bold typography\n    21→// ============================================\n    22→interface TitleSceneProps extends SceneProps {\n    23→  title: string;\n    24→  subtitle: string;\n    25→  date: string;\n    26→}\n    27→\n    28→export function TitleScene({ frame, fps, isRadar, format, title, subtitle, date }: TitleSceneProps) {\n    29→  const isMobile = format === 'mobile';\n    30→  const logoProgress = spring({ frame, fps, delay: 0, durationFrames: 22, easing: easeOutQuart });\n    31→  const glowProgress = spring({ frame, fps, delay: 3, durationFrames: 28, easing: easeOutCubic });\n    32→  const titleProgress = spring({ frame, fps, delay: 8, durationFrames: 26, easing: easeOutCubic });\n    33→  const subtitleProgress = spring({ frame, fps, delay: 16, durationFrames: 22, easing: easeOutCubic });\n    34→  const dateProgress = spring({ frame, fps, delay: 24, durationFrames: 20, easing: easeOutCubic });\n    35→  const breathe = pulse(frame, fps, 0.8);\n    36→\n    37→  return (\n    38→    <div className={`absolute inset-0 flex flex-col items-center overflow-hidden ${isMobile ? 'justify-start pt-16' : 'justify-center'}`}>\n    39→      {/* Background gradient orb */}\n    40→      <div\n    41→        className={`absolute ${isMobile ? 'w-64 h-64 top-1/4' : 'w-96 h-96'} rounded-full blur-3xl ${isRadar ? 'bg-cyan-500/10' : 'bg-stone-400/10'}`}\n    42→        style={{ opacity: glowProgress * 0.6, transform: `scale(${0.5 + glowProgress * 0.5 * breathe})` }}\n    43→      />\n    44→\n    45→      {/* Decorative rings */}\n    46→      <div\n    47→        className={`absolute ${isMobile ? 'w-24 h-24' : 'w-32 h-32'} rounded-full border ${isRadar ? 'border-cyan-500/20' : 'border-stone-400/20'}`}\n    48→        style={{ opacity: logoProgress * 0.5, transform: `scale(${0.8 + logoProgress * 0.4})` }}\n    49→      />\n    50→\n    51→      {/* Logo with glow */}\n    52→      <div className=\"relative\">\n    53→        <div\n    54→          className={`absolute inset-0 rounded-2xl blur-xl ${isRadar ? 'bg-cyan-500/40' : 'bg-stone-600/30'}`}\n    55→          style={{ opacity: glowProgress * 0.6, transform: `scale(${1.2 * breathe})` }}\n    56→        />\n    57→        <div\n    58→          className={`relative ${isMobile ? 'w-14 h-14' : 'w-16 h-16'} rounded-2xl flex items-center justify-center shadow-2xl ${\n    59→            isRadar ? 'bg-gradient-to-br from-cyan-400 to-blue-600' : 'bg-gradient-to-br from-stone-600 to-stone-800'\n    60→          }`}\n    61→          style={{ opacity: logoProgress, transform: `scale(${0.5 + logoProgress * 0.5})` }}\n    62→        >\n    63→          <svg className={`${isMobile ? 'w-7 h-7' : 'w-8 h-8'} text-white`} fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n    64→            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z\" />\n    65→          </svg>\n    66→        </div>\n    67→      </div>\n    68→\n    69→      {/* Title container */}\n    70→      <div className={`${isMobile ? 'mt-6 px-4' : 'mt-6 px-6'} text-center`}>\n    71→        {/* Subtitle badge - NEWS CATEGORY */}\n    72→        <div\n    73→          className={`mb-3 inline-flex items-center gap-1.5 px-3 py-1 rounded-full ${\n    74→            isRadar ? 'bg-red-500/20 border border-red-500/30' : 'bg-red-100 border border-red-200'\n    75→          }`}\n    76→          style={{ opacity: subtitleProgress, transform: `scale(${0.9 + subtitleProgress * 0.1})` }}\n    77→        >\n    78→          <span className={`text-[10px] font-bold tracking-wider ${isRadar ? 'text-red-400' : 'text-red-600'}`}>\n    79→            {subtitle}\n    80→          </span>\n    81→        </div>\n    82→\n    83→        {/* Main Title */}\n    84→        <h1\n    85→          className={`${isMobile ? 'text-xl' : 'text-2xl'} font-bold tracking-tight leading-tight ${\n    86→            isRadar ? 'bg-gradient-to-r from-white to-cyan-200 bg-clip-text text-transparent' : 'text-stone-900'\n    87→          }`}\n    88→          style={{ opacity: titleProgress, transform: `translateY(${(1 - titleProgress) * 10}px)` }}\n    89→        >\n    90→          {title}\n    91→        </h1>\n    92→\n    93→        {/* Date line */}\n    94→        <div\n    95→          className={`mt-3 flex items-center justify-center gap-2 ${isMobile ? 'text-xs' : 'text-sm'}`}\n    96→          style={{ opacity: dateProgress }}\n    97→        >\n    98→          <div className={`w-8 h-px ${isRadar ? 'bg-slate-600' : 'bg-stone-300'}`} />\n    99→          <span className={`${isRadar ? 'text-slate-400' : 'text-stone-500'}`}>{date}</span>\n   100→          <div className={`w-8 h-px ${isRadar ? 'bg-slate-600' : 'bg-stone-300'}`} />\n   101→        </div>\n   102→      </div>\n   103→\n   104→      {/* Mobile: Additional bottom element */}\n   105→      {isMobile && (\n   106→        <div\n   107→          className=\"absolute bottom-20 left-4 right-4\"\n   108→          style={{ opacity: dateProgress, transform: `translateY(${(1 - dateProgress) * 20}px)` }}\n   109→        >\n   110→          <div className={`h-px ${isRadar ? 'bg-gradient-to-r from-transparent via-cyan-500/30 to-transparent' : 'bg-gradient-to-r from-transparent via-stone-400/30 to-transparent'}`} />\n   111→          <p className={`mt-3 text-center text-xs ${isRadar ? 'text-slate-500' : 'text-stone-400'}`}>\n   112→            Swipe for insights ↓\n   113→          </p>\n   114→        </div>\n   115→      )}\n   116→    </div>\n   117→  );\n   118→}\n   119→\n   120→// ============================================\n   121→// METRICS SCENE - Data-driven news style\n   122→// ============================================\n   123→interface MetricsSceneProps extends SceneProps {\n   124→  metrics: Array<{ label: string; value: number; suffix?: string; color: string }>;\n   125→}\n   126→\n   127→export function MetricsScene({ frame, fps, isRadar, format, metrics }: MetricsSceneProps) {\n   128→  const isMobile = format === 'mobile';\n   129→  const headerProgress = spring({ frame, fps, delay: 0, durationFrames: 18, easing: easeOutCubic });\n   130→  const lineProgress = spring({ frame, fps, delay: 3, durationFrames: 22, easing: easeInOutCubic });\n   131→\n   132→  return (\n   133→    <div className={`absolute inset-0 ${isMobile ? 'p-4 pt-8' : 'p-5'}`}>\n   134→      {/* Background accent */}\n   135→      <div\n   136→        className={`absolute ${isMobile ? 'top-1/3 right-0' : 'top-0 right-0'} w-48 h-48 rounded-full blur-3xl ${isRadar ? 'bg-cyan-500/5' : 'bg-stone-400/5'}`}\n   137→        style={{ opacity: headerProgress }}\n   138→      />\n   139→\n   140→      {/* Header */}\n   141→      <div className={`${isMobile ? 'mb-4' : 'mb-5'}`}>\n   142→        <div\n   143→          className=\"flex items-center gap-2\"\n   144→          style={{ opacity: headerProgress, transform: `translateX(${(1 - headerProgress) * -12}px)` }}\n   145→        >\n   146→          <div className={`w-1 ${isMobile ? 'h-6' : 'h-7'} rounded-full ${isRadar ? 'bg-gradient-to-b from-cyan-400 to-cyan-600' : 'bg-gradient-to-b from-stone-600 to-stone-800'}`} />\n   147→          <h2 className={`${isMobile ? 'text-base' : 'text-lg'} font-bold ${isRadar ? 'text-white' : 'text-stone-900'}`}>Key Metrics</h2>\n   148→        </div>\n   149→        <div className={`h-px mt-3 ${isRadar ? 'bg-cyan-500/20' : 'bg-stone-300'}`} style={{ transform: `scaleX(${lineProgress})`, transformOrigin: 'left' }} />\n   150→      </div>\n   151→\n   152→      {/* Metrics grid */}\n   153→      <div className={`grid ${isMobile ? 'grid-cols-2 gap-3' : 'grid-cols-4 gap-3'}`}>\n   154→        {metrics.map((m, i) => (\n   155→          <MetricCard key={i} {...m} index={i} frame={frame} fps={fps} isRadar={isRadar} format={format} />\n   156→        ))}\n   157→      </div>\n   158→    </div>\n   159→  );\n   160→}\n   161→\n   162→function MetricCard({ label, value, suffix = '', color, index, frame, fps, isRadar, format }: {\n   163→  label: string; value: number; suffix?: string; color: string; index: number; frame: number; fps: number; isRadar: boolean; format: VideoFormat;\n   164→}) {\n   165→  const isMobile = format === 'mobile';\n   166→  const progress = spring({ frame, fps, delay: 6 + index * 4, durationFrames: 22, easing: easeOutQuart });\n   167→  const countProgress = spring({ frame, fps, delay: 12 + index * 4, durationFrames: 32, easing: easeOutCubic });\n   168→  const glowProgress = spring({ frame, fps, delay: 16 + index * 4, durationFrames: 18, easing: easeOutCubic });\n   169→  const breathe = pulse(frame, fps, 0.6);\n   170→\n   171→  const colorMap: Record<string, { bg: string; border: string; text: string; glow: string }> = {\n   172→    cyan: {\n   173→      bg: isRadar ? 'bg-cyan-500/8' : 'bg-blue-50',\n   174→      border: isRadar ? 'border-cyan-500/25' : 'border-blue-200',\n   175→      text: isRadar ? 'text-cyan-400' : 'text-blue-600',\n   176→      glow: isRadar ? 'bg-cyan-500/20' : 'bg-blue-500/10'\n   177→    },\n   178→    emerald: {\n   179→      bg: isRadar ? 'bg-emerald-500/8' : 'bg-emerald-50',\n   180→      border: isRadar ? 'border-emerald-500/25' : 'border-emerald-200',\n   181→      text: isRadar ? 'text-emerald-400' : 'text-emerald-600',\n   182→      glow: isRadar ? 'bg-emerald-500/20' : 'bg-emerald-500/10'\n   183→    },\n   184→    amber: {\n   185→      bg: isRadar ? 'bg-amber-500/8' : 'bg-amber-50',\n   186→      border: isRadar ? 'border-amber-500/25' : 'border-amber-200',\n   187→      text: isRadar ? 'text-amber-400' : 'text-amber-600',\n   188→      glow: isRadar ? 'bg-amber-500/20' : 'bg-amber-500/10'\n   189→    },\n   190→    rose: {\n   191→      bg: isRadar ? 'bg-rose-500/8' : 'bg-rose-50',\n   192→      border: isRadar ? 'border-rose-500/25' : 'border-rose-200',\n   193→      text: isRadar ? 'text-rose-400' : 'text-rose-600',\n   194→      glow: isRadar ? 'bg-rose-500/20' : 'bg-rose-500/10'\n   195→    },\n   196→  };\n   197→\n   198→  const colors = colorMap[color] || colorMap.cyan;\n   199→\n   200→  return (\n   201→    <div className=\"relative\">\n   202→      <div\n   203→        className={`absolute inset-0 rounded-xl blur-xl ${colors.glow}`}\n   204→        style={{ opacity: glowProgress * 0.4, transform: `scale(${1.1 * breathe})` }}\n   205→      />\n   206→      <div\n   207→        className={`relative ${isMobile ? 'p-3' : 'p-3'} rounded-xl border backdrop-blur-sm ${colors.bg} ${colors.border}`}\n   208→        style={{ opacity: progress, transform: `translateY(${(1 - progress) * 15}px)` }}\n   209→      >\n   210→        <div className={`${isMobile ? 'text-[9px]' : 'text-[10px]'} uppercase tracking-wider font-medium mb-1 ${isRadar ? 'text-slate-400' : 'text-stone-500'}`}>\n   211→          {label}\n   212→        </div>\n   213→        <div className={`${isMobile ? 'text-2xl' : 'text-2xl'} font-bold tabular-nums ${colors.text}`}>\n   214→          {Math.round(value * countProgress)}{suffix}\n   215→        </div>\n   216→        {/* Mini progress bar */}\n   217→        <div className={`mt-2 h-0.5 rounded-full ${isRadar ? 'bg-slate-800' : 'bg-stone-200'}`}>\n   218→          <div\n   219→            className={`h-full rounded-full ${colors.text.replace('text-', 'bg-')}`}\n   220→            style={{ width: `${countProgress * 100}%`, opacity: 0.5 }}\n   221→          />\n   222→        </div>\n   223→      </div>\n   224→    </div>\n   225→  );\n   226→}\n   227→\n   228→// ============================================\n   229→// CHARTS SCENE - Data visualization\n   230→// ============================================\n   231→interface ChartsSceneProps extends SceneProps {\n   232→  barData: Array<{ label: string; value: number }>;\n   233→  lineData: number[];\n   234→  pieData: Array<{ label: string; value: number; color: string }>;\n   235→}\n   236→\n   237→export function ChartsScene({ frame, fps, isRadar, format, barData, lineData, pieData }: ChartsSceneProps) {\n   238→  const isMobile = format === 'mobile';\n   239→  const headerProgress = spring({ frame, fps, delay: 0, durationFrames: 18, easing: easeOutCubic });\n   240→  const lineProgress = spring({ frame, fps, delay: 3, durationFrames: 22, easing: easeInOutCubic });\n   241→  const chart1Progress = spring({ frame, fps, delay: 6, durationFrames: 20, easing: easeOutQuart });\n   242→  const chart2Progress = spring({ frame, fps, delay: 12, durationFrames: 20, easing: easeOutQuart });\n   243→  const chart3Progress = spring({ frame, fps, delay: 18, durationFrames: 20, easing: easeOutQuart });\n   244→\n   245→  // Mobile layout: vertical stack\n   246→  if (isMobile) {\n   247→    return (\n   248→      <div className=\"absolute inset-0 p-4 pt-8\">\n   249→        {/* Header */}\n   250→        <div className=\"mb-3\">\n   251→          <div\n   252→            className=\"flex items-center gap-2\"\n   253→            style={{ opacity: headerProgress, transform: `translateX(${(1 - headerProgress) * -12}px)` }}\n   254→          >\n   255→            <div className=\"w-1 h-6 rounded-full bg-gradient-to-b from-blue-400 to-cyan-600\" />\n   256→            <h2 className={`text-base font-bold ${isRadar ? 'text-white' : 'text-stone-900'}`}>Data Analysis</h2>\n   257→          </div>\n   258→          <div className={`h-px mt-2 ${isRadar ? 'bg-cyan-500/20' : 'bg-stone-300'}`} style={{ transform: `scaleX(${lineProgress})`, transformOrigin: 'left' }} />\n   259→        </div>\n   260→\n   261→        {/* Charts - vertical stack for mobile */}\n   262→        <div className=\"space-y-3\">\n   263→          {/* Bar + Pie row */}\n   264→          <div className=\"flex gap-3\">\n   265→            <div\n   266→              className={`flex-1 p-3 rounded-xl ${isRadar ? 'bg-slate-900/70 border border-cyan-500/15' : 'bg-white/90 border border-stone-200'}`}\n   267→              style={{ opacity: chart1Progress, transform: `translateY(${(1 - chart1Progress) * 10}px)` }}\n   268→            >\n   269→              <div className={`text-[9px] font-medium mb-2 ${isRadar ? 'text-cyan-400/80' : 'text-stone-500'}`}>Distribution</div>\n   270→              <AnimatedBarChart data={barData} frame={frame - 10} fps={fps} width={100} height={70} isRadar={isRadar} />\n   271→            </div>\n   272→\n   273→            <div\n   274→              className={`flex-1 p-3 rounded-xl flex flex-col items-center ${isRadar ? 'bg-slate-900/70 border border-violet-500/15' : 'bg-white/90 border border-stone-200'}`}\n   275→              style={{ opacity: chart3Progress, transform: `translateY(${(1 - chart3Progress) * 10}px)` }}\n   276→            >\n   277→              <div className={`text-[9px] font-medium mb-2 self-start ${isRadar ? 'text-violet-400/80' : 'text-stone-500'}`}>Sources</div>\n   278→              <AnimatedPieChart data={pieData} frame={frame - 24} fps={fps} size={70} isRadar={isRadar} />\n   279→            </div>\n   280→          </div>\n   281→\n   282→          {/* Line chart - full width */}\n   283→          <div\n   284→            className={`p-3 rounded-xl ${isRadar ? 'bg-slate-900/70 border border-emerald-500/15' : 'bg-white/90 border border-stone-200'}`}\n   285→            style={{ opacity: chart2Progress, transform: `translateY(${(1 - chart2Progress) * 10}px)` }}\n   286→          >\n   287→            <div className={`text-[9px] font-medium mb-2 ${isRadar ? 'text-emerald-400/80' : 'text-stone-500'}`}>Confidence Trend</div>\n   288→            <AnimatedLineChart data={lineData} frame={frame - 18} fps={fps} width={230} height={80} isRadar={isRadar} />\n   289→          </div>\n   290→        </div>\n   291→      </div>\n   292→    );\n   293→  }\n   294→\n   295→  // Standard layout: horizontal\n   296→  return (\n   297→    <div className=\"absolute inset-0 p-5\">\n   298→      <div\n   299→        className={`absolute bottom-0 left-0 w-48 h-48 rounded-full blur-3xl ${isRadar ? 'bg-blue-500/5' : 'bg-stone-400/5'}`}\n   300→        style={{ opacity: headerProgress }}\n   301→      />\n   302→\n   303→      <div className=\"mb-4\">\n   304→        <div\n   305→          className=\"flex items-center gap-2\"\n   306→          style={{ opacity: headerProgress, transform: `translateX(${(1 - headerProgress) * -12}px)` }}\n   307→        >\n   308→          <div className=\"w-1 h-7 rounded-full bg-gradient-to-b from-blue-400 to-cyan-600\" />\n   309→          <h2 className={`text-lg font-bold ${isRadar ? 'text-white' : 'text-stone-900'}`}>Data Analysis</h2>\n   310→        </div>\n   311→        <div className={`h-px mt-3 ${isRadar ? 'bg-cyan-500/20' : 'bg-stone-300'}`} style={{ transform: `scaleX(${lineProgress})`, transformOrigin: 'left' }} />\n   312→      </div>\n   313→\n   314→      <div className=\"grid grid-cols-3 gap-3\" style={{ height: 170 }}>\n   315→        <div className=\"relative\">\n   316→          <div\n   317→            className={`absolute inset-0 rounded-xl blur-lg ${isRadar ? 'bg-cyan-500/10' : 'bg-blue-500/5'}`}\n   318→            style={{ opacity: chart1Progress * 0.3 }}\n   319→          />\n   320→          <div\n   321→            className={`relative h-full p-3 rounded-xl backdrop-blur-sm ${isRadar ? 'bg-slate-900/70 border border-cyan-500/15' : 'bg-white/90 border border-stone-200'}`}\n   322→            style={{ opacity: chart1Progress, transform: `translateY(${(1 - chart1Progress) * 10}px) scale(${0.96 + chart1Progress * 0.04})` }}\n   323→          >\n   324→            <div className={`text-[10px] font-medium mb-2 ${isRadar ? 'text-cyan-400/80' : 'text-stone-500'}`}>Distribution</div>\n   325→            <AnimatedBarChart data={barData} frame={frame - 10} fps={fps} width={165} height={120} isRadar={isRadar} />\n   326→          </div>\n   327→        </div>\n   328→\n   329→        <div className=\"relative\">\n   330→          <div\n   331→            className={`absolute inset-0 rounded-xl blur-lg ${isRadar ? 'bg-emerald-500/10' : 'bg-emerald-500/5'}`}\n   332→            style={{ opacity: chart2Progress * 0.3 }}\n   333→          />\n   334→          <div\n   335→            className={`relative h-full p-3 rounded-xl backdrop-blur-sm ${isRadar ? 'bg-slate-900/70 border border-emerald-500/15' : 'bg-white/90 border border-stone-200'}`}\n   336→            style={{ opacity: chart2Progress, transform: `translateY(${(1 - chart2Progress) * 10}px) scale(${0.96 + chart2Progress * 0.04})` }}\n   337→          >\n   338→            <div className={`text-[10px] font-medium mb-2 ${isRadar ? 'text-emerald-400/80' : 'text-stone-500'}`}>Confidence Trend</div>\n   339→            <AnimatedLineChart data={lineData} frame={frame - 18} fps={fps} width={165} height={120} isRadar={isRadar} />\n   340→          </div>\n   341→        </div>\n   342→\n   343→        <div className=\"relative\">\n   344→          <div\n   345→            className={`absolute inset-0 rounded-xl blur-lg ${isRadar ? 'bg-violet-500/10' : 'bg-violet-500/5'}`}\n   346→            style={{ opacity: chart3Progress * 0.3 }}\n   347→          />\n   348→          <div\n   349→            className={`relative h-full p-3 rounded-xl flex flex-col backdrop-blur-sm ${isRadar ? 'bg-slate-900/70 border border-violet-500/15' : 'bg-white/90 border border-stone-200'}`}\n   350→            style={{ opacity: chart3Progress, transform: `translateY(${(1 - chart3Progress) * 10}px) scale(${0.96 + chart3Progress * 0.04})` }}\n   351→          >\n   352→            <div className={`text-[10px] font-medium mb-2 ${isRadar ? 'text-violet-400/80' : 'text-stone-500'}`}>Source Mix</div>\n   353→            <div className=\"flex-1 flex items-center justify-center\">\n   354→              <AnimatedPieChart data={pieData} frame={frame - 26} fps={fps} size={100} isRadar={isRadar} />\n   355→            </div>\n   356→          </div>\n   357→        </div>\n   358→      </div>\n   359→    </div>\n   360→  );\n   361→}\n   362→\n   363→// ============================================\n   364→// INSIGHTS SCENE - Key findings highlight\n   365→// ============================================\n   366→interface InsightsSceneProps extends SceneProps {\n   367→  insights: string[];\n   368→  warnings: string[];\n   369→}\n   370→\n   371→export function InsightsScene({ frame, fps, isRadar, format, insights, warnings }: InsightsSceneProps) {\n   372→  const isMobile = format === 'mobile';\n   373→  const headerProgress = spring({ frame, fps, delay: 0, durationFrames: 18, easing: easeOutCubic });\n   374→  const lineProgress = spring({ frame, fps, delay: 3, durationFrames: 22, easing: easeInOutCubic });\n   375→  const col1Progress = spring({ frame, fps, delay: 6, durationFrames: 20, easing: easeOutQuart });\n   376→  const col2Progress = spring({ frame, fps, delay: 12, durationFrames: 20, easing: easeOutQuart });\n   377→\n   378→  // Mobile: vertical stack\n   379→  if (isMobile) {\n   380→    return (\n   381→      <div className=\"absolute inset-0 p-4 pt-8\">\n   382→        <div\n   383→          className={`absolute top-1/3 left-1/2 w-32 h-32 rounded-full blur-3xl ${isRadar ? 'bg-emerald-500/5' : 'bg-emerald-400/5'}`}\n   384→          style={{ opacity: headerProgress }}\n   385→        />\n   386→\n   387→        <div className=\"mb-3\">\n   388→          <div\n   389→            className=\"flex items-center gap-2\"\n   390→            style={{ opacity: headerProgress, transform: `translateX(${(1 - headerProgress) * -12}px)` }}\n   391→          >\n   392→            <div className=\"w-1 h-6 rounded-full bg-gradient-to-b from-emerald-400 to-emerald-600\" />\n   393→            <h2 className={`text-base font-bold ${isRadar ? 'text-white' : 'text-stone-900'}`}>Key Findings</h2>\n   394→          </div>\n   395→          <div className={`h-px mt-2 ${isRadar ? 'bg-emerald-500/20' : 'bg-stone-300'}`} style={{ transform: `scaleX(${lineProgress})`, transformOrigin: 'left' }} />\n   396→        </div>\n   397→\n   398→        {/* Vertical stack for mobile */}\n   399→        <div className=\"space-y-3\">\n   400→          {/* Insights */}\n   401→          <div\n   402→            className={`p-3 rounded-xl ${isRadar ? 'bg-emerald-500/5 border border-emerald-500/15' : 'bg-emerald-50/50 border border-emerald-200'}`}\n   403→            style={{ opacity: col1Progress, transform: `translateY(${(1 - col1Progress) * 10}px)` }}\n   404→          >\n   405→            <div className={`text-[9px] uppercase tracking-wider font-semibold mb-2 flex items-center gap-1.5 ${isRadar ? 'text-emerald-400' : 'text-emerald-600'}`}>\n   406→              <span>💡</span> Insights\n   407→            </div>\n   408→            <div className=\"space-y-2\">\n   409→              {insights.slice(0, 2).map((text, i) => (\n   410→                <InsightItem key={i} text={text} type=\"insight\" index={i} frame={frame} fps={fps} isRadar={isRadar} format={format} />\n   411→              ))}\n   412→              {insights.length === 0 && (\n   413→                <p className={`text-xs italic ${isRadar ? 'text-slate-500' : 'text-stone-400'}`}>No insights available</p>\n   414→              )}\n   415→            </div>\n   416→          </div>\n   417→\n   418→          {/* Warnings */}\n   419→          <div\n   420→            className={`p-3 rounded-xl ${isRadar ? 'bg-amber-500/5 border border-amber-500/15' : 'bg-amber-50/50 border border-amber-200'}`}\n   421→            style={{ opacity: col2Progress, transform: `translateY(${(1 - col2Progress) * 10}px)` }}\n   422→          >\n   423→            <div className={`text-[9px] uppercase tracking-wider font-semibold mb-2 flex items-center gap-1.5 ${isRadar ? 'text-amber-400' : 'text-amber-600'}`}>\n   424→              <span>⚠️</span> Alerts\n   425→            </div>\n   426→            <div className=\"space-y-2\">\n   427→              {warnings.slice(0, 2).map((text, i) => (\n   428→                <InsightItem key={i} text={text} type=\"warning\" index={i + insights.length} frame={frame} fps={fps} isRadar={isRadar} format={format} />\n   429→              ))}\n   430→              {warnings.length === 0 && (\n   431→                <p className={`text-xs italic ${isRadar ? 'text-slate-500' : 'text-stone-400'}`}>No alerts</p>\n   432→              )}\n   433→            </div>\n   434→          </div>\n   435→        </div>\n   436→      </div>\n   437→    );\n   438→  }\n   439→\n   440→  // Standard: two columns\n   441→  return (\n   442→    <div className=\"absolute inset-0 p-5\">\n   443→      <div\n   444→        className={`absolute top-1/2 left-1/4 w-36 h-36 rounded-full blur-3xl ${isRadar ? 'bg-emerald-500/5' : 'bg-emerald-400/5'}`}\n   445→        style={{ opacity: headerProgress }}\n   446→      />\n   447→      <div\n   448→        className={`absolute top-1/2 right-1/4 w-36 h-36 rounded-full blur-3xl ${isRadar ? 'bg-amber-500/5' : 'bg-amber-400/5'}`}\n   449→        style={{ opacity: headerProgress }}\n   450→      />\n   451→\n   452→      <div className=\"mb-4\">\n   453→        <div\n   454→          className=\"flex items-center gap-2\"\n   455→          style={{ opacity: headerProgress, transform: `translateX(${(1 - headerProgress) * -12}px)` }}\n   456→        >\n   457→          <div className=\"w-1 h-7 rounded-full bg-gradient-to-b from-emerald-400 to-emerald-600\" />\n   458→          <h2 className={`text-lg font-bold ${isRadar ? 'text-white' : 'text-stone-900'}`}>Key Findings</h2>\n   459→        </div>\n   460→        <div className={`h-px mt-3 ${isRadar ? 'bg-emerald-500/20' : 'bg-stone-300'}`} style={{ transform: `scaleX(${lineProgress})`, transformOrigin: 'left' }} />\n   461→      </div>\n   462→\n   463→      <div className=\"grid grid-cols-2 gap-4\">\n   464→        <div\n   465→          className={`p-3 rounded-xl ${isRadar ? 'bg-emerald-500/5 border border-emerald-500/15' : 'bg-emerald-50/50 border border-emerald-200'}`}\n   466→          style={{ opacity: col1Progress, transform: `translateX(${(1 - col1Progress) * -12}px)` }}\n   467→        >\n   468→          <div className={`text-[10px] uppercase tracking-wider font-semibold mb-3 flex items-center gap-1.5 ${isRadar ? 'text-emerald-400' : 'text-emerald-600'}`}>\n   469→            <span>💡</span> Insights\n   470→          </div>\n   471→          <div className=\"space-y-2\">\n   472→            {insights.slice(0, 3).map((text, i) => (\n   473→              <InsightItem key={i} text={text} type=\"insight\" index={i} frame={frame} fps={fps} isRadar={isRadar} format={format} />\n   474→            ))}\n   475→            {insights.length === 0 && (\n   476→              <p className={`text-xs italic ${isRadar ? 'text-slate-500' : 'text-stone-400'}`}>No insights available</p>\n   477→            )}\n   478→          </div>\n   479→        </div>\n   480→\n   481→        <div\n   482→          className={`p-3 rounded-xl ${isRadar ? 'bg-amber-500/5 border border-amber-500/15' : 'bg-amber-50/50 border border-amber-200'}`}\n   483→          style={{ opacity: col2Progress, transform: `translateX(${(1 - col2Progress) * 12}px)` }}\n   484→        >\n   485→          <div className={`text-[10px] uppercase tracking-wider font-semibold mb-3 flex items-center gap-1.5 ${isRadar ? 'text-amber-400' : 'text-amber-600'}`}>\n   486→            <span>⚠️</span> Alerts\n   487→          </div>\n   488→          <div className=\"space-y-2\">\n   489→            {warnings.slice(0, 2).map((text, i) => (\n   490→              <InsightItem key={i} text={text} type=\"warning\" index={i + insights.length} frame={frame} fps={fps} isRadar={isRadar} format={format} />\n   491→            ))}\n   492→            {warnings.length === 0 && (\n   493→              <p className={`text-xs italic ${isRadar ? 'text-slate-500' : 'text-stone-400'}`}>No alerts</p>\n   494→            )}\n   495→          </div>\n   496→        </div>\n   497→      </div>\n   498→    </div>\n   499→  );\n   500→}\n   501→\n   502→function InsightItem({ text, type, index, frame, fps, isRadar, format }: {\n   503→  text: string; type: 'insight' | 'warning'; index: number; frame: number; fps: number; isRadar: boolean; format: VideoFormat;\n   504→}) {\n   505→  const isMobile = format === 'mobile';\n   506→  const progress = spring({ frame, fps, delay: 6 + index * 6, durationFrames: 22, easing: easeOutCubic });\n   507→  const color = type === 'insight'\n   508→    ? (isRadar ? 'text-emerald-200' : 'text-emerald-800')\n   509→    : (isRadar ? 'text-amber-200' : 'text-amber-800');\n   510→\n   511→  const maxLen = isMobile ? 60 : 85;\n   512→\n   513→  return (\n   514→    <div\n   515→      className={`flex items-start gap-2 p-2 rounded-lg ${isRadar ? 'bg-slate-900/30' : 'bg-white/60'}`}\n   516→      style={{ opacity: progress, transform: `translateY(${(1 - progress) * 8}px)` }}\n   517→    >\n   518→      <div className={`w-1 h-1 rounded-full mt-1.5 flex-shrink-0 ${type === 'insight' ? (isRadar ? 'bg-emerald-400' : 'bg-emerald-500') : (isRadar ? 'bg-amber-400' : 'bg-amber-500')}`} />\n   519→      <p className={`${isMobile ? 'text-[11px]' : 'text-xs'} leading-relaxed ${color}`}>{text.slice(0, maxLen)}{text.length > maxLen ? '...' : ''}</p>\n   520→    </div>\n   521→  );\n   522→}\n   523→\n   524→// ============================================\n   525→// SUMMARY SCENE - Dramatic finale\n   526→// ============================================\n   527→interface SummarySceneProps extends SceneProps {\n   528→  confidence: number;\n   529→  findings: number;\n   530→  sources: number;\n   531→}\n   532→\n   533→export function SummaryScene({ frame, fps, isRadar, format, confidence, findings, sources }: SummarySceneProps) {\n   534→  const isMobile = format === 'mobile';\n   535→  const bgProgress = spring({ frame, fps, delay: 0, durationFrames: 28, easing: easeOutCubic });\n   536→  const mainProgress = spring({ frame, fps, delay: 3, durationFrames: 26, easing: easeOutExpo });\n   537→  const ringProgress = spring({ frame, fps, delay: 6, durationFrames: 32, easing: easeOutCubic });\n   538→  const statsProgress = spring({ frame, fps, delay: 16, durationFrames: 22, easing: easeOutCubic });\n   539→  const badgeProgress = spring({ frame, fps, delay: 28, durationFrames: 20, easing: easeOutQuart });\n   540→  const breathe = pulse(frame, fps, 0.5);\n   541→\n   542→  const confidenceColor = confidence >= 80\n   543→    ? (isRadar ? 'text-emerald-400' : 'text-emerald-600')\n   544→    : confidence >= 60\n   545→      ? (isRadar ? 'text-cyan-400' : 'text-blue-600')\n   546→      : (isRadar ? 'text-amber-400' : 'text-amber-600');\n   547→\n   548→  return (\n   549→    <div className={`absolute inset-0 flex flex-col items-center overflow-hidden ${isMobile ? 'justify-start pt-12' : 'justify-center'}`}>\n   550→      {/* Radial gradient background */}\n   551→      <div\n   552→        className={`absolute ${isMobile ? 'w-64 h-64' : 'w-[400px] h-[400px]'} rounded-full ${isRadar ? 'bg-gradient-radial from-cyan-500/15 via-transparent to-transparent' : 'bg-gradient-radial from-stone-400/10 via-transparent to-transparent'}`}\n   553→        style={{ opacity: bgProgress }}\n   554→      />\n   555→\n   556→      {/* Animated rings */}\n   557→      <div\n   558→        className={`absolute ${isMobile ? 'w-32 h-32' : 'w-40 h-40'} rounded-full border-2 ${isRadar ? 'border-cyan-500/20' : 'border-stone-400/20'}`}\n   559→        style={{ opacity: ringProgress * 0.5, transform: `scale(${0.6 + ringProgress * 0.5 * breathe})` }}\n   560→      />\n   561→      <div\n   562→        className={`absolute ${isMobile ? 'w-48 h-48' : 'w-56 h-56'} rounded-full border ${isRadar ? 'border-cyan-500/10' : 'border-stone-400/10'}`}\n   563→        style={{ opacity: ringProgress * 0.3, transform: `scale(${0.5 + ringProgress * 0.6 * breathe})` }}\n   564→      />\n   565→\n   566→      {/* Main confidence display */}\n   567→      <div className=\"relative\" style={{ opacity: mainProgress, transform: `scale(${0.5 + mainProgress * 0.5})` }}>\n   568→        <div\n   569→          className={`absolute inset-0 blur-2xl ${confidence >= 80 ? (isRadar ? 'bg-emerald-500/30' : 'bg-emerald-500/20') : (isRadar ? 'bg-cyan-500/30' : 'bg-blue-500/20')}`}\n   570→          style={{ transform: `scale(${1.4 * breathe})` }}\n   571→        />\n   572→        <div className=\"relative text-center\">\n   573→          <div className={`${isMobile ? 'text-5xl' : 'text-6xl'} font-bold tabular-nums ${confidenceColor}`}>\n   574→            <AnimatedCounter value={confidence} frame={frame} fps={fps} delay={6} suffix=\"%\" />\n   575→          </div>\n   576→          <div className={`${isMobile ? 'text-sm' : 'text-base'} mt-1 font-medium ${isRadar ? 'text-white/90' : 'text-stone-700'}`}>\n   577→            Overall Confidence\n   578→          </div>\n   579→        </div>\n   580→      </div>\n   581→\n   582→      {/* Stats row */}\n   583→      <div\n   584→        className={`flex ${isMobile ? 'gap-4 mt-6' : 'gap-6 mt-8'}`}\n   585→        style={{ opacity: statsProgress, transform: `translateY(${(1 - statsProgress) * 10}px)` }}\n   586→      >\n   587→        <div className={`text-center ${isMobile ? 'px-4 py-2' : 'px-5 py-2.5'} rounded-xl ${isRadar ? 'bg-slate-800/60 border border-slate-700' : 'bg-white/80 border border-stone-200'}`}>\n   588→          <div className={`${isMobile ? 'text-xl' : 'text-2xl'} font-bold tabular-nums ${isRadar ? 'text-cyan-400' : 'text-blue-600'}`}>\n   589→            <AnimatedCounter value={findings} frame={frame} fps={fps} delay={20} />\n   590→          </div>\n   591→          <div className={`text-[10px] mt-0.5 ${isRadar ? 'text-slate-400' : 'text-stone-500'}`}>Findings</div>\n   592→        </div>\n   593→\n   594→        <div className={`text-center ${isMobile ? 'px-4 py-2' : 'px-5 py-2.5'} rounded-xl ${isRadar ? 'bg-slate-800/60 border border-slate-700' : 'bg-white/80 border border-stone-200'}`}>\n   595→          <div className={`${isMobile ? 'text-xl' : 'text-2xl'} font-bold tabular-nums ${isRadar ? 'text-emerald-400' : 'text-emerald-600'}`}>\n   596→            <AnimatedCounter value={sources} frame={frame} fps={fps} delay={24} />\n   597→          </div>\n   598→          <div className={`text-[10px] mt-0.5 ${isRadar ? 'text-slate-400' : 'text-stone-500'}`}>Sources</div>\n   599→        </div>\n   600→      </div>\n   601→\n   602→      {/* Completion badge */}\n   603→      <div\n   604→        className={`${isMobile ? 'mt-5 px-4 py-2' : 'mt-6 px-5 py-2.5'} rounded-full shadow-lg ${\n   605→          isRadar ? 'bg-gradient-to-r from-emerald-500/20 to-cyan-500/20 border border-emerald-500/30 text-emerald-300' : 'bg-gradient-to-r from-emerald-100 to-cyan-100 border border-emerald-300 text-emerald-700'\n   606→        }`}\n   607→        style={{ opacity: badgeProgress, transform: `scale(${0.88 + badgeProgress * 0.12})` }}\n   608→      >\n   609→        <div className=\"flex items-center gap-2\">\n   610→          <div className={`${isMobile ? 'w-4 h-4' : 'w-5 h-5'} rounded-full flex items-center justify-center ${isRadar ? 'bg-emerald-500/30' : 'bg-emerald-500/20'}`}>\n   611→            <svg className={`${isMobile ? 'w-2.5 h-2.5' : 'w-3 h-3'}`} fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" strokeWidth={3}>\n   612→              <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M5 13l4 4L19 7\" />\n   613→            </svg>\n   614→          </div>\n   615→          <span className={`font-semibold ${isMobile ? 'text-xs' : 'text-sm'}`}>Analysis Complete</span>\n   616→        </div>\n   617→      </div>\n   618→\n   619→      {/* Mobile: CTA at bottom */}\n   620→      {isMobile && (\n   621→        <div\n   622→          className=\"absolute bottom-16 left-4 right-4 text-center\"\n   623→          style={{ opacity: badgeProgress }}\n   624→        >\n   625→          <p className={`text-[10px] ${isRadar ? 'text-slate-500' : 'text-stone-400'}`}>\n   626→            Follow for more insights\n   627→          </p>\n   628→        </div>\n   629→      )}\n   630→    </div>\n   631→  );\n   632→}\n   633→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01RXtY2QPAvhrW5UxujdPX7p","session_id":"05d3e4f1-2259-4f3e-a055-8040a34c8b02","uuid":"83ae8392-9edc-4e2f-80d0-2261177512a2"}
