[2026-01-29T23:37:40.579Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011ABVrY6pgvaZefdkyUUyN1","type":"tool_result","content":"     1→/**\n     2→ * Template Video Configuration System\n     3→ *\n     4→ * Defines the structure for template-specific video output with differentiated\n     5→ * scene flows, timing, and visual treatments for each research template.\n     6→ */\n     7→\n     8→import type { TemplateType } from '@/src/lib/videoShowcaseMockData';\n     9→\n    10→/**\n    11→ * A single scene definition within a template's video flow\n    12→ */\n    13→export interface SceneDefinition {\n    14→  /** Unique identifier for this scene */\n    15→  id: string;\n    16→  /** Display name for the scene (shown in UI/debug) */\n    17→  name: string;\n    18→  /** Component name to render (maps to scene registry) */\n    19→  component: SceneComponentType;\n    20→  /** Frame at which this scene begins (0-indexed) */\n    21→  startFrame: number;\n    22→  /** Frame at which this scene ends (exclusive) */\n    23→  endFrame: number;\n    24→  /** Additional props to pass to the scene component */\n    25→  props?: Record<string, unknown>;\n    26→}\n    27→\n    28→/**\n    29→ * Available scene component types\n    30→ * Each maps to a specific React component for rendering\n    31→ */\n    32→export type SceneComponentType =\n    33→  // Universal scenes\n    34→  | 'HookScene'\n    35→  | 'VerdictScene'\n    36→  // Investigative scenes\n    37→  | 'ActorNetworkScene'\n    38→  | 'MoneyTrailScene'\n    39→  | 'PatternRevealScene'\n    40→  // Financial scenes\n    41→  | 'BullBearScene'\n    42→  | 'RiskMeterScene'\n    43→  // Competitive scenes\n    44→  | 'CompetitiveLandscapeScene'\n    45→  | 'BattleMapScene'\n    46→  // Legal scenes\n    47→  | 'RulingImpactScene'\n    48→  | 'AtRiskScene'\n    49→  // Tech Market scenes\n    50→  | 'HypeVsRealityScene'\n    51→  | 'AdoptionCurveScene'\n    52→  // Contract scenes\n    53→  | 'PriceComparisonScene'\n    54→  | 'ShellCompanyWebScene'\n    55→  | 'CorruptionFlagsScene'\n    56→  // Understanding scenes\n    57→  | 'NarrativeComparisonScene'\n    58→  | 'CausalChainScene'\n    59→  // Due Diligence scenes\n    60→  | 'RedFlagCompilationScene'\n    61→  | 'LeadershipHistoryScene'\n    62→  // Purchase Decision scenes\n    63→  | 'HiddenCostBreakdownScene'\n    64→  | 'AlternativeComparisonScene'\n    65→  // Reputation scenes\n    66→  | 'TrustMeterScene'\n    67→  | 'ComplaintPatternScene';\n    68→\n    69→/**\n    70→ * Hook patterns for opening/closing the video\n    71→ */\n    72→export interface HookPatterns {\n    73→  /** Pattern for the opening hook (e.g., \"What they don't want you to know...\") */\n    74→  openingPattern: string;\n    75→  /** Pattern for the closing CTA */\n    76→  closingPattern: string;\n    77→}\n    78→\n    79→/**\n    80→ * Visual styling configuration\n    81→ */\n    82→export interface VisualConfig {\n    83→  /** Primary accent color for this template (hex) */\n    84→  accentColor: string;\n    85→  /** Secondary color for gradients/accents */\n    86→  secondaryColor: string;\n    87→  /** Icon character/emoji for template identification */\n    88→  icon: string;\n    89→}\n    90→\n    91→/**\n    92→ * Complete configuration for a template's video output\n    93→ */\n    94→export interface TemplateVideoConfig {\n    95→  /** The template type this config applies to */\n    96→  templateType: TemplateType;\n    97→  /** Human-readable name for the template */\n    98→  name: string;\n    99→  /** Frames per second (typically 30) */\n   100→  fps: number;\n   101→  /** Total frames in the video */\n   102→  totalFrames: number;\n   103→  /** Duration in seconds (totalFrames / fps) */\n   104→  durationSeconds: number;\n   105→  /** Ordered list of scenes to render */\n   106→  scenes: SceneDefinition[];\n   107→  /** Hook text patterns */\n   108→  hooks: HookPatterns;\n   109→  /** Visual styling */\n   110→  visuals: VisualConfig;\n   111→}\n   112→\n   113→/**\n   114→ * Props passed to all scene components\n   115→ */\n   116→export interface BaseSceneProps {\n   117→  /** Current frame number (0-indexed) */\n   118→  frame: number;\n   119→  /** Frames per second */\n   120→  fps: number;\n   121→  /** Whether to use dark (radar) theme */\n   122→  isRadar: boolean;\n   123→  /** Video format (standard 16:9 or mobile 9:16) */\n   124→  format: 'standard' | 'mobile';\n   125→  /** Frame within this scene (relative to scene start) */\n   126→  sceneFrame: number;\n   127→  /** Total frames for this scene */\n   128→  sceneDuration: number;\n   129→  /** Progress through scene (0 to 1) */\n   130→  sceneProgress: number;\n   131→}\n   132→\n   133→/**\n   134→ * Helper to calculate scene-relative values\n   135→ */\n   136→export function getSceneProgress(\n   137→  frame: number,\n   138→  startFrame: number,\n   139→  endFrame: number\n   140→): { sceneFrame: number; sceneDuration: number; sceneProgress: number } {\n   141→  const sceneFrame = Math.max(0, frame - startFrame);\n   142→  const sceneDuration = endFrame - startFrame;\n   143→  const sceneProgress = Math.min(1, sceneFrame / sceneDuration);\n   144→  return { sceneFrame, sceneDuration, sceneProgress };\n   145→}\n   146→\n   147→/**\n   148→ * Helper to check if a frame is within a scene\n   149→ */\n   150→export function isFrameInScene(\n   151→  frame: number,\n   152→  scene: SceneDefinition\n   153→): boolean {\n   154→  return frame >= scene.startFrame && frame < scene.endFrame;\n   155→}\n   156→\n   157→/**\n   158→ * Get the current scene for a given frame\n   159→ */\n   160→export function getCurrentScene(\n   161→  frame: number,\n   162→  scenes: SceneDefinition[]\n   163→): SceneDefinition | null {\n   164→  return scenes.find(scene => isFrameInScene(frame, scene)) || null;\n   165→}\n   166→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01RXtY2QPAvhrW5UxujdPX7p","session_id":"05d3e4f1-2259-4f3e-a055-8040a34c8b02","uuid":"b67ce4c5-3c58-44dd-9112-9b3aa61b8f22"}
