or\\src\\services\\report_components.py","C:\\Users\\mkdol\\dolla\\res\\actor\\src\\services\\report_component_renderer.py","C:\\Users\\mkdol\\dolla\\res\\actor\\src\\services\\report_component_styles.py","C:\\Users\\mkdol\\dolla\\res\\actor\\src\\services\\state.py","C:\\Users\\mkdol\\dolla\\res\\actor\\src\\services\\transform.py","C:\\Users\\mkdol\\dolla\\res\\actor\\src\\services\\research.py","C:\\Users\\mkdol\\dolla\\res\\actor\\src\\services\\report.py","C:\\Users\\mkdol\\dolla\\res\\actor\\src\\services\\visualizations.py","C:\\Users\\mkdol\\dolla\\res\\actor\\src\\services\\report_interactive.py","C:\\Users\\mkdol\\dolla\\res\\actor\\src\\services\\intelligence.py"],"durationMs":343,"numFiles":17,"truncated":false}}
