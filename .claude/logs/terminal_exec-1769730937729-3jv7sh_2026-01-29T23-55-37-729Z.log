[2026-01-29T23:56:27.237Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0114uKHZYhecf4bEt7PKZd5f","type":"tool_result","content":"     1→\"\"\"Bayesian confidence model for explainable AI confidence scores.\n     2→\n     3→This module implements a proper Bayesian inference model for calculating\n     4→confidence scores, making them interpretable and actionable. Instead of\n     5→ad-hoc additive adjustments, this uses proper probability propagation.\n     6→\n     7→Key concepts:\n     8→- P(finding is true) depends on P(source is credible)\n     9→- P(source is credible) depends on P(domain is authoritative)\n    10→- All probabilities are properly multiplied, not added\n    11→- Explanations are generated showing the reasoning chain\n    12→\"\"\"\n    13→\n    14→from dataclasses import dataclass, field\n    15→from typing import Any, Dict, List, Optional, Tuple\n    16→from enum import Enum\n    17→import math\n    18→\n    19→\n    20→class EvidenceType(Enum):\n    21→    \"\"\"Types of evidence that can affect confidence.\"\"\"\n    22→    SOURCE_CREDIBILITY = \"source_credibility\"\n    23→    CROSS_REFERENCE = \"cross_reference\"\n    24→    BIAS_DETECTION = \"bias_detection\"\n    25→    EXPERT_SANITY = \"expert_sanity\"\n    26→    CORROBORATION = \"corroboration\"\n    27→    CONTRADICTION = \"contradiction\"\n    28→\n    29→\n    30→@dataclass\n    31→class EvidenceNode:\n    32→    \"\"\"Represents a piece of evidence in the Bayesian network.\n    33→\n    34→    Each node has:\n    35→    - prior: Base probability before considering this evidence\n    36→    - likelihood: P(evidence | hypothesis is true)\n    37→    - marginal: P(evidence) - the probability of seeing this evidence\n    38→    - posterior: Calculated P(hypothesis | evidence)\n    39→    \"\"\"\n    40→    evidence_type: EvidenceType\n    41→    name: str\n    42→    prior: float\n    43→    likelihood: float\n    44→    marginal: float\n    45→    posterior: float = 0.0\n    46→    explanation: str = \"\"\n    47→    raw_data: Optional[Dict[str, Any]] = None\n    48→\n    49→    def __post_init__(self):\n    50→        \"\"\"Calculate posterior using Bayes' theorem.\"\"\"\n    51→        if self.marginal > 0:\n    52→            self.posterior = (self.likelihood * self.prior) / self.marginal\n    53→        else:\n    54→            self.posterior = self.prior\n    55→\n    56→    def to_dict(self) -> Dict[str, Any]:\n    57→        \"\"\"Convert to dictionary for serialization.\"\"\"\n    58→        return {\n    59→            \"evidence_type\": self.evidence_type.value,\n    60→            \"name\": self.name,\n    61→            \"prior\": round(self.prior, 4),\n    62→            \"likelihood\": round(self.likelihood, 4),\n    63→            \"marginal\": round(self.marginal, 4),\n    64→            \"posterior\": round(self.posterior, 4),\n    65→            \"explanation\": self.explanation,\n    66→        }\n    67→\n    68→\n    69→@dataclass\n    70→class ConfidenceExplanation:\n    71→    \"\"\"Structured explanation of how confidence was calculated.\"\"\"\n    72→\n    73→    base_confidence: float\n    74→    final_confidence: float\n    75→    evidence_chain: List[EvidenceNode] = field(default_factory=list)\n    76→    summary: str = \"\"\n    77→    what_would_increase: List[str] = field(default_factory=list)\n    78→    what_would_decrease: List[str] = field(default_factory=list)\n    79→\n    80→    def to_dict(self) -> Dict[str, Any]:\n    81→        \"\"\"Convert to dictionary for serialization.\"\"\"\n    82→        return {\n    83→            \"base_confidence\": round(self.base_confidence, 4),\n    84→            \"final_confidence\": round(self.final_confidence, 4),\n    85→            \"summary\": self.summary,\n    86→            \"evidence_chain\": [e.to_dict() for e in self.evidence_chain],\n    87→            \"what_would_increase\": self.what_would_increase,\n    88→            \"what_would_decrease\": self.what_would_decrease,\n    89→        }\n    90→\n    91→    def generate_narrative(self) -> str:\n    92→        \"\"\"Generate human-readable explanation of confidence.\"\"\"\n    93→        lines = []\n    94→        pct = lambda x: f\"{x*100:.0f}%\"\n    95→\n    96→        lines.append(f\"This finding has {pct(self.final_confidence)} confidence.\")\n    97→        lines.append(\"\")\n    98→        lines.append(\"Reasoning:\")\n    99→        lines.append(f\"  - Started with {pct(self.base_confidence)} base confidence\")\n   100→\n   101→        for evidence in self.evidence_chain:\n   102→            impact = evidence.posterior - evidence.prior\n   103→            direction = \"increased\" if impact > 0 else \"decreased\"\n   104→            lines.append(f\"  - {evidence.name}: {direction} to {pct(evidence.posterior)}\")\n   105→            if evidence.explanation:\n   106→                lines.append(f\"    ({evidence.explanation})\")\n   107→\n   108→        if self.what_would_increase:\n   109→            lines.append(\"\")\n   110→            lines.append(\"To increase confidence:\")\n   111→            for item in self.what_would_increase[:3]:\n   112→                lines.append(f\"  - {item}\")\n   113→\n   114→        if self.what_would_decrease:\n   115→            lines.append(\"\")\n   116→            lines.append(\"Factors that could lower confidence:\")\n   117→            for item in self.what_would_decrease[:3]:\n   118→                lines.append(f\"  - {item}\")\n   119→\n   120→        return \"\\n\".join(lines)\n   121→\n   122→\n   123→class BayesianConfidenceCalculator:\n   124→    \"\"\"Calculates confidence using Bayesian inference.\n   125→\n   126→    This replaces the additive adjustment model with proper probabilistic\n   127→    inference, making confidence scores interpretable and actionable.\n   128→    \"\"\"\n   129→\n   130→    # Domain authority priors - P(domain is authoritative)\n   131→    DOMAIN_AUTHORITY_PRIORS: Dict[str, float] = {\n   132→        # Highest authority - government and academic\n   133→        \"gov\": 0.95,\n   134→        \"edu\": 0.92,\n   135→        \"mil\": 0.93,\n   136→\n   137→        # High authority - major wire services and papers of record\n   138→        \"reuters.com\": 0.90,\n   139→        \"apnews.com\": 0.90,\n   140→        \"bbc.com\": 0.88,\n   141→        \"nytimes.com\": 0.87,\n   142→        \"wsj.com\": 0.88,\n   143→        \"ft.com\": 0.87,\n   144→        \"bloomberg.com\": 0.86,\n   145→        \"sec.gov\": 0.95,\n   146→\n   147→        # Medium-high authority - quality publications\n   148→        \"forbes.com\": 0.75,\n   149→        \"businessinsider.com\": 0.70,\n   150→        \"cnbc.com\": 0.72,\n   151→        \"marketwatch.com\": 0.70,\n   152→        \"washingtonpost.com\": 0.80,\n   153→        \"economist.com\": 0.85,\n   154→        \"nature.com\": 0.92,\n   155→        \"sciencedirect.com\": 0.88,\n   156→\n   157→        # Tech-focused high authority\n   158→        \"github.com\": 0.75,\n   159→        \"stackoverflow.com\": 0.70,\n   160→        \"arxiv.org\": 0.85,\n   161→        \"acm.org\": 0.88,\n   162→        \"ieee.org\": 0.88,\n   163→    }\n   164→\n   165→    # Default prior for unknown domains\n   166→    DEFAULT_DOMAIN_PRIOR = 0.50\n   167→\n   168→    def __init__(self):\n   169→        self.evidence_nodes: List[EvidenceNode] = []\n   170→\n   171→    def reset(self):\n   172→        \"\"\"Reset evidence chain for new calculation.\"\"\"\n   173→        self.evidence_nodes = []\n   174→\n   175→    def get_domain_authority(self, domain: str) -> Tuple[float, str]:\n   176→        \"\"\"Get domain authority prior probability.\n   177→\n   178→        Returns:\n   179→            Tuple of (probability, explanation)\n   180→        \"\"\"\n   181→        domain_lower = domain.lower()\n   182→\n   183→        # Check for exact match first\n   184→        if domain_lower in self.DOMAIN_AUTHORITY_PRIORS:\n   185→            prob = self.DOMAIN_AUTHORITY_PRIORS[domain_lower]\n   186→            return prob, f\"Known authoritative domain: {domain}\"\n   187→\n   188→        # Check for TLD-based matches\n   189→        for tld in [\"gov\", \"edu\", \"mil\"]:\n   190→            if domain_lower.endswith(f\".{tld}\"):\n   191→                prob = self.DOMAIN_AUTHORITY_PRIORS[tld]\n   192→                return prob, f\"Authoritative {tld.upper()} domain\"\n   193→\n   194→        # Check for partial domain matches\n   195→        for known_domain, prob in self.DOMAIN_AUTHORITY_PRIORS.items():\n   196→            if known_domain in domain_lower:\n   197→                return prob, f\"Associated with {known_domain}\"\n   198→\n   199→        return self.DEFAULT_DOMAIN_PRIOR, \"Unknown domain - using default prior\"\n   200→\n   201→    def calculate_source_credibility(\n   202→        self,\n   203→        source: Dict[str, Any],\n   204→    ) -> Tuple[float, EvidenceNode]:\n   205→        \"\"\"Calculate P(source is credible) using Bayesian inference.\n   206→\n   207→        The model:\n   208→        - P(credible | domain) = P(domain authoritative) * P(content quality)\n   209→        - Domain authority is a strong prior\n   210→        - Content indicators can adjust\n   211→\n   212→        Returns:\n   213→            Tuple of (credibility_score, evidence_node)\n   214→        \"\"\"\n   215→        domain = source.get(\"domain\", \"\")\n   216→\n   217→        # Get domain authority as prior\n   218→        domain_prior, domain_explanation = self.get_domain_authority(domain)\n   219→\n   220→        # Estimate content quality likelihood from available signals\n   221→        # P(quality content | source is credible) vs P(quality content | not credible)\n   222→        content_signals = self._assess_content_signals(source)\n   223→\n   224→        # Calculate using simplified Bayesian update\n   225→        # P(credible | signals) = P(signals | credible) * P(credible) / P(signals)\n   226→        likelihood_if_credible = content_signals\n   227→        likelihood_if_not_credible = 1 - content_signals\n   228→\n   229→        # Marginal: P(signals) = P(signals|credible)*P(credible) + P(signals|not)*P(not)\n   230→        marginal = (\n   231→            likelihood_if_credible * domain_prior +\n   232→            likelihood_if_not_credible * (1 - domain_prior)\n   233→        )\n   234→\n   235→        # Posterior: P(credible | signals)\n   236→        if marginal > 0:\n   237→            posterior = (likelihood_if_credible * domain_prior) / marginal\n   238→        else:\n   239→            posterior = domain_prior\n   240→\n   241→        # Clamp to reasonable range\n   242→        posterior = max(0.1, min(0.95, posterior))\n   243→\n   244→        evidence = EvidenceNode(\n   245→            evidence_type=EvidenceType.SOURCE_CREDIBILITY,\n   246→            name=f\"Source: {domain}\",\n   247→            prior=domain_prior,\n   248→            likelihood=likelihood_if_credible,\n   249→            marginal=marginal,\n   250→            posterior=posterior,\n   251→            explanation=domain_explanation,\n   252→            raw_data={\"domain\": domain, \"content_signals\": content_signals}\n   253→        )\n   254→\n   255→        return posterior, evidence\n   256→\n   257→    def _assess_content_signals(self, source: Dict[str, Any]) -> float:\n   258→        \"\"\"Assess content quality signals from source metadata.\n   259→\n   260→        Returns probability that content is high quality given observable signals.\n   261→        \"\"\"\n   262→        signals_score = 0.5  # Start at neutral\n   263→\n   264→        title = source.get(\"title\", \"\")\n   265→        snippet = source.get(\"snippet\", \"\")\n   266→        source_type = source.get(\"source_type\", \"web\")\n   267→\n   268→        # Title quality signals\n   269→        if title:\n   270→            # Longer, descriptive titles tend to be higher quality\n   271→            if len(title) > 30:\n   272→                signals_score += 0.05\n   273→            if len(title) > 60:\n   274→                signals_score += 0.05\n   275→\n   276→            # Marketing language is a negative signal\n   277→            marketing_words = [\"best\", \"top\", \"amazing\", \"revolutionary\", \"guaranteed\"]\n   278→            if any(w in title.lower() for w in marketing_words):\n   279→                signals_score -= 0.10\n   280→\n   281→        # Snippet quality signals\n   282→        if snippet:\n   283→            # Substantive snippets suggest better content\n   284→            if len(snippet) > 100:\n   285→                signals_score += 0.05\n   286→\n   287→            # Contains numbers/data (suggests factual content)\n   288→            if any(c.isdigit() for c in snippet):\n   289→                signals_score += 0.05\n   290→\n   291→        # Source type signals\n   292→        if source_type == \"academic\":\n   293→            signals_score += 0.15\n   294→        elif source_type == \"news\":\n   295→            signals_score += 0.05\n   296→        elif source_type == \"blog\":\n   297→            signals_score -= 0.05\n   298→        elif source_type == \"social\":\n   299→            signals_score -= 0.10\n   300→\n   301→        return max(0.1, min(0.9, signals_score))\n   302→\n   303→    def calculate_finding_confidence(\n   304→        self,\n   305→        finding: Dict[str, Any],\n   306→        sources: List[Dict[str, Any]],\n   307→        verification: Optional[Dict[str, Any]] = None,\n   308→    ) -> Tuple[float, ConfidenceExplanation]:\n   309→        \"\"\"Calculate P(finding is true) using full Bayesian network.\n   310→\n   311→        The network structure:\n   312→        - P(finding true) depends on P(sources credible)\n   313→        - Multiple credible sources increase confidence (corroboration)\n   314→        - Bias detection decreases confidence\n   315→        - Expert sanity check can increase or decrease\n   316→\n   317→        Returns:\n   318→            Tuple of (confidence_score, explanation)\n   319→        \"\"\"\n   320→        self.reset()\n   321→\n   322→        # Start with base confidence from finding extraction\n   323→        base_confidence = finding.get(\"confidence_score\", 0.5)\n   324→\n   325→        # Track cumulative probability\n   326→        current_confidence = base_confidence\n   327→\n   328→        # Phase 1: Source credibility\n   329→        # P(finding | sources) = product of P(source_i credible) for corroborating sources\n   330→        source_posteriors = []\n   331→        for source in sources[:5]:  # Limit to top 5 sources\n   332→            cred_score, evidence = self.calculate_source_credibility(source)\n   333→            source_posteriors.append(cred_score)\n   334→            self.evidence_nodes.append(evidence)\n   335→\n   336→        if source_posteriors:\n   337→            # Combine source credibilities using Bayesian combination\n   338→            # Multiple agreeing sources increase confidence\n   339→            combined_source_cred = self._combine_source_credibilities(source_posteriors)\n   340→\n   341→            # Update confidence based on source credibility\n   342→            # P(finding | sources) = P(finding) * adjustment_factor\n   343→            source_adjustment = self._calculate_source_adjustment(\n   344→                base_confidence, combined_source_cred\n   345→            )\n   346→            current_confidence = source_adjustment\n   347→\n   348→            self.evidence_nodes.append(EvidenceNode(\n   349→                evidence_type=EvidenceType.CORROBORATION,\n   350→                name=\"Source Agreement\",\n   351→                prior=base_confidence,\n   352→                likelihood=combined_source_cred,\n   353→                marginal=0.5,  # Neutral marginal\n   354→                posterior=current_confidence,\n   355→                explanation=f\"Combined credibility from {len(source_posteriors)} sources\"\n   356→            ))\n   357→\n   358→        # Phase 2: Verification adjustments\n   359→        if verification:\n   360→            current_confidence = self._apply_verification_evidence(\n   361→                current_confidence, verification\n   362→            )\n   363→\n   364→        # Generate explanation\n   365→        explanation = self._generate_explanation(\n   366→            base_confidence, current_confidence, finding, sources\n   367→        )\n   368→\n   369→        # Clamp final result\n   370→        final_confidence = max(0.1, min(0.95, current_confidence))\n   371→        explanation.final_confidence = final_confidence\n   372→\n   373→        return final_confidence, explanation\n   374→\n   375→    def _combine_source_credibilities(self, credibilities: List[float]) -> float:\n   376→        \"\"\"Combine multiple source credibilities using Bayesian update.\n   377→\n   378→        Multiple independent credible sources increase confidence:\n   379→        P(true | source1, source2) > P(true | source1) if source2 corroborates\n   380→\n   381→        We use a log-odds model for combining evidence.\n   382→        \"\"\"\n   383→        if not credibilities:\n   384→            return 0.5\n   385→\n   386→        if len(credibilities) == 1:\n   387→            return credibilities[0]\n   388→\n   389→        # Convert to log-odds and sum\n   390→        log_odds = []\n   391→        for p in credibilities:\n   392→            # Clamp to avoid log(0)\n   393→            p = max(0.01, min(0.99, p))\n   394→            log_odds.append(math.log(p / (1 - p)))\n   395→\n   396→        # Average log-odds (for independent evidence this is additive)\n   397→        # But we use a weighted average with diminishing returns\n   398→        # First source has full weight, subsequent sources have reduced weight\n   399→        weights = [1.0 / (i + 1) for i in range(len(log_odds))]\n   400→        total_weight = sum(weights)\n   401→        weighted_log_odds = sum(lo * w for lo, w in zip(log_odds, weights)) / total_weight\n   402→\n   403→        # Convert back to probability\n   404→        combined = 1 / (1 + math.exp(-weighted_log_odds))\n   405→\n   406→        # Apply bonus for multiple sources (corroboration boost)\n   407→        if len(credibilities) >= 3:\n   408→            combined = combined * 1.05  # 5% boost for 3+ sources\n   409→        if len(credibilities) >= 5:\n   410→            combined = combined * 1.05  # Additional 5% boost for 5+ sources\n   411→\n   412→        return min(0.95, combined)\n   413→\n   414→    def _calculate_source_adjustment(\n   415→        self,\n   416→        base_confidence: float,\n   417→        source_credibility: float\n   418→    ) -> float:\n   419→        \"\"\"Calculate adjusted confidence based on source credibility.\n   420→\n   421→        Uses a Bayesian update where source credibility affects our belief\n   422→        in the finding being true.\n   423→        \"\"\"\n   424→        # P(finding | sources) = P(sources support finding | finding true) * P(finding) / P(sources support)\n   425→        # Simplified: we weight the base confidence by source credibility\n   426→\n   427→        # If sources are highly credible, pull confidence toward their level\n   428→        # If sources are low credibility, pull down\n   429→\n   430→        # Weight based on how much evidence we have\n   431→        weight = 0.4  # How much source credibility affects the final score\n   432→\n   433→        adjusted = (1 - weight) * base_confidence + weight * source_credibility\n   434→\n   435→        return adjusted\n   436→\n   437→    def _apply_verification_evidence(\n   438→        self,\n   439→        current_confidence: float,\n   440→        verification: Dict[str, Any],\n   441→    ) -> float:\n   442→        \"\"\"Apply verification results using Bayesian updates.\n   443→\n   444→        Unlike additive adjustments, we use proper probability updates.\n   445→        \"\"\"\n   446→        confidence = current_confidence\n   447→\n   448→        # Bias detection evidence\n   449→        if \"bias\" in verification:\n   450→            bias = verification[\"bias\"]\n   451→            bias_score = bias.get(\"bias_score\", 0.0)\n   452→\n   453→            if bias_score > 0.3:\n   454→                # High bias detected - this is evidence against the finding\n   455→                # P(finding true | bias detected) = P(bias | true) * P(true) / P(bias)\n   456→                # If source is biased, less likely finding is objective truth\n   457→\n   458→                # Likelihood ratio: P(bias | finding true) / P(bias | finding false)\n   459→                # Biased sources more likely to push false narratives\n   460→                likelihood_ratio = 0.7 - (bias_score * 0.4)  # 0.3 to 0.7\n   461→\n   462→                confidence = self._bayesian_update(\n   463→                    prior=confidence,\n   464→                    likelihood_ratio=likelihood_ratio\n   465→                )\n   466→\n   467→                self.evidence_nodes.append(EvidenceNode(\n   468→                    evidence_type=EvidenceType.BIAS_DETECTION,\n   469→                    name=\"Bias Detection\",\n   470→                    prior=current_confidence,\n   471→                    likelihood=likelihood_ratio,\n   472→                    marginal=0.5,\n   473→                    posterior=confidence,\n   474→                    explanation=f\"Bias score: {bias_score:.2f} - {bias.get('bias_type', 'unknown')}\",\n   475→                    raw_data=bias\n   476→                ))\n   477→\n   478→        # Expert sanity check evidence\n   479→        if \"expert_check\" in verification:\n   480→            expert = verification[\"expert_check\"]\n   481→            plausibility = expert.get(\"plausibility\", \"plausible\")\n   482→            plausibility_score = expert.get(\"plausibility_score\", 0.7)\n   483→\n   484→            # Expert judgment provides strong evidence\n   485→            if plausibility == \"implausible\":\n   486→                # Strong evidence against\n   487→                likelihood_ratio = 0.3\n   488→                explanation = \"Expert assessment: claim is implausible\"\n   489→            elif plausibility == \"questionable\":\n   490→                # Moderate evidence against\n   491→                likelihood_ratio = 0.6\n   492→                explanation = \"Expert assessment: claim is questionable\"\n   493→            else:\n   494→                # Slight positive evidence\n   495→                likelihood_ratio = 1.0 + (plausibility_score - 0.7) * 0.3\n   496→                explanation = f\"Expert assessment: claim is plausible ({plausibility_score:.0%})\"\n   497→\n   498→            prior = confidence\n   499→            confidence = self._bayesian_update(\n   500→                prior=confidence,\n   501→                likelihood_ratio=likelihood_ratio\n   502→            )\n   503→\n   504→            self.evidence_nodes.append(EvidenceNode(\n   505→                evidence_type=EvidenceType.EXPERT_SANITY,\n   506→                name=\"Expert Sanity Check\",\n   507→                prior=prior,\n   508→                likelihood=likelihood_ratio if likelihood_ratio <= 1 else 1/likelihood_ratio,\n   509→                marginal=0.5,\n   510→                posterior=confidence,\n   511→                explanation=explanation,\n   512→                raw_data=expert\n   513→            ))\n   514→\n   515→            # Flag extraordinary claims\n   516→            if expert.get(\"extraordinary_claim\", False):\n   517→                # Extraordinary claims require extraordinary evidence\n   518→                confidence = confidence * 0.85\n   519→                self.evidence_nodes.append(EvidenceNode(\n   520→                    evidence_type=EvidenceType.EXPERT_SANITY,\n   521→                    name=\"Extraordinary Claim Flag\",\n   522→                    prior=confidence / 0.85,\n   523→                    likelihood=0.85,\n   524→                    marginal=0.5,\n   525→                    posterior=confidence,\n   526→                    explanation=\"Extraordinary claim requires stronger evidence\"\n   527→                ))\n   528→\n   529→        # Cross-reference evidence\n   530→        if \"cross_reference\" in verification:\n   531→            cross_ref = verification[\"cross_reference\"]\n   532→            corroboration = cross_ref.get(\"corroboration_level\", \"unknown\")\n   533→\n   534→            # Cross-reference provides corroboration evidence\n   535→            corroboration_map = {\n   536→                \"strong\": 1.3,      # Strong positive evidence\n   537→                \"moderate\": 1.1,    # Moderate positive\n   538→                \"weak\": 0.95,       # Slight negative\n   539→                \"uncorroborated\": 0.8,  # No corroboration is weak negative\n   540→                \"unknown\": 1.0      # Neutral\n   541→            }\n   542→\n   543→            likelihood_ratio = corroboration_map.get(corroboration, 1.0)\n   544→\n   545→            # Check for contradictions\n   546→            contradictions = cross_ref.get(\"contradicting_findings\", [])\n   547→            if contradictions:\n   548→                # Each contradiction is evidence against\n   549→                likelihood_ratio *= (0.9 ** len(contradictions))\n   550→\n   551→            prior = confidence\n   552→            confidence = self._bayesian_update(\n   553→                prior=confidence,\n   554→                likelihood_ratio=likelihood_ratio\n   555→            )\n   556→\n   557→            explanation = f\"Cross-reference: {corroboration}\"\n   558→            if contradictions:\n   559→                explanation += f\" ({len(contradictions)} contradictions)\"\n   560→\n   561→            self.evidence_nodes.append(EvidenceNode(\n   562→                evidence_type=EvidenceType.CROSS_REFERENCE,\n   563→                name=\"Cross-Reference Analysis\",\n   564→                prior=prior,\n   565→                likelihood=min(1.0, likelihood_ratio),\n   566→                marginal=0.5,\n   567→                posterior=confidence,\n   568→                explanation=explanation,\n   569→                raw_data=cross_ref\n   570→            ))\n   571→\n   572→        return confidence\n   573→\n   574→    def _bayesian_update(\n   575→        self,\n   576→        prior: float,\n   577→        likelihood_ratio: float,\n   578→    ) -> float:\n   579→        \"\"\"Apply Bayesian update using likelihood ratio.\n   580→\n   581→        posterior_odds = likelihood_ratio * prior_odds\n   582→\n   583→        Args:\n   584→            prior: Prior probability P(H)\n   585→            likelihood_ratio: P(E|H) / P(E|not H)\n   586→\n   587→        Returns:\n   588→            Posterior probability P(H|E)\n   589→        \"\"\"\n   590→        # Convert to odds\n   591→        if prior >= 0.99:\n   592→            prior = 0.99\n   593→        if prior <= 0.01:\n   594→            prior = 0.01\n   595→\n   596→        prior_odds = prior / (1 - prior)\n   597→\n   598→        # Update odds\n   599→        posterior_odds = likelihood_ratio * prior_odds\n   600→\n   601→        # Convert back to probability\n   602→        posterior = posterior_odds / (1 + posterior_odds)\n   603→\n   604→        return max(0.1, min(0.95, posterior))\n   605→\n   606→    def _generate_explanation(\n   607→        self,\n   608→        base_confidence: float,\n   609→        final_confidence: float,\n   610→        finding: Dict[str, Any],\n   611→        sources: List[Dict[str, Any]],\n   612→    ) -> ConfidenceExplanation:\n   613→        \"\"\"Generate structured explanation of confidence calculation.\"\"\"\n   614→\n   615→        # Determine what would increase confidence\n   616→        what_would_increase = []\n   617→        what_would_decrease = []\n   618→\n   619→        # Check source diversity\n   620→        domains = set(s.get(\"domain\", \"\") for s in sources)\n   621→        if len(domains) < 3:\n   622→            what_would_increase.append(\n   623→                \"Additional corroborating sources from different domains\"\n   624→            )\n   625→\n   626→        # Check for high-authority sources\n   627→        high_auth_count = sum(\n   628→            1 for s in sources\n   629→            if self.get_domain_authority(s.get(\"domain\", \"\"))[0] > 0.8\n   630→        )\n   631→        if high_auth_count < 2:\n   632→            what_would_increase.append(\n   633→                \"Citations from authoritative sources (academic, government, major publications)\"\n   634→            )\n   635→\n   636→        # Check verification status\n   637→        for node in self.evidence_nodes:\n   638→            if node.evidence_type == EvidenceType.BIAS_DETECTION:\n   639→                if node.posterior < node.prior:\n   640→                    what_would_decrease.append(\n   641→                        f\"Bias detected: {node.explanation}\"\n   642→                    )\n   643→            if node.evidence_type == EvidenceType.EXPERT_SANITY:\n   644→                if \"implausible\" in node.explanation.lower():\n   645→                    what_would_decrease.append(\n   646→                        \"Expert assessment flagged claim as implausible\"\n   647→                    )\n   648→                elif \"questionable\" in node.explanation.lower():\n   649→                    what_would_decrease.append(\n   650→                        \"Expert assessment flagged claim as questionable\"\n   651→                    )\n   652→\n   653→        # Add general factors\n   654→        if final_confidence < 0.7:\n   655→            what_would_increase.append(\n   656→                \"Verification by independent fact-checking\"\n   657→            )\n   658→\n   659→        if final_confidence > 0.8:\n   660→            what_would_decrease.append(\n   661→                \"Discovery of conflicting evidence or retractions\"\n   662→            )\n   663→\n   664→        # Generate summary\n   665→        pct = lambda x: f\"{x*100:.0f}%\"\n   666→\n   667→        if final_confidence >= base_confidence + 0.1:\n   668→            summary = (\n   669→                f\"Confidence increased from {pct(base_confidence)} to {pct(final_confidence)} \"\n   670→                f\"due to corroborating evidence from credible sources.\"\n   671→            )\n   672→        elif final_confidence <= base_confidence - 0.1:\n   673→            summary = (\n   674→                f\"Confidence decreased from {pct(base_confidence)} to {pct(final_confidence)} \"\n   675→                f\"due to verification concerns (bias, plausibility, or lack of corroboration).\"\n   676→            )\n   677→        else:\n   678→            summary = (\n   679→                f\"Confidence of {pct(final_confidence)} reflects balanced evidence \"\n   680→                f\"from the available sources and verification checks.\"\n   681→            )\n   682→\n   683→        return ConfidenceExplanation(\n   684→            base_confidence=base_confidence,\n   685→            final_confidence=final_confidence,\n   686→            evidence_chain=self.evidence_nodes.copy(),\n   687→            summary=summary,\n   688→            what_would_increase=what_would_increase[:5],\n   689→            what_would_decrease=what_would_decrease[:5],\n   690→        )\n   691→\n   692→\n   693→def calculate_bayesian_confidence(\n   694→    finding: Dict[str, Any],\n   695→    sources: List[Dict[str, Any]],\n   696→    verification: Optional[Dict[str, Any]] = None,\n   697→) -> Tuple[float, ConfidenceExplanation]:\n   698→    \"\"\"Convenience function for calculating Bayesian confidence.\n   699→\n   700→    Args:\n   701→        finding: Finding dictionary with confidence_score\n   702→        sources: List of source dictionaries\n   703→        verification: Optional verification results\n   704→\n   705→    Returns:\n   706→        Tuple of (confidence_score, explanation)\n   707→    \"\"\"\n   708→    calculator = BayesianConfidenceCalculator()\n   709→    return calculator.calculate_finding_confidence(finding, sources, verification)\n   710→\n   711→\n   712→def calculate_source_credibility(source: Dict[str, Any]) -> Tuple[float, str]:\n   713→    \"\"\"Calculate credibility score for a single source.\n   714→\n   715→    Returns:\n   716→        Tuple of (credibility_score, explanation_string)\n   717→    \"\"\"\n   718→    calculator = BayesianConfidenceCalculator()\n   719→    score, evidence = calculator.calculate_source_credibility(source)\n   720→    return score, evidence.explanation\n   721→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"05d3e4f1-2259-4f3e-a055-8040a34c8b02","uuid":"7573589c-a88b-42be-b2e3-f3c0e728b383","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\actor\\src\\services\\bayesian_confidence.py","content":"\"\"\"Bayesian confidence model for explainable AI confidence scores.\n\nThis module implements a proper Bayesian inference model for calculating\nconfidence scores, making them interpretable and actionable. Instead of\nad-hoc additive adjustments, this uses proper probability propagation.\n\nKey concepts:\n- P(finding is true) depends on P(source is credible)\n- P(source is credible) depends on P(domain is authoritative)\n- All probabilities are properly multiplied, not added\n- Explanations are generated showing the reasoning chain\n\"\"\"\n\nfrom dataclasses import dataclass, field\nfrom typing import Any, Dict, List, Optional, Tuple\nfrom enum import Enum\nimport math\n\n\nclass EvidenceType(Enum):\n    \"\"\"Types of evidence that can affect confidence.\"\"\"\n    SOURCE_CREDIBILITY = \"source_credibility\"\n    CROSS_REFERENCE = \"cross_reference\"\n    BIAS_DETECTION = \"bias_detection\"\n    EXPERT_SANITY = \"expert_sanity\"\n    CORROBORATION = \"corroboration\"\n    CONTRADICTION = \"contradiction\"\n\n\n@dataclass\nclass EvidenceNode:\n    \"\"\"Represents a piece of evidence in the Bayesian network.\n\n    Each node has:\n    - prior: Base probability before considering this evidence\n    - likelihood: P(evidence | hypothesis is true)\n    - marginal: P(evidence) - the probability of seeing this evidence\n    - posterior: Calculated P(hypothesis | evidence)\n    \"\"\"\n    evidence_type: EvidenceType\n    name: str\n    prior: float\n    likelihood: float\n    marginal: float\n    posterior: float = 0.0\n    explanation: str = \"\"\n    raw_data: Optional[Dict[str, Any]] = None\n\n    def __post_init__(self):\n        \"\"\"Calculate posterior using Bayes' theorem.\"\"\"\n        if self.marginal > 0:\n            self.posterior = (self.likelihood * self.prior) / self.marginal\n        else:\n            self.posterior = self.prior\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Convert to dictionary for serialization.\"\"\"\n        return {\n            \"evidence_type\": self.evidence_type.value,\n            \"name\": self.name,\n            \"prior\": round(self.prior, 4),\n            \"likelihood\": round(self.likelihood, 4),\n            \"marginal\": round(self.marginal, 4),\n            \"posterior\": round(self.posterior, 4),\n            \"explanation\": self.explanation,\n        }\n\n\n@dataclass\nclass ConfidenceExplanation:\n    \"\"\"Structured explanation of how confidence was calculated.\"\"\"\n\n    base_confidence: float\n    final_confidence: float\n    evidence_chain: List[EvidenceNode] = field(default_factory=list)\n    summary: str = \"\"\n    what_would_increase: List[str] = field(default_factory=list)\n    what_would_decrease: List[str] = field(default_factory=list)\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Convert to dictionary for serialization.\"\"\"\n        return {\n            \"base_confidence\": round(self.base_confidence, 4),\n            \"final_confidence\": round(self.final_confidence, 4),\n            \"summary\": self.summary,\n            \"evidence_chain\": [e.to_dict() for e in self.evidence_chain],\n            \"what_would_increase\": self.what_would_increase,\n            \"what_would_decrease\": self.what_would_decrease,\n        }\n\n    def generate_narrative(self) -> str:\n        \"\"\"Generate human-readable explanation of confidence.\"\"\"\n        lines = []\n        pct = lambda x: f\"{x*100:.0f}%\"\n\n        lines.append(f\"This finding has {pct(self.final_confidence)} confidence.\")\n        lines.append(\"\")\n        lines.append(\"Reasoning:\")\n        lines.append(f\"  - Started with {pct(self.base_confidence)} base confidence\")\n\n        for evidence in self.evidence_chain:\n            impact = evidence.posterior - evidence.prior\n            direction = \"increased\" if impact > 0 else \"decreased\"\n            lines.append(f\"  - {evidence.name}: {direction} to {pct(evidence.posterior)}\")\n            if evidence.explanation:\n                lines.append(f\"    ({evidence.explanation})\")\n\n        if self.what_would_increase:\n            lines.append(\"\")\n            lines.append(\"To increase confidence:\")\n            for item in self.what_would_increase[:3]:\n                lines.append(f\"  - {item}\")\n\n        if self.what_would_decrease:\n            lines.append(\"\")\n            lines.append(\"Factors that could lower confidence:\")\n            for item in self.what_would_decrease[:3]:\n                lines.append(f\"  - {item}\")\n\n        return \"\\n\".join(lines)\n\n\nclass BayesianConfidenceCalculator:\n    \"\"\"Calculates confidence using Bayesian inference.\n\n    This replaces the additive adjustment model with proper probabilistic\n    inference, making confidence scores interpretable and actionable.\n    \"\"\"\n\n    # Domain authority priors - P(domain is authoritative)\n    DOMAIN_AUTHORITY_PRIORS: Dict[str, float] = {\n        # Highest authority - government and academic\n        \"gov\": 0.95,\n        \"edu\": 0.92,\n        \"mil\": 0.93,\n\n        # High authority - major wire services and papers of record\n        \"reuters.com\": 0.90,\n        \"apnews.com\": 0.90,\n        \"bbc.com\": 0.88,\n        \"nytimes.com\": 0.87,\n        \"wsj.com\": 0.88,\n        \"ft.com\": 0.87,\n        \"bloomberg.com\": 0.86,\n        \"sec.gov\": 0.95,\n\n        # Medium-high authority - quality publications\n        \"forbes.com\": 0.75,\n        \"businessinsider.com\": 0.70,\n        \"cnbc.com\": 0.72,\n        \"marketwatch.com\": 0.70,\n        \"washingtonpost.com\": 0.80,\n        \"economist.com\": 0.85,\n        \"nature.com\": 0.92,\n        \"sciencedirect.com\": 0.88,\n\n        # Tech-focused high authority\n        \"github.com\": 0.75,\n        \"stackoverflow.com\": 0.70,\n        \"arxiv.org\": 0.85,\n        \"acm.org\": 0.88,\n        \"ieee.org\": 0.88,\n    }\n\n    # Default prior for unknown domains\n    DEFAULT_DOMAIN_PRIOR = 0.50\n\n    def __init__(self):\n        self.evidence_nodes: List[EvidenceNode] = []\n\n    def reset(self):\n        \"\"\"Reset evidence chain for new calculation.\"\"\"\n        self.evidence_nodes = []\n\n    def get_domain_authority(self, domain: str) -> Tuple[float, str]:\n        \"\"\"Get domain authority prior probability.\n\n        Returns:\n            Tuple of (probability, explanation)\n        \"\"\"\n        domain_lower = domain.lower()\n\n        # Check for exact match first\n        if domain_lower in self.DOMAIN_AUTHORITY_PRIORS:\n            prob = self.DOMAIN_AUTHORITY_PRIORS[domain_lower]\n            return prob, f\"Known authoritative domain: {domain}\"\n\n        # Check for TLD-based matches\n        for tld in [\"gov\", \"edu\", \"mil\"]:\n            if domain_lower.endswith(f\".{tld}\"):\n                prob = self.DOMAIN_AUTHORITY_PRIORS[tld]\n                return prob, f\"Authoritative {tld.upper()} domain\"\n\n        # Check for partial domain matches\n        for known_domain, prob in self.DOMAIN_AUTHORITY_PRIORS.items():\n            if known_domain in domain_lower:\n                return prob, f\"Associated with {known_domain}\"\n\n        return self.DEFAULT_DOMAIN_PRIOR, \"Unknown domain - using default prior\"\n\n    def calculate_source_credibility(\n        self,\n        source: Dict[str, Any],\n    ) -> Tuple[float, EvidenceNode]:\n        \"\"\"Calculate P(source is credible) using Bayesian inference.\n\n        The model:\n        - P(credible | domain) = P(domain authoritative) * P(content quality)\n        - Domain authority is a strong prior\n        - Content indicators can adjust\n\n        Returns:\n            Tuple of (credibility_score, evidence_node)\n        \"\"\"\n        domain = source.get(\"domain\", \"\")\n\n        # Get domain authority as prior\n        domain_prior, domain_explanation = self.get_domain_authority(domain)\n\n        # Estimate content quality likelihood from available signals\n        # P(quality content | source is credible) vs P(quality content | not credible)\n        content_signals = self._assess_content_signals(source)\n\n        # Calculate using simplified Bayesian update\n        # P(credible | signals) = P(signals | credible) * P(credible) / P(signals)\n        likelihood_if_credible = content_signals\n        likelihood_if_not_credible = 1 - content_signals\n\n        # Marginal: P(signals) = P(signals|credible)*P(credible) + P(signals|not)*P(not)\n        marginal = (\n            likelihood_if_credible * domain_prior +\n            likelihood_if_not_credible * (1 - domain_prior)\n        )\n\n        # Posterior: P(credible | signals)\n        if marginal > 0:\n            posterior = (likelihood_if_credible * domain_prior) / marginal\n        else:\n            posterior = domain_prior\n\n        # Clamp to reasonable range\n        posterior = max(0.1, min(0.95, posterior))\n\n        evidence = EvidenceNode(\n            evidence_type=EvidenceType.SOURCE_CREDIBILITY,\n            name=f\"Source: {domain}\",\n            prior=domain_prior,\n            likelihood=likelihood_if_credible,\n            marginal=marginal,\n            posterior=posterior,\n            explanation=domain_explanation,\n            raw_data={\"domain\": domain, \"content_signals\": content_signals}\n        )\n\n        return posterior, evidence\n\n    def _assess_content_signals(self, source: Dict[str, Any]) -> float:\n        \"\"\"Assess content quality signals from source metadata.\n\n        Returns probability that content is high quality given observable signals.\n        \"\"\"\n        signals_score = 0.5  # Start at neutral\n\n        title = source.get(\"title\", \"\")\n        snippet = source.get(\"snippet\", \"\")\n        source_type = source.get(\"source_type\", \"web\")\n\n        # Title quality signals\n        if title:\n            # Longer, descriptive titles tend to be higher quality\n            if len(title) > 30:\n                signals_score += 0.05\n            if len(title) > 60:\n                signals_score += 0.05\n\n            # Marketing language is a negative signal\n            marketing_words = [\"best\", \"top\", \"amazing\", \"revolutionary\", \"guaranteed\"]\n            if any(w in title.lower() for w in marketing_words):\n                signals_score -= 0.10\n\n        # Snippet quality signals\n        if snippet:\n            # Substantive snippets suggest better content\n            if len(snippet) > 100:\n                signals_score += 0.05\n\n            # Contains numbers/data (suggests factual content)\n            if any(c.isdigit() for c in snippet):\n                signals_score += 0.05\n\n        # Source type signals\n        if source_type == \"academic\":\n            signals_score += 0.15\n        elif source_type == \"news\":\n            signals_score += 0.05\n        elif source_type == \"blog\":\n            signals_score -= 0.05\n        elif source_type == \"social\":\n            signals_score -= 0.10\n\n        return max(0.1, min(0.9, signals_score))\n\n    def calculate_finding_confidence(\n        self,\n        finding: Dict[str, Any],\n        sources: List[Dict[str, Any]],\n        verification: Optional[Dict[str, Any]] = None,\n    ) -> Tuple[float, ConfidenceExplanation]:\n        \"\"\"Calculate P(finding is true) using full Bayesian network.\n\n        The network structure:\n        - P(finding true) depends on P(sources credible)\n        - Multiple credible sources increase confidence (corroboration)\n        - Bias detection decreases confidence\n        - Expert sanity check can increase or decrease\n\n        Returns:\n            Tuple of (confidence_score, explanation)\n        \"\"\"\n        self.reset()\n\n        # Start with base confidence from finding extraction\n        base_confidence = finding.get(\"confidence_score\", 0.5)\n\n        # Track cumulative probability\n        current_confidence = base_confidence\n\n        # Phase 1: Source credibility\n        # P(finding | sources) = product of P(source_i credible) for corroborating sources\n        source_posteriors = []\n        for source in sources[:5]:  # Limit to top 5 sources\n            cred_score, evidence = self.calculate_source_credibility(source)\n            source_posteriors.append(cred_score)\n            self.evidence_nodes.append(evidence)\n\n        if source_posteriors:\n            # Combine source credibilities using Bayesian combination\n            # Multiple agreeing sources increase confidence\n            combined_source_cred = self._combine_source_credibilities(source_posteriors)\n\n            # Update confidence based on source credibility\n            # P(finding | sources) = P(finding) * adjustment_factor\n            source_adjustment = self._calculate_source_adjustment(\n                base_confidence, combined_source_cred\n            )\n            current_confidence = source_adjustment\n\n            self.evidence_nodes.append(EvidenceNode(\n                evidence_type=EvidenceType.CORROBORATION,\n                name=\"Source Agreement\",\n                prior=base_confidence,\n                likelihood=combined_source_cred,\n                marginal=0.5,  # Neutral marginal\n                posterior=current_confidence,\n                explanation=f\"Combined credibility from {len(source_posteriors)} sources\"\n            ))\n\n        # Phase 2: Verification adjustments\n        if verification:\n            current_confidence = self._apply_verification_evidence(\n                current_confidence, verification\n            )\n\n        # Generate explanation\n        explanation = self._generate_explanation(\n            base_confidence, current_confidence, finding, sources\n        )\n\n        # Clamp final result\n        final_confidence = max(0.1, min(0.95, current_confidence))\n        explanation.final_confidence = final_confidence\n\n        return final_confidence, explanation\n\n    def _combine_source_credibilities(self, credibilities: List[float]) -> float:\n        \"\"\"Combine multiple source credibilities using Bayesian update.\n\n        Multiple independent credible sources increase confidence:\n        P(true | source1, source2) > P(true | source1) if source2 corroborates\n\n        We use a log-odds model for combining evidence.\n        \"\"\"\n        if not credibilities:\n            return 0.5\n\n        if len(credibilities) == 1:\n            return credibilities[0]\n\n        # Convert to log-odds and sum\n        log_odds = []\n        for p in credibilities:\n            # Clamp to avoid log(0)\n            p = max(0.01, min(0.99, p))\n            log_odds.append(math.log(p / (1 - p)))\n\n        # Average log-odds (for independent evidence this is additive)\n        # But we use a weighted average with diminishing returns\n        # First source has full weight, subsequent sources have reduced weight\n        weights = [1.0 / (i + 1) for i in range(len(log_odds))]\n        total_weight = sum(weights)\n        weighted_log_odds = sum(lo * w for lo, w in zip(log_odds, weights)) / total_weight\n\n        # Convert back to probability\n        combined = 1 / (1 + math.exp(-weighted_log_odds))\n\n        # Apply bonus for multiple sources (corroboration boost)\n        if len(credibilities) >= 3:\n            combined = combined * 1.05  # 5% boost for 3+ sources\n        if len(credibilities) >= 5:\n            combined = combined * 1.05  # Additional 5% boost for 5+ sources\n\n        return min(0.95, combined)\n\n    def _calculate_source_adjustment(\n        self,\n        base_confidence: float,\n        source_credibility: float\n    ) -> float:\n        \"\"\"Calculate adjusted confidence based on source credibility.\n\n        Uses a Bayesian update where source credibility affects our belief\n        in the finding being true.\n        \"\"\"\n        # P(finding | sources) = P(sources support finding | finding true) * P(finding) / P(sources support)\n        # Simplified: we weight the base confidence by source credibility\n\n        # If sources are highly credible, pull confidence toward their level\n        # If sources are low credibility, pull down\n\n        # Weight based on how much evidence we have\n        weight = 0.4  # How much source credibility affects the final score\n\n        adjusted = (1 - weight) * base_confidence + weight * source_credibility\n\n        return adjusted\n\n    def _apply_verification_evidence(\n        self,\n        current_confidence: float,\n        verification: Dict[str, Any],\n    ) -> float:\n        \"\"\"Apply verification results using Bayesian updates.\n\n        Unlike additive adjustments, we use proper probability updates.\n        \"\"\"\n        confidence = current_confidence\n\n        # Bias detection evidence\n        if \"bias\" in verification:\n            bias = verification[\"bias\"]\n            bias_score = bias.get(\"bias_score\", 0.0)\n\n            if bias_score > 0.3:\n                # High bias detected - this is evidence against the finding\n                # P(finding true | bias detected) = P(bias | true) * P(true) / P(bias)\n                # If source is biased, less likely finding is objective truth\n\n                # Likelihood ratio: P(bias | finding true) / P(bias | finding false)\n                # Biased sources more likely to push false narratives\n                likelihood_ratio = 0.7 - (bias_score * 0.4)  # 0.3 to 0.7\n\n                confidence = self._bayesian_update(\n                    prior=confidence,\n                    likelihood_ratio=likelihood_ratio\n                )\n\n                self.evidence_nodes.append(EvidenceNode(\n                    evidence_type=EvidenceType.BIAS_DETECTION,\n                    name=\"Bias Detection\",\n                    prior=current_confidence,\n                    likelihood=likelihood_ratio,\n                    marginal=0.5,\n                    posterior=confidence,\n                    explanation=f\"Bias score: {bias_score:.2f} - {bias.get('bias_type', 'unknown')}\",\n                    raw_data=bias\n                ))\n\n        # Expert sanity check evidence\n        if \"expert_check\" in verification:\n            expert = verification[\"expert_check\"]\n            plausibility = expert.get(\"plausibility\", \"plausible\")\n            plausibility_score = expert.get(\"plausibility_score\", 0.7)\n\n            # Expert judgment provides strong evidence\n            if plausibility == \"implausible\":\n                # Strong evidence against\n                likelihood_ratio = 0.3\n                explanation = \"Expert assessment: claim is implausible\"\n            elif plausibility == \"questionable\":\n                # Moderate evidence against\n                likelihood_ratio = 0.6\n                explanation = \"Expert assessment: claim is questionable\"\n            else:\n                # Slight positive evidence\n                likelihood_ratio = 1.0 + (plausibility_score - 0.7) * 0.3\n                explanation = f\"Expert assessment: claim is plausible ({plausibility_score:.0%})\"\n\n            prior = confidence\n            confidence = self._bayesian_update(\n                prior=confidence,\n                likelihood_ratio=likelihood_ratio\n            )\n\n            self.evidence_nodes.append(EvidenceNode(\n                evidence_type=EvidenceType.EXPERT_SANITY,\n                name=\"Expert Sanity Check\",\n                prior=prior,\n                likelihood=likelihood_ratio if likelihood_ratio <= 1 else 1/likelihood_ratio,\n                marginal=0.5,\n                posterior=confidence,\n                explanation=explanation,\n                raw_data=expert\n            ))\n\n            # Flag extraordinary claims\n            if expert.get(\"extraordinary_claim\", False):\n                # Extraordinary claims require extraordinary evidence\n                confidence = confidence * 0.85\n                self.evidence_nodes.append(EvidenceNode(\n                    evidence_type=EvidenceType.EXPERT_SANITY,\n                    name=\"Extraordinary Claim Flag\",\n                    prior=confidence / 0.85,\n                    likelihood=0.85,\n                    marginal=0.5,\n                    posterior=confidence,\n                    explanation=\"Extraordinary claim requires stronger evidence\"\n                ))\n\n        # Cross-reference evidence\n        if \"cross_reference\" in verification:\n            cross_ref = verification[\"cross_reference\"]\n            corroboration = cross_ref.get(\"corroboration_level\", \"unknown\")\n\n            # Cross-reference provides corroboration evidence\n            corroboration_map = {\n                \"strong\": 1.3,      # Strong positive evidence\n                \"moderate\": 1.1,    # Moderate positive\n                \"weak\": 0.95,       # Slight negative\n                \"uncorroborated\": 0.8,  # No corroboration is weak negative\n                \"unknown\": 1.0      # Neutral\n            }\n\n            likelihood_ratio = corroboration_map.get(corroboration, 1.0)\n\n            # Check for contradictions\n            contradictions = cross_ref.get(\"contradicting_findings\", [])\n            if contradictions:\n                # Each contradiction is evidence against\n                likelihood_ratio *= (0.9 ** len(contradictions))\n\n            prior = confidence\n            confidence = self._bayesian_update(\n                prior=confidence,\n                likelihood_ratio=likelihood_ratio\n            )\n\n            explanation = f\"Cross-reference: {corroboration}\"\n            if contradictions:\n                explanation += f\" ({len(contradictions)} contradictions)\"\n\n            self.evidence_nodes.append(EvidenceNode(\n                evidence_type=EvidenceType.CROSS_REFERENCE,\n                name=\"Cross-Reference Analysis\",\n                prior=prior,\n                likelihood=min(1.0, likelihood_ratio),\n                marginal=0.5,\n                posterior=confidence,\n                explanation=explanation,\n                raw_data=cross_ref\n            ))\n\n        return confidence\n\n    def _bayesian_update(\n        self,\n        prior: float,\n        likelihood_ratio: float,\n    ) -> float:\n        \"\"\"Apply Bayesian update using likelihood ratio.\n\n        posterior_odds = likelihood_ratio * prior_odds\n\n        Args:\n            prior: Prior probability P(H)\n            likelihood_ratio: P(E|H) / P(E|not H)\n\n        Returns:\n            Posterior probability P(H|E)\n        \"\"\"\n        # Convert to odds\n        if prior >= 0.99:\n            prior = 0.99\n        if prior <= 0.01:\n            prior = 0.01\n\n        prior_odds = prior / (1 - prior)\n\n        # Update odds\n        posterior_odds = likelihood_ratio * prior_odds\n\n        # Convert back to probability\n        posterior = posterior_odds / (1 + posterior_odds)\n\n        return max(0.1, min(0.95, posterior))\n\n    def _generate_explanation(\n        self,\n        base_confidence: float,\n        final_confidence: float,\n        finding: Dict[str, Any],\n        sources: List[Dict[str, Any]],\n    ) -> ConfidenceExplanation:\n        \"\"\"Generate structured explanation of confidence calculation.\"\"\"\n\n        # Determine what would increase confidence\n        what_would_increase = []\n        what_would_decrease = []\n\n        # Check source diversity\n        domains = set(s.get(\"domain\", \"\") for s in sources)\n        if len(domains) < 3:\n            what_would_increase.append(\n                \"Additional corroborating sources from different domains\"\n            )\n\n        # Check for high-authority sources\n        high_auth_count = sum(\n            1 for s in sources\n            if self.get_domain_authority(s.get(\"domain\", \"\"))[0] > 0.8\n        )\n        if high_auth_count < 2:\n            what_would_increase.append(\n                \"Citations from authoritative sources (academic, government, major publications)\"\n            )\n\n        # Check verification status\n        for node in self.evidence_nodes:\n            if node.evidence_type == EvidenceType.BIAS_DETECTION:\n                if node.posterior < node.prior:\n                    what_would_decrease.append(\n                        f\"Bias detected: {node.explanation}\"\n                    )\n            if node.evidence_type == EvidenceType.EXPERT_SANITY:\n                if \"implausible\" in node.explanation.lower():\n                    what_would_decrease.append(\n                        \"Expert assessment flagged claim as implausible\"\n                    )\n                elif \"questionable\" in node.explanation.lower():\n                    what_would_decrease.append(\n                        \"Expert assessment flagged claim as questionable\"\n                    )\n\n        # Add general factors\n        if final_confidence < 0.7:\n            what_would_increase.append(\n                \"Verification by independent fact-checking\"\n            )\n\n        if final_confidence > 0.8:\n            what_would_decrease.append(\n                \"Discovery of conflicting evidence or retractions\"\n            )\n\n        # Generate summary\n        pct = lambda x: f\"{x*100:.0f}%\"\n\n        if final_confidence >= base_confidence + 0.1:\n            summary = (\n                f\"Confidence increased from {pct(base_confidence)} to {pct(final_confidence)} \"\n                f\"due to corroborating evidence from credible sources.\"\n            )\n        elif final_confidence <= base_confidence - 0.1:\n            summary = (\n                f\"Confidence decreased from {pct(base_confidence)} to {pct(final_confidence)} \"\n                f\"due to verification concerns (bias, plausibility, or lack of corroboration).\"\n            )\n        else:\n            summary = (\n                f\"Confidence of {pct(final_confidence)} reflects balanced evidence \"\n                f\"from the available sources and verification checks.\"\n            )\n\n        return ConfidenceExplanation(\n            base_confidence=base_confidence,\n            final_confidence=final_confidence,\n            evidence_chain=self.evidence_nodes.copy(),\n            summary=summary,\n            what_would_increase=what_would_increase[:5],\n            what_would_decrease=what_would_decrease[:5],\n        )\n\n\ndef calculate_bayesian_confidence(\n    finding: Dict[str, Any],\n    sources: List[Dict[str, Any]],\n    verification: Optional[Dict[str, Any]] = None,\n) -> Tuple[float, ConfidenceExplanation]:\n    \"\"\"Convenience function for calculating Bayesian confidence.\n\n    Args:\n        finding: Finding dictionary with confidence_score\n        sources: List of source dictionaries\n        verification: Optional verification results\n\n    Returns:\n        Tuple of (confidence_score, explanation)\n    \"\"\"\n    calculator = BayesianConfidenceCalculator()\n    return calculator.calculate_finding_confidence(finding, sources, verification)\n\n\ndef calculate_source_credibility(source: Dict[str, Any]) -> Tuple[float, str]:\n    \"\"\"Calculate credibility score for a single source.\n\n    Returns:\n        Tuple of (credibility_score, explanation_string)\n    \"\"\"\n    calculator = BayesianConfidenceCalculator()\n    score, evidence = calculator.calculate_source_credibility(source)\n    return score, evidence.explanation\n","numLines":721,"startLine":1,"totalLines":721}}}
