4→  }, []);\n    45→\n    46→  const reset = useCallback(() => {\n    47→    pause();\n    48→    setCurrentIndex(0);\n    49→  }, [pause]);\n    50→\n    51→  useEffect(() => {\n    52→    if (isPlaying && currentIndex < words.length - 1) {\n    53→      const msPerWord = 60000 / wpm;\n    54→      intervalRef.current = setInterval(() => {\n    55→        setCurrentIndex(i => Math.min(i + 1, words.length - 1));\n    56→      }, msPerWord);\n    57→      return () => {\n    58→        if (intervalRef.current) clearInterval(intervalRef.current);\n    59→      };\n    60→    } else if (currentIndex >= words.length - 1) {\n    61→      pause();\n    62→    }\n    63→  }, [isPlaying, wpm, words.length, currentIndex, pause]);\n    64→\n    65→  useEffect(() => {\n    66→    if (!isActive) {\n    67→      reset();\n    68→    }\n    69→  }, [isActive, reset]);\n    70→\n    71→  useEffect(() => {\n    72→    const handleKeyDown = (e: KeyboardEvent) => {\n    73→      if (!isActive) return;\n    74→      if (e.key === ' ') { e.preventDefault(); isPlaying ? pause() : play(); }\n    75→      if (e.key === 'ArrowLeft') setCurrentIndex(i => Math.max(0, i - 5));\n    76→      if (e.key === 'ArrowRight') setCurrentIndex(i => Math.min(words.length - 1, i + 5));\n    77→      if (e.key === 'Escape') onClose();\n    78→    };\n    79→    window.addEventListener('keydown', handleKeyDown);\n    80→    return () => window.removeEventListener('keydown', handleKeyDown);\n    81→  }, [isActive, isPlaying, play, pause, onClose, words.length]);\n    82→\n    83→  return (\n    84→    <AnimatePresence>\n    85→      {isActive && (\n    86→        <motion.div\n    87→          initial={{ opacity: 0 }}\n    88→          animate={{ opacity: 1 }}\n    89→          exit={{ opacity: 0 }}\n    90→          className={`fixed inset-0 z-50 flex flex-col items-center justify-center ${isRadar ? 'bg-slate-950' : 'bg-stone-100'}`}\n    91→        >\n    92→          {/* Word display */}\n    93→          <div className=\"flex-1 flex items-center justify-center\">\n    94→            <div className={`relative px-16 py-8 rounded-2xl ${isRadar ? 'bg-slate-900/80' : 'bg-white shadow-xl'}`}>\n    95→              {/* Focal point marker */}\n    96→              <div className={`absolute top-0 left-1/2 w-0.5 h-3 -translate-x-1/2 ${isRadar ? 'bg-cyan-400' : 'bg-stone-800'}`} />\n    97→              <div className={`absolute bottom-0 left-1/2 w-0.5 h-3 -translate-x-1/2 ${isRadar ? 'bg-cyan-400' : 'bg-stone-800'}`} />\n    98→\n    99→              {/* Word */}\n   100→              <motion.div\n   101→                key={currentIndex}\n   102→                initial={{ opacity: 0, y: 10 }}\n   103→                animate={{ opacity: 1, y: 0 }}\n   104→                className=\"text-5xl font-mono tracking-wider flex justify-center\"\n   105→              >\n   106→                <span className={styles.textMuted}>{beforeFocal}</span>\n   107→                <span className={isRadar ? 'text-cyan-400' : 'text-rose-600'}>{focal}</span>\n   108→                <span className={styles.text}>{afterFocal}</span>\n   109→              </motion.div>\n   110→            </div>\n   111→          </div>\n   112→\n   113→          {/* Controls */}\n   114→          <div className={`w-full max-w-md p-6 ${isRadar ? 'border-t border-cyan-500/20' : 'border-t border-stone-200'}`}>\n   115→            {/* Progress bar */}\n   116→            <div className={`h-1 rounded-full mb-4 ${isRadar ? 'bg-slate-800' : 'bg-stone-200'}`}>\n   117→              <motion.div\n   118→                className={`h-full rounded-full ${isRadar ? 'bg-cyan-400' : 'bg-stone-800'}`}\n   119→                animate={{ width: `${progress}%` }}\n   120→              />\n   121→            </div>\n   122→\n   123→            {/* Button row */}\n   124→            <div className=\"flex items-center justify-between\">\n   125→              <button onClick={reset} className={`px-4 py-2 rounded-lg text-sm ${isRadar ? 