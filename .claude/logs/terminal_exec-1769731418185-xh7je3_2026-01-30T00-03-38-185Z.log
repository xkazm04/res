kens":0,"cache_creation_input_tokens":854,"cache_read_input_tokens":164400,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":854},"output_tokens":1,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"05d3e4f1-2259-4f3e-a055-8040a34c8b02","uuid":"943c92ec-54be-41e8-bcb4-f8158e627128"}
