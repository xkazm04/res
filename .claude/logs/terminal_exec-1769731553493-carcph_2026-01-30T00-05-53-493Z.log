        ))}\n   128→              </div>\n   129→            </div>\n   130→          )}\n   131→\n   132→          {/* Supporting Sources */}\n   133→          {supportingSources.length > 0 && (\n   134→            <div className=\"bg-slate-50 rounded-md p-3 border-l-3 border-blue-400\">\n   135→              <div className=\"text-[10px] font-semibold text-blue-600 uppercase mb-2 flex items-center gap-1\">\n   136→                <span className=\"w-3 h-3\"><LinkIcon /></span>\n   137→                Sources ({supportingSources.length})\n   138→              </div>\n   139→              <div className=\"space-y-1\">\n   140→                {supportingSources.slice(0, 3).map((sourceId) => {\n   141→                  const source = sourceMap.get(sourceId);\n   142→                  if (!source) return null;\n   143→                  return (\n   144→                    <a\n   145→                      key={sourceId}\n   146→                      href={source.url}\n   147→                      target=\"_blank\"\n   148→                      rel=\"noopener noreferrer\"\n   149→                      className=\"block text-xs text-blue-600 hover:underline truncate\"\n   150→                    >\n   151→                      {source.title || source.domain || source.url}\n   152→                      {source.credibility_score && (\n   153→                        <span className=\"text-slate-400 ml-1\">\n   154→                          ({Math.round(source.credibility_score * 100)}% cred)\n   155→                        </span>\n   156→                      )}\n   157→                    </a>\n   158→                  );\n   159→                })}\n   160→              </div>\n   161→            </div>\n   162→          )}\n   163→        </div>\n   164→      )}\n   165→    </div>\n   166→  );\n   167→}\n   168→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"05d3e4f1-2259-4f3e-a055-8040a34c8b02","uuid":"b1bec1cd-0efe-47c0-8381-b4464baefe70","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\tabs\\FindingsTab.tsx","content":"'use client';\n\nimport { useMemo, useState } from 'react';\nimport type { ResearchFinding, ResearchSource } from '@/src/types/research';\nimport { Section, EmptyState } from '../shared/Cards';\nimport { TypeBadge, ConfidenceBadge } from '../shared/Badges';\nimport { ProgressBar } from '../shared/ProgressBar';\nimport { ChevronRightIcon, ClockIcon, LinkIcon } from '../shared/Icons';\n\ninterface FindingsTabProps {\n  findings: ResearchFinding[];\n  sources: ResearchSource[];\n  searchQuery: string;\n  filterType: string;\n  filterConfidence: string;\n}\n\nexport function FindingsTab({\n  findings,\n  sources,\n  searchQuery,\n  filterType,\n  filterConfidence,\n}: FindingsTabProps) {\n  const filteredFindings = useMemo(() => {\n    return findings.filter((f) => {\n      if (searchQuery && !f.content.toLowerCase().includes(searchQuery.toLowerCase())) {\n        return false;\n      }\n      if (filterType !== 'all' && f.finding_type !== filterType) {\n        return false;\n      }\n      const conf = f.confidence_score || 0;\n      if (filterConfidence === 'high' && conf < 0.8) return false;\n      if (filterConfidence === 'medium' && (conf < 0.5 || conf >= 0.8)) return false;\n      if (filterConfidence === 'low' && conf >= 0.5) return false;\n      return true;\n    });\n  }, [findings, searchQuery, filterType, filterConfidence]);\n\n  const sourceMap = useMemo(() => {\n    const map = new Map<string, ResearchSource>();\n    sources.forEach((s) => map.set(s.id, s));\n    return map;\n  }, [sources]);\n\n  if (filteredFindings.length === 0) {\n    return <EmptyState message=\"No findings match your filters\" />;\n  }\n\n  return (\n    <Section title=\"Findings\" count={filteredFindings.length}>\n      <div className=\"space-y-2\">\n        {filteredFindings.map((finding) => (\n          <FindingCard key={finding.id} finding={finding} sourceMap={sourceMap} />\n        ))}\n      </div>\n    </Section>\n  );\n}\n\nfunction FindingCard({\n  finding,\n  sourceMap,\n}: {\n  finding: ResearchFinding;\n  sourceMap: Map<string, ResearchSource>;\n}) {\n  const [expanded, setExpanded] = useState(false);\n  const supportingSources = finding.supporting_sources || [];\n  const confidence = finding.confidence_score || 0;\n\n  // Get summary (first sentence or first 120 chars)\n  const summary = finding.content.split('.')[0] + '.';\n  const hasMore = finding.content.length > summary.length + 10;\n\n  return (\n    <div className=\"border border-slate-200 rounded-lg overflow-hidden bg-white\">\n      {/* Header - always visible */}\n      <div\n        className=\"flex items-center gap-3 px-4 py-3 bg-slate-50/50 cursor-pointer hover:bg-slate-50 transition-colors\"\n        onClick={() => setExpanded(!expanded)}\n      >\n        <span className={`w-5 h-5 text-slate-400 transition-transform ${expanded ? 'rotate-90' : ''}`}>\n          <ChevronRightIcon />\n        </span>\n        <TypeBadge type={finding.finding_type} />\n        <span className=\"flex-1 text-sm text-slate-700 line-clamp-1\">{summary}</span>\n        <ConfidenceBadge score={confidence} />\n      </div>\n\n      {/* Body - expandable */}\n      {expanded && (\n        <div className=\"px-4 py-3 border-t border-slate-100\">\n          {/* Full content */}\n          <p className=\"text-sm text-slate-700 leading-relaxed mb-3\">{finding.content}</p>\n\n          {/* Meta row */}\n          <div className=\"flex flex-wrap items-center gap-3 text-xs text-slate-500 mb-3\">\n            {finding.temporal_context && (\n              <span className=\"flex items-center gap-1\">\n                <span className=\"w-3.5 h-3.5\"><ClockIcon /></span>\n                {finding.temporal_context}\n                {finding.event_date && ` • ${new Date(finding.event_date).toLocaleDateString()}`}\n              </span>\n            )}\n            <span className=\"flex items-center gap-1\">\n              Confidence:\n              <span className=\"w-16\"><ProgressBar value={confidence * 100} size=\"sm\" /></span>\n            </span>\n          </div>\n\n          {/* Extracted Data */}\n          {finding.extracted_data && Object.keys(finding.extracted_data).length > 0 && (\n            <div className=\"bg-indigo-50 border border-indigo-100 rounded-md p-3 mb-3\">\n              <div className=\"text-[10px] font-semibold text-indigo-600 uppercase mb-2\">\n                Extracted Data\n              </div>\n              <div className=\"grid grid-cols-2 md:grid-cols-3 gap-2\">\n                {Object.entries(finding.extracted_data).slice(0, 6).map(([key, value]) => (\n                  <div key={key} className=\"text-xs\">\n                    <span className=\"text-slate-500\">{key}: </span>\n                    <span className=\"text-slate-700 font-medium\">\n                      {typeof value === 'object' ? JSON.stringify(value) : String(value)}\n                    </span>\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n\n          {/* Supporting Sources */}\n          {supportingSources.length > 0 && (\n            <div className=\"bg-slate-50 rounded-md p-3 border-l-3 border-blue-400\">\n              <div className=\"text-[10px] font-semibold text-blue-600 uppercase mb-2 flex items-center gap-1\">\n                <span className=\"w-3 h-3\"><LinkIcon /></span>\n                Sources ({supportingSources.length})\n              </div>\n              <div className=\"space-y-1\">\n                {supportingSources.slice(0, 3).map((sourceId) => {\n                  const source = sourceMap.get(sourceId);\n                  if (!source) return null;\n                  return (\n                    <a\n                      key={sourceId}\n                      href={source.url}\n                      target=\"_blank\"\n                      rel=\"noopener noreferrer\"\n                      className=\"block text-xs text-blue-600 hover:underline truncate\"\n                    >\n                      {source.title || source.domain || source.url}\n                      {source.credibility_score && (\n                        <span className=\"text-slate-400 ml-1\">\n                          ({Math.round(source.credibility_score * 100)}% cred)\n                        </span>\n                      )}\n                    </a>\n                  );\n                })}\n              </div>\n            </div>\n          )}\n        </div>\n      )}\n    </div>\n  );\n}\n","numLines":168,"startLine":1,"totalLines":168}}}
