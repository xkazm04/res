percent}%` }}\n        />\n      </div>\n      {showLabel && (\n        <span className=\"text-[10px] font-medium text-slate-600 w-8 text-right\">\n          {Math.round(percent)}%\n        </span>\n      )}\n    </div>\n  );\n}\n\ninterface MiniChartProps {\n  data: number[];\n  color?: 'blue' | 'emerald' | 'amber' | 'auto';\n  height?: number;\n}\n\nexport function MiniChart({ data, color = 'blue', height = 20 }: MiniChartProps) {\n  const max = Math.max(...data, 1);\n\n  const getBarColor = (value: number) => {\n    if (color !== 'auto') {\n      const colors = {\n        blue: 'bg-blue-500',\n        emerald: 'bg-emerald-500',\n        amber: 'bg-amber-500',\n      };\n      return colors[color];\n    }\n    const percent = (value / max) * 100;\n    if (percent >= 80) return 'bg-emerald-500';\n    if (percent >= 50) return 'bg-amber-500';\n    return 'bg-red-500';\n  };\n\n  return (\n    <div className=\"flex gap-0.5 items-end\" style={{ height }}>\n      {data.map((value, i) => (\n        <div\n          key={i}\n          className={`flex-1 rounded-t-sm transition-all ${getBarColor(value)}`}\n          style={{ height: `${(value / max) * 100}%`, minWidth: 3 }}\n        />\n      ))}\n    </div>\n  );\n}\n\ninterface ConfidenceDistributionProps {\n  high: number;\n  medium: number;\n  low: number;\n}\n\nexport function ConfidenceDistribution({ high, medium, low }: ConfidenceDistributionProps) {\n  const total = high + medium + low || 1;\n\n  return (\n    <div className=\"flex h-1.5 rounded-full overflow-hidden bg-slate-200\">\n      <div\n        className=\"bg-emerald-500 transition-all\"\n        style={{ width: `${(high / total) * 100}%` }}\n      />\n      <div\n        className=\"bg-amber-500 transition-all\"\n        style={{ width: `${(medium / total) * 100}%` }}\n      />\n      <div\n        className=\"bg-red-500 transition-all\"\n        style={{ width: `${(low / total) * 100}%` }}\n      />\n    </div>\n  );\n}\n","numLines":119,"startLine":1,"totalLines":119}}}
