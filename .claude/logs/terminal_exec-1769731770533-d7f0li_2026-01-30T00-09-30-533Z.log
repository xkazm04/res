apitalize transition-colors ${\n    80→                viewMode === mode\n    81→                  ? isRadar ? 'bg-cyan-500/20 text-cyan-300' : 'bg-white text-stone-900'\n    82→                  : isRadar ? 'text-slate-400 hover:text-white' : 'text-stone-600 hover:text-stone-900'\n    83→              }`}\n    84→            >\n    85→              {mode}\n    86→            </button>\n    87→          ))}\n    88→        </div>\n    89→      </div>\n    90→\n    91→      {/* Constellation view */}\n    92→      {viewMode === 'constellation' && (\n    93→        <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }}>\n    94→          <EntityConstellation\n    95→            entities={filtered}\n    96→            selectedEntity={selectedEntity || undefined}\n    97→            onEntitySelect={setSelectedEntity}\n    98→          />\n    99→        </motion.div>\n   100→      )}\n   101→\n   102→      {/* Cards view */}\n   103→      {viewMode === 'cards' && (\n   104→        <div className=\"grid grid-cols-2 md:grid-cols-4 gap-3\">\n   105→          {(['person', 'organization', 'location', 'event'] as EntityType[]).map(type => {\n   106→            const list = filterType === 'all' ? grouped[type] : (filterType === type ? grouped[type] : []);\n   107→            if (list.length === 0) return null;\n   108→\n   109→            return (\n   110→              <EntityTypeColumn\n   111→                key={type}\n   112→                type={type}\n   113→                entities={list}\n   114→                selectedEntity={selectedEntity}\n   115→                onSelect={setSelectedEntity}\n   116→              />\n   117→            );\n   118→          })}\n   119→        </div>\n   120→      )}\n   121→\n   122→      {/* Selected entity detail */}\n   123→      <AnimatePresence>\n   124→        {selectedData && (\n   125→          <EntityDetail entity={selectedData} onClose={() => setSelectedEntity(null)} />\n   126→        )}\n   127→      </AnimatePres