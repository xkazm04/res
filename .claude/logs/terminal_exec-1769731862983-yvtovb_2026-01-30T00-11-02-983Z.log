4→  }, []);\n    45→\n    46→  const reset = useCallback(() => {\n    47→    pause();\n    48→    setCurrentIndex(0);\n    49→  }, [pause]);\n    50→\n    51→  useEffect(() => {\n    52→    if (isPlaying && currentIndex < words.length - 1) {\n    53→      const msPerWord = 60000 / wpm;\n    54→      intervalRef.current = setInterval(() => {\n    55→        setCurrentIndex(i => Math.min(i + 1, words.length - 1));\n    56→      }, msPerWord);\n    57→      return () => {\n    58→        if (intervalRef.current) clearInterval(intervalRef.current);\n    59→      };\n    60→    } else if (currentIndex >= words.length - 1) {\n    61→      pause();\n    62→    }\n    63→  }, [isPlaying, wpm, words.length, currentIndex, pause]);\n    64→\n    65→  useEffect(() => {\n    66→    if (!isActive) {\n    67→      reset();\n    68→    }\n    69→  }, [isActive, reset]);\n    70→\n    71→  useEffect(() => {\n    72→    const handleKeyDown = (e: KeyboardEvent) => {\n    73→      if (!isActive) return;\n    74→      if (e.key === ' ') { e.preventDefault(); isPlaying ? pause() : play(); }\n    75→      if (e.key === 'ArrowLeft') setCurrentIndex(i => Math.max(0, i - 5));\n    76→      if (e.key === 'ArrowRight') setCurrentIndex(i => Math.min(words.length - 1, i + 5));\n    77→      if (e.key === 'Escape') onClose();\n    78→    };\n    79→    window.addEventListener('keydown', handleKeyDown);\n    80→    return () => window.removeEventListener('keydown', handleKeyDown);\n    81→  }, [isActive, isPlaying, play, pause, onClose, words.length]);\n    82→\n    83→  return (\n    84→    <AnimatePresence>\n    85→      {isActive && (\n    86→        <motion.div\n    87→          initial={{ opacity: 0 }}\n    88→          animate={{ opacity: 1 }}\n    89→          exit={{ opacity: 0 }}\n    90→          className={`fixed inset-0 z-50 flex flex-col items-center justify-center ${isRadar ? 'bg-slate-950' : 'bg-stone-100'}`}\n    91→        >\n    92→          {/* Word display */}\n    93→         