l }[] = [\n  { id: 'overview', label: 'Overview', key: null },\n  { id: 'findings', label: 'Findings', key: 'findings' },\n  { id: 'sources', label: 'Sources', key: 'sources' },\n  { id: 'perspectives', label: 'Perspectives', key: 'perspectives' },\n  { id: 'analysis', label: 'Analysis', key: null },\n  { id: 'entities', label: 'Entities', key: 'entities' },\n];\n\nexport function ThemedSidebar({ activeTab, onTabChange, stats, onClose }: ThemedSidebarProps) {\n  const { theme } = useReportTheme();\n  return theme === 'radar' ? (\n    <RadarSidebar activeTab={activeTab} onTabChange={onTabChange} stats={stats} onClose={onClose} />\n  ) : (\n    <SwissSidebar activeTab={activeTab} onTabChange={onTabChange} stats={stats} onClose={onClose} />\n  );\n}\n\nfunction RadarSidebar({ activeTab, onTabChange, stats, onClose }: ThemedSidebarProps) {\n  return (\n    <aside className=\"w-56 flex flex-col border-r border-cyan-500/20 bg-slate-950/50\">\n      {/* Header */}\n      <div className=\"p-4 border-b border-cyan-500/20\">\n        <div className=\"flex items-center gap-2\">\n          <div className=\"w-8 h-8 rounded-lg bg-gradient-to-br from-cyan-400 to-blue-500 flex items-center justify-center\">\n            <span className=\"text-white text-xs font-bold\">DR</span>\n          </div>\n          <div>\n            <div className=\"text-sm font-semibold text-white\">Deep Research</div>\n            <div className=\"text-[10px] text-cyan-400/60\">Intelligence Report</div>\n          </div>\n        </div>\n      </div>\n\n      {/* Confidence Ring */}\n      <div className=\"p-4 flex justify-center border-b border-cyan-500/10\">\n        <AnimatedProgressRing\n          value={stats.avgConfidence}\n          size={80}\n          strokeWidth={6}\n          color=\"#22d3ee\"\n          bgColor=\"rgba(34,211,238,0.1)\"\n        />\n      </div>\n\n      {/* Navigation */}\n      <nav className=\"flex-1 p-2 space-y-1\">\n        {tabs.map((tab, i) => {\n          const count = tab.key ? stats[tab.key] : tab.id === 'analysis' ? stats.contradictions + stats.gaps : null;\n          const isActive = activeTab === tab.id;\n          return (\n            <motion.button\n              key={tab.id}\n              initial={{ opacity: 0, x: -20 }}\n              animate={{ opacity: 1, x: 0 }}\n              transition={{ delay: i * 0.05 }}\n              onClick={() => onTabChange(tab.id)}\n              className={`w-full px-3 py-2 rounded-lg text-left text-sm transition-all flex items-center gap-2 ${\n                isActive\n                  ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/30'\n                  : 'text-slate-400 hover:text-white hover:bg-white/5'\n              }`}\n            >\n              {isActive && <PulsingDot color=\"bg-cyan-400\" />}\n              <span className=\"flex-1\">{tab.label}</span>\n              {count !== null && (\n                <span className=\"text-[10px] px-1.5 py-0.5 rounded bg-white/10\">\n                  <AnimatedNumber value={count} />\n                </span>\n              )}\n            </motion.button>\n          );\n        })}\n      </nav>\n\n      {/* Stats */}\n      <div className=\"p-3 border-t border-cyan-500/10 space-y-2\">\n        {stats.redFlags > 0 && (\n          <div className=\"flex items-center gap-2 px-2 py-1.5 rounded bg-rose-500/10 border border-rose-500/20\">\n            <PulsingDot color=\"bg-rose-500\" />\n            <span className=\"text-xs text-rose-400\">{stats.redFlags} Red Flags</span>\n          </div>\n        )}\n      </div>\n\n      {/* Close */}\n      <div className=\"p-3\">\n        <button onClick={onClose} className=\"w-full px-3 py-2 text-xs text-slate-400 hover:text-white border border-cyan-500/20 hover:border-cyan-500/40 rounded-lg transition-all\">\n          Close Report\n        </button>\n      </div>\n    </aside>\n  );\n}\n\nfunction SwissSidebar({ activeTab, onTabChange, stats, onClose }: ThemedSidebarProps) {\n  return (\n    <aside className=\"w-52 flex flex-col border-r border-stone-200 bg-white\">\n      {/* Header */}\n      <div className=\"p-4 border-b border-stone-200\">\n        <div className=\"text-lg font-bold text-stone-900 tracking-tight\">Research</div>\n        <div className=\"text-[10px] uppercase tracking-[0.2em] text-stone-400 mt-0.5\">Intelligence Report</div>\n      </div>\n\n      {/* Big number */}\n      <div className=\"p-4 border-b border-stone-100\">\n        <div className=\"text-4xl font-bold text-stone-900 tabular-nums\">\n          <AnimatedNumber value={stats.avgConfidence} suffix=\"%\" />\n        </div>\n        <div className=\"text-[10px] uppercase tracking-wider text-stone-400 mt-1\">Confidence Score</div>\n      </div>\n\n      {/* Navigation */}\n      <nav className=\"flex-1 py-2\">\n        {tabs.map((tab, i) => {\n          const count = tab.key ? stats[tab.key] : tab.id === 'analysis' ? stats.contradictions + stats.gaps : null;\n          const isActive = activeTab === tab.id;\n          return (\n            <motion.button\n              key={tab.id}\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              transition={{ delay: i * 0.03 }}\n              onClick={() => onTabChange(tab.id)}\n              className={`w-full px-4 py-2.5 text-left text-sm flex items-center border-l-2 transition-all ${\n                isActive\n                  ? 'border-stone-900 bg-stone-50 text-stone-900 font-medium'\n                  : 'border-transparent text-stone-500 hover:text-stone-900 hover:bg-stone-50'\n              }`}\n            >\n              <span className=\"flex-1\">{tab.label}</span>\n              {count !== null && (\n                <span className=\"text-xs tabular-nums text-stone-400\">{count}</span>\n              )}\n            </motion.button>\n          );\n        })}\n      </nav>\n\n      {/* Stats */}\n      {stats.redFlags > 0 && (\n        <div className=\"mx-4 mb-3 px-3 py-2 border-l-2 border-rose-600 bg-rose-50\">\n          <div className=\"text-xs font-medium text-rose-700\">{stats.redFlags} Issues Found</div>\n        </div>\n      )}\n\n      {/* Close */}\n      <div className=\"p-3 border-t border-stone-100\">\n        <button onClick={onClose} className=\"w-full px-3 py-2 text-xs text-stone-500 hover:text-stone-900 border border-stone-200 hover:border-stone-900 rounded transition-all\">\n          Close\n        </button>\n      </div>\n    </aside>\n  );\n}\n","numLines":180,"startLine":1,"totalLines":180}}}
