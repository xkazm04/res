nitial={{ opacity: 0, y: 10 }}\n                animate={{ opacity: 1, y: 0 }}\n                className=\"text-5xl font-mono tracking-wider flex justify-center\"\n              >\n                <span className={styles.textMuted}>{beforeFocal}</span>\n                <span className={isRadar ? 'text-cyan-400' : 'text-rose-600'}>{focal}</span>\n                <span className={styles.text}>{afterFocal}</span>\n              </motion.div>\n            </div>\n          </div>\n\n          {/* Controls */}\n          <div className={`w-full max-w-md p-6 ${isRadar ? 'border-t border-cyan-500/20' : 'border-t border-stone-200'}`}>\n            {/* Progress bar */}\n            <div className={`h-1 rounded-full mb-4 ${isRadar ? 'bg-slate-800' : 'bg-stone-200'}`}>\n              <motion.div\n                className={`h-full rounded-full ${isRadar ? 'bg-cyan-400' : 'bg-stone-800'}`}\n                animate={{ width: `${progress}%` }}\n              />\n            </div>\n\n            {/* Button row */}\n            <div className=\"flex items-center justify-between\">\n              <button onClick={reset} className={`px-4 py-2 rounded-lg text-sm ${isRadar ? 'bg-slate-800 text-slate-300 hover:bg-slate-700' : 'bg-stone-200 text-stone-700 hover:bg-stone-300'}`}>\n                Reset\n              </button>\n\n              <button\n                onClick={isPlaying ? pause : play}\n                className={`px-8 py-3 rounded-xl font-semibold ${isRadar ? 'bg-cyan-500 text-slate-900 hover:bg-cyan-400' : 'bg-stone-800 text-white hover:bg-stone-700'}`}\n              >\n                {isPlaying ? 'Pause' : 'Play'}\n              </button>\n\n              <div className=\"flex items-center gap-2\">\n                <span className={`text-xs ${styles.textMuted}`}>WPM:</span>\n                <input\n                  type=\"range\"\n                  min=\"100\"\n                  max=\"600\"\n                  step=\"50\"\n                  value={wpm}\n           