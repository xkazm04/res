umber } from '../core/AnimatedNumber';\n\ninterface KeyPoint {\n  id: string;\n  text: string;\n  type: 'insight' | 'warning' | 'action' | 'fact';\n  confidence: number;\n  sourceCount: number;\n  relatedFindings?: string[];\n}\n\ninterface KeyPointsPanelProps {\n  points: KeyPoint[];\n  onPointClick?: (pointId: string) => void;\n  highlightedPoint?: string;\n}\n\nconst typeConfig = {\n  insight: {\n    icon: '💡',\n    radarBg: 'bg-emerald-500/10 border-emerald-500/30',\n    swissBg: 'bg-emerald-50 border-emerald-200',\n    radarText: 'text-emerald-400',\n    swissText: 'text-emerald-700',\n  },\n  warning: {\n    icon: '⚠️',\n    radarBg: 'bg-amber-500/10 border-amber-500/30',\n    swissBg: 'bg-amber-50 border-amber-200',\n    radarText: 'text-amber-400',\n    swissText: 'text-amber-700',\n  },\n  action: {\n    icon: '🎯',\n    radarBg: 'bg-blue-500/10 border-blue-500/30',\n    swissBg: 'bg-blue-50 border-blue-200',\n    radarText: 'text-blue-400',\n    swissText: 'text-blue-700',\n  },\n  fact: {\n    icon: '📊',\n    radarBg: 'bg-violet-500/10 border-violet-500/30',\n    swissBg: 'bg-violet-50 border-violet-200',\n    radarText: 'text-violet-400',\n    swissText: 'text-violet-700',\n  },\n};\n\nexport function KeyPointsPanel({ points, onPointClick, highlightedPoint }: KeyPointsPanelProps) {\n  const { theme } = useReportTheme();\n  const styles = useThemeStyles();\n  const isRadar = theme === 'radar';\n  const [filter, setFilter] = useState<KeyPoint['type'] | 'all'>('all');\n  const [expanded, setExpanded] = useState<string | null>(null);\n\n  const filteredPoints = filter === 'all' ? points : points.filter(p => p.type === filter);\n  const typeCounts = {\n    insight: points.filter(p => p.type === 'insight').length,\n    warning: points.filter(p => p.type === 'warning').length,\n    action: points.filter(p => p.type === 'action').length,\n    fact: points.filter(p => p.type === 'fact').length,\n  };\n\n  return (\n    <div className={`rounded-2xl overflow-hidden ${isRadar ? 'bg-slate-900/60 border border-cyan-500/10' : 'bg-white border border-stone-200'}`}>\n      {/* Header */}\n      <div className={`p-4 border-b ${isRadar ? 'border-cyan-500/10' : 'border-stone-200'}`}>\n        <div className=\"flex items-center justify-between mb-3\">\n          <h3 className={`font-semibold ${styles.text}`}>Key Points</h3>\n          <span className={`text-xs ${styles.textMuted}`}>\n            <AnimatedNumber value={filteredPoints.length} /> points\n          </span>\n        </div>\n\n        {/* Filters */}\n        <div className=\"flex flex-wrap gap-2\">\n          <FilterButton\n            label=\"All\"\n            count={points.length}\n            active={filter === 'all'}\n            onClick={() => setFilter('all')}\n          />\n          {(Object.keys(typeConfig) as KeyPoint['type'][]).map(type => (\n            <FilterButton\n              key={type}\n              label={typeConfig[type].icon}\n              count={typeCounts[type]}\n              active={filter === type}\n              onClick={() => setFilter(type)}\n            />\n          ))}\n        </div>\n      </div>\n\n      {/* Points list */}\n      <div className=\"p-3 space-y-2 max-h-96 overflow-y-auto\">\n        <AnimatePresence mode=\"popLayout\">\n          {filteredPoints.map((point, i) => {\n            const config = typeConfig[point.type];\n            const isExpanded = expanded === point.id;\n            const isHighlighted = highlightedPoint === point.id;\n\n            return (\n              <motion.div\n                key={point.id}\n                layout\n                initial={{ opacity: 0, x: -20 }}\n                animate={{ opacity: 1, x: 0 }}\n                exit={{ opacity: 0, x: 20 }}\n                transition={{ delay: i * 0.03 }}\n                className={`rounded-xl border cursor-pointer overflow-hidden transition-all ${\n                  isRadar ? config.radarBg : config.swissBg\n                } ${isHighlighted ? (isRadar ? 'ring-2 ring-cyan-400' : 'ring-2 ring-stone-800') : ''}`}\n                onClick={() => {\n                  setExpanded(isExpanded ? null : point.id);\n                  onPointClick?.(point.id);\n                }}\n              >\n                {/* Main content */}\n                <div className=\"p-3\">\n                  <div className=\"flex items-start gap-2\">\n                    <span className=\"text-lg flex-shrink-0\">{config.icon}</span>\n                    <div className=\"flex-1 min-w-0\">\n                      <p className={`text-sm ${isRadar ? config.radarText : config.swissText}`}>\n                        {point.text}\n                      </p>\n                      <div className=\"flex items-center gap-3 mt-2\">\n                        <span className={`text-[10px] ${styles.textMuted}`}>\n                          {Math.round(point.confidence * 100)}% confidence\n                        </span>\n                        <span className={`text-[10px] ${styles.textMuted}`}>\n                          {point.sourceCount} sources\n                        </span>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Expanded details */}\n                <AnimatePresence>\n                  {isExpanded && point.relatedFindings && (\n                    <motion.div\n                      initial={{ height: 0, opacity: 0 }}\n                      animate={{ height: 'auto', opacity: 1 }}\n                      exit={{ height: 0, opacity: 0 }}\n                      className={`border-t ${isRadar ? 'border-white/10 bg-black/20' : 'border-stone-200 bg-stone-50'}`}\n                    >\n                      <div className=\"p-3\">\n                        <div className={`text-[10px] uppercase tracking-wider mb-2 ${styles.textMuted}`}>\n                          Related Findings\n                        </div>\n                        <ul className=\"space-y-1\">\n                          {point.relatedFindings.slice(0, 3).map((finding, j) => (\n                            <li key={j} className={`text-xs ${styles.textMuted}`}>\n                              • {finding}\n                            </li>\n                          ))}\n                        </ul>\n                      </div>\n                    </motion.div>\n                  )}\n                </AnimatePresence>\n              </motion.div>\n            );\n          })}\n        </AnimatePresence>\n      </div>\n    </div>\n  );\n}\n\nfunction FilterButton({ label, count, active, onClick }: {\n  label: string;\n  count: number;\n  active: boolean;\n  onClick: () => void;\n}) {\n  const { theme } = useReportTheme();\n  const isRadar = theme === 'radar';\n\n  return (\n    <button\n      onClick={onClick}\n      className={`px-2 py-1 rounded-lg text-xs flex items-center gap-1 transition-all ${\n        active\n          ? isRadar ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/30' : 'bg-stone-800 text-white'\n          : isRadar ? 'bg-slate-800/50 text-slate-400 hover:text-white' : 'bg-stone-100 text-stone-600 hover:bg-stone-200'\n      }`}\n    >\n      {label}\n      <span className={`px-1 py-0.5 rounded text-[9px] ${active ? (isRadar ? 'bg-cyan-500/30' : 'bg-white/20') : 'bg-black/10'}`}>\n        {count}\n      </span>\n    </button>\n  );\n}\n","numLines":202,"startLine":1,"totalLines":202}}}
