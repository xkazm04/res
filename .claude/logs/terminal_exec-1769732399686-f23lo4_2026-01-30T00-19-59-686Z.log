  showConfidenceFilter={activeTab === 'findings' || activeTab === 'sources'}\n    82→          />\n    83→        )}\n    84→\n    85→        {/* Content */}\n    86→        <div className=\"flex-1 overflow-y-auto p-6\">\n    87→          <div className=\"max-w-5xl mx-auto\">\n    88→            {activeTab === 'overview' && <OverviewView session={session} stats={stats} />}\n    89→            {activeTab === 'findings' && <FindingsView findings={session.findings || []} sources={session.sources || []} searchQuery={searchQuery} filterType={filterType} filterConfidence={filterConfidence} />}\n    90→            {activeTab === 'sources' && <SourcesView sources={session.sources || []} searchQuery={searchQuery} filterConfidence={filterConfidence} />}\n    91→            {activeTab === 'perspectives' && <PerspectivesView perspectives={session.perspectives || []} />}\n    92→            {activeTab === 'analysis' && <AnalysisView contradictions={session.contradictions || []} gaps={session.gaps || []} causalChains={session.causal_chains || []} />}\n    93→            {activeTab === 'entities' && <EntitiesView entities={session.entities || []} />}\n    94→          </div>\n    95→        </div>\n    96→      </main>\n    97→    </ReportShell>\n    98→  );\n    99→}\n   100→\n   101→function Toolbar({ searchQuery, onSearchChange, filterType, onFilterTypeChange, filterConfidence, onFilterConfidenceChange, findingTypes, showTypeFilter, showConfidenceFilter }: {\n   102→  searchQuery: string;\n   103→  onSearchChange: (v: string) => void;\n   104→  filterType: string;\n   105→  onFilterTypeChange: (v: string) => void;\n   106→  filterConfidence: string;\n   107→  onFilterConfidenceChange: (v: string) => void;\n   108→  findingTypes: string[];\n   109→  showTypeFilter: boolean;\n   110→  showConfidenceFilter: boolean;\n   111→}) {\n   112→  const styles = useThemeStyles();\n   113→  return (\n   114→    <div className={`px-6 py-3 border-b ${styles.border} flex flex-wrap gap-3`}>\n  