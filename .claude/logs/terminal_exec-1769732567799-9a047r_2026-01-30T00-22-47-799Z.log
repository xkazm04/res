shared\\Cards.tsx","content":"'use client';\n\nimport { useState, type ReactNode } from 'react';\nimport { ChevronRightIcon } from './Icons';\n\n// Section wrapper component\nexport function Section({\n  title,\n  count,\n  children,\n  collapsible = false,\n  defaultExpanded = true,\n}: {\n  title: string;\n  count?: number;\n  children: ReactNode;\n  collapsible?: boolean;\n  defaultExpanded?: boolean;\n}) {\n  const [expanded, setExpanded] = useState(defaultExpanded);\n\n  return (\n    <div className=\"bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden transition-shadow hover:shadow-md\">\n      <div\n        className={`px-4 py-3 border-b border-slate-100 flex justify-between items-center ${\n          collapsible ? 'cursor-pointer hover:bg-slate-50' : ''\n        }`}\n        onClick={() => collapsible && setExpanded(!expanded)}\n      >\n        <div className=\"flex items-center gap-2\">\n          {collapsible && (\n            <span className={`w-4 h-4 text-slate-400 transition-transform ${expanded ? 'rotate-90' : ''}`}>\n              <ChevronRightIcon />\n            </span>\n          )}\n          <h3 className=\"font-semibold text-slate-800 text-sm\">{title}</h3>\n        </div>\n        {count !== undefined && (\n          <span className=\"text-[10px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full font-medium\">\n            {count}\n          </span>\n        )}\n      </div>\n      {(!collapsible || expanded) && (\n        <div className=\"p-4\">{children}</div>\n      )}\n    </div>\n  );\n}\n\n// Quick stat card\nexport function QuickStatCard({\n  label,\n  value,\n  subtext,\n  progress,\n  icon,\n  color,\n}: {\n  label: string;\n  value: string | number;\n  subtext?: string;\n  progress?: number;\n  icon: ReactNode;\n  color: 'blue' | 'emerald' | 'amber' | 'red' | 'slate';\n}) {\n  const colorClasses = {\n    blue: 'bg-blue-50 border-blue-200 text-blue-600',\n    emerald: 'bg-emerald-50 border-emerald-200 text-emerald-600',\n    amber: 'bg-amber-50 border-amber-200 text-amber-600',\n    red: 'bg-red-50 border-red-200 text-red-600',\n    slate: 'bg-slate-50 border-slate-200 text-slate-600',\n  };\n\n  const progressColors = {\n    blue: 'bg-blue-500',\n    emerald: 'bg-emerald-500',\n    amber: 'bg-amber-500',\n    red: 'bg-red-500',\n    slate: 'bg-slate-500',\n  };\n\n  return (\n    <div className={`rounded-lg border p-3 ${colorClasses[color]}`}>\n      <div className=\"flex items-center justify-between mb-1\">\n        <span className=\"w-4 h-4 opacity-60\">{icon}</span>\n        <span className=\"text-[9px] uppercase tracking-wider opacity-60\">{label}</span>\n      </div>\n      <div className=\"text-xl font-bold\">{value}</div>\n      {subtext && <div className=\"text-[10px] opacity-70 mt-0.5\">{subtext}</div>}\n      {progress !== undefined && (\n        <div className=\"h-1 bg-white/50 rounded-full mt-2 overflow-hidden\">\n          <div\n            className={`h-full rounded-full ${progressColors[color]}`}\n            style={{ width: `${progress}%` }}\n          />\n        </div>\n      )}\n    </div>\n  );\n}\n\n// Alert banner\nexport function AlertBanner({\n  title,\n  description,\n  variant,\n  icon,\n}: {\n  title: string;\n  description: string;\n  variant: 'warning' | 'error' | 'info' | 'success';\n  icon?: ReactNode;\n}) {\n  const variants = {\n    warning: 'bg-gradient-to-br from-orange-50 to-amber-50 border-orange-200 text-orange-700',\n    error: 'bg-gradient-to-br from-red-50 to-rose-50 border-red-200 text-red-700',\n    info: 'bg-gradient-to-br from-violet-50 to-purple-50 border-violet-200 text-violet-700',\n    success: 'bg-gradient-to-br from-emerald-50 to-green-50 border-emerald-200 text-emerald-700',\n  };\n\n  return (\n    <div className={`border rounded-lg p-3 ${variants[variant]}`}>\n      <div className=\"flex items-center gap-2 font-semibold text-xs mb-1\">\n        {icon && <span className=\"w-3.5 h-3.5\">{icon}</span>}\n        {title}\n      </div>\n      <p className=\"text-[10px] opacity-80\">{description}</p>\n    </div>\n  );\n}\n\n// Empty state\nexport function EmptyState({ message }: { message: string }) {\n  return (\n    <div className=\"text-center py-8 text-slate-400 text-sm\">\n      {message}\n    </div>\n  );\n}\n","numLines":141,"startLine":1,"totalLines":141}}}
