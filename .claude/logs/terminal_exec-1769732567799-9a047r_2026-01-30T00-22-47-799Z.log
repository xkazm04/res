ter ${className}`}>\n    60→      <svg width={size} height={size} className=\"-rotate-90\">\n    61→        {/* Background ring */}\n    62→        <circle\n    63→          cx={size / 2}\n    64→          cy={size / 2}\n    65→          r={radius}\n    66→          fill=\"none\"\n    67→          stroke={bgColor}\n    68→          strokeWidth={strokeWidth}\n    69→        />\n    70→        {/* Progress ring */}\n    71→        <motion.circle\n    72→          cx={size / 2}\n    73→          cy={size / 2}\n    74→          r={radius}\n    75→          fill=\"none\"\n    76→          stroke={color}\n    77→          strokeWidth={strokeWidth}\n    78→          strokeLinecap=\"round\"\n    79→          initial={{ strokeDashoffset: circumference }}\n    80→          animate={{ strokeDashoffset: circumference - (progress / 100) * circumference }}\n    81→          transition={{ duration: 1, ease: 'easeOut' }}\n    82→          style={{ strokeDasharray: circumference }}\n    83→        />\n    84→      </svg>\n    85→      {showValue && (\n    86→        <div className=\"absolute inset-0 flex items-center justify-center\">\n    87→          <AnimatedNumber value={progress} suffix=\"%\" className=\"text-xs font-bold\" />\n    88→        </div>\n    89→      )}\n    90→    </div>\n    91→  );\n    92→}\n    93→\n    94→export function PulsingDot({ color = 'bg-blue-500', size = 'w-2 h-2' }: { color?: string; size?: string }) {\n    95→  return (\n    96→    <span className=\"relative flex\">\n    97→      <span className={`animate-ping absolute inline-flex h-full w-full rounded-full ${color} opacity-75`} />\n    98→      <span className={`relative inline-flex rounded-full ${size} ${color}`} />\n    99→    </span>\n   100→  );\n   101→}\n   102→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can