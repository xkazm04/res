0, Math.round((stats.sources / Math.max(10, stats.findings * 2)) * 100));\n  const reliability = Math.round((findings.filter(f => (f.confidence_score || 0) >= 0.7).length / Math.max(1, findings.length)) * 100);\n  const completeness = Math.min(100, 100 - (stats.gaps * 10));\n\n  const allWarnings = session.perspectives?.flatMap(p => p.warnings || []) || [];\n\n  return (\n    <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} className=\"space-y-6\">\n      {/* View mode toggle */}\n      <div className=\"flex items-center justify-between\">\n        <h2 className={`text-sm font-semibold ${styles.text}`}>Overview</h2>\n        <div className={`flex rounded-lg overflow-hidden ${isRadar ? 'bg-slate-800' : 'bg-stone-200'}`}>\n          <button\n            onClick={() => setViewMode('video')}\n            className={`px-3 py-1.5 text-xs font-medium flex items-center gap-1 transition-colors ${\n              viewMode === 'video'\n                ? isRadar ? 'bg-cyan-500/20 text-cyan-300' : 'bg-white text-stone-900'\n                : isRadar ? 'text-slate-400 hover:text-white' : 'text-stone-600 hover:text-stone-900'\n            }`}\n          >\n            <svg className=\"w-3 h-3\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M8 5v14l11-7z\" /></svg>\n            Video\n          </button>\n          <button\n            onClick={() => setViewMode('static')}\n            className={`px-3 py-1.5 text-xs font-medium flex items-center gap-1 transition-colors ${\n              viewMode === 'static'\n                ? isRadar ? 'bg-cyan-500/20 text-cyan-300' : 'bg-white text-stone-900'\n                : isRadar ? 'text-slate-400 hover:text-white' : 'text-stone-600 hover:text-stone-900'\n            }`}\n          >\n            <svg className=\"w-3 h-3\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M4 6h16M4 12h16M4 18h16\" /></svg>\n            Static\n         