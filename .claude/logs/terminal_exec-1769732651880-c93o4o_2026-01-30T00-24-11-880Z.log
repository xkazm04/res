}\n    37→\n    38→  return (\n    39→    <div className=\"space-y-4\">\n    40→      {/* Tab navigation */}\n    41→      <div className={`flex gap-2 p-2 rounded-xl ${isRadar ? 'bg-slate-900/50' : 'bg-stone-100'}`}>\n    42→        {tabs.filter(t => t.count > 0).map(tab => (\n    43→          <button\n    44→            key={tab.key}\n    45→            onClick={() => setActiveTab(tab.key)}\n    46→            className={`flex-1 px-4 py-3 rounded-lg text-sm font-medium transition-all ${\n    47→              activeTab === tab.key\n    48→                ? isRadar ? 'bg-slate-800 text-white shadow-lg' : 'bg-white text-stone-900 shadow'\n    49→                : isRadar ? 'text-slate-400 hover:text-white' : 'text-stone-600 hover:text-stone-900'\n    50→            }`}\n    51→          >\n    52→            <span className=\"mr-2\">{tab.icon}</span>\n    53→            {tab.label}\n    54→            <span className={`ml-2 px-1.5 py-0.5 rounded text-[10px] ${\n    55→              activeTab === tab.key\n    56→                ? isRadar ? 'bg-cyan-500/30' : 'bg-stone-800 text-white'\n    57→                : isRadar ? 'bg-slate-700' : 'bg-stone-200'\n    58→            }`}>\n    59→              <AnimatedNumber value={tab.count} />\n    60→            </span>\n    61→          </button>\n    62→        ))}\n    63→      </div>\n    64→\n    65→      {/* Content */}\n    66→      <AnimatePresence mode=\"wait\">\n    67→        {activeTab === 'contradictions' && contradictions.length > 0 && (\n    68→          <motion.div key=\"contradictions\" initial={{ opacity: 0, y: 10 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0, y: -10 }}>\n    69→            <ContradictionMatrix contradictions={contradictions} />\n    70→          </motion.div>\n    71→        )}\n    72→\n    73→        {activeTab === 'gaps' && gaps.length > 0 && (\n    74→          <motion.div key=\"gaps\" initial={{ opacity: 0, y: 10 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0, y: -10 }} class