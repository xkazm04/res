    {causalChains.length > 0 && (\n    47→        <Section title=\"Causal Chains\" count={causalChains.length} collapsible defaultExpanded>\n    48→          <div className=\"space-y-3\">\n    49→            {causalChains.map((chain) => (\n    50→              <CausalChainCard key={chain.id} chain={chain} />\n    51→            ))}\n    52→          </div>\n    53→        </Section>\n    54→      )}\n    55→    </div>\n    56→  );\n    57→}\n    58→\n    59→function ContradictionCard({ contradiction }: { contradiction: ResearchContradiction }) {\n    60→  return (\n    61→    <div className=\"p-4 bg-red-50 border border-red-200 rounded-lg\">\n    62→      <div className=\"flex items-center gap-2 mb-2\">\n    63→        <span className=\"w-4 h-4 text-red-600\"><AlertIcon /></span>\n    64→        <span className=\"text-xs font-semibold text-red-700 uppercase\">Contradiction</span>\n    65→        {contradiction.significance && (\n    66→          <span className=\"text-[10px] px-1.5 py-0.5 bg-red-100 text-red-700 rounded\">\n    67→            {contradiction.significance}\n    68→          </span>\n    69→        )}\n    70→      </div>\n    71→\n    72→      {/* Conflicting claims */}\n    73→      <div className=\"space-y-2 mb-3\">\n    74→        <div className=\"p-2 bg-white rounded border border-red-100\">\n    75→          <div className=\"text-[10px] text-red-500 mb-1\">Claim A</div>\n    76→          <p className=\"text-sm text-slate-700\">{contradiction.claim_1}</p>\n    77→          {contradiction.source_1 && (\n    78→            <p className=\"text-[10px] text-slate-500 mt-1\">Source: {contradiction.source_1}</p>\n    79→          )}\n    80→        </div>\n    81→        <div className=\"flex justify-center\">\n    82→          <span className=\"text-xs text-red-400\">VS</span>\n    83→        </div>\n    84→        <div className=\"p-2 bg-white rounded border border-red-100\">\n    85→          <div className=\"text-[10px] text-red-500 mb-1\">Claim B</d