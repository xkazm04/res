\n    35→            <ComparisonCard key={p.id} perspective={p} />\n    36→          ))}\n    37→        </div>\n    38→      )}\n    39→\n    40→      {/* Detailed Cards */}\n    41→      <Section title=\"Detailed Analysis\" count={perspectives.length}>\n    42→        <div className=\"space-y-3\">\n    43→          {perspectives.map((p) => (\n    44→            <PerspectiveCard key={p.id} perspective={p} />\n    45→          ))}\n    46→        </div>\n    47→      </Section>\n    48→    </div>\n    49→  );\n    50→}\n    51→\n    52→function ComparisonCard({ perspective }: { perspective: ResearchPerspective }) {\n    53→  const colors = perspectiveColors[perspective.perspective_type] || perspectiveColors.default;\n    54→  const insights = perspective.key_insights || [];\n    55→  const warnings = perspective.warnings || [];\n    56→  const confidence = perspective.confidence || 0;\n    57→\n    58→  return (\n    59→    <div className={`${colors.bg} ${colors.border} border rounded-lg p-3`}>\n    60→      <div className=\"flex items-center justify-between mb-2\">\n    61→        <span className={`text-sm font-semibold ${colors.icon} capitalize`}>\n    62→          {perspective.perspective_type.replace('_', ' ')}\n    63→        </span>\n    64→        <ConfidenceBadge score={confidence} />\n    65→      </div>\n    66→      <div className=\"flex items-center gap-4 text-xs text-slate-600\">\n    67→        <span className=\"flex items-center gap-1\">\n    68→          <span className=\"w-3 h-3 text-emerald-500\"><CheckCircleIcon /></span>\n    69→          {insights.length} insights\n    70→        </span>\n    71→        <span className=\"flex items-center gap-1\">\n    72→          <span className=\"w-3 h-3 text-amber-500\"><AlertIcon /></span>\n    73→          {warnings.length} warnings\n    74→        </span>\n    75→      </div>\n    76→    </div>\n    77→  );\n    78→}\n    79→\n    80→function PerspectiveCard({ perspective }: { perspective: ResearchPerspective }) {\n    81→  const [expanded, setExpanded] = useState(true);\n    82→  const colors = perspectiveColors[perspective.perspective_type] || perspectiveColors.default;\n    83→  const insights = perspective.key_insights || [];\n    84→  const warnings = perspective.warnings || [];\n    85→  const recommendations = perspective.recommendations || [];\n    86→  const confidence = perspective.confidence || 0;\n    87→\n    88→  return (\n    89→    <div className=\"border border-slate-200 rounded-lg overflow-hidden bg-white\">\n    90→      {/* Header */}\n    91→      <div\n    92→        className={`px-4 py-3 ${colors.bg} cursor-pointer flex items-center gap-3`}\n    93→        onClick={() => setExpanded(!expanded)}\n    94→      >\n    95→        <span className={`w-5 h-5 text-slate-400 transition-transform ${expanded ? 'rotate-90' : ''}`}>\n    96→          <ChevronRightIcon />\n    97→        </span>\n    98→        <span className={`font-semibold ${colors.icon} capitalize flex-1`}>\n    99→          {perspective.perspective_type.replace('_', ' ')} Perspective\n   100→        </span>\n   101→        <div className=\"flex items-center gap-2\">\n   102→          <ProgressBar value={confidence * 100} size=\"sm\" />\n   103→          <span className=\"text-xs text-slate-600 w-8\">{Math.round(confidence * 100)}%</span>\n   104→        </div>\n   105→      </div>\n   106→\n   107→      {/* Body */}\n   108→      {expanded && (\n   109→        <div className=\"p-4 space-y-4\">\n   110→          {/* Analysis */}\n   111→          {perspective.analysis_text && (\n   112→            <p className=\"text-sm text-slate-700 leading-relaxed\">\n   113→              {perspective.analysis_text}\n   114→            </p>\n   115→          )}\n   116→\n   117→          {/* Grid of insights/warnings/recommendations */}\n   118→          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-3\">\n   119→            {insights.length > 0 && (\n   120→              <div className=\"space-y-2\">\n   121→                <div className=\"text-[10px] font-semibold text-emerald-600 uppercase flex items-center gap-1\">\n   122→                  <span className=\"w-3 h-3\"><CheckCircleIcon /></span>\n   123→                  Key Insights\n   124→                </div>\n   125→                {insights.slice(0, 4).map((ins, i) => (\n   126→                  <div key={i} className=\"text-xs text-slate-700 pl-3 border-l-2 border-emerald-300 py-1\">\n   127→                    {ins}\n   128→                  </div>\n   129→                ))}\n   130→              </div>\n   131→            )}\n   132→            {warnings.length > 0 && (\n   133→              <div className=\"space-y-2\">\n   134→                <div className=\"text-[10px] font-semibold text-amber-600 uppercase flex items-center gap-1\">\n   135→                  <span className=\"w-3 h-3\"><AlertIcon /></span>\n   136→                  Warnings\n   137→                </div>\n   138→                {warnings.slice(0, 4).map((w, i) => (\n   139→                  <div key={i} className=\"text-xs text-amber-800 bg-amber-50 rounded px-2 py-1\">\n   140→                    {w}\n   141→                  </div>\n   142→                ))}\n   143→              </div>\n   144→            )}\n   145→            {recommendations.length > 0 && (\n   146→              <div className=\"space-y-2\">\n   147→                <div className=\"text-[10px] font-semibold text-blue-600 uppercase flex items-center gap-1\">\n   148→                  <span className=\"w-3 h-3\"><TargetIcon /></span>\n   149→                  Actions\n   150→                </div>\n   151→                {recommendations.slice(0, 4).map((rec, i) => (\n   152→                  <div key={i} className=\"text-xs text-slate-700 bg-blue-50 rounded px-2 py-1\">\n   153→                    {rec}\n   154→                  </div>\n   155→                ))}\n   156→              </div>\n   157→            )}\n   158→          </div>\n   159→        </div>\n   160→      )}\n   161→    </div>\n   162→  );\n   163→}\n   164→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"05d3e4f1-2259-4f3e-a055-8040a34c8b02","uuid":"a6a5872c-8942-498e-a446-b51e36616943","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\tabs\\PerspectivesTab.tsx","content":"'use client';\n\nimport { useState } from 'react';\nimport type { ResearchPerspective } from '@/src/types/research';\nimport { Section, EmptyState } from '../shared/Cards';\nimport { ConfidenceBadge } from '../shared/Badges';\nimport { ProgressBar } from '../shared/ProgressBar';\nimport { CheckCircleIcon, AlertIcon, TargetIcon, ChevronRightIcon } from '../shared/Icons';\n\ninterface PerspectivesTabProps {\n  perspectives: ResearchPerspective[];\n}\n\nconst perspectiveColors: Record<string, { bg: string; border: string; icon: string }> = {\n  financial: { bg: 'bg-emerald-50', border: 'border-emerald-200', icon: 'text-emerald-600' },\n  investigative: { bg: 'bg-rose-50', border: 'border-rose-200', icon: 'text-rose-600' },\n  strategic: { bg: 'bg-blue-50', border: 'border-blue-200', icon: 'text-blue-600' },\n  competitive: { bg: 'bg-amber-50', border: 'border-amber-200', icon: 'text-amber-600' },\n  technical: { bg: 'bg-indigo-50', border: 'border-indigo-200', icon: 'text-indigo-600' },\n  legal: { bg: 'bg-slate-50', border: 'border-slate-200', icon: 'text-slate-600' },\n  default: { bg: 'bg-slate-50', border: 'border-slate-200', icon: 'text-slate-600' },\n};\n\nexport function PerspectivesTab({ perspectives }: PerspectivesTabProps) {\n  if (perspectives.length === 0) {\n    return <EmptyState message=\"No perspectives available\" />;\n  }\n\n  return (\n    <div className=\"space-y-4\">\n      {/* Comparison Grid */}\n      {perspectives.length > 1 && (\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3\">\n          {perspectives.map((p) => (\n            <ComparisonCard key={p.id} perspective={p} />\n          ))}\n        </div>\n      )}\n\n      {/* Detailed Cards */}\n      <Section title=\"Detailed Analysis\" count={perspectives.length}>\n        <div className=\"space-y-3\">\n          {perspectives.map((p) => (\n            <PerspectiveCard key={p.id} perspective={p} />\n          ))}\n        </div>\n      </Section>\n    </div>\n  );\n}\n\nfunction ComparisonCard({ perspective }: { perspective: ResearchPerspective }) {\n  const colors = perspectiveColors[perspective.perspective_type] || perspectiveColors.default;\n  const insights = perspective.key_insights || [];\n  const warnings = perspective.warnings || [];\n  const confidence = perspective.confidence || 0;\n\n  return (\n    <div className={`${colors.bg} ${colors.border} border rounded-lg p-3`}>\n      <div className=\"flex items-center justify-between mb-2\">\n        <span className={`text-sm font-semibold ${colors.icon} capitalize`}>\n          {perspective.perspective_type.replace('_', ' ')}\n        </span>\n        <ConfidenceBadge score={confidence} />\n      </div>\n      <div className=\"flex items-center gap-4 text-xs text-slate-600\">\n        <span className=\"flex items-center gap-1\">\n          <span className=\"w-3 h-3 text-emerald-500\"><CheckCircleIcon /></span>\n          {insights.length} insights\n        </span>\n        <span className=\"flex items-center gap-1\">\n          <span className=\"w-3 h-3 text-amber-500\"><AlertIcon /></span>\n          {warnings.length} warnings\n        </span>\n      </div>\n    </div>\n  );\n}\n\nfunction PerspectiveCard({ perspective }: { perspective: ResearchPerspective }) {\n  const [expanded, setExpanded] = useState(true);\n  const colors = perspectiveColors[perspective.perspective_type] || perspectiveColors.default;\n  const insights = perspective.key_insights || [];\n  const warnings = perspective.warnings || [];\n  const recommendations = perspective.recommendations || [];\n  const confidence = perspective.confidence || 0;\n\n  return (\n    <div className=\"border border-slate-200 rounded-lg overflow-hidden bg-white\">\n      {/* Header */}\n      <div\n        className={`px-4 py-3 ${colors.bg} cursor-pointer flex items-center gap-3`}\n        onClick={() => setExpanded(!expanded)}\n      >\n        <span className={`w-5 h-5 text-slate-400 transition-transform ${expanded ? 'rotate-90' : ''}`}>\n          <ChevronRightIcon />\n        </span>\n        <span className={`font-semibold ${colors.icon} capitalize flex-1`}>\n          {perspective.perspective_type.replace('_', ' ')} Perspective\n        </span>\n        <div className=\"flex items-center gap-2\">\n          <ProgressBar value={confidence * 100} size=\"sm\" />\n          <span className=\"text-xs text-slate-600 w-8\">{Math.round(confidence * 100)}%</span>\n        </div>\n      </div>\n\n      {/* Body */}\n      {expanded && (\n        <div className=\"p-4 space-y-4\">\n          {/* Analysis */}\n          {perspective.analysis_text && (\n            <p className=\"text-sm text-slate-700 leading-relaxed\">\n              {perspective.analysis_text}\n            </p>\n          )}\n\n          {/* Grid of insights/warnings/recommendations */}\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-3\">\n            {insights.length > 0 && (\n              <div className=\"space-y-2\">\n                <div className=\"text-[10px] font-semibold text-emerald-600 uppercase flex items-center gap-1\">\n                  <span className=\"w-3 h-3\"><CheckCircleIcon /></span>\n                  Key Insights\n                </div>\n                {insights.slice(0, 4).map((ins, i) => (\n                  <div key={i} className=\"text-xs text-slate-700 pl-3 border-l-2 border-emerald-300 py-1\">\n                    {ins}\n                  </div>\n                ))}\n              </div>\n            )}\n            {warnings.length > 0 && (\n              <div className=\"space-y-2\">\n                <div className=\"text-[10px] font-semibold text-amber-600 uppercase flex items-center gap-1\">\n                  <span className=\"w-3 h-3\"><AlertIcon /></span>\n                  Warnings\n                </div>\n                {warnings.slice(0, 4).map((w, i) => (\n                  <div key={i} className=\"text-xs text-amber-800 bg-amber-50 rounded px-2 py-1\">\n                    {w}\n                  </div>\n                ))}\n              </div>\n            )}\n            {recommendations.length > 0 && (\n              <div className=\"space-y-2\">\n                <div className=\"text-[10px] font-semibold text-blue-600 uppercase flex items-center gap-1\">\n                  <span className=\"w-3 h-3\"><TargetIcon /></span>\n                  Actions\n                </div>\n                {recommendations.slice(0, 4).map((rec, i) => (\n                  <div key={i} className=\"text-xs text-slate-700 bg-blue-50 rounded px-2 py-1\">\n                    {rec}\n                  </div>\n                ))}\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}\n","numLines":164,"startLine":1,"totalLines":164}}}
