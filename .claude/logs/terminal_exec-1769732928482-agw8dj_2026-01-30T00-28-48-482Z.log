        <div className=\"space-y-2\">\n   131→            {session.gaps?.slice(0, 3).map((gap, i) => (\n   132→              <div key={i} className=\"p-3 bg-violet-50 border-l-3 border-violet-500 rounded-r-lg\">\n   133→                <div className=\"flex items-center gap-2 mb-1\">\n   134→                  <span className=\"text-[10px] font-semibold text-violet-600 uppercase px-1.5 py-0.5 bg-violet-100 rounded\">\n   135→                    {gap.gap_type}\n   136→                  </span>\n   137→                  <span className=\"text-[10px] text-violet-500\">{gap.priority} priority</span>\n   138→                </div>\n   139→                <p className=\"text-sm text-slate-700\">{gap.description}</p>\n   140→              </div>\n   141→            ))}\n   142→          </div>\n   143→        </Section>\n   144→      )}\n   145→    </div>\n   146→  );\n   147→}\n   148→\n   149→function StatCard({\n   150→  label,\n   151→  value,\n   152→  subtext,\n   153→  icon,\n   154→  color,\n   155→  children,\n   156→}: {\n   157→  label: string;\n   158→  value: string | number;\n   159→  subtext?: string;\n   160→  icon: React.ReactNode;\n   161→  color: 'blue' | 'emerald' | 'amber' | 'red' | 'slate';\n   162→  children?: React.ReactNode;\n   163→}) {\n   164→  const colors = {\n   165→    blue: 'text-blue-600',\n   166→    emerald: 'text-emerald-600',\n   167→    amber: 'text-amber-600',\n   168→    red: 'text-red-600',\n   169→    slate: 'text-slate-600',\n   170→  };\n   171→\n   172→  return (\n   173→    <div className=\"bg-white rounded-lg border border-slate-200 p-3 shadow-sm\">\n   174→      <div className=\"flex items-center justify-between mb-1\">\n   175→        <span className={`w-4 h-4 ${colors[color]}`}>{icon}</span>\n   176→        <span className=\"text-[9px] uppercase tracking-wider text-slate-400\">{label}</span>\n   177→      </div>\n   178→      <div className={`text-2xl font-bold ${colors[color]}`}>{value}</div>\n   179→      {subtext && <div className=\"text-[10px] text-slate-400 mt-0.5\">{subtext}</div>}\n   180→      {children && <div className=\"mt-2\">{children}</div>}\n   181→    </div>\n   182→  );\n   183→}\n   184→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"05d3e4f1-2259-4f3e-a055-8040a34c8b02","uuid":"43c33654-4703-46e3-9108-b944867f2891","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\tabs\\OverviewTab.tsx","content":"'use client';\n\nimport type { SessionWithDetails } from '@/src/types/research';\nimport { Section, QuickStatCard, AlertBanner } from '../shared/Cards';\nimport { ProgressBar, ConfidenceDistribution } from '../shared/ProgressBar';\nimport { DocumentIcon, LinkIcon, UsersIcon, AlertIcon, TargetIcon, CheckCircleIcon } from '../shared/Icons';\n\ninterface OverviewTabProps {\n  session: SessionWithDetails;\n  stats: {\n    findings: number;\n    sources: number;\n    perspectives: number;\n    contradictions: number;\n    gaps: number;\n    avgConfidence: number;\n    highConfidence: number;\n    redFlags: number;\n    highCredSources: number;\n    entities: number;\n  };\n}\n\nexport function OverviewTab({ session, stats }: OverviewTabProps) {\n  const findings = session.findings || [];\n  const allInsights = session.perspectives?.flatMap(p => p.key_insights || []) || [];\n  const allWarnings = session.perspectives?.flatMap(p => p.warnings || []) || [];\n  const allRecommendations = session.perspectives?.flatMap(p => p.recommendations || []) || [];\n\n  // Calculate confidence distribution\n  const highConf = findings.filter(f => (f.confidence_score || 0) >= 0.8).length;\n  const medConf = findings.filter(f => {\n    const c = f.confidence_score || 0;\n    return c >= 0.5 && c < 0.8;\n  }).length;\n  const lowConf = findings.filter(f => (f.confidence_score || 0) < 0.5).length;\n\n  return (\n    <div className=\"space-y-4\">\n      {/* Stats Grid */}\n      <div className=\"grid grid-cols-2 md:grid-cols-5 gap-3\">\n        <StatCard\n          label=\"Findings\"\n          value={stats.findings}\n          subtext={`${stats.highConfidence} high confidence`}\n          icon={<DocumentIcon />}\n          color=\"blue\"\n        >\n          <ConfidenceDistribution high={highConf} medium={medConf} low={lowConf} />\n        </StatCard>\n        <StatCard\n          label=\"Avg Confidence\"\n          value={`${stats.avgConfidence}%`}\n          icon={<TargetIcon />}\n          color={stats.avgConfidence >= 80 ? 'emerald' : stats.avgConfidence >= 50 ? 'amber' : 'red'}\n        >\n          <ProgressBar value={stats.avgConfidence} color=\"auto\" size=\"sm\" />\n        </StatCard>\n        <StatCard\n          label=\"Sources\"\n          value={stats.sources}\n          subtext={`${stats.highCredSources} high credibility`}\n          icon={<LinkIcon />}\n          color=\"emerald\"\n        />\n        <StatCard\n          label=\"Perspectives\"\n          value={stats.perspectives}\n          icon={<UsersIcon />}\n          color=\"slate\"\n        />\n        <StatCard\n          label=\"Red Flags\"\n          value={stats.redFlags}\n          subtext={stats.redFlags > 0 ? 'Review needed' : 'Clear'}\n          icon={<AlertIcon />}\n          color={stats.redFlags > 0 ? 'red' : 'slate'}\n        />\n      </div>\n\n      {/* Warnings Banner */}\n      {allWarnings.length > 0 && (\n        <div className=\"bg-gradient-to-br from-amber-50 to-orange-50 border border-amber-200 rounded-lg p-4\">\n          <div className=\"flex items-center gap-2 text-amber-700 font-semibold text-sm mb-2\">\n            <span className=\"w-4 h-4\"><AlertIcon /></span>\n            Warnings ({allWarnings.length})\n          </div>\n          <ul className=\"space-y-1\">\n            {allWarnings.slice(0, 4).map((w, i) => (\n              <li key={i} className=\"text-sm text-amber-800 pl-6 relative before:content-['•'] before:absolute before:left-2 before:text-amber-400\">\n                {w}\n              </li>\n            ))}\n          </ul>\n        </div>\n      )}\n\n      {/* Key Insights */}\n      {allInsights.length > 0 && (\n        <Section title=\"Key Insights\" count={allInsights.length}>\n          <ul className=\"space-y-2\">\n            {allInsights.slice(0, 6).map((insight, i) => (\n              <li key={i} className=\"flex items-start gap-2 text-sm text-slate-700 pl-3 border-l-2 border-emerald-400 py-1\">\n                {insight}\n              </li>\n            ))}\n          </ul>\n        </Section>\n      )}\n\n      {/* Recommendations */}\n      {allRecommendations.length > 0 && (\n        <Section title=\"Recommended Actions\" count={allRecommendations.length}>\n          <div className=\"space-y-2\">\n            {allRecommendations.slice(0, 5).map((rec, i) => (\n              <div key={i} className=\"flex items-start gap-3 p-2 bg-blue-50 rounded-lg\">\n                <span className=\"w-5 h-5 bg-blue-500 text-white rounded-full flex items-center justify-center text-[10px] font-bold flex-shrink-0 mt-0.5\">\n                  {i + 1}\n                </span>\n                <span className=\"text-sm text-slate-700\">{rec}</span>\n              </div>\n            ))}\n          </div>\n        </Section>\n      )}\n\n      {/* Gaps */}\n      {stats.gaps > 0 && (\n        <Section title=\"Research Gaps\" count={stats.gaps}>\n          <div className=\"space-y-2\">\n            {session.gaps?.slice(0, 3).map((gap, i) => (\n              <div key={i} className=\"p-3 bg-violet-50 border-l-3 border-violet-500 rounded-r-lg\">\n                <div className=\"flex items-center gap-2 mb-1\">\n                  <span className=\"text-[10px] font-semibold text-violet-600 uppercase px-1.5 py-0.5 bg-violet-100 rounded\">\n                    {gap.gap_type}\n                  </span>\n                  <span className=\"text-[10px] text-violet-500\">{gap.priority} priority</span>\n                </div>\n                <p className=\"text-sm text-slate-700\">{gap.description}</p>\n              </div>\n            ))}\n          </div>\n        </Section>\n      )}\n    </div>\n  );\n}\n\nfunction StatCard({\n  label,\n  value,\n  subtext,\n  icon,\n  color,\n  children,\n}: {\n  label: string;\n  value: string | number;\n  subtext?: string;\n  icon: React.ReactNode;\n  color: 'blue' | 'emerald' | 'amber' | 'red' | 'slate';\n  children?: React.ReactNode;\n}) {\n  const colors = {\n    blue: 'text-blue-600',\n    emerald: 'text-emerald-600',\n    amber: 'text-amber-600',\n    red: 'text-red-600',\n    slate: 'text-slate-600',\n  };\n\n  return (\n    <div className=\"bg-white rounded-lg border border-slate-200 p-3 shadow-sm\">\n      <div className=\"flex items-center justify-between mb-1\">\n        <span className={`w-4 h-4 ${colors[color]}`}>{icon}</span>\n        <span className=\"text-[9px] uppercase tracking-wider text-slate-400\">{label}</span>\n      </div>\n      <div className={`text-2xl font-bold ${colors[color]}`}>{value}</div>\n      {subtext && <div className=\"text-[10px] text-slate-400 mt-0.5\">{subtext}</div>}\n      {children && <div className=\"mt-2\">{children}</div>}\n    </div>\n  );\n}\n","numLines":184,"startLine":1,"totalLines":184}}}
