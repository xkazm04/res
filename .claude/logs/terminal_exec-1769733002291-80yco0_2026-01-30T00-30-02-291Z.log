      className=\"bg-red-500 transition-all\"\n   114→        style={{ width: `${(low / total) * 100}%` }}\n   115→      />\n   116→    </div>\n   117→  );\n   118→}\n   119→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"05d3e4f1-2259-4f3e-a055-8040a34c8b02","uuid":"badacc05-9f45-41c8-aa0b-830cb7492a39","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\shared\\ProgressBar.tsx","content":"'use client';\n\ninterface ProgressBarProps {\n  value: number;\n  max?: number;\n  color?: 'blue' | 'emerald' | 'amber' | 'red' | 'auto';\n  size?: 'sm' | 'md';\n  showLabel?: boolean;\n}\n\nexport function ProgressBar({\n  value,\n  max = 100,\n  color = 'auto',\n  size = 'md',\n  showLabel = false,\n}: ProgressBarProps) {\n  const percent = Math.min(100, Math.max(0, (value / max) * 100));\n\n  const getColor = () => {\n    if (color !== 'auto') return color;\n    if (percent >= 80) return 'emerald';\n    if (percent >= 50) return 'amber';\n    return 'red';\n  };\n\n  const colorClass = {\n    blue: 'bg-gradient-to-r from-blue-500 to-blue-600',\n    emerald: 'bg-gradient-to-r from-emerald-500 to-emerald-600',\n    amber: 'bg-gradient-to-r from-amber-500 to-amber-600',\n    red: 'bg-gradient-to-r from-red-500 to-red-600',\n  };\n\n  const sizeClass = {\n    sm: 'h-1',\n    md: 'h-1.5',\n  };\n\n  return (\n    <div className=\"flex items-center gap-2\">\n      <div className={`flex-1 bg-slate-200 rounded-full overflow-hidden ${sizeClass[size]}`}>\n        <div\n          className={`h-full rounded-full transition-all duration-500 ${colorClass[getColor()]}`}\n          style={{ width: `${percent}%` }}\n        />\n      </div>\n      {showLabel && (\n        <span className=\"text-[10px] font-medium text-slate-600 w-8 text-right\">\n          {Math.round(percent)}%\n        </span>\n      )}\n    </div>\n  );\n}\n\ninterface MiniChartProps {\n  data: number[];\n  color?: 'blue' | 'emerald' | 'amber' | 'auto';\n  height?: number;\n}\n\nexport function MiniChart({ data, color = 'blue', height = 20 }: MiniChartProps) {\n  const max = Math.max(...data, 1);\n\n  const getBarColor = (value: number) => {\n    if (color !== 'auto') {\n      const colors = {\n        blue: 'bg-blue-500',\n        emerald: 'bg-emerald-500',\n        amber: 'bg-amber-500',\n      };\n      return colors[color];\n    }\n    const percent = (value / max) * 100;\n    if (percent >= 80) return 'bg-emerald-500';\n    if (percent >= 50) return 'bg-amber-500';\n    return 'bg-red-500';\n  };\n\n  return (\n    <div className=\"flex gap-0.5 items-end\" style={{ height }}>\n      {data.map((value, i) => (\n        <div\n          key={i}\n          className={`flex-1 rounded-t-sm transition-all ${getBarColor(value)}`}\n          style={{ height: `${(value / max) * 100}%`, minWidth: 3 }}\n        />\n      ))}\n    </div>\n  );\n}\n\ninterface ConfidenceDistributionProps {\n  high: number;\n  medium: number;\n  low: number;\n}\n\nexport function ConfidenceDistribution({ high, medium, low }: ConfidenceDistributionProps) {\n  const total = high + medium + low || 1;\n\n  return (\n    <div className=\"flex h-1.5 rounded-full overflow-hidden bg-slate-200\">\n      <div\n        className=\"bg-emerald-500 transition-all\"\n        style={{ width: `${(high / total) * 100}%` }}\n      />\n      <div\n        className=\"bg-amber-500 transition-all\"\n        style={{ width: `${(medium / total) * 100}%` }}\n      />\n      <div\n        className=\"bg-red-500 transition-all\"\n        style={{ width: `${(low / total) * 100}%` }}\n      />\n    </div>\n  );\n}\n","numLines":119,"startLine":1,"totalLines":119}}}
