ence>\n   128→    </div>\n   129→  );\n   130→}\n   131→\n   132→function FilterChip({ label, count, active, onClick }: { label: string; count: number; active: boolean; onClick: () => void }) {\n   133→  const { theme } = useReportTheme();\n   134→  const isRadar = theme === 'radar';\n   135→\n   136→  return (\n   137→    <button\n   138→      onClick={onClick}\n   139→      className={`px-2 py-1 rounded-lg text-xs flex items-center gap-1 transition-all ${\n   140→        active\n   141→          ? isRadar ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/30' : 'bg-stone-800 text-white'\n   142→          : isRadar ? 'bg-slate-800/50 text-slate-400 hover:text-white' : 'bg-stone-100 text-stone-600 hover:bg-stone-200'\n   143→      }`}\n   144→    >\n   145→      {label}\n   146→      <span className={`px-1 py-0.5 rounded text-[9px] ${active ? (isRadar ? 'bg-cyan-500/30' : 'bg-white/20') : 'bg-black/10'}`}>\n   147→        {count}\n   148→      </span>\n   149→    </button>\n   150→  );\n   151→}\n   152→\n   153→function EntityTypeColumn({ type, entities, selectedEntity, onSelect }: {\n   154→  type: EntityType;\n   155→  entities: KnowledgeEntity[];\n   156→  selectedEntity: string | null;\n   157→  onSelect: (id: string | null) => void;\n   158→}) {\n   159→  const { theme } = useReportTheme();\n   160→  const isRadar = theme === 'radar';\n   161→  const config = entityConfig[type];\n   162→\n   163→  return (\n   164→    <motion.div\n   165→      initial={{ opacity: 0, y: 20 }}\n   166→      animate={{ opacity: 1, y: 0 }}\n   167→      className={`rounded-xl overflow-hidden ${isRadar ? 'bg-slate-900/60 border border-cyan-500/10' : 'bg-white border border-stone-200'}`}\n   168→    >\n   169→      <div className={`p-3 ${isRadar ? `bg-gradient-to-r ${config.gradient}` : 'bg-stone-50 border-b border-stone-200'}`}>\n   170→        <h4 className={`text-xs font-semibold capitalize flex items-center gap-2 ${isRadar ? 'text-white' : 'text-stone-900'}`}>\n   171→      