tion.div>\n      )}\n    </AnimatePresence>\n  );\n}\n\ninterface SpotlightTextProps {\n  text: string;\n  className?: string;\n  highlightKeywords?: string[];\n}\n\nexport function SpotlightText({ text, className = '', highlightKeywords = [] }: SpotlightTextProps) {\n  const { theme } = useReportTheme();\n  const isRadar = theme === 'radar';\n  const [hoveredSentence, setHoveredSentence] = useState<number | null>(null);\n\n  const sentences = text.split(/(?<=[.!?])\\s+/);\n\n  const highlightText = useCallback((sentence: string) => {\n    if (highlightKeywords.length === 0) return sentence;\n\n    const regex = new RegExp(`(${highlightKeywords.join('|')})`, 'gi');\n    const parts = sentence.split(regex);\n\n    return parts.map((part, i) => {\n      if (highlightKeywords.some(kw => kw.toLowerCase() === part.toLowerCase())) {\n        return (\n          <mark\n            key={i}\n            className={`px-0.5 rounded ${isRadar ? 'bg-cyan-500/30 text-cyan-200' : 'bg-amber-200 text-amber-900'}`}\n          >\n            {part}\n          </mark>\n        );\n      }\n      return part;\n    });\n  }, [highlightKeywords, isRadar]);\n\n  return (\n    <p className={className}>\n      {sentences.map((sentence, i) => (\n        <motion.span\n          key={i}\n          className=\"inline cursor-pointer transition-opacity\"\n          animate={{\n            opacity: hoveredSentence === null || hoveredSentence === i ? 1 : 0.3,\n          }}\n          onMouseEnter={() => setHoveredSentence(i)}\n          onMouseLeave={() => setHoveredSentence(null)}\n        >\n          {highlightText(sentence)}{' '}\n        </motion.span>\n      ))}\n    </p>\n  );\n}\n","numLines":120,"startLine":1,"totalLines":120}}}
