9-4f3e-a055-8040a34c8b02","uuid":"649c60fa-5711-451f-80b3-cdb818ccfd6e","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\features\\SpeedReader.tsx","content":"'use client';\n\nimport { useState, useEffect, useCallback, useRef } from 'react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport { useReportTheme, useThemeStyles } from '../core/ThemeContext';\n\ninterface SpeedReaderProps {\n  text: string;\n  isActive: boolean;\n  onClose: () => void;\n  wordsPerMinute?: number;\n}\n\nexport function SpeedReader({ text, isActive, onClose, wordsPerMinute = 300 }: SpeedReaderProps) {\n  const { theme } = useReportTheme();\n  const styles = useThemeStyles();\n  const isRadar = theme === 'radar';\n\n  const words = text.split(/\\s+/).filter(w => w.length > 0);\n  const [currentIndex, setCurrentIndex] = useState(0);\n  const [isPlaying, setIsPlaying] = useState(false);\n  const [wpm, setWpm] = useState(wordsPerMinute);\n  const intervalRef = useRef<NodeJS.Timeout | null>(null);\n\n  const currentWord = words[currentIndex] || '';\n  const progress = words.length > 0 ? (currentIndex / words.length) * 100 : 0;\n\n  // Find the optimal focal point (slightly left of center for English)\n  const focalIndex = Math.floor(currentWord.length * 0.35);\n  const beforeFocal = currentWord.slice(0, focalIndex);\n  const focal = currentWord[focalIndex] || '';\n  const afterFocal = currentWord.slice(focalIndex + 1);\n\n  const play = useCallback(() => {\n    setIsPlaying(true);\n  }, []);\n\n  const pause = useCallback(() => {\n    setIsPlaying(false);\n    if (intervalRef.current) {\n      clearInterval(intervalRef.current);\n      intervalRef.current = null;\n    }\n  }, []);\n\n  const reset = useCallback(() => {\n    pause();\n    setCurrentIndex(0);\n  }, [pause]);\n\n  useEffect(() => {\n    if (isPlaying && currentIndex < words.length - 1) {\n      const msPerWord = 60000 / wpm;\n      intervalRef.current = setI