onClose }: FocusModeProps) {\n  const { theme } = useReportTheme();\n  const isRadar = theme === 'radar';\n\n  return (\n    <AnimatePresence>\n      {enabled && (\n        <motion.div\n          initial={{ opacity: 0 }}\n          animate={{ opacity: 1 }}\n          exit={{ opacity: 0 }}\n          className=\"fixed inset-0 z-50 flex items-center justify-center\"\n          onClick={onClose}\n        >\n          {/* Spotlight background */}\n          <div className={`absolute inset-0 ${isRadar ? 'bg-slate-950/98' : 'bg-stone-950/95'}`} />\n\n          {/* Radial gradient spotlight */}\n          <div\n            className=\"absolute inset-0 pointer-events-none\"\n            style={{\n              background: isRadar\n                ? 'radial-gradient(ellipse 60% 50% at center, transparent 0%, rgba(0,0,0,0.8) 100%)'\n                : 'radial-gradient(ellipse 60% 50% at center, transparent 0%, rgba(0,0,0,0.9) 100%)',\n            }}\n          />\n\n          {/* Content */}\n          <motion.div\n            initial={{ scale: 0.9, opacity: 0 }}\n            animate={{ scale: 1, opacity: 1 }}\n            exit={{ scale: 0.9, opacity: 0 }}\n            className={`relative z-10 max-w-3xl max-h-[80vh] overflow-y-auto p-8 rounded-2xl ${isRadar ? 'bg-slate-900/90 border border-cyan-500/30' : 'bg-white shadow-2xl'}`}\n            onClick={(e) => e.stopPropagation()}\n          >\n            {/* Close hint */}\n            <div className={`absolute top-4 right-4 text-xs ${isRadar ? 'text-cyan-400/60' : 'text-stone-400'}`}>\n              Press ESC to exit\n            </div>\n\n            {children}\n          </motion.div>\n\n          {/* Ambient glow for radar theme */}\n          {isRadar && (\n            <div className=\"absolute inset-0 pointer-events-none\">\n              <div className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-cyan-500/5 blur-3xl rounded-full\" />\n            </div>\n          )}\n        </motion.div>\n      )}\n    </AnimatePresence>\n  );\n}\n\ninterface SpotlightTextProps {\n  text: string;\n  className?: string;\n  highlightKeywords?: string[];\n}\n\nexport function SpotlightText({ text, className = '', highlightKeywords = [] }: SpotlightTextProps) {\n  const { theme } = useReportTheme();\n  const isRadar = theme === 'radar';\n  const [hoveredSentence, setHoveredSentence] = useState<number | null>(null);\n\n  const sentences = text.split(/(?<=[.!?])\\s+/);\n\n  const highlightText = useCallback((sentence: string) => {\n    if (highlightKeywords.length === 0) return sentence;\n\n    const regex = new RegExp(`(${highlightKeywords.join('|')})`, 'gi');\n    const parts = sentence.split(regex);\n\n    return parts.map((part, i) => {\n      if (highlightKeywords.some(kw => kw.toLowerCase() === part.toLowerCase())) {\n        return (\n          <mark\n            key={i}\n            className={`px-0.5 rounded ${isRadar ? 'bg-cyan-500/30 text-cyan-200' : 'bg-amber-200 text-amber-900'}`}\n          >\n            {part}\n          </mark>\n        );\n      }\n      return part;\n    });\n  }, [highlightKeywords, isRadar]);\n\n  return (\n    <p className={className}>\n      {sentences.map((sentence, i) => (\n        <motion.span\n          key={i}\n          className=\"inline cursor-pointer transition-opacity\"\n          animate={{\n            opacity: hoveredSentence === null || hoveredSentence === i ? 1 : 0.3,\n          }}\n          onMouseEnter={() => setHoveredSentence(i)}\n          onMouseLeave={() => setHoveredSentence(null)}\n        >\n          {highlightText(sentence)}{' '}\n        </motion.span>\n      ))}\n    </p>\n  );\n}\n","numLines":120,"startLine":1,"totalLines":120}}}
