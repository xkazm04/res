tent":"'use client';\n\nimport { useState, useMemo } from 'react';\nimport { motion } from 'framer-motion';\nimport type { SessionWithDetails } from '@/src/types/research';\nimport { ReportThemeProvider, useThemeStyles, type ReportTheme } from './core/ThemeContext';\nimport { ReportShell } from './ReportShell';\nimport { ThemedSidebar } from './ThemedSidebar';\nimport { OverviewView, FindingsView, SourcesView, PerspectivesView, AnalysisView, EntitiesView } from './views';\n\ntype TabId = 'overview' | 'findings' | 'sources' | 'perspectives' | 'analysis' | 'entities';\n\ninterface ReportViewProps {\n  session: SessionWithDetails;\n  onClose: () => void;\n  theme?: ReportTheme;\n}\n\nexport function ReportView({ session, onClose, theme = 'radar' }: ReportViewProps) {\n  return (\n    <ReportThemeProvider theme={theme}>\n      <ReportViewInner session={session} onClose={onClose} />\n    </ReportThemeProvider>\n  );\n}\n\nfunction ReportViewInner({ session, onClose }: Omit<ReportViewProps, 'theme'>) {\n  const styles = useThemeStyles();\n  const [activeTab, setActiveTab] = useState<TabId>('overview');\n  const [searchQuery, setSearchQuery] = useState('');\n  const [filterType, setFilterType] = useState('all');\n  const [filterConfidence, setFilterConfidence] = useState('all');\n\n  const stats = useMemo(() => {\n    const findings = session.findings || [];\n    const sources = session.sources || [];\n    const avgConfidence = findings.length > 0\n      ? Math.round(findings.reduce((sum, f) => sum + (f.confidence_score || 0), 0) / findings.length * 100)\n      : 0;\n    return {\n      findings: findings.length,\n      sources: sources.length,\n      perspectives: session.perspectives?.length || 0,\n      contradictions: session.contradictions?.length || 0,\n      gaps: session.gaps?.length || 0,\n      avgConfidence,\n      highConfidence: findings.filter(f => (f.confidence_score || 0) >= 0.8).length,\n      redFlags: findings.filter(f => f.finding_type === 'gap' || f.content.toLowerCase().includes('risk')).length,\n      entities: session.entities?.length || 0,\n    };\n  }, [session]);\n\n  const findingTypes = useMemo(() =>\n    Array.from(new Set(session.findings?.map(f => f.finding_type) || [])),\n    [session.findings]\n  );\n\n  return (\n    <ReportShell onClose={onClose}>\n      <ThemedSidebar activeTab={activeTab} onTabChange={setActiveTab} stats={stats} onClose={onClose} />\n\n      <main className={`flex-1 flex flex-col overflow-hidden ${styles.bg}`}>\n        {/* Header */}\n        <header className={`px-6 py-4 border-b ${styles.border}`}>\n          <motion.h1 initial={{ opacity: 0, y: -10 }} animate={{ opacity: 1, y: 0 }} className={`text-lg font-bold ${styles.text}`}>\n            {session.title}\n          </motion.h1>\n        </header>\n\n        {/* Toolbar */}\n        {activeTab !== 'overview' && (\n          <Toolbar\n            searchQuery={searchQuery}\n            onSearchChange={setSearchQuery}\n            filterType={filterType}\n            onFilterTypeChange={setFilterType}\n            filterConfidence={filterConfidence}\n            onFilterConfidenceChange={setFilterConfidence}\n            findingTypes={findingTypes}\n            showTypeFilter={activeTab === 'findings'}\n            showConfidenceFilter={activeTab === 'findings' || activeTab === 'sources'}\n          />\n        )}\n\n        {/* Content */}\n        <div className=\"flex-1 overflow-y-auto p-6\">\n          <div className=\"max-w-5xl mx-auto\">\n            {activeTab === 'overview' && <OverviewView session={session} stats={stats} />}\n            {activeTab === 'findings' && <FindingsView findings={session.findings || []} sources={session.sources || []} searchQuery={searchQuery} filterType={filterType} filterConfidence={filterConfidence} />}\n            {activeTab === 'sources' && <SourcesView sources={session.sources || []} searchQuery={searchQuery} filterConfidence={filterConfidence} />}\n            {activeTab === 'perspectives' && <PerspectivesView perspectives={session.perspectives || []} />}\n            {activeTab === 'analysis' && <AnalysisView contradictions={session.contradictions || []} gaps={session.gaps || []} causalChains={session.causal_chains || []} />}\n            {activeTab === 'entities' && <EntitiesView entities={session.entities || []} />}\n          </div>\n        </div>\n      </main>\n    </ReportShell>\n  );\n}\n\nfunction Toolbar({ searchQuery, onSearchChange, filterType, onFilterTypeChange, filterConfidence, onFilterConfidenceChange, findingTypes, showTypeFilter, showConfidenceFilter }: {\n  searchQuery: string;\n  onSearchChange: (v: string) => void;\n  filterType: string;\n  onFilterTypeChange: (v: string) => void;\n  filterConfidence: string;\n  onFilterConfidenceChange: (v: string) => void;\n  findingTypes: string[];\n  showTypeFilter: boolean;\n  showConfidenceFilter: boolean;\n}) {\n  const styles = useThemeStyles();\n  return (\n    <div className={`px-6 py-3 border-b ${styles.border} flex flex-wrap gap-3`}>\n      <input\n        type=\"text\"\n        placeholder=\"Search...\"\n        value={searchQuery}\n        onChange={(e) => onSearchChange(e.target.value)}\n        className={`flex-1 min-w-[200px] px-3 py-1.5 text-sm rounded-lg ${styles.bgSecondary} ${styles.border} border ${styles.text} focus:outline-none`}\n      />\n      {showTypeFilter && (\n        <select value={filterType} onChange={(e) => onFilterTypeChange(e.target.value)} className={`px-3 py-1.5 text-sm rounded-lg ${styles.bgSecondary} ${styles.border} border ${styles.text}`}>\n          <option value=\"all\">All Types</option>\n          {findingTypes.map(t => <option key={t} value={t}>{t}</option>)}\n        </select>\n      )}\n      {showConfidenceFilter && (\n        <select value={filterConfidence} onChange={(e) => onFilterConfidenceChange(e.target.value)} className={`px-3 py-1.5 text-sm rounded-lg ${styles.bgSecondary} ${styles.border} border ${styles.text}`}>\n          <option value=\"all\">All Confidence</option>\n          <option value=\"high\">High (80%+)</option>\n          <option value=\"medium\">Medium (50-79%)</option>\n          <option value=\"low\">Low (&lt;50%)</option>\n        </select>\n      )}\n    </div>\n  );\n}\n","numLines":139,"startLine":1,"totalLines":139}}}
