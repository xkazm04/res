abChange, stats, onClose }: ThemedSidebarProps) {\n    44→  return (\n    45→    <aside className=\"w-56 flex flex-col border-r border-cyan-500/20 bg-slate-950/50\">\n    46→      {/* Header */}\n    47→      <div className=\"p-4 border-b border-cyan-500/20\">\n    48→        <div className=\"flex items-center gap-2\">\n    49→          <div className=\"w-8 h-8 rounded-lg bg-gradient-to-br from-cyan-400 to-blue-500 flex items-center justify-center\">\n    50→            <span className=\"text-white text-xs font-bold\">DR</span>\n    51→          </div>\n    52→          <div>\n    53→            <div className=\"text-sm font-semibold text-white\">Deep Research</div>\n    54→            <div className=\"text-[10px] text-cyan-400/60\">Intelligence Report</div>\n    55→          </div>\n    56→        </div>\n    57→      </div>\n    58→\n    59→      {/* Confidence Ring */}\n    60→      <div className=\"p-4 flex justify-center border-b border-cyan-500/10\">\n    61→        <AnimatedProgressRing\n    62→          value={stats.avgConfidence}\n    63→          size={80}\n    64→          strokeWidth={6}\n    65→          color=\"#22d3ee\"\n    66→          bgColor=\"rgba(34,211,238,0.1)\"\n    67→        />\n    68→      </div>\n    69→\n    70→      {/* Navigation */}\n    71→      <nav className=\"flex-1 p-2 space-y-1\">\n    72→        {tabs.map((tab, i) => {\n    73→          const count = tab.key ? stats[tab.key] : tab.id === 'analysis' ? stats.contradictions + stats.gaps : null;\n    74→          const isActive = activeTab === tab.id;\n    75→          return (\n    76→            <motion.button\n    77→              key={tab.id}\n    78→              initial={{ opacity: 0, x: -20 }}\n    79→              animate={{ opacity: 1, x: 0 }}\n    80→              transition={{ delay: i * 0.05 }}\n    81→              onClick={() => onTabChange(tab.id)}\n    82→              className={`w-full px-3 py-2 rounded-lg text-left text-sm transition-all flex items-center gap-2 ${\n    83→                isActive\n    84→                  ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/30'\n    85→                  : 'text-slate-400 hover:text-white hover:bg-white/5'\n    86→              }`}\n    87→            >\n    88→              {isActive && <PulsingDot color=\"bg-cyan-400\" />}\n    89→              <span className=\"flex-1\">{tab.label}</span>\n    90→              {count !== null && (\n    91→                <span className=\"text-[10px] px-1.5 py-0.5 rounded bg-white/10\">\n    92→                  <AnimatedNumber value={count} />\n    93→                </span>\n    94→              )}\n    95→            </motion.button>\n    96→          );\n    97→        })}\n    98→      </nav>\n    99→\n   100→      {/* Stats */}\n   101→      <div className=\"p-3 border-t border-cyan-500/10 space-y-2\">\n   102→        {stats.redFlags > 0 && (\n   103→          <div className=\"flex items-center gap-2 px-2 py-1.5 rounded bg-rose-500/10 border border-rose-500/20\">\n   104→            <PulsingDot color=\"bg-rose-500\" />\n   105→            <span className=\"text-xs text-rose-400\">{stats.redFlags} Red Flags</span>\n   106→          </div>\n   107→        )}\n   108→      </div>\n   109→\n   110→      {/* Close */}\n   111→      <div className=\"p-3\">\n   112→        <button onClick={onClose} className=\"w-full px-3 py-2 text-xs text-slate-400 hover:text-white border border-cyan-500/20 hover:border-cyan-500/40 rounded-lg transition-all\">\n   113→          Close Report\n   114→        </button>\n   115→      </div>\n   116→    </aside>\n   117→  );\n   118→}\n   119→\n   120→function SwissSidebar({ activeTab, onTabChange, stats, onClose }: ThemedSidebarProps) {\n   121→  return (\n   122→    <aside className=\"w-52 flex flex-col border-r border-stone-200 bg-white\">\n   123→      {/* Header */}\n   124→      <div className=\"p-4 border-b border-stone-200\">\n   125→        <div className=\"text-lg font-bold text-stone-900 tracking-tight\">Research</div>\n   126→        <div className=\"text-[10px] uppercase tracking-[0.2em] text-stone-400 mt-0.5\">Intelligence Report</div>\n   127→      </div>\n   128→\n   129→      {/* Big number */}\n   130→      <div className=\"p-4 border-b border-stone-100\">\n   131→        <div className=\"text-4xl font-bold text-stone-900 tabular-nums\">\n   132→          <AnimatedNumber value={stats.avgConfidence} suffix=\"%\" />\n   133→        </div>\n   134→        <div className=\"text-[10px] uppercase tracking-wider text-stone-400 mt-1\">Confidence Score</div>\n   135→      </div>\n   136→\n   137→      {/* Navigation */}\n   138→      <nav className=\"flex-1 py-2\">\n   139→        {tabs.map((tab, i) => {\n   140→          const count = tab.key ? stats[tab.key] : tab.id === 'analysis' ? stats.contradictions + stats.gaps : null;\n   141→          const isActive = activeTab === tab.id;\n   142→          return (\n   143→            <motion.button\n   144→              key={tab.id}\n   145→              initial={{ opacity: 0 }}\n   146→              animate={{ opacity: 1 }}\n   147→              transition={{ delay: i * 0.03 }}\n   148→              onClick={() => onTabChange(tab.id)}\n   149→              className={`w-full px-4 py-2.5 text-left text-sm flex items-center border-l-2 transition-all ${\n   150→                isActive\n   151→                  ? 'border-stone-900 bg-stone-50 text-stone-900 font-medium'\n   152→                  : 'border-transparent text-stone-500 hover:text-stone-900 hover:bg-stone-50'\n   153→              }`}\n   154→            >\n   155→              <span className=\"flex-1\">{tab.label}</span>\n   156→              {count !== null && (\n   157→                <span className=\"text-xs tabular-nums text-stone-400\">{count}</span>\n   158→              )}\n   159→            </motion.button>\n   160→          );\n   161→        })}\n   162→      </nav>\n   163→\n   164→      {/* Stats */}\n   165→      {stats.redFlags > 0 && (\n   166→        <div className=\"mx-4 mb-3 px-3 py-2 border-l-2 border-rose-600 bg-rose-50\">\n   167→          <div className=\"text-xs font-medium text-rose-700\">{stats.redFlags} Issues Found</div>\n   168→        </div>\n   169→      )}\n   170→\n   171→      {/* Close */}\n   172→      <div className=\"p-3 border-t border-stone-100\">\n   173→        <button onClick={onClose} className=\"w-full px-3 py-2 text-xs text-stone-500 hover:text-stone-900 border border-stone-200 hover:border-stone-900 rounded transition-all\">\n   174→          Close\n   175→        </button>\n   176→      </div>\n   177→    </aside>\n   178→  );\n   179→}\n   180→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"05d3e4f1-2259-4f3e-a055-8040a34c8b02","uuid":"e27d0bbb-7e36-43d4-9cf2-7ffcf663476c","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\ThemedSidebar.tsx","content":"'use client';\n\nimport { motion } from 'framer-motion';\nimport { useReportTheme, useThemeStyles } from './core/ThemeContext';\nimport { AnimatedNumber, AnimatedProgressRing, PulsingDot } from './core/AnimatedNumber';\n\ntype TabId = 'overview' | 'findings' | 'sources' | 'perspectives' | 'analysis' | 'entities';\n\ninterface ThemedSidebarProps {\n  activeTab: TabId;\n  onTabChange: (tab: TabId) => void;\n  stats: {\n    findings: number;\n    sources: number;\n    perspectives: number;\n    contradictions: number;\n    gaps: number;\n    avgConfidence: number;\n    redFlags: number;\n    entities: number;\n  };\n  onClose: () => void;\n}\n\nconst tabs: { id: TabId; label: string; key: keyof ThemedSidebarProps['stats'] | null }[] = [\n  { id: 'overview', label: 'Overview', key: null },\n  { id: 'findings', label: 'Findings', key: 'findings' },\n  { id: 'sources', label: 'Sources', key: 'sources' },\n  { id: 'perspectives', label: 'Perspectives', key: 'perspectives' },\n  { id: 'analysis', label: 'Analysis', key: null },\n  { id: 'entities', label: 'Entities', key: 'entities' },\n];\n\nexport function ThemedSidebar({ activeTab, onTabChange, stats, onClose }: ThemedSidebarProps) {\n  const { theme } = useReportTheme();\n  return theme === 'radar' ? (\n    <RadarSidebar activeTab={activeTab} onTabChange={onTabChange} stats={stats} onClose={onClose} />\n  ) : (\n    <SwissSidebar activeTab={activeTab} onTabChange={onTabChange} stats={stats} onClose={onClose} />\n  );\n}\n\nfunction RadarSidebar({ activeTab, onTabChange, stats, onClose }: ThemedSidebarProps) {\n  return (\n    <aside className=\"w-56 flex flex-col border-r border-cyan-500/20 bg-slate-950/50\">\n      {/* Header */}\n      <div className=\"p-4 border-b border-cyan-500/20\">\n        <div className=\"flex items-center gap-2\">\n          <div className=\"w-8 h-8 rounded-lg bg-gradient-to-br from-cyan-400 to-blue-500 flex items-center justify-center\">\n            <span className=\"text-white text-xs font-bold\">DR</span>\n          </div>\n          <div>\n            <div className=\"text-sm font-semibold text-white\">Deep Research</div>\n            <div className=\"text-[10px] text-cyan-400/60\">Intelligence Report</div>\n          </div>\n        </div>\n      </div>\n\n      {/* Confidence Ring */}\n      <div className=\"p-4 flex justify-center border-b border-cyan-500/10\">\n        <AnimatedProgressRing\n          value={stats.avgConfidence}\n          size={80}\n          strokeWidth={6}\n          color=\"#22d3ee\"\n          bgColor=\"rgba(34,211,238,0.1)\"\n        />\n      </div>\n\n      {/* Navigation */}\n      <nav className=\"flex-1 p-2 space-y-1\">\n        {tabs.map((tab, i) => {\n          const count = tab.key ? stats[tab.key] : tab.id === 'analysis' ? stats.contradictions + stats.gaps : null;\n          const isActive = activeTab === tab.id;\n          return (\n            <motion.button\n              key={tab.id}\n              initial={{ opacity: 0, x: -20 }}\n              animate={{ opacity: 1, x: 0 }}\n              transition={{ delay: i * 0.05 }}\n              onClick={() => onTabChange(tab.id)}\n              className={`w-full px-3 py-2 rounded-lg text-left text-sm transition-all flex items-center gap-2 ${\n                isActive\n                  ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/30'\n                  : 'text-slate-400 hover:text-white hover:bg-white/5'\n              }`}\n            >\n              {isActive && <PulsingDot color=\"bg-cyan-400\" />}\n              <span className=\"flex-1\">{tab.label}</span>\n              {count !== null && (\n                <span className=\"text-[10px] px-1.5 py-0.5 rounded bg-white/10\">\n                  <AnimatedNumber value={count} />\n                </span>\n              )}\n            </motion.button>\n          );\n        })}\n      </nav>\n\n      {/* Stats */}\n      <div className=\"p-3 border-t border-cyan-500/10 space-y-2\">\n        {stats.redFlags > 0 && (\n          <div className=\"flex items-center gap-2 px-2 py-1.5 rounded bg-rose-500/10 border border-rose-500/20\">\n            <PulsingDot color=\"bg-rose-500\" />\n            <span className=\"text-xs text-rose-400\">{stats.redFlags} Red Flags</span>\n          </div>\n        )}\n      </div>\n\n      {/* Close */}\n      <div className=\"p-3\">\n        <button onClick={onClose} className=\"w-full px-3 py-2 text-xs text-slate-400 hover:text-white border border-cyan-500/20 hover:border-cyan-500/40 rounded-lg transition-all\">\n          Close Report\n        </button>\n      </div>\n    </aside>\n  );\n}\n\nfunction SwissSidebar({ activeTab, onTabChange, stats, onClose }: ThemedSidebarProps) {\n  return (\n    <aside className=\"w-52 flex flex-col border-r border-stone-200 bg-white\">\n      {/* Header */}\n      <div className=\"p-4 border-b border-stone-200\">\n        <div className=\"text-lg font-bold text-stone-900 tracking-tight\">Research</div>\n        <div className=\"text-[10px] uppercase tracking-[0.2em] text-stone-400 mt-0.5\">Intelligence Report</div>\n      </div>\n\n      {/* Big number */}\n      <div className=\"p-4 border-b border-stone-100\">\n        <div className=\"text-4xl font-bold text-stone-900 tabular-nums\">\n          <AnimatedNumber value={stats.avgConfidence} suffix=\"%\" />\n        </div>\n        <div className=\"text-[10px] uppercase tracking-wider text-stone-400 mt-1\">Confidence Score</div>\n      </div>\n\n      {/* Navigation */}\n      <nav className=\"flex-1 py-2\">\n        {tabs.map((tab, i) => {\n          const count = tab.key ? stats[tab.key] : tab.id === 'analysis' ? stats.contradictions + stats.gaps : null;\n          const isActive = activeTab === tab.id;\n          return (\n            <motion.button\n              key={tab.id}\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              transition={{ delay: i * 0.03 }}\n              onClick={() => onTabChange(tab.id)}\n              className={`w-full px-4 py-2.5 text-left text-sm flex items-center border-l-2 transition-all ${\n                isActive\n                  ? 'border-stone-900 bg-stone-50 text-stone-900 font-medium'\n                  : 'border-transparent text-stone-500 hover:text-stone-900 hover:bg-stone-50'\n              }`}\n            >\n              <span className=\"flex-1\">{tab.label}</span>\n              {count !== null && (\n                <span className=\"text-xs tabular-nums text-stone-400\">{count}</span>\n              )}\n            </motion.button>\n          );\n        })}\n      </nav>\n\n      {/* Stats */}\n      {stats.redFlags > 0 && (\n        <div className=\"mx-4 mb-3 px-3 py-2 border-l-2 border-rose-600 bg-rose-50\">\n          <div className=\"text-xs font-medium text-rose-700\">{stats.redFlags} Issues Found</div>\n        </div>\n      )}\n\n      {/* Close */}\n      <div className=\"p-3 border-t border-stone-100\">\n        <button onClick={onClose} className=\"w-full px-3 py-2 text-xs text-stone-500 hover:text-stone-900 border border-stone-200 hover:border-stone-900 rounded transition-all\">\n          Close\n        </button>\n      </div>\n    </aside>\n  );\n}\n","numLines":180,"startLine":1,"totalLines":180}}}
