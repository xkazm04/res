ne-800';\n    47→  const mutedClass = isRadar ? 'text-slate-400' : 'text-stone-600';\n    48→\n    49→  // Loading state\n    50→  if (currentSessionLoading) {\n    51→    return (\n    52→      <AnimatePresence>\n    53→        <motion.div\n    54→          initial={{ opacity: 0 }}\n    55→          animate={{ opacity: 1 }}\n    56→          exit={{ opacity: 0 }}\n    57→          className={`fixed inset-0 z-50 flex items-center justify-center backdrop-blur-sm ${bgClass}`}\n    58→        >\n    59→          <motion.div\n    60→            initial={{ scale: 0.9, opacity: 0 }}\n    61→            animate={{ scale: 1, opacity: 1 }}\n    62→            className={`rounded-2xl p-8 border ${cardClass}`}\n    63→          >\n    64→            <div className=\"flex items-center gap-4\">\n    65→              <div className={`w-8 h-8 border-2 ${isRadar ? 'border-cyan-400 border-t-transparent' : 'border-stone-800 border-t-transparent'} rounded-full animate-spin`} />\n    66→              <div>\n    67→                <div className={`font-medium ${textClass}`}>Loading Intelligence</div>\n    68→                <div className={`text-sm ${mutedClass}`}>Retrieving research data...</div>\n    69→              </div>\n    70→            </div>\n    71→          </motion.div>\n    72→        </motion.div>\n    73→      </AnimatePresence>\n    74→    );\n    75→  }\n    76→\n    77→  // Error state\n    78→  if (currentSessionError) {\n    79→    return (\n    80→      <AnimatePresence>\n    81→        <motion.div\n    82→          initial={{ opacity: 0 }}\n    83→          animate={{ opacity: 1 }}\n    84→          exit={{ opacity: 0 }}\n    85→          className={`fixed inset-0 z-50 flex items-center justify-center backdrop-blur-sm ${bgClass}`}\n    86→        >\n    87→          <motion.div\n    88→            initial={{ scale: 0.9, opacity: 0 }}\n    89→            animate={{ scale: 1, opacity: 1 }}\n    90→            className={`rounded-2xl p-8 max-w-md border ${cardClass}`}\n    91→          >\n    92→            <div className=\"text-center\">\n    93→              <div className={`w-12 h-12 mx-auto mb-4 rounded-full ${isRadar ? 'bg-rose-500/20' : 'bg-rose-100'} flex items-center justify-center`}>\n    94→                <svg className={`w-6 h-6 ${isRadar ? 'text-rose-400' : 'text-rose-600'}`} viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\">\n    95→                  <circle cx=\"12\" cy=\"12\" r=\"10\" />\n    96→                  <line x1=\"15\" y1=\"9\" x2=\"9\" y2=\"15\" />\n    97→                  <line x1=\"9\" y1=\"9\" x2=\"15\" y2=\"15\" />\n    98→                </svg>\n    99→              </div>\n   100→              <h3 className={`text-lg font-semibold mb-2 ${textClass}`}>Failed to Load</h3>\n   101→              <p className={`text-sm mb-4 ${mutedClass}`}>{currentSessionError}</p>\n   102→              <button\n   103→                onClick={() => { clearCurrentSession(); closeReportModal(); }}\n   104→                className={`px-4 py-2 rounded-lg transition-colors ${isRadar ? 'bg-cyan-500/20 text-cyan-300 hover:bg-cyan-500/30 border border-cyan-500/30' : 'bg-stone-800 text-white hover:bg-stone-700'}`}\n   105→              >\n   106→                Close\n   107→              </button>\n   108→            </div>\n   109→          </motion.div>\n   110→        </motion.div>\n   111→      </AnimatePresence>\n   112→    );\n   113→  }\n   114→\n   115→  if (!currentSession) return null;\n   116→\n   117→  return (\n   118→    <ReportView\n   119→      session={currentSession}\n   120→      onClose={closeReportModal}\n   121→      theme={theme}\n   122→    />\n   123→  );\n   124→}\n   125→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"05d3e4f1-2259-4f3e-a055-8040a34c8b02","uuid":"f7e3e7e3-ecdb-4159-8df9-4cd78b53dcc1","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\layout\\ReportModal.tsx","content":"'use client';\n\nimport { useEffect } from 'react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport { useAppStore } from '@/src/stores/appStore';\nimport { useThemeStore } from '@/src/stores/themeStore';\nimport { ReportView } from '@/src/components/report/ReportView';\n\nexport function ReportModal() {\n  const { theme } = useThemeStore();\n  const {\n    currentSession,\n    currentSessionLoading,\n    currentSessionError,\n    isReportModalOpen,\n    closeReportModal,\n    clearCurrentSession,\n  } = useAppStore();\n\n  // Handle escape key\n  useEffect(() => {\n    const handleEscape = (e: KeyboardEvent) => {\n      if (e.key === 'Escape' && isReportModalOpen) {\n        closeReportModal();\n      }\n    };\n    window.addEventListener('keydown', handleEscape);\n    return () => window.removeEventListener('keydown', handleEscape);\n  }, [isReportModalOpen, closeReportModal]);\n\n  // Prevent body scroll when modal is open\n  useEffect(() => {\n    if (isReportModalOpen) {\n      document.body.style.overflow = 'hidden';\n    } else {\n      document.body.style.overflow = '';\n    }\n    return () => { document.body.style.overflow = ''; };\n  }, [isReportModalOpen]);\n\n  if (!isReportModalOpen) return null;\n\n  const isRadar = theme === 'radar';\n  const bgClass = isRadar ? 'bg-slate-950/95' : 'bg-stone-100/95';\n  const cardClass = isRadar ? 'bg-slate-900 border-cyan-500/20' : 'bg-white border-stone-200';\n  const textClass = isRadar ? 'text-slate-100' : 'text-stone-800';\n  const mutedClass = isRadar ? 'text-slate-400' : 'text-stone-600';\n\n  // Loading state\n  if (currentSessionLoading) {\n    return (\n      <AnimatePresence>\n        <motion.div\n          initial={{ opacity: 0 }}\n          animate={{ opacity: 1 }}\n          exit={{ opacity: 0 }}\n          className={`fixed inset-0 z-50 flex items-center justify-center backdrop-blur-sm ${bgClass}`}\n        >\n          <motion.div\n            initial={{ scale: 0.9, opacity: 0 }}\n            animate={{ scale: 1, opacity: 1 }}\n            className={`rounded-2xl p-8 border ${cardClass}`}\n          >\n            <div className=\"flex items-center gap-4\">\n              <div className={`w-8 h-8 border-2 ${isRadar ? 'border-cyan-400 border-t-transparent' : 'border-stone-800 border-t-transparent'} rounded-full animate-spin`} />\n              <div>\n                <div className={`font-medium ${textClass}`}>Loading Intelligence</div>\n                <div className={`text-sm ${mutedClass}`}>Retrieving research data...</div>\n              </div>\n            </div>\n          </motion.div>\n        </motion.div>\n      </AnimatePresence>\n    );\n  }\n\n  // Error state\n  if (currentSessionError) {\n    return (\n      <AnimatePresence>\n        <motion.div\n          initial={{ opacity: 0 }}\n          animate={{ opacity: 1 }}\n          exit={{ opacity: 0 }}\n          className={`fixed inset-0 z-50 flex items-center justify-center backdrop-blur-sm ${bgClass}`}\n        >\n          <motion.div\n            initial={{ scale: 0.9, opacity: 0 }}\n            animate={{ scale: 1, opacity: 1 }}\n            className={`rounded-2xl p-8 max-w-md border ${cardClass}`}\n          >\n            <div className=\"text-center\">\n              <div className={`w-12 h-12 mx-auto mb-4 rounded-full ${isRadar ? 'bg-rose-500/20' : 'bg-rose-100'} flex items-center justify-center`}>\n                <svg className={`w-6 h-6 ${isRadar ? 'text-rose-400' : 'text-rose-600'}`} viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\">\n                  <circle cx=\"12\" cy=\"12\" r=\"10\" />\n                  <line x1=\"15\" y1=\"9\" x2=\"9\" y2=\"15\" />\n                  <line x1=\"9\" y1=\"9\" x2=\"15\" y2=\"15\" />\n                </svg>\n              </div>\n              <h3 className={`text-lg font-semibold mb-2 ${textClass}`}>Failed to Load</h3>\n              <p className={`text-sm mb-4 ${mutedClass}`}>{currentSessionError}</p>\n              <button\n                onClick={() => { clearCurrentSession(); closeReportModal(); }}\n                className={`px-4 py-2 rounded-lg transition-colors ${isRadar ? 'bg-cyan-500/20 text-cyan-300 hover:bg-cyan-500/30 border border-cyan-500/30' : 'bg-stone-800 text-white hover:bg-stone-700'}`}\n              >\n                Close\n              </button>\n            </div>\n          </motion.div>\n        </motion.div>\n      </AnimatePresence>\n    );\n  }\n\n  if (!currentSession) return null;\n\n  return (\n    <ReportView\n      session={currentSession}\n      onClose={closeReportModal}\n      theme={theme}\n    />\n  );\n}\n","numLines":125,"startLine":1,"totalLines":125}}}
