con /></span>\n   125→                {query}\n   126→              </li>\n   127→            ))}\n   128→          </ul>\n   129→        </div>\n   130→      )}\n   131→    </div>\n   132→  );\n   133→}\n   134→\n   135→function CausalChainCard({ chain }: { chain: CausalChain }) {\n   136→  const descriptions = chain.descriptions || [];\n   137→\n   138→  return (\n   139→    <div className=\"p-4 bg-blue-50 border border-blue-200 rounded-lg\">\n   140→      <div className=\"flex items-center gap-2 mb-3\">\n   141→        <span className=\"text-xs font-semibold text-blue-700 uppercase\">Causal Chain</span>\n   142→        <span className=\"text-[10px] text-blue-500\">\n   143→          {descriptions.length} step{descriptions.length !== 1 ? 's' : ''}\n   144→        </span>\n   145→      </div>\n   146→\n   147→      {/* Chain visualization */}\n   148→      <div className=\"flex flex-wrap items-center gap-1\">\n   149→        {descriptions.map((desc, i) => (\n   150→          <div key={i} className=\"flex items-center gap-1\">\n   151→            <div className=\"px-2 py-1 bg-white rounded border border-blue-100 text-xs text-slate-700\">\n   152→              {desc}\n   153→            </div>\n   154→            {i < descriptions.length - 1 && (\n   155→              <span className=\"w-4 h-4 text-blue-400\"><ArrowRightIcon /></span>\n   156→            )}\n   157→          </div>\n   158→        ))}\n   159→      </div>\n   160→    </div>\n   161→  );\n   162→}\n   163→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"05d3e4f1-2259-4f3e-a055-8040a34c8b02","uuid":"498eee3d-d089-4cc5-aa64-6f882c99a78d","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\tabs\\AnalysisTab.tsx","content":"'use client';\n\nimport type { ResearchContradiction, ResearchGap, CausalChain } from '@/src/types/research';\nimport { Section, EmptyState } from '../shared/Cards';\nimport { PriorityBadge } from '../shared/Badges';\nimport { AlertIcon, TargetIcon, ArrowRightIcon } from '../shared/Icons';\n\ninterface AnalysisTabProps {\n  contradictions: ResearchContradiction[];\n  gaps: ResearchGap[];\n  causalChains: CausalChain[];\n}\n\nexport function AnalysisTab({ contradictions, gaps, causalChains }: AnalysisTabProps) {\n  const hasContent = contradictions.length > 0 || gaps.length > 0 || causalChains.length > 0;\n\n  if (!hasContent) {\n    return <EmptyState message=\"No analysis data available\" />;\n  }\n\n  return (\n    <div className=\"space-y-4\">\n      {/* Contradictions */}\n      {contradictions.length > 0 && (\n        <Section title=\"Contradictions\" count={contradictions.length} collapsible defaultExpanded>\n          <div className=\"space-y-3\">\n            {contradictions.map((c) => (\n              <ContradictionCard key={c.id} contradiction={c} />\n            ))}\n          </div>\n        </Section>\n      )}\n\n      {/* Research Gaps */}\n      {gaps.length > 0 && (\n        <Section title=\"Research Gaps\" count={gaps.length} collapsible defaultExpanded>\n          <div className=\"space-y-3\">\n            {gaps.map((g) => (\n              <GapCard key={g.id} gap={g} />\n            ))}\n          </div>\n        </Section>\n      )}\n\n      {/* Causal Chains */}\n      {causalChains.length > 0 && (\n        <Section title=\"Causal Chains\" count={causalChains.length} collapsible defaultExpanded>\n          <div className=\"space-y-3\">\n            {causalChains.map((chain) => (\n              <CausalChainCard key={chain.id} chain={chain} />\n            ))}\n          </div>\n        </Section>\n      )}\n    </div>\n  );\n}\n\nfunction ContradictionCard({ contradiction }: { contradiction: ResearchContradiction }) {\n  return (\n    <div className=\"p-4 bg-red-50 border border-red-200 rounded-lg\">\n      <div className=\"flex items-center gap-2 mb-2\">\n        <span className=\"w-4 h-4 text-red-600\"><AlertIcon /></span>\n        <span className=\"text-xs font-semibold text-red-700 uppercase\">Contradiction</span>\n        {contradiction.significance && (\n          <span className=\"text-[10px] px-1.5 py-0.5 bg-red-100 text-red-700 rounded\">\n            {contradiction.significance}\n          </span>\n        )}\n      </div>\n\n      {/* Conflicting claims */}\n      <div className=\"space-y-2 mb-3\">\n        <div className=\"p-2 bg-white rounded border border-red-100\">\n          <div className=\"text-[10px] text-red-500 mb-1\">Claim A</div>\n          <p className=\"text-sm text-slate-700\">{contradiction.claim_1}</p>\n          {contradiction.source_1 && (\n            <p className=\"text-[10px] text-slate-500 mt-1\">Source: {contradiction.source_1}</p>\n          )}\n        </div>\n        <div className=\"flex justify-center\">\n          <span className=\"text-xs text-red-400\">VS</span>\n        </div>\n        <div className=\"p-2 bg-white rounded border border-red-100\">\n          <div className=\"text-[10px] text-red-500 mb-1\">Claim B</div>\n          <p className=\"text-sm text-slate-700\">{contradiction.claim_2}</p>\n          {contradiction.source_2 && (\n            <p className=\"text-[10px] text-slate-500 mt-1\">Source: {contradiction.source_2}</p>\n          )}\n        </div>\n      </div>\n\n      {/* Resolution hint */}\n      {contradiction.resolution_hint && (\n        <div className=\"text-xs text-slate-600 bg-white p-2 rounded border border-slate-100\">\n          <span className=\"font-medium\">Resolution hint:</span> {contradiction.resolution_hint}\n        </div>\n      )}\n    </div>\n  );\n}\n\nfunction GapCard({ gap }: { gap: ResearchGap }) {\n  const suggestedQueries = gap.suggested_queries || [];\n\n  return (\n    <div className=\"p-4 bg-violet-50 border border-violet-200 rounded-lg\">\n      <div className=\"flex items-center justify-between mb-2\">\n        <div className=\"flex items-center gap-2\">\n          <span className=\"w-4 h-4 text-violet-600\"><TargetIcon /></span>\n          <span className=\"text-xs font-semibold text-violet-700 uppercase\">{gap.gap_type} Gap</span>\n        </div>\n        <PriorityBadge priority={gap.priority} />\n      </div>\n\n      <p className=\"text-sm text-slate-700 mb-3\">{gap.description}</p>\n\n      {suggestedQueries.length > 0 && (\n        <div className=\"bg-white p-2 rounded border border-violet-100\">\n          <div className=\"text-[10px] text-violet-600 font-medium mb-1\">Suggested Queries</div>\n          <ul className=\"space-y-1\">\n            {suggestedQueries.slice(0, 3).map((query, i) => (\n              <li key={i} className=\"text-xs text-slate-600 flex items-center gap-1\">\n                <span className=\"w-3 h-3 text-violet-400\"><ArrowRightIcon /></span>\n                {query}\n              </li>\n            ))}\n          </ul>\n        </div>\n      )}\n    </div>\n  );\n}\n\nfunction CausalChainCard({ chain }: { chain: CausalChain }) {\n  const descriptions = chain.descriptions || [];\n\n  return (\n    <div className=\"p-4 bg-blue-50 border border-blue-200 rounded-lg\">\n      <div className=\"flex items-center gap-2 mb-3\">\n        <span className=\"text-xs font-semibold text-blue-700 uppercase\">Causal Chain</span>\n        <span className=\"text-[10px] text-blue-500\">\n          {descriptions.length} step{descriptions.length !== 1 ? 's' : ''}\n        </span>\n      </div>\n\n      {/* Chain visualization */}\n      <div className=\"flex flex-wrap items-center gap-1\">\n        {descriptions.map((desc, i) => (\n          <div key={i} className=\"flex items-center gap-1\">\n            <div className=\"px-2 py-1 bg-white rounded border border-blue-100 text-xs text-slate-700\">\n              {desc}\n            </div>\n            {i < descriptions.length - 1 && (\n              <span className=\"w-4 h-4 text-blue-400\"><ArrowRightIcon /></span>\n            )}\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n}\n","numLines":163,"startLine":1,"totalLines":163}}}
