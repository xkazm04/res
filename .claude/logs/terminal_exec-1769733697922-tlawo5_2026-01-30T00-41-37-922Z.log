ources]);\n    46→\n    47→  if (filteredFindings.length === 0) {\n    48→    return <EmptyState message=\"No findings match your filters\" />;\n    49→  }\n    50→\n    51→  return (\n    52→    <Section title=\"Findings\" count={filteredFindings.length}>\n    53→      <div className=\"space-y-2\">\n    54→        {filteredFindings.map((finding) => (\n    55→          <FindingCard key={finding.id} finding={finding} sourceMap={sourceMap} />\n    56→        ))}\n    57→      </div>\n    58→    </Section>\n    59→  );\n    60→}\n    61→\n    62→function FindingCard({\n    63→  finding,\n    64→  sourceMap,\n    65→}: {\n    66→  finding: ResearchFinding;\n    67→  sourceMap: Map<string, ResearchSource>;\n    68→}) {\n    69→  const [expanded, setExpanded] = useState(false);\n    70→  const supportingSources = finding.supporting_sources || [];\n    71→  const confidence = finding.confidence_score || 0;\n    72→\n    73→  // Get summary (first sentence or first 120 chars)\n    74→  const summary = finding.content.split('.')[0] + '.';\n    75→  const hasMore = finding.content.length > summary.length + 10;\n    76→\n    77→  return (\n    78→    <div className=\"border border-slate-200 rounded-lg overflow-hidden bg-white\">\n    79→      {/* Header - always visible */}\n    80→      <div\n    81→        className=\"flex items-center gap-3 px-4 py-3 bg-slate-50/50 cursor-pointer hover:bg-slate-50 transition-colors\"\n    82→        onClick={() => setExpanded(!expanded)}\n    83→      >\n    84→        <span className={`w-5 h-5 text-slate-400 transition-transform ${expanded ? 'rotate-90' : ''}`}>\n    85→          <ChevronRightIcon />\n    86→        </span>\n    87→        <TypeBadge type={finding.finding_type} />\n    88→        <span className=\"flex-1 text-sm text-slate-700 line-clamp-1\">{summary}</span>\n    89→        <ConfidenceBadge score={confidence} />\n    90→      </div>\n    91→\n    92→      {/* Body - expandable */}\n    93→      {expanded && (\n    94→     