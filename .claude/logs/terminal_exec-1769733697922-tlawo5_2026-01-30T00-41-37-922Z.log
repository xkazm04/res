onf = findings.filter(f => {\n    const c = f.confidence_score || 0;\n    return c >= 0.5 && c < 0.8;\n  }).length;\n  const lowConf = findings.filter(f => (f.confidence_score || 0) < 0.5).length;\n\n  return (\n    <div className=\"space-y-4\">\n      {/* Stats Grid */}\n      <div className=\"grid grid-cols-2 md:grid-cols-5 gap-3\">\n        <StatCard\n          label=\"Findings\"\n          value={stats.findings}\n          subtext={`${stats.highConfidence} high confidence`}\n          icon={<DocumentIcon />}\n          color=\"blue\"\n        >\n          <ConfidenceDistribution high={highConf} medium={medConf} low={lowConf} />\n        </StatCard>\n        <StatCard\n          label=\"Avg Confidence\"\n          value={`${stats.avgConfidence}%`}\n          icon={<TargetIcon />}\n          color={stats.avgConfidence >= 80 ? 'emerald' : stats.avgConfidence >= 50 ? 'amber' : 'red'}\n        >\n          <ProgressBar value={stats.avgConfidence} color=\"auto\" size=\"sm\" />\n        </StatCard>\n        <StatCard\n          label=\"Sources\"\n          value={stats.sources}\n          subtext={`${stats.highCredSources} high credibility`}\n          icon={<LinkIcon />}\n          color=\"emerald\"\n        />\n        <StatCard\n          label=\"Perspectives\"\n          value={stats.perspectives}\n          icon={<UsersIcon />}\n          color=\"slate\"\n        />\n        <StatCard\n          label=\"Red Flags\"\n          value={stats.redFlags}\n          subtext={stats.redFlags > 0 ? 'Review needed' : 'Clear'}\n          icon={<AlertIcon />}\n          color={stats.redFlags > 0 ? 'red' : 'slate'}\n        />\n      </div>\n\n      {/* Warnings Banner */}\n      {allWarnings.length > 0 && (\n        <div className=\"bg-gradient-to-br from-amber-50 to-orange-50 border border-amber-200 rounded-lg p-4\">\n          <div className=\"flex items-center gap-2 text-amber-700 font-semibold text-sm mb-2\">\n            <span className=\"w-4 h-4\"><AlertIcon /></span>\n            Warnings ({allWarnings.length})\n          </div>\n          <ul className=\"space-y-1\">\n            {allWarnings.slice(0, 4).map((w, i) => (\n              <li key={i} className=\"text-sm text-amber-800 pl-6 relative before:content-['•'] before:absolute before:left-2 before:text-amber-400\">\n                {w}\n              </li>\n            ))}\n          </ul>\n        </div>\n      )}\n\n      {/* Key Insights */}\n      {allInsights.length > 0 && (\n        <Section title=\"Key Insights\" count={allInsights.length}>\n          <ul className=\"space-y-2\">\n            {allInsights.slice(0, 6).map((insight, i) => (\n              <li key={i} className=\"flex items-start gap-2 text-sm text-slate-700 pl-3 border-l-2 border-emerald-400 py-1\">\n                {insight}\n              </li>\n            ))}\n          </ul>\n        </Section>\n      )}\n\n      {/* Recommendations */}\n      {allRecommendations.length > 0 && (\n        <Section title=\"Recommended Actions\" count={allRecommendations.length}>\n          <div className=\"space-y-2\">\n            {allRecommendations.slice(0, 5).map((rec, i) => (\n              <div key={i} className=\"flex items-start gap-3 p-2 bg-blue-50 rounded-lg\">\n                <span className=\"w-5 h-5 bg-blue-500 text-white rounded-full flex items-center justify-center text-[10px] font-bold flex-shrink-0 mt-0.5\">\n                  {i + 1}\n                </span>\n                <span className=\"text-sm text-slate-700\">{rec}</span>\n              </div>\n            ))}\n          </div>\n        </Section>\n      )}\n\n      {/* Gaps */}\n      {stats.gaps > 0 && (\n        <Section title=\"Research Gaps\" count={stats.gaps}>\n          <div className=\"space-y-2\">\n            {session.gaps?.slice(0, 3).map((gap, i) => (\n              <div key={i} className=\"p-3 bg-violet-50 border-l-3 border-violet-500 rounded-r-lg\">\n                <div className=\"flex items-center gap-2 mb-1\">\n                  <span className=\"text-[10px] font-semibold text-violet-600 uppercase px-1.5 py-0.5 bg-violet-100 rounded\">\n                    {gap.gap_type}\n                  </span>\n                  <span className=\"text-[10px] text-violet-500\">{gap.priority} priority</span>\n                </div>\n                <p className=\"text-sm text-slate-700\">{gap.description}</p>\n              </div>\n            ))}\n          </div>\n        </Section>\n      )}\n    </div>\n  );\n}\n\nfunction StatCard({\n  label,\n  value,\n  subtext,\n  icon,\n  color,\n  children,\n}: {\n  label: string;\n  value: string | number;\n  subtext?: string;\n  icon: React.ReactNode;\n  color: 'blue' | 'emerald' | 'amber' | 'red' | 'slate';\n  children?: React.ReactNode;\n}) {\n  const colors = {\n    blue: 'text-blue-600',\n    emerald: 'text-emerald-600',\n    amber: 'text-amber-600',\n    red: 'text-red-600',\n    slate: 'text-slate-600',\n  };\n\n  return (\n    <div className=\"bg-white rounded-lg border border-slate-200 p-3 shadow-sm\">\n      <div className=\"flex items-center justify-between mb-1\">\n        <span className={`w-4 h-4 ${colors[color]}`}>{icon}</span>\n        <span className=\"text-[9px] uppercase tracking-wider text-slate-400\">{label}</span>\n      </div>\n      <div className={`text-2xl font-bold ${colors[color]}`}>{value}</div>\n      {subtext && <div className=\"text-[10px] text-slate-400 mt-0.5\">{subtext}</div>}\n      {children && <div className=\"mt-2\">{children}</div>}\n    </div>\n  );\n}\n","numLines":184,"startLine":1,"totalLines":184}}}
