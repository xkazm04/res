      <StatCard\n    43→          label=\"Findings\"\n    44→          value={stats.findings}\n    45→          subtext={`${stats.highConfidence} high confidence`}\n    46→          icon={<DocumentIcon />}\n    47→          color=\"blue\"\n    48→        >\n    49→          <ConfidenceDistribution high={highConf} medium={medConf} low={lowConf} />\n    50→        </StatCard>\n    51→        <StatCard\n    52→          label=\"Avg Confidence\"\n    53→          value={`${stats.avgConfidence}%`}\n    54→          icon={<TargetIcon />}\n    55→          color={stats.avgConfidence >= 80 ? 'emerald' : stats.avgConfidence >= 50 ? 'amber' : 'red'}\n    56→        >\n    57→          <ProgressBar value={stats.avgConfidence} color=\"auto\" size=\"sm\" />\n    58→        </StatCard>\n    59→        <StatCard\n    60→          label=\"Sources\"\n    61→          value={stats.sources}\n    62→          subtext={`${stats.highCredSources} high credibility`}\n    63→          icon={<LinkIcon />}\n    64→          color=\"emerald\"\n    65→        />\n    66→        <StatCard\n    67→          label=\"Perspectives\"\n    68→          value={stats.perspectives}\n    69→          icon={<UsersIcon />}\n    70→          color=\"slate\"\n    71→        />\n    72→        <StatCard\n    73→          label=\"Red Flags\"\n    74→          value={stats.redFlags}\n    75→          subtext={stats.redFlags > 0 ? 'Review needed' : 'Clear'}\n    76→          icon={<AlertIcon />}\n    77→          color={stats.redFlags > 0 ? 'red' : 'slate'}\n    78→        />\n    79→      </div>\n    80→\n    81→      {/* Warnings Banner */}\n    82→      {allWarnings.length > 0 && (\n    83→        <div className=\"bg-gradient-to-br from-amber-50 to-orange-50 border border-amber-200 rounded-lg p-4\">\n    84→          <div className=\"flex items-center gap-2 text-amber-700 font-semibold text-sm mb-2\">\n    85→            <span className=\"w-4 h-4\"><AlertIcon /></span>\n    86→            Warnings ({allWarning