[2026-01-30T08:01:10.937Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TiRAXExzGxLHtg39eTFPFB","type":"tool_result","content":"     1→'use client';\n     2→\n     3→import { useMemo, useState } from 'react';\n     4→import { motion } from 'framer-motion';\n     5→import type { SessionWithDetails } from '@/src/types/research';\n     6→import { useReportTheme, useThemeStyles } from '../core/ThemeContext';\n     7→import { ThemedSection, ThemedBadge } from '../ThemedCards';\n     8→import { AnimatedNumber } from '../core/AnimatedNumber';\n     9→import { IntelDashboard } from '../features/IntelDashboard';\n    10→import { KeyPointsPanel } from '../features/KeyPointsPanel';\n    11→import { ConfidenceHeatmap } from '../visualizations/ConfidenceHeatmap';\n    12→import { Timeline } from '../visualizations/Timeline';\n    13→import { VideoOverview } from '../video/VideoOverview';\n    14→\n    15→interface OverviewViewProps {\n    16→  session: SessionWithDetails;\n    17→  stats: {\n    18→    findings: number;\n    19→    sources: number;\n    20→    perspectives: number;\n    21→    avgConfidence: number;\n    22→    highConfidence: number;\n    23→    redFlags: number;\n    24→    gaps: number;\n    25→  };\n    26→}\n    27→\n    28→type ViewMode = 'video' | 'static';\n    29→\n    30→export function OverviewView({ session, stats }: OverviewViewProps) {\n    31→  const { theme } = useReportTheme();\n    32→  const styles = useThemeStyles();\n    33→  const findings = session.findings || [];\n    34→  const isRadar = theme === 'radar';\n    35→  const [viewMode, setViewMode] = useState<ViewMode>('video');\n    36→\n    37→  // Calculate metrics for dashboard\n    38→  const coverage = Math.min(100, Math.round((stats.sources / Math.max(10, stats.findings * 2)) * 100));\n    39→  const reliability = Math.round((findings.filter(f => (f.confidence_score || 0) >= 0.7).length / Math.max(1, findings.length)) * 100);\n    40→  const completeness = Math.min(100, 100 - (stats.gaps * 10));\n    41→\n    42→  const allWarnings = session.perspectives?.flatMap(p => p.warnings || []) || [];\n    43→\n    44→  return (\n    45→    <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} className=\"space-y-6\">\n    46→      {/* View mode toggle */}\n    47→      <div className=\"flex items-center justify-between\">\n    48→        <h2 className={`text-sm font-semibold ${styles.text}`}>Overview</h2>\n    49→        <div className={`flex rounded-lg overflow-hidden ${isRadar ? 'bg-slate-800' : 'bg-stone-200'}`}>\n    50→          <button\n    51→            onClick={() => setViewMode('video')}\n    52→            className={`px-3 py-1.5 text-xs font-medium flex items-center gap-1 transition-colors ${\n    53→              viewMode === 'video'\n    54→                ? isRadar ? 'bg-cyan-500/20 text-cyan-300' : 'bg-white text-stone-900'\n    55→                : isRadar ? 'text-slate-400 hover:text-white' : 'text-stone-600 hover:text-stone-900'\n    56→            }`}\n    57→          >\n    58→            <svg className=\"w-3 h-3\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M8 5v14l11-7z\" /></svg>\n    59→            Video\n    60→          </button>\n    61→          <button\n    62→            onClick={() => setViewMode('static')}\n    63→            className={`px-3 py-1.5 text-xs font-medium flex items-center gap-1 transition-colors ${\n    64→              viewMode === 'static'\n    65→                ? isRadar ? 'bg-cyan-500/20 text-cyan-300' : 'bg-white text-stone-900'\n    66→                : isRadar ? 'text-slate-400 hover:text-white' : 'text-stone-600 hover:text-stone-900'\n    67→            }`}\n    68→          >\n    69→            <svg className=\"w-3 h-3\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M4 6h16M4 12h16M4 18h16\" /></svg>\n    70→            Static\n    71→          </button>\n    72→        </div>\n    73→      </div>\n    74→\n    75→      {/* Video mode */}\n    76→      {viewMode === 'video' && <VideoOverview session={session} stats={stats} />}\n    77→\n    78→      {/* Static mode */}\n    79→      {viewMode === 'static' && <StaticOverview session={session} stats={stats} coverage={coverage} reliability={reliability} completeness={completeness} allWarnings={allWarnings} />}\n    80→    </motion.div>\n    81→  );\n    82→}\n    83→\n    84→function StaticOverview({ session, stats, coverage, reliability, completeness, allWarnings }: {\n    85→  session: SessionWithDetails;\n    86→  stats: OverviewViewProps['stats'];\n    87→  coverage: number;\n    88→  reliability: number;\n    89→  completeness: number;\n    90→  allWarnings: string[];\n    91→}) {\n    92→  const { theme } = useReportTheme();\n    93→  const styles = useThemeStyles();\n    94→  const isRadar = theme === 'radar';\n    95→  const findings = session.findings || [];\n    96→\n    97→  const keyPoints = useMemo(() => {\n    98→    const points: Array<{ id: string; text: string; type: 'insight' | 'warning' | 'action' | 'fact'; confidence: number; sourceCount: number }> = [];\n    99→    session.perspectives?.forEach(p => {\n   100→      p.key_insights?.forEach((insight, i) => { points.push({ id: `insight-${p.id}-${i}`, text: insight, type: 'insight', confidence: p.confidence || 0.7, sourceCount: p.sources_cited?.length || 0 }); });\n   101→      p.warnings?.forEach((warning, i) => { points.push({ id: `warning-${p.id}-${i}`, text: warning, type: 'warning', confidence: 0.9, sourceCount: 1 }); });\n   102→      p.recommendations?.forEach((rec, i) => { points.push({ id: `action-${p.id}-${i}`, text: rec, type: 'action', confidence: 0.8, sourceCount: 1 }); });\n   103→    });\n   104→    findings.slice(0, 5).forEach(f => { points.push({ id: f.id, text: f.content.slice(0, 150), type: 'fact', confidence: f.confidence_score || 0.5, sourceCount: f.supporting_sources?.length 