[2026-01-30T08:07:33.427Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HwKjL6BeP1gCBGoovsB8Yg","type":"tool_result","content":"     1→'use client';\n     2→\n     3→import { useMemo, useState } from 'react';\n     4→import { motion } from 'framer-motion';\n     5→import type { SessionWithDetails } from '@/src/types/research';\n     6→import { useReportTheme, useThemeStyles } from '../core/ThemeContext';\n     7→import { ThemedSection, ThemedBadge } from '../ThemedCards';\n     8→import { AnimatedNumber } from '../core/AnimatedNumber';\n     9→import { IntelDashboard } from '../features/IntelDashboard';\n    10→import { KeyPointsPanel } from '../features/KeyPointsPanel';\n    11→import { ConfidenceHeatmap } from '../visualizations/ConfidenceHeatmap';\n    12→import { Timeline } from '../visualizations/Timeline';\n    13→import { VideoOverview } from '../video/VideoOverview';\n    14→\n    15→interface OverviewViewProps {\n    16→  session: SessionWithDetails;\n    17→  stats: {\n    18→    findings: number;\n    19→    sources: number;\n    20→    perspectives: number;\n    21→    avgConfidence: number;\n    22→    highConfidence: number;\n    23→    redFlags: number;\n    24→    gaps: number;\n    25→  };\n    26→}\n    27→\n    28→type ViewMode = 'video' | 'static';\n    29→\n    30→export function OverviewView({ session, stats }: OverviewViewProps) {\n    31→  const { theme } = useReportTheme();\n    32→  const styles = useThemeStyles();\n    33→  const findings = session.findings || [];\n    34→  const isRadar = theme === 'radar';\n    35→  const [viewMode, setViewMode] = useState<ViewMode>('video');\n    36→\n    37→  // Calculate metrics for dashboard\n    38→  const coverage = Math.min(100, Math.round((stats.sources / Math.max(10, stats.findings * 2)) * 100));\n    39→  const reliability = Math.round((findings.filter(f => (f.confidence_score || 0) >= 0.7).length / Math.max(1, findings.length)) * 100);\n    40→  const completeness = Math.min(100, 100 - (stats.gaps * 10));\n    41→\n    42→  const allWarnings = session.perspectives?.flatMap(p => p.warnings || []) || [];\n    43→\n    44→  return (\n    45→    <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} className=\"space-y-6\">\n    46→      {/* View mode toggle */}\n    47→      <div className=\"flex items-center justify-between\">\n    48→        <h2 className={`text-sm font-semibold ${styles.text}`}>Overview</h2>\n    49→        <div className={`flex rounded-lg overflow-hidden ${isRadar ? 'bg-slate-800' : 'bg-stone-200'}`}>\n    50→          <button\n    51→            onClick={() => setViewMode('video')}\n    52→            className={`px-3 py-1.5 text-xs font-medium flex items-center gap-1 transition-colors ${\n    53→              viewMode === 'video'\n    54→                ? isRadar ? 'bg-cyan-500/20 text-cyan-300' : 'bg-white text-stone-900'\n    55→                : isRadar ? 'text-slate-400 hover:text-white' : 'text-stone-600 hover:text-stone-900'\n    56→            }`}\n    57→          >\n    58→            <svg className=\"w-3 h-3\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M8 5v14l11-7z\" /></svg>\n    59→            Video\n    60→          </button>\n    61→          <button\n    62→            onClick={() => setViewMode('static')}\n    63→            className={`px-3 py-1.5 text-xs font-medium flex items-center gap-1 transition-colors ${\n    64→              viewMode === 'static'\n    65→                ? isRadar ? 'bg-cyan-500/20 text-cyan-300' : 'bg-white text-stone-900'\n    66→                : isRadar ? 'text-slate-400 hover:text-white' : 'text-stone-600 hover:text-stone-900'\n    67→            }`}\n    68→          >\n    69→            <svg className=\"w-3 h-3\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M4 6h16M4 12h16M4 18h16\" /></svg>\n    70→            Static\n    71→          </button>\n    72→        </div>\n    73→      </div>\n    74→\n    75→      {/* Video mode */}\n    76→      {viewMode === 'video' && <VideoOverview session={session} stats={stats} />}\n    77→\n    78→      {/* Static mode */}\n    79→      {viewMode === 'static' && <StaticOverview session={session} stats={stats} coverage={coverage} reliability={reliability} completeness={completeness} allWarnings={allWarnings} />}\n    80→    </motion.div>\n    81→  );\n    82→}\n    83→\n    84→function StaticOverview({ session, stats, coverage, reliability, completeness, allWarnings }: {\n    85→  session: SessionWithDetails;\n    86→  stats: OverviewViewProps['stats'];\n    87→  coverage: number;\n    88→  reliability: number;\n    89→  completeness: number;\n    90→  allWarnings: string[];\n    91→}) {\n    92→  const { theme } = useReportTheme();\n    93→  const styles = useThemeStyles();\n    94→  const isRadar = theme === 'radar';\n    95→  const findings = session.findings || [];\n    96→\n    97→  // Single memoized computation for all derived data, keyed by session.id for stability\n    98→  const { keyPoints, heatmapData, timelineEvents } = useMemo(() => {\n    99→    // Key points from perspectives and findings\n   100→    const points: Array<{ id: string; text: string; type: 'insight' | 'warning' | 'action' | 'fact'; confidence: number; sourceCount: number }> = [];\n   101→    session.perspectives?.forEach(p => {\n   102→      p.key_insights?.forEach((insight, i) => { points.push({ id: `insight-${p.id}-${i}`, text: insight, type: 'insight', confidence: p.confidence || 0.7, sourceCount: p.sources_cited?.length || 0 }); });\n   103→      p.warnings?.forEach((warning, i) => { points.push({ id: `warning-${p.id}-${i}`, text: warning, type: 'warning', confidence: 0.9, sourceCount: 1 }); });\n   104→      p.recommendations?.forEach((rec, i) => { points.push({ id: `action-${p.id}-${i}`, text: rec, type: 'action', confidence: 0.8, sourceCount: 1 }); });\n   105→    });\n   106→    findings.slice(0, 5).forEach(f => { points.push({ id: f.id, text: f.content.slice(0, 150), type: 'fact', confidence: f.confidence_score || 0.5, sourceCount: f.supporting_sources?.length || 0 }); });\n   107→\n   108→    // Heatmap data from findings confidence\n   109→    const heatmap = findings.slice(0, 25).map(f => ({ id: f.id, label: f.content.slice(0, 40) + '...', value: f.confidence_score || 0.5 }));\n   110→\n   111→    // Timeline events from dated findings\n   112→    const timeline = findings.filter(f => f.event_date).map(f => ({\n   113→      id: f.id,\n   114→      date: new Date(f.event_date!),\n   115→      label: f.content.slice(0, 50) + '...',\n   116→      type: (f.temporal_context === 'prediction' ? 'prediction' : f.finding_type === 'event' ? 'event' : 'finding') as 'finding' | 'event' | 'prediction',\n   117→      confidence: f.confidence_score,\n   118→    })).slice(0, 15);\n   119→\n   120→    return {\n   121→      keyPoints: points.slice(0, 12),\n   122→      heatmapData: heatmap,\n   123→      timelineEvents: timeline,\n   124→    };\n   125→  }, [session.id, session.perspectives, findings]);\n   126→\n   127→  return (\n   128→    <>\n   129→      <IntelDashboard\n   130→        confidence={stats.avgConfidence}\n   131→        findings={{ label: 'Findings', value: stats.findings, sublabel: `${stats.highConfidence} verified` }}\n   132→        sources={{ label: 'Sources', value: stats.sources, sublabel: 'analyzed' }}\n   133→        coverage={coverage}\n   134→        reliability={reliability}\n   135→        completeness={completeness}\n   136→        alerts={stats.redFlags + allWarnings.length}\n   137→      />\n   138→\n   139→      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n   140→        <KeyPointsPanel points={keyPoints} />\n   141→        {heatmapData.length > 0 && <ConfidenceHeatmap data={heatmapData} title=\"Finding Confidence Distribution\" />}\n   142→      </div>\n   143→\n   144→      {timelineEvents.length > 0 && <Timeline events={timelineEvents} />}\n   145→\n   146→      {allWarnings.length > 0 && (\n   147→        <motion.div initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.3 }}\n   148→          className={`rounded-xl p-4 ${isRadar ? 'bg-rose-500/10 border border-rose-500/30' : 'bg-rose-50 border-l-4 border-rose-600'}`}>\n   149→          <div className={`flex items-center gap-2 mb-3 ${isRadar ? 'text-rose-400' : 'text-rose-700'}`}>\n   150→            <motion.span animate={{ scale: [1, 1.2, 1] }} transition={{ duration: 2, repeat: Infinity }}>⚠️</motion.span>\n   151→            <span className=\"font-semibold\">Critical Warnings ({allWarnings.length})</span>\n   152→          </div>\n   153→          <ul className=\"space-y-2\">\n   154→            {allWarnings.slice(0, 4).map((warning, i) => (\n   155→              <motion.li key={i} initial={{ opacity: 0, x: -10 }} animate={{ opacity: 1, x: 0 }} transition={{ delay: 0.4 + i * 0.1 }}\n   156→                className={`text-sm ${isRadar ? 'text-rose-300/80' : 'text-rose-800'}`}>• {warning}</motion.li>\n   157→            ))}\n   158→          </ul>\n   159→        </motion.div>\n   160→      )}\n   161→\n   162→      {stats.gaps > 0 && (\n   163→        <ThemedSection title=\"Research Gaps\" count={stats.gaps} delay={0.5}>\n   164→          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3\">\n   165→            {session.gaps?.slice(0, 4).map((gap, i) => (\n   166→              <motion.div key={gap.id} initial={{ opacity: 0, scale: 0.95 }} animate={{ opacity: 1, scale: 1 }} transition={{ delay: 0.6 + i * 0.1 }}\n   167→                className={`p-3 rounded-lg ${isRadar ? 'bg-violet-500/10 border border-violet-500/20' : 'bg-violet-50 border-l-2 border-violet-600'}`}>\n   168→                <div className=\"flex items-center gap-2 mb-1\">\n   169→                  <ThemedBadge variant=\"warning\">{gap.gap_type}</ThemedBadge>\n   170→                  <span className={`text-[10px] ${styles.textMuted}`}>{gap.priority}</span>\n   171→                </div>\n   172→                <p className={`text-sm ${isRadar ? 'text-violet-200/80' : 'text-stone-700'}`}>{gap.description}</p>\n   173→              </motion.div>\n   174→            ))}\n   175→          </div>\n   176→        </ThemedSection>\n   177→      )}\n   178→    </>\n   179→  );\n   180→}\n   181→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"a8a4f9ca-6a40-4b19-853c-2be96846861c","uuid":"33190344-c002-4289-be22-9257945f3246","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\views\\OverviewView.tsx","content":"'use client';\n\nimport { useMemo, useState } from 'react';\nimport { motion } from 'framer-motion';\nimport type { SessionWithDetails } from '@/src/types/research';\nimport { useReportTheme, useThemeStyles } from '../core/ThemeContext';\nimport { ThemedSection, ThemedBadge } from '../ThemedCards';\nimport { AnimatedNumber } from '../core/AnimatedNumber';\nimport { IntelDashboard } from '../features/IntelDashboard';\nimport { KeyPointsPanel } from '../features/KeyPointsPanel';\nimport { ConfidenceHeatmap } from '../visualizations/ConfidenceHeatmap';\nimport { Timeline } from '../visualizations/Timeline';\nimport { VideoOverview } from '../video/VideoOverview';\n\ninterface OverviewViewProps {\n  session: SessionWithDetails;\n  stats: {\n    findings: number;\n    sources: number;\n    perspectives: number;\n    avgConfidence: number;\n    highConfidence: number;\n    redFlags: number;\n    gaps: number;\n  };\n}\n\ntype ViewMode = 'video' | 'static';\n\nexport function OverviewView({ session, stats }: OverviewViewProps) {\n  const { theme } = useReportTheme();\n  const styles = useThemeStyles();\n  const findings = session.findings || [];\n  const isRadar = theme === 'radar';\n  const [viewMode, setViewMode] = useState<ViewMode>('video');\n\n  // Calculate metrics for dashboard\n  const coverage = Math.min(100, Math.round((stats.sources / Math.max(10, stats.findings * 2)) * 100));\n  const reliability = Math.round((findings.filter(f => (f.confidence_score || 0) >= 0.7).length / Math.max(1, findings.length)) * 100);\n  const completeness = Math.min(100, 100 - (stats.gaps * 10));\n\n  const allWarnings = session.perspectives?.flatMap(p => p.warnings || []) || [];\n\n  return (\n    <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} className=\"space-y-6\">\n      {/* View mode toggle */}\n      <div className=\"flex items-center justify-between\">\n        <h2 className={`text-sm font-semibold ${styles.text}`}>Overview</h2>\n        <div className={`flex rounded-lg overflow-hidden ${isRadar ? 'bg-slate-800' : 'bg-stone-200'}`}>\n          <button\n            onClick={() => setViewMode('video')}\n            className={`px-3 py-1.5 text-xs font-medium flex items-center gap-1 transition-colors ${\n              viewMode === 'video'\n                ? isRadar ? 'bg-cyan-500/20 text-cyan-300' : 'bg-white text-stone-900'\n                : isRadar ? 'text-slate-400 hover:text-white' : 'text-stone-600 hover:text-stone-900'\n            }`}\n          >\n            <svg className=\"w-3 h-3\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M8 5v14l11-7z\" /></svg>\n            Video\n          </button>\n          <button\n            onClick={() => setViewMode('static')}\n            className={`px-3 py-1.5 text-xs font-medium flex items-center gap-1 transition-colors ${\n              viewMode === 'static'\n                ? isRadar ? 'bg-cyan-500/20 text-cyan-300' : 'bg-white text-stone-900'\n                : isRadar ? 'text-slate-400 hover:text-white' : 'text-stone-600 hover:text-stone-900'\n            }`}\n          >\n            <svg className=\"w-3 h-3\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M4 6h16M4 12h16M4 18h16\" /></svg>\n            Static\n          </button>\n        </div>\n      </div>\n\n      {/* Video mode */}\n      {viewMode === 'video' && <VideoOverview session={session} stats={stats} />}\n\n      {/* Static mode */}\n      {viewMode === 'static' && <StaticOverview session={session} stats={stats} coverage={coverage} reliability={reliability} completeness={completeness} allWarnings={allWarnings} />}\n    </motion.div>\n  );\n}\n\nfunction StaticOverview({ session, stats, coverage, reliability, completeness, allWarnings }: {\n  session: SessionWithDetails;\n  stats: OverviewViewProps['stats'];\n  coverage: number;\n  reliability: number;\n  completeness: number;\n  allWarnings: string[];\n}) {\n  const { theme } = useReportTheme();\n  const styles = useThemeStyles();\n  const isRadar = theme === 'radar';\n  const findings = session.findings || [];\n\n  // Single memoized computation for all derived data, keyed by session.id for stability\n  const { keyPoints, heatmapData, timelineEvents } = useMemo(() => {\n    // Key points from perspectives and findings\n    const points: Array<{ id: string; text: string; type: 'insight' | 'warning' | 'action' | 'fact'; confidence: number; sourceCount: number }> = [];\n    session.perspectives?.forEach(p => {\n      p.key_insights?.forEach((insight, i) => { points.push({ id: `insight-${p.id}-${i}`, text: insight, type: 'insight', confidence: p.confidence || 0.7, sourceCount: p.sources_cited?.length || 0 }); });\n      p.warnings?.forEach((warning, i) => { points.push({ id: `warning-${p.id}-${i}`, text: warning, type: 'warning', confidence: 0.9, sourceCount: 1 }); });\n      p.recommendations?.forEach((rec, i) => { points.push({ id: `action-${p.id}-${i}`, text: rec, type: 'action', confidence: 0.8, sourceCount: 1 }); });\n    });\n    findings.slice(0, 5).forEach(f => { points.push({ id: f.id, text: f.content.slice(0, 150), type: 'fact', confidence: f.confidence_score || 0.5, sourceCount: f.supporting_sources?.length || 0 }); });\n\n    // Heatmap data from findings confidence\n    const heatmap = findings.slice(0, 25).map(f => ({ id: f.id, label: f.content.slice(0, 40) + '...', value: f.confidence_score || 0.5 }));\n\n    // Timeline events from dated findings\n    const timeline = findings.filter(f => f.event_date).map(f => ({\n      id: f.id,\n      date: new Date(f.event_date!),\n      label: f.content.slice(0, 50) + '...',\n      type: (f.temporal_context === 'prediction' ? 'prediction' : f.finding_type === 'event' ? 'event' : 'finding') as 'finding' | 'event' | 'prediction',\n      confidence: f.confidence_score,\n    })).slice(0, 15);\n\n    return {\n      keyPoints: points.slice(0, 12),\n      heatmapData: heatmap,\n      timelineEvents: timeline,\n    };\n  }, [session.id, session.perspectives, findings]);\n\n  return (\n    <>\n      <IntelDashboard\n        confidence={stats.avgConfidence}\n        findings={{ label: 'Findings', value: stats.findings, sublabel: `${stats.highConfidence} verified` }}\n        sources={{ label: 'Sources', value: stats.sources, sublabel: 'analyzed' }}\n        coverage={coverage}\n        reliability={reliability}\n        completeness={completeness}\n        alerts={stats.redFlags + allWarnings.length}\n      />\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n        <KeyPointsPanel points={keyPoints} />\n        {heatmapData.length > 0 && <ConfidenceHeatmap data={heatmapData} title=\"Finding Confidence Distribution\" />}\n      </div>\n\n      {timelineEvents.length > 0 && <Timeline events={timelineEvents} />}\n\n      {allWarnings.length > 0 && (\n        <motion.div initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.3 }}\n          className={`rounded-xl p-4 ${isRadar ? 'bg-rose-500/10 border border-rose-500/30' : 'bg-rose-50 border-l-4 border-rose-600'}`}>\n          <div className={`flex items-center gap-2 mb-3 ${isRadar ? 'text-rose-400' : 'text-rose-700'}`}>\n            <motion.span animate={{ scale: [1, 1.2, 1] }} transition={{ duration: 2, repeat: Infinity }}>⚠️</motion.span>\n            <span className=\"font-semibold\">Critical Warnings ({allWarnings.length})</span>\n          </div>\n          <ul className=\"space-y-2\">\n            {allWarnings.slice(0, 4).map((warning, i) => (\n              <motion.li key={i} initial={{ opacity: 0, x: -10 }} animate={{ opacity: 1, x: 0 }} transition={{ delay: 0.4 + i * 0.1 }}\n                className={`text-sm ${isRadar ? 'text-rose-300/80' : 'text-rose-800'}`}>• {warning}</motion.li>\n            ))}\n          </ul>\n        </motion.div>\n      )}\n\n      {stats.gaps > 0 && (\n        <ThemedSection title=\"Research Gaps\" count={stats.gaps} delay={0.5}>\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3\">\n            {session.gaps?.slice(0, 4).map((gap, i) => (\n              <motion.div key={gap.id} initial={{ opacity: 0, scale: 0.95 }} animate={{ opacity: 1, scale: 1 }} transition={{ delay: 0.6 + i * 0.1 }}\n                className={`p-3 rounded-lg ${isRadar ? 'bg-violet-500/10 border border-violet-500/20' : 'bg-violet-50 border-l-2 border-violet-600'}`}>\n                <div className=\"flex items-center gap-2 mb-1\">\n                  <ThemedBadge variant=\"warning\">{gap.gap_type}</ThemedBadge>\n                  <span className={`text-[10px] ${styles.textMuted}`}>{gap.priority}</span>\n                </div>\n                <p className={`text-sm ${isRadar ? 'text-violet-200/80' : 'text-stone-700'}`}>{gap.description}</p>\n              </motion.div>\n            ))}\n          </div>\n        </ThemedSection>\n      )}\n    </>\n  );\n}\n","numLines":181,"startLine":1,"totalLines":181}}}
