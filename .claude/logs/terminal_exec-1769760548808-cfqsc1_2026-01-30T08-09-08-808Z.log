[2026-01-30T08:10:13.794Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Dtcs2UdrAjmAYakr3i9rJr","type":"tool_result","content":"     1→'use client';\n     2→\n     3→import { useState } from 'react';\n     4→import { motion, AnimatePresence } from 'framer-motion';\n     5→import type { ResearchContradiction, ResearchGap, CausalChain } from '@/src/types/research';\n     6→import { useReportTheme, useThemeStyles } from '../core/ThemeContext';\n     7→import { ThemedBadge } from '../ThemedCards';\n     8→import { AnimatedNumber } from '../core/AnimatedNumber';\n     9→import { CausalFlow } from '../visualizations/CausalFlow';\n    10→import { ContradictionMatrix } from '../visualizations/ContradictionMatrix';\n    11→\n    12→interface AnalysisViewProps {\n    13→  contradictions: ResearchContradiction[];\n    14→  gaps: ResearchGap[];\n    15→  causalChains: CausalChain[];\n    16→}\n    17→\n    18→type AnalysisTab = 'contradictions' | 'gaps' | 'chains';\n    19→\n    20→export function AnalysisView({ contradictions, gaps, causalChains }: AnalysisViewProps) {\n    21→  const { theme } = useReportTheme();\n    22→  const styles = useThemeStyles();\n    23→  const isRadar = theme === 'radar';\n    24→  const [activeTab, setActiveTab] = useState<AnalysisTab>('contradictions');\n    25→\n    26→  const tabs: { key: AnalysisTab; label: string; count: number; icon: string }[] = [\n    27→    { key: 'contradictions', label: 'Contradictions', count: contradictions.length, icon: '⚡' },\n    28→    { key: 'gaps', label: 'Research Gaps', count: gaps.length, icon: '🔍' },\n    29→    { key: 'chains', label: 'Causal Chains', count: causalChains.length, icon: '🔗' },\n    30→  ];\n    31→\n    32→  const hasContent = contradictions.length > 0 || gaps.length > 0 || causalChains.length > 0;\n    33→\n    34→  if (!hasContent) {\n    35→    return <div className={`text-center py-12 ${styles.textMuted}`}>No analysis data available</div>;\n    36→  