' | 'other';\ntype ViewMode = 'constellation' | 'cards';\n\nconst entityConfig: Record<EntityType, { icon: string; gradient: string }> = {\n  person: { icon: '👤', gradient: 'from-rose-500 to-pink-600' },\n  organization: { icon: '🏢', gradient: 'from-blue-500 to-indigo-600' },\n  location: { icon: '📍', gradient: 'from-emerald-500 to-teal-600' },\n  event: { icon: '📅', gradient: 'from-amber-500 to-orange-600' },\n  other: { icon: '🔹', gradient: 'from-slate-500 to-gray-600' },\n};\n\nexport function EntitiesView({ entities }: EntitiesViewProps) {\n  const { theme } = useReportTheme();\n  const styles = useThemeStyles();\n  const isRadar = theme === 'radar';\n  const [viewMode, setViewMode] = useState<ViewMode>('constellation');\n  const [selectedEntity, setSelectedEntity] = useState<string | null>(null);\n  const [filterType, setFilterType] = useState<EntityType | 'all'>('all');\n\n  const grouped = useMemo(() => {\n    const groups: Record<EntityType, KnowledgeEntity[]> = {\n      person: [], organization: [], location: [], event: [], other: [],\n    };\n    entities.forEach(e => {\n      const type = (e.entity_type?.toLowerCase() || 'other') as EntityType;\n      (groups[type] || groups.other).push(e);\n    });\n    return groups;\n  }, [entities]);\n\n  const filtered = useMemo(() => {\n    if (filterType === 'all') return entities;\n    return grouped[filterType];\n  }, [entities, grouped, filterType]);\n\n  const selectedData = selectedEntity ? entities.find(e => e.id === selectedEntity) : null;\n\n  if (entities.length === 0) {\n    return <div className={`text-center py-12 ${styles.textMuted}`}>No entities extracted</div>;\n  }\n\n  return (\n    <div className=\"space-y-4\">\n      {/* Header controls */}\n      <div className=\"flex items-center justify-between flex-wrap gap-3\">\n        {/* Type filters */}\n        <div className=\"flex gap-2\">\n          <FilterChip label=\"All\" count={entities.length} active={filterType === 'all'} onClick={() => setFilterType('all')} />\n          {(['person', 'organization', 'location', 'event'] as EntityType[]).map(type => (\n            <FilterChip\n              key={type}\n              label={entityConfig[type].icon}\n              count={grouped[type].length}\n              active={filterType === type}\n              onClick={() => setFilterType(type)}\n            />\n          ))}\n        </div>\n\n        {/* View toggle */}\n        <div className={`flex rounded-lg overflow-hidden ${isRadar ? 'bg-slate-800' : 'bg-stone-200'}`}>\n          {(['constellation', 'cards'] as ViewMode[]).map(mode => (\n            <button\n              key={mode}\n              onClick={() => setViewMode(mode)}\n              className={`px-3 py-1.5 text-xs font-medium capitalize transition-colors ${\n                viewMode === mode\n                  ? isRadar ? 'bg-cyan-500/20 text-cyan-300' : 'bg-white text-stone-900'\n                  : isRadar ? 'text-slate-400 hover:text-white' : 'text-stone-600 hover:text-stone-900'\n              }`}\n            >\n              {mode}\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* Constellation view */}\n      {viewMode === 'constellation' && (\n        <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }}>\n          <EntityConstellation\n            entities={filtered}\n            selectedEntity={selectedEntity || undefined}\n            onEntitySelect={setSelectedEntity}\n          />\n        </motion.div>\n      )}\n\n      {/* Cards view */}\n      {viewMode === 'cards' && (\n        <div className=\"grid grid-cols-2 md:grid-cols-4 gap-3\">\n          {(['person', 'organization', 'location', 'event'] as EntityType[]).map(type => {\n            const list = filterType === 'all' ? grouped[type] : (filterType === type ? grouped[type] : []);\n            if (list.length === 0) return null;\n\n            return (\n              <EntityTypeColumn\n                key={type}\n                type={type}\n                entities={list}\n                selectedEntity={selectedEntity}\n                onSelect={setSelectedEntity}\n              />\n            );\n          })}\n        </div>\n      )}\n\n      {/* Selected entity detail */}\n      <AnimatePresence>\n        {selectedData && (\n          <EntityDetail entity={selectedData} onClose={() => setSelectedEntity(null)} />\n        )}\n      </AnimatePresence>\n    </div>\n  );\n}\n\nfunction FilterChip({ label, count, active, onClick }: { label: string; count: number; active: boolean; onClick: () => void }) {\n  const { theme } = useReportTheme();\n  const isRadar = theme === 'radar';\n\n  return (\n    <button\n      onClick={onClick}\n      className={`px-2 py-1 rounded-lg text-xs flex items-center gap-1 transition-all ${\n        active\n          ? isRadar ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/30' : 'bg-stone-800 text-white'\n          : isRadar ? 'bg-slate-800/50 text-slate-400 hover:text-white' : 'bg-stone-100 text-stone-600 hover:bg-stone-200'\n      }`}\n    >\n      {label}\n      <span className={`px-1 py-0.5 rounded text-[9px] ${active ? (isRadar ? 'bg-cyan-500/30' : 'bg-white/20') : 'bg-black/10'}`}>\n        {count}\n      </span>\n    </button>\n  );\n}\n\nfunction EntityTypeColumn({ type, entities, selectedEntity, onSelect }: {\n  type: EntityType;\n  entities: KnowledgeEntity[];\n  selectedEntity: string | null;\n  onSelect: (id: string | null) => void;\n}) {\n  const { theme } = useReportTheme();\n  const isRadar = theme === 'radar';\n  const config = entityConfig[type];\n\n  return (\n    <motion.div\n      initial={{ opacity: 0, y: 20 }}\n      animate={{ opacity: 1, y: 0 }}\n      className={`rounded-xl overflow-hidden ${isRadar ? 'bg-slate-900/60 border border-cyan-500/10' : 'bg-white border border-stone-200'}`}\n    >\n      <div className={`p-3 ${isRadar ? `bg-gradient-to-r ${config.gradient}` : 'bg-stone-50 border-b border-stone-200'}`}>\n        <h4 className={`text-xs font-semibold capitalize flex items-center gap-2 ${isRadar ? 'text-white' : 'text-stone-900'}`}>\n          {config.icon} {type}s (<AnimatedNumber value={entities.length} />)\n        </h4>\n      </div>\n      <div className=\"p-2 max-h-64 overflow-y-auto space-y-1\">\n        {entities.slice(0, 10).map((e, i) => (\n          <motion.button\n            key={e.id}\n            initial={{ opacity: 0 }}\n            animate={{ opacity: 1 }}\n            transition={{ delay: i * 0.03 }}\n            onClick={() => onSelect(selectedEntity === e.id ? null : e.id)}\n            className={`w-full text-left p-2 rounded-lg text-xs transition-all ${\n              selectedEntity === e.id\n                ? isRadar ? 'bg-cyan-500/20 text-cyan-300' : 'bg-stone-800 text-white'\n                : isRadar ? 'text-slate-300 hover:bg-slate-800/50' : 'text-stone-700 hover:bg-stone-50'\n            }`}\n          >\n            {e.canonical_name}\n          </motion.button>\n        ))}\n      </div>\n    </motion.div>\n  );\n}\n\nfunction EntityDetail({ entity, onClose }: { entity: KnowledgeEntity; onClose: () => void }) {\n  const { theme } = useReportTheme();\n  const styles = useThemeStyles();\n  const isRadar = theme === 'radar';\n  const type = (entity.entity_type?.toLowerCase() || 'other') as EntityType;\n  const config = entityConfig[type];\n\n  return (\n    <motion.div\n      initial={{ opacity: 0, y: 20 }}\n      animate={{ opacity: 1, y: 0 }}\n      exit={{ opacity: 0, y: 20 }}\n      className={`p-4 rounded-xl ${isRadar ? 'bg-slate-900/80 border border-cyan-500/20' : 'bg-white border border-stone-200 shadow-lg'}`}\n    >\n      <div className=\"flex items-start justify-between mb-3\">\n        <div className=\"flex items-center gap-3\">\n          <span className=\"text-2xl\">{config.icon}</span>\n          <div>\n            <h3 className={`font-semibold ${styles.text}`}>{entity.canonical_name}</h3>\n            <p className={`text-xs ${styles.textMuted}`}>{entity.mention_count || 0} mentions</p>\n          </div>\n        </div>\n        <button onClick={onClose} className={`p-1 rounded ${isRadar ? 'hover:bg-slate-800' : 'hover:bg-stone-100'}`}>\n          <svg className={`w-5 h-5 ${styles.textMuted}`} fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M6 18L18 6M6 6l12 12\" />\n          </svg>\n        </button>\n      </div>\n\n      {entity.description && <p className={`text-sm mb-3 ${styles.text}`}>{entity.description}</p>}\n\n      {entity.aliases && entity.aliases.length > 0 && (\n        <div className={`p-3 rounded-lg ${isRadar ? 'bg-slate-800/50' : 'bg-stone-50'}`}>\n          <div className={`text-[10px] uppercase tracking-wider mb-2 ${styles.textMuted}`}>Also known as</div>\n          <div className=\"flex flex-wrap gap-1\">\n            {entity.aliases.map((alias, i) => (\n              <span key={i} className={`px-2 py-1 rounded text-xs ${isRadar ? 'bg-slate-700 text-slate-300' : 'bg-stone-200 text-stone-700'}`}>\n                {alias}\n              </span>\n            ))}\n          </div>\n        </div>\n      )}\n    </motion.div>\n  );\n}\n","structuredPatch":[{"oldStart":166,"oldLines":12,"newStart":166,"newLines":12,"lines":["       animate={{ opacity: 1, y: 0 }}","       className={`rounded-xl overflow-hidden ${isRadar ? 'bg-slate-900/60 border border-cyan-500/10' : 'bg-white border border-stone-200'}`}","     >","-      <div className={`p-3 ${isRadar ? `bg-gradient-to-r ${config.gradient}` : 'bg-stone-50 border-b border-stone-200'}`}>","+      <div className={`sticky top-0 z-10 p-3 backdrop-blur-sm ${isRadar ? `bg-gradient-to-r ${config.gradient}/95` : 'bg-stone-50/95 border-b border-stone-200'}`}>","         <h4 className={`text-xs font-semibold capitalize flex items-center gap-2 ${isRadar ? 'text-white' : 'text-stone-900'}`}>","           {config.icon} {type}s (<AnimatedNumber value={entities.length} />)","         </h4>","       </div>","-      <div className=\"p-2 max-h-64 overflow-y-auto space-y-1\">","+      <div className=\"p-2 max-h-64 overflow-y-auto space-y-1 scroll-smooth\">","         {entities.slice(0, 10).map((e, i) => (","           <motion.button","             key={e.id}"]}],"userModified":false,"replaceAll":false}}
