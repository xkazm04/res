 36→    };\n    37→    entities.forEach(e => {\n    38→      const type = (e.entity_type?.toLowerCase() || 'other') as EntityType;\n    39→      (groups[type] || groups.other).push(e);\n    40→    });\n    41→    return groups;\n    42→  }, [entities]);\n    43→\n    44→  const filtered = useMemo(() => {\n    45→    if (filterType === 'all') return entities;\n    46→    return grouped[filterType];\n    47→  }, [entities, grouped, filterType]);\n    48→\n    49→  const selectedData = selectedEntity ? entities.find(e => e.id === selectedEntity) : null;\n    50→\n    51→  if (entities.length === 0) {\n    52→    return <div className={`text-center py-12 ${styles.textMuted}`}>No entities extracted</div>;\n    53→  }\n    54→\n    55→  return (\n    56→    <div className=\"space-y-4\">\n    57→      {/* Header controls */}\n    58→      <div className=\"flex items-center justify-between flex-wrap gap-3\">\n    59→        {/* Type filters */}\n    60→        <div className=\"flex gap-2\">\n    61→          <FilterChip label=\"All\" count={entities.length} active={filterType === 'all'} onClick={() => setFilterType('all')} />\n    62→          {(['person', 'organization', 'location', 'event'] as EntityType[]).map(type => (\n    63→            <FilterChip\n    64→              key={type}\n    65→              label={entityConfig[type].icon}\n    66→              count={grouped[type].length}\n    67→              active={filterType === type}\n    68→              onClick={() => setFilterType(type)}\n    69→            />\n    70→          ))}\n    71→        </div>\n    72→\n    73→        {/* View toggle */}\n    74→        <div className={`flex rounded-lg overflow-hidden ${isRadar ? 'bg-slate-800' : 'bg-stone-200'}`}>\n    75→          {(['constellation', 'cards'] as ViewMode[]).map(mode => (\n    76→            <button\n    77→              key={mode}\n    78→              onClick={() => setViewMode(mode)}\n    79→              className={`px-3 py-1.5 text-xs font-medium c