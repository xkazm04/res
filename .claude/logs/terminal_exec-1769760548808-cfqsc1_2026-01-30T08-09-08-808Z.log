    {config.icon} {type}s (<AnimatedNumber value={entities.length} />)\n   172→        </h4>\n   173→      </div>\n   174→      <div className=\"p-2 max-h-64 overflow-y-auto space-y-1\">\n   175→        {entities.slice(0, 10).map((e, i) => (\n   176→          <motion.button\n   177→            key={e.id}\n   178→            initial={{ opacity: 0 }}\n   179→            animate={{ opacity: 1 }}\n   180→            transition={{ delay: i * 0.03 }}\n   181→            onClick={() => onSelect(selectedEntity === e.id ? null : e.id)}\n   182→            className={`w-full text-left p-2 rounded-lg text-xs transition-all ${\n   183→              selectedEntity === e.id\n   184→                ? isRadar ? 'bg-cyan-500/20 text-cyan-300' : 'bg-stone-800 text-white'\n   185→                : isRadar ? 'text-slate-300 hover:bg-slate-800/50' : 'text-stone-700 hover:bg-stone-50'\n   186→            }`}\n   187→          >\n   188→            {e.canonical_name}\n   189→          </motion.button>\n   190→        ))}\n   191→      </div>\n   192→    </motion.div>\n   193→  );\n   194→}\n   195→\n   196→function EntityDetail({ entity, onClose }: { entity: KnowledgeEntity; onClose: () => void }) {\n   197→  const { theme } = useReportTheme();\n   198→  const styles = useThemeStyles();\n   199→  const isRadar = theme === 'radar';\n   200→  const type = (entity.entity_type?.toLowerCase() || 'other') as EntityType;\n   201→  const config = entityConfig[type];\n   202→\n   203→  return (\n   204→    <motion.div\n   205→      initial={{ opacity: 0, y: 20 }}\n   206→      animate={{ opacity: 1, y: 0 }}\n   207→      exit={{ opacity: 0, y: 20 }}\n   208→      className={`p-4 rounded-xl ${isRadar ? 'bg-slate-900/80 border border-cyan-500/20' : 'bg-white border border-stone-200 shadow-lg'}`}\n   209→    >\n   210→      <div className=\"flex items-start justify-between mb-3\">\n   211→        <div className=\"flex items-center gap-3\">\n   212→          <span className=\"text-2xl\">{config.icon}<