Name=\"space-y-3\">\n    75→            {gaps.map((g, i) => <GapCard key={g.id} gap={g} delay={i * 0.05} />)}\n    76→          </motion.div>\n    77→        )}\n    78→\n    79→        {activeTab === 'chains' && causalChains.length > 0 && (\n    80→          <motion.div key=\"chains\" initial={{ opacity: 0, y: 10 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0, y: -10 }}>\n    81→            <CausalFlow chains={causalChains} />\n    82→          </motion.div>\n    83→        )}\n    84→      </AnimatePresence>\n    85→    </div>\n    86→  );\n    87→}\n    88→\n    89→function GapCard({ gap, delay }: { gap: ResearchGap; delay: number }) {\n    90→  const { theme } = useReportTheme();\n    91→  const styles = useThemeStyles();\n    92→  const isRadar = theme === 'radar';\n    93→  const [showQueries, setShowQueries] = useState(false);\n    94→  const queries = gap.suggested_queries || [];\n    95→\n    96→  const priorityColors = {\n    97→    high: isRadar ? 'text-rose-400 bg-rose-500/20' : 'text-rose-700 bg-rose-100',\n    98→    medium: isRadar ? 'text-amber-400 bg-amber-500/20' : 'text-amber-700 bg-amber-100',\n    99→    low: isRadar ? 'text-emerald-400 bg-emerald-500/20' : 'text-emerald-700 bg-emerald-100',\n   100→  };\n   101→\n   102→  return (\n   103→    <motion.div\n   104→      initial={{ opacity: 0, x: -10 }}\n   105→      animate={{ opacity: 1, x: 0 }}\n   106→      transition={{ delay }}\n   107→      className={`rounded-xl overflow-hidden ${isRadar ? 'bg-slate-900/60 border border-violet-500/20' : 'bg-white border border-violet-200'}`}\n   108→    >\n   109→      <div className=\"p-4\">\n   110→        <div className=\"flex items-center justify-between mb-3\">\n   111→          <ThemedBadge variant=\"warning\">{gap.gap_type}</ThemedBadge>\n   112→          <span className={`text-[10px] px-2 py-1 rounded-full font-medium uppercase ${priorityColors[gap.priority as keyof typeof priorityColors] || priorityColors.medium}`}>\n   113→            {gap.