ilePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\ReportShell.tsx","content":"'use client';\n\nimport { motion, AnimatePresence } from 'framer-motion';\nimport { type ReactNode, useEffect } from 'react';\nimport { useReportTheme, useThemeStyles } from './core/ThemeContext';\n\ninterface ReportShellProps {\n  children: ReactNode;\n  onClose: () => void;\n}\n\nexport function ReportShell({ children, onClose }: ReportShellProps) {\n  const { theme } = useReportTheme();\n  const styles = useThemeStyles();\n\n  // Escape key to close\n  useEffect(() => {\n    const handleEscape = (e: KeyboardEvent) => {\n      if (e.key === 'Escape') onClose();\n    };\n    window.addEventListener('keydown', handleEscape);\n    return () => window.removeEventListener('keydown', handleEscape);\n  }, [onClose]);\n\n  return (\n    <AnimatePresence>\n      <motion.div\n        initial={{ opacity: 0 }}\n        animate={{ opacity: 1 }}\n        exit={{ opacity: 0 }}\n        className=\"fixed inset-0 z-50 flex\"\n      >\n        {/* Backdrop */}\n        <motion.div\n          initial={{ opacity: 0 }}\n          animate={{ opacity: 1 }}\n          className={`absolute inset-0 ${theme === 'radar' ? 'bg-black/90' : 'bg-stone-900/60'}`}\n          onClick={onClose}\n        />\n\n        {/* Content */}\n        <motion.div\n          initial={{ opacity: 0, scale: 0.95, y: 20 }}\n          animate={{ opacity: 1, scale: 1, y: 0 }}\n          transition={{ type: 'spring', damping: 25, stiffness: 300 }}\n          className={`relative z-10 flex flex-1 m-4 rounded-2xl overflow-hidden ${styles.bgCard} ${styles.border} border`}\n        >\n          {theme === 'radar' && <RadarAmbience />}\n          {children}\n        </motion.div>\n      </motion.div>\n    </AnimatePresence>\n  );\n}\n\n// Ambient effects for Radar theme\nfunction RadarAmbience() {\n  return (\n    <>\n      {/* Gradient overlay */}\n      <div className=\"absolute inset-0 bg-gradient-to-br from-cyan-500/5 via-transparent to-blue-500/5 pointer-events-none\" />\n\n      {/* Scan line effect */}\n      <motion.div\n        className=\"absolute inset-0 pointer-events-none overflow-hidden\"\n        initial={{ opacity: 0.3 }}\n      >\n        <motion.div\n          className=\"absolute left-0 right-0 h-px bg-gradient-to-r from-transparent via-cyan-400/50 to-transparent\"\n          animate={{ top: ['0%', '100%'] }}\n          transition={{ duration: 8, repeat: Infinity, ease: 'linear' }}\n        />\n      </motion.div>\n\n      {/* Corner accents */}\n      <div className=\"absolute top-0 left-0 w-20 h-20 border-l-2 border-t-2 border-cyan-500/30 rounded-tl-2xl pointer-events-none\" />\n      <div className=\"absolute bottom-0 right-0 w-20 h-20 border-r-2 border-b-2 border-cyan-500/30 rounded-br-2xl pointer-events-none\" />\n    </>\n  );\n}\n","numLines":81,"startLine":1,"totalLines":81}}}
