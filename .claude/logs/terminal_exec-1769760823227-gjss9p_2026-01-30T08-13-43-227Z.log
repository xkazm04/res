→          <mark\n    91→            key={i}\n    92→            className={`px-0.5 rounded ${isRadar ? 'bg-cyan-500/30 text-cyan-200' : 'bg-amber-200 text-amber-900'}`}\n    93→          >\n    94→            {part}\n    95→          </mark>\n    96→        );\n    97→      }\n    98→      return part;\n    99→    });\n   100→  }, [highlightKeywords, isRadar]);\n   101→\n   102→  return (\n   103→    <p className={className}>\n   104→      {sentences.map((sentence, i) => (\n   105→        <motion.span\n   106→          key={i}\n   107→          className=\"inline cursor-pointer transition-opacity\"\n   108→          animate={{\n   109→            opacity: hoveredSentence === null || hoveredSentence === i ? 1 : 0.3,\n   110→          }}\n   111→          onMouseEnter={() => setHoveredSentence(i)}\n   112→          onMouseLeave={() => setHoveredSentence(null)}\n   113→        >\n   114→          {highlightText(sentence)}{' '}\n   115→        </motion.span>\n   116→      ))}\n   117→    </p>\n   118→  );\n   119→}\n   120→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"a8a4f9ca-6a40-4b19-853c-2be96846861c","uuid":"8f2c65f7-e91d-4275-b2a9-4efd12f214fa","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\features\\FocusMode.tsx","content":"'use client';\n\nimport { useState, useCallback, type ReactNode } from 'react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport { useReportTheme } from '../core/ThemeContext';\n\ninterface FocusModeProps {\n  children: ReactNode;\n  enabled: boolean;\n  onClose: () => void;\n}\n\nexport function FocusMode({ children, enabled, onClose }: FocusModeProps) {\n  const { theme } = useReportTheme();\n  const isRadar = theme === 'radar';\n\n  return (\n    <AnimatePresence>\n      {enabled && (\n        <motion.div\n          initial={{ opacity: 0 }}\n          animate={{ opacity: 1 }}\n          exit={{ opacity: 0 }}\n          className=\"fixed inset-0 z-50 flex items-center justify-center\"\n          onClick={onClose}\n        >\n          {/* Spotlight background */}\n          <div className={`absolute inset-0 ${isRadar ? 'bg-slate-950/98' : 'bg-stone-950/95'}`} />\n\n          {/* Radial gradient spotlight */}\n          <div\n            className=\"absolute inset-0 pointer-events-none\"\n            style={{\n              background: isRadar\n                ? 'radial-gradient(ellipse 60% 50% at center, transparent 0%, rgba(0,0,0,0.8) 100%)'\n                : 'radial-gradient(ellipse 60% 50% at center, transparent 0%, rgba(0,0,0,0.9) 100%)',\n            }}\n          />\n\n          {/* Content */}\n          <motion.div\n            initial={{ scale: 0.9, opacity: 0 }}\n            animate={{ scale: 1, opacity: 1 }}\n            exit={{ scale: 0.9, opacity: 0 }}\n            className={`relative z-10 max-w-3xl max-h-[80vh] overflow-y-auto p-8 rounded-2xl ${isRadar ? 'bg-slate-900/90 border border-cyan-500/30' : 'bg-white shadow-2xl'}`}\n            onClick={(e) => e.stopPropagation()}\n          >\n            {/* Close hint */}\n            <div className={`absolute top-4 right-4 text-xs ${isRadar ? 'text-cyan-400/60' : 'text-stone-400'}`}>\n              Press ESC to exit\n            </div>\n\n            {children}\n          </motion.div>\n\n          {/* Ambient glow for radar theme */}\n          {isRadar && (\n            <div className=\"absolute inset-0 pointer-events-none\">\n              <div className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-cyan-500/5 blur-3xl rounded-full\" />\n            </div>\n          )}\n        </motion.div>\n      )}\n    </AnimatePresence>\n  );\n}\n\ninterface SpotlightTextProps {\n  text: string;\n  className?: string;\n  highlightKeywords?: string[];\n}\n\nexport function SpotlightText({ text, className = '', highlightKeywords = [] }: SpotlightTextProps) {\n  const { theme } = useReportTheme();\n  const isRadar = theme === 'radar';\n  const [hoveredSentence, setHoveredSentence] = useState<number | null>(null);\n\n  const sentences = text.split(/(?<=[.!?])\\s+/);\n\n  const highlightText = useCallback((sentence: string) => {\n    if (highlightKeywords.length === 0) return sentence;\n\n    const regex = new RegExp(`(${highlightKeywords.join('|')})`, 'gi');\n    const parts = sentence.split(regex);\n\n    return parts.map((part, i) => {\n      if (highlightKeywords.some(kw => kw.toLowerCase() === part.toLowerCase())) {\n        return (\n          <mark\n            key={i}\n            className={`px-0.5 rounded ${isRadar ? 'bg-cyan-500/30 text-cyan-200' : 'bg-amber-200 text-amber-900'}`}\n          >\n            {part}\n          </mark>\n        );\n      }\n      return part;\n    });\n  }, [highlightKeywords, isRadar]);\n\n  return (\n    <p className={className}>\n      {sentences.map((sentence, i) => (\n        <motion.span\n          key={i}\n          className=\"inline cursor-pointer transition-opacity\"\n          animate={{\n            opacity: hoveredSentence === null || hoveredSentence === i ? 1 : 0.3,\n          }}\n          onMouseEnter={() => setHoveredSentence(i)}\n          onMouseLeave={() => setHoveredSentence(null)}\n        >\n          {highlightText(sentence)}{' '}\n        </motion.span>\n      ))}\n    </p>\n  );\n}\n","numLines":120,"startLine":1,"totalLines":120}}}
