iv>\n    86→          <p className=\"text-sm text-slate-700\">{contradiction.claim_2}</p>\n    87→          {contradiction.source_2 && (\n    88→            <p className=\"text-[10px] text-slate-500 mt-1\">Source: {contradiction.source_2}</p>\n    89→          )}\n    90→        </div>\n    91→      </div>\n    92→\n    93→      {/* Resolution hint */}\n    94→      {contradiction.resolution_hint && (\n    95→        <div className=\"text-xs text-slate-600 bg-white p-2 rounded border border-slate-100\">\n    96→          <span className=\"font-medium\">Resolution hint:</span> {contradiction.resolution_hint}\n    97→        </div>\n    98→      )}\n    99→    </div>\n   100→  );\n   101→}\n   102→\n   103→function GapCard({ gap }: { gap: ResearchGap }) {\n   104→  const suggestedQueries = gap.suggested_queries || [];\n   105→\n   106→  return (\n   107→    <div className=\"p-4 bg-violet-50 border border-violet-200 rounded-lg\">\n   108→      <div className=\"flex items-center justify-between mb-2\">\n   109→        <div className=\"flex items-center gap-2\">\n   110→          <span className=\"w-4 h-4 text-violet-600\"><TargetIcon /></span>\n   111→          <span className=\"text-xs font-semibold text-violet-700 uppercase\">{gap.gap_type} Gap</span>\n   112→        </div>\n   113→        <PriorityBadge priority={gap.priority} />\n   114→      </div>\n   115→\n   116→      <p className=\"text-sm text-slate-700 mb-3\">{gap.description}</p>\n   117→\n   118→      {suggestedQueries.length > 0 && (\n   119→        <div className=\"bg-white p-2 rounded border border-violet-100\">\n   120→          <div className=\"text-[10px] text-violet-600 font-medium mb-1\">Suggested Queries</div>\n   121→          <ul className=\"space-y-1\">\n   122→            {suggestedQueries.slice(0, 3).map((query, i) => (\n   123→              <li key={i} className=\"text-xs text-slate-600 flex items-center gap-1\">\n   124→                <span className=\"w-3 h-3 text-violet-400\"><ArrowRightI