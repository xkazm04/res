[2026-01-30T08:19:25.671Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HQVwmh1su6xDysLs9wXgsg","type":"tool_result","content":"     1→'use client';\n     2→\n     3→import { motion } from 'framer-motion';\n     4→import { useReportTheme, useThemeStyles } from '../core/ThemeContext';\n     5→import { AnimatedNumber, AnimatedProgressRing } from '../core/AnimatedNumber';\n     6→\n     7→interface MetricData {\n     8→  label: string;\n     9→  value: number;\n    10→  max?: number;\n    11→  trend?: 'up' | 'down' | 'stable';\n    12→  sublabel?: string;\n    13→}\n    14→\n    15→interface IntelDashboardProps {\n    16→  confidence: number;\n    17→  findings: MetricData;\n    18→  sources: MetricData;\n    19→  coverage: number;\n    20→  reliability: number;\n    21→  completeness: number;\n    22→  alerts: number;\n    23→}\n    24→\n    25→export function IntelDashboard({\n    26→  confidence,\n    27→  findings,\n    28→  sources,\n    29→  coverage,\n    30→  reliability,\n    31→  completeness,\n    32→  alerts,\n    33→}: IntelDashboardProps) {\n    34→  const { theme } = useReportTheme();\n    35→  const styles = useThemeStyles();\n    36→  const isRadar = theme === 'radar';\n    37→\n    38→  return (\n    39→    <div className={`grid grid-cols-12 gap-3 p-4 rounded-2xl ${isRadar ? 'bg-slate-900/80' : 'bg-white border border-stone-200'}`}>\n    40→      {/* Main confidence gauge - spans 4 columns */}\n    41→      <motion.div\n    42→        initial={{ opacity: 0, scale: 0.9 }}\n    43→        animate={{ opacity: 1, scale: 1 }}\n    44→        className={`col-span-4 row-span-2 flex flex-col items-center justify-center p-4 rounded-xl ${isRadar ? 'bg-slate-950/50 border border-cyan-500/20' : 'bg-stone-50'}`}\n    45→      >\n    46→        <div className=\"relative\">\n    47→          <AnimatedProgressRing\n    48→            value={confidence}\n    49→            size={120}\n    50→            strokeWidth={8}\n    51→            color={isRadar ? '#22d3ee' : '#0ea5e9'}\n    52→            bgColor={isRadar ? 'rgba(34,211,238,0.1)' : 'rgba(0,0,0,0.05)'}\n    53→            showValue={false}\n    54→          />\n    55→          <div className=\"absolute inset-0 flex flex-col items-center justify-center\">\n    56→            <span className={`text-3xl font-bold ${isRadar ? 'text-cyan-400' : 'text-stone-900'}`}>\n    57→              <AnimatedNumber value={confidence} />\n    58→            </span>\n    59→            <span className={`text-[10px] uppercase tracking-wider ${styles.textMuted}`}>Confidence</span>\n    60→          </div>\n    61→        </div>\n    62→        <StatusIndicator value={confidence} />\n    63→      </motion.div>\n    64→\n    65→      {/* Findings metric */}\n    66→      <MetricCard metric={findings} delay={0.1} color=\"blue\" />\n    67→\n    68→      {/* Sources metric */}\n    69→      <MetricCard metric={sources} delay={0.15} color=\"purple\" />\n    70→\n    71→      {/* Coverage gauge */}\n    72→      <GaugeCard label=\"Coverage\" value={coverage} delay={0.2} color=\"emerald\" />\n    73→\n    74→      {/* Reliability gauge */}\n    75→      <GaugeCard label=\"Reliability\" value={reliability} delay={0.25} color=\"amber\" />\n    76→\n    77→      {/* Completeness gauge */}\n    78→      <GaugeCard label=\"Completeness\" value={completeness} delay={0.3} color=\"cyan\" />\n    79→\n    80→      {/* Alerts */}\n    81→      <motion.div\n    82→        initial={{ opacity: 0, y: 10 }}\n    83→        animate={{ opacity: 1, y: 0 }}\n    84→        transition={{ delay: 0.35 }}\n    85→        className={`col-span-4 p-3 rounded-xl ${\n    86→          alerts > 0\n    87→            ? isRadar ? 'bg-rose-500/10 border border-rose-500/30' : 'bg-rose-50 border border-rose-200'\n    88→            : isRadar ? 'bg-slate-800/50' : 'bg-stone-50'\n    89→        }`}\n    90→      >\n    91→        <div className={`text-[10px] uppercase tracking-wider mb-1 ${alerts > 0 ? (isRadar ? 'text-rose-400' : 'text-rose-600') : styles.textMuted}`}>\n    92→          Alerts\n    93→        </div>\n    94→        <div className={`text-2xl font-bold ${alerts > 0 ? (isRadar ? 'text-rose-400' : 'text-rose-600') : styles.text}`}>\n    95→          <AnimatedNumber value={alerts} />\n    96→        </div>\n    97→        {alerts > 0 && (\n    98→          <motion.div\n    99→            animate={{ opacity: [0.5, 1, 0.5] }}\n   100→            transition={{ duration: 2, repeat: Infinity }}\n   101→            className={`text-[10px] ${isRadar ? 'text-rose-400/60' : 'text-rose-500'}`}\n   102→          >\n   103→            Requires attention\n   104→          </motion.div>\n   105→        )}\n   106→      </motion.div>\n   107→    </div>\n   108→  );\n   109→}\n   110→\n   111→function MetricCard({ metric, delay, color }: { metric: MetricData; delay: number; color: string }) {\n   112→  const { theme } = useReportTheme();\n   113→  const styles = useThemeStyles();\n   114→  const isRadar = theme === 'radar';\n   115→\n   116→  const trendIcon = {\n   117→    up: '↑',\n   118→    down: '↓',\n   119→    stable: '→',\n   120→  };\n   121→\n   122→  return (\n   123→    <motion.div\n   124→      initial={{ opacity: 0, y: 10 }}\n   125→      animate={{ opacity: 1, y: 0 }}\n   126→      transition={{ delay }}\n   127→      className={`col-span-4 p-3 rounded-xl ${isRadar ? 'bg-slate-800/50' : 'bg-stone-50'}`}\n   128→    >\n   129→      <div className={`text-[10px] uppercase tracking-wider mb-1 ${styles.textMuted}`}>{metric.label}</div>\n   130→      <div className=\"flex items-end gap-2\">\n   131→        <span className={`text-2xl font-bold ${styles.text}`}>\n   132→          <AnimatedNumber value={metric.value} />\n   133→        </span>\n   134→        {metric.max && (\n   135→          <span className={`text-sm ${styles.textMuted}`}>/ {metric.max}</span>\n   136→        )}\n   137→        {metric.trend && (\n   138→          <span className={`tex