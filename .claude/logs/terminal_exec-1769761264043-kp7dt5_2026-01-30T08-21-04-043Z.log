nction SectionHeader({ title, count, size = 'default' }: SectionHeaderProps) {\n  const styles = useThemeStyles();\n\n  const sizeClasses = {\n    default: 'text-base font-semibold mb-3',\n    small: 'text-sm font-medium mb-2',\n  };\n\n  return (\n    <h3 className={`${sizeClasses[size]} ${styles.text}`}>\n      {title}\n      {count !== undefined && (\n        <span className={`ml-2 text-xs font-normal ${styles.textMuted}`}>\n          ({count})\n        </span>\n      )}\n    </h3>\n  );\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":233,"cache_read_input_tokens":149009,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":233},"output_tokens":25,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"a8a4f9ca-6a40-4b19-853c-2be96846861c","uuid":"b6316606-f506-46b2-8f92-a5a984404e07"}
