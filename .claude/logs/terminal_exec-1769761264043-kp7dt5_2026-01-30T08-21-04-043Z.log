          </AnimatePresence>\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"a8a4f9ca-6a40-4b19-853c-2be96846861c","uuid":"eb65ae17-2a95-467b-b87e-df60f8139ad9","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\views\\SourcesView.tsx","content":"'use client';\n\nimport { useMemo, useState } from 'react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport type { ResearchSource } from '@/src/types/research';\nimport { useReportTheme, useThemeStyles } from '../core/ThemeContext';\nimport { ThemedBadge } from '../ThemedCards';\nimport { AnimatedNumber, AnimatedProgressRing } from '../core/AnimatedNumber';\nimport { SourceNetwork } from '../visualizations/SourceNetwork';\nimport { TrustRadar } from '../visualizations/TrustRadar';\n\ninterface SourcesViewProps {\n  sources: ResearchSource[];\n  searchQuery: string;\n  filterConfidence: string;\n}\n\ntype ViewMode = 'cards' | 'network' | 'radar';\n\nexport function SourcesView({ sources, searchQuery, filterConfidence }: SourcesViewProps) {\n  const { theme } = useReportTheme();\n  const styles = useThemeStyles();\n  const isRadar = theme === 'radar';\n  const [viewMode, setViewMode] = useState<ViewMode>('cards');\n  const [selectedSource, setSelectedSource] = useState<string | null>(null);\n\n  const filtered = useMemo(() => {\n    return sources.filter((s) => {\n      if (searchQuery) {\n        const q = searchQuery.toLowerCase();\n        if (!s.title?.toLowerCase().includes(q) && !s.domain?.toLowerCase().includes(q)) return false;\n      }\n      const cred = s.credibility_score || 0;\n      if (filterConfidence === 'high' && cred < 0.8) return false;\n      if (filterConfidence === 'medium' && (cred < 0.5 || cred >= 0.8)) return false;\n      if (filterConfidence === 'low' && cred >= 0.5) return false;\n      return true;\n    });\n  }, [sources, searchQuery, filterConfidence]);\n\n  const stats = useMemo(() => {\n    const high = filtered.filter(s => (s.credibility_score || 0) >= 0.8).length;\n    const med = filtered.filter(s => { const c = s.credibility_score || 0; return c >= 0.5 && c < 0.8; }).length;\n    return { high, med, low: filtered.length - high - med };\n  }, [filtered]);\n\n  if (filtered.length === 0) {\n    return <div className={`text-center py-12 ${styles.textMuted}`}>No sources match your filters</div>;\n  }\n\n  return (\n    <div className=\"space-y-4\">\n      {/* Header with view toggle */}\n      <div className=\"flex items-center justify-between\">\n        <CredibilityBar stats={stats} total={filtered.length} />\n        <ViewToggle mode={viewMode} onChange={setViewMode} />\n      </div>\n\n      {/* Network View */}\n      {viewMode === 'network' && (\n        <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }}>\n          <SourceNetwork sources={filtered} selectedSource={selectedSource || undefined} onSourceSelect={setSelectedSource} />\n        </motion.div>\n      )}\n\n      {/* Radar View */}\n      {viewMode === 'radar' && (\n        <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }}>\n          <TrustRadar sources={filtered} />\n        </motion.div>\n      )}\n\n      {/* Cards View */}\n      {viewMode === 'cards' && (\n        <motion.div layout className=\"grid grid-cols-1 md:grid-cols-2 gap-3\">\n          <AnimatePresence>\n            {filtered.map((source, i) => (\n              <SourceCard key={source.id} source={source} delay={i * 0.03} isSelected={selectedSource === source.id} onSelect={setSelectedSource} />\n            ))}\n          </AnimatePresence>","numLines":80,"startLine":1,"totalLines":179}}}
