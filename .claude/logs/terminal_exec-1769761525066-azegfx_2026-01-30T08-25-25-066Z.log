_score || 0), 0) / findings.length * 100)\n    40→      : 0;\n    41→    return {\n    42→      findings: findings.length,\n    43→      sources: sources.length,\n    44→      perspectives: session.perspectives?.length || 0,\n    45→      contradictions: session.contradictions?.length || 0,\n    46→      gaps: session.gaps?.length || 0,\n    47→      avgConfidence,\n    48→      highConfidence: findings.filter(f => (f.confidence_score || 0) >= 0.8).length,\n    49→      redFlags: findings.filter(f => f.finding_type === 'gap' || f.content.toLowerCase().includes('risk')).length,\n    50→      entities: session.entities?.length || 0,\n    51→    };\n    52→  }, [session]);\n    53→\n    54→  const findingTypes = useMemo(() =>\n    55→    Array.from(new Set(session.findings?.map(f => f.finding_type) || [])),\n    56→    [session.findings]\n    57→  );\n    58→\n    59→  return (\n    60→    <ReportShell onClose={onClose} titleId={titleId}>\n    61→      <ThemedSidebar activeTab={activeTab} onTabChange={setActiveTab} stats={stats} onClose={onClose} />\n    62→\n    63→      <main className={`flex-1 flex flex-col overflow-hidden ${styles.bg}`}>\n    64→        {/* Header */}\n    65→        <header className={`px-6 py-4 border-b ${styles.border}`}>\n    66→          <motion.h1 id={titleId} initial={{ opacity: 0, y: -10 }} animate={{ opacity: 1, y: 0 }} className={`text-lg font-bold ${styles.text}`}>\n    67→            {session.title}\n    68→          </motion.h1>\n    69→        </header>\n    70→\n    71→        {/* Toolbar */}\n    72→        {activeTab !== 'overview' && (\n    73→          <Toolbar\n    74→            searchQuery={searchQuery}\n    75→            onSearchChange={setSearchQuery}\n    76→            filterType={filterType}\n    77→            onFilterTypeChange={setFilterType}\n    78→            filterConfidence={filterConfidence}\n    79→            onFilterConfidenceChange={setFilterConfidence}\n    80→            findingTypes={findingTypes}\n    81→            showTypeFilter={activeTab === 'findings'}\n    82→            showConfidenceFilter={activeTab === 'findings' || activeTab === 'sources'}\n    83→          />\n    84→        )}\n    85→\n    86→        {/* Content */}\n    87→        <div className=\"flex-1 overflow-y-auto p-6\">\n    88→          <div className=\"max-w-5xl mx-auto\">\n    89→            {activeTab === 'overview' && <OverviewView session={session} stats={stats} />}\n    90→            {activeTab === 'findings' && <FindingsView findings={session.findings || []} sources={session.sources || []} searchQuery={searchQuery} filterType={filterType} filterConfidence={filterConfidence} />}\n    91→            {activeTab === 'sources' && <SourcesView sources={session.sources || []} searchQuery={searchQuery} filterConfidence={filterConfidence} />}\n    92→            {activeTab === 'perspectives' && <PerspectivesView perspectives={session.perspectives || []} />}\n    93→            {activeTab === 'analysis' && <AnalysisView contradictions={session.contradictions || []} gaps={session.gaps || []} causalChains={session.causal_chains || []} />}\n    94→            {activeTab === 'entities' && <EntitiesView entities={session.entities || []} />}\n    95→          </div>\n    96→        </div>\n    97→      </main>\n    98→    </ReportShell>\n    99→  );\n   100→}\n   101→\n   102→function Toolbar({ searchQuery, onSearchChange, filterType, onFilterTypeChange, filterConfidence, onFilterConfidenceChange, findingTypes, showTypeFilter, showConfidenceFilter }: {\n   103→  searchQuery: string;\n   104→  onSearchChange: (v: string) => void;\n   105→  filterType: string;\n   106→  onFilterTypeChange: (v: string) => void;\n   107→  filterConfidence: string;\n   108→  onFilterConfidenceChange: (v: string) => void;\n   109→  findingTypes: string[];\n   110→  showTypeFilter: boolean;\n   111→  showConfidenceFilter: boolean;\n   112→}) {\n   113→  const styles = useThemeStyles();\n   114→  return (\n   115→    <div className={`px-6 py-3 border-b ${styles.border} flex flex-wrap gap-3`}>\n   116→      <input\n   117→        type=\"text\"\n   118→        placeholder=\"Search...\"\n   119→        value={searchQuery}\n   120→        onChange={(e) => onSearchChange(e.target.value)}\n   121→        className={`flex-1 min-w-[200px] px-3 py-1.5 text-sm rounded-lg ${styles.bgSecondary} ${styles.border} border ${styles.text} focus:outline-none`}\n   122→      />\n   123→      {showTypeFilter && (\n   124→        <select value={filterType} onChange={(e) => onFilterTypeChange(e.target.value)} className={`px-3 py-1.5 text-sm rounded-lg ${styles.bgSecondary} ${styles.border} border ${styles.text}`}>\n   125→          <option value=\"all\">All Types</option>\n   126→          {findingTypes.map(t => <option key={t} value={t}>{t}</option>)}\n   127→        </select>\n   128→      )}\n   129→      {showConfidenceFilter && (\n   130→        <select value={filterConfidence} onChange={(e) => onFilterConfidenceChange(e.target.value)} className={`px-3 py-1.5 text-sm rounded-lg ${styles.bgSecondary} ${styles.border} border ${styles.text}`}>\n   131→          <option value=\"all\">All Confidence</option>\n   132→          <option value=\"high\">High (80%+)</option>\n   133→          <option value=\"medium\">Medium (50-79%)</option>\n   134→          <option value=\"low\">Low (&lt;50%)</option>\n   135→        </select>\n   136→      )}\n   137→    </div>\n   138→  );\n   139→}\n   140→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"a8a4f9ca-6a40-4b19-853c-2be96846861c","uuid":"c8d5d46f-034a-4d86-a214-f4b6bcdcc5ba","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\ReportView.tsx","content":"'use client';\n\nimport { useState, useMemo, useId } from 'react';\nimport { motion } from 'framer-motion';\nimport type { SessionWithDetails } from '@/src/types/research';\nimport { ReportThemeProvider, useThemeStyles, type ReportTheme } from './core/ThemeContext';\nimport { ReportShell } from './ReportShell';\nimport { ThemedSidebar } from './ThemedSidebar';\nimport { OverviewView, FindingsView, SourcesView, PerspectivesView, AnalysisView, EntitiesView } from './views';\n\ntype TabId = 'overview' | 'findings' | 'sources' | 'perspectives' | 'analysis' | 'entities';\n\ninterface ReportViewProps {\n  session: SessionWithDetails;\n  onClose: () => void;\n  theme?: ReportTheme;\n}\n\nexport function ReportView({ session, onClose, theme = 'radar' }: ReportViewProps) {\n  return (\n    <ReportThemeProvider theme={theme}>\n      <ReportViewInner session={session} onClose={onClose} />\n    </ReportThemeProvider>\n  );\n}\n\nfunction ReportViewInner({ session, onClose }: Omit<ReportViewProps, 'theme'>) {\n  const styles = useThemeStyles();\n  const [activeTab, setActiveTab] = useState<TabId>('overview');\n  const [searchQuery, setSearchQuery] = useState('');\n  const [filterType, setFilterType] = useState('all');\n  const [filterConfidence, setFilterConfidence] = useState('all');\n  const titleId = useId();\n\n  const stats = useMemo(() => {\n    const findings = session.findings || [];\n    const sources = session.sources || [];\n    const avgConfidence = findings.length > 0\n      ? Math.round(findings.reduce((sum, f) => sum + (f.confidence_score || 0), 0) / findings.length * 100)\n      : 0;\n    return {\n      findings: findings.length,\n      sources: sources.length,\n      perspectives: session.perspectives?.length || 0,\n      contradictions: session.contradictions?.length || 0,\n      gaps: session.gaps?.length || 0,\n      avgConfidence,\n      highConfidence: findings.filter(f => (f.confidence_score || 0) >= 0.8).length,\n      redFlags: findings.filter(f => f.finding_type === 'gap' || f.content.toLowerCase().includes('risk')).length,\n      entities: session.entities?.length || 0,\n    };\n  }, [session]);\n\n  const findingTypes = useMemo(() =>\n    Array.from(new Set(session.findings?.map(f => f.finding_type) || [])),\n    [session.findings]\n  );\n\n  return (\n    <ReportShell onClose={onClose} titleId={titleId}>\n      <ThemedSidebar activeTab={activeTab} onTabChange={setActiveTab} stats={stats} onClose={onClose} />\n\n      <main className={`flex-1 flex flex-col overflow-hidden ${styles.bg}`}>\n        {/* Header */}\n        <header className={`px-6 py-4 border-b ${styles.border}`}>\n          <motion.h1 id={titleId} initial={{ opacity: 0, y: -10 }} animate={{ opacity: 1, y: 0 }} className={`text-lg font-bold ${styles.text}`}>\n            {session.title}\n          </motion.h1>\n        </header>\n\n        {/* Toolbar */}\n        {activeTab !== 'overview' && (\n          <Toolbar\n            searchQuery={searchQuery}\n            onSearchChange={setSearchQuery}\n            filterType={filterType}\n            onFilterTypeChange={setFilterType}\n            filterConfidence={filterConfidence}\n            onFilterConfidenceChange={setFilterConfidence}\n            findingTypes={findingTypes}\n            showTypeFilter={activeTab === 'findings'}\n            showConfidenceFilter={activeTab === 'findings' || activeTab === 'sources'}\n          />\n        )}\n\n        {/* Content */}\n        <div className=\"flex-1 overflow-y-auto p-6\">\n          <div className=\"max-w-5xl mx-auto\">\n            {activeTab === 'overview' && <OverviewView session={session} stats={stats} />}\n            {activeTab === 'findings' && <FindingsView findings={session.findings || []} sources={session.sources || []} searchQuery={searchQuery} filterType={filterType} filterConfidence={filterConfidence} />}\n            {activeTab === 'sources' && <SourcesView sources={session.sources || []} searchQuery={searchQuery} filterConfidence={filterConfidence} />}\n            {activeTab === 'perspectives' && <PerspectivesView perspectives={session.perspectives || []} />}\n            {activeTab === 'analysis' && <AnalysisView contradictions={session.contradictions || []} gaps={session.gaps || []} causalChains={session.causal_chains || []} />}\n            {activeTab === 'entities' && <EntitiesView entities={session.entities || []} />}\n          </div>\n        </div>\n      </main>\n    </ReportShell>\n  );\n}\n\nfunction Toolbar({ searchQuery, onSearchChange, filterType, onFilterTypeChange, filterConfidence, onFilterConfidenceChange, findingTypes, showTypeFilter, showConfidenceFilter }: {\n  searchQuery: string;\n  onSearchChange: (v: string) => void;\n  filterType: string;\n  onFilterTypeChange: (v: string) => void;\n  filterConfidence: string;\n  onFilterConfidenceChange: (v: string) => void;\n  findingTypes: string[];\n  showTypeFilter: boolean;\n  showConfidenceFilter: boolean;\n}) {\n  const styles = useThemeStyles();\n  return (\n    <div className={`px-6 py-3 border-b ${styles.border} flex flex-wrap gap-3`}>\n      <input\n        type=\"text\"\n        placeholder=\"Search...\"\n        value={searchQuery}\n        onChange={(e) => onSearchChange(e.target.value)}\n        className={`flex-1 min-w-[200px] px-3 py-1.5 text-sm rounded-lg ${styles.bgSecondary} ${styles.border} border ${styles.text} focus:outline-none`}\n      />\n      {showTypeFilter && (\n        <select value={filterType} onChange={(e) => onFilterTypeChange(e.target.value)} className={`px-3 py-1.5 text-sm rounded-lg ${styles.bgSecondary} ${styles.border} border ${styles.text}`}>\n          <option value=\"all\">All Types</option>\n          {findingTypes.map(t => <option key={t} value={t}>{t}</option>)}\n        </select>\n      )}\n      {showConfidenceFilter && (\n        <select value={filterConfidence} onChange={(e) => onFilterConfidenceChange(e.target.value)} className={`px-3 py-1.5 text-sm rounded-lg ${styles.bgSecondary} ${styles.border} border ${styles.text}`}>\n          <option value=\"all\">All Confidence</option>\n          <option value=\"high\">High (80%+)</option>\n          <option value=\"medium\">Medium (50-79%)</option>\n          <option value=\"low\">Low (&lt;50%)</option>\n        </select>\n      )}\n    </div>\n  );\n}\n","numLines":140,"startLine":1,"totalLines":140}}}
