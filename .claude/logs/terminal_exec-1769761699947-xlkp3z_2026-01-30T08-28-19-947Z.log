Box=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\">\n      <circle cx=\"12\" cy=\"12\" r=\"10\" />\n      <path d=\"M12 6v6l4 2\" />\n    </svg>\n  );\n}\n\n// =============================================================================\n// LESS FREQUENT ICONS (Lazy loaded - used in 1-2 files)\n// =============================================================================\n\n// Raw icon components for lazy loading\nconst GridIconRaw = () => (\n  <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\">\n    <rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" />\n    <rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" />\n    <rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" />\n    <rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" />\n  </svg>\n);\n\nconst DocumentIconRaw = () => (\n  <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\">\n    <path d=\"M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z\" />\n    <polyline points=\"14,2 14,8 20,8\" />\n  </svg>\n);\n\nconst UsersIconRaw = () => (\n  <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\">\n    <path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\" />\n    <circle cx=\"9\" cy=\"7\" r=\"4\" />\n    <path d=\"M23 21v-2a4 4 0 0 0-3-3.87m-4-12a4 4 0 0 1 0 7.75\" />\n  </svg>\n);\n\nconst PersonIconRaw = () => (\n  <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\">\n    <path d=\"M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2\" />\n    <circle cx=\"12\" cy=\"7\" r=\"4\" />\n  </svg>\n);\n\nconst SearchIconRaw = () => (\n  <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\">\n    <circle cx=\"11\" cy=\"11\" r=\"8\" />\n    <path d=\"m21 21-4.3-4.3\" />\n  </svg>\n);\n\nconst CheckCircleIconRaw = () => (\n  <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\">\n    <path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.1