ons\n    39→  const prevTabRef = useRef<TabId>('overview');\n    40→  const [direction, setDirection] = useState(1); // 1 = forward, -1 = back\n    41→\n    42→  const handleTabChange = (newTab: TabId) => {\n    43→    const prevIndex = TAB_ORDER.indexOf(prevTabRef.current);\n    44→    const newIndex = TAB_ORDER.indexOf(newTab);\n    45→    setDirection(newIndex > prevIndex ? 1 : -1);\n    46→    prevTabRef.current = newTab;\n    47→    setActiveTab(newTab);\n    48→  };\n    49→\n    50→  const stats = useMemo(() => {\n    51→    const findings = session.findings || [];\n    52→    const sources = session.sources || [];\n    53→    const avgConfidence = findings.length > 0\n    54→      ? Math.round(findings.reduce((sum, f) => sum + (f.confidence_score || 0), 0) / findings.length * 100)\n    55→      : 0;\n    56→    return {\n    57→      findings: findings.length,\n    58→      sources: sources.length,\n    59→      perspectives: session.perspectives?.length || 0,\n    60→      contradictions: session.contradictions?.length || 0,\n    61→      gaps: session.gaps?.length || 0,\n    62→      avgConfidence,\n    63→      highConfidence: findings.filter(f => (f.confidence_score || 0) >= 0.8).length,\n    64→      redFlags: findings.filter(f => f.finding_type === 'gap' || f.content.toLowerCase().includes('risk')).length,\n    65→      entities: session.entities?.length || 0,\n    66→    };\n    67→  }, [session]);\n    68→\n    69→  const findingTypes = useMemo(() =>\n    70→    Array.from(new Set(session.findings?.map(f => f.finding_type) || [])),\n    71→    [session.findings]\n    72→  );\n    73→\n    74→  return (\n    75→    <ReportShell onClose={onClose} titleId={titleId}>\n    76→      <ThemedSidebar activeTab={activeTab} onTabChange={handleTabChange} stats={stats} onClose={onClose} />\n    77→\n    78→      <main className={`flex-1 flex flex-col overflow-hidden ${styles.bg}`}>\n    79→        {/* Header */}\n    80→        <header className={`px-6 py-4 borde