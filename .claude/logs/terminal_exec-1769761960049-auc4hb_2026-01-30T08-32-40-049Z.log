_type !== filterType) {\n        return false;\n      }\n      const conf = f.confidence_score || 0;\n      if (filterConfidence === 'high' && conf < 0.8) return false;\n      if (filterConfidence === 'medium' && (conf < 0.5 || conf >= 0.8)) return false;\n      if (filterConfidence === 'low' && conf >= 0.5) return false;\n      return true;\n    });\n  }, [findings, searchQuery, filterType, filterConfidence]);\n\n  const sourceMap = useMemo(() => {\n    const map = new Map<string, ResearchSource>();\n    sources.forEach((s) => map.set(s.id, s));\n    return map;\n  }, [sources]);\n\n  if (filteredFindings.length === 0) {\n    return <EmptyState message=\"No findings match your filters\" />;\n  }\n\n  return (\n    <Section title=\"Findings\" count={filteredFindings.length}>\n      <div className=\"space-y-2\">\n        {filteredFindings.map((finding) => (\n          <FindingCard key={finding.id} finding={finding} sourceMap={sourceMap} />","numLines":55,"startLine":1,"totalLines":168}}}
