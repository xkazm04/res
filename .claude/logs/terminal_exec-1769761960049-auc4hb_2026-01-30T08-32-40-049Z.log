   top: 0,\n   115→                    left: 0,\n   116→                    width: '100%',\n   117→                    transform: `translateY(${virtualRow.start}px)`,\n   118→                  }}\n   119→                  className={`border-b ${isRadar ? 'border-cyan-500/5' : 'border-stone-100'}`}\n   120→                >\n   121→                  <FindingRow\n   122→                    finding={f}\n   123→                    sourceMap={sourceMap}\n   124→                    isExpanded={expandedId === f.id}\n   125→                    onToggle={() => setExpandedId(expandedId === f.id ? null : f.id)}\n   126→                  />\n   127→                </div>\n   128→              );\n   129→            })}\n   130→          </div>\n   131→        </div>\n   132→      </div>\n   133→    </div>\n   134→  );\n   135→}\n   136→\n   137→function SortHeader({ label, col, sortKey, current, dir, onSort }: {\n   138→  label: string; col: number; sortKey: SortKey; current: SortKey; dir: SortDir;\n   139→  onSort: (k: SortKey) => void;\n   140→}) {\n   141→  const { theme } = useReportTheme();\n   142→  const isRadar = theme === 'radar';\n   143→  const isActive = current === sortKey;\n   144→\n   145→  return (\n   146→    <button\n   147→      onClick={() => onSort(sortKey)}\n   148→      className={`col-span-${col} flex items-center gap-1 hover:text-white transition-colors ${isActive ? (isRadar ? 'text-cyan-400' : 'text-stone-900') : ''}`}\n   149→    >\n   150→      {label}\n   151→      {isActive && <span className=\"text-[8px]\">{dir === 'desc' ? '▼' : '▲'}</span>}\n   152→    </button>\n   153→  );\n   154→}\n   155→\n   156→function FindingRow({ finding, sourceMap, isExpanded, onToggle }: {\n   157→  finding: ResearchFinding;\n   158→  sourceMap: Map<string, ResearchSource>;\n   159→  isExpanded: boolean;\n   160→  onToggle: () => void;\n   161→}) {\n   162→  const { theme } = useReportTheme();\n   163→  const styles = useThemeStyles();\n   164→  const isRadar = theme === 'radar';\n   165→  const conf = finding.confidence_score || 0;\n   166→  const srcCount = finding.supporting_sources?.length || 0;\n   167→\n   168→  const confColor = conf >= 0.8 ? 'text-emerald-500' : conf >= 0.5 ? 'text-amber-500' : 'text-rose-500';\n   169→  const confBg = conf >= 0.8 ? 'bg-emerald-500' : conf >= 0.5 ? 'bg-amber-500' : 'bg-rose-500';\n   170→\n   171→  return (\n   172→    <div className={`${isRadar ? 'hover:bg-slate-800/50' : 'hover:bg-stone-50'} transition-colors`}>\n   173→      <button onClick={onToggle} className=\"w-full grid grid-cols-12 gap-2 px-3 py-2 text-left items-center\">\n   174→        {/* Confidence */}\n   175→        <div className=\"col-span-1 flex items-center gap-1\">\n   176→          <div className={`w-1.5 h-1.5 rounded-full ${confBg}`} />\n   177→          <span className={`text-xs font-mono ${confColor}`}>{Math.round(conf * 100)}</span>\n   178→        </div>\n   179→\n   180→        {/* Type */}\n   181→        <div className=\"col-span-2\">\n   182→          <span className={`text-[10px] px-1.5 py-0.5 rounded ${isRadar ? 'bg-slate-800 text-slate-300' : 'bg-stone-200 text-stone-600'}`}>\n   183→            {finding.finding_type}\n   184→          </span>\n   185→        </div>\n   186→\n   187→        {/* Content */}\n   188→        <div className={`col-span-7 text-xs ${styles.text} ${!isExpanded ? 'truncate' : ''}`}>\n   189→          {finding.content.split('.')[0]}.\n   190→        </div>\n   191→\n   192→        {/* Sources */}\n   193→        <div className={`col-span-1 text-xs text-center ${styles.textMuted}`}>{srcCount}</div>\n   194→\n   195→        {/* Date */}\n   196→        <div className={`col-span-1 text-[10px] ${styles.textMuted}`}>\n   197→          {finding.event_date ? new Date(finding.event_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '—'}\n   198→        </div>\n   199→      </button>\n   200→\n   201→      {/* Expanded content */}\n   202→      <AnimatePresence>\n   2