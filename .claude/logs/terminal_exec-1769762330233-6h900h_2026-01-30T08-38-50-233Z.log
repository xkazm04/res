 text-slate-800 text-sm\">{title}</h3>\n        </div>\n        {count !== undefined && (\n          <span className=\"text-[10px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full font-medium\">\n            {count}\n          </span>\n        )}\n      </div>\n      {(!collapsible || expanded) && (\n        <div className=\"p-4\">{children}</div>\n      )}\n    </div>\n  );\n}\n\n// Quick stat card\nexport function QuickStatCard({\n  label,\n  value,\n  subtext,\n  progress,\n  icon,\n  color,\n}: {\n  label: string;\n  value: string | number;\n  subtext?: string;\n  progress?: number;\n  icon: ReactNode;\n  color: 'blue' | 'emerald' | 'amber' | 'red' | 'slate';\n}) {\n  const colorClasses = {\n    blue: 'bg-blue-50 border-blue-200 text-blue-600',\n    emerald: 'bg-emerald-50 border-emerald-200 text-emerald-600',\n    amber: 'bg-amber-50 border-amber-200 text-amber-600',\n    red: 'bg-red-50 border-red-200 text-red-600',\n    slate: 'bg-slate-50 border-slate-200 text-slate-600',\n  };\n\n  const progressColors = {\n    blue: 'bg-blue-500',\n    emerald: 'bg-emerald-500',\n    amber: 'bg-amber-500',\n    red: 'bg-red-500',\n    slate: 'bg-slate-500',\n  };\n\n  return (\n    <div className={`rounded-lg border p-3 ${colorClasses[color]}`}>\n      <div className=\"flex items-center justify-between mb-1\">\n        <span className=\"w-4 h-4 opacity-60\">{icon}</span>\n        <span className=\"text-[9px] uppercase tracking-wider opacity-60\">{label}</span>\n      </div>\n      <div className=\"text-xl font-bold\">{value}</div>\n      {subtext && <div className=\"text-[10px] opacity-70 mt-0.5\">{subtext}</div>}\n      {progress !== undefined && (\n        <div className=\"h-1 bg-white/50 rounded-full mt-2 overflow-hidden\">\n          <div\n            className={`h-full rounded-full ${progressColors[color]}`}\n            style={{ width: `${progress}%` }}\n          />\n        </div>\n      )}\n    </div>\n  );\n}\n\n// Alert banner\nexport function AlertBanner({\