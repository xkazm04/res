-slate-700/20\">\n        <motion.div initial={{ width: 0 }} animate={{ width: `${(stats.high / total) * 100}%` }} className=\"h-full bg-emerald-500\" />\n        <motion.div initial={{ width: 0 }} animate={{ width: `${(stats.med / total) * 100}%` }} className=\"h-full bg-amber-500\" />\n        <motion.div initial={{ width: 0 }} animate={{ width: `${(stats.low / total) * 100}%` }} className=\"h-full bg-rose-500\" />\n      </div>\n    </div>\n  );\n}\n\nfunction ViewToggle({ mode, onChange }: { mode: ViewMode; onChange: (m: ViewMode) => void }) {\n  const { theme } = useReportTheme();\n  const isRadar = theme === 'radar';\n  const options: ViewMode[] = ['cards', 'network', 'radar'];\n\n  return (\n    <div className={`flex rounded-lg overflow-hidden ${isRadar ? 'bg-slate-800' : 'bg-stone-200'}`}>\n      {options.map(opt => (\n        <button\n          key={opt}\n          onClick={() => onChange(opt)}\n          className={`px-3 py-1.5 text-xs font-medium capitalize transition-colors ${\n            mode === opt\n              ? isRadar ? 'bg-cyan-500/20 text-cyan-300' : 'bg-white text-stone-900'\n              : isRadar ? 'text-slate-400 hover:text-white' : 'text-stone-600 hover:text-stone-900'\n          }`}\n        >\n          {opt}\n        </button>\n      ))}\n    </div>\n  );\n}\n\nfunction SourceCard({ source, delay, isSelected, onSelect }: {\n  source: ResearchSource;\n  delay: number;\n  isSelected: boolean;\n  onSelect: (id: string | null) => void;\n}) {\n  const { theme } = useReportTheme();\n  const styles = useThemeStyles();\n  const isRadar = theme === 'radar';\n  const cred = source.credibility_score || 0;\n\n  return (\n    <motion.div\n      layout\n      initial={{ opacity: 0, y: 10 }}\n      animate={{ opacity: 1, y: 0 }}\n      exit={{ opacity: 0, scale: 0.95 }}\n      transition={{ delay }}\n      onClick={() => onSelect(isSelected ? null : source.id)}\n      className={`p-4 rounded-xl cursor-pointer transition-all ${\n        isRadar\n    