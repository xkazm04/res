turn false;\n    38→      if (filterConfidence === 'low' && cred >= 0.5) return false;\n    39→      return true;\n    40→    });\n    41→  }, [sources, searchQuery, filterConfidence]);\n    42→\n    43→  const stats = useMemo(() => {\n    44→    const high = filtered.filter(s => (s.credibility_score || 0) >= 0.8).length;\n    45→    const med = filtered.filter(s => { const c = s.credibility_score || 0; return c >= 0.5 && c < 0.8; }).length;\n    46→    return { high, med, low: filtered.length - high - med };\n    47→  }, [filtered]);\n    48→\n    49→  if (filtered.length === 0) {\n    50→    return (\n    51→      <EmptyState\n    52→        type=\"search\"\n    53→        title=\"No sources match your filters\"\n    54→        description=\"Try adjusting your search or confidence filters to see more results.\"\n    55→      />\n    56→    );\n    57→  }\n    58→\n    59→  return (\n    60→    <div className=\"space-y-4\">\n    61→      <ViewHeader\n    62→        title=\"Sources\"\n    63→        count={filtered.length}\n    64→        actions={<ViewToggle mode={viewMode} onChange={setViewMode} />}\n    65→      />\n    66→      {/* Credibility summary bar */}\n    67→      <CredibilityBar stats={stats} total={filtered.length} />\n    68→\n    69→      {/* Network View */}\n    70→      {viewMode === 'network' && (\n    71→        <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }}>\n    72→          <SourceNetwork sources={filtered} selectedSource={selectedSource || undefined} onSourceSelect={setSelectedSource} />\n    73→        </motion.div>\n    74→      )}\n    75→\n    76→      {/* Radar View */}\n    77→      {viewMode === 'radar' && (\n    78→        <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }}>\n    79→          <TrustRadar sources={filtered} />\n    80→        </motion.div>\n    81→      )}\n    82→\n    83→      {/* Cards View */}\n    84→      {viewMode === 'cards' && (\n    85→        <motion.div layout className=\"grid grid-cols-1 md:grid-cols-2 gap-3\">\n    86→          <AnimatePresence>\n    87→            {filtered.map((source, i) => (\n    88→              <SourceCard key={source.id} source={source} delay={i * 0.03} isSelected={selectedSource === source.id} onSelect={setSelectedSource} />\n    89→            ))}\n    90→          </AnimatePresence>\n    91→        </motion.div>\n    92→      )}\n    93→    </div>\n    94→  );\n    95→}\n    96→\n    97→function CredibilityBar({ stats, total }: { stats: { high: number; med: number; low: number }; total: number }) {\n    98→  const { theme } = useReportTheme();\n    99→  const styles = useThemeStyles();\n   100→  const isRadar = theme === 'radar';\n   101→\n   102→  return (\n   103→    <div className={`flex items-center gap-4`}>\n   104→      <div className={`text-sm ${styles.textMuted}`}><AnimatedNumber value={total} /> sources</div>\n   105→      <div className=\"flex items-center gap-1 h-2 w-32 rounded-full overflow-hidden bg-slate-700/20\">\n   106→        <motion.div initial={{ width: 0 }} animate={{ width: `${(stats.high / total) * 100}%` }} className=\"h-full bg-emerald-500\" />\n   107→        <motion.div initial={{ width: 0 }} animate={{ width: `${(stats.med / total) * 100}%` }} className=\"h-full bg-amber-500\" />\n   108→        <motion.div initial={{ width: 0 }} animate={{ width: `${(stats.low / total) * 100}%` }} className=\"h-full bg-rose-500\" />\n   109→      </div>\n   110→    </div>\n   111→  );\n   112→}\n   113→\n   114→function ViewToggle({ mode, onChange }: { mode: ViewMode; onChange: (m: ViewMode) => void }) {\n   115→  const { theme } = useReportTheme();\n   116→  const isRadar = theme === 'radar';\n   117→  const options: ViewMode[] = ['cards', 'network', 'radar'];\n   118→\n   119→  return (\n   120→    <div className={`flex rounded-lg overflow-hidden ${isRadar ? 'bg-slate-800' : 'bg-stone-200'}`}>\n   121→      {options.map(opt => (\n   122→        <button\n   123→          key={opt}\n   124→          onClick={() => onChange(opt)}\n   125→          className={`px-3 py-1.5 text-xs font-medium capitalize transition-colors ${\n   126→            mode === opt\n   127→              ? isRadar ? 'bg-cyan-500/20 text-cyan-300' : 'bg-white text-stone-900'\n   128→              : isRadar ? 'text-slate-400 hover:text-white' : 'text-stone-600 hover:text-stone-900'\n   129→          }`}\n   130→        >\n   131→          {opt}\n   132→        </button>\n   133→      ))}\n   134→    </div>\n   135→  );\n   136→}\n   137→\n   138→function SourceCard({ source, delay, isSelected, onSelect }: {\n   139→  source: ResearchSource;\n   140→  delay: number;\n   141→  isSelected: boolean;\n   142→  onSelect: (id: string | null) => void;\n   143→}) {\n   144→  const { theme } = useReportTheme();\n   145→  const styles = useThemeStyles();\n   146→  const isRadar = theme === 'radar';\n   147→  const cred = source.credibility_score || 0;\n   148→\n   149→  return (\n   150→    <motion.div\n   151→      layout\n   152→      initial={{ opacity: 0, y: 10 }}\n   153→      animate={{ opacity: 1, y: 0 }}\n   154→      exit={{ opacity: 0, scale: 0.95 }}\n   155→      transition={{ delay }}\n   156→      onClick={() => onSelect(isSelected ? null : source.id)}\n   157→      className={`p-4 rounded-xl cursor-pointer transition-all ${\n   158→        isRadar\n   159→          ? `bg-slate-900/60 border ${isSelected ? 'border-cyan-400 shadow-[0_0_20px_rgba(34,211,238,0.2)]' : 'border-cyan-500/10 hover:border-cyan-500/30'}`\n   160→          : `bg-white border ${isSelected ? 'border-stone-800 shadow-lg' : 'border-stone-200 hover:border-stone-400'}`\n   161→      }`}\n   162→    >\n   163→      <div className=\"flex items-start gap-3\">\n   164→        <AnimatedProgressRing\n   165→          value={cred * 100}\n   166→          size={44}\n   167→          strokeWidth={3}\n   168→          color={cred >= 0.8 ? '#34d399' : cred >= 0.5 ? '#fbbf24' : '#f87171'}\n   169→          bgColor={isRadar ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)'}\n   170→        />\n   171→        <div className=\"flex-1 min-w-0\">\n   172→          <div className=\"flex items-center gap-2 mb-1\">\n   173→            <ThemedBadge>{source.source_type || 'web'}</ThemedBadge>\n   174→            <span className={`text-[10px] ${styles.textMuted}`}>{Math.round(cred * 100)}%</span>\n   175→          </div>\n   176→          <a href={source.url} target=\"_blank\" rel=\"noopener noreferrer\" onClick={e => e.stopPropagation()}\n   177→            className={`text-sm font-medium line-clamp-1 transition-colors ${isRadar ? 'text-cyan-300 hover:text-cyan-200' : 'text-blue-600 hover:text-blue-800'}`}>\n   178→            {source.title || source.domain}\n   179→          </a>\n   180→          <p className={`text-[10px] ${styles.textMuted} mt-0.5`}>{source.domain}</p>\n   181→          {source.snippet && (\n   182→            <p className={`text-xs ${styles.textMuted} mt-2 line-clamp-2 italic`}>\"{source.snippet}\"</p>\n   183→          )}\n   184→        </div>\n   185→      </div>\n   186→    </motion.div>\n   187→  );\n   188→}\n   189→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"a8a4f9ca-6a40-4b19-853c-2be96846861c","uuid":"0882d9af-2a28-4774-9e9b-b49d79e8e460","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\views\\SourcesView.tsx","content":"'use client';\n\nimport { useMemo, useState } from 'react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport type { ResearchSource } from '@/src/types/research';\nimport { useReportTheme, useThemeStyles } from '../core/ThemeContext';\nimport { ThemedBadge } from '../ThemedCards';\nimport { AnimatedNumber, AnimatedProgressRing } from '../core/AnimatedNumber';\nimport { SourceNetwork } from '../visualizations/SourceNetwork';\nimport { TrustRadar } from '../visualizations/TrustRadar';\nimport { ViewHeader } from '../shared/ViewHeader';\nimport { EmptyState } from '../shared/EmptyState';\n\ninterface SourcesViewProps {\n  sources: ResearchSource[];\n  searchQuery: string;\n  filterConfidence: string;\n}\n\ntype ViewMode = 'cards' | 'network' | 'radar';\n\nexport function SourcesView({ sources, searchQuery, filterConfidence }: SourcesViewProps) {\n  const { theme } = useReportTheme();\n  const styles = useThemeStyles();\n  const isRadar = theme === 'radar';\n  const [viewMode, setViewMode] = useState<ViewMode>('cards');\n  const [selectedSource, setSelectedSource] = useState<string | null>(null);\n\n  const filtered = useMemo(() => {\n    return sources.filter((s) => {\n      if (searchQuery) {\n        const q = searchQuery.toLowerCase();\n        if (!s.title?.toLowerCase().includes(q) && !s.domain?.toLowerCase().includes(q)) return false;\n      }\n      const cred = s.credibility_score || 0;\n      if (filterConfidence === 'high' && cred < 0.8) return false;\n      if (filterConfidence === 'medium' && (cred < 0.5 || cred >= 0.8)) return false;\n      if (filterConfidence === 'low' && cred >= 0.5) return false;\n      return true;\n    });\n  }, [sources, searchQuery, filterConfidence]);\n\n  const stats = useMemo(() => {\n    const high = filtered.filter(s => (s.credibility_score || 0) >= 0.8).length;\n    const med = filtered.filter(s => { const c = s.credibility_score || 0; return c >= 0.5 && c < 0.8; }).length;\n    return { high, med, low: filtered.length - high - med };\n  }, [filtered]);\n\n  if (filtered.length === 0) {\n    return (\n      <EmptyState\n        type=\"search\"\n        title=\"No sources match your filters\"\n        description=\"Try adjusting your search or confidence filters to see more results.\"\n      />\n    );\n  }\n\n  return (\n    <div className=\"space-y-4\">\n      <ViewHeader\n        title=\"Sources\"\n        count={filtered.length}\n        actions={<ViewToggle mode={viewMode} onChange={setViewMode} />}\n      />\n      {/* Credibility summary bar */}\n      <CredibilityBar stats={stats} total={filtered.length} />\n\n      {/* Network View */}\n      {viewMode === 'network' && (\n        <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }}>\n          <SourceNetwork sources={filtered} selectedSource={selectedSource || undefined} onSourceSelect={setSelectedSource} />\n        </motion.div>\n      )}\n\n      {/* Radar View */}\n      {viewMode === 'radar' && (\n        <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }}>\n          <TrustRadar sources={filtered} />\n        </motion.div>\n      )}\n\n      {/* Cards View */}\n      {viewMode === 'cards' && (\n        <motion.div layout className=\"grid grid-cols-1 md:grid-cols-2 gap-3\">\n          <AnimatePresence>\n            {filtered.map((source, i) => (\n              <SourceCard key={source.id} source={source} delay={i * 0.03} isSelected={selectedSource === source.id} onSelect={setSelectedSource} />\n            ))}\n          </AnimatePresence>\n        </motion.div>\n      )}\n    </div>\n  );\n}\n\nfunction CredibilityBar({ stats, total }: { stats: { high: number; med: number; low: number }; total: number }) {\n  const { theme } = useReportTheme();\n  const styles = useThemeStyles();\n  const isRadar = theme === 'radar';\n\n  return (\n    <div className={`flex items-center gap-4`}>\n      <div className={`text-sm ${styles.textMuted}`}><AnimatedNumber value={total} /> sources</div>\n      <div className=\"flex items-center gap-1 h-2 w-32 rounded-full overflow-hidden bg-slate-700/20\">\n        <motion.div initial={{ width: 0 }} animate={{ width: `${(stats.high / total) * 100}%` }} className=\"h-full bg-emerald-500\" />\n        <motion.div initial={{ width: 0 }} animate={{ width: `${(stats.med / total) * 100}%` }} className=\"h-full bg-amber-500\" />\n        <motion.div initial={{ width: 0 }} animate={{ width: `${(stats.low / total) * 100}%` }} className=\"h-full bg-rose-500\" />\n      </div>\n    </div>\n  );\n}\n\nfunction ViewToggle({ mode, onChange }: { mode: ViewMode; onChange: (m: ViewMode) => void }) {\n  const { theme } = useReportTheme();\n  const isRadar = theme === 'radar';\n  const options: ViewMode[] = ['cards', 'network', 'radar'];\n\n  return (\n    <div className={`flex rounded-lg overflow-hidden ${isRadar ? 'bg-slate-800' : 'bg-stone-200'}`}>\n      {options.map(opt => (\n        <button\n          key={opt}\n          onClick={() => onChange(opt)}\n          className={`px-3 py-1.5 text-xs font-medium capitalize transition-colors ${\n            mode === opt\n              ? isRadar ? 'bg-cyan-500/20 text-cyan-300' : 'bg-white text-stone-900'\n              : isRadar ? 'text-slate-400 hover:text-white' : 'text-stone-600 hover:text-stone-900'\n          }`}\n        >\n          {opt}\n        </button>\n      ))}\n    </div>\n  );\n}\n\nfunction SourceCard({ source, delay, isSelected, onSelect }: {\n  source: ResearchSource;\n  delay: number;\n  isSelected: boolean;\n  onSelect: (id: string | null) => void;\n}) {\n  const { theme } = useReportTheme();\n  const styles = useThemeStyles();\n  const isRadar = theme === 'radar';\n  const cred = source.credibility_score || 0;\n\n  return (\n    <motion.div\n      layout\n      initial={{ opacity: 0, y: 10 }}\n      animate={{ opacity: 1, y: 0 }}\n      exit={{ opacity: 0, scale: 0.95 }}\n      transition={{ delay }}\n      onClick={() => onSelect(isSelected ? null : source.id)}\n      className={`p-4 rounded-xl cursor-pointer transition-all ${\n        isRadar\n          ? `bg-slate-900/60 border ${isSelected ? 'border-cyan-400 shadow-[0_0_20px_rgba(34,211,238,0.2)]' : 'border-cyan-500/10 hover:border-cyan-500/30'}`\n          : `bg-white border ${is