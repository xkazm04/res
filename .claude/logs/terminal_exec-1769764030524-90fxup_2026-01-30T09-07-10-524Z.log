[2026-01-30T09:07:18.066Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017gg9v7vL331c9Z5JrAu6uo","type":"tool_result","content":"     1→/**\n     2→ * Research service that orchestrates deep research using Gemini with Google Search grounding.\n     3→ *\n     4→ * Features:\n     5→ * - Session persistence to Supabase for recovery\n     6→ * - Email notification on completion/failure\n     7→ * - Incremental progress tracking\n     8→ */\n     9→\n    10→import { GeminiClient, Source, TokenUsage } from './gemini-client';\n    11→import { TEMPLATE_CONFIGS, TemplateType, generateSearchQueries, extractFindings } from './templates';\n    12→import { sendResearchCompletedEmail, sendResearchFailedEmail, isEmailConfigured } from './email-service';\n    13→import {\n    14→  createActorSession,\n    15→  updateActorSession,\n    16→  saveActorFindings,\n    17→  saveActorSources,\n    18→  saveActorPerspectives,\n    19→  saveActorReport,\n    20→} from '@/src/lib/supabase';\n    21→\n    22→export interface Finding {\n    23→  findingId: string;\n    24→  findingType: string;\n    25→  content: string;\n    26→  summary?: string;\n    27→  confidenceScore: number;\n    28→  temporalContext: string;\n    29→  extractedData?: Record<string, unknown>;\n    30→  supportingSources?: { url: string; title: string }[];\n    31→}\n    32→\n    33→export interface Perspective {\n    34→  perspectiveType: string;\n    35→  analysisText: string;\n    36→  keyInsights: string[];\n    37→  recommendations: string[];\n    38→  warnings: string[];\n    39→  confidence: number;\n    40→}\n    41→\n    42→export interface CostSummary {\n    43→  totalTokens: number;\n    44→  inputTokens: number;\n    45→  outputTokens: number;\n    46→  geminiCostUsd: number;\n    47→  openrouterCostUsd: number;\n    48→  totalCostUsd: number;\n    49→}\n    50→\n    51→export interface ResearchResult {\n    52→  sessionId: string;\n    53→  query: string;\n    54→  template: string;\n    55→  status: 'completed' | 'partial' | 'failed';\n    56→  findings: Finding[];\n    57→  perspectives: Perspective[];\n    58→  sources: Source[];\n    59→  searchQueriesExecuted: string[];\n    60→  reportMarkdown?: string;\n    61→  costSummary: CostSummary;\n    62→  executionTimeSeconds: number;\n    63→  errors: string[];\n    64→  warnings: string[];\n    65→}\n    66→\n    67→export class ResearchService {\n    68→  private client: GeminiClient;\n    69→  private totalTokens = 0;\n    70→  private inputTokens = 0;\n    71→  private outputTokens = 0;\n    72→  private totalCost = 0;\n    73→\n    74→  constructor(apiKey: string) {\n    75→    this.client = new GeminiClient(apiKey);\n    76→  }\n    77→\n    78→  async executeResearch(\n    79→    query: string,\n    80→    templateType: TemplateType = 'investigative',\n    81→    granularity: string = 'standard',\n    82→    maxSearches: number = 5,\n    83→    generateReport: boolean = false,\n    84→    reportVariant: string = 'full_report',\n    85→    inputText?: string,\n    86→    options?: {\n    87→      userEmail?: string;\n    88→      persistToDb?: boolean;\n    89→      sendEmail?: boolean;\n    90→    }\n    91→  ): Promise<ResearchResult> {\n    92→    const startTime = Date.now();\n    93→    const sessionId = crypto.randomUUID();\n    94→    const errors: string[] = [];\n    95→    const warnings: string[] = [];\n    96→\n    97→    const persistToDb = options?.persistToDb ?? true;\n    98→    const sendEmail = options?.sendEmail ?? !!options?.userEmail;\n    99→    const userEmail = options?.userEmail;\n   100→\n   101→    this.resetTokenTracking();\n   102→\n   103→    const templateConfig = TEMPLATE_CONFIGS[templateType];\n   104→\n   105→    // Create session in database for persistence/recovery\n   106→    if (persistToDb) {\n   107→      try {\n   108→        await createActorSession({\n   109→          id: sessionId,\n   110→          query,\n   111→          template: templateType,\n   112→          status: 'running',\n   113→          granularity,\n   114→          max_searches: maxSearches,\n   115→          user_email: userEmail,\n   116→          progress_phase: 'initializing',\n   117→          progress_percent: 0,\n   118→        });\n   119→      } catch (e) {\n   120→        console.warn('Failed to create session in database:', e);\n   121→        warnings.push('Session persistence unavailable - results will not be recoverable');\n   122→      }\n   123→    }\n   124→\n   125→    try {\n   126→      // Phase 1: Generate search queries\n   127→      console.log('Phase 1: Generating search queries...');\n   128→      const searchQueries = await this.generateQueries(query, templateType, maxSearches, granularity);\n   129→\n   130→      if (!searchQueries.length) {\n   131→        errors.push('Failed to generate search queries');\n   132→        return this.buildErrorResult(sessionId, query, templateType, errors, startTime);\n   133→      }\n   134→\n   135→      console.log(`Generated ${searchQueries.length} search queries`);\n   136→\n   137→      // Phase 2: Execute grounded searches\n   138→      console.log('Phase 2: Executing grounded web searches...');\n   139→      if (persistToDb) {\n   140→        await updateActorSession(sessionId, { progress_phase: 'searching', progress_percent: 20 });\n   141→      }\n   142→      const allSources: Source[] = [];\n   143→      const allContent: string[] = [];\n   144→\n   145→      // Add input context if provided\n   146→      if (inputText) {\n   147→        allContent.push(`## Input Context\\n\\n${inputText}`);\n   148→      }\n   149→\n   150→      for (let i = 0; i < searchQueries.length; i++) {\n   151→        const searchQuery = searchQueries[i];\n   152→        console.log(`  [${i + 1}/${searchQueries.length}] ${searchQuery.slice(0, 50)}...`);\n   153→\n   154→        // Update progress during searches\n   155→        if (persistToDb && i % 2 === 0) {\n   156→          const searchProgress = 20 + Math.floor((i / searchQueries.length) * 30);\n   157→          await updateActorSession(sessionId, { progress_percent: searchProgress });\n   158→        }\n   159→\n   160→        try {\n   161→          const result = await this.client.research(searchQuery);\n   162→          this.trackTokens(result.tokenUsage, result.costUsd);\n   163→\n   164→          // Collect sources\n   165→          for (const source of result.sources) {\n   166→            // Deduplicate by URL\n   167→            if (!allSources.some(s => s.url === source.url)) {\n   168→              allSources.push(source);\n   169→            }\n   170→          }\n   171→\n   172→          // Collect content\n   173→          if (result.text) {\n   174→            allContent.push(`## Search: ${searchQuery}\\n\\n${result.text}`);\n   175→          }\n   176→        } catch (e) {\n   177→          const errorMsg = e instanceof Error ? e.message : String(e);\n   178→          warnings.push(`Search failed for '${searchQuery.slice(0, 30)}...': ${errorMsg}`);\n   179→          console.warn(`  Search failed: ${errorMsg}`);\n   180→        }\n   181→      }\n   182→\n   183→      console.log(`Found ${allSources.length} unique sources`);\n   184→\n   185→      // Phase 3: Assess source credibility\n   186→      const sourcesWithCredibility = allSources.map(s => ({\n   187→        ...s,\n   188→        credibilityScore: this.assessCredibility(s.domain),\n   189→        credibilityLabel: this.credibilityLabel(this.assessCredibility(s.domain)),\n   190→      }));\n   191→\n   192→      // Phase 4: Extract findings\n   193→      console.log('Phase 4: Extracting findings...');\n   194→      if (persistToDb) {\n   195→        await updateActorSession(sessionId, { progress_phase: 'extracting_findings', progress_percent: 55 });\n   196→      }\n   197→      const synthesizedContent = allContent.join('\\n\\n---\\n\\n');\n   198→      const findings = await this.extractFindings(\n   199→        query,\n   200→        sourcesWithCredibility,\n   201→        synthesizedContent,\n   202→        templateType,\n   203→        granularity\n   204→      );\n   205→\n   206→      // Add IDs and supporting sources\n   207→      findings.forEach((f, i) => {\n   208→        f.findingId = `f${i + 1}`;\n   209→        f.supportingSources = sourcesWithCredibility.slice(0, 3).map(s => ({\n   210→          url: s.url,\n   211→          title: s.title,\n   212→        }));\n   213→      });\n   214→\n   215→      console.log(`Extracted ${findings.length} findings`);\n   216→\n   217→      // Phase 5: Multi-perspective analysis\n   218→      console.log('Phase 5: Running perspective analysis...');\n   219→      if (persistToDb) {\n   220→        await updateActorSession(sessionId, { progress_phase: 'analyzing_perspectives', progress_percent: 70 });\n   221→      }\n   222→      const perspectives: Perspective[] = [];\n   223→\n   224→      for (const perspectiveType of templateConfig.perspectives) {\n   225→        try {\n   226→          const analysis = await this.analyzePerspective(\n   227→            perspectiveType,\n   228→            findings,\n   229→            sourcesWithCredibility,\n   230→            query,\n   231→            templateConfig\n   232→          );\n   233→          perspectives.push(analysis);\n   234→        } catch (e) {\n   235→          const errorMsg = e instanceof Error ? e.message : String(e);\n   236→          warnings.push(`Perspective analysis failed for '${perspectiveType}': ${errorMsg}`);\n   237→        }\n   238→      }\n   239→\n   240→      console.log(`Generated ${perspectives.length} perspective analyses`);\n   241→\n   242→      // Phase 6: Generate report (optional)\n   243→      let reportMarkdown: string | undefined;\n   244→      if (generateReport) {\n   245→        console.log('Phase 6: Generating report...');\n   246→        if (persistToDb) {\n   247→          await updateActorSession(sessionId, { progress_phase: 'generating_report', progress_percent: 90 });\n   248→        }\n   249→        reportMarkdown = await this.generateReport(\n   250→          query,\n   251→          findings,\n   252→          perspectives,\n   253→          sourcesWithCredibility,\n   254→          reportVariant\n   255→        );\n   256→      }\n   257→\n   258→      const executionTime = (Date.now() - startTime) / 1000;\n   259→\n   260→      const result: ResearchResult = {\n   261→        sessionId,\n   262→        query,\n   263→        template: templateType,\n   264→        status: errors.length > 0 ? 'partial' : 'completed',\n   265→        findings,\n   266→        perspectives,\n   267→        sources: sourcesWithCredibility,\n   268→        searchQueriesExecuted: searchQueries,\n   269→        reportMarkdown,\n   270→        costSummary: {\n   271→          totalTokens: this.totalTokens,\n   272→          inputTokens: this.inputTokens,\n   273→          outputTokens: this.outputTokens,\n   274→          geminiCostUsd: this.totalCost,\n   275→          openrouterCostUsd: 0,\n   276→          totalCostUsd: this.totalCost,\n   277→        },\n   278→        executionTimeSeconds: Math.round(executionTime * 100) / 100,\n   279→        errors,\n   280→        warnings,\n   281→      };\n   282→\n   283→      // Save results to database for recovery\n   284→      if (persistToDb) {\n   285→        console.log('Saving results to database...');\n   286→        try {\n   287→          await Promise.all([\n   288→            saveActorFindings(sessionId, findings.map(f => ({\n   289→              finding_id: f.findingId,\n   290→              finding_type: f.findingType,\n   291→              content: f.content,\n   292→              summary: f.summary,\n   293→              confidence_score: f.confidenceScore,\n   294→              temporal_context: f.temporalContext,\n   295→              extracted_data: f.extractedData,\n   296→            }))),\n   297→            saveActorSources(sessionId, sourcesWithCredibility.map(s => ({\n   298→              url: s.url,\n   299→              title: s.title,\n   300→              domain: s.domain,\n   301→              snippet: s.snippet,\n   302→              credibility_score: s.credibilityScore,\n   303→              credibility_label: s.credibilityLabel,\n   304→            }))),\n   305→            saveActorPerspectives(sessionId, perspectives.map(p => ({\n   306→              perspective_type: p.perspectiveType,\n   307→              analysis_text: p.analysisText,\n   308→              key_insights: p.keyInsights,\n   309→              recommendations: p.recommendations,\n   310→              warnings: p.warnings,\n   311→              confidence: p.confidence,\n   312→            }))),\n   313→          ]);\n   314→\n   315→          await saveActorReport(sessionId, reportMarkdown || '', {\n   316→            total_tokens: this.totalTokens,\n   317→            total_cost_usd: this.totalCost,\n   318→          });\n   319→        } catch (e) {\n   320→          console.warn('Failed to save results to database:', e);\n   321→          warnings.push('Failed to persist results - session may not be recoverable');\n   322→        }\n   323→      }\n   324→\n   325→      // Send email notification if configured\n   326→      if (sendEmail && userEmail) {\n   327→        console.log(`Sending completion email to ${userEmail}...`);\n   328→        try {\n   329→          const emailResult = await sendResearchCompletedEmail(userEmail, {\n   330→            sessionId,\n   331→            query,\n   332→            template: templateType,\n   333→            findingsCount: findings.length,\n   334→            sourcesCount: sourcesWithCredibility.length,\n   335→            perspectivesCount: perspectives.length,\n   336→            executionTime,\n   337→            totalCost: this.totalCost,\n   338→            reportMarkdown,\n   339→          });\n   340→          if (!emailResult.success) {\n   341→            warnings.push(`Email notification failed: ${emailResult.error}`);\n   342→          }\n   343→        } catch (e) {\n   344→          console.warn('Failed to send email:', e);\n   345→          warnings.push('Email notification failed');\n   346→        }\n   347→      }\n   348→\n   349→      return result;\n   350→    } catch (e) {\n   351→      const errorMsg = e instanceof Error ? e.message : String(e);\n   352→      errors.push(errorMsg);\n   353→\n   354→      // Update session status to failed\n   355→      if (persistToDb) {\n   356→        await updateActorSession(sessionId, {\n   357→          status: 'failed',\n   358→          error_message: errorMsg,\n   359→          completed_at: new Date().toISOString(),\n   360→        });\n   361→      }\n   362→\n   363→      // Send failure notification if email configured\n   364→      if (sendEmail && userEmail) {\n   365→        await sendResearchFailedEmail(userEmail, {\n   366→          sessionId,\n   367→          query,\n   368→          errorMessage: errorMsg,\n   369→        });\n   370→      }\n   371→\n   372→      return this.buildErrorResult(sessionId, query, templateType, errors, startTime);\n   373→    }\n   374→  }\n   375→\n   376→  private async generateQueries(\n   377→    query: string,\n   378→    templateType: TemplateType,\n   379→    maxSearches: number,\n   380→    granularity: string\n   381→  ): Promise<string[]> {\n   382→    const prompt = generateSearchQueries(query, templateType, maxSearches, granularity);\n   383→\n   384→    const { data } = await this.client.generateJson<string[]>(prompt);\n   385→    this.trackJsonTokens();\n   386→\n   387→    if (Array.isArray(data)) {\n   388→      return data.slice(0, maxSearches);\n   389→    }\n   390→\n   391→    // Fallback: generate basic queries\n   392→    return [\n   393→      `${query} latest news analysis`,\n   394→      `${query} key facts timeline`,\n   395→      `${query} expert analysis 2024`,\n   396→    ].slice(0, maxSearches);\n   397→  }\n   398→\n   399→  private async extractFindings(\n   400→    query: string,\n   401→    sources: Source[],\n   402→    synthesizedContent: string,\n   403→    templateType: TemplateType,\n   404→    granularity: string\n   405→  ): Promise<Finding[]> {\n   406→    const prompt = extractFindings(query, sources, synthesizedContent, templateType, granularity);\n   407→\n   408→    const { data } = await this.client.generateJson<Array<{\n   409→      finding_type?: string;\n   410→      content?: string;\n   411→      summary?: string;\n   412→      confidence_score?: number;\n   413→      temporal_context?: string;\n   414→      extracted_data?: Record<string, unknown>;\n   415→    }>>(prompt);\n   416→\n   417→    this.trackJsonTokens();\n   418→\n   419→    if (!Array.isArray(data)) return [];\n   420→\n   421→    return data.map(f => ({\n   422→      findingId: '',\n   423→      findingType: f.finding_type || 'fact',\n   424→      content: f.content || '',\n   425→      summary: f.summary,\n   426→      confidenceScore: f.confidence_score || 0.5,\n   427→      temporalContext: f.temporal_context || 'present',\n   428→      extractedData: f.extracted_data,\n   429→    }));\n   430→  }\n   431→\n   432→  private async analyzePerspective(\n   433→    perspectiveType: string,\n   434→    findings: Finding[],\n   435→    sources: Source[],\n   436→    query: string,\n   437→    templateConfig: typeof TEMPLATE_CONFIGS[TemplateType]\n   438→  ): Promise<Perspective> {\n   439→    const perspectivePrompt = templateConfig.perspectivePrompts[perspectiveType] || '';\n   440→\n   441→    const findingsContext = findings.slice(0, 15).map(f =>\n   442→      `- [${f.findingType.toUpperCase()}] ${f.summary || f.content.slice(0, 200)}`\n   443→    ).join('\\n');\n   444→\n   445→    const sourcesContext = sources.slice(0, 10).map(s =>\n   446→      `- ${s.title} (${s.domain})`\n   447→    ).join('\\n');\n   448→\n   449→    const prompt = `\n   450→${perspectivePrompt}\n   451→\n   452→RESEARCH QUERY: ${query}\n   453→\n   454→KEY FINDINGS:\n   455→${findingsContext}\n   456→\n   457→SOURCES CONSULTED:\n   458→${sourcesContext}\n   459→\n   460→Provide your analysis as JSON:\n   461→{\n   462→  \"analysis_text\": \"Your detailed expert analysis (2-3 paragraphs)\",\n   463→  \"key_insights\": [\"Insight 1\", \"Insight 2\", \"Insight 3\"],\n   464→  \"recommendations\": [\"Recommendation 1\", \"Recommendation 2\"],\n   465→  \"warnings\": [\"Warning or risk 1\"],\n   466→  \"confidence\": 0.0-1.0\n   467→}\n   468→`;\n   469→\n   470→    const { data } = await this.client.generateJson<{\n   471→      analysis_text?: string;\n   472→      key_insights?: string[];\n   473→      recommendations?: string[];\n   474→      warnings?: string[];\n   475→      confidence?: number;\n   476→    }>(prompt);\n   477→\n   478→    this.trackJsonTokens();\n   479→\n   480→    return {\n   481→      perspectiveType,\n   482→      analysisText: data?.analysis_text || `Analysis from ${perspectiveType} perspective.`,\n   483→      keyInsights: data?.key_insights || [],\n   484→      recommendations: data?.recommendations || [],\n   485→      warnings: data?.warnings || [],\n   486→      confidence: data?.confidence || 0.7,\n   487→    };\n   488→  }\n   489→\n   490→  private async generateReport(\n   491→    query: string,\n   492→    findings: Finding[],\n   493→    perspectives: Perspective[],\n   494→    sources: Source[],\n   495→    variant: string\n   496→  ): Promise<string> {\n   497→    const findingsText = findings.map(f =>\n   498→      `### ${f.summary || 'Finding'}\\n- **Type**: ${f.findingType}\\n- **Confidence**: ${(f.confidenceScore * 100).toFixed(0)}%\\n\\n${f.content}`\n   499→    ).join('\\n\\n');\n   500→\n   501→    const perspectivesText = perspectives.map(p =>\n   502→      `### ${p.perspectiveType} Perspective\\n${p.analysisText}\\n\\n**Key Insights:**\\n${p.keyInsights.map(i => `- ${i}`).join('\\n')}`\n   503→    ).join('\\n\\n');\n   504→\n   505→    const sourcesText = sources.slice(0, 20).map(s =>\n   506→      `- [${s.title}](${s.url}) - ${s.domain}`\n   507→    ).join('\\n');\n   508→\n   509→    const title = variant === 'executive_summary'\n   510→      ? `Executive Summary: ${query}`\n   511→      : variant === 'investment_thesis'\n   512→      ? `Investment Thesis: ${query}`\n   513→      : `Research Report: ${query}`;\n   514→\n   515→    return `# ${title}\n   516→\n   517→**Generated:** ${new Date().toISOString()}\n   518→\n   519→---\n   520→\n   521→## Executive Summary\n   522→\n   523→This report presents findings from comprehensive research on: \"${query}\"\n   524→\n   525→## Key Findings\n   526→\n   527→${findingsText}\n   528→\n   529→## Expert Perspectives\n   530→\n   531→${perspectivesText}\n   532→\n   533→## Sources\n   534→\n   535→${sourcesText}\n   536→\n   537→---\n   538→\n   539→*Generated by Deep Research Actor with Gemini + Google Search grounding*\n   540→`;\n   541→  }\n   542→\n   543→  private assessCredibility(domain: string): number {\n   544→    const d = domain.toLowerCase();\n   545→\n   546→    // High credibility\n   547→    if (['gov', 'edu', 'reuters', 'ap', 'bbc', 'nytimes', 'wsj', 'ft.com', 'bloomberg', 'sec.gov'].some(h => d.includes(h))) {\n   548→      return 0.85;\n   549→    }\n   550→\n   551→    // Medium-high credibility\n   552→    if (['forbes', 'businessinsider', 'cnbc', 'marketwatch', 'yahoo', 'cnn', 'washingtonpost'].some(h => d.includes(h))) {\n   553→      return 0.70;\n   554→    }\n   555→\n   556→    return 0.55;\n   557→  }\n   558→\n   559→  private credibilityLabel(score: number): string {\n   560→    if (score >= 0.8) return 'high';\n   561→    if (score >= 0.6) return 'medium';\n   562→    return 'low';\n   563→  }\n   564→\n   565→  private resetTokenTracking() {\n   566→    this.totalTokens = 0;\n   567→    this.inputTokens = 0;\n   568→    this.outputTokens = 0;\n   569→    this.totalCost = 0;\n   570→  }\n   571→\n   572→  private trackTokens(usage: TokenUsage | null, cost: number | null) {\n   573→    if (usage) {\n   574→      this.totalTokens += usage.totalTokens;\n   575→      this.inputTokens += usage.inputTokens;\n   576→      this.outputTokens += usage.outputTokens;\n   577→    }\n   578→    if (cost) {\n   579→      this.totalCost += cost;\n   580→    }\n   581→  }\n   582→\n   583→  private trackJsonTokens() {\n   584→    // Estimate for JSON generation (no search tool)\n   585→    this.totalTokens += 500;\n   586→    this.inputTokens += 300;\n   587→    this.outputTokens += 200;\n   588→    this.totalCost += 0.0001;\n   589→  }\n   590→\n   591→  private buildErrorResult(\n   592→    sessionId: string,\n   593→    query: string,\n   594→    template: string,\n   595→    errors: string[],\n   596→    startTime: number\n   597→  ): ResearchResult {\n   598→    return {\n   599→      sessionId,\n   600→      query,\n   601→      template,\n   602→      status: 'failed',\n   603→      findings: [],\n   604→      perspectives: [],\n   605→      sources: [],\n   606→      searchQueriesExecuted: [],\n   607→      costSummary: {\n   608→        totalTokens: this.totalTokens,\n   609→        inputTokens: this.inputTokens,\n   610→        outputTokens: this.outputTokens,\n   611→        geminiCostUsd: this.totalCost,\n   612→        openrouterCostUsd: 0,\n   613→        totalCostUsd: this.totalCost,\n   614→      },\n   615→      executionTimeSeconds: (Date.now() - startTime) / 1000,\n   616→      errors,\n   617→      warnings: [],\n   618→    };\n   619→  }\n   620→}\n   621→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"5a9084f5-7891-419f-a7ed-a607df0d9f02","uuid":"ce48ea6a-8624-4ede-9aea-5c213bf051a9","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\lib\\research\\research-service.ts","content":"/**\n * Research service that orchestrates deep research using Gemini with Google Search grounding.\n *\n * Features:\n * - Session persistence to Supabase for recovery\n * - Email notification on completion/failure\n * - Incremental progress tracking\n */\n\nimport { GeminiClient, Source, TokenUsage } from './gemini-client';\nimport { TEMPLATE_CONFIGS, TemplateType, generateSearchQueries, extractFindings } from './templates';\nimport { sendResearchCompletedEmail, sendResearchFailedEmail, isEmailConfigured } from './email-service';\nimport {\n  createActorSession,\n  updateActorSession,\n  saveActorFindings,\n  saveActorSources,\n  saveActorPerspectives,\n  saveActorReport,\n} from '@/src/lib/supabase';\n\nexport interface Finding {\n  findingId: string;\n  findingType: string;\n  content: string;\n  summary?: string;\n  confidenceScore: number;\n  temporalContext: string;\n  extractedData?: Record<string, unknown>;\n  supportingSources?: { url: string; title: string }[];\n}\n\nexport interface Perspective {\n  perspectiveType: string;\n  analysisText: string;\n  keyInsights: string[];\n  recommendations: string[];\n  warnings: string[];\n  confidence: number;\n}\n\nexport interface CostSummary {\n  totalTokens: number;\n  inputTokens: number;\n  outputTokens: number;\n  geminiCostUsd: number;\n  openrouterCostUsd: number;\n  totalCostUsd: number;\n}\n\nexport interface ResearchResult {\n  sessionId: string;\n  query: string;\n  template: string;\n  status: 'completed' | 'partial' | 'failed';\n  findings: Finding[];\n  perspectives: Perspective[];\n  sources: Source[];\n  searchQueriesExecuted: string[];\n  reportMarkdown?: string;\n  costSummary: CostSummary;\n  executionTimeSeconds: number;\n  errors: string[];\n  warnings: string[];\n}\n\nexport class ResearchService {\n  private client: GeminiClient;\n  private totalTokens = 0;\n  private inputTokens = 0;\n  private outputTokens = 0;\n  private totalCost = 0;\n\n  constructor(apiKey: string) {\n    this.client = new GeminiClient(apiKey);\n  }\n\n  async executeResearch(\n    query: string,\n    templateType: TemplateType = 'investigative',\n    granularity: string = 'standard',\n    maxSearches: number = 5,\n    generateReport: boolean = false,\n    reportVariant: string = 'full_report',\n    inputText?: string,\n    options?: {\n      userEmail?: string;\n      persistToDb?: boolean;\n      sendEmail?: boolean;\n    }\n  ): Promise<ResearchResult> {\n    const startTime = Date.now();\n    const sessionId = crypto.randomUUID();\n    const errors: string[] = [];\n    const warnings: string[] = [];\n\n    const persistToDb = options?.persistToDb ?? true;\n    const sendEmail = options?.sendEmail ?? !!options?.userEmail;\n    const userEmail = options?.userEmail;\n\n    this.resetTokenTracking();\n\n    const templateConfig = TEMPLATE_CONFIGS[templateType];\n\n    // Create session in database for persistence/recovery\n    if (persistToDb) {\n      try {\n        await createActorSession({\n          id: sessionId,\n          query,\n          template: templateType,\n          status: 'running',\n          granularity,\n          max_searches: maxSearches,\n          user_email: userEmail,\n          progress_phase: 'initializing',\n          progress_percent: 0,\n        });\n      } catch (e) {\n        console.warn('Failed to create session in database:', e);\n        warnings.push('Session persistence unavailable - results will not be recoverable');\n      }\n    }\n\n    try {\n      // Phase 1: Generate search queries\n      console.log('Phase 1: Generating search queries...');\n      const searchQueries = await this.generateQueries(query, templateType, maxSearches, granularity);\n\n      if (!searchQueries.length) {\n        errors.push('Failed to generate search queries');\n        return this.buildErrorResult(sessionId, query, templateType, errors, startTime);\n      }\n\n      console.log(`Generated ${searchQueries.length} search queries`);\n\n      // Phase 2: Execute grounded searches\n      console.log('Phase 2: Executing grounded web searches...');\n      if (persistToDb) {\n        await updateActorSession(sessionId, { progress_phase: 'searching', progress_percent: 20 });\n      }\n      const allSources: Source[] = [];\n      const allContent: string[] = [];\n\n      // Add input context if provided\n      if (inputText) {\n        allContent.push(`## Input Context\\n\\n${inputText}`);\n      }\n\n      for (let i = 0; i < searchQueries.length; i++) {\n        const searchQuery = searchQueries[i];\n        console.log(`  [${i + 1}/${searchQueries.length}] ${searchQuery.slice(0, 50)}...`);\n\n        // Update progress during searches\n        if (persistToDb && i % 2 === 0) {\n          const searchProgress = 20 + Math.floor((i / searchQueries.length) * 30);\n          await updateActorSession(sessionId, { progress_percent: searchProgress });\n        }\n\n        try {\n          const result = await this.client.research(searchQuery);\n          this.trackTokens(result.tokenUsage, result.costUsd);\n\n          // Collect sources\n          for (const source of result.sources) {\n            // Deduplicate by URL\n            if (!allSources.some(s => s.url === source.url)) {\n              allSources.push(source);\n            }\n          }\n\n          // Collect content\n          if (result.text) {\n            allContent.push(`## Search: ${searchQuery}\\n\\n${result.text}`);\n          }\n        } catch (e) {\n          const errorMsg = e instanceof Error ? e.message : String(e);\n          warnings.push(`Search failed for '${searchQuery.slice(0, 30)}...': ${errorMsg}`);\n          console.warn(`  Search failed: ${errorMsg}`);\n        }\n      }\n\n      console.log(`Found ${allSources.length} unique sources`);\n\n      // Phase 3: Assess source credibility\n      const sourcesWithCredibility = allSources.map(s => ({\n        ...s,\n        credibilityScore: this.assessCredibility(s.domain),\n        credibilityLabel: this.credibilityLabel(this.assessCredibility(s.domain)),\n      }));\n\n      // Phase 4: Extract findings\n      console.log('Phase 4: Extracting findings...');\n      if (persistToDb) {\n        await updateActorSession(sessionId, { progress_phase: 'extracting_findings', progress_percent: 55 });\n      }\n      const synthesizedContent = allContent.join('\\n\\n---\\n\\n');\n      const findings = await this.extractFindings(\n        query,\n        sourcesWithCredibility,\n        synthesizedContent,\n        templateType,\n        granularity\n      );\n\n      // Add IDs and supporting sources\n      findings.forEach((f, i) => {\n        f.findingId = `f${i + 1}`;\n        f.supportingSources = sourcesWithCredibility.slice(0, 3).map(s => ({\n          url: s.url,\n          title: s.title,\n        }));\n      });\n\n      console.log(`Extracted ${findings.length} findings`);\n\n      // Phase 5: Multi-perspective analysis\n      console.log('Phase 5: Running perspective analysis...');\n      if (persistToDb) {\n        await updateActorSession(sessionId, { progress_phase: 'analyzing_perspectives', progress_percent: 70 });\n      }\n      const perspectives: Perspective[] = [];\n\n      for (const perspectiveType of templateConfig.perspectives) {\n        try {\n          const analysis = await this.analyzePerspective(\n            perspectiveType,\n            findings,\n            sourcesWithCredibility,\n            query,\n            templateConfig\n          );\n          perspectives.push(analysis);\n        } catch (e) {\n          const errorMsg = e instanceof Error ? e.message : String(e);\n          warnings.push(`Perspective analysis failed for '${perspectiveType}': ${errorMsg}`);\n        }\n      }\n\n      console.log(`Generated ${perspectives.length} perspective analyses`);\n\n      // Phase 6: Generate report (optional)\n      let reportMarkdown: string | undefined;\n      if (generateReport) {\n        console.log('Phase 6: Generating report...');\n        if (persistToDb) {\n          await updateActorSession(sessionId, { progress_phase: 'generating_report', progress_percent: 90 });\n        }\n        reportMarkdown = await this.generateReport(\n          query,\n          findings,\n          perspectives,\n          sourcesWithCredibility,\n          reportVariant\n        );\n      }\n\n      const executionTime = (Date.now() - startTime) / 1000;\n\n      const result: ResearchResult = {\n        sessionId,\n        query,\n        template: templateType,\n        status: errors.length > 0 ? 'partial' : 'completed',\n        findings,\n        perspectives,\n        sources: sourcesWithCredibility,\n        searchQueriesExecuted: searchQueries,\n        reportMarkdown,\n        costSummary: {\n          totalTokens: this.totalTokens,\n          inputTokens: this.inputTokens,\n          outputTokens: this.outputTokens,\n          geminiCostUsd: this.totalCost,\n          openrouterCostUsd: 0,\n          totalCostUsd: this.totalCost,\n        },\n        executionTimeSeconds: Math.round(executionTime * 100) / 100,\n        errors,\n        warnings,\n      };\n\n      // Save results to database for recovery\n      if (persistToDb) {\n        console.log('Saving results to database...');\n        try {\n          await Promise.all([\n            saveActorFindings(sessionId, findings.map(f => ({\n              finding_id: f.findingId,\n              finding_type: f.findingType,\n              content: f.content,\n              summary: f.summary,\n              confidence_score: f.confidenceScore,\n              temporal_context: f.temporalContext,\n              extracted_data: f.extractedData,\n            }))),\n            saveActorSources(sessionId, sourcesWithCredibility.map(s => ({\n              url: s.url,\n              title: s.title,\n              domain: s.domain,\n              snippet: s.snippet,\n              credibility_score: s.credibilityScore,\n              credibility_label: s.credibilityLabel,\n            }))),\n            saveActorPerspectives(sessionId, perspectives.map(p => ({\n              perspective_type: p.perspectiveType,\n              analysis_text: p.analysisText,\n              key_insights: p.keyInsights,\n              recommendations: p.recommendations,\n              warnings: p.warnings,\n              confidence: p.confidence,\n            }))),\n          ]);\n\n          await saveActorReport(sessionId, reportMarkdown || '', {\n            total_tokens: this.totalTokens,\n            total_cost_usd: this.totalCost,\n          });\n        } catch (e) {\n          console.warn('Failed to save results to database:', e);\n          warnings.push('Failed to persist results - session may not be recoverable');\n        }\n      }\n\n      // Send email notification if configured\n      if (sendEmail && userEmail) {\n        console.log(`Sending completion email to ${userEmail}...`);\n        try {\n          const emailResult = await sendResearchCompletedEmail(userEmail, {\n            sessionId,\n            query,\n            template: templateType,\n            findingsCount: findings.length,\n            sourcesCount: sourcesWithCredibility.length,\n            perspectivesCount: perspectives.length,\n            executionTime,\n            totalCost: this.totalCost,\n            reportMarkdown,\n          });\n          if (!emailResult.success) {\n            warnings.push(`Email notification failed: ${emailResult.error}`);\n          }\n        } catch (e) {\n          console.warn('Failed to send email:', e);\n          warnings.push('Email notification failed');\n        }\n      }\n\n      return result;\n    } catch (e) {\n      const errorMsg = e instanceof Error ? e.message : String(e);\n      errors.push(errorMsg);\n\n      // Update session status to failed\n      if (persistToDb) {\n        await updateActorSession(sessionId, {\n          status: 'failed',\n          error_message: errorMsg,\n          completed_at: new Date().toISOString(),\n        });\n      }\n\n      // Send failure notification if email configured\n      if (sendEmail && userEmail) {\n        await sendResearchFailedEmail(userEmail, {\n          sessionId,\n          query,\n          errorMessage: errorMsg,\n        });\n      }\n\n      return this.buildErrorResult(sessionId, query, templateType, errors, startTime);\n    }\n  }\n\n  private async generateQueries(\n    query: string,\n    templateType: TemplateType,\n    maxSearches: number,\n    granularity: string\n  ): Promise<string[]> {\n    const prompt = generateSearchQueries(query, templateType, maxSearches, granularity);\n\n    const { data } = await this.client.generateJson<string[]>(prompt);\n    this.trackJsonTokens();\n\n    if (Array.isArray(data)) {\n      return data.slice(0, maxSearches);\n    }\n\n    // Fallback: generate basic queries\n    return [\n      `${query} latest news analysis`,\n      `${query} key facts timeline`,\n      `${query} expert analysis 2024`,\n    ].slice(0, maxSearches);\n  }\n\n  private async extractFindings(\n    query: string,\n    sources: Source[],\n    synthesizedContent: string,\n    templateType: TemplateType,\n    granularity: string\n  ): Promise<Finding[]> {\n    const prompt = extractFindings(query, sources, synthesizedContent, templateType, granularity);\n\n    const { data } = await this.client.generateJson<Array<{\n      finding_type?: string;\n      content?: string;\n      summary?: string;\n      confidence_score?: number;\n      temporal_context?: string;\n      extracted_data?: Record<string, unknown>;\n    }>>(prompt);\n\n    this.trackJsonTokens();\n\n    if (!Array.isArray(data)) return [];\n\n    return data.map(f => ({\n      findingId: '',\n      findingType: f.finding_type || 'fact',\n      content: f.content || '',\n      summary: f.summary,\n      confidenceScore: f.confidence_score || 0.5,\n      temporalContext: f.temporal_context || 'present',\n      extractedData: f.extracted_data,\n    }));\n  }\n\n  private async analyzePerspective(\n    perspectiveType: string,\n    findings: Finding[],\n    sources: Source[],\n    query: string,\n    templateConfig: typeof TEMPLATE_CONFIGS[TemplateType]\n  ): Promise<Perspective> {\n    const perspectivePrompt = templateConfig.perspectivePrompts[perspectiveType] || '';\n\n    const findingsContext = findings.slice(0, 15).map(f =>\n      `- [${f.findingType.toUpperCase()}] ${f.summary || f.content.slice(0, 200)}`\n    ).join('\\n');\n\n    const sourcesContext = sources.slice(0, 10).map(s =>\n      `- ${s.title} (${s.domain})`\n    ).join('\\n');\n\n    const prompt = `\n${perspectivePrompt}\n\nRESEARCH QUERY: ${query}\n\nKEY FINDINGS:\n${findingsContext}\n\nSOURCES CONSULTED:\n${sourcesContext}\n\nProvide your analysis as JSON:\n{\n  \"analysis_text\": \"Your detailed expert analysis (2-3 paragraphs)\",\n  \"key_insights\": [\"Insight 1\", \"Insight 2\", \"Insight 3\"],\n  \"recommendations\": [\"Recommendation 1\", \"Recommendation 2\"],\n  \"warnings\": [\"Warning or risk 1\"],\n  \"confidence\": 0.0-1.0\n}\n`;\n\n    const { data } = await this.client.generateJson<{\n      analysis_text?: string;\n      key_insights?: string[];\n      recommendations?: string[];\n      warnings?: string[];\n      confidence?: number;\n    }>(prompt);\n\n    this.trackJsonTokens();\n\n    return {\n      perspectiveType,\n      analysisText: data?.analysis_text || `Analysis from ${perspectiveType} perspective.`,\n      keyInsights: data?.key_insights || [],\n      recommendations: data?.recommendations || [],\n      warnings: data?.warnings || [],\n      confidence: data?.confidence || 0.7,\n    };\n  }\n\n  private async generateReport(\n    query: string,\n    findings: Finding[],\n    perspectives: Perspective[],\n    sources: Source[],\n    variant: string\n  ): Promise<string> {\n    const findingsText = findings.map(f =>\n      `### ${f.summary || 'Finding'}\\n- **Type**: ${f.findingType}\\n- **Confidence**: ${(f.confidenceScore * 100).toFixed(0)}%\\n\\n${f.content}`\n    ).join('\\n\\n');\n\n    const perspectivesText = perspectives.map(p =>\n      `### ${p.perspectiveType} Perspective\\n${p.analysisText}\\n\\n**Key Insights:**\\n${p.keyInsights.map(i => `- ${i}`).join('\\n')}`\n    ).join('\\n\\n');\n\n    const sourcesText = sources.slice(0, 20).map(s =>\n      `- [${s.title}](${s.url}) - ${s.domain}`\n    ).join('\\n');\n\n    const title = variant === 'executive_summary'\n      ? `Executive Summary: ${query}`\n      : variant === 'investment_thesis'\n      ? `Investment Thesis: ${query}`\n      : `Research Report: ${query}`;\n\n    return `# ${title}\n\n**Generated:** ${new Date().toISOString()}\n\n---\n\n## Executive Summary\n\nThis report presents findings from comprehensive research on: \"${query}\"\n\n## Key Findings\n\n${findingsText}\n\n## Expert Perspectives\n\n${perspectivesText}\n\n## Sources\n\n${sourcesText}\n\n---\n\n*Generated by Deep Research Actor with Gemini + Google Search grounding*\n`;\n  }\n\n  private assessCredibility(domain: string): number {\n    const d = domain.toLowerCase();\n\n    // High credibility\n    if (['gov', 'edu', 'reuters', 'ap', 'bbc', 'nytimes', 'wsj', 'ft.com', 'bloomberg', 'sec.gov'].some(h => d.includes(h))) {\n      return 0.85;\n    }\n\n    // Medium-high credibility\n    if (['forbes', 'businessinsider', 'cnbc', 'marketwatch', 'yahoo', 'cnn', 'washingtonpost'].some(h => d.includes(h))) {\n      return 0.70;\n    }\n\n    return 0.55;\n  }\n\n  private credibilityLabel(score: number): string {\n    if (score >= 0.8) return 'high';\n    if (score >= 0.6) return 'medium';\n    return 'low';\n  }\n\n  private resetTokenTracking() {\n    this.totalTokens = 0;\n    this.inputTokens = 0;\n    this.outputTokens = 0;\n    this.totalCost = 0;\n  }\n\n  private trackTokens(usage: TokenUsage | null, cost: number | null) {\n    if (usage) {\n      this.totalTokens += usage.totalTokens;\n      this.inputTokens += usage.inputTokens;\n      this.outputTokens += usage.outputTokens;\n    }\n    if (cost) {\n      this.totalCost += cost;\n    }\n  }\n\n  private trackJsonTokens() {\n    // Estimate for JSON generation (no search tool)\n    this.totalTokens += 500;\n    this.inputTokens += 300;\n    this.outputTokens += 200;\n    this.totalCost += 0.0001;\n  }\n\n  private buildErrorResult(\n    sessionId: string,\n    query: string,\n    template: string,\n    errors: string[],\n    startTime: number\n  ): ResearchResult {\n    return {\n      sessionId,\n      query,\n      template,\n      status: 'failed',\n      findings: [],\n      perspectives: [],\n      sources: [],\n      searchQueriesExecuted: [],\n      costSummary: {\n        totalTokens: this.totalTokens,\n        inputTokens: this.inputTokens,\n        outputTokens: this.outputTokens,\n        geminiCostUsd: this.totalCost,\n        openrouterCostUsd: 0,\n        totalCostUsd: this.totalCost,\n      },\n      executionTimeSeconds: (Date.now() - startTime) / 1000,\n      errors,\n      warnings: [],\n    };\n  }\n}\n","numLines":621,"startLine":1,"totalLines":621}}}
