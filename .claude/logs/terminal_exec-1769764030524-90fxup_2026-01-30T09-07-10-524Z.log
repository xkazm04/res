[2026-01-30T09:07:37.030Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VGbKx2udYkRSEbg4nwHWj5","type":"tool_result","content":"     1→\"\"\"Cache service for Cloud Run - using in-memory or Redis.\n     2→\n     3→This is a Cloud Run-compatible version that doesn't depend on Apify KV store.\n     4→For production, configure Redis using REDIS_URL environment variable.\n     5→\"\"\"\n     6→\n     7→import os\n     8→import hashlib\n     9→import logging\n    10→from typing import Dict, Any, Optional, List\n    11→from datetime import datetime\n    12→\n    13→logger = logging.getLogger(__name__)\n    14→\n    15→# In-memory cache (for single-instance deployments)\n    16→_memory_cache: Dict[str, Dict[str, Any]] = {}\n    17→\n    18→\n    19→class CacheService:\n    20→    \"\"\"\n    21→    Query-level research cache for Cloud Run.\n    22→\n    23→    Uses in-memory caching by default. For multi-instance deployments,\n    24→    configure REDIS_URL environment variable for Redis-based caching.\n    25→    \"\"\"\n    26→\n    27→    def __init__(self, cache_prefix: str = \"CACHE_\"):\n    28→        \"\"\"\n    29→        Initialize cache service.\n    30→\n    31→        Args:\n    32→            cache_prefix: Prefix for cache keys\n    33→        \"\"\"\n    34→        self.cache_prefix = cache_prefix\n    35→        self._redis = None\n    36→        self._redis_available = False\n    37→\n    38→        # Try to connect to Redis if URL is provided\n    39→        redis_url = os.getenv(\"REDIS_URL\")\n    40→        if redis_url:\n    41→            try:\n    42→                import redis\n    43→                self._redis = redis.from_url(redis_url)\n    44→                self._redis.ping()\n    45→                self._redis_available = True\n    46→                logger.info(\"Connected to Redis cache\")\n    47→            except Exception as e:\n    48→                logger.warning(f\"Redis connection failed, using in-memory cache: {e}\")\n    49→\n    50→    def get_cache_key(self, query: str, template: str, granularity: str) -> str:\n    51→        \"\"\"\n    52→        Generate cache key from normalized query.\n    53→\n    54→        Args:\n    55→            query: Research query\n    56→            template: Template type (e.g., \"tech_market\", \"financial\")\n    57→            granularity: Research depth (\"quick\", \"standard\", \"deep\")\n    58→\n    59→        Returns:\n    60→            Cache key string\n    61→        \"\"\"\n    62→        normalized = self._normalize_query(query)\n    63→        query_hash = hashlib.md5(normalized.encode()).hexdigest()[:16]\n    64→        return f\"{self.cache_prefix}{template}_{granularity}_{query_hash}\"\n    65→\n    66→    def _normalize_query(self, query: str) -> str:\n    67→        \"\"\"\n    68→        Normalize query for consistent matching.\n    69→\n    70→        Args:\n    71→            query: Raw query string\n    72→\n    73→        Returns:\n    74→            Normalized query string\n    75→        \"\"\"\n    76→        return \" \".join(query.lower().strip().split())\n    77→\n    78→    async def get_cached(self, cache_key: str) -> Optional[Dict[str, Any]]:\n    79→        \"\"\"\n    80→        Retrieve cached research result.\n    81→\n    82→        Args:\n    83→            cache_key: Cache key from get_cache_key()\n    84→\n    85→        Returns:\n    86→            Cached entry dict or None if not found\n    87→        \"\"\"\n    88→        try:\n    89→            if self._redis_available:\n    90→                import json\n    91→                cached = self._redis.get(cache_key)\n    92→                if cached:\n    93→                    logger.info(f\"Redis cache hit: {cache_key}\")\n    94→                    return json.loads(cached)\n    95→            else:\n    96→                cached = _memory_cache.get(cache_key)\n    97→                if cached:\n    98→                