48→                logger.info(f\"Cached to memory: {cache_key}\")\n   149→\n   150→            return True\n   151→        except Exception as e:\n   152→            logger.warning(f\"Cache write error: {e}\")\n   153→            return False\n   154→\n   155→    async def update_access(self, cache_key: str) -> bool:\n   156→        \"\"\"\n   157→        Update access count and timestamp for cached entry.\n   158→\n   159→        Args:\n   160→            cache_key: Cache key\n   161→\n   162→        Returns:\n   163→            True if updated successfully\n   164→        \"\"\"\n   165→        try:\n   166→            if self._redis_available:\n   167→                import json\n   168→                cached = self._redis.get(cache_key)\n   169→                if cached:\n   170→                    data = json.loads(cached)\n   171→                    data[\"access_count\"] = data.get(\"access_count\", 0) + 1\n   172→                    data[\"last_accessed\"] = datetime.utcnow().isoformat()\n   173→                    ttl = self._redis.ttl(cache_key)\n   174→                    if ttl > 0:\n   175→                        self._redis.setex(cache_key, ttl, json.dumps(data))\n   176→                    return True\n   177→            else:\n   178→                if cache_key in _memory_cache:\n   179→                    _memory_cache[cache_key][\"access_count\"] = \\\n   180→                        _memory_cache[cache_key].get(\"access_count\", 0) + 1\n   181→                    _memory_cache[cache_key][\"last_accessed\"] = \\\n   182→                        datetime.utcnow().isoformat()\n   183→                    return True\n   184→            return False\n   185→        except Exception as e:\n   186→            logger.warning(f\"Cache update error: {e}\")\n   187→            return False\n   188→\n   189→    async def extend_cached(\n   190→        self,\n   191→        cache_key: str,\n   192→        new_findings: List[Dict[str, Any]],\n   193→        new