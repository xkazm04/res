ompt ? `${systemPrompt}\\n\\n${query}` : query;\n    57→\n    58→    const response = await this.ai.generate({\n    59→      model: googleAI.model(this.modelName),\n    60→      prompt: fullPrompt,\n    61→      config: {\n    62→        googleSearchRetrieval: true,\n    63→        temperature: 0.3,\n    64→        maxOutputTokens: 4096,\n    65→      },\n    66→    });\n    67→\n    68→    const text = response.text;\n    69→\n    70→    // Extract sources from grounding metadata\n    71→    const sources: Source[] = [];\n    72→    const searchQueries: string[] = [];\n    73→\n    74→    // Access grounding metadata from custom response\n    75→    // eslint-disable-next-line @typescript-eslint/no-explicit-any\n    76→    const customResponse = response.custom as any;\n    77→    const groundingMetadata = customResponse?.candidates?.[0]?.groundingMetadata;\n    78→\n    79→    if (groundingMetadata) {\n    80→      // Extract search queries\n    81→      if (groundingMetadata.webSearchQueries) {\n    82→        searchQueries.push(...groundingMetadata.webSearchQueries);\n    83→      }\n    84→\n    85→      // Extract grounding chunks (sources)\n    86→      if (groundingMetadata.groundingChunks) {\n    87→        for (const chunk of groundingMetadata.groundingChunks) {\n    88→          if (chunk.web) {\n    89→            const url = chunk.web.uri || '';\n    90→            const title = chunk.web.title || '';\n    91→            let domain = '';\n    92→\n    93→            try {\n    94→              domain = new URL(url).hostname;\n    95→            } catch {\n    96→              domain = title;\n    97→            }\n    98→\n    99→            sources.push({\n   100→              url,\n   101→              title,\n   102→              domain,\n   103→              snippet: '',\n   104→              sourceType: 'web',\n   105→            });\n   106→          }\n   107→        }\n   108→      }\n   109→    }\n   110→\n   111→    // Get token usage from response metadata\n   112→    const usageMetadata = customResponse?.usageMetadata;\n   113→    const tokenUsage: TokenUsage | null = usageMetadata ? {\n   114→      inputTokens: usageMetadata.promptTokenCount || 0,\n   115→      outputTokens: usageMetadata.candidatesTokenCount || 0,\n   116→      totalTokens: usageMetadata.totalTokenCount || 0,\n   117→    } : null;\n   118→\n   119→    // Calculate cost\n   120→    const costUsd = this.estimateCost(tokenUsage);\n   121→\n   122→    return {\n   123→      text,\n   124→      sources,\n   125→      searchQueries,\n   126→      tokenUsage,\n   127→      costUsd,\n   128→    };\n   129→  }\n   130→\n   131→  async generateJson<T>(prompt: string, systemPrompt?: string): Promise<{ data: T | null; response: ResearchResponse }> {\n   132→    const fullPrompt = systemPrompt ? `${systemPrompt}\\n\\n${prompt}` : prompt;\n   133→\n   134→    const response = await this.ai.generate({\n   135→      model: googleAI.model(this.modelName),\n   136→      prompt: fullPrompt,\n   137→      config: {\n   138→        temperature: 0.3,\n   139→      },\n   140→      output: {\n   141→        format: 'json',\n   142→      },\n   143→    });\n   144→\n   145→    const text = response.text;\n   146→\n   147→    // eslint-disable-next-line @typescript-eslint/no-explicit-any\n   148→    const customResponse = response.custom as any;\n   149→    const usageMetadata = customResponse?.usageMetadata;\n   150→    const tokenUsage: TokenUsage | null = usageMetadata ? {\n   151→      inputTokens: usageMetadata.promptTokenCount || 0,\n   152→      outputTokens: usageMetadata.candidatesTokenCount || 0,\n   153→      totalTokens: usageMetadata.totalTokenCount || 0,\n   154→    } : null;\n   155→\n   156→    // Parse JSON\n   157→    let data: T | null = null;\n   158→    try {\n   159→      data = JSON.parse(text);\n   160→    } catch {\n   161→      // Try extracting from code blocks\n   162→      const match = text.match(/```(?:json)?\\s*\\n?([\\s\\S]*?)\\n?```/);\n   163→      if (match) {\n   164→        try {\n   165→          data = JSON.parse(match[1]);\n   166→        } catch {\n   167→          // Fallback: try finding JSON array or object\n   168→          const jsonMatch = text.match(/[\\[{][\\s\\S]*[\\]}]/);\n   169→          if (jsonMatch) {\n   170→            try {\n   171→              data = JSON.parse(jsonMatch[0]);\n   172→            } catch {\n   173→              console.warn('Failed to parse JSON from response');\n   174→            }\n   175→          }\n   176→        }\n   177→      }\n   178→    }\n   179→\n   180→    return {\n   181→      data,\n   182→      response: {\n   183→        text,\n   184→        sources: [],\n   185→        searchQueries: [],\n   186→        tokenUsage,\n   187→        costUsd: this.estimateCost(tokenUsage),\n   188→      },\n   189→    };\n   190→  }\n   191→\n   192→  private estimateCost(tokenUsage: TokenUsage | null): number | null {\n   193→    if (!tokenUsage) return null;\n   194→\n   195→    const rates = COST_RATES[this.modelName] || { input: 0.075, output: 0.30 };\n   196→    const inputCost = (tokenUsage.inputTokens / 1_000_000) * rates.input;\n   197→    const outputCost = (tokenUsage.outputTokens / 1_000_000) * rates.output;\n   198→\n   199→    return inputCost + outputCost;\n   200→  }\n   201→}\n   202→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"5a9084f5-7891-419f-a7ed-a607df0d9f02","uuid":"de965714-e669-40fa-8510-649bf1649d0d","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\lib\\research\\gemini-client.ts","content":"/**\n * Gemini client with Google Search grounding using Genkit.\n *\n * Uses @genkit-ai/googleai for Gemini models with built-in\n * web search grounding capabilities.\n */\n\nimport { genkit, z } from 'genkit';\nimport { googleAI } from '@genkit-ai/googleai';\n\nexport interface Source {\n  url: string;\n  title: string;\n  domain: string;\n  snippet: string;\n  sourceType: string;\n}\n\nexport interface TokenUsage {\n  inputTokens: number;\n  outputTokens: number;\n  totalTokens: number;\n}\n\nexport interface ResearchResponse {\n  text: string;\n  sources: Source[];\n  searchQueries: string[];\n  tokenUsage: TokenUsage | null;\n  costUsd: number | null;\n}\n\nconst COST_RATES: Record<string, { input: number; output: number }> = {\n  'gemini-2.0-flash': { input: 0.075, output: 0.30 },\n  'gemini-2.5-flash': { input: 0.15, output: 0.60 },\n  'gemini-1.5-flash': { input: 0.075, output: 0.30 },\n  'gemini-1.5-pro': { input: 1.25, output: 5.00 },\n};\n\nexport class GeminiClient {\n  private ai: ReturnType<typeof genkit>;\n  private modelName: string;\n\n  constructor(apiKey: string, modelName: string = 'gemini-2.0-flash') {\n    this.modelName = modelName;\n\n    // Initialize Genkit with Google AI plugin\n    this.ai = genkit({\n      plugins: [\n        googleAI({ apiKey }),\n      ],\n    });\n  }\n\n  async research(query: string, systemPrompt?: string): Promise<ResearchResponse> {\n    const fullPrompt = systemPrompt ? `${systemPrompt}\\n\\n${query}` : query;\n\n    const response = await this.ai.generate({\n      model: googleAI.model(this.modelName),\n      prompt: fullPrompt,\n      config: {\n        googleSearchRetrieval: true,\n        temperature: 0.3,\n        maxOutputTokens: 4096,\n      },\n    });\n\n    const text = response.text;\n\n    // Extract sources from grounding metadata\n    const sources: Source[] = [];\n    const searchQueries: string[] = [];\n\n    // Access grounding metadata from custom response\n    // eslint-disable-next-line @typescript-eslint/no-explicit-any\n    const customResponse = response.custom as any;\n    const groundingMetadata = customResponse?.candidates?.[0]?.groundingMetadata;\n\n    if (groundingMetadata) {\n      // Extract search queries\n      if (groundingMetadata.webSearchQueries) {\n        searchQueries.push(...groundingMetadata.webSearchQueries);\n      }\n\n      // Extract grounding chunks (sources)\n      if (groundingMetadata.groundingChunks) {\n        for (const chunk of groundingMetadata.groundingChunks) {\n          if (chunk.web) {\n            const url = chunk.web.uri || '';\n            const title = chunk.web.title || '';\n            let domain = '';\n\n            try {\n              domain = new URL(url).hostname;\n            } catch {\n              domain = title;\n            }\n\n            sources.push({\n              url,\n              title,\n              domain,\n              snippet: '',\n              sourceType: 'web',\n            });\n          }\n        }\n      }\n    }\n\n    // Get token usage from response metadata\n    const usageMetadata = customResponse?.usageMetadata;\n    const tokenUsage: TokenUsage | null = usageMetadata ? {\n      inputTokens: usageMetadata.promptTokenCount || 0,\n      outputTokens: usageMetadata.candidatesTokenCount || 0,\n      totalTokens: usageMetadata.totalTokenCount || 0,\n    } : null;\n\n    // Calculate cost\n    const costUsd = this.estimateCost(tokenUsage);\n\n    return {\n      text,\n      sources,\n      searchQueries,\n      tokenUsage,\n      costUsd,\n    };\n  }\n\n  async generateJson<T>(prompt: string, systemPrompt?: string): Promise<{ data: T | null; response: ResearchResponse }> {\n    const fullPrompt = systemPrompt ? `${systemPrompt}\\n\\n${prompt}` : prompt;\n\n    const response = await this.ai.generate({\n      model: googleAI.model(this.modelName),\n      prompt: fullPrompt,\n      config: {\n        temperature: 0.3,\n      },\n      output: {\n        format: 'json',\n      },\n    });\n\n    const text = response.text;\n\n    // eslint-disable-next-line @typescript-eslint/no-explicit-any\n    const customResponse = response.custom as any;\n    const usageMetadata = customResponse?.usageMetadata;\n    const tokenUsage: TokenUsage | null = usageMetadata ? {\n      inputTokens: usageMetadata.promptTokenCount || 0,\n      outputTokens: usageMetadata.candidatesTokenCount || 0,\n      totalTokens: usageMetadata.totalTokenCount || 0,\n    } : null;\n\n    // Parse JSON\n    let data: T | null = null;\n    try {\n      data = JSON.parse(text);\n    } catch {\n      // Try extracting from code blocks\n      const match = text.match(/```(?:json)?\\s*\\n?([\\s\\S]*?)\\n?```/);\n      if (match) {\n        try {\n          data = JSON.parse(match[1]);\n        } catch {\n          // Fallback: try finding JSON array or object\n          const jsonMatch = text.match(/[\\[{][\\s\\S]*[\\]}]/);\n          if (jsonMatch) {\n            try {\n              data = JSON.parse(jsonMatch[0]);\n            } catch {\n              console.warn('Failed to parse JSON from response');\n            }\n          }\n        }\n      }\n    }\n\n    return {\n      data,\n      response: {\n        text,\n        sources: [],\n        searchQueries: [],\n        tokenUsage,\n        costUsd: this.estimateCost(tokenUsage),\n      },\n    };\n  }\n\n  private estimateCost(tokenUsage: TokenUsage | null): number | null {\n    if (!tokenUsage) return null;\n\n    const rates = COST_RATES[this.modelName] || { input: 0.075, output: 0.30 };\n    const inputCost = (tokenUsage.inputTokens / 1_000_000) * rates.input;\n    const outputCost = (tokenUsage.outputTokens / 1_000_000) * rates.output;\n\n    return inputCost + outputCost;\n  }\n}\n","numLines":202,"startLine":1,"totalLines":202}}}
