onfidenceExplanation(BaseModel):\n    55→    \"\"\"Structured explanation of how confidence was calculated using Bayesian inference.\n    56→\n    57→    This provides interpretable and actionable confidence scores:\n    58→    - Shows the evidence chain that led to the confidence score\n    59→    - Explains what would increase or decrease confidence\n    60→    - Uses proper probability theory (not ad-hoc adjustments)\n    61→    \"\"\"\n    62→\n    63→    base_confidence: float = 0.5  # Initial confidence from extraction\n    64→    final_confidence: float = 0.5  # After Bayesian updates\n    65→    summary: str = \"\"  # Human-readable summary of confidence reasoning\n    66→\n    67→    # Evidence chain showing how confidence was updated\n    68→    evidence_chain: List[Dict[str, Any]] = Field(default_factory=list)\n    69→\n    70→    # Actionable insights\n    71→    what_would_increase: List[str] = Field(default_factory=list)\n    72→    what_would_decrease: List[str] = Field(default_factory=list)\n    73→\n    74→\n    75→class Finding(BaseModel):\n    76→    \"\"\"An extracted finding from research.\"\"\"\n    77→\n    78→    finding_id: str\n    79→    finding_type: str  # fact, event, actor, relationship, financial, evidence, pattern, gap\n    80→    content: str\n    81→    summary: Optional[str] = None\n    82→    confidence_score: float = 0.5\n    83→    temporal_context: str = \"present\"  # past, present, ongoing, prediction\n    84→    extracted_data: Optional[Dict[str, Any]] = None\n    85→    supporting_sources: List[Dict[str, str]] = Field(default_factory=list)\n    86→\n    87→    # Date information extracted from finding\n    88→    date_referenced: Optional[str] = None  # Specific date (e.g., \"2024-12-15\", \"December 2024\")\n    89→    date_range: Optional[str] = None  # Date range (e.g., \"Q4 2024\", \"2024-2025\")\n    90→\n    91→    # Bayesian confidence (replaces simple adjusted_confidence)\n    92→    # These fields provide interpre