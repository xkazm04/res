[2026-01-30T09:08:03.300Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KYdthLQP9TBXQhKXerVBmb","type":"tool_result","content":"     1→\"\"\"Actor input schema with validation.\"\"\"\n     2→\n     3→from typing import List, Optional\n     4→from pydantic import BaseModel, Field\n     5→\n     6→\n     7→class ActorInput(BaseModel):\n     8→    \"\"\"Input parameters for the Deep Research Actor.\"\"\"\n     9→\n    10→    # === USER-FACING PARAMETERS ===\n    11→\n    12→    # Core research\n    13→    query: str = Field(..., description=\"Research question (required)\")\n    14→    template: str = Field(\n    15→        default=\"tech_market\",\n    16→        description=\"Research template: competitive | contract | due_diligence | financial | investigative | legal | purchase_decision | reputation | tech_market | understanding\"\n    17→    )\n    18→    granularity: str = Field(\n    19→        default=\"standard\",\n    20→        description=\"Research depth: quick | standard | deep\"\n    21→    )\n    22→    intent: Optional[str] = Field(\n    23→        default=None,\n    24→        description=\"Requestor's decision intent: investment_sizing | entry_exit_timing | risk_assessment | due_diligence | education. When specified, research depth and focus are tailored to the decision context. Investment_sizing requires full bull/bear cases with position recommendations. Entry_exit_timing focuses on catalysts and timing signals. Risk_assessment emphasizes downside scenarios and kill criteria. Due_diligence prioritizes verification and red flags. Education provides broader context without action recommendations.\"\n    25→    )\n    26→\n    27→    # Document input (optional)\n    28→    input_file_url: Optional[str] = Field(\n    29→        default=None,\n    30→        description=\"URL to PDF/text file for context\"\n    31→    )\n    32→    input_text: Optional[str] = Field(\n    33→        default=None,\n    34→        description=\"Direct text context\"\n    35→    )\n    36→\n    37→    # Report generation\n    38→    generate_report: bool = Field(\n    39→        default=True,\n    40→        description=\"Whether to generate formatted report\"\n    41→    )\n    42→    report_variant: str = Field(\n    43→        default=\"full_report\",\n    44→        description=\"Report type (auto-selected based on template): full_report | executive_summary | investment_thesis | risk_summary | buyer_guide | trust_report | credibility_report\"\n    45→    )\n    46→    report_format: str = Field(\n    47→        default=\"html\",\n    48→        description=\"Report format: html | markdown | pdf | docx\"\n    49→    )\n    50→\n    51→    # Export options (for extended formats)\n    52→    export_options: Optional[dict] = Field(\n    53→        default=None,\n    54→        description=\"Format-specific export options (company_name, logo_url, colors, etc.)\"\n    55→    )\n    56→\n    57→    # === INTERNAL PARAMETERS (not exposed in UI) ===\n    58→\n    59→    # Expert perspectives - uses template defaults if not specified\n    60→    perspectives: Optional[List[str]] = Field(\n    61→        default=None,\n    62→        description=\"Override default perspectives for analysis\"\n    63→    )\n    64→\n    65→    # Report title - auto-generated from query if not specified\n    66→    report_title: Optional[str] = Field(\n    67→        default=None,\n    68→        description=\"Custom report title (auto-generated if not provided)\"\n    69→    )\n    70→\n    71→    # Database options - disabled by default for Apify\n    72→    save_to_supabase: bool = Field(\n    73→        default=False,\n    74→        description=\"Whether to save results to Supabase\"\n    75→    )\n    76→    workspace_id: str = Field(\n    77→        default=\"apify\",\n    78→        description=\"Workspace identifier for storage\"\n    79→    )\n    80→\n    81→    # Email delivery (optional, non-blocking)\n    82→    send_email: bool = Field(\n    83→        default=False,\n    84→        description=\"Send research report via email when complete\"\n    85→    )\n    86→    email_to: Optional[str] = Field(\n    87→        default=None,\n    88→        description=\"Recipient email address\"\n    89→    )\n    90→    email_subject: Optional[str] = Field(\n    91→        default=None,\n    92→        description=\"Custom email subject (auto-generated if not provided)\"\n    93→    )\n    94→\n    95→    # Webhook for real-time progress events\n    96→    progress_webhook_url: Optional[str] = Field(\n    97→        default=None,\n    98→        description=\"URL to receive real-time progress events via HTTP POST\"\n    99→    )\n   100→\n   101→    # Cache control\n   102→    use_cache: bool = Field(\n   103→        default=True,\n   104→        description=\"Use cached results for identical queries (saves cost)\"\n   105→    )\n   106→    extend_cache: bool = Field(\n   107→        default=True,\n   108→        description=\"Extend cached results with new findings in background\"\n   109→    )\n   110→\n   111→    # Cloud Run dispatch (cost optimization)\n   112→    use_cloud_run: bool = Field(\n   113→        default=True,\n   114→        description=\"Use Cloud Run for research (reduces Apify compute costs)\"\n   115→    )\n   116→    cloud_run_url: Optional[str] = Field(\n   117→        default=None,\n   118→        description=\"Cloud Run service URL (from env var CLOUD_RUN_URL)\"\n   119→    )\n   120→\n   121→    # API keys - always from environment variables\n   122→    google_api_key: Optional[str] = Field(\n   123→        default=None,\n   124→        description=\"Google API key for Gemini (from env var GOOGLE_API_KEY)\"\n   125→    )\n   126→    openrouter_api_key: Optional[str] = Field(\n   127→        default=None,\n   128→        description=\"OpenRouter API key for OCR (from env var OPENROUTER_API_KEY)\"\n   129→    )\n   130→    resend_api_key: Optional[str] = Field(\n   131→        default=None,\n   132→        description=\"Resend API key for email delivery (from env var RESEND_API_KEY)\"\n   133→    )\n   134→    supabase_url: Optional[str] = Field(\n   135→        default=None,\n   136→        description=\"Supabase project URL (from env var SUPABASE_URL)\"\n   137→    )\n   138→    supabase_key: Optional[str] = Field(\n   139→        default=None,\n   140→        description=\"Supabase anon key (from env var SUPABASE_KEY)\"\n   141→    )\n   142→\n   143→    # Limits - set based on granularity\n   144→    max_searches: Optional[int] = Field(\n   145→        default=None,\n   146→        ge=1,\n   147→        le=15,\n   148→        description=\"Maximum web searches (auto-set based on granularity)\"\n   149→    )\n   150→    max_sources_per_search: int = Field(\n   151→        default=10,\n   152→        ge=1,\n   153→        le=20,\n   154→        description=\"Max sources per search\"\n   155→    )\n   156→\n   157→    def get_max_searches(self) -> int:\n   158→        \"\"\"Get max searches based on granularity if not explicitly set.\"\"\"\n   159→        if self.max_searches is not None:\n   160→            return self.max_searches\n   161→\n   162→        granularity_defaults = {\n   163→            \"quick\": 4,\n   164→            \"standard\": 8,\n   165→            \"deep\": 12,\n   166→        }\n   167→        return granularity_defaults.get(self.granularity, 8)\n   168→\n   169→    def get_report_title(self) -> str:\n   170→        \"\"\"Get report title, auto-generating from query if not set.\"\"\"\n   171→        if self.report_title:\n   172→            return self.report_title\n   173→\n   174→        # Auto-generate from query\n   175→        title = self.query[:80]\n   176→        if len(self.query) > 80:\n   177→            title += \"...\"\n   178→        return f\"Research: {title}\"\n   179→\n   180→    def get_intent_config(self) -> dict:\n   181→        \"\"\"Get research configuration based on