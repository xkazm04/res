[2026-01-30T09:07:26.745Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Kn8KA1vBnKSRWn4vbakKYq","type":"tool_result","content":"     1→/**\n     2→ * Email service for sending research results as backup.\n     3→ *\n     4→ * Uses Resend for reliable email delivery when research completes\n     5→ * or when connection is lost and results need to be delivered.\n     6→ */\n     7→\n     8→import { Resend } from 'resend';\n     9→\n    10→const resend = process.env.RESEND_API_KEY ? new Resend(process.env.RESEND_API_KEY) : null;\n    11→\n    12→export interface ResearchEmailData {\n    13→  sessionId: string;\n    14→  query: string;\n    15→  template: string;\n    16→  findingsCount: number;\n    17→  sourcesCount: number;\n    18→  perspectivesCount: number;\n    19→  executionTime: number;\n    20→  totalCost: number;\n    21→  reportMarkdown?: string;\n    22→  appUrl?: string;\n    23→}\n    24→\n    25→export async function sendResearchCompletedEmail(\n    26→  to: string,\n    27→  data: ResearchEmailData\n    28→): Promise<{ success: boolean; error?: string }> {\n    29→  if (!resend) {\n    30→    console.warn('Email service not configured - RESEND_API_KEY not set');\n    31→    return { success: false, error: 'Email service not configured' };\n    32→  }\n    33→\n    34→  const appUrl = data.appUrl || process.env.NEXT_PUBLIC_APP_URL || 'http://localhost:3000';\n    35→  const sessionUrl = `${appUrl}/actor/results/${data.sessionId}`;\n    36→\n    37→  const htmlContent = `\n    38→<!DOCTYPE html>\n    39→<html>\n    40→<head>\n    41→  <style>\n    42→    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; line-height: 1.6; color: #333; }\n    43→    .container { max-width: 600px; margin: 0 auto; padding: 20px; }\n    44→    .header { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 30px; border-radius: 8px 8px 0 0; }\n    45→    .header h1 { color: white; marg