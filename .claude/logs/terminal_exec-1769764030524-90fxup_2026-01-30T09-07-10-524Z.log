[2026-01-30T09:07:46.559Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01R4q4H2Fo8eY8ov6Uz6Y3mW","type":"tool_result","content":"     1→\"\"\"Deep Research Actor - Main entry point.\n     2→\n     3→This actor performs AI-powered deep research using Gemini with Google Search grounding.\n     4→\"\"\"\n     5→\n     6→import asyncio\n     7→import base64\n     8→import logging\n     9→import os\n    10→from datetime import datetime\n    11→from typing import Optional\n    12→\n    13→from .config import override_settings, get_settings\n    14→from .schemas import ActorInput, ActorOutput, ExecutiveSummary, Finding, Source, Perspective, Prediction, CostSummary\n    15→from .clients import GeminiClient, OpenRouterClient, SupabaseClient, ResendClient, CloudRunClient, R2Client\n    16→from .services import OCRService, ResearchService, ReportService, ProgressEmitter, StateManager\n    17→from .services.transform import transform_research_result\n    18→\n    19→\n    20→# Auto-select best report variant for each template\n    21→TEMPLATE_REPORT_VARIANTS = {\n    22→    \"tech_market\": \"full_report\",\n    23→    \"financial\": \"investment_thesis\",\n    24→    \"competitive\": \"full_report\",\n    25→    \"investigative\": \"full_report\",\n    26→    \"legal\": \"full_report\",\n    27→    \"contract\": \"decision_brief\",\n    28→    \"understanding\": \"credibility_report\",\n    29→    \"due_diligence\": \"risk_summary\",\n    30→    \"purchase_decision\": \"buyer_guide\",\n    31→    \"reputation\": \"trust_report\",\n    32→}\n    33→\n    34→\n    35→def get_report_variant_for_template(template: str) -> str:\n    36→    \"\"\"Get the best report variant for a given template.\"\"\"\n    37→    return TEMPLATE_REPORT_VARIANTS.get(template, \"full_report\")\n    38→\n    39→# Configure logging\n    40→logging.basicConfig(\n    41→    level=logging.INFO,\n    42→    format=\"%(asctime)s [%(levelname)s] %(name)s: %(message)s\"\n    43→)\n    44→logger = logging.getLogger(__name__)\n    45→\n    46→\n    47→def build_executive_summary(output: ActorOutput) -> ExecutiveSummary:\n    48→    \"\"\"Build executive summary from actor output.\"\"\"\n    49→    # Count high confidence findings\n    50→    high_conf_findings = [f for f in output.findings if f.confidence_score >= 0.8]\n    51→\n    52→    # Count high credibility sources\n    53→    high_cred_sources = [s for s in output.sources if s.credibility_score and s.credibility_score >= 0.8]\n    54→\n    55→    # Get top 5 findings by confidence\n    56→    sorted_findings = sorted(output.findings, key=lambda f: f.confidence_score, reverse=True)\n    57→    top_findings = [\n    58→        f.summary or f.content[:100] + \"...\" if len(f.content) > 100 else f.content\n    59→        for f in sorted_findings[:5]\n    60→    ]\n    61→\n    62→    # Aggregate expert recommendations, warnings, insights\n    63→    all_recommendations = []\n    64→    all_warnings = []\n    65→    all_insights = []\n    66→\n    67→    for p in output.perspectives:\n    68→        all_recommendations.extend(p.recommendations[:2])  # Top 2 per perspective\n    69→        all_warnings.extend(p.warnings[:1])  # Top 1 per perspective\n    70→        all_insights.extend(p.key_insights[:2])  # Top 2 per perspective\n    71→\n    72→    # Deduplicate and limit\n    73→    seen_recs = set()\n    74→    unique_recommendations = []\n    75→    for r in all_recommendations:\n    76→        if r.lower() not in seen_recs:\n    77→            seen_recs.add(r.lower())\n    78→            unique_recommendations.append(r)\n    79→            if len(unique_recommendations) >= 5:\n    80→                break\n    81→\n    82→    seen_warnings = set()\n    83→    unique_warnings = []\n    84→    for w in all_warnings:\n    85→        if w.lower() not in seen_warnings:\n    86→            seen_warnings.add(w.lower())\n    87→            unique_warnings.append(w)\n    88→            if len(unique_warnings) >= 3:\n    89→                break\n    90→\n    91→    seen_insights = set()\n    92→    unique_insights = []\n    93→    for i in all_insights:\n    94→        if i.lower() not in seen_insights:\n    95→            seen_insights.add(i.lower())\n    96→            unique_insights.append(i)\n    97→            if len(unique_insights) >= 5:\n    98→                break\n    99→\n   100→    # Report preview\n   101→    report_preview = \"\"\n   102→    if output.report_markdown:\n   103→        report_preview = output.report_markdown[:500]\n   104→        if len(output.report_markdown) > 500:\n   105→            report_preview += \"...\"\n   106→\n   107→    return ExecutiveSummary(\n   108→        session_id=output.session_id,\n   109→        query=output.query,\n   110→        template=output.template,\n   111→        status=output.status,\n   112→        findings_count=len(output.findings),\n   113→        high_confidence_findings=len(high_conf_findings),\n   114→        sources_count=len(output.sources),\n   115→        high_credibility_sources=len(high_cred_sources),\n   116→        perspectives_count=len(output.perspectives),\n   117→        top_findings=top_findings,\n   118→        expert_recommendations=unique_recommendations,\n   119→        expert_warnings=unique_warnings,\n   120→        key_insights=unique_insights,\n   121→        report_preview=report_preview,\n   122→        total_cost_usd=output.cost_summary.total_cost_usd,\n   123→        execution_time_seconds=output.execution_time_seconds,\n   124→        completed_at=output.completed_at,\n   125→    )\n   126→\n   127→\n   128→async def run_actor(\n   129→    actor_input: ActorInput,\n   130→    progress_emitter: Optional[ProgressEmitter] = None,\n   131→) -> ActorOutput:\n   132→    \"\"\"\n   133→    Execute the Deep Research Actor.\n   134→\n   135→    Args:\n   136→        actor_input: Validated input parameters\n   137→        progress_emitter: Optional unified progress emitter for status and webhook events\n   138→\n   139→    Returns:\n   140→        ActorOutput with research results\n   141→    \"\"\"\n   142→    started_at = datetime.utcnow()\n   143→    logger.info(f\"Starting research: {actor_input.query[:50]}...\")\n   144→\n   145→    # Get settings with overrides\n   146→    settings = override_settings(\n   147→        google_api_key=actor_input.google_api_key,\n   148→        openrouter_api_key=actor_input.openrouter_api_key,\n   149→        supabase_url=actor_input.supabase_url,\n   150→        supabase_key=actor_input.supabase_key,\n   151→        resend_api_key=actor_input.resend_api_key,\n   152→        cloud_run_url=actor_input.cloud_run_url,\n   153→    )\n   154→\n   155→    # Validate required API key\n   156→    if not settings.google_api_key:\n   157→        return ActorOutput(\n   158→            session_id=\"error\",\n   159→            query=actor_input.query,\n   160→            template=actor_input.template,\n   161→            status=\"failed\",\n   162→            errors=[\"Google API key is required. Set GOOGLE_API_KEY env var or provide in input.\"],\n   163→            started_at=started_at,\n   164→            completed_at=datetime.utcnow(),\n   165→        )\n   166→\n   167→    \n   168→    # === CLOUD RUN DISPATCH (fire-and-forget mode) ===\n   169→    # Dispatch to Cloud Run and return immediately - Cloud Run handles everything\n   170→    if settings.cloud_run_url:\n   171→        logger.info(f\"Dispatching to Cloud Run (fire-and-forget): {settings.cloud_run_url}\")\n   172→\n   173→        try:\n   174→            # Initialize R2 client for report storage (if configured)\n   175→            r2_client = None\n   176→            report_url = None\n   177→            job_id = None\n   178→\n   179→            if settings.r2_account_id and settings.r2_access_key_id and settings.r2_secret_access_key:\n   180→                try:\n   181→                    r2_client = R2Client(\n   182→                        account_id=settings.r2_account_id,\n   183→                        access_key_id=settings.r2_access_key_id,\n   184→                        secret_access_key=settings.r2_secret_access_key,\n   185→                        bucket_name=settings.r2_bucket_name,\n   186→                        public_url_base=settings.r2_public_url or None,\n   187→                    )\n   188→\n   189→                    # Generate job_id and upload placeholder\n   190→                    job_id = r2_client.generate_job_id(actor_input.query, actor_input.template)\n   191→                    report_url = r2_client.upload_placeholder(\n   192→                        job_id=job_id,\n   193→                        query=actor_input.query,\n   194→                        template=actor_input.template,\n   195→                    )\n   196→                    logger.info(f\"Placeholder uploaded to R2: {report_url}\")\n   197→\n   198→                except Exception as e:\n   199→                    logger.warning(f\"R2 placeholder upload failed (continuing without): {e}\")\n   200→                    r2_client = None\n   201→\n   202→            cloud_run_client = CloudRunClient(\n   203→                service_url=settings.cloud_run_url,\n   204→                dispatch_timeout=15,  # Short timeout for acknowledgment only\n   205→            )\n   206→\n   207→            # Auto-select best report variant for template\n   208→            report_variant = get_report_variant_for_template(actor_input.template)\n   209→\n   210→            # Fire-and-forget dispatch - Cloud Run handles research, report, email, R2 upload\n   211→            dispatch_result = await cloud_run_client.dispatch_async(\n   212→                query=actor_input.query,\n   213→                template=actor_input.template,\n   214→                granularity=actor_input.granularity,\n   215→                max_searches=actor_input.get_max_searches(),\n   216→                perspectives=actor_input.perspectives,\n   217→                input_file_url=actor_input.input_file_url,\n   218→                input_text=actor_input.input_text,\n   219→                workspace_id=actor_input.workspace_id,\n   220→                gemini_api_key=settings.google_api_key,\n   221→                supabase_url=settings.supabase_url,\n   222→                supabase_key=settings.supabase_key,\n   223→                resend_api_key=settings.resend_api_key,\n   224→                # Report options\n   225→                generate_report=actor_input.generate_report,\n   226→                report_format=actor_input.report_format,\n   227→                report_variant=report_variant,\n   228→                report_title=actor_input.report_title,\n   229→                # Email options\n   230→                send_email=actor_input.send_email,\n   231→                email_to=actor_input.email_to,\n   232→                email_subject=actor_input.email_subject,\n   233→                # Progress webhook\n   234→                callback_url=actor_input.progress_webhook_url,\n   235→                # R2 config for Cloud Run to upload final report\n   236→                r2_job_id=job_id,\n   237→                r2_account_id=settings.r2_account_id if r2_client else None,\n   238→                r2_access_key_id=settings.r2_access_key_id if r2_client else None,\n   239→                r2_secret_access_key=settings.r2_secret_access_key if r2_client else None,\n   240→                r2_bucket_name=settings.r2_bucket_name if r2_client else None,\n   241→                r2_public_url=settings.r2_public_url if r2_client else None,\n   242→            )\n   243→\n   244→            await cloud_run_client.close()\n   245→\n   246→            # Use job_id from R2 if available, otherwise from dispatch result\n   247→            final_job_id = job_id or dispatch_result.get(\"job_id\", \"unknown\")\n   248→            logger.info(f\"Cloud Run job dispatched: {final_job_id}\")\n   249→\n   250→            # Return immediately with dispatched status and report URL\n   251→            return ActorOutput(\n   252→                session_id=final_job_id,\n   253→                query=actor_input.query,\n   254→                template=actor_input.template,\n   255→                status=\"processing\",  # More accurate than \"dispatched\"\n   256→                findings=[],\n   257→                perspectives=[],\n   258→                sources=[],\n   259→                search_queries_executed=[],\n   260→                report_markdown=None,\n   261→                report_html=None,\n   262→                report_url=report_url,  # Pre-generated URL with placeholder\n   263→                cost_summary=CostSummary(\n   264→                    total_cost_usd=0.005,  # Minimal Apify compute cost\n   265→                    gemini_cost_usd=0,\n   266→                    gemini_tokens_used=0,\n   267→                    searches_performed=0,\n   268→                ),\n   269→                execution_time_seconds=0,\n   270→                errors=[],\n   271→                warnings=[\"Research is processing. Visit report_url to view results when ready.\" if report_url else \"Research dispatched to Cloud Run.\"],\n   272→                started_at=started_at,\n   273→                completed_at=datetime.utcnow(),\n   274→                cache_hit=False,\n   275→                cache_extended=False,\n   276→            )\n   277→\n   278→        except Exception as e:\n   279→            logger.warning(f\"Cloud Run dispatch failed, falling back to local: {e}\")\n   280→            # Fall through to local execution\n   281→\n   282→    # === LOCAL EXECUTION (fallback or when Cloud Run not configured) ===\n   283→    # Initialize clients\n   284→    try:\n   285→        gemini_client = GeminiClient(\n   286→            api_key=settings.google_api_key,\n   287→            model=settings.gemini_model,\n   288→        )\n   289→    except Exception as e:\n   290→        return ActorOutput(\n   291→            session_id=\"error\",\n   292→            query=actor_input.query,\n   293→            template=actor_input.template,\n   294→            status=\"failed\",\n   295→            errors=[f\"Failed to initialize Gemini client: {str(e)}\"],\n   296→            started_at=started_at,\n   297→            completed_at=datetime.utcnow(),\n   298→        )\n   299→\n   300→    # Optional: OpenRouter for OCR\n   301→    ocr_service = None\n   302→    if settings.openrouter_api_key:\n   303→        try:\n   304→            openrouter_client = OpenRouterClient(\n   305→                api_key=settings.openrouter_api_key,\n   306→                base_url=settings.openrouter_base_url,\n   307→                model=settings.openrouter_ocr_model,\n   308→            )\n   309→            ocr_service = OCRService(openrouter_client)\n   310→        except Exception as e:\n   311→            logger.warning(f\"Failed to initialize OCR service: {e}\")\n   312→\n   313→    # Optional: Supabase for persistence\n   314→    supabase_client = None\n   315→    if actor_input.save_to_supabase and settings.supabase_url and settings.supabase_key:\n   316→        try:\n   317→            supabase_client = SupabaseClient(\n   318→                url=settings.supabase_url,\n   319→                key=settings.supabase_key,\n   320→                workspace_id=actor_input.workspace_id,\n   321→            )\n   322→        except Exception as e:\n   323→            logger.warning(f\"Failed to initialize Supabase client: {e}\")\n   324→\n   325→    # Initialize research service with progress emitter\n   326→    research_service = ResearchService(\n   327→        gemini_client=gemini_client,\n   328→        supabase_client=supabase_client,\n   329→        ocr_service=ocr_service,\n   330→        progress_emitter=progress_emitter,\n   331→    )\n   332→\n   333→    # Execute research\n   334→    try:\n   335→        # Get intent configuration for tailored research\n   336→        intent_config = actor_input.get_intent_config() if actor_input.intent else None\n   337→\n   338→        result = await research_service.execute_research(\n   339→            query=actor_input.query,\n   340→            template_type=actor_input.template,\n   341→            granularity=actor_input.granularity,\n   342→            max_searches=actor_input.max_searches,\n   343→            perspectives=actor_input.perspectives,\n   344→            input_file_url=actor_input.input_file_url,\n   345→            input_text=actor_input.input_text,\n   346→            save_to_db=actor_input.save_to_supabase and supabase_client is not None,\n   347→            workspace_id=actor_input.workspace_id,\n   348→            use_cache=actor_input.use_cache,\n   349→            extend_cache=actor_input.extend_cache,\n   350→            intent=actor_input.intent,\n   351→            intent_config=intent_config,\n   352→        )\n   353→    except Exception as e:\n   354→        logger.error(f\"Research failed: {e}\")\n   355→        return ActorOutput(\n   356→            session_id=\"error\",\n   357→            query=actor_input.query,\n   358→            template=actor_input.template,\n   359→            status=\"failed\",\n   360→            errors=[f\"Research execution failed: {str(e)}\"],\n   361→            started_at=started_at,\n   362→            completed_at=datetime.utcnow(),\n   363→        )\n   364→\n   365→    # Generate report if requested\n   366→    report_markdown = None\n   367→    report_html = None\n   368→\n   369→    if actor_input.generate_report:\n   370→        try:\n   371→            # Emit report started\n   372→            if progress_emitter:\n   373→                await progress_emitter.report_started(actor_input.report_variant, actor_input.report_format)\n   374→\n   375→            report_service = ReportService()\n   376→            report_markdown = report_service.generate_markdown(\n   377→                research_result=result,\n   378→                variant=actor_input.report_variant,\n   379→                title=actor_input.report_title,\n   380→            )\n   381→\n   382→            if actor_input.report_format == \"html\":\n   383→                report_html = report_service.generate_html(\n   384→                    markdown_content=report_markdown,\n   385→                    title=actor_input.report_title or f\"Research: {actor_input.query[:40]}\",\n   386→                    research_result=result,\n   387→                )\n   388→\n   389→            # Emit report completed\n   390→            if progress_emitter:\n   391→                await progress_emitter.report_completed(len(report_markdown) if report_markdown else 0)\n   392→        except Exception as e:\n   393→            logger.warning(f\"Report generation failed: {e}\")\n   394→            result.setdefault(\"warnings\", []).append(f\"Report generation failed: {str(e)}\")\n   395→\n   396→    # Build output using transform pipeline\n   397→    completed_at = datetime.utcnow()\n   398→    transformed = transform_research_result(result)\n   399→\n   400→    return ActorOutput(\n   401→        session_id=result.get(\"session_id\", \"unknown\"),\n   402→        query=actor_input.query,\n   403→        template=actor_input.template,\n   404→        status=result.get(\"status\", \"completed\"),\n   405→        findings=transformed.findings,\n   406→        perspectives=transformed.perspectives,\n   407→        sources=transformed.sources,\n   408→        search_queries_executed=result.get(\"search_queries_executed\", []),\n   409→        report_markdown=report_markdown,\n   410→        report_html=report_html,\n   411→        cost_summary=transformed.cost_summary,\n   412→        execution_time_seconds=result.get(\"execution_time_seconds\", 0),\n   413→        supabase_session_id=result.get(\"supabase_session_id\"),\n   414→        errors=result.get(\"errors\", []),\n   415→        warnings=result.get(\"warnings\", []),\n   416→        started_at=started_at,\n   417→        completed_at=completed_at,\n   418→        cache_hit=result.get(\"cache_hit\", False),\n   419→        cache_extended=result.get(\"cache_extended\", False),\n   420→        original_cached_at=result.get(\"original_cached_at\"),\n   421→        # Intelligence analysis results\n   422→        contradictions=result.get(\"contradictions\", []),\n   423→        knowledge_gaps=result.get(\"knowledge_gaps\", []),\n   424→        role_summaries=result.get(\"role_summaries\", {}),\n   425→    )\n   426→\n   427→\n   428→async def main():\n   429→    \"\"\"Main entry point for Apify actor.\"\"\"\n   430→    try:\n   431→        from apify import Actor\n   432→        APIFY_AVAILABLE = True\n   433→    except ImportError:\n   434→        APIFY_AVAILABLE = False\n   435→        Actor = None\n   436→\n   437→    if APIFY_AVAILABLE:\n   438→        async with Actor:\n   439→            # Get actor run context\n   440→            actor_info = Actor.get_env() or {}\n   441→            apify_run_id = actor_info.get(\"actor_run_id\", \"unknown\")\n   442→\n   443→            # Get input from Apify\n   444→            actor_input_raw = await Actor.get_input() or {}\n   445→            actor_input = ActorInput(**actor_input_raw)\n   446→\n   447→            # Generate session ID\n   448→            session_id = f\"session_{apify_run_id[:12]}\"\n   449→\n   450→            # Initialize unified progress emitter\n   451→            progress_emitter = ProgressEmitter(\n   452→                session_id=session_id,\n   453→                apify_run_id=apify_run_id,\n   454→                webhook_url=actor_input.progress_webhook_url,\n   455→            )\n   456→            await progress_emitter.initialize()\n   457→\n   458→            # Initialize state manager for migration recovery\n   459→            state_manager = StateManager(session_id)\n   460→            await state_manager.initialize()\n   461→\n   462→            # Run research with progress emitter\n   463→            output = await run_actor(actor_input, progress_emitter)\n   464→\n   465→            # Build executive summary\n   466→            exec_summary = build_executive_summary(output)\n   467→\n   468→            # Store full output\n   469→            await Actor.set_value(\"OUTPUT\", output.model_dump())\n   470→\n   471→            # Store executive summary\n   472→            await Actor.set_value(\"EXECUTIVE_SUMMARY\", exec_summary.model_dump())\n   473→\n   474→            # Store report if generated\n   475→            if output.report_markdown:\n   476→                await Actor.set_value(\"REPORT.md\", output.report_markdown)\n   477→            if output.report_html:\n   478→                await Actor.set_value(\"REPORT.html\", output.report_html)\n   479→\n   480→            # === MULTI-RECORD DATASET PUSH ===\n   481→\n   482→            # 1. Summary record (overview)\n   483→            await Actor.push_data({\n   484→                \"record_type\": \"summary\",\n   485→                \"session_id\": output.session_id,\n   486→                \"query\": output.query,\n   487→                \"template\": output.template,\n   488→                \"status\": output.status,\n   489→                \"total_findings\": len(output.findings),\n   490→                \"total_perspectives\": len(output.perspectives),\n   491→                \"total_sources\": len(output.sources),\n   492→                \"execution_time_seconds\": output.execution_time_seconds,\n   493→                \"total_cost_usd\": output.cost_summary.total_cost_usd,\n   494→                \"report_available\": output.report_markdown is not None,\n   495→                \"high_confidence_findings\": exec_summary.high_confidence_findings,\n   496→                \"high_credibility_sources\": exec_summary.high_credibility_sources,\n   497→            })\n   498→\n   499→            # 2. Finding records\n   500→            for finding in output.findings:\n   501→                await Actor.push_data({\n   502→                    \"record_type\": \"finding\",\n   503→                    \"session_id\": output.session_id,\n   504→                    **finding.model_dump()\n   505→                })\n   506→\n   507→            # 3. Perspective records\n   508→            for perspective in output.perspectives:\n   509→                await Actor.push_data({\n   510→                    \"record_type\": \"perspective\",\n   511→                    \"session_id\": output.session_id,\n   512→                    **perspective.model_dump()\n   513→                })\n   514→\n   515→            # 4. Source records\n   516→            for source in output.sources:\n   517→                await Actor.push_data({\n   518→                    \"record_type\": \"source\",\n   519→                    \"session_id\": output.session_id,\n   520→                    **source.model_dump()\n   521→                })\n   522→\n   523→            # 5. Metrics record\n   524→            await Actor.push_data({\n   525→                \"record_type\": \"metrics\",\n   526→                \"session_id\": output.session_id,\n   527→                **output.cost_summary.model_dump(),\n   528→                \"execution_time_seconds\": output.execution_time_seconds,\n   529→                \"search_queries_executed\": len(output.search_queries_executed),\n   530→            })\n   531→\n   532→            logger.info(\n   533→                f\"Research completed: {len(output.findings)} findings, \"\n   534→                f\"{len(output.perspectives)} perspectives, {len(output.sources)} sources\"\n   535→            )\n   536→\n   537→            # === EMAIL DELIVERY (optional, non-blocking) ===\n   538→            if actor_input.send_email and actor_input.email_to:\n   539→                try:\n   540→                    # Get settings for resend API key\n   541→                    settings = override_settings(resend_api_key=actor_input.resend_api_key)\n   542→\n   543→                    if settings.resend_api_key:\n   544→                        resend_client = ResendClient(api_key=settings.resend_api_key)\n   545→\n   546→                        # Prepare findings with sources for email (top 5 with source URLs)\n   547→                        findings_with_sources = [\n   548→                            {\n   549→                                \"summary\": f.summary,\n   550→                                \"content\": f.content,\n   551→                                \"supporting_sources\": f.supporting_sources,\n   552→                                \"date_referenced\": f.date_referenced,\n   553→                                \"date_range\": f.date_range,\n   554→                            }\n   555→                            for f in sorted(output.findings, key=lambda x: x.confidence_score, reverse=True)[:5]\n   556→                        ]\n   557→\n   558→                        # Collect all predictions from perspectives\n   559→                        all_predictions = []\n   560→                        for p in output.perspectives:\n   561→                            for pred in p.predictions[:2]:  # Top 2 per perspective\n   562→                                all_predictions.append(pred.model_dump())\n   563→                        # Deduplicate and limit\n   564→                        seen_preds = set()\n   565→                        unique_predictions = []\n   566→                        for pred in all_predictions:\n   567→                            pred_key = pred.get(\"prediction\", \"\")[:50].lower()\n   568→                            if pred_key not in seen_preds:\n   569→                                seen_preds.add(pred_key)\n   570→                                unique_predictions.append(pred)\n   571→                                if len(unique_predictions) >= 5:\n   572→                                    break\n   573→\n   574→                        # Build email content with new parameters\n   575→                        email_content = resend_client.build_report_email(\n   576→                            query=output.query,\n   577→                            template=output.template,\n   578→                            executive_summary=exec_summary.model_dump(),\n   579→                            report_html=output.report_html,\n   580→                            report_markdown=output.report_markdown,\n   581→                            findings_with_sources=findings_with_sources,\n   582→                            predictions=unique_predictions,\n   583→                        )\n   584→\n   585→                        # Prepare attachments (both markdown and HTML)\n   586→                        attachments = []\n   587→                        if output.report_markdown:\n   588→                            attachments.append({\n   589→                                \"filename\": \"research_report.md\",\n   590→                                \"content\": base64.b64encode(output.report_markdown.encode()).decode(),\n   591→                            })\n   592→                        if output.report_html:\n   593→                            attachments.append({\n   594→                                \"filename\": \"research_report.html\",\n   595→                                \"content\": base64.b64encode(output.report_html.encode()).decode(),\n   596→                            })\n   597→\n   598→                        # Send email\n   599→                        email_result = await resend_client.send_report(\n   600→                            to_email=actor_input.email_to,\n   601→                            subject=actor_input.email_subject or email_content[\"subject\"],\n   602→                            html_content=email_content[\"html\"],\n   603→                            text_content=email_content[\"text\"],\n   604→                            attachments=attachments if attachments else None,\n   605→                        )\n   606→\n   607→                        if email_result[\"success\"]:\n   608→                            logger.info(f\"Email sent successfully to {actor_input.email_to}\")\n   609→                        else:\n   610→                            logger.warning(f\"Email send failed: {email_result.get('error')}\")\n   611→                    else:\n   612→                        logger.warning(\"Email requested but RESEND_API_KEY not configured\")\n   613→\n   614→                except Exception as e:\n   615→                    # Non-blocking - log error but don't fail the actor\n   616→                    logger.warning(f\"Email delivery failed (non-blocking): {str(e)}\")\n   617→\n   618→            # === FINAL PROGRESS EMISSION ===\n   619→            if output.status == \"completed\":\n   620→                # Emit completion via unified progress emitter\n   621→                kv_store = await Actor.open_key_value_store()\n   622→                results_url = f\"https://api.apify.com/v2/key-value-stores/{kv_store.id}/records/OUTPUT\"\n   623→\n   624→                await progress_emitter.completed(\n   625→                    findings_count=len(output.findings),\n   626→                    sources_count=len(output.sources),\n   627→                    total_cost_usd=output.cost_summary.total_cost_usd,\n   628→                    perspectives_count=len(output.perspectives),\n   629→                    execution_time_seconds=output.execution_time_seconds,\n   630→                    results_url=results_url,\n   631→                )\n   632→\n   633→                # Clear state after successful completion\n   634→                await state_manager.clear()\n   635→            else:\n   636→                # Emit failure via unified progress emitter\n   637→                error_msg = \"; \".join(output.errors) if output.errors else \"Unknown error\"\n   638→                await progress_emitter.failed(error_msg, \"RESEARCH_FAILED\", \"execution\")\n   639→\n   640→    else:\n   641→        # Local execution for testing\n   642→        logger.info(\"Running in local mode (Apify SDK not available)\")\n   643→\n   644→        # Example input for testing\n   645→        test_input = ActorInput(\n   646→            query=\"What is Apple's current financial position and stock outlook?\",\n   647→            template=\"financial\",\n   648→            granularity=\"quick\",\n   649→            max_searches=3,\n   650→            generate_report=True,\n   651→            save_to_supabase=False,\n   652→        )\n   653→\n   654→        output = await run_actor(test_input)\n   655→        exec_summary = build_executive_summary(output)\n   656→\n   657→        print(f\"\\nResults: {len(output.findings)} findings, {len(output.sources)} sources\")\n   658→        print(f\"Status: {output.status}\")\n   659→        print(f\"Execution time: {output.execution_time_seconds:.1f}s\")\n   660→        print(f\"High confidence findings: {exec_summary.high_confidence_findings}\")\n   661→\n   662→        if output.errors:\n   663→            print(f\"Errors: {output.errors}\")\n   664→\n   665→        if exec_summary.top_findings:\n   666→            print(\"\\nTop Findings:\")\n   667→            for i, f in enumerate(exec_summary.top_findings[:3], 1):\n   668→                print(f\"  {i}. {f}\")\n   669→\n   670→        if output.report_markdown:\n   671→            print(\"\\n\" + \"=\"*50)\n   672→            print(output.report_markdown[:2000])\n   673→\n   674→\n   675→if __name__ == \"__main__\":\n   676→    asyncio.run(main())\n   677→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"5a9084f5-7891-419f-a7ed-a607df0d9f02","uuid":"a926666e-9eb5-4042-ba1d-965d59828cd1","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\actor\\src\\main.py","content":"\"\"\"Deep Research Actor - Main entry point.\n\nThis actor performs AI-powered deep research using Gemini with Google Search grounding.\n\"\"\"\n\nimport asyncio\nimport base64\nimport logging\nimport os\nfrom datetime import datetime\nfrom typing import Optional\n\nfrom .config import override_settings, get_settings\nfrom .schemas import ActorInput, ActorOutput, ExecutiveSummary, Finding, Source, Perspective, Prediction, CostSummary\nfrom .clients import GeminiClient, OpenRouterClient, SupabaseClient, ResendClient, CloudRunClient, R2Client\nfrom .services import OCRService, ResearchService, ReportService, ProgressEmitter, StateManager\nfrom .services.transform import transform_research_result\n\n\n# Auto-select best report variant for each template\nTEMPLATE_REPORT_VARIANTS = {\n    \"tech_market\": \"full_report\",\n    \"financial\": \"investment_thesis\",\n    \"competitive\": \"full_report\",\n    \"investigative\": \"full_report\",\n    \"legal\": \"full_report\",\n    \"contract\": \"decision_brief\",\n    \"understanding\": \"credibility_report\",\n    \"due_diligence\": \"risk_summary\",\n    \"purchase_decision\": \"buyer_guide\",\n    \"reputation\": \"trust_report\",\n}\n\n\ndef get_report_variant_for_template(template: str) -> str:\n    \"\"\"Get the best report variant for a given template.\"\"\"\n    return TEMPLATE_REPORT_VARIANTS.get(template, \"full_report\")\n\n# Configure logging\nlogging.basicConfig(\n    level=logging.INFO,\n    format=\"%(asctime)s [%(levelname)s] %(name)s: %(message)s\"\n)\nlogger = logging.getLogger(__name__)\n\n\ndef build_executive_summary(output: ActorOutput) -> ExecutiveSummary:\n    \"\"\"Build executive summary from actor output.\"\"\"\n    # Count high confidence findings\n    high_conf_findings = [f for f in output.findings if f.confidence_score >= 0.8]\n\n    # Count high credibility sources\n    high_cred_sources = [s for s in output.sources if s.credibility_score and s.credibility_score >= 0.8]\n\n    # Get top 5 findings by confidence\n    sorted_findings = sorted(output.findings, key=lambda f: f.confidence_score, reverse=True)\n    top_findings = [\n        f.summary or f.content[:100] + \"...\" if len(f.content) > 100 else f.content\n        for f in sorted_findings[:5]\n    ]\n\n    # Aggregate expert recommendations, warnings, insights\n    all_recommendations = []\n    all_warnings = []\n    all_insights = []\n\n    for p in output.perspectives:\n        all_recommendations.extend(p.recommendations[:2])  # Top 2 per perspective\n        all_warnings.extend(p.warnings[:1])  # Top 1 per perspective\n        all_insights.extend(p.key_insights[:2])  # Top 2 per perspective\n\n    # Deduplicate and limit\n    seen_recs = set()\n    unique_recommendations = []\n    for r in all_recommendations:\n        if r.lower() not in seen_recs:\n            seen_recs.add(r.lower())\n            unique_recommendations.append(r)\n            if len(unique_recommendations) >= 5:\n                break\n\n    seen_warnings = set()\n    unique_warnings = []\n    for w in all_warnings:\n        if w.lower() not in seen_warnings:\n            seen_warnings.add(w.lower())\n            unique_warnings.append(w)\n            if len(unique_warnings) >= 3:\n                break\n\n    seen_insights = set()\n    unique_insights = []\n    for i in all_insights:\n        if i.lower() not in seen_insights:\n            seen_insights.add(i.lower())\n            unique_insights.append(i)\n            if len(unique_insights) >= 5:\n                break\n\n    # Report preview\n    report_preview = \"\"\n    if output.report_markdown:\n        report_preview = output.report_markdown[:500]\n        if len(output.report_markdown) > 500:\n            report_preview += \"...\"\n\n    return ExecutiveSummary(\n        session_id=output.session_id,\n        query=output.query,\n        template=output.template,\n        status=output.status,\n        findings_count=len(output.findings),\n        high_confidence_findings=len(high_conf_findings),\n        sources_count=len(output.sources),\n        high_credibility_sources=len(high_cred_sources),\n        perspectives_count=len(output.perspectives),\n        top_findings=top_findings,\n        expert_recommendations=unique_recommendations,\n        expert_warnings=unique_warnings,\n        key_insights=unique_insights,\n        report_preview=report_preview,\n        total_cost_usd=output.cost_summary.total_cost_usd,\n        execution_time_seconds=output.execution_time_seconds,\n        completed_at=output.completed_at,\n    )\n\n\nasync def run_actor(\n    actor_input: ActorInput,\n    progress_emitter: Optional[ProgressEmitter] = None,\n) -> ActorOutput:\n    \"\"\"\n    Execute the Deep Research Actor.\n\n    Args:\n        actor_input: Validated input parameters\n        progress_emitter: Optional unified progress emitter for status and webhook events\n\n    Returns:\n        ActorOutput with research results\n    \"\"\"\n    started_at = datetime.utcnow()\n    logger.info(f\"Starting research: {actor_input.query[:50]}...\")\n\n    # Get settings with overrides\n    settings = override_settings(\n        google_api_key=actor_input.google_api_key,\n        openrouter_api_key=actor_input.openrouter_api_key,\n        supabase_url=actor_input.supabase_url,\n        supabase_key=actor_input.supabase_key,\n        resend_api_key=actor_input.resend_api_key,\n        cloud_run_url=actor_input.cloud_run_url,\n    )\n\n    # Validate required API key\n    if not settings.google_api_key:\n        return ActorOutput(\n            session_id=\"error\",\n            query=actor_input.query,\n            template=actor_input.template,\n            status=\"failed\",\n            errors=[\"Google API key is required. Set GOOGLE_API_KEY env var or provide in input.\"],\n            started_at=started_at,\n            completed_at=datetime.utcnow(),\n        )\n\n    \n    # === CLOUD RUN DISPATCH (fire-and-forget mode) ===\n    # Dispatch to Cloud Run and return immediately - Cloud Run handles everything\n    if settings.cloud_run_url:\n        logger.info(f\"Dispatching to Cloud Run (fire-and-forget): {settings.cloud_run_url}\")\n\n        try:\n            # Initialize R2 client for report storage (if configured)\n            r2_client = None\n            report_url = None\n            job_id = None\n\n            if settings.r2_account_id and settings.r2_access_key_id and settings.r2_secret_access_key:\n                try:\n                    r2_client = R2Client(\n                        account_id=settings.r2_account_id,\n                        access_key_id=settings.r2_access_key_id,\n                        secret_access_key=settings.r2_secret_access_key,\n                        bucket_name=settings.r2_bucket_name,\n                        public_url_base=settings.r2_public_url or None,\n                    )\n\n                    # Generate job_id and upload placeholder\n                    job_id = r2_client.generate_job_id(actor_input.query, actor_input.template)\n                    report_url = r2_client.upload_placeholder(\n                        job_id=job_id,\n                        query=actor_input.query,\n                        template=actor_input.template,\n                    )\n                    logger.info(f\"Placeholder uploaded to R2: {report_url}\")\n\n                except Exception as e:\n                    logger.warning(f\"R2 placeholder upload failed (continuing without): {e}\")\n                    r2_client = None\n\n            cloud_run_client = CloudRunClient(\n                service_url=settings.cloud_run_url,\n                dispatch_timeout=15,  # Short timeout for acknowledgment only\n            )\n\n            # Auto-select best report variant for template\n            report_variant = get_report_variant_for_template(actor_input.template)\n\n            # Fire-and-forget dispatch - Cloud Run handles research, report, email, R2 upload\n            dispatch_result = await cloud_run_client.dispatch_async(\n                query=actor_input.query,\n                template=actor_input.template,\n                granularity=actor_input.granularity,\n                max_searches=actor_input.get_max_searches(),\n                perspectives=actor_input.perspectives,\n                input_file_url=actor_input.input_file_url,\n                input_text=actor_input.input_text,\n                workspace_id=actor_input.workspace_id,\n                gemini_api_key=settings.google_api_key,\n                supabase_url=settings.supabase_url,\n                supabase_key=settings.supabase_key,\n                resend_api_key=settings.resend_api_key,\n                # Report options\n                generate_report=actor_input.generate_report,\n                report_format=actor_input.report_format,\n                report_variant=report_variant,\n                report_title=actor_input.report_title,\n                # Email options\n                send_email=actor_input.send_email,\n                email_to=actor_input.email_to,\n                email_subject=actor_input.email_subject,\n                # Progress webhook\n                callback_url=actor_input.progress_webhook_url,\n                # R2 config for Cloud Run to upload final report\n                r2_job_id=job_id,\n                r2_account_id=settings.r2_account_id if r2_client else None,\n                r2_access_key_id=settings.r2_access_key_id if r2_client else None,\n                r2_secret_access_key=settings.r2_secret_access_key if r2_client else None,\n                r2_bucket_name=settings.r2_bucket_name if r2_client else None,\n                r2_public_url=settings.r2_public_url if r2_client else None,\n            )\n\n            await cloud_run_client.close()\n\n            # Use job_id from R2 if available, otherwise from dispatch result\n            final_job_id = job_id or dispatch_result.get(\"job_id\", \"unknown\")\n            logger.info(f\"Cloud Run job dispatched: {final_job_id}\")\n\n            # Return immediately with dispatched status and report URL\n            return ActorOutput(\n                session_id=final_job_id,\n                query=actor_input.query,\n                template=actor_input.template,\n                status=\"processing\",  # More accurate than \"dispatched\"\n                findings=[],\n                perspectives=[],\n                sources=[],\n                search_queries_executed=[],\n                report_markdown=None,\n                report_html=None,\n                report_url=report_url,  # Pre-generated URL with placeholder\n                cost_summary=CostSummary(\n                    total_cost_usd=0.005,  # Minimal Apify compute cost\n                    gemini_cost_usd=0,\n                    gemini_tokens_used=0,\n                    searches_performed=0,\n                ),\n                execution_time_seconds=0,\n                errors=[],\n                warnings=[\"Research is processing. Visit report_url to view results when ready.\" if report_url else \"Research dispatched to Cloud Run.\"],\n                started_at=started_at,\n                completed_at=datetime.utcnow(),\n                cache_hit=False,\n                cache_extended=False,\n            )\n\n        except Exception as e:\n            logger.warning(f\"Cloud Run dispatch failed, falling back to local: {e}\")\n            # Fall through to local execution\n\n    # === LOCAL EXECUTION (fallback or when Cloud Run not configured) ===\n    # Initialize clients\n    try:\n        gemini_client = GeminiClient(\n            api_key=settings.google_api_key,\n            model=settings.gemini_model,\n        )\n    except Exception as e:\n        return ActorOutput(\n            session_id=\"error\",\n            query=actor_input.query,\n            template=actor_input.template,\n            status=\"failed\",\n            errors=[f\"Failed to initialize Gemini client: {str(e)}\"],\n            started_at=started_at,\n            completed_at=datetime.utcnow(),\n        )\n\n    # Optional: OpenRouter for OCR\n    ocr_service = None\n    if settings.openrouter_api_key:\n        try:\n            openrouter_client = OpenRouterClient(\n                api_key=settings.openrouter_api_key,\n                base_url=settings.openrouter_base_url,\n                model=settings.openrouter_ocr_model,\n            )\n            ocr_service = OCRService(openrouter_client)\n        except Exception as e:\n            logger.warning(f\"Failed to initialize OCR service: {e}\")\n\n    # Optional: Supabase for persistence\n    supabase_client = None\n    if actor_input.save_to_supabase and settings.supabase_url and settings.supabase_key:\n        try:\n            supabase_client = SupabaseClient(\n                url=settings.supabase_url,\n                key=settings.supabase_key,\n                workspace_id=actor_input.workspace_id,\n            )\n        except Exception as e:\n            logger.warning(f\"Failed to initialize Supabase client: {e}\")\n\n    # Initialize research service with progress emitter\n    research_service = ResearchService(\n        gemini_client=gemini_client,\n        supabase_client=supabase_client,\n        ocr_service=ocr_service,\n        progress_emitter=progress_emitter,\n    )\n\n    # Execute research\n    try:\n        # Get intent configuration for tailored research\n        intent_config = actor_input.get_intent_config() if actor_input.intent else None\n\n        result = await research_service.execute_research(\n            query=actor_input.query,\n            template_type=actor_input.template,\n            granularity=actor_input.granularity,\n            max_searches=actor_input.max_searches,\n            perspectives=actor_input.perspectives,\n            input_file_url=actor_input.input_file_url,\n            input_text=actor_input.input_text,\n            save_to_db=actor_input.save_to_supabase and supabase_client is not None,\n            workspace_id=actor_input.workspace_id,\n            use_cache=actor_input.use_cache,\n            extend_cache=actor_input.extend_cache,\n            intent=actor_input.intent,\n            intent_config=intent_config,\n        )\n    except Exception as e:\n        logger.error(f\"Research failed: {e}\")\n        return ActorOutput(\n            session_id=\"error\",\n            query=actor_input.query,\n            template=actor_input.template,\n            status=\"failed\",\n            errors=[f\"Research execution failed: {str(e)}\"],\n            started_at=started_at,\n            completed_at=datetime.utcnow(),\n        )\n\n    # Generate report if requested\n    report_markdown = None\n    report_html = None\n\n    if actor_input.generate_report:\n        try:\n            # Emit report started\n            if progress_emitter:\n                await progress_emitter.report_started(actor_input.report_variant, actor_input.report_format)\n\n            report_service = ReportService()\n            report_markdown = report_service.generate_markdown(\n                research_result=result,\n                variant=actor_input.report_variant,\n                title=actor_input.report_title,\n            )\n\n            if actor_input.report_format == \"html\":\n                report_html = report_service.generate_html(\n                    markdown_content=report_markdown,\n                    title=actor_input.report_title or f\"Research: {actor_input.query[:40]}\",\n                    research_result=result,\n                )\n\n            # Emit report completed\n            if progress_emitter:\n                await progress_emitter.report_completed(len(report_markdown) if report_markdown else 0)\n        except Exception as e:\n            logger.warning(f\"Report generation failed: {e}\")\n            result.setdefault(\"warnings\", []).append(f\"Report generation failed: {str(e)}\")\n\n    # Build output using transform pipeline\n    completed_at = datetime.utcnow()\n    transformed = transform_research_result(result)\n\n    return ActorOutput(\n        session_id=result.get(\"session_id\", \"unknown\"),\n        query=actor_input.query,\n        template=actor_input.template,\n        status=result.get(\"status\", \"completed\"),\n        findings=transformed.findings,\n        perspectives=transformed.perspectives,\n        sources=transformed.sources,\n        search_queries_executed=result.get(\"search_queries_executed\", []),\n        report_markdown=report_markdown,\n        report_html=report_html,\n        cost_summary=transformed.cost_summary,\n        execution_time_seconds=result.get(\"execution_time_seconds\", 0),\n        supabase_session_id=result.get(\"supabase_session_id\"),\n        errors=result.get(\"errors\", []),\n        warnings=result.get(\"warnings\", []),\n        started_at=started_at,\n        completed_at=completed_at,\n        cache_hit=result.get(\"cache_hit\", False),\n        cache_extended=result.get(\"cache_extended\", False),\n        original_cached_at=result.get(\"original_cached_at\"),\n        # Intelligence analysis results\n        contradictions=result.get(\"contradictions\", []),\n        knowledge_gaps=result.get(\"knowledge_gaps\", []),\n        role_summaries=result.get(\"role_summaries\", {}),\n    )\n\n\nasync def main():\n    \"\"\"Main entry point for Apify actor.\"\"\"\n    try:\n        from apify import Actor\n        APIFY_AVAILABLE = True\n    except ImportError:\n        APIFY_AVAILABLE = False\n        Actor = None\n\n    if APIFY_AVAILABLE:\n        async with Actor:\n            # Get actor run context\n            actor_info = Actor.get_env() or {}\n            apify_run_id = actor_info.get(\"actor_run_id\", \"unknown\")\n\n            # Get input from Apify\n            actor_input_raw = await Actor.get_input() or {}\n            actor_input = ActorInput(**actor_input_raw)\n\n            # Generate session ID\n            session_id = f\"session_{apify_run_id[:12]}\"\n\n            # Initialize unified progress emitter\n            progress_emitter = ProgressEmitter(\n                session_id=session_id,\n                apify_run_id=apify_run_id,\n                webhook_url=actor_input.progress_webhook_url,\n            )\n            await progress_emitter.initialize()\n\n            # Initialize state manager for migration recovery\n            state_manager = StateManager(session_id)\n            await state_manager.initialize()\n\n            # Run research with progress emitter\n            output = await run_actor(actor_input, progress_emitter)\n\n            # Build executive summary\n            exec_summary = build_executive_summary(output)\n\n            # Store full output\n            await Actor.set_value(\"OUTPUT\", output.model_dump())\n\n            # Store executive summary\n            await Actor.set_value(\"EXECUTIVE_SUMMARY\", exec_summary.model_dump())\n\n            # Store report if generated\n            if output.report_markdown:\n                await Actor.set_value(\"REPORT.md\", output.report_markdown)\n            if output.report_html:\n                await Actor.set_value(\"REPORT.html\", output.report_html)\n\n            # === MULTI-RECORD DATASET PUSH ===\n\n            # 1. Summary record (overview)\n            await Actor.push_data({\n                \"record_type\": \"summary\",\n                \"session_id\": output.session_id,\n                \"query\": output.query,\n                \"template\": output.template,\n                \"status\": output.status,\n                \"total_findings\": len(output.findings),\n                \"total_perspectives\": len(output.perspectives),\n                \"total_sources\": len(output.sources),\n                \"execution_time_seconds\": output.execution_time_seconds,\n                \"total_cost_usd\": output.cost_summary.total_cost_usd,\n                \"report_available\": output.report_markdown is not None,\n                \"high_confidence_findings\": exec_summary.high_confidence_findings,\n                \"high_credibility_sources\": exec_summary.high_credibility_sources,\n            })\n\n            # 2. Finding records\n            for finding in output.findings:\n                await Actor.push_data({\n                    \"record_type\": \"finding\",\n                    \"session_id\": output.session_id,\n                    **finding.model_dump()\n                })\n\n            # 3. Perspective records\n            for perspective in output.perspectives:\n                await Actor.push_data({\n                    \"record_type\": \"perspective\",\n                    \"session_id\": output.session_id,\n                    **perspective.model_dump()\n                })\n\n            # 4. Source records\n            for source in output.sources:\n                await Actor.push_data({\n                    \"record_type\": \"source\",\n                    \"session_id\": output.session_id,\n                    **source.model_dump()\n                })\n\n            # 5. Metrics record\n            await Actor.push_data({\n                \"record_type\": \"metrics\",\n                \"session_id\": output.session_id,\n                **output.cost_summary.model_dump(),\n                \"execution_time_seconds\": output.execution_time_seconds,\n                \"search_queries_executed\": len(output.search_queries_executed),\n            })\n\n            logger.info(\n                f\"Research completed: {len(output.findings)} findings, \"\n                f\"{len(output.perspectives)} perspectives, {len(output.sources)} sources\"\n            )\n\n            # === EMAIL DELIVERY (optional, non-blocking) ===\n            if actor_input.send_email and actor_input.email_to:\n                try:\n                    # Get settings for resend API key\n                    settings = override_settings(resend_api_key=actor_input.resend_api_key)\n\n                    if settings.resend_api_key:\n                        resend_client = ResendClient(api_key=settings.resend_api_key)\n\n                        # Prepare findings with sources for email (top 5 with source URLs)\n                        findings_with_sources = [\n                            {\n                                \"summary\": f.summary,\n                                \"content\": f.content,\n                                \"supporting_sources\": f.supporting_sources,\n                                \"date_referenced\": f.date_referenced,\n                                \"date_range\": f.date_range,\n                            }\n                            for f in sorted(output.findings, key=lambda x: x.confidence_score, reverse=True)[:5]\n                        ]\n\n                        # Collect all predictions from perspectives\n                        all_predictions = []\n                        for p in output.perspectives:\n                            for pred in p.predictions[:2]:  # Top 2 per perspective\n                                all_predictions.append(pred.model_dump())\n                        # Deduplicate and limit\n                        seen_preds = set()\n                        unique_predictions = []\n                        for pred in all_predictions:\n                            pred_key = pred.get(\"prediction\", \"\")[:50].lower()\n                            if pred_key not in seen_preds:\n                                seen_preds.add(pred_key)\n                                unique_predictions.append(pred)\n                                if len(unique_predictions) >= 5:\n                                    break\n\n                        # Build email content with new parameters\n                        email_content = resend_client.build_report_email(\n                            query=output.query,\n                            template=output.template,\n                            executive_summary=exec_summary.model_dump(),\n                            report_html=output.report_html,\n                            report_markdown=output.report_markdown,\n                            findings_with_sources=findings_with_sources,\n                            predictions=unique_predictions,\n                        )\n\n                        # Prepare attachments (both markdown and HTML)\n                        attachments = []\n                        if output.report_markdown:\n                            attachments.append({\n                                \"filename\": \"research_report.md\",\n                                \"content\": base64.b64encode(output.report_markdown.encode()).decode(),\n                            })\n                        if output.report_html:\n                            attachments.append({\n                                \"filename\": \"research_report.html\",\n                                \"content\": base64.b64encode(output.report_html.encode()).decode(),\n                            })\n\n                        # Send email\n                        email_result = await resend_client.send_report(\n                            to_email=actor_input.email_to,\n                            subject=actor_input.email_subject or email_content[\"subject\"],\n                            html_content=email_content[\"html\"],\n                            text_content=email_content[\"text\"],\n                            attachments=attachments if attachments else None,\n                        )\n\n                        if email_result[\"success\"]:\n                            logger.info(f\"Email sent successfully to {actor_input.email_to}\")\n                        else:\n                            logger.warning(f\"Email send failed: {email_result.get('error')}\")\n                    else:\n                        logger.warning(\"Email requested but RESEND_API_KEY not configured\")\n\n                except Exception as e:\n                    # Non-blocking - log error but don't fail the actor\n                    logger.warning(f\"Email delivery failed (non-blocking): {str(e)}\")\n\n            # === FINAL PROGRESS EMISSION ===\n            if output.status == \"completed\":\n                # Emit completion via unified progress emitter\n                kv_store = await Actor.open_key_value_store()\n                results_url = f\"https://api.apify.com/v2/key-value-stores/{kv_store.id}/records/OUTPUT\"\n\n                await progress_emitter.completed(\n                    findings_count=len(output.findings),\n                    sources_count=len(output.sources),\n                    total_cost_usd=output.cost_summary.total_cost_usd,\n                    perspectives_count=len(output.perspectives),\n                    execution_time_seconds=output.execution_time_seconds,\n                    results_url=results_url,\n                )\n\n                # Clear state after successful completion\n                await state_manager.clear()\n            else:\n                # Emit failure via unified progress emitter\n                error_msg = \"; \".join(output.errors) if output.errors else \"Unknown error\"\n                await progress_emitter.failed(error_msg, \"RESEARCH_FAILED\", \"execution\")\n\n    else:\n        # Local execution for testing\n        logger.info(\"Running in local mode (Apify SDK not available)\")\n\n        # Example input for testing\n        test_input = ActorInput(\n            query=\"What is Apple's current financial position and stock outlook?\",\n            template=\"financial\",\n            granularity=\"quick\",\n            max_searches=3,\n            generate_report=True,\n            save_to_supabase=False,\n        )\n\n        output = await run_actor(test_input)\n        exec_summary = build_executive_summary(output)\n\n        print(f\"\\nResults: {len(output.findings)} findings, {len(output.sources)} sources\")\n        print(f\"Status: {output.status}\")\n        print(f\"Execution time: {output.execution_time_seconds:.1f}s\")\n        print(f\"High confidence findings: {exec_summary.high_confidence_findings}\")\n\n        if output.errors:\n            print(f\"Errors: {output.errors}\")\n\n        if exec_summary.top_findings:\n            print(\"\\nTop Findings:\")\n            for i, f in enumerate(exec_summary.top_findings[:3], 1):\n                print(f\"  {i}. {f}\")\n\n        if output.report_markdown:\n            print(\"\\n\" + \"=\"*50)\n            print(output.report_markdown[:2000])\n\n\nif __name__ == \"__main__\":\n    asyncio.run(main())\n","numLines":677,"startLine":1,"totalLines":677}}}
