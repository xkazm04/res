[2026-01-30T09:07:50.710Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YbLzHM1MDbLNKMNiMkVHKf","type":"tool_result","content":"     1→\"\"\"Investigative journalism research template.\"\"\"\n     2→\n     3→from typing import List, Dict, Any, Optional\n     4→\n     5→from .base import BaseTemplate\n     6→from ..services.report_components import (\n     7→    ComponentType, ComponentConfig, ReportHints, get_report_hints\n     8→)\n     9→\n    10→\n    11→class InvestigativeTemplate(BaseTemplate):\n    12→    \"\"\"Template for investigative journalism research.\"\"\"\n    13→\n    14→    template_id = \"investigative\"\n    15→    template_name = \"Investigative Research\"\n    16→    description = \"Deep investigative journalism with actor and relationship analysis\"\n    17→\n    18→    # Report hints for component-based rendering\n    19→    report_hints = ReportHints(\n    20→        template_type=\"investigative\",\n    21→        structure=\"narrative_first\",\n    22→        findings_grouping=\"chronological\",\n    23→        tone=\"investigative\",\n    24→        decision_format=\"recommendation\",\n    25→        emphasis=[\"evidence\", \"timeline\", \"key_actors\", \"implications\"],\n    26→        required_components=[\n    27→            ComponentType.INVESTIGATION_TIMELINE,\n    28→            ComponentType.FINDINGS_TABLE,\n    29→            ComponentType.QUOTE_CAROUSEL,\n    30→        ],\n    31→        optional_components=[\n    32→            ComponentType.KEY_INSIGHTS,\n    33→            ComponentType.RISK_MATRIX,\n    34→            ComponentType.CHECKLIST,\n    35→            ComponentType.SOURCE_LIST,\n    36→        ],\n    37→        visualization_preference=[\"investigation_timeline\", \"evidence_network\", \"actor_map\"],\n    38→        custom_sections={\n    39→            \"show_financial_trail\": True,\n    40→            \"highlight_actors\": True,\n    41→            \"evidence_strength_indicators\": True,\n    42→        }\n    43→    )\n    44→\n    45→    # Expert perspectives for deep investigative analysis\n    46→    default_perspectives = [\n    47→        \"forensic_financial\",      # Follow the money, fraud detection\n    48→        \"power_network\",           # Map influence networks and institutional capture\n    49→        \"psychological_behavioral\", # Analyze motivations and credibility\n    50→        \"legal_liability\",          # Assess legal exposure and enforcement risk\n    51→        \"geopolitical_strategic\",   # Strategic interests and power dynamics\n    52→    ]\n    53→\n    54→    default_max_searches = 8\n    55→\n    56→    # Investigative requires thorough verification on all dimensions\n    57→    # Critical to verify claims, detect cover-ups, and identify spin\n    58→    verification_config = {\n    59→        \"cross_reference\": \"thorough\",      # Must corroborate claims\n    60→        \"bias_detection\": \"thorough\",       # Detect PR spin, cover-ups\n    61→        \"expert_sanity_check\": \"thorough\",  # Flag implausible claims\n    62→        \"source_quality\": \"thorough\",       # Primary sources critical\n    63→    }\n    64→\n    65→    async def generate_search_queries(\n    66→        self,\n    67→        query: str,\n    68→        max_searches: int,\n    69→        granularity: str = \"standard\",\n    70→    ) -> List[str]:\n    71→        \"\"\"Generate investigative search queries.\"\"\"\n    72→        prompt = f\"\"\"\n    73→You are an investigative journalist planning research queries for a deep investigation.\n    74→\n    75→Investigation Topic: {query}\n    76→\n    77→Depth Level: {granularity}\n    78→\n    79→Generate search queries covering these investigative angles:\n    80→1. KEY ACTORS: Who are the main people/organizations involved?\n    81→2. TIMELINE: What events happened and when?\n    82→3. LOCATIONS: Where did key events occur? What jurisdictions are involved?\n    83→4. MOTIVATIONS: What are the underlying interests and relationships?\n    84→5. METHODS: How were things done? What mechanisms were used?\n    85→6. MONEY TRAIL: Financial connections and transactions\n    86→7. OFFICIAL RECORDS: Government filings, court documents, regulatory actions\n    87→8. MEDIA COVERAGE: News reports, interviews, public statements\n    88→\n    89→For a \"{granularity}\" depth level:\n    90→- \"quick\": Focus on 1-3 most critical angles\n    91→- \"standard\": Cover 4-5 key angles with balanced depth\n    92→- \"deep\": Comprehensive coverage of all angles with follow-up queries\n    93→\n    94→Return a JSON array of exactly {max_searches} search query strings, ordered by importance.\n    95→Example: [\"query about main actor\", \"query about key event\", ...]\n    96→\"\"\"\n    97→\n    98→        result = await self._call_gemini_json(prompt)\n    99→\n   100→        if isinstance(result, list):\n   101→            return result[:max_searches]\n   102→        return []\n   103→\n   104→    async def extract_findings(\n   105→        self,\n   106→        query: str,\n   107→        sources: List[Dict[str, Any]],\n   108→        synthesized_content: str,\n   109→        granularity: str = \"standard\",\n   110→    ) -> List[Dict[str, Any]]:\n   111→        \"\"\"Extract investigative findings.\"\"\"\n   112→        # Build source context\n   113→        source_context = \"\\n\\n\".join([\n   114→            f\"Source: {s.get('title', 'Unknown')} ({s.get('url', '')})\\n\"\n   115→            f\"Credibility: {s.get('credibility_score', 'Unknown')}\\n\"\n   116→            f\"Domain: {s.get('domain', '')}\"\n   117→            for s in sources[:20]\n   118→        ])\n   119→\n   120→        prompt = f\"\"\"\n   121→You are an investigative analyst extracting key findings for a deep investigation.\n   122→\n   123→Investigation Topic: {query}\n   124→\n   125→Synthesized Research Content:\n   126→{synthesized_content[:15000]}\n   127→\n   128→Sources Referenced:\n   129→{source_context}\n   130→\n   131→Extract findings in these investigative categories:\n   132→\n   133→1. ACTORS (finding_type: \"actor\")\n   134→   - People, organizations, entities involved\n   135→   - Include: name, role, affiliations, significance\n   136→   - Note any aliases or connections\n   137→\n   138→2. EVENTS (finding_type: \"event\")\n   139→   - Key incidents, actions, decisions\n   140→   - Include: date (if known), location, participants, outcome\n   141→   - Note sequence and causation\n   142→\n   143→3. RELATIONSHIPS (finding_type: \"relationship\")\n   144→   - Connections between actors\n   145→   - Types: personal, professional, political, criminal\n   146→   - Include strength of evidence\n   147→\n   148→4. FINANCIAL TRANSACTIONS (finding_type: \"financial\")\n   149→   - ANY money movement: payments, gifts, loans, wire transfers, settlements\n   150→   - Property purchases, sales, or transfers\n   151→   - Investments, donations, or funding\n   152→   - Include in extracted_data:\n   153→     * \"amount\": dollar amount (number)\n   154→     * \"currency\": \"USD\", \"GBP\", etc.\n   155→     * \"payer\": who paid/gave the money\n   156→     * \"payee\": who received the money\n   157→     * \"transaction_date\": date if known (YYYY-MM-DD)\n   158→     * \"transaction_type\": payment/gift/loan/wire_transfer/property/settlement/investment\n   159→     * \"purpose\": reason or context for the transaction\n   160→   - This is CRITICAL - extract ALL financial amounts mentioned\n   161→\n   162→5. EVIDENCE (finding_type: \"evidence\")\n   163→   - Documents, statements, data points\n   164→   - Include: type, source, significance\n   165→   - Note verification status\n   166→\n   167→6. PATTERNS (finding_type: \"pattern\")\n   168→   - Recurring behaviors, methods, structures\n   169→   - Include: description, frequency, participants\n   170→\n   171→7. GAPS (finding_type: \"gap\")\n   172→   - Missing information, unanswered questions\n   173→   - What we don't know and why it matters\n   174→   - Suggested follow-up\n   175→\n   176→For each finding, return:\n   177→- finding_type: One of 'actor', 'event', 'relationship', 'financial', 'evidence', 'pattern', 'gap'\n   178→- content: Detailed finding with specific facts\n   179→- summary: One sentence\n   180→- analysis: YOUR EXPERT ANALYTICAL COMMENTARY (REQUIRED - 2-4 sentences) explaining:\n   181→  * WHY this finding is significant for the investigation\n   182→  * What it IMPLIES about the broader situation\n   183→  * How it CONNECTS to other findings or patterns\n   184→  * What questions it RAISES or answers\n   185→- confidence_score: 0.0-1.0 (based on source quality and corroboration)\n   186→- temporal_context: 'past', 'present', 'ongoing', or 'prediction'\n   187→- extracted_data: JSON object with structured data specific to the finding type\n   188→  - For 'financial': MUST include amount, payer, payee, transaction_type\n   189→\n   190→CRITICAL: The \"analysis\" field must provide substantive reasoning, not just restate the finding.\n   191→Bad example: \"This is an important financial transaction.\"\n   192→Good example: \"This payment pattern suggests a quid pro quo arrangement because the timing coincides with the policy change. The use of intermediary accounts indicates awareness that direct payment would raise red flags. This connects to the earlier lobbying activity and raises questions about who authorized the payment structure.\"\n   193→\n   194→Return as JSON array. Prioritize extracting ALL financial transactions with specific dollar amounts.\n   195→\"\"\"\n   196→\n   197→        result = await self._call_gemini_json(prompt)\n   198→\n   199→        findings = []\n   200→        if isinstance(result, list):\n   201→            for f in result:\n   202→                if isinstance(f, dict):\n   203→                    finding = {\n   204→                        \"finding_type\": f.get(\"finding_type\", \"fact\"),\n   205→                        \"content\": f.get(\"content\", \"\"),\n   206→                        \"summary\": f.get(\"summary\"),\n   207→                        \"analysis\": f.get(\"analysis\", \"\"),\n   208→                        \"confidence_score\": f.get(\"confidence_score\", 0.5),\n   209→                        \"temporal_context\": f.get(\"temporal_context\", \"present\"),\n   210→                        \"extracted_data\": f.get(\"extracted_data\"),\n   211→                    }\n   212→\n   213→                    # Validate analysis field - generate fallback if too short/empty\n   214→                    analysis = finding.get(\"analysis\", \"\")\n   215→                    if not analysis or len(analysis) < 30:\n   216→                        finding_type = finding.get(\"finding_type\", \"fact\")\n   217→                        summary = finding.get(\"summary\", \"\")\n   218→\n   219→                        # Generate contextual fallback analysis based on finding type\n   220→                        type_context = {\n   221→                            \"actor\": \"This actor's role and connections warrant further investigation to understand their influence on events.\",\n   222→                            \"event\": \"This event is significant in the investigative timeline and may have causal links to other developments.\",\n   223→                            \"relationship\": \"This connection reveals potential coordination or influence that could be relevant to the investigation.\",\n   224→                            \"financial\": \"This financial transaction may indicate underlying arrangements that require further scrutiny.\",\n   225→                            \"evidence\": \"This evidence supports key aspects of the investigation and strengthens the evidentiary foundation.\",\n   226→                            \"pattern\": \"This recurring pattern suggests systematic behavior that may indicate intentional coordination.\",\n   227→                            \"gap\": \"This information gap limits our ability to draw complete conclusions and should be addressed.\",\n   228→                        }\n   229→                        finding[\"analysis\"] = type_context.get(finding_type, \"This finding provides relevant context for the investigation.\")\n   230→\n   231→                    findings.append(finding)\n   232→\n   233→        return findings\n   234→\n   235→    # ========== INVESTIGATIVE-SPECIFIC REPORT GENERATION ==========\n   236→\n   237→    def get_supported_report_variants(self) -> List[str]:\n   238→        \"\"\"Investigative template supports risk_assessment variant.\"\"\"\n   239→        return [\"full_report\", \"executive_summary\", \"risk_assessment\"]\n   240→\n   241→    def generate_risk_assessment(\n   242→        self,\n   243→        result: Dict[str, Any],\n   244→        title: Optional[str] = None,\n   245→    ) -> str:\n   246→        \"\"\"Generate risk assessment report - investigative-specific variant.\"\"\"\n   247→        from datetime import datetime\n   248→\n   249→        query = result.get(\"query\", \"Unknown\")\n   250→        report_title = title or f\"Risk Assessment: {query[:40]}\"\n   251→\n   252→        sections = []\n   253→        sections.append(f\"# {report_title}\")\n   254→        sections.append(\"\")\n   255→        sections.append(f\"**Subject:** {query}\")\n   256→        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n   257→        sections.append(\"\")\n   258→        sections.append(\"---\")\n   259→        sections.append(\"\")\n   260→\n   261→        findings = result.get(\"findings\", [])\n   262→\n   263→        # Critical findings (high risk)\n   264→        high_risk = [f for f in findings if f.get(\"finding_type\") in [\"financial\", \"evidence\"]\n   265→                     and f.get(\"confidence_score\", 0) >= 0.7]\n   266→        sections.append(\"## Critical Findings\")\n   267→        sections.append(\"\")\n   268→        if high_risk:\n   269→            for f in high_risk[:6]:\n   270→                sections.append(f\"- **{f.get('finding_type', 'fact').upper()}**: {f.get('summary') or f.get('content', '')[:100]}\")\n   271→        else:\n   272→            sections.append(\"No critical findings identified.\")\n   273→        sections.append(\"\")\n   274→\n   275→        # Key actors\n   276→        actors = [f for f in findings if f.get(\"finding_type\") == \"actor\"]\n   277→        if actors:\n   278→            sections.append(\"## Key Actors\")\n   279→            sections.append(\"\")\n   280→            for actor in actors[:8]:\n   281→                extracted = actor.get(\"extracted_data\", {})\n   282→                if extracted and isinstance(extracted, dict):\n   283→                    name = extracted.get(\"name\", \"\")\n   284→                    role = extracted.get(\"role\", \"\")\n   285→                    if name:\n   286→                        sections.append(f\"- **{name}**: {role}\")\n   287→                else:\n   288→                    sections.append(f\"- {actor.get('summary') or actor.get('content', '')[:80]}\")\n   289→            sections.append(\"\")\n   290→\n   291→        # Financial transactions\n   292→        financial = [f for f in findings if f.get(\"finding_type\") == \"financial\"]\n   293→        if financial:\n   294→            sections.append(\"## Financial Trail\")\n   295→            sections.append(\"\")\n   296→            for txn in financial[:6]:\n   297→                extracted = txn.get(\"extracted_data\", {})\n   298→                if extracted and isinstance(extracted, dict):\n   299→                    amount = extracted.get(\"amount\", \"\")\n   300→                    payer = extracted.get(\"payer\", \"\")\n   301→                    payee = extracted.get(\"payee\", \"\")\n   302→                    if amount:\n   303→                        sections.append(f\"- **${amount:,}** from {payer} to {payee}\")\n   304→                else:\n   305→                    sections.append(f\"- {txn.get('summary') or txn.get('content', '')[:80]}\")\n   306→            sections.append(\"\")\n   307→\n   308→        # Relationships map\n   309→        relationships = [f for f in findings if f.get(\"finding_type\") == \"relationship\"]\n   310→        if relationships:\n   311→            sections.append(\"## Key Relationships\")\n   312→            sections.append(\"\")\n   313→            for rel in relationships[:6]:\n   314→                sections.append(f\"- {rel.get('summary') or rel.get('content', '')[:100]}\")\n   315→            sections.append(\"\")\n   316→\n   317→        # Patterns\n   318→        patterns = [f for f in findings if f.get(\"finding_type\") == \"pattern\"]\n   319→        if patterns:\n   320→            sections.append(\"## Identified Patterns\")\n   321→            sections.append(\"\")\n   322→            for p in patterns[:5]:\n   323→                sections.append(f\"- {p.get('summary') or p.get('content', '')[:100]}\")\n   324→            sections.append(\"\")\n   325→\n   326→        # Knowledge gaps\n   327→        gaps = [f for f in findings if f.get(\"finding_type\") == \"gap\"]\n   328→        if gaps:\n   329→            sections.append(\"## Investigation Gaps\")\n   330→            sections.append(\"\")\n   331→            for g in gaps[:5]:\n   332→                sections.append(f\"- {g.get('summary') or g.get('content', '')[:100]}\")\n   333→            sections.append(\"\")\n   334→\n   335→        # Warnings from perspectives\n   336→        perspectives = result.get(\"perspectives\", [])\n   337→        all_warnings = []\n   338→        for p in perspectives:\n   339→            all_warnings.extend(p.get(\"warnings\", []))\n   340→        if all_warnings:\n   341→            sections.append(\"## Risk Warnings\")\n   342→            sections.append(\"\")\n   343→            for warning in all_warnings[:6]:\n   344→                sections.append(f\"- {warning}\")\n   345→            sections.append(\"\")\n   346→\n   347→        return \"\\n\".join(sections)\n   348→\n   349→    def _get_priority_findings(self, findings: List[Dict[str, Any]]) -> List[Dict[str, Any]]:\n   350→        \"\"\"Investigative template prioritizes actors, financial, and evidence.\"\"\"\n   351→        # Priority order for investigative findings\n   352→        priority_types = [\"financial\", \"evidence\", \"actor\", \"relationship\", \"pattern\"]\n   353→        prioritized = []\n   354→\n   355→        for ftype in priority_types:\n   356→            type_findings = [f for f in findings if f.get(\"finding_type\") == ftype]\n   357→            prioritized.extend(sorted(\n   358→                type_findings,\n   359→                key=lambda x: x.get(\"confidence_score\", 0),\n   360→                reverse=True\n   361→            ))\n   362→\n   363→        # Add remaining\n   364→        remaining = [f for f in findings if f not in prioritized]\n   365→        prioritized.extend(sorted(remaining, key=lambda x: x.get(\"confidence_score\", 0), reverse=True))\n   366→\n   367→        return prioritized\n   368→\n   369→    def _group_findings(self, findings: List[Dict[str, Any]]) -> Dict[str, List[Dict[str, Any]]]:\n   370→        \"\"\"Group findings with investigative priority order.\"\"\"\n   371→        # Custom order for investigative reports\n   372→        order = [\"financial\", \"actor\", \"relationship\", \"evidence\", \"event\", \"pattern\", \"gap\", \"other\"]\n   373→        grouped: Dict[str, List[Dict[str, Any]]] = {}\n   374→\n   375→        for ftype in order:\n   376→            type_findings = [f for f in findings if f.get(\"finding_type\") == ftype]\n   377→            if type_findings:\n   378→                grouped[ftype] = type_findings\n   379→\n   380→        # Add any remaining types not in order\n   381→        for f in findings:\n   382→            ftype = f.get(\"finding_type\", \"other\")\n   383→            if ftype not in grouped:\n   384→                grouped[ftype] = []\n   385→            if f not in grouped.get(ftype, []):\n   386→                grouped.setdefault(ftype, []).append(f)\n   387→\n   388→        return grouped\n   389→\n   390→    def _generate_key_sections(self, result: Dict[str, Any]) -> str:\n   391→        \"\"\"Generate investigative-specific key sections: Actor map, Financial trail.\"\"\"\n   392→        findings = result.get(\"findings\", [])\n   393→        sections = []\n   394→\n   395→        # Key Actors Summary\n   396→        actors = [f for f in findings if f.get(\"finding_type\") == \"actor\"]\n   397→        if actors:\n   398→            sections.append(\"## Key Actors Summary\")\n   399→            sections.append(\"\")\n   400→            for actor in actors[:5]:\n   401→                sections.append(f\"- {actor.get('summary') or actor.get('content', '')[:100]}\")\n   402→            sections.append(\"\")\n   403→\n   404→        # Financial Trail Summary\n   405→        financial = [f for f in findings if f.get(\"finding_type\") == \"financial\"]\n   406→        if financial:\n   407→            sections.append(\"## Financial Trail Summary\")\n   408→            sections.append(\"\")\n   409→            for txn in financial[:5]:\n   410→                sections.append(f\"- {txn.get('summary') or txn.get('content', '')[:100]}\")\n   411→            sections.append(\"\")\n   412→\n   413→        return \"\\n\".join(sections)\n   414→\n   415→    def _generate_executive_highlights(self, result: Dict[str, Any]) -> str:\n   416→        \"\"\"Generate investigative-specific executive highlights.\"\"\"\n   417→        findings = result.get(\"findings\", [])\n   418→        sections = []\n   419→\n   420→        # Critical evidence highlight\n   421→        evidence = [f for f in findings if f.get(\"finding_type\") == \"evidence\"\n   422→                    and f.get(\"confidence_score\", 0) >= 0.7]\n   423→        if evidence:\n   424→            sections.append(\"## Critical Evidence\")\n   425→            sections.append(\"\")\n   426→            for e in evidence[:3]:\n   427→                sections.append(f\"- {e.get('summary') or e.get('content', '')[:100]}\")\n   428→            sections.append(\"\")\n   429→\n   430→        return \"\\n\".join(sections)\n   431→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"82343d47-30e9-47a3-93fa-efd2489cfa93","uuid":"2b904dc0-bf26-4799-876f-04d6bc3262e9","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\actor\\src\\templates\\investigative.py","content":"\"\"\"Investigative journalism research template.\"\"\"\n\nfrom typing import List, Dict, Any, Optional\n\nfrom .base import BaseTemplate\nfrom ..services.report_components import (\n    ComponentType, ComponentConfig, ReportHints, get_report_hints\n)\n\n\nclass InvestigativeTemplate(BaseTemplate):\n    \"\"\"Template for investigative journalism research.\"\"\"\n\n    template_id = \"investigative\"\n    template_name = \"Investigative Research\"\n    description = \"Deep investigative journalism with actor and relationship analysis\"\n\n    # Report hints for component-based rendering\n    report_hints = ReportHints(\n        template_type=\"investigative\",\n        structure=\"narrative_first\",\n        findings_grouping=\"chronological\",\n        tone=\"investigative\",\n        decision_format=\"recommendation\",\n        emphasis=[\"evidence\", \"timeline\", \"key_actors\", \"implications\"],\n        required_components=[\n            ComponentType.INVESTIGATION_TIMELINE,\n            ComponentType.FINDINGS_TABLE,\n            ComponentType.QUOTE_CAROUSEL,\n        ],\n        optional_components=[\n            ComponentType.KEY_INSIGHTS,\n            ComponentType.RISK_MATRIX,\n            ComponentType.CHECKLIST,\n            ComponentType.SOURCE_LIST,\n        ],\n        visualization_preference=[\"investigation_timeline\", \"evidence_network\", \"actor_map\"],\n        custom_sections={\n            \"show_financial_trail\": True,\n            \"highlight_actors\": True,\n            \"evidence_strength_indicators\": True,\n        }\n    )\n\n    # Expert perspectives for deep investigative analysis\n    default_perspectives = [\n        \"forensic_financial\",      # Follow the money, fraud detection\n        \"power_network\",           # Map influence networks and institutional capture\n        \"psychological_behavioral\", # Analyze motivations and credibility\n        \"legal_liability\",          # Assess legal exposure and enforcement risk\n        \"geopolitical_strategic\",   # Strategic interests and power dynamics\n    ]\n\n    default_max_searches = 8\n\n    # Investigative requires thorough verification on all dimensions\n    # Critical to verify claims, detect cover-ups, and identify spin\n    verification_config = {\n        \"cross_reference\": \"thorough\",      # Must corroborate claims\n        \"bias_detection\": \"thorough\",       # Detect PR spin, cover-ups\n        \"expert_sanity_check\": \"thorough\",  # Flag implausible claims\n        \"source_quality\": \"thorough\",       # Primary sources critical\n    }\n\n    async def generate_search_queries(\n        self,\n        query: str,\n        max_searches: int,\n        granularity: str = \"standard\",\n    ) -> List[str]:\n        \"\"\"Generate investigative search queries.\"\"\"\n        prompt = f\"\"\"\nYou are an investigative journalist planning research queries for a deep investigation.\n\nInvestigation Topic: {query}\n\nDepth Level: {granularity}\n\nGenerate search queries covering these investigative angles:\n1. KEY ACTORS: Who are the main people/organizations involved?\n2. TIMELINE: What events happened and when?\n3. LOCATIONS: Where did key events occur? What jurisdictions are involved?\n4. MOTIVATIONS: What are the underlying interests and relationships?\n5. METHODS: How were things done? What mechanisms were used?\n6. MONEY TRAIL: Financial connections and transactions\n7. OFFICIAL RECORDS: Government filings, court documents, regulatory actions\n8. MEDIA COVERAGE: News reports, interviews, public statements\n\nFor a \"{granularity}\" depth level:\n- \"quick\": Focus on 1-3 most critical angles\n- \"standard\": Cover 4-5 key angles with balanced depth\n- \"deep\": Comprehensive coverage of all angles with follow-up queries\n\nReturn a JSON array of exactly {max_searches} search query strings, ordered by importance.\nExample: [\"query about main actor\", \"query about key event\", ...]\n\"\"\"\n\n        result = await self._call_gemini_json(prompt)\n\n        if isinstance(result, list):\n            return result[:max_searches]\n        return []\n\n    async def extract_findings(\n        self,\n        query: str,\n        sources: List[Dict[str, Any]],\n        synthesized_content: str,\n        granularity: str = \"standard\",\n    ) -> List[Dict[str, Any]]:\n        \"\"\"Extract investigative findings.\"\"\"\n        # Build source context\n        source_context = \"\\n\\n\".join([\n            f\"Source: {s.get('title', 'Unknown')} ({s.get('url', '')})\\n\"\n            f\"Credibility: {s.get('credibility_score', 'Unknown')}\\n\"\n            f\"Domain: {s.get('domain', '')}\"\n            for s in sources[:20]\n        ])\n\n        prompt = f\"\"\"\nYou are an investigative analyst extracting key findings for a deep investigation.\n\nInvestigation Topic: {query}\n\nSynthesized Research Content:\n{synthesized_content[:15000]}\n\nSources Referenced:\n{source_context}\n\nExtract findings in these investigative categories:\n\n1. ACTORS (finding_type: \"actor\")\n   - People, organizations, entities involved\n   - Include: name, role, affiliations, significance\n   - Note any aliases or connections\n\n2. EVENTS (finding_type: \"event\")\n   - Key incidents, actions, decisions\n   - Include: date (if known), location, participants, outcome\n   - Note sequence and causation\n\n3. RELATIONSHIPS (finding_type: \"relationship\")\n   - Connections between actors\n   - Types: personal, professional, political, criminal\n   - Include strength of evidence\n\n4. FINANCIAL TRANSACTIONS (finding_type: \"financial\")\n   - ANY money movement: payments, gifts, loans, wire transfers, settlements\n   - Property purchases, sales, or transfers\n   - Investments, donations, or funding\n   - Include in extracted_data:\n     * \"amount\": dollar amount (number)\n     * \"currency\": \"USD\", \"GBP\", etc.\n     * \"payer\": who paid/gave the money\n     * \"payee\": who received the money\n     * \"transaction_date\": date if known (YYYY-MM-DD)\n     * \"transaction_type\": payment/gift/loan/wire_transfer/property/settlement/investment\n     * \"purpose\": reason or context for the transaction\n   - This is CRITICAL - extract ALL financial amounts mentioned\n\n5. EVIDENCE (finding_type: \"evidence\")\n   - Documents, statements, data points\n   - Include: type, source, significance\n   - Note verification status\n\n6. PATTERNS (finding_type: \"pattern\")\n   - Recurring behaviors, methods, structures\n   - Include: description, frequency, participants\n\n7. GAPS (finding_type: \"gap\")\n   - Missing information, unanswered questions\n   - What we don't know and why it matters\n   - Suggested follow-up\n\nFor each finding, return:\n- finding_type: One of 'actor', 'event', 'relationship', 'financial', 'evidence', 'pattern', 'gap'\n- content: Detailed finding with specific facts\n- summary: One sentence\n- analysis: YOUR EXPERT ANALYTICAL COMMENTARY (REQUIRED - 2-4 sentences) explaining:\n  * WHY this finding is significant for the investigation\n  * What it IMPLIES about the broader situation\n  * How it CONNECTS to other findings or patterns\n  * What questions it RAISES or answers\n- confidence_score: 0.0-1.0 (based on source quality and corroboration)\n- temporal_context: 'past', 'present', 'ongoing', or 'prediction'\n- extracted_data: JSON object with structured data specific to the finding type\n  - For 'financial': MUST include amount, payer, payee, transaction_type\n\nCRITICAL: The \"analysis\" field must provide substantive reasoning, not just restate the finding.\nBad example: \"This is an important financial transaction.\"\nGood example: \"This payment pattern suggests a quid pro quo arrangement because the timing coincides with the policy change. The use of intermediary accounts indicates awareness that direct payment would raise red flags. This connects to the earlier lobbying activity and raises questions about who authorized the payment structure.\"\n\nReturn as JSON array. Prioritize extracting ALL financial transactions with specific dollar amounts.\n\"\"\"\n\n        result = await self._call_gemini_json(prompt)\n\n        findings = []\n        if isinstance(result, list):\n            for f in result:\n                if isinstance(f, dict):\n                    finding = {\n                        \"finding_type\": f.get(\"finding_type\", \"fact\"),\n                        \"content\": f.get(\"content\", \"\"),\n                        \"summary\": f.get(\"summary\"),\n                        \"analysis\": f.get(\"analysis\", \"\"),\n                        \"confidence_score\": f.get(\"confidence_score\", 0.5),\n                        \"temporal_context\": f.get(\"temporal_context\", \"present\"),\n                        \"extracted_data\": f.get(\"extracted_data\"),\n                    }\n\n                    # Validate analysis field - generate fallback if too short/empty\n                    analysis = finding.get(\"analysis\", \"\")\n                    if not analysis or len(analysis) < 30:\n                        finding_type = finding.get(\"finding_type\", \"fact\")\n                        summary = finding.get(\"summary\", \"\")\n\n                        # Generate contextual fallback analysis based on finding type\n                        type_context = {\n                            \"actor\": \"This actor's role and connections warrant further investigation to understand their influence on events.\",\n                            \"event\": \"This event is significant in the investigative timeline and may have causal links to other developments.\",\n                            \"relationship\": \"This connection reveals potential coordination or influence that could be relevant to the investigation.\",\n                            \"financial\": \"This financial transaction may indicate underlying arrangements that require further scrutiny.\",\n                            \"evidence\": \"This evidence supports key aspects of the investigation and strengthens the evidentiary foundation.\",\n                            \"pattern\": \"This recurring pattern suggests systematic behavior that may indicate intentional coordination.\",\n                            \"gap\": \"This information gap limits our ability to draw complete conclusions and should be addressed.\",\n                        }\n                        finding[\"analysis\"] = type_context.get(finding_type, \"This finding provides relevant context for the investigation.\")\n\n                    findings.append(finding)\n\n        return findings\n\n    # ========== INVESTIGATIVE-SPECIFIC REPORT GENERATION ==========\n\n    def get_supported_report_variants(self) -> List[str]:\n        \"\"\"Investigative template supports risk_assessment variant.\"\"\"\n        return [\"full_report\", \"executive_summary\", \"risk_assessment\"]\n\n    def generate_risk_assessment(\n        self,\n        result: Dict[str, Any],\n        title: Optional[str] = None,\n    ) -> str:\n        \"\"\"Generate risk assessment report - investigative-specific variant.\"\"\"\n        from datetime import datetime\n\n        query = result.get(\"query\", \"Unknown\")\n        report_title = title or f\"Risk Assessment: {query[:40]}\"\n\n        sections = []\n        sections.append(f\"# {report_title}\")\n        sections.append(\"\")\n        sections.append(f\"**Subject:** {query}\")\n        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n        sections.append(\"\")\n        sections.append(\"---\")\n        sections.append(\"\")\n\n        findings = result.get(\"findings\", [])\n\n        # Critical findings (high risk)\n        high_risk = [f for f in findings if f.get(\"finding_type\") in [\"financial\", \"evidence\"]\n                     and f.get(\"confidence_score\", 0) >= 0.7]\n        sections.append(\"## Critical Findings\")\n        sections.append(\"\")\n        if high_risk:\n            for f in high_risk[:6]:\n                sections.append(f\"- **{f.get('finding_type', 'fact').upper()}**: {f.get('summary') or f.get('content', '')[:100]}\")\n        else:\n            sections.append(\"No critical findings identified.\")\n        sections.append(\"\")\n\n        # Key actors\n        actors = [f for f in findings if f.get(\"finding_type\") == \"actor\"]\n        if actors:\n            sections.append(\"## Key Actors\")\n            sections.append(\"\")\n            for actor in actors[:8]:\n                extracted = actor.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    name = extracted.get(\"name\", \"\")\n                    role = extracted.get(\"role\", \"\")\n                    if name:\n                        sections.append(f\"- **{name}**: {role}\")\n                else:\n                    sections.append(f\"- {actor.get('summary') or actor.get('content', '')[:80]}\")\n            sections.append(\"\")\n\n        # Financial transactions\n        financial = [f for f in findings if f.get(\"finding_type\") == \"financial\"]\n        if financial:\n            sections.append(\"## Financial Trail\")\n            sections.append(\"\")\n            for txn in financial[:6]:\n                extracted = txn.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    amount = extracted.get(\"amount\", \"\")\n                    payer = extracted.get(\"payer\", \"\")\n                    payee = extracted.get(\"payee\", \"\")\n                    if amount:\n                        sections.append(f\"- **${amount:,}** from {payer} to {payee}\")\n                else:\n                    sections.append(f\"- {txn.get('summary') or txn.get('content', '')[:80]}\")\n            sections.append(\"\")\n\n        # Relationships map\n        relationships = [f for f in findings if f.get(\"finding_type\") == \"relationship\"]\n        if relationships:\n            sections.append(\"## Key Relationships\")\n            sections.append(\"\")\n            for rel in relationships[:6]:\n                sections.append(f\"- {rel.get('summary') or rel.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Patterns\n        patterns = [f for f in findings if f.get(\"finding_type\") == \"pattern\"]\n        if patterns:\n            sections.append(\"## Identified Patterns\")\n            sections.append(\"\")\n            for p in patterns[:5]:\n                sections.append(f\"- {p.get('summary') or p.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Knowledge gaps\n        gaps = [f for f in findings if f.get(\"finding_type\") == \"gap\"]\n        if gaps:\n            sections.append(\"## Investigation Gaps\")\n            sections.append(\"\")\n            for g in gaps[:5]:\n                sections.append(f\"- {g.get('summary') or g.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Warnings from perspectives\n        perspectives = result.get(\"perspectives\", [])\n        all_warnings = []\n        for p in perspectives:\n            all_warnings.extend(p.get(\"warnings\", []))\n        if all_warnings:\n            sections.append(\"## Risk Warnings\")\n            sections.append(\"\")\n            for warning in all_warnings[:6]:\n                sections.append(f\"- {warning}\")\n            sections.append(\"\")\n\n        return \"\\n\".join(sections)\n\n    def _get_priority_findings(self, findings: List[Dict[str, Any]]) -> List[Dict[str, Any]]:\n        \"\"\"Investigative template prioritizes actors, financial, and evidence.\"\"\"\n        # Priority order for investigative findings\n        priority_types = [\"financial\", \"evidence\", \"actor\", \"relationship\", \"pattern\"]\n        prioritized = []\n\n        for ftype in priority_types:\n            type_findings = [f for f in findings if f.get(\"finding_type\") == ftype]\n            prioritized.extend(sorted(\n                type_findings,\n                key=lambda x: x.get(\"confidence_score\", 0),\n                reverse=True\n            ))\n\n        # Add remaining\n        remaining = [f for f in findings if f not in prioritized]\n        prioritized.extend(sorted(remaining, key=lambda x: x.get(\"confidence_score\", 0), reverse=True))\n\n        return prioritized\n\n    def _group_findings(self, findings: List[Dict[str, Any]]) -> Dict[str, List[Dict[str, Any]]]:\n        \"\"\"Group findings with investigative priority order.\"\"\"\n        # Custom order for investigative reports\n        order = [\"financial\", \"actor\", \"relationship\", \"evidence\", \"event\", \"pattern\", \"gap\", \"other\"]\n        grouped: Dict[str, List[Dict[str, Any]]] = {}\n\n        for ftype in order:\n            type_findings = [f for f in findings if f.get(\"finding_type\") == ftype]\n            if type_findings:\n                grouped[ftype] = type_findings\n\n        # Add any remaining types not in order\n        for f in findings:\n            ftype = f.get(\"finding_type\", \"other\")\n            if ftype not in grouped:\n                grouped[ftype] = []\n            if f not in grouped.get(ftype, []):\n                grouped.setdefault(ftype, []).append(f)\n\n        return grouped\n\n    def _generate_key_sections(self, result: Dict[str, Any]) -> str:\n        \"\"\"Generate investigative-specific key sections: Actor map, Financial trail.\"\"\"\n        findings = result.get(\"findings\", [])\n        sections = []\n\n        # Key Actors Summary\n        actors = [f for f in findings if f.get(\"finding_type\") == \"actor\"]\n        if actors:\n            sections.append(\"## Key Actors Summary\")\n            sections.append(\"\")\n            for actor in actors[:5]:\n                sections.append(f\"- {actor.get('summary') or actor.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Financial Trail Summary\n        financial = [f for f in findings if f.get(\"finding_type\") == \"financial\"]\n        if financial:\n            sections.append(\"## Financial Trail Summary\")\n            sections.append(\"\")\n            for txn in financial[:5]:\n                sections.append(f\"- {txn.get('summary') or txn.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        return \"\\n\".join(sections)\n\n    def _generate_executive_highlights(self, result: Dict[str, Any]) -> str:\n        \"\"\"Generate investigative-specific executive highlights.\"\"\"\n        findings = result.get(\"findings\", [])\n        sections = []\n\n        # Critical evidence highlight\n        evidence = [f for f in findings if f.get(\"finding_type\") == \"evidence\"\n                    and f.get(\"confidence_score\", 0) >= 0.7]\n        if evidence:\n            sections.append(\"## Critical Evidence\")\n            sections.append(\"\")\n            for e in evidence[:3]:\n                sections.append(f\"- {e.get('summary') or e.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        return \"\\n\".join(sections)\n","numLines":431,"startLine":1,"totalLines":431}}}
