[2026-01-30T09:07:35.632Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HA6EumsoCkHt6s6xevpeGy","type":"tool_result","content":"     1→\"\"\"Contract analysis template for government contracts, pricing, and corruption detection.\"\"\"\n     2→\n     3→from typing import List, Dict, Any, Optional\n     4→\n     5→from .base import BaseTemplate\n     6→from ..services.report_components import (\n     7→    ComponentType, ComponentConfig, ReportHints, get_report_hints\n     8→)\n     9→\n    10→\n    11→class ContractTemplate(BaseTemplate):\n    12→    \"\"\"Template for government contract evaluation and corruption detection.\"\"\"\n    13→\n    14→    template_id = \"contract\"\n    15→    template_name = \"Government Contract Analysis\"\n    16→    description = \"Analyze state/government contracts for overpricing, corruption, and suspicious elements\"\n    17→\n    18→    # Report hints for component-based rendering\n    19→    report_hints = ReportHints(\n    20→        template_type=\"contract\",\n    21→        structure=\"balanced\",\n    22→        findings_grouping=\"category\",\n    23→        tone=\"professional\",\n    24→        decision_format=\"checklist\",\n    25→        emphasis=[\"key_terms\", \"obligations\", \"risks\", \"opportunities\"],\n    26→        required_components=[\n    27→            ComponentType.CONTRACT_ANALYSIS,\n    28→            ComponentType.CHECKLIST,\n    29→            ComponentType.RISK_MATRIX,\n    30→        ],\n    31→        optional_components=[\n    32→            ComponentType.FINDINGS_TABLE,\n    33→            ComponentType.ACTION_ITEMS,\n    34→            ComponentType.COMPARISON_TABLE,\n    35→            ComponentType.KEY_INSIGHTS,\n    36→        ],\n    37→        visualization_preference=[\"contract_structure\", \"obligation_timeline\", \"risk_assessment\"],\n    38→        custom_sections={\n    39→            \"show_pricing_comparison\": True,\n    40→            \"red_flag_priority\": True,\n    41→            \"vendor_history\": True,\n    42→        }\n    43→    )\n    44→\n    45→    # Expert perspectives for contract analysis\n    46→    default_perspectives = [\n    47→        \"contract_auditor\",           # Pricing and cost analysis\n    48→        \"procurement_investigator\",   # Bid process, competition issues\n    49→        \"forensic_accountant\",        # Financial red flags\n    50→        \"regulatory_compliance\",      # Legal requirements\n    51→        \"industry_benchmarker\",       # Market rate comparison\n    52→    ]\n    53→\n    54→    default_max_searches = 12\n    55→\n    56→    # Thorough verification for fraud detection\n    57→    verification_config = {\n    58→        \"cross_reference\": \"thorough\",\n    59→        \"bias_detection\": \"thorough\",\n    60→        \"expert_sanity_check\": \"thorough\",\n    61→        \"source_quality\": \"thorough\",\n    62→    }\n    63→\n    64→    async def generate_search_queries(\n    65→        self,\n    66→        query: str,\n    67→        max_searches: int,\n    68→        granularity: str = \"standard\",\n    69→    ) -> List[str]:\n    70→        \"\"\"Generate contract-specific search queries.\"\"\"\n    71→        prompt = f\"\"\"\n    72→You are a government contract analyst and fraud investigator planning research queries\n    73→to analyze contracts for overpricing, corruption risks, and suspicious elements.\n    74→\n    75→CONTRACT/TOPIC TO ANALYZE: {query}\n    76→\n    77→Depth Level: {granularity}\n    78→\n    79→Generate search queries covering these critical investigation areas:\n    80→\n    81→1. VENDOR/CONTRACTOR BACKGROUND\n    82→   - Company registration, incorporation date, ownership history\n    83→   - Key executives and beneficial owners\n    84→   - Prior government contracts with this vendor\n    85→   - Complaints, lawsuits, debarment history\n    86→   - Related companies, subsidiaries, DBAs\n    87→   - Political donations by company or executives\n    88→\n    89→2. PRICING BENCHMARK RESEARCH\n    90→   - Industry standard rates for similar work/services\n    91→   - Government rate schedules (GSA schedules for federal)\n    92→   - Comparable contracts in same sector/region\n    93→   - Unit pricing for common line items\n    94→   - Labor rate comparisons (prevailing wage data)\n    95→   - Material cost benchmarks\n    96→\n    97→3. BID PROCESS AND COMPETITION\n    98→   - Other bidders on this contract (if public)\n    99→   - Similar recent solicitations for comparison\n   100→   - Sole-source justification patterns\n   101→   - Bid protest history\n   102→   - Procurement officer history and patterns\n   103→\n   104→4. CONTRACT MODIFICATIONS AND OVERRUNS\n   105→   - Change order patterns on similar contracts\n   106→   - Amendment and modification history\n   107→   - Cost overrun statistics in sector\n   108→   - Schedule extension patterns\n   109→   - Scope creep indicators\n   110→\n   111→5. VENDOR PERFORMANCE HISTORY\n   112→   - Past performance evaluations (PPIRS for federal)\n   113→   - Completed projects: on-time, on-budget?\n   114→   - Quality issues, defects, rework\n   115→   - Customer complaints and disputes\n   116→   - Warranty claims and callbacks\n   117→\n   118→6. CONNECTED ENTITIES AND CONFLICTS\n   119→   - Subcontractor relationships\n   120→   - Joint venture partners\n   121→   - Related party transactions\n   122→   - Revolving door: former officials now at vendor\n   123→   - Family connections to agency staff\n   124→   - Shell company indicators\n   125→\n   126→7. REGULATORY AND COMPLIANCE\n   127→   - Required certifications/licenses\n   128→   - Small business set-aside compliance\n   129→   - DBE/MBE/WBE certification verification\n   130→   - Insurance and bonding requirements\n   131→   - DCAA audit findings (federal)\n   132→\n   133→8. NEWS AND INVESTIGATIONS\n   134→   - Media coverage of vendor or contract\n   135→   - Inspector General reports\n   136→   - GAO/state auditor findings\n   137→   - Whistleblower complaints\n   138→   - FBI/DOJ investigations in sector\n   139→\n   140→9. CONSTRUCTION-SPECIFIC (if applicable)\n   141→   - Prevailing wage compliance\n   142→   - OSHA violations\n   143→   - Environmental compliance\n   144→   - Permit and inspection history\n   145→   - Subcontractor payment disputes\n   146→\n   147→10. SOFTWARE/IT-SPECIFIC (if applicable)\n   148→    - Similar IT projects cost/duration\n   149→    - Technology stack market rates\n   150→    - Developer/consultant hourly rates\n   151→    - Software license fair pricing\n   152→    - Customization vs. COTS analysis\n   153→\n   154→For \"{granularity}\" depth level:\n   155→- quick (4-5): Focus on vendor background + pricing benchmark + news/issues\n   156→- standard (8-10): Add bid process + performance + connected entities\n   157→- deep (12+): All angles with multiple queries per angle, deep ownership research\n   158→\n   159→Return a JSON array of exactly {max_searches} search query strings.\n   160→Make queries SPECIFIC to the contract details provided. Include:\n   161→- Vendor/company name if mentioned\n   162→- Agency/government entity if mentioned\n   163→- Project type and location if mentioned\n   164→- Dollar amounts or timeframes if mentioned\n   165→\n   166→Example: [\"ABC Construction LLC government contracts history complaints\", \"highway construction prevailing wage rates 2024 Texas\", ...]\n   167→\"\"\"\n   168→\n   169→        result = await self._call_gemini_json(prompt)\n   170→\n   171→        if isinstance(result, list):\n   172→            return result[:max_searches]\n   173→        return []\n   174→\n   175→    async def extract_findings(\n   176→        self,\n   177→        query: str,\n   178→        sources: List[Dict[str, Any]],\n   179→        synthesized_content: str,\n   180→        granularity: str = \"standard\",\n   181→    ) -> List[Dict[str, Any]]:\n   182→        \"\"\"Extract contract analysis findings with fraud indicators.\"\"\"\n   183→        # Build source context\n   184→        source_context = \"\\n\\n\".join([\n   185→            f\"Source: {s.get('title', 'Unknown')} ({s.get('url', '')})\\n\"\n   186→            f\"Credibility: {s.get('credibility_score', 'Unknown')}\\n\"\n   187→            f\"Domain: {s.get('domain', '')}\"\n   188→            for s in sources[:20]\n   189→        ])\n   190→\n   191→        prompt = f\"\"\"\n   192→You are a government contract auditor and fraud investigator extracting findings\n   193→from research on a contract or contractor. Your goal is to identify red flags,\n   194→pricing anomalies, and corruption indicators.\n   195→\n   196→CONTRACT/TOPIC ANALYZED: {query}\n   197→\n   198→Synthesized Research Content:\n   199→{synthesized_content[:15000]}\n   200→\n   201→Sources Referenced:\n   202→{source_context}\n   203→\n   204→Extract findings in these contract analysis categories:\n   205→\n   206→1. CONTRACT ENTITY (finding_type: \"contract_entity\")\n   207→   - Key parties: vendor, agency, contracting officer, subcontractors\n   208→   - Include in extracted_data: entity_name, entity_type, role, registration_info\n   209→   - Note: ownership structure, key personnel\n   210→\n   211→2. CONTRACT TERMS (finding_type: \"contract_terms\")\n   212→   - Value, duration, payment schedule, key rates\n   213→   - Include in extracted_data: total_value, duration, payment_terms, key_rates, type (fixed/cost-plus)\n   214→   - Note: unusual terms, milestone payments\n   215→\n   216→3. PRICING ANALYSIS (finding_type: \"pricing_analysis\")\n   217→   - Cost breakdown, unit rates, comparison to market\n   218→   - Include in extracted_data: item, proposed_rate, market_rate, variance_percent, benchmark_source\n   219→   - Note: overhead, profit margins, labor vs. materials\n   220→\n   221→4. BID PROCESS FINDING (finding_type: \"bid_process\")\n   222→   - Competition level, bidders, evaluation criteria\n   223→   - Include in extracted_data: bid_count, bidder_names, award_basis, competition_type\n   224→   - Note: sole-source justifications, bid rotation patterns\n   225→\n   226→5. SUSPICIOUS ELEMENT (finding_type: \"suspicious_element\") - HIGH PRIORITY\n   227→   - Unusual terms, sweetheart deals, conflict indicators\n   228→   - Include in extracted_data:\n   229→     * \"element_type\": type of suspicious activity\n   230→     * \"description\": what was found\n   231→     * \"severity\": \"high\" | \"medium\" | \"low\"\n   232→     * \"related_parties\": who is involved\n   233→     * \"evidence\": supporting facts\n   234→   - Examples: related party transactions, revolving door, bid steering\n   235→\n   236→6. CONNECTED ENTITY (finding_type: \"connected_entity\")\n   237→   - Related parties, shell companies, family businesses\n   238→   - Include in extracted_data: primary_entity, connected_entity, relationship_type, evidence\n   239→   - Note: ownership overlaps, shared addresses, common executives\n   240→\n   241→7. COMPLIANCE ISSUE (finding_type: \"compliance_issue\")\n   242→   - Regulatory violations, missing documentation\n   243→   - Include in extracted_data: requirement, status, violation_type, consequence\n   244→   - Note: licensing, certifications, insurance, bonding\n   245→\n   246→8. PERFORMANCE ISSUE (finding_type: \"performance_issue\")\n   247→   - Delays, cost overruns, quality problems\n   248→   - Include in extracted_data: issue_type, original_value, actual_value, variance, cause\n   249→   - Note: pattern across multiple contracts\n   250→\n   251→9. COMPARABLE CONTRACT (finding_type: \"comparable_contract\")\n   252→   - Similar contracts for benchmarking\n   253→   - Include in extracted_data: contract_id, agency, vendor, value, scope, outcome\n   254→   - Note: price per unit/sq ft/hour comparisons\n   255→\n   256→10. RED FLAG (finding_type: \"red_flag\") - CRITICAL\n   257→    - Strong corruption or fraud indicators\n   258→    - Include in extracted_data:\n   259→      * \"flag_type\": category of red flag\n   260→      * \"description\": specific concern\n   261→      * \"risk_level\": \"high\" | \"critical\"\n   262→      * \"supporting_evidence\": list of facts\n   263→      * \"recommended_investigation\": next steps\n   264→    - Examples: phantom vendors, kickbacks, bid rigging, overbilling\n   265→\n   266→11. GAP (finding_type: \"gap\")\n   267→    - Missing critical information needed\n   268→    - Include in extracted_data: information_needed, importance (high/medium/low), impact_on_analysis\n   269→    - Note: what documents/data would help investigation\n   270→\n   271→12. DATE/TIMELINE (finding_type: \"date_timeline\")\n   272→    - Important dates and timeline inconsistencies\n   273→    - Include in extracted_data: event, date, significance, related_events\n   274→    - Note: contract award before bid deadline, rushed timelines\n   275→\n   276→For each finding, return:\n   277→- finding_type: One of the types above\n   278→- content: Detailed finding with specific facts, numbers, names\n   279→- summary: One sentence summary\n   280→- analysis: YOUR EXPERT INVESTIGATIVE ANALYSIS (REQUIRED - 2-4 sentences) explaining:\n   281→  * WHY this finding is significant for contract oversight or fraud detection\n   282→  * What PATTERN or RED FLAG this represents in government contracting\n   283→  * How this COMPARES to normal contracting practices or known fraud schemes\n   284→  * What FURTHER INVESTIGATION or action this finding warrants\n   285→- confidence_score: 0.0-1.0 (based on source quality and evidence strength)\n   286→- temporal_context: 'past', 'present', 'ongoing', or 'predicted'\n   287→- event_date: ISO date if known (YYYY-MM-DD)\n   288→- date_referenced: Specific date mentioned in finding (e.g., \"December 15, 2024\")\n   289→- date_range: Date range if applicable (e.g., \"Q4 2024\", \"2023-2025\")\n   290→- extracted_data: JSON object with structured data specific to finding type\n   291→\n   292→CRITICAL: The \"analysis\" field must provide substantive investigative reasoning, not just describe the finding.\n   293→Good example: \"This 40% price premium over market rate is a significant red flag in competitive bid environments. In similar cases, inflated pricing of this magnitude has been associated with kickback schemes where the excess margin funds illicit payments. The fact that this vendor has previously worked with the contracting officer warrants examination of their relationship and any campaign contributions or post-employment arrangements.\"\n   294→\n   295→For \"{granularity}\" depth:\n   296→- quick: 8-10 findings focusing on major red flags and pricing\n   297→- standard: 15-20 findings with balanced coverage of all areas\n   298→- deep: 25-30 comprehensive findings with full investigation support\n   299→\n   300→CRITICAL: Prioritize RED_FLAG and SUSPICIOUS_ELEMENT findings. If you identify\n   301→potential fraud indicators, ensure they are captured even if confidence is moderate.\n   302→False negatives (missing fraud) are worse than false positives (flagging non-issues).\n   303→\n   304→Return as JSON array.\n   305→\"\"\"\n   306→\n   307→        result = await self._call_gemini_json(prompt)\n   308→\n   309→        findings = []\n   310→        if isinstance(result, list):\n   311→            for f in result:\n   312→                if isinstance(f, dict):\n   313→                    findings.append({\n   314→                        \"finding_type\": f.get(\"finding_type\", \"fact\"),\n   315→                        \"content\": f.get(\"content\", \"\"),\n   316→                        \"summary\": f.get(\"summary\"),\n   317→                        \"analysis\": f.get(\"analysis\", \"\"),\n   318→                        \"confidence_score\": f.get(\"confidence_score\", 0.5),\n   319→                        \"temporal_context\": f.get(\"temporal_context\", \"present\"),\n   320→                        \"event_date\": f.get(\"event_date\"),\n   321→                        \"date_referenced\": f.get(\"date_referenced\"),\n   322→                        \"date_range\": f.get(\"date_range\"),\n   323→                        \"extracted_data\": f.get(\"extracted_data\"),\n   324→                    })\n   325→\n   326→        return findings\n   327→\n   328→    # ========== CONTRACT-SPECIFIC REPORT GENERATION ==========\n   329→\n   330→    def get_supported_report_variants(self) -> List[str]:\n   331→        \"\"\"Contract template supports red_flags_summary and pricing_analysis variants.\"\"\"\n   332→        return [\"full_report\", \"executive_summary\", \"red_flags_summary\", \"pricing_analysis\"]\n   333→\n   334→    def generate_red_flags_summary(\n   335→        self,\n   336→        result: Dict[str, Any],\n   337→        title: Optional[str] = None,\n   338→    ) -> str:\n   339→        \"\"\"Generate red flags summary report - contract-specific variant.\n   340→\n   341→        This report focuses on corruption indicators, suspicious elements,\n   342→        and fraud risk factors identified in the contract analysis.\n   343→        \"\"\"\n   344→        from datetime import datetime\n   345→\n   346→        query = result.get(\"query\", \"Unknown\")\n   347→        report_title = title or f\"Red Flags Summary: {query[:40]}\"\n   348→\n   349→        sections = []\n   350→        sections.append(f\"# {report_title}\")\n   351→        sections.append(\"\")\n   352→        sections.append(f\"**Contract/Subject:** {query}\")\n   353→        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n   354→        sections.append(\"\")\n   355→        sections.append(\"---\")\n   356→        sections.append(\"\")\n   357→\n   358→        findings = result.get(\"findings\", [])\n   359→\n   360→        # Critical Red Flags\n   361→        red_flags = [f for f in findings if f.get(\"finding_type\") == \"red_flag\"]\n   362→        sections.append(\"## Critical Red Flags\")\n   363→        sections.append(\"\")\n   364→        if red_flags:\n   365→            for rf in red_flags:\n   366→                extracted = rf.get(\"extracted_data\", {})\n   367→                if extracted and isinstance(extracted, dict):\n   368→                    flag_type = extracted.get(\"flag_type\", \"Unknown\")\n   369→                    risk_level = extracted.get(\"risk_level\", \"high\")\n   370→                    sections.append(f\"### {flag_type.replace('_', ' ').title()} ({risk_level.upper()} RISK)\")\n   371→                    sections.append(\"\")\n   372→                    sections.append(rf.get(\"content\", \"\"))\n   373→                    sections.append(\"\")\n   374→                    evidence = extracted.get(\"supporting_evidence\", [])\n   375→                    if evidence:\n   376→                        sections.append(\"**Supporting Evidence:**\")\n   377→                        for e in evidence[:3]:\n   378→                            sections.append(f\"- {e}\")\n   379→                        sections.append(\"\")\n   380→                    recommendation = extracted.get(\"recommended_investigation\", \"\")\n   381→                    if recommendation:\n   382→                        sections.append(f\"**Recommended Investigation:** {recommendation}\")\n   383→                        sections.append(\"\")\n   384→                else:\n   385→                    sections.append(f\"- **RED FLAG**: {rf.get('summary') or rf.get('content', '')[:150]}\")\n   386→        else:\n   387→            sections.append(\"No critical red flags identified.\")\n   388→        sections.append(\"\")\n   389→\n   390→        # Suspicious Elements\n   391→        suspicious = [f for f in findings if f.get(\"finding_type\") == \"suspicious_element\"]\n   392→        if suspicious:\n   393→            sections.append(\"## Suspicious Elements\")\n   394→            sections.append(\"\")\n   395→            for se in suspicious:\n   396→                extracted = se.get(\"extracted_data\", {})\n   397→                if extracted and isinstance(extracted, dict):\n   398→                    element_type = extracted.get(\"element_type\", \"Unknown\")\n   399→                    severity = extracted.get(\"severity\", \"medium\")\n   400→                    sections.append(f\"- **{element_type.replace('_', ' ').title()}** ({severity}): {se.get('summary', '')}\")\n   401→                else:\n   402→                    sections.append(f\"- {se.get('summary') or se.get('content', '')[:100]}\")\n   403→            sections.append(\"\")\n   404→\n   405→        # Connected Entities (potential conflicts)\n   406→        connected = [f for f in findings if f.get(\"finding_type\") == \"connected_entity\"]\n   407→        if connected:\n   408→            sections.append(\"## Connected Entities (Potential Conflicts)\")\n   409→            sections.append(\"\")\n   410→            for ce in connected:\n   411→                extracted = ce.get(\"extracted_data\", {})\n   412→                if extracted and isinstance(extracted, dict):\n   413→                    primary = extracted.get(\"primary_entity\", \"Unknown\")\n   414→                    related = extracted.get(\"connected_entity\", \"Unknown\")\n   415→                    rel_type = extracted.get(\"relationship_type\", \"related to\")\n   416→                    sections.append(f\"- **{primary}** {rel_type} **{related}**\")\n   417→                else:\n   418→                    sections.append(f\"- {ce.get('summary') or ce.get('content', '')[:100]}\")\n   419→            sections.append(\"\")\n   420→\n   421→        # Compliance Issues\n   422→        compliance = [f for f in findings if f.get(\"finding_type\") == \"compliance_issue\"]\n   423→        if compliance:\n   424→            sections.append(\"## Compliance Issues\")\n   425→            sections.append(\"\")\n   426→            for ci in compliance:\n   427→                sections.append(f\"- {ci.get('summary') or ci.get('content', '')[:100]}\")\n   428→            sections.append(\"\")\n   429→\n   430→        # Bid Process Concerns\n   431→        bid_issues = [f for f in findings if f.get(\"finding_type\") == \"bid_process\"]\n   432→        if bid_issues:\n   433→            sections.append(\"## Bid Process Concerns\")\n   434→            sections.append(\"\")\n   435→            for bi in bid_issues:\n   436→                extracted = bi.get(\"extracted_data\", {})\n   437→                if extracted and isinstance(extracted, dict):\n   438→                    bid_count = extracted.get(\"bid_count\", \"Unknown\")\n   439→                    competition_type = extracted.get(\"competition_type\", \"Unknown\")\n   440→                    sections.append(f\"- **Bids:** {bid_count} | **Competition:** {competition_type}\")\n   441→                    sections.append(f\"  {bi.get('content', '')[:200]}\")\n   442→                else:\n   443→                    sections.append(f\"- {bi.get('summary') or bi.get('content', '')[:100]}\")\n   444→            sections.append(\"\")\n   445→\n   446→        # Risk Assessment from Perspectives\n   447→        perspectives = result.get(\"perspectives\", [])\n   448→        all_warnings = []\n   449→        for p in perspectives:\n   450→            all_warnings.extend(p.get(\"warnings\", []))\n   451→        if all_warnings:\n   452→            sections.append(\"## Expert Risk Assessment\")\n   453→            sections.append(\"\")\n   454→            for warning in all_warnings[:8]:\n   455→                sections.append(f\"- {warning}\")\n   456→            sections.append(\"\")\n   457→\n   458→        # Recommended Investigations\n   459→        sections.append(\"## Recommended Actions\")\n   460→        sections.append(\"\")\n   461→        for p in perspectives:\n   462→            recs = p.get(\"recommendations\", [])\n   463→            for rec in recs[:2]:\n   464→                sections.append(f\"- {rec}\")\n   465→        sections.append(\"\")\n   466→\n   467→        return \"\\n\".join(sections)\n   468→\n   469→    def generate_pricing_analysis(\n   470→        self,\n   471→        result: Dict[str, Any],\n   472→        title: Optional[str] = None,\n   473→    ) -> str:\n   474→        \"\"\"Generate pricing analysis report - contract-specific variant.\n   475→\n   476→        This report focuses on pricing comparisons, cost analysis,\n   477→        and value-for-money assessment.\n   478→        \"\"\"\n   479→        from datetime import datetime\n   480→\n   481→        query = result.get(\"query\", \"Unknown\")\n   482→        report_title = title or f\"Pricing Analysis: {query[:40]}\"\n   483→\n   484→        sections = []\n   485→        sections.append(f\"# {report_title}\")\n   486→        sections.append(\"\")\n   487→        sections.append(f\"**Contract/Subject:** {query}\")\n   488→        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n   489→        sections.append(\"\")\n   490→        sections.append(\"---\")\n   491→        sections.append(\"\")\n   492→\n   493→        findings = result.get(\"findings\", [])\n   494→\n   495→        # Contract Terms Summary\n   496→        terms = [f for f in findings if f.get(\"finding_type\") == \"contract_terms\"]\n   497→        if terms:\n   498→            sections.append(\"## Contract Terms\")\n   499→            sections.append(\"\")\n   500→            for t in terms:\n   501→                extracted = t.get(\"extracted_data\", {})\n   502→                if extracted and isinstance(extracted, dict):\n   503→                    value = extracted.get(\"total_value\", \"Unknown\")\n   504→                    duration = extracted.get(\"duration\", \"Unknown\")\n   505→                    contract_type = extracted.get(\"type\", \"Unknown\")\n   506→                    sections.append(f\"- **Total Value:** ${value:,}\" if isinstance(value, (int, float)) else f\"- **Total Value:** {value}\")\n   507→                    sections.append(f\"- **Duration:** {duration}\")\n   508→                    sections.append(f\"- **Contract Type:** {contract_type}\")\n   509→                else:\n   510→                    sections.append(f\"- {t.get('content', '')[:200]}\")\n   511→            sections.append(\"\")\n   512→\n   513→        # Pricing Analysis Details\n   514→        pricing = [f for f in findings if f.get(\"finding_type\") == \"pricing_analysis\"]\n   515→        if pricing:\n   516→            sections.append(\"## Pricing Comparison\")\n   517→            sections.append(\"\")\n   518→            sections.append(\"| Item | Proposed Rate | Market Rate | Variance |\")\n   519→            sections.append(\"|------|--------------|-------------|----------|\")\n   520→            for p in pricing:\n   521→                extracted = p.get(\"extracted_data\", {})\n   522→                if extracted and isinstance(extracted, dict):\n   523→                    item = extracted.get(\"item\", \"Unknown\")\n   524→                    proposed = extracted.get(\"proposed_rate\", \"N/A\")\n   525→                    market = extracted.get(\"market_rate\", \"N/A\")\n   526→                    variance = extracted.get(\"variance_percent\", \"N/A\")\n   527→                    sections.append(f\"| {item} | {proposed} | {market} | {variance}% |\")\n   528→                else:\n   529→                    sections.append(f\"- {p.get('summary') or p.get('content', '')[:100]}\")\n   530→            sections.append(\"\")\n   531→\n   532→        # Comparable Contracts\n   533→        comparables = [f for f in findings if f.get(\"finding_type\") == \"comparable_contract\"]\n   534→        if comparables:\n   535→            sections.append(\"## Comparable Contracts\")\n   536→            sections.append(\"\")\n   537→            for c in comparables:\n   538→                extracted = c.get(\"extracted_data\", {})\n   539→                if extracted and isinstance(extracted, dict):\n   540→                    agency = extracted.get(\"agency\", \"Unknown\")\n   541→                    vendor = extracted.get(\"vendor\", \"Unknown\")\n   542→                    value = extracted.get(\"value\", \"Unknown\")\n   543→                    sections.append(f\"- **{agency}** with {vendor}: ${value:,}\" if isinstance(value, (int, float)) else f\"- **{agency}** with {vendor}: {value}\")\n   544→                else:\n   545→                    sections.append(f\"- {c.get('summary') or c.get('content', '')[:100]}\")\n   546→            sections.append(\"\")\n   547→\n   548→        # Performance Issues (cost overruns)\n   549→        performance = [f for f in findings if f.get(\"finding_type\") == \"performance_issue\"]\n   550→        if performance:\n   551→            sections.append(\"## Historical Performance Issues\")\n   552→            sections.append(\"\")\n   553→            for perf in performance:\n   554→                extracted = perf.get(\"extracted_data\", {})\n   555→                if extracted and isinstance(extracted, dict):\n   556→                    issue_type = extracted.get(\"issue_type\", \"Unknown\")\n   557→                    variance = extracted.get(\"variance\", \"Unknown\")\n   558→                    sections.append(f\"- **{issue_type.replace('_', ' ').title()}**: {variance} variance\")\n   559→                else:\n   560→                    sections.append(f\"- {perf.get('summary') or perf.get('content', '')[:100]}\")\n   561→            sections.append(\"\")\n   562→\n   563→        # Industry Benchmarking Perspective\n   564→        perspectives = result.get(\"perspectives\", [])\n   565→        benchmarker = next((p for p in perspectives if \"benchmark\" in p.get(\"perspective_type\", \"\").lower()), None)\n   566→        if benchmarker:\n   567→            sections.append(\"## Industry Benchmarking Analysis\")\n   568→            sections.append(\"\")\n   569→            sections.append(benchmarker.get(\"analysis_text\", \"\")[:500])\n   570→            sections.append(\"\")\n   571→\n   572→        # Value Assessment\n   573→        sections.append(\"## Value Assessment\")\n   574→        sections.append(\"\")\n   575→        auditor = next((p for p in perspectives if \"auditor\" in p.get(\"perspective_type\", \"\").lower()), None)\n   576→        if auditor:\n   577→            insights = auditor.get(\"key_insights\", [])\n   578→            for insight in insights[:4]:\n   579→                sections.append(f\"- {insight}\")\n   580→        sections.append(\"\")\n   581→\n   582→        return \"\\n\".join(sections)\n   583→\n   584→    def _get_priority_findings(self, findings: List[Dict[str, Any]]) -> List[Dict[str, Any]]:\n   585→        \"\"\"Contract template prioritizes red flags and suspicious elements first.\"\"\"\n   586→        # Priority order for contract findings\n   587→        priority_types = [\"red_flag\", \"suspicious_element\", \"compliance_issue\", \"pricing_analysis\", \"connected_entity\"]\n   588→        prioritized = []\n   589→\n   590→        for ftype in priority_types:\n   591→            type_findings = [f for f in findings if f.get(\"finding_type\") == ftype]\n   592→            prioritized.extend(sorted(\n   593→                type_findings,\n   594→                key=lambda x: x.get(\"confidence_score\", 0),\n   595→                reverse=True\n   596→            ))\n   597→\n   598→        # Add remaining\n   599→        remaining = [f for f in findings if f not in prioritized]\n   600→        prioritized.extend(sorted(remaining, key=lambda x: x.get(\"confidence_score\", 0), reverse=True))\n   601→\n   602→        return prioritized\n   603→\n   604→    def _group_findings(self, findings: List[Dict[str, Any]]) -> Dict[str, List[Dict[str, Any]]]:\n   605→        \"\"\"Group findings with contract-specific priority order.\"\"\"\n   606→        # Order emphasizes risk and fraud indicators\n   607→        order = [\"red_flag\", \"suspicious_element\", \"connected_entity\", \"compliance_issue\",\n   608→                 \"pricing_analysis\", \"bid_process\", \"contract_terms\", \"performance_issue\",\n   609→                 \"comparable_contract\", \"contract_entity\", \"date_timeline\", \"gap\"]\n   610→        grouped: Dict[str, List[Dict[str, Any]]] = {}\n   611→\n   612→        for ftype in order:\n   613→            type_findings = [f for f in findings if f.get(\"finding_type\") == ftype]\n   614→            if type_findings:\n   615→                grouped[ftype] = type_findings\n   616→\n   617→        # Add any remaining types not in order\n   618→        for f in findings:\n   619→            ftype = f.get(\"finding_type\", \"other\")\n   620→            if ftype not in grouped:\n   621→                if ftype not in grouped:\n   622→                    grouped[ftype] = []\n   623→                grouped[ftype].append(f)\n   624→\n   625→        return grouped\n   626→\n   627→    def _generate_report_header(self, result: Dict[str, Any]) -> str:\n   628→        \"\"\"Generate contract-specific header with risk summary.\"\"\"\n   629→        findings = result.get(\"findings\", [])\n   630→\n   631→        red_flags = len([f for f in findings if f.get(\"finding_type\") == \"red_flag\"])\n   632→        suspicious = len([f for f in findings if f.get(\"finding_type\") == \"suspicious_element\"])\n   633→        compliance = len([f for f in findings if f.get(\"finding_type\") == \"compliance_issue\"])\n   634→\n   635→        if red_flags > 0 or suspicious > 0:\n   636→            risk_level = \"HIGH\" if red_flags >= 2 else \"MEDIUM\" if red_flags >= 1 or suspicious >= 2 else \"LOW\"\n   637→            return f\"\"\"## Risk Summary\n   638→\n   639→**Overall Risk Level:** {risk_level}\n   640→\n   641→- **Critical Red Flags:** {red_flags}\n   642→- **Suspicious Elements:** {suspicious}\n   643→- **Compliance Issues:** {compliance}\"\"\"\n   644→        return \"\"\n   645→\n   646→    def _generate_key_sections(self, result: Dict[str, Any]) -> str:\n   647→        \"\"\"Generate contract-specific key sections: Red Flags Summary, Pricing Overview.\"\"\"\n   648→        findings = result.get(\"findings\", [])\n   649→        sections = []\n   650→\n   651→        # Red Flags Summary\n   652→        red_flags = [f for f in findings if f.get(\"finding_type\") == \"red_flag\"]\n   653→        if red_flags:\n   654→            sections.append(\"## Red Flags Summary\")\n   655→            sections.append(\"\")\n   656→            for rf in red_flags[:5]:\n   657→                extracted = rf.get(\"extracted_data\", {})\n   658→                if extracted and isinstance(extracted, dict):\n   659→                    flag_type = extracted.get(\"flag_type\", \"Unknown\")\n   660→                    risk_level = extracted.get(\"risk_level\", \"high\")\n   661→                    sections.append(f\"- **[{risk_level.upper()}]** {flag_type.replace('_', ' ').title()}: {rf.get('summary', '')}\")\n   662→                else:\n   663→                    sections.append(f\"- {rf.get('summary') or rf.get('content', '')[:100]}\")\n   664→            sections.append(\"\")\n   665→\n   666→        # Pricing Overview\n   667→        pricing = [f for f in findings if f.get(\"finding_type\") == \"pricing_analysis\"]\n   668→        if pricing:\n   669→            sections.append(\"## Pricing Overview\")\n   670→            sections.append(\"\")\n   671→            for p in pricing[:4]:\n   672→                sections.append(f\"- {p.get('summary') or p.get('content', '')[:100]}\")\n   673→            sections.append(\"\")\n   674→\n   675→        return \"\\n\".join(sections)\n   676→\n   677→    def _generate_executive_highlights(self, result: Dict[str, Any]) -> str:\n   678→        \"\"\"Generate contract-specific executive highlights focusing on risk.\"\"\"\n   679→        findings = result.get(\"findings\", [])\n   680→        sections = []\n   681→\n   682→        # Risk indicators\n   683→        red_flags = [f for f in findings if f.get(\"finding_type\") == \"red_flag\"]\n   684→        suspicious = [f for f in findings if f.get(\"finding_type\") == \"suspicious_element\"]\n   685→\n   686→        if red_flags or suspicious:\n   687→            sections.append(\"## Risk Indicators\")\n   688→            sections.append(\"\")\n   689→            for rf in red_flags[:3]:\n   690→                sections.append(f\"- **RED FLAG**: {rf.get('summary') or rf.get('content', '')[:80]}\")\n   691→            for se in suspicious[:2]:\n   692→                sections.append(f\"- **SUSPICIOUS**: {se.get('summary') or se.get('content', '')[:80]}\")\n   693→            sections.append(\"\")\n   694→\n   695→        return \"\\n\".join(sections)\n   696→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"82343d47-30e9-47a3-93fa-efd2489cfa93","uuid":"75f8544f-10f7-4bec-bbd8-30235f0a19f8","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\actor\\src\\templates\\contract.py","content":"\"\"\"Contract analysis template for government contracts, pricing, and corruption detection.\"\"\"\n\nfrom typing import List, Dict, Any, Optional\n\nfrom .base import BaseTemplate\nfrom ..services.report_components import (\n    ComponentType, ComponentConfig, ReportHints, get_report_hints\n)\n\n\nclass ContractTemplate(BaseTemplate):\n    \"\"\"Template for government contract evaluation and corruption detection.\"\"\"\n\n    template_id = \"contract\"\n    template_name = \"Government Contract Analysis\"\n    description = \"Analyze state/government contracts for overpricing, corruption, and suspicious elements\"\n\n    # Report hints for component-based rendering\n    report_hints = ReportHints(\n        template_type=\"contract\",\n        structure=\"balanced\",\n        findings_grouping=\"category\",\n        tone=\"professional\",\n        decision_format=\"checklist\",\n        emphasis=[\"key_terms\", \"obligations\", \"risks\", \"opportunities\"],\n        required_components=[\n            ComponentType.CONTRACT_ANALYSIS,\n            ComponentType.CHECKLIST,\n            ComponentType.RISK_MATRIX,\n        ],\n        optional_components=[\n            ComponentType.FINDINGS_TABLE,\n            ComponentType.ACTION_ITEMS,\n            ComponentType.COMPARISON_TABLE,\n            ComponentType.KEY_INSIGHTS,\n        ],\n        visualization_preference=[\"contract_structure\", \"obligation_timeline\", \"risk_assessment\"],\n        custom_sections={\n            \"show_pricing_comparison\": True,\n            \"red_flag_priority\": True,\n            \"vendor_history\": True,\n        }\n    )\n\n    # Expert perspectives for contract analysis\n    default_perspectives = [\n        \"contract_auditor\",           # Pricing and cost analysis\n        \"procurement_investigator\",   # Bid process, competition issues\n        \"forensic_accountant\",        # Financial red flags\n        \"regulatory_compliance\",      # Legal requirements\n        \"industry_benchmarker\",       # Market rate comparison\n    ]\n\n    default_max_searches = 12\n\n    # Thorough verification for fraud detection\n    verification_config = {\n        \"cross_reference\": \"thorough\",\n        \"bias_detection\": \"thorough\",\n        \"expert_sanity_check\": \"thorough\",\n        \"source_quality\": \"thorough\",\n    }\n\n    async def generate_search_queries(\n        self,\n        query: str,\n        max_searches: int,\n        granularity: str = \"standard\",\n    ) -> List[str]:\n        \"\"\"Generate contract-specific search queries.\"\"\"\n        prompt = f\"\"\"\nYou are a government contract analyst and fraud investigator planning research queries\nto analyze contracts for overpricing, corruption risks, and suspicious elements.\n\nCONTRACT/TOPIC TO ANALYZE: {query}\n\nDepth Level: {granularity}\n\nGenerate search queries covering these critical investigation areas:\n\n1. VENDOR/CONTRACTOR BACKGROUND\n   - Company registration, incorporation date, ownership history\n   - Key executives and beneficial owners\n   - Prior government contracts with this vendor\n   - Complaints, lawsuits, debarment history\n   - Related companies, subsidiaries, DBAs\n   - Political donations by company or executives\n\n2. PRICING BENCHMARK RESEARCH\n   - Industry standard rates for similar work/services\n   - Government rate schedules (GSA schedules for federal)\n   - Comparable contracts in same sector/region\n   - Unit pricing for common line items\n   - Labor rate comparisons (prevailing wage data)\n   - Material cost benchmarks\n\n3. BID PROCESS AND COMPETITION\n   - Other bidders on this contract (if public)\n   - Similar recent solicitations for comparison\n   - Sole-source justification patterns\n   - Bid protest history\n   - Procurement officer history and patterns\n\n4. CONTRACT MODIFICATIONS AND OVERRUNS\n   - Change order patterns on similar contracts\n   - Amendment and modification history\n   - Cost overrun statistics in sector\n   - Schedule extension patterns\n   - Scope creep indicators\n\n5. VENDOR PERFORMANCE HISTORY\n   - Past performance evaluations (PPIRS for federal)\n   - Completed projects: on-time, on-budget?\n   - Quality issues, defects, rework\n   - Customer complaints and disputes\n   - Warranty claims and callbacks\n\n6. CONNECTED ENTITIES AND CONFLICTS\n   - Subcontractor relationships\n   - Joint venture partners\n   - Related party transactions\n   - Revolving door: former officials now at vendor\n   - Family connections to agency staff\n   - Shell company indicators\n\n7. REGULATORY AND COMPLIANCE\n   - Required certifications/licenses\n   - Small business set-aside compliance\n   - DBE/MBE/WBE certification verification\n   - Insurance and bonding requirements\n   - DCAA audit findings (federal)\n\n8. NEWS AND INVESTIGATIONS\n   - Media coverage of vendor or contract\n   - Inspector General reports\n   - GAO/state auditor findings\n   - Whistleblower complaints\n   - FBI/DOJ investigations in sector\n\n9. CONSTRUCTION-SPECIFIC (if applicable)\n   - Prevailing wage compliance\n   - OSHA violations\n   - Environmental compliance\n   - Permit and inspection history\n   - Subcontractor payment disputes\n\n10. SOFTWARE/IT-SPECIFIC (if applicable)\n    - Similar IT projects cost/duration\n    - Technology stack market rates\n    - Developer/consultant hourly rates\n    - Software license fair pricing\n    - Customization vs. COTS analysis\n\nFor \"{granularity}\" depth level:\n- quick (4-5): Focus on vendor background + pricing benchmark + news/issues\n- standard (8-10): Add bid process + performance + connected entities\n- deep (12+): All angles with multiple queries per angle, deep ownership research\n\nReturn a JSON array of exactly {max_searches} search query strings.\nMake queries SPECIFIC to the contract details provided. Include:\n- Vendor/company name if mentioned\n- Agency/government entity if mentioned\n- Project type and location if mentioned\n- Dollar amounts or timeframes if mentioned\n\nExample: [\"ABC Construction LLC government contracts history complaints\", \"highway construction prevailing wage rates 2024 Texas\", ...]\n\"\"\"\n\n        result = await self._call_gemini_json(prompt)\n\n        if isinstance(result, list):\n            return result[:max_searches]\n        return []\n\n    async def extract_findings(\n        self,\n        query: str,\n        sources: List[Dict[str, Any]],\n        synthesized_content: str,\n        granularity: str = \"standard\",\n    ) -> List[Dict[str, Any]]:\n        \"\"\"Extract contract analysis findings with fraud indicators.\"\"\"\n        # Build source context\n        source_context = \"\\n\\n\".join([\n            f\"Source: {s.get('title', 'Unknown')} ({s.get('url', '')})\\n\"\n            f\"Credibility: {s.get('credibility_score', 'Unknown')}\\n\"\n            f\"Domain: {s.get('domain', '')}\"\n            for s in sources[:20]\n        ])\n\n        prompt = f\"\"\"\nYou are a government contract auditor and fraud investigator extracting findings\nfrom research on a contract or contractor. Your goal is to identify red flags,\npricing anomalies, and corruption indicators.\n\nCONTRACT/TOPIC ANALYZED: {query}\n\nSynthesized Research Content:\n{synthesized_content[:15000]}\n\nSources Referenced:\n{source_context}\n\nExtract findings in these contract analysis categories:\n\n1. CONTRACT ENTITY (finding_type: \"contract_entity\")\n   - Key parties: vendor, agency, contracting officer, subcontractors\n   - Include in extracted_data: entity_name, entity_type, role, registration_info\n   - Note: ownership structure, key personnel\n\n2. CONTRACT TERMS (finding_type: \"contract_terms\")\n   - Value, duration, payment schedule, key rates\n   - Include in extracted_data: total_value, duration, payment_terms, key_rates, type (fixed/cost-plus)\n   - Note: unusual terms, milestone payments\n\n3. PRICING ANALYSIS (finding_type: \"pricing_analysis\")\n   - Cost breakdown, unit rates, comparison to market\n   - Include in extracted_data: item, proposed_rate, market_rate, variance_percent, benchmark_source\n   - Note: overhead, profit margins, labor vs. materials\n\n4. BID PROCESS FINDING (finding_type: \"bid_process\")\n   - Competition level, bidders, evaluation criteria\n   - Include in extracted_data: bid_count, bidder_names, award_basis, competition_type\n   - Note: sole-source justifications, bid rotation patterns\n\n5. SUSPICIOUS ELEMENT (finding_type: \"suspicious_element\") - HIGH PRIORITY\n   - Unusual terms, sweetheart deals, conflict indicators\n   - Include in extracted_data:\n     * \"element_type\": type of suspicious activity\n     * \"description\": what was found\n     * \"severity\": \"high\" | \"medium\" | \"low\"\n     * \"related_parties\": who is involved\n     * \"evidence\": supporting facts\n   - Examples: related party transactions, revolving door, bid steering\n\n6. CONNECTED ENTITY (finding_type: \"connected_entity\")\n   - Related parties, shell companies, family businesses\n   - Include in extracted_data: primary_entity, connected_entity, relationship_type, evidence\n   - Note: ownership overlaps, shared addresses, common executives\n\n7. COMPLIANCE ISSUE (finding_type: \"compliance_issue\")\n   - Regulatory violations, missing documentation\n   - Include in extracted_data: requirement, status, violation_type, consequence\n   - Note: licensing, certifications, insurance, bonding\n\n8. PERFORMANCE ISSUE (finding_type: \"performance_issue\")\n   - Delays, cost overruns, quality problems\n   - Include in extracted_data: issue_type, original_value, actual_value, variance, cause\n   - Note: pattern across multiple contracts\n\n9. COMPARABLE CONTRACT (finding_type: \"comparable_contract\")\n   - Similar contracts for benchmarking\n   - Include in extracted_data: contract_id, agency, vendor, value, scope, outcome\n   - Note: price per unit/sq ft/hour comparisons\n\n10. RED FLAG (finding_type: \"red_flag\") - CRITICAL\n    - Strong corruption or fraud indicators\n    - Include in extracted_data:\n      * \"flag_type\": category of red flag\n      * \"description\": specific concern\n      * \"risk_level\": \"high\" | \"critical\"\n      * \"supporting_evidence\": list of facts\n      * \"recommended_investigation\": next steps\n    - Examples: phantom vendors, kickbacks, bid rigging, overbilling\n\n11. GAP (finding_type: \"gap\")\n    - Missing critical information needed\n    - Include in extracted_data: information_needed, importance (high/medium/low), impact_on_analysis\n    - Note: what documents/data would help investigation\n\n12. DATE/TIMELINE (finding_type: \"date_timeline\")\n    - Important dates and timeline inconsistencies\n    - Include in extracted_data: event, date, significance, related_events\n    - Note: contract award before bid deadline, rushed timelines\n\nFor each finding, return:\n- finding_type: One of the types above\n- content: Detailed finding with specific facts, numbers, names\n- summary: One sentence summary\n- analysis: YOUR EXPERT INVESTIGATIVE ANALYSIS (REQUIRED - 2-4 sentences) explaining:\n  * WHY this finding is significant for contract oversight or fraud detection\n  * What PATTERN or RED FLAG this represents in government contracting\n  * How this COMPARES to normal contracting practices or known fraud schemes\n  * What FURTHER INVESTIGATION or action this finding warrants\n- confidence_score: 0.0-1.0 (based on source quality and evidence strength)\n- temporal_context: 'past', 'present', 'ongoing', or 'predicted'\n- event_date: ISO date if known (YYYY-MM-DD)\n- date_referenced: Specific date mentioned in finding (e.g., \"December 15, 2024\")\n- date_range: Date range if applicable (e.g., \"Q4 2024\", \"2023-2025\")\n- extracted_data: JSON object with structured data specific to finding type\n\nCRITICAL: The \"analysis\" field must provide substantive investigative reasoning, not just describe the finding.\nGood example: \"This 40% price premium over market rate is a significant red flag in competitive bid environments. In similar cases, inflated pricing of this magnitude has been associated with kickback schemes where the excess margin funds illicit payments. The fact that this vendor has previously worked with the contracting officer warrants examination of their relationship and any campaign contributions or post-employment arrangements.\"\n\nFor \"{granularity}\" depth:\n- quick: 8-10 findings focusing on major red flags and pricing\n- standard: 15-20 findings with balanced coverage of all areas\n- deep: 25-30 comprehensive findings with full investigation support\n\nCRITICAL: Prioritize RED_FLAG and SUSPICIOUS_ELEMENT findings. If you identify\npotential fraud indicators, ensure they are captured even if confidence is moderate.\nFalse negatives (missing fraud) are worse than false positives (flagging non-issues).\n\nReturn as JSON array.\n\"\"\"\n\n        result = await self._call_gemini_json(prompt)\n\n        findings = []\n        if isinstance(result, list):\n            for f in result:\n                if isinstance(f, dict):\n                    findings.append({\n                        \"finding_type\": f.get(\"finding_type\", \"fact\"),\n                        \"content\": f.get(\"content\", \"\"),\n                        \"summary\": f.get(\"summary\"),\n                        \"analysis\": f.get(\"analysis\", \"\"),\n                        \"confidence_score\": f.get(\"confidence_score\", 0.5),\n                        \"temporal_context\": f.get(\"temporal_context\", \"present\"),\n                        \"event_date\": f.get(\"event_date\"),\n                        \"date_referenced\": f.get(\"date_referenced\"),\n                        \"date_range\": f.get(\"date_range\"),\n                        \"extracted_data\": f.get(\"extracted_data\"),\n                    })\n\n        return findings\n\n    # ========== CONTRACT-SPECIFIC REPORT GENERATION ==========\n\n    def get_supported_report_variants(self) -> List[str]:\n        \"\"\"Contract template supports red_flags_summary and pricing_analysis variants.\"\"\"\n        return [\"full_report\", \"executive_summary\", \"red_flags_summary\", \"pricing_analysis\"]\n\n    def generate_red_flags_summary(\n        self,\n        result: Dict[str, Any],\n        title: Optional[str] = None,\n    ) -> str:\n        \"\"\"Generate red flags summary report - contract-specific variant.\n\n        This report focuses on corruption indicators, suspicious elements,\n        and fraud risk factors identified in the contract analysis.\n        \"\"\"\n        from datetime import datetime\n\n        query = result.get(\"query\", \"Unknown\")\n        report_title = title or f\"Red Flags Summary: {query[:40]}\"\n\n        sections = []\n        sections.append(f\"# {report_title}\")\n        sections.append(\"\")\n        sections.append(f\"**Contract/Subject:** {query}\")\n        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n        sections.append(\"\")\n        sections.append(\"---\")\n        sections.append(\"\")\n\n        findings = result.get(\"findings\", [])\n\n        # Critical Red Flags\n        red_flags = [f for f in findings if f.get(\"finding_type\") == \"red_flag\"]\n        sections.append(\"## Critical Red Flags\")\n        sections.append(\"\")\n        if red_flags:\n            for rf in red_flags:\n                extracted = rf.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    flag_type = extracted.get(\"flag_type\", \"Unknown\")\n                    risk_level = extracted.get(\"risk_level\", \"high\")\n                    sections.append(f\"### {flag_type.replace('_', ' ').title()} ({risk_level.upper()} RISK)\")\n                    sections.append(\"\")\n                    sections.append(rf.get(\"content\", \"\"))\n                    sections.append(\"\")\n                    evidence = extracted.get(\"supporting_evidence\", [])\n                    if evidence:\n                        sections.append(\"**Supporting Evidence:**\")\n                        for e in evidence[:3]:\n                            sections.append(f\"- {e}\")\n                        sections.append(\"\")\n                    recommendation = extracted.get(\"recommended_investigation\", \"\")\n                    if recommendation:\n                        sections.append(f\"**Recommended Investigation:** {recommendation}\")\n                        sections.append(\"\")\n                else:\n                    sections.append(f\"- **RED FLAG**: {rf.get('summary') or rf.get('content', '')[:150]}\")\n        else:\n            sections.append(\"No critical red flags identified.\")\n        sections.append(\"\")\n\n        # Suspicious Elements\n        suspicious = [f for f in findings if f.get(\"finding_type\") == \"suspicious_element\"]\n        if suspicious:\n            sections.append(\"## Suspicious Elements\")\n            sections.append(\"\")\n            for se in suspicious:\n                extracted = se.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    element_type = extracted.get(\"element_type\", \"Unknown\")\n                    severity = extracted.get(\"severity\", \"medium\")\n                    sections.append(f\"- **{element_type.replace('_', ' ').title()}** ({severity}): {se.get('summary', '')}\")\n                else:\n                    sections.append(f\"- {se.get('summary') or se.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Connected Entities (potential conflicts)\n        connected = [f for f in findings if f.get(\"finding_type\") == \"connected_entity\"]\n        if connected:\n            sections.append(\"## Connected Entities (Potential Conflicts)\")\n            sections.append(\"\")\n            for ce in connected:\n                extracted = ce.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    primary = extracted.get(\"primary_entity\", \"Unknown\")\n                    related = extracted.get(\"connected_entity\", \"Unknown\")\n                    rel_type = extracted.get(\"relationship_type\", \"related to\")\n                    sections.append(f\"- **{primary}** {rel_type} **{related}**\")\n                else:\n                    sections.append(f\"- {ce.get('summary') or ce.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Compliance Issues\n        compliance = [f for f in findings if f.get(\"finding_type\") == \"compliance_issue\"]\n        if compliance:\n            sections.append(\"## Compliance Issues\")\n            sections.append(\"\")\n            for ci in compliance:\n                sections.append(f\"- {ci.get('summary') or ci.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Bid Process Concerns\n        bid_issues = [f for f in findings if f.get(\"finding_type\") == \"bid_process\"]\n        if bid_issues:\n            sections.append(\"## Bid Process Concerns\")\n            sections.append(\"\")\n            for bi in bid_issues:\n                extracted = bi.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    bid_count = extracted.get(\"bid_count\", \"Unknown\")\n                    competition_type = extracted.get(\"competition_type\", \"Unknown\")\n                    sections.append(f\"- **Bids:** {bid_count} | **Competition:** {competition_type}\")\n                    sections.append(f\"  {bi.get('content', '')[:200]}\")\n                else:\n                    sections.append(f\"- {bi.get('summary') or bi.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Risk Assessment from Perspectives\n        perspectives = result.get(\"perspectives\", [])\n        all_warnings = []\n        for p in perspectives:\n            all_warnings.extend(p.get(\"warnings\", []))\n        if all_warnings:\n            sections.append(\"## Expert Risk Assessment\")\n            sections.append(\"\")\n            for warning in all_warnings[:8]:\n                sections.append(f\"- {warning}\")\n            sections.append(\"\")\n\n        # Recommended Investigations\n        sections.append(\"## Recommended Actions\")\n        sections.append(\"\")\n        for p in perspectives:\n            recs = p.get(\"recommendations\", [])\n            for rec in recs[:2]:\n                sections.append(f\"- {rec}\")\n        sections.append(\"\")\n\n        return \"\\n\".join(sections)\n\n    def generate_pricing_analysis(\n        self,\n        result: Dict[str, Any],\n        title: Optional[str] = None,\n    ) -> str:\n        \"\"\"Generate pricing analysis report - contract-specific variant.\n\n        This report focuses on pricing comparisons, cost analysis,\n        and value-for-money assessment.\n        \"\"\"\n        from datetime import datetime\n\n        query = result.get(\"query\", \"Unknown\")\n        report_title = title or f\"Pricing Analysis: {query[:40]}\"\n\n        sections = []\n        sections.append(f\"# {report_title}\")\n        sections.append(\"\")\n        sections.append(f\"**Contract/Subject:** {query}\")\n        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n        sections.append(\"\")\n        sections.append(\"---\")\n        sections.append(\"\")\n\n        findings = result.get(\"findings\", [])\n\n        # Contract Terms Summary\n        terms = [f for f in findings if f.get(\"finding_type\") == \"contract_terms\"]\n        if terms:\n            sections.append(\"## Contract Terms\")\n            sections.append(\"\")\n            for t in terms:\n                extracted = t.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    value = extracted.get(\"total_value\", \"Unknown\")\n                    duration = extracted.get(\"duration\", \"Unknown\")\n                    contract_type = extracted.get(\"type\", \"Unknown\")\n                    sections.append(f\"- **Total Value:** ${value:,}\" if isinstance(value, (int, float)) else f\"- **Total Value:** {value}\")\n                    sections.append(f\"- **Duration:** {duration}\")\n                    sections.append(f\"- **Contract Type:** {contract_type}\")\n                else:\n                    sections.append(f\"- {t.get('content', '')[:200]}\")\n            sections.append(\"\")\n\n        # Pricing Analysis Details\n        pricing = [f for f in findings if f.get(\"finding_type\") == \"pricing_analysis\"]\n        if pricing:\n            sections.append(\"## Pricing Comparison\")\n            sections.append(\"\")\n            sections.append(\"| Item | Proposed Rate | Market Rate | Variance |\")\n            sections.append(\"|------|--------------|-------------|----------|\")\n            for p in pricing:\n                extracted = p.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    item = extracted.get(\"item\", \"Unknown\")\n                    proposed = extracted.get(\"proposed_rate\", \"N/A\")\n                    market = extracted.get(\"market_rate\", \"N/A\")\n                    variance = extracted.get(\"variance_percent\", \"N/A\")\n                    sections.append(f\"| {item} | {proposed} | {market} | {variance}% |\")\n                else:\n                    sections.append(f\"- {p.get('summary') or p.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Comparable Contracts\n        comparables = [f for f in findings if f.get(\"finding_type\") == \"comparable_contract\"]\n        if comparables:\n            sections.append(\"## Comparable Contracts\")\n            sections.append(\"\")\n            for c in comparables:\n                extracted = c.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    agency = extracted.get(\"agency\", \"Unknown\")\n                    vendor = extracted.get(\"vendor\", \"Unknown\")\n                    value = extracted.get(\"value\", \"Unknown\")\n                    sections.append(f\"- **{agency}** with {vendor}: ${value:,}\" if isinstance(value, (int, float)) else f\"- **{agency}** with {vendor}: {value}\")\n                else:\n                    sections.append(f\"- {c.get('summary') or c.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Performance Issues (cost overruns)\n        performance = [f for f in findings if f.get(\"finding_type\") == \"performance_issue\"]\n        if performance:\n            sections.append(\"## Historical Performance Issues\")\n            sections.append(\"\")\n            for perf in performance:\n                extracted = perf.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    issue_type = extracted.get(\"issue_type\", \"Unknown\")\n                    variance = extracted.get(\"variance\", \"Unknown\")\n                    sections.append(f\"- **{issue_type.replace('_', ' ').title()}**: {variance} variance\")\n                else:\n                    sections.append(f\"- {perf.get('summary') or perf.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Industry Benchmarking Perspective\n        perspectives = result.get(\"perspectives\", [])\n        benchmarker = next((p for p in perspectives if \"benchmark\" in p.get(\"perspective_type\", \"\").lower()), None)\n        if benchmarker:\n            sections.append(\"## Industry Benchmarking Analysis\")\n            sections.append(\"\")\n            sections.append(benchmarker.get(\"analysis_text\", \"\")[:500])\n            sections.append(\"\")\n\n        # Value Assessment\n        sections.append(\"## Value Assessment\")\n        sections.append(\"\")\n        auditor = next((p for p in perspectives if \"auditor\" in p.get(\"perspective_type\", \"\").lower()), None)\n        if auditor:\n            insights = auditor.get(\"key_insights\", [])\n            for insight in insights[:4]:\n                sections.append(f\"- {insight}\")\n        sections.append(\"\")\n\n        return \"\\n\".join(sections)\n\n    def _get_priority_findings(self, findings: List[Dict[str, Any]]) -> List[Dict[str, Any]]:\n        \"\"\"Contract template prioritizes red flags and suspicious elements first.\"\"\"\n        # Priority order for contract findings\n        priority_typ
[2026-01-30T09:07:35.633Z] [STDOUT] es = [\"red_flag\", \"suspicious_element\", \"compliance_issue\", \"pricing_analysis\", \"connected_entity\"]\n        prioritized = []\n\n        for ftype in priority_types:\n            type_findings = [f for f in findings if f.get(\"finding_type\") == ftype]\n            prioritized.extend(sorted(\n                type_findings,\n                key=lambda x: x.get(\"confidence_score\", 0),\n                reverse=True\n            ))\n\n        # Add remaining\n        remaining = [f for f in findings if f not in prioritized]\n        prioritized.extend(sorted(remaining, key=lambda x: x.get(\"confidence_score\", 0), reverse=True))\n\n        return prioritized\n\n    def _group_findings(self, findings: List[Dict[str, Any]]) -> Dict[str, List[Dict[str, Any]]]:\n        \"\"\"Group findings with contract-specific priority order.\"\"\"\n        # Order emphasizes risk and fraud indicators\n        order = [\"red_flag\", \"suspicious_element\", \"connected_entity\", \"compliance_issue\",\n                 \"pricing_analysis\", \"bid_process\", \"contract_terms\", \"performance_issue\",\n                 \"comparable_contract\", \"contract_entity\", \"date_timeline\", \"gap\"]\n        grouped: Dict[str, List[Dict[str, Any]]] = {}\n\n        for ftype in order:\n            type_findings = [f for f in findings if f.get(\"finding_type\") == ftype]\n            if type_findings:\n                grouped[ftype] = type_findings\n\n        # Add any remaining types not in order\n        for f in findings:\n            ftype = f.get(\"finding_type\", \"other\")\n            if ftype not in grouped:\n                if ftype not in grouped:\n                    grouped[ftype] = []\n                grouped[ftype].append(f)\n\n        return grouped\n\n    def _generate_report_header(self, result: Dict[str, Any]) -> str:\n        \"\"\"Generate contract-specific header with risk summary.\"\"\"\n        findings = result.get(\"findings\", [])\n\n        red_flags = len([f for f in findings if f.get(\"finding_type\") == \"red_flag\"])\n        suspicious = len([f for f in findings if f.get(\"finding_type\") == \"suspicious_element\"])\n        compliance = len([f for f in findings if f.get(\"finding_type\") == \"compliance_issue\"])\n\n        if red_flags > 0 or suspicious > 0:\n            risk_level = \"HIGH\" if red_flags >= 2 else \"MEDIUM\" if red_flags >= 1 or suspicious >= 2 else \"LOW\"\n            return f\"\"\"## Risk Summary\n\n**Overall Risk Level:** {risk_level}\n\n- **Critical Red Flags:** {red_flags}\n- **Suspicious Elements:** {suspicious}\n- **Compliance Issues:** {compliance}\"\"\"\n        return \"\"\n\n    def _generate_key_sections(self, result: Dict[str, Any]) -> str:\n        \"\"\"Generate contract-specific key sections: Red Flags Summary, Pricing Overview.\"\"\"\n        findings = result.get(\"findings\", [])\n        sections = []\n\n        # Red Flags Summary\n        red_flags = [f for f in findings if f.get(\"finding_type\") == \"red_flag\"]\n        if red_flags:\n            sections.append(\"## Red Flags Summary\")\n            sections.append(\"\")\n            for rf in red_flags[:5]:\n                extracted = rf.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    flag_type = extracted.get(\"flag_type\", \"Unknown\")\n                    risk_level = extracted.get(\"risk_level\", \"high\")\n                    sections.append(f\"- **[{risk_level.upper()}]** {flag_type.replace('_', ' ').title()}: {rf.get('summary', '')}\")\n                else:\n                    sections.append(f\"- {rf.get('summary') or rf.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Pricing Overview\n        pricing = [f for f in findings if f.get(\"finding_type\") == \"pricing_analysis\"]\n        if pricing:\n            sections.append(\"## Pricing Overview\")\n            sections.append(\"\")\n            for p in pricing[:4]:\n                sections.append(f\"- {p.get('summary') or p.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        return \"\\n\".join(sections)\n\n    def _generate_executive_highlights(self, result: Dict[str, Any]) -> str:\n        \"\"\"Generate contract-specific executive highlights focusing on risk.\"\"\"\n        findings = result.get(\"findings\", [])\n        sections = []\n\n        # Risk indicators\n        red_flags = [f for f in findings if f.get(\"finding_type\") == \"red_flag\"]\n        suspicious = [f for f in findings if f.get(\"finding_type\") == \"suspicious_element\"]\n\n        if red_flags or suspicious:\n            sections.append(\"## Risk Indicators\")\n            sections.append(\"\")\n            for rf in red_flags[:3]:\n                sections.append(f\"- **RED FLAG**: {rf.get('summary') or rf.get('content', '')[:80]}\")\n            for se in suspicious[:2]:\n                sections.append(f\"- **SUSPICIOUS**: {se.get('summary') or se.get('content', '')[:80]}\")\n            sections.append(\"\")\n\n        return \"\\n\".join(sections)\n","numLines":696,"startLine":1,"totalLines":696}}}
