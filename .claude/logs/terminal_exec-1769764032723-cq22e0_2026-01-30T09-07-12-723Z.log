[2026-01-30T09:07:43.311Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017Bp1V3sQVo8BWdMSEmENAF","type":"tool_result","content":"     1→\"\"\"Competitive analysis research template.\"\"\"\n     2→\n     3→from typing import List, Dict, Any, Optional\n     4→\n     5→from .base import BaseTemplate\n     6→from ..services.report_components import (\n     7→    ComponentType, ComponentConfig, ReportHints, get_report_hints\n     8→)\n     9→\n    10→\n    11→class CompetitiveTemplate(BaseTemplate):\n    12→    \"\"\"Template for competitive intelligence and market analysis.\"\"\"\n    13→\n    14→    template_id = \"competitive\"\n    15→    template_name = \"Competitive Analysis\"\n    16→    description = \"Deep competitive intelligence, market positioning, and strategic analysis\"\n    17→\n    18→    # Report hints for component-based rendering\n    19→    report_hints = ReportHints(\n    20→        template_type=\"competitive\",\n    21→        structure=\"balanced\",\n    22→        findings_grouping=\"category\",\n    23→        tone=\"analytical\",\n    24→        decision_format=\"matrix\",\n    25→        emphasis=[\"market_position\", \"competitive_advantages\", \"strategic_gaps\"],\n    26→        required_components=[\n    27→            ComponentType.COMPETITOR_MATRIX,\n    28→            ComponentType.COMPARISON_TABLE,\n    29→            ComponentType.METRIC_CARDS,\n    30→        ],\n    31→        optional_components=[\n    32→            ComponentType.FINDINGS_TABLE,\n    33→            ComponentType.PROS_CONS,\n    34→            ComponentType.KEY_INSIGHTS,\n    35→            ComponentType.ACTION_ITEMS,\n    36→        ],\n    37→        visualization_preference=[\"competitor_matrix\", \"market_share_chart\", \"swot_grid\"],\n    38→        custom_sections={\n    39→            \"show_market_share\": True,\n    40→            \"highlight_leader\": True,\n    41→            \"show_strategic_gaps\": True,\n    42→        }\n    43→    )\n    44→\n    45→    # Expert perspectives for competitive intelligence\n    46→    default_perspectives = [\n    47→        \"strategy_consultant\",      # Porter's forces, competitive positioning\n    48→        \"industry_insider\",         # Operational realities, customer dynamics\n    49→        \"institutional_investor\",   # Long-term value, moat durability\n    50→        \"short_seller\",             # Skeptical view, hidden weaknesses\n    51→    ]\n    52→\n    53→    default_max_searches = 10\n    54→\n    55→    # Competitive analysis is rife with vendor marketing and inflated claims\n    56→    # Market share numbers vary wildly, need to detect promotional content\n    57→    verification_config = {\n    58→        \"cross_reference\": \"standard\",      # Market data varies by methodology\n    59→        \"bias_detection\": \"thorough\",       # Vendors inflate their position\n    60→        \"expert_sanity_check\": \"standard\",  # Flag unrealistic market claims\n    61→        \"source_quality\": \"standard\",       # Mix of analyst and vendor sources\n    62→    }\n    63→\n    64→    async def generate_search_queries(\n    65→        self,\n    66→        query: str,\n    67→        max_searches: int,\n    68→        granularity: str = \"standard\",\n    69→    ) -> List[str]:\n    70→        \"\"\"Generate competitive analysis search queries.\"\"\"\n    71→        prompt = f\"\"\"\n    72→You are a competitive intelligence analyst planning research for a comprehensive competitive analysis.\n    73→\n    74→Research Topic: {query}\n    75→\n    76→Depth Level: {granularity}\n    77→\n    78→Generate search queries covering these competitive intelligence angles:\n    79→\n    80→1. MARKET OVERVIEW\n    81→   - Total addressable market size and growth rate\n    82→   - Market segmentation and dynamics\n    83→   - Industry value chain analysis\n    84→\n    85→2. COMPETITOR IDENTIFICATION\n    86→   - Direct competitors by market segment\n    87→   - Indirect and emerging competitors\n    88→   - Potential new entrants and substitutes\n    89→\n    90→3. COMPETITOR PROFILES (for each key competitor)\n    91→   - Business model and revenue streams\n    92→   - Product/service offerings and differentiation\n    93→   - Geographic presence and expansion plans\n    94→   - Recent news, announcements, product launches\n    95→\n    96→4. FINANCIAL COMPARISON\n    97→   - Revenue, growth rates, margins\n    98→   - Market share estimates\n    99→   - Investment and R&D spending\n   100→   - Profitability and unit economics\n   101→\n   102→5. STRATEGIC POSITIONING\n   103→   - Value propositions and target customers\n   104→   - Pricing strategies and models\n   105→   - Distribution and go-to-market approaches\n   106→   - Partnerships and ecosystem plays\n   107→\n   108→6. COMPETITIVE ADVANTAGES\n   109→   - Technology and IP advantages\n   110→   - Network effects and switching costs\n   111→   - Scale and cost advantages\n   112→   - Brand and reputation\n   113→\n   114→7. CUSTOMER INTELLIGENCE\n   115→   - Customer reviews and satisfaction\n   116→   - Win/loss analysis patterns\n   117→   - Customer concentration\n   118→   - Churn and retention data\n   119→\n   120→8. TALENT AND CULTURE\n   121→   - Leadership team background\n   122→   - Key hires and departures\n   123→   - Glassdoor/Indeed reviews\n   124→   - Engineering talent and culture\n   125→\n   126→9. WEAKNESSES AND THREATS\n   127→   - Known vulnerabilities\n   128→   - Customer complaints\n   129→   - Regulatory challenges\n   130→   - Strategic missteps\n   131→\n   132→10. FUTURE OUTLOOK\n   133→    - Stated strategies and roadmaps\n   134→    - M&A activity and rumors\n   135→    - Industry trend positioning\n   136→\n   137→For a \"{granularity}\" depth level:\n   138→- \"quick\": Focus on top 3 competitors with key metrics only\n   139→- \"standard\": Cover 5-7 competitors with balanced analysis\n   140→- \"deep\": Comprehensive coverage of 10+ competitors with detailed profiles\n   141→\n   142→Return a JSON array of exactly {max_searches} search query strings, ordered by importance.\n   143→Example: [\"company X vs company Y market share 2024\", \"company X revenue growth analysis\", ...]\n   144→\"\"\"\n   145→\n   146→        result = await self._call_gemini_json(prompt)\n   147→\n   148→        if isinstance(result, list):\n   149→            return result[:max_searches]\n   150→        return []\n   151→\n   152→    async def extract_findings(\n   153→        self,\n   154→        query: str,\n   155→        sources: List[Dict[str, Any]],\n   156→        synthesized_content: str,\n   157→        granularity: str = \"standard\",\n   158→    ) -> List[Dict[str, Any]]:\n   159→        \"\"\"Extract competitive intelligence findings.\"\"\"\n   160→        # Build source context\n   161→        source_context = \"\\n\\n\".join([\n   162→            f\"Source: {s.get('title', 'Unknown')} ({s.get('url', '')})\\n\"\n   163→            f\"Credibility: {s.get('credibility_score', 'Unknown')}\\n\"\n   164→            f\"Domain: {s.get('domain', '')}\"\n   165→            for s in sources[:20]\n   166→        ])\n   167→\n   168→        prompt = f\"\"\"\n   169→You are a competitive intelligence analyst extracting key findings for strategic decision-making.\n   170→\n   171→Research Topic: {query}\n   172→\n   173→Synthesized Research Content:\n   174→{synthesized_content[:15000]}\n   175→\n   176→Sources Referenced:\n   177→{source_context}\n   178→\n   179→Extract findings in these competitive intelligence categories:\n   180→\n   181→1. MARKET DATA (finding_type: \"fact\")\n   182→   - Market size, growth rates, segments\n   183→   - Include: metric, value, source, date\n   184→   - Note methodology if available\n   185→\n   186→2. COMPETITOR PROFILES (finding_type: \"actor\")\n   187→   - Company overview, positioning, strategy\n   188→   - Include: company name, segment, key metrics\n   189→   - Note strengths and weaknesses\n   190→\n   191→3. MARKET EVENTS (finding_type: \"event\")\n   192→   - Product launches, M&A, leadership changes\n   193→   - Include: date, companies involved, impact\n   194→   - Note strategic implications\n   195→\n   196→4. COMPETITIVE DYNAMICS (finding_type: \"relationship\")\n   197→   - Head-to-head competition, partnerships, ecosystems\n   198→   - Include: companies, nature of relationship\n   199→   - Note competitive intensity\n   200→\n   201→5. MARKET SHARE DATA (finding_type: \"evidence\")\n   202→   - Market share percentages, rankings\n   203→   - Include: source, methodology, time period\n   204→   - Note trends and changes\n   205→\n   206→6. STRATEGIC MOVES (finding_type: \"pattern\")\n   207→   - Pricing changes, go-to-market shifts, pivots\n   208→   - Include: company, action, timing\n   209→   - Note competitive response\n   210→\n   211→7. CUSTOMER INTELLIGENCE (finding_type: \"claim\")\n   212→   - Customer feedback, satisfaction, preferences\n   213→   - Include: sentiment, specifics, volume\n   214→   - Note credibility of source\n   215→\n   216→8. FINANCIAL METRICS (finding_type: \"evidence\")\n   217→   - Revenue, margins, growth rates by competitor\n   218→   - Include: metric, value, period, YoY change\n   219→   - Note vs. industry benchmarks\n   220→\n   221→9. THREATS AND OPPORTUNITIES (finding_type: \"prediction\")\n   222→   - Emerging threats, market opportunities\n   223→   - Include: threat/opportunity, likelihood, timeline\n   224→   - Note strategic implications\n   225→\n   226→10. GAPS (finding_type: \"gap\")\n   227→    - Missing competitive data\n   228→    - Information needed for complete analysis\n   229→    - Suggested intelligence gathering\n   230→\n   231→For each finding, return:\n   232→- finding_type: One of 'fact', 'actor', 'event', 'relationship', 'evidence', 'pattern', 'claim', 'prediction', 'gap'\n   233→- content: Detailed finding with specific data points\n   234→- summary: One sentence\n   235→- analysis: YOUR EXPERT ANALYTICAL COMMENTARY (REQUIRED - 2-4 sentences) explaining:\n   236→  * WHY this finding matters for competitive positioning\n   237→  * What STRATEGIC IMPLICATIONS it has for market players\n   238→  * How this COMPARES to historical patterns or industry norms\n   239→  * What ACTIONS or responses this might trigger from competitors\n   240→- confidence_score: 0.0-1.0 (based on source quality and recency)\n   241→- temporal_context: 'past', 'present', 'ongoing', or 'prediction'\n   242→- extracted_data: JSON object with structured data:\n   243→  - For market data: {{\"metric\": \"...\", \"value\": ..., \"period\": \"...\", \"growth\": ...}}\n   244→  - For competitors: {{\"company\": \"...\", \"segment\": \"...\", \"revenue\": ..., \"market_share\": ...}}\n   245→  - For events: {{\"date\": \"...\", \"companies\": [...], \"event_type\": \"...\", \"impact\": \"...\"}}\n   246→\n   247→CRITICAL: The \"analysis\" field must provide substantive strategic reasoning, not just restate the finding.\n   248→Good example: \"This market share gain is significant because it crosses the 30% threshold typically required for pricing power. Historically, companies reaching this level have been able to raise prices 5-10% without significant churn. Competitors will likely respond with aggressive bundling or price cuts within 6 months.\"\n   249→\n   250→Return as JSON array.\n   251→\"\"\"\n   252→\n   253→        result = await self._call_gemini_json(prompt)\n   254→\n   255→        findings = []\n   256→        if isinstance(result, list):\n   257→            for f in result:\n   258→                if isinstance(f, dict):\n   259→                    findings.append({\n   260→                        \"finding_type\": f.get(\"finding_type\", \"fact\"),\n   261→                        \"content\": f.get(\"content\", \"\"),\n   262→                        \"summary\": f.get(\"summary\"),\n   263→                        \"analysis\": f.get(\"analysis\", \"\"),\n   264→                        \"confidence_score\": f.get(\"confidence_score\", 0.5),\n   265→                        \"temporal_context\": f.get(\"temporal_context\", \"present\"),\n   266→                        \"extracted_data\": f.get(\"extracted_data\"),\n   267→                    })\n   268→\n   269→        return findings\n   270→\n   271→    # ========== COMPETITIVE-SPECIFIC REPORT GENERATION ==========\n   272→\n   273→    def get_supported_report_variants(self) -> List[str]:\n   274→        \"\"\"Competitive template supports competitor_matrix variant.\"\"\"\n   275→        return [\"full_report\", \"executive_summary\", \"competitor_matrix\"]\n   276→\n   277→    def generate_competitor_matrix(\n   278→        self,\n   279→        result: Dict[str, Any],\n   280→        title: Optional[str] = None,\n   281→    ) -> str:\n   282→        \"\"\"Generate competitor matrix report - competitive-specific variant.\"\"\"\n   283→        from datetime import datetime\n   284→\n   285→        query = result.get(\"query\", \"Unknown\")\n   286→        report_title = title or f\"Competitive Matrix: {query[:40]}\"\n   287→\n   288→        sections = []\n   289→        sections.append(f\"# {report_title}\")\n   290→        sections.append(\"\")\n   291→        sections.append(f\"**Market/Subject:** {query}\")\n   292→        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n   293→        sections.append(\"\")\n   294→        sections.append(\"---\")\n   295→        sections.append(\"\")\n   296→\n   297→        findings = result.get(\"findings\", [])\n   298→\n   299→        # Market Overview\n   300→        market_data = [f for f in findings if f.get(\"finding_type\") == \"fact\"]\n   301→        if market_data:\n   302→            sections.append(\"## Market Overview\")\n   303→            sections.append(\"\")\n   304→            for m in market_data[:4]:\n   305→                sections.append(f\"- {m.get('summary') or m.get('content', '')[:100]}\")\n   306→            sections.append(\"\")\n   307→\n   308→        # Competitor Profiles\n   309→        competitors = [f for f in findings if f.get(\"finding_type\") == \"actor\"]\n   310→        if competitors:\n   311→            sections.append(\"## Competitor Profiles\")\n   312→            sections.append(\"\")\n   313→            for comp in competitors:\n   314→                extracted = comp.get(\"extracted_data\", {})\n   315→                if extracted and isinstance(extracted, dict):\n   316→                    company = extracted.get(\"company\", \"Unknown\")\n   317→                    segment = extracted.get(\"segment\", \"\")\n   318→                    revenue = extracted.get(\"revenue\", \"\")\n   319→                    market_share = extracted.get(\"market_share\", \"\")\n   320→                    sections.append(f\"### {company}\")\n   321→                    sections.append(\"\")\n   322→                    if segment:\n   323→                        sections.append(f\"- **Segment:** {segment}\")\n   324→                    if revenue:\n   325→                        sections.append(f\"- **Revenue:** {revenue}\")\n   326→                    if market_share:\n   327→                        sections.append(f\"- **Market Share:** {market_share}\")\n   328→                    sections.append(f\"- {comp.get('content', '')[:200]}\")\n   329→                    sections.append(\"\")\n   330→                else:\n   331→                    sections.append(f\"- {comp.get('summary') or comp.get('content', '')[:100]}\")\n   332→            sections.append(\"\")\n   333→\n   334→        # Competitive Dynamics\n   335→        relationships = [f for f in findings if f.get(\"finding_type\") == \"relationship\"]\n   336→        if relationships:\n   337→            sections.append(\"## Competitive Dynamics\")\n   338→            sections.append(\"\")\n   339→            for rel in relationships[:6]:\n   340→                sections.append(f\"- {rel.get('summary') or rel.get('content', '')[:100]}\")\n   341→            sections.append(\"\")\n   342→\n   343→        # Market Share Data\n   344→        evidence = [f for f in findings if f.get(\"finding_type\") == \"evidence\"]\n   345→        if evidence:\n   346→            sections.append(\"## Market Share & Metrics\")\n   347→            sections.append(\"\")\n   348→            for e in evidence[:6]:\n   349→                sections.append(f\"- {e.get('summary') or e.get('content', '')[:100]}\")\n   350→            sections.append(\"\")\n   351→\n   352→        # Strategic Moves\n   353→        patterns = [f for f in findings if f.get(\"finding_type\") == \"pattern\"]\n   354→        if patterns:\n   355→            sections.append(\"## Recent Strategic Moves\")\n   356→            sections.append(\"\")\n   357→            for p in patterns[:5]:\n   358→                sections.append(f\"- {p.get('summary') or p.get('content', '')[:100]}\")\n   359→            sections.append(\"\")\n   360→\n   361→        # Threats and Opportunities\n   362→        predictions = [f for f in findings if f.get(\"finding_type\") == \"prediction\"]\n   363→        if predictions:\n   364→            sections.append(\"## Threats & Opportunities\")\n   365→            sections.append(\"\")\n   366→            for pred in predictions[:5]:\n   367→                sections.append(f\"- {pred.get('summary') or pred.get('content', '')[:100]}\")\n   368→            sections.append(\"\")\n   369→\n   370→        return \"\\n\".join(sections)\n   371→\n   372→    def _get_priority_findings(self, findings: List[Dict[str, Any]]) -> List[Dict[str, Any]]:\n   373→        \"\"\"Competitive template prioritizes actors (competitors) and evidence.\"\"\"\n   374→        priority_types = [\"actor\", \"evidence\", \"fact\", \"relationship\", \"pattern\"]\n   375→        prioritized = []\n   376→\n   377→        for ftype in priority_types:\n   378→            type_findings = [f for f in findings if f.get(\"finding_type\") == ftype]\n   379→            prioritized.extend(sorted(\n   380→                type_findings,\n   381→                key=lambda x: x.get(\"confidence_score\", 0),\n   382→                reverse=True\n   383→            ))\n   384→\n   385→        remaining = [f for f in findings if f not in prioritized]\n   386→        prioritized.extend(sorted(remaining, key=lambda x: x.get(\"confidence_score\", 0), reverse=True))\n   387→\n   388→        return prioritized\n   389→\n   390→    def _generate_key_sections(self, result: Dict[str, Any]) -> str:\n   391→        \"\"\"Generate competitive-specific key sections: Market Position, Key Competitors.\"\"\"\n   392→        findings = result.get(\"findings\", [])\n   393→        sections = []\n   394→\n   395→        # Market Position Summary\n   396→        evidence = [f for f in findings if f.get(\"finding_type\") == \"evidence\"]\n   397→        if evidence:\n   398→            sections.append(\"## Market Position Summary\")\n   399→            sections.append(\"\")\n   400→            for e in evidence[:4]:\n   401→                sections.append(f\"- {e.get('summary') or e.get('content', '')[:100]}\")\n   402→            sections.append(\"\")\n   403→\n   404→        # Key Competitors\n   405→        competitors = [f for f in findings if f.get(\"finding_type\") == \"actor\"]\n   406→        if competitors:\n   407→            sections.append(\"## Key Competitors\")\n   408→            sections.append(\"\")\n   409→            for comp in competitors[:5]:\n   410→                sections.append(f\"- {comp.get('summary') or comp.get('content', '')[:100]}\")\n   411→            sections.append(\"\")\n   412→\n   413→        return \"\\n\".join(sections)\n   414→\n   415→    def _generate_executive_highlights(self, result: Dict[str, Any]) -> str:\n   416→        \"\"\"Generate competitive-specific executive highlights.\"\"\"\n   417→        findings = result.get(\"findings\", [])\n   418→        sections = []\n   419→\n   420→        # Top competitors highlight\n   421→        competitors = [f for f in findings if f.get(\"finding_type\") == \"actor\"]\n   422→        if competitors:\n   423→            sections.append(\"## Top Competitors\")\n   424→            sections.append(\"\")\n   425→            for comp in competitors[:3]:\n   426→                sections.append(f\"- {comp.get('summary') or comp.get('content', '')[:80]}\")\n   427→            sections.append(\"\")\n   428→\n   429→        return \"\\n\".join(sections)\n   430→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"82343d47-30e9-47a3-93fa-efd2489cfa93","uuid":"c7b12624-3b3d-4096-920b-ae18216b4281","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\actor\\src\\templates\\competitive.py","content":"\"\"\"Competitive analysis research template.\"\"\"\n\nfrom typing import List, Dict, Any, Optional\n\nfrom .base import BaseTemplate\nfrom ..services.report_components import (\n    ComponentType, ComponentConfig, ReportHints, get_report_hints\n)\n\n\nclass CompetitiveTemplate(BaseTemplate):\n    \"\"\"Template for competitive intelligence and market analysis.\"\"\"\n\n    template_id = \"competitive\"\n    template_name = \"Competitive Analysis\"\n    description = \"Deep competitive intelligence, market positioning, and strategic analysis\"\n\n    # Report hints for component-based rendering\n    report_hints = ReportHints(\n        template_type=\"competitive\",\n        structure=\"balanced\",\n        findings_grouping=\"category\",\n        tone=\"analytical\",\n        decision_format=\"matrix\",\n        emphasis=[\"market_position\", \"competitive_advantages\", \"strategic_gaps\"],\n        required_components=[\n            ComponentType.COMPETITOR_MATRIX,\n            ComponentType.COMPARISON_TABLE,\n            ComponentType.METRIC_CARDS,\n        ],\n        optional_components=[\n            ComponentType.FINDINGS_TABLE,\n            ComponentType.PROS_CONS,\n            ComponentType.KEY_INSIGHTS,\n            ComponentType.ACTION_ITEMS,\n        ],\n        visualization_preference=[\"competitor_matrix\", \"market_share_chart\", \"swot_grid\"],\n        custom_sections={\n            \"show_market_share\": True,\n            \"highlight_leader\": True,\n            \"show_strategic_gaps\": True,\n        }\n    )\n\n    # Expert perspectives for competitive intelligence\n    default_perspectives = [\n        \"strategy_consultant\",      # Porter's forces, competitive positioning\n        \"industry_insider\",         # Operational realities, customer dynamics\n        \"institutional_investor\",   # Long-term value, moat durability\n        \"short_seller\",             # Skeptical view, hidden weaknesses\n    ]\n\n    default_max_searches = 10\n\n    # Competitive analysis is rife with vendor marketing and inflated claims\n    # Market share numbers vary wildly, need to detect promotional content\n    verification_config = {\n        \"cross_reference\": \"standard\",      # Market data varies by methodology\n        \"bias_detection\": \"thorough\",       # Vendors inflate their position\n        \"expert_sanity_check\": \"standard\",  # Flag unrealistic market claims\n        \"source_quality\": \"standard\",       # Mix of analyst and vendor sources\n    }\n\n    async def generate_search_queries(\n        self,\n        query: str,\n        max_searches: int,\n        granularity: str = \"standard\",\n    ) -> List[str]:\n        \"\"\"Generate competitive analysis search queries.\"\"\"\n        prompt = f\"\"\"\nYou are a competitive intelligence analyst planning research for a comprehensive competitive analysis.\n\nResearch Topic: {query}\n\nDepth Level: {granularity}\n\nGenerate search queries covering these competitive intelligence angles:\n\n1. MARKET OVERVIEW\n   - Total addressable market size and growth rate\n   - Market segmentation and dynamics\n   - Industry value chain analysis\n\n2. COMPETITOR IDENTIFICATION\n   - Direct competitors by market segment\n   - Indirect and emerging competitors\n   - Potential new entrants and substitutes\n\n3. COMPETITOR PROFILES (for each key competitor)\n   - Business model and revenue streams\n   - Product/service offerings and differentiation\n   - Geographic presence and expansion plans\n   - Recent news, announcements, product launches\n\n4. FINANCIAL COMPARISON\n   - Revenue, growth rates, margins\n   - Market share estimates\n   - Investment and R&D spending\n   - Profitability and unit economics\n\n5. STRATEGIC POSITIONING\n   - Value propositions and target customers\n   - Pricing strategies and models\n   - Distribution and go-to-market approaches\n   - Partnerships and ecosystem plays\n\n6. COMPETITIVE ADVANTAGES\n   - Technology and IP advantages\n   - Network effects and switching costs\n   - Scale and cost advantages\n   - Brand and reputation\n\n7. CUSTOMER INTELLIGENCE\n   - Customer reviews and satisfaction\n   - Win/loss analysis patterns\n   - Customer concentration\n   - Churn and retention data\n\n8. TALENT AND CULTURE\n   - Leadership team background\n   - Key hires and departures\n   - Glassdoor/Indeed reviews\n   - Engineering talent and culture\n\n9. WEAKNESSES AND THREATS\n   - Known vulnerabilities\n   - Customer complaints\n   - Regulatory challenges\n   - Strategic missteps\n\n10. FUTURE OUTLOOK\n    - Stated strategies and roadmaps\n    - M&A activity and rumors\n    - Industry trend positioning\n\nFor a \"{granularity}\" depth level:\n- \"quick\": Focus on top 3 competitors with key metrics only\n- \"standard\": Cover 5-7 competitors with balanced analysis\n- \"deep\": Comprehensive coverage of 10+ competitors with detailed profiles\n\nReturn a JSON array of exactly {max_searches} search query strings, ordered by importance.\nExample: [\"company X vs company Y market share 2024\", \"company X revenue growth analysis\", ...]\n\"\"\"\n\n        result = await self._call_gemini_json(prompt)\n\n        if isinstance(result, list):\n            return result[:max_searches]\n        return []\n\n    async def extract_findings(\n        self,\n        query: str,\n        sources: List[Dict[str, Any]],\n        synthesized_content: str,\n        granularity: str = \"standard\",\n    ) -> List[Dict[str, Any]]:\n        \"\"\"Extract competitive intelligence findings.\"\"\"\n        # Build source context\n        source_context = \"\\n\\n\".join([\n            f\"Source: {s.get('title', 'Unknown')} ({s.get('url', '')})\\n\"\n            f\"Credibility: {s.get('credibility_score', 'Unknown')}\\n\"\n            f\"Domain: {s.get('domain', '')}\"\n            for s in sources[:20]\n        ])\n\n        prompt = f\"\"\"\nYou are a competitive intelligence analyst extracting key findings for strategic decision-making.\n\nResearch Topic: {query}\n\nSynthesized Research Content:\n{synthesized_content[:15000]}\n\nSources Referenced:\n{source_context}\n\nExtract findings in these competitive intelligence categories:\n\n1. MARKET DATA (finding_type: \"fact\")\n   - Market size, growth rates, segments\n   - Include: metric, value, source, date\n   - Note methodology if available\n\n2. COMPETITOR PROFILES (finding_type: \"actor\")\n   - Company overview, positioning, strategy\n   - Include: company name, segment, key metrics\n   - Note strengths and weaknesses\n\n3. MARKET EVENTS (finding_type: \"event\")\n   - Product launches, M&A, leadership changes\n   - Include: date, companies involved, impact\n   - Note strategic implications\n\n4. COMPETITIVE DYNAMICS (finding_type: \"relationship\")\n   - Head-to-head competition, partnerships, ecosystems\n   - Include: companies, nature of relationship\n   - Note competitive intensity\n\n5. MARKET SHARE DATA (finding_type: \"evidence\")\n   - Market share percentages, rankings\n   - Include: source, methodology, time period\n   - Note trends and changes\n\n6. STRATEGIC MOVES (finding_type: \"pattern\")\n   - Pricing changes, go-to-market shifts, pivots\n   - Include: company, action, timing\n   - Note competitive response\n\n7. CUSTOMER INTELLIGENCE (finding_type: \"claim\")\n   - Customer feedback, satisfaction, preferences\n   - Include: sentiment, specifics, volume\n   - Note credibility of source\n\n8. FINANCIAL METRICS (finding_type: \"evidence\")\n   - Revenue, margins, growth rates by competitor\n   - Include: metric, value, period, YoY change\n   - Note vs. industry benchmarks\n\n9. THREATS AND OPPORTUNITIES (finding_type: \"prediction\")\n   - Emerging threats, market opportunities\n   - Include: threat/opportunity, likelihood, timeline\n   - Note strategic implications\n\n10. GAPS (finding_type: \"gap\")\n    - Missing competitive data\n    - Information needed for complete analysis\n    - Suggested intelligence gathering\n\nFor each finding, return:\n- finding_type: One of 'fact', 'actor', 'event', 'relationship', 'evidence', 'pattern', 'claim', 'prediction', 'gap'\n- content: Detailed finding with specific data points\n- summary: One sentence\n- analysis: YOUR EXPERT ANALYTICAL COMMENTARY (REQUIRED - 2-4 sentences) explaining:\n  * WHY this finding matters for competitive positioning\n  * What STRATEGIC IMPLICATIONS it has for market players\n  * How this COMPARES to historical patterns or industry norms\n  * What ACTIONS or responses this might trigger from competitors\n- confidence_score: 0.0-1.0 (based on source quality and recency)\n- temporal_context: 'past', 'present', 'ongoing', or 'prediction'\n- extracted_data: JSON object with structured data:\n  - For market data: {{\"metric\": \"...\", \"value\": ..., \"period\": \"...\", \"growth\": ...}}\n  - For competitors: {{\"company\": \"...\", \"segment\": \"...\", \"revenue\": ..., \"market_share\": ...}}\n  - For events: {{\"date\": \"...\", \"companies\": [...], \"event_type\": \"...\", \"impact\": \"...\"}}\n\nCRITICAL: The \"analysis\" field must provide substantive strategic reasoning, not just restate the finding.\nGood example: \"This market share gain is significant because it crosses the 30% threshold typically required for pricing power. Historically, companies reaching this level have been able to raise prices 5-10% without significant churn. Competitors will likely respond with aggressive bundling or price cuts within 6 months.\"\n\nReturn as JSON array.\n\"\"\"\n\n        result = await self._call_gemini_json(prompt)\n\n        findings = []\n        if isinstance(result, list):\n            for f in result:\n                if isinstance(f, dict):\n                    findings.append({\n                        \"finding_type\": f.get(\"finding_type\", \"fact\"),\n                        \"content\": f.get(\"content\", \"\"),\n                        \"summary\": f.get(\"summary\"),\n                        \"analysis\": f.get(\"analysis\", \"\"),\n                        \"confidence_score\": f.get(\"confidence_score\", 0.5),\n                        \"temporal_context\": f.get(\"temporal_context\", \"present\"),\n                        \"extracted_data\": f.get(\"extracted_data\"),\n                    })\n\n        return findings\n\n    # ========== COMPETITIVE-SPECIFIC REPORT GENERATION ==========\n\n    def get_supported_report_variants(self) -> List[str]:\n        \"\"\"Competitive template supports competitor_matrix variant.\"\"\"\n        return [\"full_report\", \"executive_summary\", \"competitor_matrix\"]\n\n    def generate_competitor_matrix(\n        self,\n        result: Dict[str, Any],\n        title: Optional[str] = None,\n    ) -> str:\n        \"\"\"Generate competitor matrix report - competitive-specific variant.\"\"\"\n        from datetime import datetime\n\n        query = result.get(\"query\", \"Unknown\")\n        report_title = title or f\"Competitive Matrix: {query[:40]}\"\n\n        sections = []\n        sections.append(f\"# {report_title}\")\n        sections.append(\"\")\n        sections.append(f\"**Market/Subject:** {query}\")\n        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n        sections.append(\"\")\n        sections.append(\"---\")\n        sections.append(\"\")\n\n        findings = result.get(\"findings\", [])\n\n        # Market Overview\n        market_data = [f for f in findings if f.get(\"finding_type\") == \"fact\"]\n        if market_data:\n            sections.append(\"## Market Overview\")\n            sections.append(\"\")\n            for m in market_data[:4]:\n                sections.append(f\"- {m.get('summary') or m.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Competitor Profiles\n        competitors = [f for f in findings if f.get(\"finding_type\") == \"actor\"]\n        if competitors:\n            sections.append(\"## Competitor Profiles\")\n            sections.append(\"\")\n            for comp in competitors:\n                extracted = comp.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    company = extracted.get(\"company\", \"Unknown\")\n                    segment = extracted.get(\"segment\", \"\")\n                    revenue = extracted.get(\"revenue\", \"\")\n                    market_share = extracted.get(\"market_share\", \"\")\n                    sections.append(f\"### {company}\")\n                    sections.append(\"\")\n                    if segment:\n                        sections.append(f\"- **Segment:** {segment}\")\n                    if revenue:\n                        sections.append(f\"- **Revenue:** {revenue}\")\n                    if market_share:\n                        sections.append(f\"- **Market Share:** {market_share}\")\n                    sections.append(f\"- {comp.get('content', '')[:200]}\")\n                    sections.append(\"\")\n                else:\n                    sections.append(f\"- {comp.get('summary') or comp.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Competitive Dynamics\n        relationships = [f for f in findings if f.get(\"finding_type\") == \"relationship\"]\n        if relationships:\n            sections.append(\"## Competitive Dynamics\")\n            sections.append(\"\")\n            for rel in relationships[:6]:\n                sections.append(f\"- {rel.get('summary') or rel.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Market Share Data\n        evidence = [f for f in findings if f.get(\"finding_type\") == \"evidence\"]\n        if evidence:\n            sections.append(\"## Market Share & Metrics\")\n            sections.append(\"\")\n            for e in evidence[:6]:\n                sections.append(f\"- {e.get('summary') or e.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Strategic Moves\n        patterns = [f for f in findings if f.get(\"finding_type\") == \"pattern\"]\n        if patterns:\n            sections.append(\"## Recent Strategic Moves\")\n            sections.append(\"\")\n            for p in patterns[:5]:\n                sections.append(f\"- {p.get('summary') or p.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Threats and Opportunities\n        predictions = [f for f in findings if f.get(\"finding_type\") == \"prediction\"]\n        if predictions:\n            sections.append(\"## Threats & Opportunities\")\n            sections.append(\"\")\n            for pred in predictions[:5]:\n                sections.append(f\"- {pred.get('summary') or pred.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        return \"\\n\".join(sections)\n\n    def _get_priority_findings(self, findings: List[Dict[str, Any]]) -> List[Dict[str, Any]]:\n        \"\"\"Competitive template prioritizes actors (competitors) and evidence.\"\"\"\n        priority_types = [\"actor\", \"evidence\", \"fact\", \"relationship\", \"pattern\"]\n        prioritized = []\n\n        for ftype in priority_types:\n            type_findings = [f for f in findings if f.get(\"finding_type\") == ftype]\n            prioritized.extend(sorted(\n                type_findings,\n                key=lambda x: x.get(\"confidence_score\", 0),\n                reverse=True\n            ))\n\n        remaining = [f for f in findings if f not in prioritized]\n        prioritized.extend(sorted(remaining, key=lambda x: x.get(\"confidence_score\", 0), reverse=True))\n\n        return prioritized\n\n    def _generate_key_sections(self, result: Dict[str, Any]) -> str:\n        \"\"\"Generate competitive-specific key sections: Market Position, Key Competitors.\"\"\"\n        findings = result.get(\"findings\", [])\n        sections = []\n\n        # Market Position Summary\n        evidence = [f for f in findings if f.get(\"finding_type\") == \"evidence\"]\n        if evidence:\n            sections.append(\"## Market Position Summary\")\n            sections.append(\"\")\n            for e in evidence[:4]:\n                sections.append(f\"- {e.get('summary') or e.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Key Competitors\n        competitors = [f for f in findings if f.get(\"finding_type\") == \"actor\"]\n        if competitors:\n            sections.append(\"## Key Competitors\")\n            sections.append(\"\")\n            for comp in competitors[:5]:\n                sections.append(f\"- {comp.get('summary') or comp.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        return \"\\n\".join(sections)\n\n    def _generate_executive_highlights(self, result: Dict[str, Any]) -> str:\n        \"\"\"Generate competitive-specific executive highlights.\"\"\"\n        findings = result.get(\"findings\", [])\n        sections = []\n\n        # Top competitors highlight\n        competitors = [f for f in findings if f.get(\"finding_type\") == \"actor\"]\n        if competitors:\n            sections.append(\"## Top Competitors\")\n            sections.append(\"\")\n            for comp in competitors[:3]:\n                sections.append(f\"- {comp.get('summary') or comp.get('content', '')[:80]}\")\n            sections.append(\"\")\n\n        return \"\\n\".join(sections)\n","numLines":430,"startLine":1,"totalLines":430}}}
