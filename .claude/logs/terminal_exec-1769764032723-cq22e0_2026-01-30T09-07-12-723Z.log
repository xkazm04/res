[2026-01-30T09:07:24.525Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WU26tW58uEPaFrX9xQvNAe","type":"tool_result","content":"     1→\"\"\"Due Diligence template for vetting companies, vendors, and partners.\"\"\"\n     2→\n     3→from typing import List, Dict, Any, Optional\n     4→from datetime import datetime\n     5→\n     6→from .base import BaseTemplate\n     7→from ..services.report_components import (\n     8→    ComponentType, ComponentConfig, ReportHints, get_report_hints\n     9→)\n    10→\n    11→\n    12→class DueDiligenceTemplate(BaseTemplate):\n    13→    \"\"\"Template for business due diligence research.\n    14→\n    15→    Helps users vet potential business partners, vendors, employers,\n    16→    or investment targets by surfacing risks and verifying claims.\n    17→    \"\"\"\n    18→\n    19→    template_id = \"due_diligence\"\n    20→    template_name = \"Due Diligence\"\n    21→    description = \"Vet companies, vendors, and partners before signing contracts or making commitments\"\n    22→\n    23→    # Report hints for component-based rendering\n    24→    report_hints = ReportHints(\n    25→        template_type=\"due_diligence\",\n    26→        structure=\"verdict_first\",\n    27→        findings_grouping=\"category\",\n    28→        tone=\"professional\",\n    29→        decision_format=\"scorecard\",\n    30→        emphasis=[\"overall_assessment\", \"red_flags\", \"strengths\", \"category_scores\"],\n    31→        required_components=[\n    32→            ComponentType.DUE_DILIGENCE_SCORECARD,\n    33→            ComponentType.CHECKLIST,\n    34→            ComponentType.FINDINGS_TABLE,\n    35→        ],\n    36→        optional_components=[\n    37→            ComponentType.RISK_MATRIX,\n    38→            ComponentType.KEY_INSIGHTS,\n    39→            ComponentType.ACTION_ITEMS,\n    40→            ComponentType.TIMELINE,\n    41→        ],\n    42→        visualization_preference=[\"scorecard\", \"category_radar\", \"red_flag_matrix\"],\n    43→        custom_sections={\n    44→            \"show_risk_score\": True,\n    45→            \"category_breakdown\": True,\n    46→            \"recommendation_prominent\": True,\n    47→        }\n    48→    )\n    49→\n    50→    # Expert perspectives for due diligence\n    51→    default_perspectives = [\n    52→        \"due_diligence_analyst\",  # Professional vetting\n    53→        \"forensic_financial\",     # Follow the money\n    54→        \"legal_liability\",        # Legal exposure\n    55→        \"industry_insider\",       # Operational reality\n    56→    ]\n    57→\n    58→    default_max_searches = 8\n    59→\n    60→    # Due diligence requires thorough verification\n    61→    verification_config = {\n    62→        \"cross_reference\": \"thorough\",\n    63→        \"bias_detection\": \"standard\",\n    64→        \"expert_sanity_check\": \"thorough\",\n    65→        \"source_quality\": \"thorough\",\n    66→    }\n    67→\n    68→    async def generate_search_queries(\n    69→        self,\n    70→        query: str,\n    71→        max_searches: int,\n    72→        granularity: str = \"standard\",\n    73→    ) -> List[str]:\n    74→        \"\"\"Generate search queries for due diligence research.\"\"\"\n    75→        prompt = f\"\"\"\n    76→You are a professional due diligence researcher helping someone vet a business entity.\n    77→\n    78→Research Subject: {query}\n    79→\n    80→Depth Level: {granularity}\n    81→\n    82→Generate search queries to thoroughly vet this entity. Cover these angles:\n    83→\n    84→1. COMPANY BASICS\n    85→   - Official registration, founding date, headquarters\n    86→   - Business model, products/services, market position\n    87→   - Company size, employee count, growth trajectory\n    88→\n    89→2. LEADERSHIP & KEY PEOPLE\n    90→   - Founders, executives, board members\n    91→   - Their backgrounds, previous companies, track records\n    92→   - Any controversies or notable achievements\n    93→\n    94→3. FINANCIAL HEALTH\n    95→   - Funding history, investors, revenue signals\n    96→   - Profitability indicators, growth metrics\n    97→   - Any signs of financial distress\n    98→\n    99→4. LEGAL & REGULATORY\n   100→   - Lawsuits (plaintiff and defendant)\n   101→   - Regulatory actions, fines, settlements\n   102→   - Compliance issues, license status\n   103→\n   104→5. REPUTATION & REVIEWS\n   105→   - Customer reviews and complaints (BBB, Trustpilot, G2, etc.)\n   106→   - Employee reviews (Glassdoor, Indeed)\n   107→   - Industry reputation, awards, recognition\n   108→\n   109→6. RED FLAGS\n   110→   - Scam reports, fraud allegations\n   111→   - High-profile failures or scandals\n   112→   - Pattern of complaints or issues\n   113→\n   114→For a \"{granularity}\" depth level:\n   115→- \"quick\": Focus on 3-4 most critical angles (legal, reviews, red flags)\n   116→- \"standard\": Cover 5-6 angles with balanced depth\n   117→- \"deep\": Comprehensive coverage of all angles\n   118→\n   119→Return a JSON array of exactly {max_searches} search query strings.\n   120→Make queries specific and investigative. Include the entity name in each query.\n   121→\"\"\"\n   122→\n   123→        result = await self._call_gemini_json(prompt)\n   124→\n   125→        if isinstance(result, list):\n   126→            return result[:max_searches]\n   127→        return []\n   128→\n   129→    async def extract_findings(\n   130→        self,\n   131→        query: str,\n   132→        sources: List[Dict[str, Any]],\n   133→        synthesized_content: str,\n   134→        granularity: str = \"standard\",\n   135→    ) -> List[Dict[str, Any]]:\n   136→        \"\"\"Extract due diligence findings.\"\"\"\n   137→        source_context = \"\\n\\n\".join([\n   138→            f\"Source: {s.get('title', 'Unknown')} ({s.get('url', '')})\\n\"\n   139→            f\"Domain: {s.get('domain', '')}\"\n   140→            for s in sources[:20]\n   141→        ])\n   142→\n   143→        prompt = f\"\"\"\n   144→You are a due diligence analyst extracting findings to help someone make a business decision.\n   145→\n   146→Research Subject: {query}\n   147→\n   148→Synthesized Research Content:\n   149→{synthesized_content[:16000]}\n   150→\n   151→Sources Referenced:\n   152→{source_context}\n   153→\n   154→Extract findings in these categories:\n   155→\n   156→1. COMPANY_PROFILE (finding_type: \"company_profile\")\n   157→   - Basic facts about the entity\n   158→   - extracted_data: {{\"name\": \"\", \"founded\": \"\", \"headquarters\": \"\", \"size\": \"\", \"industry\": \"\", \"business_model\": \"\"}}\n   159→\n   160→2. FINANCIAL_HEALTH (finding_type: \"financial_health\")\n   161→   - Financial stability indicators\n   162→   - extracted_data: {{\"indicator\": \"\", \"status\": \"healthy/concerning/unknown\", \"evidence\": \"\", \"trend\": \"\"}}\n   163→\n   164→3. LEGAL_HISTORY (finding_type: \"legal_history\")\n   165→   - Lawsuits, regulatory actions, legal issues\n   166→   - extracted_data: {{\"case_type\": \"\", \"status\": \"\", \"outcome\": \"\", \"amount\": \"\", \"date\": \"\", \"significance\": \"\"}}\n   167→\n   168→4. RED_FLAG (finding_type: \"red_flag\")\n   169→   - Warning signs that should concern the user\n   170→   - Be specific about WHY this is a red flag\n   171→   - extracted_data: {{\"flag_type\": \"\", \"severity\": \"high/medium/low\", \"evidence\": \"\", \"recommendation\": \"\"}}\n   172→\n   173→5. REPUTATION_SIGNAL (finding_type: \"reputation_signal\")\n   174→   - Reviews, testimonials, industry standing\n   175→   - extracted_data: {{\"source\": \"\", \"sentiment\": \"positive/negative/mixed\", \"rating\": \"\", \"common_themes\": []}}\n   176→\n   177→6. KEY_PERSON (finding_type: \"key_person\")\n   178→   - Leadership background and track record\n   179→   - extracted_data: {{\"name\": \"\", \"role\": \"\", \"background\": \"\", \"track_record\": \"\", \"concerns\": \"\"}}\n   180→\n   181→For each finding, return:\n   182→- finding_type: One of the types above\n   183→- content: Detailed finding with specific facts\n   184→- summary: One concise sentence (this is what users see first)\n   185→- analysis: YOUR EXPERT DUE DILIGENCE ANALYSIS (REQUIRED - 2-4 sentences) explaining:\n   186→  * WHY this finding matters for the business decision at hand\n   187→  * What RISK or OPPORTUNITY this represents and how significant it is\n   188→  * How this COMPARES to industry norms or similar entities\n   189→  * What ADDITIONAL INVESTIGATION or verification this warrants\n   190→- confidence_score: 0.0-1.0 based on source quality and corroboration\n   191→- temporal_context: 'past', 'present', 'ongoing'\n   192→- extracted_data: Structured data for the finding type\n   193→\n   194→CRITICAL: The \"analysis\" field must provide substantive reasoning, not just describe the finding.\n   195→Good example: \"This pattern of multiple lawsuits from former employees alleging wage theft is a significant red flag. In our experience, companies with 3+ wage-related lawsuits in a 2-year period have a 70% likelihood of ongoing compliance issues. This also suggests potential labor law violations that could expose acquirers to successor liability. Recommend thorough review of payroll practices and settlement terms.\"\n   196→\n   197→IMPORTANT:\n   198→- Prioritize RED FLAGS - users need to know risks first\n   199→- Be specific with dates, amounts, and names when available\n   200→- Distinguish between verified facts and allegations\n   201→- Note when information is outdated or unverifiable\n   202→\n   203→Return as JSON array. Prioritize actionable findings that help the user decide whether to proceed.\n   204→\"\"\"\n   205→\n   206→        result = await self._call_gemini_json(prompt)\n   207→\n   208→        findings = []\n   209→        if isinstance(result, list):\n   210→            for f in result:\n   211→                if isinstance(f, dict):\n   212→                    findings.append({\n   213→                        \"finding_type\": f.get(\"finding_type\", \"fact\"),\n   214→                        \"content\": f.get(\"content\", \"\"),\n   215→                        \"summary\": f.get(\"summary\"),\n   216→                        \"analysis\": f.get(\"analysis\", \"\"),\n   217→                        \"confidence_score\": f.get(\"confidence_score\", 0.5),\n   218→                        \"temporal_context\": f.get(\"temporal_context\", \"present\"),\n   219→                        \"extracted_data\": f.get(\"extracted_data\"),\n   220→                    })\n   221→\n   222→        return findings\n   223→\n   224→    def get_supported_report_variants(self) -> List[str]:\n   225→        \"\"\"Due diligence supports risk_summary variant.\"\"\"\n   226→        return [\"full_report\", \"executive_summary\", \"risk_summary\"]\n   227→\n   228→    def generate_risk_summary(\n   229→        self,\n   230→        result: Dict[str, Any],\n   231→        title: Optional[str] = None,\n   232→    ) -> str:\n   233→        \"\"\"Generate risk-focused summary for due diligence.\"\"\"\n   234→        query = result.get(\"query\", \"Unknown\")\n   235→        report_title = title or f\"Due Diligence: {query[:50]}\"\n   236→\n   237→        sections = []\n   238→        sections.append(f\"# {report_title}\")\n   239→        sections.append(\"\")\n   240→        sections.append(f\"**Subject:** {query}\")\n   241→        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n   242→        sections.append(\"\")\n   243→\n   244→        findings = result.get(\"findings\", [])\n   245→\n   246→        # Risk verdict\n   247→        red_flags = [f for f in findings if f.get(\"finding_type\") == \"red_flag\"]\n   248→        high_severity = [f for f in red_flags if f.get(\"extracted_data\", {}).get(\"severity\") == \"high\"]\n   249→\n   250→        sections.append(\"## Risk Assessment\")\n   251→        sections.append(\"\")\n   252→        if high_severity:\n   253→            sections.append(\"**RISK LEVEL: HIGH** - Significant concerns identified\")\n   254→        elif red_flags:\n   255→            sections.append(\"**RISK LEVEL: MEDIUM** - Some concerns warrant attention\")\n   256→        else:\n   257→            sections.append(\"**RISK LEVEL: LOW** - No major red flags detected\")\n   258→        sections.append(\"\")\n   259→\n   260→        # Red flags first\n   261→        if red_flags:\n   262→            sections.append(\"## Red Flags\")\n   263→            sections.append(\"\")\n   264→            for rf in red_flags[:6]:\n   265→                extracted = rf.get(\"extracted_data\", {})\n   266→                severity = extracted.get(\"severity\", \"medium\").upper() if extracted else \"MEDIUM\"\n   267→                sections.append(f\"- **[{severity}]** {rf.get('summary', rf.get('content', '')[:100])}\")\n   268→            sections.append(\"\")\n   269→\n   270→        # Legal issues\n   271→        legal = [f for f in findings if f.get(\"finding_type\") == \"legal_history\"]\n   272→        if legal:\n   273→            sections.append(\"## Legal History\")\n   274→            sections.append(\"\")\n   275→            for l in legal[:5]:\n   276→                sections.append(f\"- {l.get('summary', l.get('content', '')[:100])}\")\n   277→            sections.append(\"\")\n   278→\n   279→        # Reputation\n   280→        reputation = [f for f in findings if f.get(\"finding_type\") == \"reputation_signal\"]\n   281→        if reputation:\n   282→            sections.append(\"## Reputation Signals\")\n   283→            sections.append(\"\")\n   284→            for r in reputation[:4]:\n   285→                sections.append(f\"- {r.get('summary', r.get('content', '')[:100])}\")\n   286→            sections.append(\"\")\n   287→\n   288→        return \"\\n\".join(sections)\n   289→\n   290→    def _get_priority_findings(self, findings: List[Dict[str, Any]]) -> List[Dict[str, Any]]:\n   291→        \"\"\"Due diligence prioritizes red flags and legal issues.\"\"\"\n   292→        priority_types = [\"red_flag\", \"legal_history\", \"financial_health\", \"reputation_signal\", \"key_person\"]\n   293→        prioritized = []\n   294→\n   295→        for ftype in priority_types:\n   296→            type_findings = [f for f in findings if f.get(\"finding_type\") == ftype]\n   297→            prioritized.extend(sorted(\n   298→                type_findings,\n   299→                key=lambda x: x.get(\"confidence_score\", 0),\n   300→                reverse=True\n   301→            ))\n   302→\n   303→        remaining = [f for f in findings if f not in prioritized]\n   304→        prioritized.extend(sorted(remaining, key=lambda x: x.get(\"confidence_score\", 0), reverse=True))\n   305→\n   306→        return prioritized\n   307→\n   308→    def _group_findings(self, findings: List[Dict[str, Any]]) -> Dict[str, List[Dict[str, Any]]]:\n   309→        \"\"\"Group findings with due diligence priority order.\"\"\"\n   310→        order = [\"red_flag\", \"legal_history\", \"financial_health\", \"reputation_signal\", \"key_person\", \"company_profile\"]\n   311→        grouped: Dict[str, List[Dict[str, Any]]] = {}\n   312→\n   313→        for ftype in order:\n   314→            type_findings = [f for f in findings if f.get(\"finding_type\") == ftype]\n   315→            if type_findings:\n   316→                grouped[ftype] = type_findings\n   317→\n   318→        for f in findings:\n   319→            ftype = f.get(\"finding_type\", \"other\")\n   320→            if ftype not in grouped:\n   321→                grouped[ftype] = []\n   322→            if f not in grouped.get(ftype, []):\n   323→                grouped.setdefault(ftype, []).append(f)\n   324→\n   325→        return grouped\n   326→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"82343d47-30e9-47a3-93fa-efd2489cfa93","uuid":"fb39973f-d432-4dbc-afdb-98b394e5f99a","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\actor\\src\\templates\\due_diligence.py","content":"\"\"\"Due Diligence template for vetting companies, vendors, and partners.\"\"\"\n\nfrom typing import List, Dict, Any, Optional\nfrom datetime import datetime\n\nfrom .base import BaseTemplate\nfrom ..services.report_components import (\n    ComponentType, ComponentConfig, ReportHints, get_report_hints\n)\n\n\nclass DueDiligenceTemplate(BaseTemplate):\n    \"\"\"Template for business due diligence research.\n\n    Helps users vet potential business partners, vendors, employers,\n    or investment targets by surfacing risks and verifying claims.\n    \"\"\"\n\n    template_id = \"due_diligence\"\n    template_name = \"Due Diligence\"\n    description = \"Vet companies, vendors, and partners before signing contracts or making commitments\"\n\n    # Report hints for component-based rendering\n    report_hints = ReportHints(\n        template_type=\"due_diligence\",\n        structure=\"verdict_first\",\n        findings_grouping=\"category\",\n        tone=\"professional\",\n        decision_format=\"scorecard\",\n        emphasis=[\"overall_assessment\", \"red_flags\", \"strengths\", \"category_scores\"],\n        required_components=[\n            ComponentType.DUE_DILIGENCE_SCORECARD,\n            ComponentType.CHECKLIST,\n            ComponentType.FINDINGS_TABLE,\n        ],\n        optional_components=[\n            ComponentType.RISK_MATRIX,\n            ComponentType.KEY_INSIGHTS,\n            ComponentType.ACTION_ITEMS,\n            ComponentType.TIMELINE,\n        ],\n        visualization_preference=[\"scorecard\", \"category_radar\", \"red_flag_matrix\"],\n        custom_sections={\n            \"show_risk_score\": True,\n            \"category_breakdown\": True,\n            \"recommendation_prominent\": True,\n        }\n    )\n\n    # Expert perspectives for due diligence\n    default_perspectives = [\n        \"due_diligence_analyst\",  # Professional vetting\n        \"forensic_financial\",     # Follow the money\n        \"legal_liability\",        # Legal exposure\n        \"industry_insider\",       # Operational reality\n    ]\n\n    default_max_searches = 8\n\n    # Due diligence requires thorough verification\n    verification_config = {\n        \"cross_reference\": \"thorough\",\n        \"bias_detection\": \"standard\",\n        \"expert_sanity_check\": \"thorough\",\n        \"source_quality\": \"thorough\",\n    }\n\n    async def generate_search_queries(\n        self,\n        query: str,\n        max_searches: int,\n        granularity: str = \"standard\",\n    ) -> List[str]:\n        \"\"\"Generate search queries for due diligence research.\"\"\"\n        prompt = f\"\"\"\nYou are a professional due diligence researcher helping someone vet a business entity.\n\nResearch Subject: {query}\n\nDepth Level: {granularity}\n\nGenerate search queries to thoroughly vet this entity. Cover these angles:\n\n1. COMPANY BASICS\n   - Official registration, founding date, headquarters\n   - Business model, products/services, market position\n   - Company size, employee count, growth trajectory\n\n2. LEADERSHIP & KEY PEOPLE\n   - Founders, executives, board members\n   - Their backgrounds, previous companies, track records\n   - Any controversies or notable achievements\n\n3. FINANCIAL HEALTH\n   - Funding history, investors, revenue signals\n   - Profitability indicators, growth metrics\n   - Any signs of financial distress\n\n4. LEGAL & REGULATORY\n   - Lawsuits (plaintiff and defendant)\n   - Regulatory actions, fines, settlements\n   - Compliance issues, license status\n\n5. REPUTATION & REVIEWS\n   - Customer reviews and complaints (BBB, Trustpilot, G2, etc.)\n   - Employee reviews (Glassdoor, Indeed)\n   - Industry reputation, awards, recognition\n\n6. RED FLAGS\n   - Scam reports, fraud allegations\n   - High-profile failures or scandals\n   - Pattern of complaints or issues\n\nFor a \"{granularity}\" depth level:\n- \"quick\": Focus on 3-4 most critical angles (legal, reviews, red flags)\n- \"standard\": Cover 5-6 angles with balanced depth\n- \"deep\": Comprehensive coverage of all angles\n\nReturn a JSON array of exactly {max_searches} search query strings.\nMake queries specific and investigative. Include the entity name in each query.\n\"\"\"\n\n        result = await self._call_gemini_json(prompt)\n\n        if isinstance(result, list):\n            return result[:max_searches]\n        return []\n\n    async def extract_findings(\n        self,\n        query: str,\n        sources: List[Dict[str, Any]],\n        synthesized_content: str,\n        granularity: str = \"standard\",\n    ) -> List[Dict[str, Any]]:\n        \"\"\"Extract due diligence findings.\"\"\"\n        source_context = \"\\n\\n\".join([\n            f\"Source: {s.get('title', 'Unknown')} ({s.get('url', '')})\\n\"\n            f\"Domain: {s.get('domain', '')}\"\n            for s in sources[:20]\n        ])\n\n        prompt = f\"\"\"\nYou are a due diligence analyst extracting findings to help someone make a business decision.\n\nResearch Subject: {query}\n\nSynthesized Research Content:\n{synthesized_content[:16000]}\n\nSources Referenced:\n{source_context}\n\nExtract findings in these categories:\n\n1. COMPANY_PROFILE (finding_type: \"company_profile\")\n   - Basic facts about the entity\n   - extracted_data: {{\"name\": \"\", \"founded\": \"\", \"headquarters\": \"\", \"size\": \"\", \"industry\": \"\", \"business_model\": \"\"}}\n\n2. FINANCIAL_HEALTH (finding_type: \"financial_health\")\n   - Financial stability indicators\n   - extracted_data: {{\"indicator\": \"\", \"status\": \"healthy/concerning/unknown\", \"evidence\": \"\", \"trend\": \"\"}}\n\n3. LEGAL_HISTORY (finding_type: \"legal_history\")\n   - Lawsuits, regulatory actions, legal issues\n   - extracted_data: {{\"case_type\": \"\", \"status\": \"\", \"outcome\": \"\", \"amount\": \"\", \"date\": \"\", \"significance\": \"\"}}\n\n4. RED_FLAG (finding_type: \"red_flag\")\n   - Warning signs that should concern the user\n   - Be specific about WHY this is a red flag\n   - extracted_data: {{\"flag_type\": \"\", \"severity\": \"high/medium/low\", \"evidence\": \"\", \"recommendation\": \"\"}}\n\n5. REPUTATION_SIGNAL (finding_type: \"reputation_signal\")\n   - Reviews, testimonials, industry standing\n   - extracted_data: {{\"source\": \"\", \"sentiment\": \"positive/negative/mixed\", \"rating\": \"\", \"common_themes\": []}}\n\n6. KEY_PERSON (finding_type: \"key_person\")\n   - Leadership background and track record\n   - extracted_data: {{\"name\": \"\", \"role\": \"\", \"background\": \"\", \"track_record\": \"\", \"concerns\": \"\"}}\n\nFor each finding, return:\n- finding_type: One of the types above\n- content: Detailed finding with specific facts\n- summary: One concise sentence (this is what users see first)\n- analysis: YOUR EXPERT DUE DILIGENCE ANALYSIS (REQUIRED - 2-4 sentences) explaining:\n  * WHY this finding matters for the business decision at hand\n  * What RISK or OPPORTUNITY this represents and how significant it is\n  * How this COMPARES to industry norms or similar entities\n  * What ADDITIONAL INVESTIGATION or verification this warrants\n- confidence_score: 0.0-1.0 based on source quality and corroboration\n- temporal_context: 'past', 'present', 'ongoing'\n- extracted_data: Structured data for the finding type\n\nCRITICAL: The \"analysis\" field must provide substantive reasoning, not just describe the finding.\nGood example: \"This pattern of multiple lawsuits from former employees alleging wage theft is a significant red flag. In our experience, companies with 3+ wage-related lawsuits in a 2-year period have a 70% likelihood of ongoing compliance issues. This also suggests potential labor law violations that could expose acquirers to successor liability. Recommend thorough review of payroll practices and settlement terms.\"\n\nIMPORTANT:\n- Prioritize RED FLAGS - users need to know risks first\n- Be specific with dates, amounts, and names when available\n- Distinguish between verified facts and allegations\n- Note when information is outdated or unverifiable\n\nReturn as JSON array. Prioritize actionable findings that help the user decide whether to proceed.\n\"\"\"\n\n        result = await self._call_gemini_json(prompt)\n\n        findings = []\n        if isinstance(result, list):\n            for f in result:\n                if isinstance(f, dict):\n                    findings.append({\n                        \"finding_type\": f.get(\"finding_type\", \"fact\"),\n                        \"content\": f.get(\"content\", \"\"),\n                        \"summary\": f.get(\"summary\"),\n                        \"analysis\": f.get(\"analysis\", \"\"),\n                        \"confidence_score\": f.get(\"confidence_score\", 0.5),\n                        \"temporal_context\": f.get(\"temporal_context\", \"present\"),\n                        \"extracted_data\": f.get(\"extracted_data\"),\n                    })\n\n        return findings\n\n    def get_supported_report_variants(self) -> List[str]:\n        \"\"\"Due diligence supports risk_summary variant.\"\"\"\n        return [\"full_report\", \"executive_summary\", \"risk_summary\"]\n\n    def generate_risk_summary(\n        self,\n        result: Dict[str, Any],\n        title: Optional[str] = None,\n    ) -> str:\n        \"\"\"Generate risk-focused summary for due diligence.\"\"\"\n        query = result.get(\"query\", \"Unknown\")\n        report_title = title or f\"Due Diligence: {query[:50]}\"\n\n        sections = []\n        sections.append(f\"# {report_title}\")\n        sections.append(\"\")\n        sections.append(f\"**Subject:** {query}\")\n        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n        sections.append(\"\")\n\n        findings = result.get(\"findings\", [])\n\n        # Risk verdict\n        red_flags = [f for f in findings if f.get(\"finding_type\") == \"red_flag\"]\n        high_severity = [f for f in red_flags if f.get(\"extracted_data\", {}).get(\"severity\") == \"high\"]\n\n        sections.append(\"## Risk Assessment\")\n        sections.append(\"\")\n        if high_severity:\n            sections.append(\"**RISK LEVEL: HIGH** - Significant concerns identified\")\n        elif red_flags:\n            sections.append(\"**RISK LEVEL: MEDIUM** - Some concerns warrant attention\")\n        else:\n            sections.append(\"**RISK LEVEL: LOW** - No major red flags detected\")\n        sections.append(\"\")\n\n        # Red flags first\n        if red_flags:\n            sections.append(\"## Red Flags\")\n            sections.append(\"\")\n            for rf in red_flags[:6]:\n                extracted = rf.get(\"extracted_data\", {})\n                severity = extracted.get(\"severity\", \"medium\").upper() if extracted else \"MEDIUM\"\n                sections.append(f\"- **[{severity}]** {rf.get('summary', rf.get('content', '')[:100])}\")\n            sections.append(\"\")\n\n        # Legal issues\n        legal = [f for f in findings if f.get(\"finding_type\") == \"legal_history\"]\n        if legal:\n            sections.append(\"## Legal History\")\n            sections.append(\"\")\n            for l in legal[:5]:\n                sections.append(f\"- {l.get('summary', l.get('content', '')[:100])}\")\n            sections.append(\"\")\n\n        # Reputation\n        reputation = [f for f in findings if f.get(\"finding_type\") == \"reputation_signal\"]\n        if reputation:\n            sections.append(\"## Reputation Signals\")\n            sections.append(\"\")\n            for r in reputation[:4]:\n                sections.append(f\"- {r.get('summary', r.get('content', '')[:100])}\")\n            sections.append(\"\")\n\n        return \"\\n\".join(sections)\n\n    def _get_priority_findings(self, findings: List[Dict[str, Any]]) -> List[Dict[str, Any]]:\n        \"\"\"Due diligence prioritizes red flags and legal issues.\"\"\"\n        priority_types = [\"red_flag\", \"legal_history\", \"financial_health\", \"reputation_signal\", \"key_person\"]\n        prioritized = []\n\n        for ftype in priority_types:\n            type_findings = [f for f in findings if f.get(\"finding_type\") == ftype]\n            prioritized.extend(sorted(\n                type_findings,\n                key=lambda x: x.get(\"confidence_score\", 0),\n                reverse=True\n            ))\n\n        remaining = [f for f in findings if f not in prioritized]\n        prioritized.extend(sorted(remaining, key=lambda x: x.get(\"confidence_score\", 0), reverse=True))\n\n        return prioritized\n\n    def _group_findings(self, findings: List[Dict[str, Any]]) -> Dict[str, List[Dict[str, Any]]]:\n        \"\"\"Group findings with due diligence priority order.\"\"\"\n        order = [\"red_flag\", \"legal_history\", \"financial_health\", \"reputation_signal\", \"key_person\", \"company_profile\"]\n        grouped: Dict[str, List[Dict[str, Any]]] = {}\n\n        for ftype in order:\n            type_findings = [f for f in findings if f.get(\"finding_type\") == ftype]\n            if type_findings:\n                grouped[ftype] = type_findings\n\n        for f in findings:\n            ftype = f.get(\"finding_type\", \"other\")\n            if ftype not in grouped:\n                grouped[ftype] = []\n            if f not in grouped.get(ftype, []):\n                grouped.setdefault(ftype, []).append(f)\n\n        return grouped\n","numLines":326,"startLine":1,"totalLines":326}}}
