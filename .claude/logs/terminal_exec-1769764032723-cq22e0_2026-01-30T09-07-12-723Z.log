[2026-01-30T09:07:33.170Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01S8WaiCy2Z28yTr9VyMekC9","type":"tool_result","content":"     1→\"\"\"Legal research template.\"\"\"\n     2→\n     3→from typing import List, Dict, Any, Optional\n     4→\n     5→from .base import BaseTemplate\n     6→from ..services.report_components import (\n     7→    ComponentType, ComponentConfig, ReportHints, get_report_hints\n     8→)\n     9→\n    10→\n    11→class LegalTemplate(BaseTemplate):\n    12→    \"\"\"Template for legal research, regulatory analysis, and compliance.\"\"\"\n    13→\n    14→    template_id = \"legal\"\n    15→    template_name = \"Legal Research\"\n    16→    description = \"Legal case research, regulatory analysis, and compliance assessment\"\n    17→\n    18→    # Report hints for component-based rendering\n    19→    report_hints = ReportHints(\n    20→        template_type=\"legal\",\n    21→        structure=\"narrative_first\",\n    22→        findings_grouping=\"category\",\n    23→        tone=\"professional\",\n    24→        decision_format=\"recommendation\",\n    25→        emphasis=[\"legal_precedents\", \"regulatory_implications\", \"compliance_requirements\"],\n    26→        required_components=[\n    27→            ComponentType.LEGAL_CASE_TRACKER,\n    28→            ComponentType.FINDINGS_TABLE,\n    29→            ComponentType.TIMELINE,\n    30→        ],\n    31→        optional_components=[\n    32→            ComponentType.KEY_INSIGHTS,\n    33→            ComponentType.CHECKLIST,\n    34→            ComponentType.RISK_MATRIX,\n    35→            ComponentType.ACTION_ITEMS,\n    36→        ],\n    37→        visualization_preference=[\"case_timeline\", \"jurisdiction_map\", \"precedent_chain\"],\n    38→        custom_sections={\n    39→            \"show_case_citations\": True,\n    40→            \"compliance_checklist\": True,\n    41→            \"regulatory_timeline\": True,\n    42→        }\n    43→    )\n    44→\n    45→    # Expert perspectives for legal analysis\n    46→    default_perspectives = [\n    47→        \"litigation_strategist\",   # Case strength, discovery, outcomes\n    48→        \"regulatory_expert\",       # Compliance, enforcement, political factors\n    49→        \"legal_liability\",         # Liability exposure, evidence strength\n    50→        \"forensic_financial\",      # Financial crimes, fraud patterns\n    51→    ]\n    52→\n    53→    default_max_searches = 10\n    54→\n    55→    # Legal research is more factual - court citations are verifiable\n    56→    # Focus on source quality (primary legal sources) over bias detection\n    57→    verification_config = {\n    58→        \"cross_reference\": \"light\",         # Legal citations are specific\n    59→        \"bias_detection\": \"light\",          # Less bias in case law\n    60→        \"expert_sanity_check\": \"light\",     # Legal findings are factual\n    61→        \"source_quality\": \"thorough\",       # Primary sources (court filings) critical\n    62→    }\n    63→\n    64→    async def generate_search_queries(\n    65→        self,\n    66→        query: str,\n    67→        max_searches: int,\n    68→        granularity: str = \"standard\",\n    69→    ) -> List[str]:\n    70→        \"\"\"Generate legal research search queries.\"\"\"\n    71→        prompt = f\"\"\"\n    72→You are a legal researcher planning comprehensive legal research for a law firm or legal department.\n    73→\n    74→Research Topic: {query}\n    75→\n    76→Depth Level: {granularity}\n    77→\n    78→Generate search queries covering these legal research angles:\n    79→\n    80→1. CASE LAW\n    81→   - Relevant federal and state court decisions\n    82→   - Appellate decisions and precedents\n    83→   - Recent rulings in this area\n    84→   - Landmark cases that shaped the law\n    85→\n    86→2. STATUTES AND REGULATIONS\n    87→   - Applicable federal statutes (U.S. Code)\n    88→   - State statutes and laws\n    89→   - Federal regulations (CFR, Federal Register)\n    90→   - State and local regulations\n    91→\n    92→3. REGULATORY GUIDANCE\n    93→   - Agency interpretive guidance\n    94→   - No-action letters, advisory opinions\n    95→   - Enforcement policy statements\n    96→   - FAQ and compliance bulletins\n    97→\n    98→4. ENFORCEMENT ACTIONS\n    99→   - SEC, DOJ, FTC enforcement actions\n   100→   - State AG actions\n   101→   - Consent decrees and settlements\n   102→   - Criminal prosecutions\n   103→\n   104→5. LITIGATION HISTORY\n   105→   - Active lawsuits and proceedings\n   106→   - Class action filings\n   107→   - Qui tam and whistleblower cases\n   108→   - Arbitration and alternative dispute resolution\n   109→\n   110→6. LEGAL COMMENTARY\n   111→   - Law review articles and legal scholarship\n   112→   - Bar association publications\n   113→   - Legal blog analysis\n   114→   - Expert commentary\n   115→\n   116→7. REGULATORY FILINGS\n   117→   - SEC filings (8-K, 10-K risk factors)\n   118→   - Lobbying disclosures\n   119→   - Comment letters on proposed rules\n   120→   - Patent and trademark filings\n   121→\n   122→8. CONTRACTUAL ANALYSIS\n   123→   - Standard contract terms in this area\n   124→   - Key contractual provisions\n   125→   - Industry standard agreements\n   126→   - Licensing and IP arrangements\n   127→\n   128→9. COMPLIANCE REQUIREMENTS\n   129→   - Regulatory compliance checklists\n   130→   - Industry standards and best practices\n   131→   - Self-regulatory organization rules\n   132→   - International compliance requirements\n   133→\n   134→10. LEGAL TRENDS\n   135→    - Proposed legislation\n   136→    - Regulatory reform initiatives\n   137→    - Emerging legal theories\n   138→    - Judicial appointment impacts\n   139→\n   140→For a \"{granularity}\" depth level:\n   141→- \"quick\": Focus on most relevant cases and current regulations\n   142→- \"standard\": Balanced coverage of cases, regulations, and enforcement\n   143→- \"deep\": Comprehensive legal research including commentary and trends\n   144→\n   145→Return a JSON array of exactly {max_searches} search query strings, ordered by importance.\n   146→Example: [\"SEC v Company X securities fraud case 2024\", \"GDPR compliance requirements data breach\", ...]\n   147→\"\"\"\n   148→\n   149→        result = await self._call_gemini_json(prompt)\n   150→\n   151→        if isinstance(result, list):\n   152→            return result[:max_searches]\n   153→        return []\n   154→\n   155→    async def extract_findings(\n   156→        self,\n   157→        query: str,\n   158→        sources: List[Dict[str, Any]],\n   159→        synthesized_content: str,\n   160→        granularity: str = \"standard\",\n   161→    ) -> List[Dict[str, Any]]:\n   162→        \"\"\"Extract legal research findings.\"\"\"\n   163→        # Build source context\n   164→        source_context = \"\\n\\n\".join([\n   165→            f\"Source: {s.get('title', 'Unknown')} ({s.get('url', '')})\\n\"\n   166→            f\"Credibility: {s.get('credibility_score', 'Unknown')}\\n\"\n   167→            f\"Domain: {s.get('domain', '')}\"\n   168→            for s in sources[:20]\n   169→        ])\n   170→\n   171→        prompt = f\"\"\"\n   172→You are a legal research analyst extracting key findings for legal analysis.\n   173→\n   174→Research Topic: {query}\n   175→\n   176→Synthesized Research Content:\n   177→{synthesized_content[:15000]}\n   178→\n   179→Sources Referenced:\n   180→{source_context}\n   181→\n   182→Extract findings in these legal research categories:\n   183→\n   184→1. CASE LAW (finding_type: \"evidence\")\n   185→   - Court decisions and holdings\n   186→   - Include: case name, court, date, holding\n   187→   - Note precedential value and applicability\n   188→   - extracted_data: {{\"case_name\": \"...\", \"court\": \"...\", \"date\": \"...\", \"citation\": \"...\", \"holding\": \"...\", \"precedential_value\": \"binding/persuasive\"}}\n   189→\n   190→2. STATUTES AND REGULATIONS (finding_type: \"fact\")\n   191→   - Applicable laws and regulations\n   192→   - Include: statute/regulation name, citation, key provisions\n   193→   - Note effective date and amendments\n   194→   - extracted_data: {{\"name\": \"...\", \"citation\": \"...\", \"key_provisions\": [...], \"effective_date\": \"...\"}}\n   195→\n   196→3. ENFORCEMENT ACTIONS (finding_type: \"event\")\n   197→   - Regulatory enforcement and prosecutions\n   198→   - Include: agency, respondent, date, allegations, outcome\n   199→   - Note penalties, injunctions, and remedies\n   200→   - extracted_data: {{\"agency\": \"...\", \"respondent\": \"...\", \"date\": \"...\", \"allegations\": [...], \"outcome\": \"...\", \"penalty\": ...}}\n   201→\n   202→4. LITIGATION (finding_type: \"event\")\n   203→   - Active and resolved lawsuits\n   204→   - Include: parties, court, claims, status\n   205→   - Note settlement amounts if disclosed\n   206→   - extracted_data: {{\"case_name\": \"...\", \"court\": \"...\", \"filing_date\": \"...\", \"claims\": [...], \"status\": \"...\", \"settlement\": ...}}\n   207→\n   208→5. REGULATORY GUIDANCE (finding_type: \"claim\")\n   209→   - Agency interpretations and guidance\n   210→   - Include: agency, date, topic, key points\n   211→   - Note legal weight and binding nature\n   212→   - extracted_data: {{\"agency\": \"...\", \"document_type\": \"...\", \"date\": \"...\", \"topic\": \"...\", \"key_points\": [...]}}\n   213→\n   214→6. LEGAL RISKS (finding_type: \"pattern\")\n   215→   - Identified legal exposure patterns\n   216→   - Include: risk type, likelihood, severity\n   217→   - Note mitigation strategies if mentioned\n   218→   - extracted_data: {{\"risk_type\": \"...\", \"likelihood\": \"high/medium/low\", \"severity\": \"high/medium/low\", \"mitigation\": [...]}}\n   219→\n   220→7. COMPLIANCE REQUIREMENTS (finding_type: \"fact\")\n   221→   - Specific compliance obligations\n   222→   - Include: requirement, authority, deadline\n   223→   - Note penalties for non-compliance\n   224→   - extracted_data: {{\"requirement\": \"...\", \"authority\": \"...\", \"deadline\": \"...\", \"penalty\": \"...\"}}\n   225→\n   226→8. LEGAL PRECEDENT (finding_type: \"relationship\")\n   227→   - How cases relate to each other\n   228→   - Include: cases involved, relationship type\n   229→   - Note whether overruled or distinguished\n   230→   - extracted_data: {{\"citing_case\": \"...\", \"cited_case\": \"...\", \"relationship\": \"follows/distinguishes/overrules/questions\"}}\n   231→\n   232→9. LEGAL ANALYSIS (finding_type: \"claim\")\n   233→   - Expert legal opinions and commentary\n   234→   - Include: source, position, reasoning\n   235→   - Note author credentials\n   236→   - extracted_data: {{\"source\": \"...\", \"author\": \"...\", \"position\": \"...\", \"reasoning\": \"...\"}}\n   237→\n   238→10. KNOWLEDGE GAPS (finding_type: \"gap\")\n   239→    - Missing legal research\n   240→    - What additional research is needed\n   241→    - Suggested follow-up sources\n   242→\n   243→For each finding, return:\n   244→- finding_type: One of 'evidence', 'fact', 'event', 'claim', 'pattern', 'relationship', 'gap'\n   245→- content: Detailed finding with specific citations and facts\n   246→- summary: One sentence\n   247→- analysis: YOUR EXPERT LEGAL ANALYSIS (REQUIRED - 2-4 sentences) explaining:\n   248→  * The LEGAL SIGNIFICANCE of this finding and how it affects the matter at hand\n   249→  * How this PRECEDENT or REGULATION applies to the specific situation\n   250→  * What RISKS or OPPORTUNITIES this creates from a legal perspective\n   251→  * How this COMPARES to similar cases or regulatory interpretations\n   252→- confidence_score: 0.0-1.0 (based on source authority and recency)\n   253→- temporal_context: 'past', 'present', 'ongoing', or 'prediction'\n   254→- extracted_data: JSON object with structured legal data as specified above\n   255→\n   256→CRITICAL: The \"analysis\" field must provide substantive legal reasoning, not just describe the finding.\n   257→Good example: \"This Supreme Court holding is controlling precedent that directly applies to the current matter. The Court's reasoning suggests a broad interpretation that would likely cover the conduct at issue. However, the concurrence's narrower reading has been adopted by some circuit courts, creating potential for distinguishing arguments.\"\n   258→\n   259→Return as JSON array. Prioritize accuracy and proper legal citations.\n   260→\"\"\"\n   261→\n   262→        result = await self._call_gemini_json(prompt)\n   263→\n   264→        findings = []\n   265→        if isinstance(result, list):\n   266→            for f in result:\n   267→                if isinstance(f, dict):\n   268→                    findings.append({\n   269→                        \"finding_type\": f.get(\"finding_type\", \"fact\"),\n   270→                        \"content\": f.get(\"content\", \"\"),\n   271→                        \"summary\": f.get(\"summary\"),\n   272→                        \"analysis\": f.get(\"analysis\", \"\"),\n   273→                        \"confidence_score\": f.get(\"confidence_score\", 0.5),\n   274→                        \"temporal_context\": f.get(\"temporal_context\", \"present\"),\n   275→                        \"extracted_data\": f.get(\"extracted_data\"),\n   276→                    })\n   277→\n   278→        return findings\n   279→\n   280→    # ========== LEGAL-SPECIFIC REPORT GENERATION ==========\n   281→\n   282→    def get_supported_report_variants(self) -> List[str]:\n   283→        \"\"\"Legal template supports legal_brief and compliance_assessment variants.\"\"\"\n   284→        return [\"full_report\", \"executive_summary\", \"legal_brief\", \"compliance_assessment\"]\n   285→\n   286→    def generate_legal_brief(\n   287→        self,\n   288→        result: Dict[str, Any],\n   289→        title: Optional[str] = None,\n   290→    ) -> str:\n   291→        \"\"\"Generate legal brief report - legal-specific variant.\"\"\"\n   292→        from datetime import datetime\n   293→\n   294→        query = result.get(\"query\", \"Unknown\")\n   295→        report_title = title or f\"Legal Brief: {query[:40]}\"\n   296→\n   297→        sections = []\n   298→        sections.append(f\"# {report_title}\")\n   299→        sections.append(\"\")\n   300→        sections.append(f\"**Subject:** {query}\")\n   301→        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n   302→        sections.append(\"\")\n   303→        sections.append(\"---\")\n   304→        sections.append(\"\")\n   305→\n   306→        findings = result.get(\"findings\", [])\n   307→\n   308→        # Applicable Law\n   309→        statutes = [f for f in findings if f.get(\"finding_type\") == \"fact\"\n   310→                    and (\"statute\" in f.get(\"content\", \"\").lower() or \"regulation\" in f.get(\"content\", \"\").lower())]\n   311→        if statutes:\n   312→            sections.append(\"## Applicable Law\")\n   313→            sections.append(\"\")\n   314→            for s in statutes[:5]:\n   315→                extracted = s.get(\"extracted_data\", {})\n   316→                if extracted and isinstance(extracted, dict):\n   317→                    name = extracted.get(\"name\", \"\")\n   318→                    citation = extracted.get(\"citation\", \"\")\n   319→                    if name and citation:\n   320→                        sections.append(f\"- **{name}** ({citation})\")\n   321→                else:\n   322→                    sections.append(f\"- {s.get('summary') or s.get('content', '')[:100]}\")\n   323→            sections.append(\"\")\n   324→\n   325→        # Relevant Case Law\n   326→        cases = [f for f in findings if f.get(\"finding_type\") == \"evidence\"]\n   327→        if cases:\n   328→            sections.append(\"## Relevant Case Law\")\n   329→            sections.append(\"\")\n   330→            for case in cases[:6]:\n   331→                extracted = case.get(\"extracted_data\", {})\n   332→                if extracted and isinstance(extracted, dict):\n   333→                    case_name = extracted.get(\"case_name\", \"\")\n   334→                    citation = extracted.get(\"citation\", \"\")\n   335→                    holding = extracted.get(\"holding\", \"\")\n   336→                    if case_name:\n   337→                        sections.append(f\"### {case_name}\")\n   338→                        if citation:\n   339→                            sections.append(f\"*{citation}*\")\n   340→                        sections.append(\"\")\n   341→                        if holding:\n   342→                            sections.append(f\"**Holding:** {holding}\")\n   343→                        sections.append(\"\")\n   344→                else:\n   345→                    sections.append(f\"- {case.get('summary') or case.get('content', '')[:150]}\")\n   346→            sections.append(\"\")\n   347→\n   348→        # Legal Analysis\n   349→        perspectives = result.get(\"perspectives\", [])\n   350→        litigation = next((p for p in perspectives if \"litigation\" in p.get(\"perspective_type\", \"\").lower()), None)\n   351→        if litigation:\n   352→            sections.append(\"## Legal Analysis\")\n   353→            sections.append(\"\")\n   354→            sections.append(litigation.get(\"analysis_text\", \"\")[:800])\n   355→            sections.append(\"\")\n   356→\n   357→        # Risk Assessment\n   358→        risks = [f for f in findings if f.get(\"finding_type\") == \"pattern\"]\n   359→        if risks:\n   360→            sections.append(\"## Legal Risk Assessment\")\n   361→            sections.append(\"\")\n   362→            for r in risks[:5]:\n   363→                sections.append(f\"- {r.get('summary') or r.get('content', '')[:100]}\")\n   364→            sections.append(\"\")\n   365→\n   366→        # Recommendations\n   367→        sections.append(\"## Recommendations\")\n   368→        sections.append(\"\")\n   369→        for p in perspectives:\n   370→            recs = p.get(\"recommendations\", [])\n   371→            for rec in recs[:2]:\n   372→                sections.append(f\"- {rec}\")\n   373→        sections.append(\"\")\n   374→\n   375→        return \"\\n\".join(sections)\n   376→\n   377→    def generate_compliance_assessment(\n   378→        self,\n   379→        result: Dict[str, Any],\n   380→        title: Optional[str] = None,\n   381→    ) -> str:\n   382→        \"\"\"Generate compliance assessment report - legal-specific variant.\"\"\"\n   383→        from datetime import datetime\n   384→\n   385→        query = result.get(\"query\", \"Unknown\")\n   386→        report_title = title or f\"Compliance Assessment: {query[:40]}\"\n   387→\n   388→        sections = []\n   389→        sections.append(f\"# {report_title}\")\n   390→        sections.append(\"\")\n   391→        sections.append(f\"**Subject:** {query}\")\n   392→        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n   393→        sections.append(\"\")\n   394→        sections.append(\"---\")\n   395→        sections.append(\"\")\n   396→\n   397→        findings = result.get(\"findings\", [])\n   398→\n   399→        # Compliance Requirements\n   400→        requirements = [f for f in findings if f.get(\"finding_type\") == \"fact\"]\n   401→        if requirements:\n   402→            sections.append(\"## Compliance Requirements\")\n   403→            sections.append(\"\")\n   404→            for req in requirements[:6]:\n   405→                extracted = req.get(\"extracted_data\", {})\n   406→                if extracted and isinstance(extracted, dict):\n   407→                    requirement = extracted.get(\"requirement\", \"\")\n   408→                    authority = extracted.get(\"authority\", \"\")\n   409→                    if requirement:\n   410→                        sections.append(f\"- **{requirement}** (Authority: {authority})\")\n   411→                else:\n   412→                    sections.append(f\"- {req.get('summary') or req.get('content', '')[:100]}\")\n   413→            sections.append(\"\")\n   414→\n   415→        # Enforcement Actions\n   416→        enforcement = [f for f in findings if f.get(\"finding_type\") == \"event\"]\n   417→        if enforcement:\n   418→            sections.append(\"## Relevant Enforcement Actions\")\n   419→            sections.append(\"\")\n   420→            for e in enforcement[:5]:\n   421→                extracted = e.get(\"extracted_data\", {})\n   422→                if extracted and isinstance(extracted, dict):\n   423→                    agency = extracted.get(\"agency\", \"\")\n   424→                    respondent = extracted.get(\"respondent\", \"\")\n   425→                    outcome = extracted.get(\"outcome\", \"\")\n   426→                    if agency and respondent:\n   427→                        sections.append(f\"- **{agency} v. {respondent}**: {outcome}\")\n   428→                else:\n   429→                    sections.append(f\"- {e.get('summary') or e.get('content', '')[:100]}\")\n   430→            sections.append(\"\")\n   431→\n   432→        # Compliance Gaps\n   433→        gaps = [f for f in findings if f.get(\"finding_type\") == \"gap\"]\n   434→        if gaps:\n   435→            sections.append(\"## Identified Compliance Gaps\")\n   436→            sections.append(\"\")\n   437→            for g in gaps[:5]:\n   438→                sections.append(f\"- {g.get('summary') or g.get('content', '')[:100]}\")\n   439→            sections.append(\"\")\n   440→\n   441→        # Regulatory Expert Analysis\n   442→        perspectives = result.get(\"perspectives\", [])\n   443→        regulatory = next((p for p in perspectives if \"regulatory\" in p.get(\"perspective_type\", \"\").lower()), None)\n   444→        if regulatory:\n   445→            sections.append(\"## Regulatory Analysis\")\n   446→            sections.append(\"\")\n   447→            sections.append(regulatory.get(\"analysis_text\", \"\")[:600])\n   448→            sections.append(\"\")\n   449→            warnings = regulatory.get(\"warnings\", [])\n   450→            if warnings:\n   451→                sections.append(\"**Compliance Warnings:**\")\n   452→                for w in warnings[:4]:\n   453→                    sections.append(f\"- {w}\")\n   454→            sections.append(\"\")\n   455→\n   456→        # Remediation Recommendations\n   457→        sections.append(\"## Remediation Recommendations\")\n   458→        sections.append(\"\")\n   459→        for p in perspectives:\n   460→            recs = p.get(\"recommendations\", [])\n   461→            for rec in recs[:3]:\n   462→                sections.append(f\"- {rec}\")\n   463→        sections.append(\"\")\n   464→\n   465→        return \"\\n\".join(sections)\n   466→\n   467→    def _get_priority_findings(self, findings: List[Dict[str, Any]]) -> List[Dict[str, Any]]:\n   468→        \"\"\"Legal template prioritizes evidence (case law) and facts (statutes).\"\"\"\n   469→        priority_types = [\"evidence\", \"fact\", \"event\", \"pattern\", \"claim\"]\n   470→        prioritized = []\n   471→\n   472→        for ftype in priority_types:\n   473→            type_findings = [f for f in findings if f.get(\"finding_type\") == ftype]\n   474→            prioritized.extend(sorted(\n   475→                type_findings,\n   476→                key=lambda x: x.get(\"confidence_score\", 0),\n   477→                reverse=True\n   478→            ))\n   479→\n   480→        remaining = [f for f in findings if f not in prioritized]\n   481→        prioritized.extend(sorted(remaining, key=lambda x: x.get(\"confidence_score\", 0), reverse=True))\n   482→\n   483→        return prioritized\n   484→\n   485→    def _generate_key_sections(self, result: Dict[str, Any]) -> str:\n   486→        \"\"\"Generate legal-specific key sections: Case Law, Statutes.\"\"\"\n   487→        findings = result.get(\"findings\", [])\n   488→        sections = []\n   489→\n   490→        # Key Case Law\n   491→        cases = [f for f in findings if f.get(\"finding_type\") == \"evidence\"]\n   492→        if cases:\n   493→            sections.append(\"## Key Case Law\")\n   494→            sections.append(\"\")\n   495→            for case in cases[:4]:\n   496→                sections.append(f\"- {case.get('summary') or case.get('content', '')[:100]}\")\n   497→            sections.append(\"\")\n   498→\n   499→        # Applicable Statutes\n   500→        statutes = [f for f in findings if f.get(\"finding_type\") == \"fact\"]\n   501→        if statutes:\n   502→            sections.append(\"## Applicable Statutes & Regulations\")\n   503→            sections.append(\"\")\n   504→            for s in statutes[:4]:\n   505→                sections.append(f\"- {s.get('summary') or s.get('content', '')[:100]}\")\n   506→            sections.append(\"\")\n   507→\n   508→        return \"\\n\".join(sections)\n   509→\n   510→    def _generate_executive_highlights(self, result: Dict[str, Any]) -> str:\n   511→        \"\"\"Generate legal-specific executive highlights.\"\"\"\n   512→        findings = result.get(\"findings\", [])\n   513→        sections = []\n   514→\n   515→        # Legal risks highlight\n   516→        risks = [f for f in findings if f.get(\"finding_type\") == \"pattern\"]\n   517→        if risks:\n   518→            sections.append(\"## Key Legal Risks\")\n   519→            sections.append(\"\")\n   520→            for r in risks[:3]:\n   521→                sections.append(f\"- {r.get('summary') or r.get('content', '')[:80]}\")\n   522→            sections.append(\"\")\n   523→\n   524→        return \"\\n\".join(sections)\n   525→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"82343d47-30e9-47a3-93fa-efd2489cfa93","uuid":"dd46ecbf-c745-4979-8f3f-e5627d951bc1","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\actor\\src\\templates\\legal.py","content":"\"\"\"Legal research template.\"\"\"\n\nfrom typing import List, Dict, Any, Optional\n\nfrom .base import BaseTemplate\nfrom ..services.report_components import (\n    ComponentType, ComponentConfig, ReportHints, get_report_hints\n)\n\n\nclass LegalTemplate(BaseTemplate):\n    \"\"\"Template for legal research, regulatory analysis, and compliance.\"\"\"\n\n    template_id = \"legal\"\n    template_name = \"Legal Research\"\n    description = \"Legal case research, regulatory analysis, and compliance assessment\"\n\n    # Report hints for component-based rendering\n    report_hints = ReportHints(\n        template_type=\"legal\",\n        structure=\"narrative_first\",\n        findings_grouping=\"category\",\n        tone=\"professional\",\n        decision_format=\"recommendation\",\n        emphasis=[\"legal_precedents\", \"regulatory_implications\", \"compliance_requirements\"],\n        required_components=[\n            ComponentType.LEGAL_CASE_TRACKER,\n            ComponentType.FINDINGS_TABLE,\n            ComponentType.TIMELINE,\n        ],\n        optional_components=[\n            ComponentType.KEY_INSIGHTS,\n            ComponentType.CHECKLIST,\n            ComponentType.RISK_MATRIX,\n            ComponentType.ACTION_ITEMS,\n        ],\n        visualization_preference=[\"case_timeline\", \"jurisdiction_map\", \"precedent_chain\"],\n        custom_sections={\n            \"show_case_citations\": True,\n            \"compliance_checklist\": True,\n            \"regulatory_timeline\": True,\n        }\n    )\n\n    # Expert perspectives for legal analysis\n    default_perspectives = [\n        \"litigation_strategist\",   # Case strength, discovery, outcomes\n        \"regulatory_expert\",       # Compliance, enforcement, political factors\n        \"legal_liability\",         # Liability exposure, evidence strength\n        \"forensic_financial\",      # Financial crimes, fraud patterns\n    ]\n\n    default_max_searches = 10\n\n    # Legal research is more factual - court citations are verifiable\n    # Focus on source quality (primary legal sources) over bias detection\n    verification_config = {\n        \"cross_reference\": \"light\",         # Legal citations are specific\n        \"bias_detection\": \"light\",          # Less bias in case law\n        \"expert_sanity_check\": \"light\",     # Legal findings are factual\n        \"source_quality\": \"thorough\",       # Primary sources (court filings) critical\n    }\n\n    async def generate_search_queries(\n        self,\n        query: str,\n        max_searches: int,\n        granularity: str = \"standard\",\n    ) -> List[str]:\n        \"\"\"Generate legal research search queries.\"\"\"\n        prompt = f\"\"\"\nYou are a legal researcher planning comprehensive legal research for a law firm or legal department.\n\nResearch Topic: {query}\n\nDepth Level: {granularity}\n\nGenerate search queries covering these legal research angles:\n\n1. CASE LAW\n   - Relevant federal and state court decisions\n   - Appellate decisions and precedents\n   - Recent rulings in this area\n   - Landmark cases that shaped the law\n\n2. STATUTES AND REGULATIONS\n   - Applicable federal statutes (U.S. Code)\n   - State statutes and laws\n   - Federal regulations (CFR, Federal Register)\n   - State and local regulations\n\n3. REGULATORY GUIDANCE\n   - Agency interpretive guidance\n   - No-action letters, advisory opinions\n   - Enforcement policy statements\n   - FAQ and compliance bulletins\n\n4. ENFORCEMENT ACTIONS\n   - SEC, DOJ, FTC enforcement actions\n   - State AG actions\n   - Consent decrees and settlements\n   - Criminal prosecutions\n\n5. LITIGATION HISTORY\n   - Active lawsuits and proceedings\n   - Class action filings\n   - Qui tam and whistleblower cases\n   - Arbitration and alternative dispute resolution\n\n6. LEGAL COMMENTARY\n   - Law review articles and legal scholarship\n   - Bar association publications\n   - Legal blog analysis\n   - Expert commentary\n\n7. REGULATORY FILINGS\n   - SEC filings (8-K, 10-K risk factors)\n   - Lobbying disclosures\n   - Comment letters on proposed rules\n   - Patent and trademark filings\n\n8. CONTRACTUAL ANALYSIS\n   - Standard contract terms in this area\n   - Key contractual provisions\n   - Industry standard agreements\n   - Licensing and IP arrangements\n\n9. COMPLIANCE REQUIREMENTS\n   - Regulatory compliance checklists\n   - Industry standards and best practices\n   - Self-regulatory organization rules\n   - International compliance requirements\n\n10. LEGAL TRENDS\n    - Proposed legislation\n    - Regulatory reform initiatives\n    - Emerging legal theories\n    - Judicial appointment impacts\n\nFor a \"{granularity}\" depth level:\n- \"quick\": Focus on most relevant cases and current regulations\n- \"standard\": Balanced coverage of cases, regulations, and enforcement\n- \"deep\": Comprehensive legal research including commentary and trends\n\nReturn a JSON array of exactly {max_searches} search query strings, ordered by importance.\nExample: [\"SEC v Company X securities fraud case 2024\", \"GDPR compliance requirements data breach\", ...]\n\"\"\"\n\n        result = await self._call_gemini_json(prompt)\n\n        if isinstance(result, list):\n            return result[:max_searches]\n        return []\n\n    async def extract_findings(\n        self,\n        query: str,\n        sources: List[Dict[str, Any]],\n        synthesized_content: str,\n        granularity: str = \"standard\",\n    ) -> List[Dict[str, Any]]:\n        \"\"\"Extract legal research findings.\"\"\"\n        # Build source context\n        source_context = \"\\n\\n\".join([\n            f\"Source: {s.get('title', 'Unknown')} ({s.get('url', '')})\\n\"\n            f\"Credibility: {s.get('credibility_score', 'Unknown')}\\n\"\n            f\"Domain: {s.get('domain', '')}\"\n            for s in sources[:20]\n        ])\n\n        prompt = f\"\"\"\nYou are a legal research analyst extracting key findings for legal analysis.\n\nResearch Topic: {query}\n\nSynthesized Research Content:\n{synthesized_content[:15000]}\n\nSources Referenced:\n{source_context}\n\nExtract findings in these legal research categories:\n\n1. CASE LAW (finding_type: \"evidence\")\n   - Court decisions and holdings\n   - Include: case name, court, date, holding\n   - Note precedential value and applicability\n   - extracted_data: {{\"case_name\": \"...\", \"court\": \"...\", \"date\": \"...\", \"citation\": \"...\", \"holding\": \"...\", \"precedential_value\": \"binding/persuasive\"}}\n\n2. STATUTES AND REGULATIONS (finding_type: \"fact\")\n   - Applicable laws and regulations\n   - Include: statute/regulation name, citation, key provisions\n   - Note effective date and amendments\n   - extracted_data: {{\"name\": \"...\", \"citation\": \"...\", \"key_provisions\": [...], \"effective_date\": \"...\"}}\n\n3. ENFORCEMENT ACTIONS (finding_type: \"event\")\n   - Regulatory enforcement and prosecutions\n   - Include: agency, respondent, date, allegations, outcome\n   - Note penalties, injunctions, and remedies\n   - extracted_data: {{\"agency\": \"...\", \"respondent\": \"...\", \"date\": \"...\", \"allegations\": [...], \"outcome\": \"...\", \"penalty\": ...}}\n\n4. LITIGATION (finding_type: \"event\")\n   - Active and resolved lawsuits\n   - Include: parties, court, claims, status\n   - Note settlement amounts if disclosed\n   - extracted_data: {{\"case_name\": \"...\", \"court\": \"...\", \"filing_date\": \"...\", \"claims\": [...], \"status\": \"...\", \"settlement\": ...}}\n\n5. REGULATORY GUIDANCE (finding_type: \"claim\")\n   - Agency interpretations and guidance\n   - Include: agency, date, topic, key points\n   - Note legal weight and binding nature\n   - extracted_data: {{\"agency\": \"...\", \"document_type\": \"...\", \"date\": \"...\", \"topic\": \"...\", \"key_points\": [...]}}\n\n6. LEGAL RISKS (finding_type: \"pattern\")\n   - Identified legal exposure patterns\n   - Include: risk type, likelihood, severity\n   - Note mitigation strategies if mentioned\n   - extracted_data: {{\"risk_type\": \"...\", \"likelihood\": \"high/medium/low\", \"severity\": \"high/medium/low\", \"mitigation\": [...]}}\n\n7. COMPLIANCE REQUIREMENTS (finding_type: \"fact\")\n   - Specific compliance obligations\n   - Include: requirement, authority, deadline\n   - Note penalties for non-compliance\n   - extracted_data: {{\"requirement\": \"...\", \"authority\": \"...\", \"deadline\": \"...\", \"penalty\": \"...\"}}\n\n8. LEGAL PRECEDENT (finding_type: \"relationship\")\n   - How cases relate to each other\n   - Include: cases involved, relationship type\n   - Note whether overruled or distinguished\n   - extracted_data: {{\"citing_case\": \"...\", \"cited_case\": \"...\", \"relationship\": \"follows/distinguishes/overrules/questions\"}}\n\n9. LEGAL ANALYSIS (finding_type: \"claim\")\n   - Expert legal opinions and commentary\n   - Include: source, position, reasoning\n   - Note author credentials\n   - extracted_data: {{\"source\": \"...\", \"author\": \"...\", \"position\": \"...\", \"reasoning\": \"...\"}}\n\n10. KNOWLEDGE GAPS (finding_type: \"gap\")\n    - Missing legal research\n    - What additional research is needed\n    - Suggested follow-up sources\n\nFor each finding, return:\n- finding_type: One of 'evidence', 'fact', 'event', 'claim', 'pattern', 'relationship', 'gap'\n- content: Detailed finding with specific citations and facts\n- summary: One sentence\n- analysis: YOUR EXPERT LEGAL ANALYSIS (REQUIRED - 2-4 sentences) explaining:\n  * The LEGAL SIGNIFICANCE of this finding and how it affects the matter at hand\n  * How this PRECEDENT or REGULATION applies to the specific situation\n  * What RISKS or OPPORTUNITIES this creates from a legal perspective\n  * How this COMPARES to similar cases or regulatory interpretations\n- confidence_score: 0.0-1.0 (based on source authority and recency)\n- temporal_context: 'past', 'present', 'ongoing', or 'prediction'\n- extracted_data: JSON object with structured legal data as specified above\n\nCRITICAL: The \"analysis\" field must provide substantive legal reasoning, not just describe the finding.\nGood example: \"This Supreme Court holding is controlling precedent that directly applies to the current matter. The Court's reasoning suggests a broad interpretation that would likely cover the conduct at issue. However, the concurrence's narrower reading has been adopted by some circuit courts, creating potential for distinguishing arguments.\"\n\nReturn as JSON array. Prioritize accuracy and proper legal citations.\n\"\"\"\n\n        result = await self._call_gemini_json(prompt)\n\n        findings = []\n        if isinstance(result, list):\n            for f in result:\n                if isinstance(f, dict):\n                    findings.append({\n                        \"finding_type\": f.get(\"finding_type\", \"fact\"),\n                        \"content\": f.get(\"content\", \"\"),\n                        \"summary\": f.get(\"summary\"),\n                        \"analysis\": f.get(\"analysis\", \"\"),\n                        \"confidence_score\": f.get(\"confidence_score\", 0.5),\n                        \"temporal_context\": f.get(\"temporal_context\", \"present\"),\n                        \"extracted_data\": f.get(\"extracted_data\"),\n                    })\n\n        return findings\n\n    # ========== LEGAL-SPECIFIC REPORT GENERATION ==========\n\n    def get_supported_report_variants(self) -> List[str]:\n        \"\"\"Legal template supports legal_brief and compliance_assessment variants.\"\"\"\n        return [\"full_report\", \"executive_summary\", \"legal_brief\", \"compliance_assessment\"]\n\n    def generate_legal_brief(\n        self,\n        result: Dict[str, Any],\n        title: Optional[str] = None,\n    ) -> str:\n        \"\"\"Generate legal brief report - legal-specific variant.\"\"\"\n        from datetime import datetime\n\n        query = result.get(\"query\", \"Unknown\")\n        report_title = title or f\"Legal Brief: {query[:40]}\"\n\n        sections = []\n        sections.append(f\"# {report_title}\")\n        sections.append(\"\")\n        sections.append(f\"**Subject:** {query}\")\n        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n        sections.append(\"\")\n        sections.append(\"---\")\n        sections.append(\"\")\n\n        findings = result.get(\"findings\", [])\n\n        # Applicable Law\n        statutes = [f for f in findings if f.get(\"finding_type\") == \"fact\"\n                    and (\"statute\" in f.get(\"content\", \"\").lower() or \"regulation\" in f.get(\"content\", \"\").lower())]\n        if statutes:\n            sections.append(\"## Applicable Law\")\n            sections.append(\"\")\n            for s in statutes[:5]:\n                extracted = s.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    name = extracted.get(\"name\", \"\")\n                    citation = extracted.get(\"citation\", \"\")\n                    if name and citation:\n                        sections.append(f\"- **{name}** ({citation})\")\n                else:\n                    sections.append(f\"- {s.get('summary') or s.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Relevant Case Law\n        cases = [f for f in findings if f.get(\"finding_type\") == \"evidence\"]\n        if cases:\n            sections.append(\"## Relevant Case Law\")\n            sections.append(\"\")\n            for case in cases[:6]:\n                extracted = case.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    case_name = extracted.get(\"case_name\", \"\")\n                    citation = extracted.get(\"citation\", \"\")\n                    holding = extracted.get(\"holding\", \"\")\n                    if case_name:\n                        sections.append(f\"### {case_name}\")\n                        if citation:\n                            sections.append(f\"*{citation}*\")\n                        sections.append(\"\")\n                        if holding:\n                            sections.append(f\"**Holding:** {holding}\")\n                        sections.append(\"\")\n                else:\n                    sections.append(f\"- {case.get('summary') or case.get('content', '')[:150]}\")\n            sections.append(\"\")\n\n        # Legal Analysis\n        perspectives = result.get(\"perspectives\", [])\n        litigation = next((p for p in perspectives if \"litigation\" in p.get(\"perspective_type\", \"\").lower()), None)\n        if litigation:\n            sections.append(\"## Legal Analysis\")\n            sections.append(\"\")\n            sections.append(litigation.get(\"analysis_text\", \"\")[:800])\n            sections.append(\"\")\n\n        # Risk Assessment\n        risks = [f for f in findings if f.get(\"finding_type\") == \"pattern\"]\n        if risks:\n            sections.append(\"## Legal Risk Assessment\")\n            sections.append(\"\")\n            for r in risks[:5]:\n                sections.append(f\"- {r.get('summary') or r.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Recommendations\n        sections.append(\"## Recommendations\")\n        sections.append(\"\")\n        for p in perspectives:\n            recs = p.get(\"recommendations\", [])\n            for rec in recs[:2]:\n                sections.append(f\"- {rec}\")\n        sections.append(\"\")\n\n        return \"\\n\".join(sections)\n\n    def generate_compliance_assessment(\n        self,\n        result: Dict[str, Any],\n        title: Optional[str] = None,\n    ) -> str:\n        \"\"\"Generate compliance assessment report - legal-specific variant.\"\"\"\n        from datetime import datetime\n\n        query = result.get(\"query\", \"Unknown\")\n        report_title = title or f\"Compliance Assessment: {query[:40]}\"\n\n        sections = []\n        sections.append(f\"# {report_title}\")\n        sections.append(\"\")\n        sections.append(f\"**Subject:** {query}\")\n        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n        sections.append(\"\")\n        sections.append(\"---\")\n        sections.append(\"\")\n\n        findings = result.get(\"findings\", [])\n\n        # Compliance Requirements\n        requirements = [f for f in findings if f.get(\"finding_type\") == \"fact\"]\n        if requirements:\n            sections.append(\"## Compliance Requirements\")\n            sections.append(\"\")\n            for req in requirements[:6]:\n                extracted = req.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    requirement = extracted.get(\"requirement\", \"\")\n                    authority = extracted.get(\"authority\", \"\")\n                    if requirement:\n                        sections.append(f\"- **{requirement}** (Authority: {authority})\")\n                else:\n                    sections.append(f\"- {req.get('summary') or req.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Enforcement Actions\n        enforcement = [f for f in findings if f.get(\"finding_type\") == \"event\"]\n        if enforcement:\n            sections.append(\"## Relevant Enforcement Actions\")\n            sections.append(\"\")\n            for e in enforcement[:5]:\n                extracted = e.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    agency = extracted.get(\"agency\", \"\")\n                    respondent = extracted.get(\"respondent\", \"\")\n                    outcome = extracted.get(\"outcome\", \"\")\n                    if agency and respondent:\n                        sections.append(f\"- **{agency} v. {respondent}**: {outcome}\")\n                else:\n                    sections.append(f\"- {e.get('summary') or e.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Compliance Gaps\n        gaps = [f for f in findings if f.get(\"finding_type\") == \"gap\"]\n        if gaps:\n            sections.append(\"## Identified Compliance Gaps\")\n            sections.append(\"\")\n            for g in gaps[:5]:\n                sections.append(f\"- {g.get('summary') or g.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Regulatory Expert Analysis\n        perspectives = result.get(\"perspectives\", [])\n        regulatory = next((p for p in perspectives if \"regulatory\" in p.get(\"perspective_type\", \"\").lower()), None)\n        if regulatory:\n            sections.append(\"## Regulatory Analysis\")\n            sections.append(\"\")\n            sections.append(regulatory.get(\"analysis_text\", \"\")[:600])\n            sections.append(\"\")\n            warnings = regulatory.get(\"warnings\", [])\n            if warnings:\n                sections.append(\"**Compliance Warnings:**\")\n                for w in warnings[:4]:\n                    sections.append(f\"- {w}\")\n            sections.append(\"\")\n\n        # Remediation Recommendations\n        sections.append(\"## Remediation Recommendations\")\n        sections.append(\"\")\n        for p in perspectives:\n            recs = p.get(\"recommendations\", [])\n            for rec in recs[:3]:\n                sections.append(f\"- {rec}\")\n        sections.append(\"\")\n\n        return \"\\n\".join(sections)\n\n    def _get_priority_findings(self, findings: List[Dict[str, Any]]) -> List[Dict[str, Any]]:\n        \"\"\"Legal template prioritizes evidence (case law) and facts (statutes).\"\"\"\n        priority_types = [\"evidence\", \"fact\", \"event\", \"pattern\", \"claim\"]\n        prioritized = []\n\n        for ftype in priority_types:\n            type_findings = [f for f in findings if f.get(\"finding_type\") == ftype]\n            prioritized.extend(sorted(\n                type_findings,\n                key=lambda x: x.get(\"confidence_score\", 0),\n                reverse=True\n            ))\n\n        remaining = [f for f in findings if f not in prioritized]\n        prioritized.extend(sorted(remaining, key=lambda x: x.get(\"confidence_score\", 0), reverse=True))\n\n        return prioritized\n\n    def _generate_key_sections(self, result: Dict[str, Any]) -> str:\n        \"\"\"Generate legal-specific key sections: Case Law, Statutes.\"\"\"\n        findings = result.get(\"findings\", [])\n        sections = []\n\n        # Key Case Law\n        cases = [f for f in findings if f.get(\"finding_type\") == \"evidence\"]\n        if cases:\n            sections.append(\"## Key Case Law\")\n            sections.append(\"\")\n            for case in cases[:4]:\n                sections.append(f\"- {case.get('summary') or case.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Applicable Statutes\n        statutes = [f for f in findings if f.get(\"finding_type\") == \"fact\"]\n        if statutes:\n            sections.append(\"## Applicable Statutes & Regulations\")\n            sections.append(\"\")\n            for s in statutes[:4]:\n                sections.append(f\"- {s.get('summary') or s.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        return \"\\n\".join(sections)\n\n    def _generate_executive_highlights(self, result: Dict[str, Any]) -> str:\n        \"\"\"Generate legal-specific executive highlights.\"\"\"\n        findings = result.get(\"findings\", [])\n        sections = []\n\n        # Legal risks highlight\n        risks = [f for f in findings if f.get(\"finding_type\") == \"pattern\"]\n        if risks:\n            sections.append(\"## Key Legal Risks\")\n            sections.append(\"\")\n            for r in risks[:3]:\n                sections.append(f\"- {r.get('summary') or r.get('content', '')[:80]}\")\n            sections.append(\"\")\n\n        return \"\\n\".join(sections)\n","numLines":525,"startLine":1,"totalLines":525}}}
