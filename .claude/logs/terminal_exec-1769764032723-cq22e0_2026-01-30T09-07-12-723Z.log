[2026-01-30T09:07:29.073Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015YZVmVb9MtoGa9UkTYsQb2","type":"tool_result","content":"     1→\"\"\"Reputation Check template for verifying legitimacy and trustworthiness.\"\"\"\n     2→\n     3→from typing import List, Dict, Any, Optional\n     4→from datetime import datetime\n     5→\n     6→from .base import BaseTemplate\n     7→from ..services.report_components import (\n     8→    ComponentType, ComponentConfig, ReportHints, get_report_hints\n     9→)\n    10→\n    11→\n    12→class ReputationTemplate(BaseTemplate):\n    13→    \"\"\"Template for reputation and legitimacy checks.\n    14→\n    15→    Helps users verify whether a business, service, or professional\n    16→    is legitimate and trustworthy before engaging with them.\n    17→    \"\"\"\n    18→\n    19→    template_id = \"reputation\"\n    20→    template_name = \"Reputation Check\"\n    21→    description = \"Verify legitimacy and trustworthiness - scam detection, reviews, and trust signals\"\n    22→\n    23→    # Report hints for component-based rendering\n    24→    report_hints = ReportHints(\n    25→        template_type=\"reputation\",\n    26→        structure=\"verdict_first\",\n    27→        findings_grouping=\"sentiment\",\n    28→        tone=\"advisory\",\n    29→        decision_format=\"checklist\",\n    30→        emphasis=[\"trust_score\", \"red_flags\", \"user_sentiment\", \"verification\"],\n    31→        required_components=[\n    32→            ComponentType.TRUST_DASHBOARD,\n    33→            ComponentType.CHECKLIST,\n    34→            ComponentType.FINDINGS_TABLE,\n    35→        ],\n    36→        optional_components=[\n    37→            ComponentType.QUOTE_CAROUSEL,\n    38→            ComponentType.TIMELINE,\n    39→            ComponentType.KEY_INSIGHTS,\n    40→            ComponentType.SOURCE_LIST,\n    41→        ],\n    42→        visualization_preference=[\"trust_gauge\", \"sentiment_chart\", \"verification_checklist\"],\n    43→        custom_sections={\n    44→            \"trust_score_prominent\": True,\n    45→            \"red_flag_alerts\": True,\n    46→            \"sentiment_breakdown\": True,\n    47→        }\n    48→    )\n    49→\n    50→    # Expert perspectives for reputation checks\n    51→    default_perspectives = [\n    52→        \"consumer_protection\",   # Scam detection focus\n    53→        \"reputation_analyst\",    # Pattern analysis\n    54→        \"fact_checker\",          # Verification specialist\n    55→        \"industry_benchmarker\",  # Comparative assessment\n    56→    ]\n    57→\n    58→    default_max_searches = 6\n    59→\n    60→    # Reputation checks need thorough bias detection (fake reviews are common)\n    61→    verification_config = {\n    62→        \"cross_reference\": \"thorough\",\n    63→        \"bias_detection\": \"thorough\",\n    64→        \"expert_sanity_check\": \"standard\",\n    65→        \"source_quality\": \"thorough\",\n    66→    }\n    67→\n    68→    async def generate_search_queries(\n    69→        self,\n    70→        query: str,\n    71→        max_searches: int,\n    72→        granularity: str = \"standard\",\n    73→    ) -> List[str]:\n    74→        \"\"\"Generate search queries for reputation check research.\"\"\"\n    75→        prompt = f\"\"\"\n    76→You are a consumer protection researcher helping someone verify if an entity is trustworthy.\n    77→\n    78→Subject to Check: {query}\n    79→\n    80→Depth Level: {granularity}\n    81→\n    82→Generate search queries to determine if this entity is legitimate and trustworthy. Cover:\n    83→\n    84→1. SCAM & FRAUD REPORTS\n    85→   - Scam reports, fraud allegations\n    86→   - BBB complaints, FTC reports\n    87→   - Consumer protection warnings\n    88→\n    89→2. REVIEWS & COMPLAINTS\n    90→   - Customer reviews across multiple platforms\n    91→   - Complaint patterns and common issues\n    92→   - Response to complaints\n    93→\n    94→3. LEGITIMACY VERIFICATION\n    95→   - Business registration, licenses\n    96→   - Physical address verification\n    97→   - Contact information validity\n    98→\n    99→4. ONLINE PRESENCE\n   100→   - Website age, domain history\n   101→   - Social media presence and engagement\n   102→   - Professional profiles (LinkedIn, industry directories)\n   103→\n   104→5. INDUSTRY REPUTATION\n   105→   - Industry association membership\n   106→   - Awards, certifications\n   107→   - Peer recognition\n   108→\n   109→6. NEWS & MEDIA\n   110→   - News coverage (positive and negative)\n   111→   - Investigations or exposés\n   112→   - Press releases vs. independent coverage\n   113→\n   114→For a \"{granularity}\" depth level:\n   115→- \"quick\": Focus on 3-4 angles (scam reports, reviews, legitimacy)\n   116→- \"standard\": Cover 5-6 angles\n   117→- \"deep\": Comprehensive coverage\n   118→\n   119→Return a JSON array of exactly {max_searches} search query strings.\n   120→Include \"scam\", \"reviews\", \"complaints\", \"legitimate\" in relevant queries.\n   121→\"\"\"\n   122→\n   123→        result = await self._call_gemini_json(prompt)\n   124→\n   125→        if isinstance(result, list):\n   126→            return result[:max_searches]\n   127→        return []\n   128→\n   129→    async def extract_findings(\n   130→        self,\n   131→        query: str,\n   132→        sources: List[Dict[str, Any]],\n   133→        synthesized_content: str,\n   134→        granularity: str = \"standard\",\n   135→    ) -> List[Dict[str, Any]]:\n   136→        \"\"\"Extract reputation check findings.\"\"\"\n   137→        source_context = \"\\n\\n\".join([\n   138→            f\"Source: {s.get('title', 'Unknown')} ({s.get('url', '')})\\n\"\n   139→            f\"Domain: {s.get('domain', '')}\"\n   140→            for s in sources[:20]\n   141→        ])\n   142→\n   143→        prompt = f\"\"\"\n   144→You are a consumer protection analyst checking if an entity is trustworthy.\n   145→\n   146→Subject: {query}\n   147→\n   148→Synthesized Research Content:\n   149→{synthesized_content[:16000]}\n   150→\n   151→Sources Referenced:\n   152→{source_context}\n   153→\n   154→Extract findings in these categories:\n   155→\n   156→1. TRUST_SIGNAL (finding_type: \"trust_signal\")\n   157→   - Positive indicators of legitimacy\n   158→   - Must be verifiable, not self-reported\n   159→   - extracted_data: {{\"signal_type\": \"\", \"verification_status\": \"verified/unverified/self_reported\", \"source\": \"\", \"strength\": \"strong/moderate/weak\"}}\n   160→\n   161→2. WARNING_SIGN (finding_type: \"warning_sign\")\n   162→   - Red flags and concerns\n   163→   - Be specific about what's concerning and why\n   164→   - extracted_data: {{\"warning_type\": \"\", \"severity\": \"critical/significant/minor\", \"evidence\": \"\", \"recommendation\": \"\"}}\n   165→\n   166→3. COMPLAINT_PATTERN (finding_type: \"complaint_pattern\")\n   167→   - Recurring issues reported by multiple people\n   168→   - extracted_data: {{\"complaint_type\": \"\", \"frequency\": \"many/several/few\", \"resolution\": \"resolved/unresolved/mixed\", \"sources\": []}}\n   169→\n   170→4. VERIFICATION_STATUS (finding_type: \"verification_status\")\n   171→   - Credentials, licenses, certifications\n   172→   - extracted_data: {{\"credential\": \"\", \"issuer\": \"\", \"status\": \"valid/expired/unverifiable/fake\", \"verification_url\": \"\"}}\n   173→\n   174→5. SENTIMENT_TREND (finding_type: \"sentiment_trend\")\n   175→   - How perception has changed over time\n   176→   - extracted_data: {{\"direction\": \"improving/declining/stable\", \"timeframe\": \"\", \"key_events\": [], \"current_sentiment\": \"positive/negative/mixed\"}}\n   177→\n   178→6. COMPARISON_BENCHMARK (finding_type: \"comparison_benchmark\")\n   179→   - How they compare to similar entities\n   180→   - extracted_data: {{\"benchmark\": \"\", \"rating\": \"above_average/average/below_average\", \"comparison_basis\": \"\"}}\n   181→\n   182→For each finding, return:\n   183→- finding_type: One of the types above\n   184→- content: Detailed finding with specific evidence\n   185→- summary: One concise sentence (what users see first)\n   186→- analysis: YOUR EXPERT REPUTATION ANALYSIS (REQUIRED - 2-4 sentences) explaining:\n   187→  * WHY this signal matters for assessing trustworthiness\n   188→  * What this PATTERN indicates about the entity's practices\n   189→  * How this COMPARES to typical behavior of legitimate vs problematic actors\n   190→  * What SPECIFIC RISKS or assurances this provides\n   191→- confidence_score: 0.0-1.0 based on source quality and corroboration\n   192→- temporal_context: 'past', 'present', 'ongoing'\n   193→- extracted_data: Structured data for the finding type\n   194→\n   195→CRITICAL: The \"analysis\" field must provide substantive assessment reasoning, not just describe the finding.\n   196→Good example: \"This pattern of unresolved complaints is a major red flag because legitimate companies typically respond to BBB complaints within 14 days. The consistent theme of delayed refunds suggests systemic cash flow issues or intentional delay tactics. Companies with this complaint volume and non-response rate have a 78% correlation with eventual enforcement action.\"\n   197→\n   198→IMPORTANT:\n   199→- WARNING SIGNS are the most important - surface these first\n   200→- Be skeptical of self-reported credentials\n   201→- Note if reviews appear fake or manipulated\n   202→- Distinguish between isolated incidents and patterns\n   203→\n   204→Return as JSON array. Help the user avoid scams and bad actors.\n   205→\"\"\"\n   206→\n   207→        result = await self._call_gemini_json(prompt)\n   208→\n   209→        findings = []\n   210→        if isinstance(result, list):\n   211→            for f in result:\n   212→                if isinstance(f, dict):\n   213→                    findings.append({\n   214→                        \"finding_type\": f.get(\"finding_type\", \"fact\"),\n   215→                        \"content\": f.get(\"content\", \"\"),\n   216→                        \"summary\": f.get(\"summary\"),\n   217→                        \"analysis\": f.get(\"analysis\", \"\"),\n   218→                        \"confidence_score\": f.get(\"confidence_score\", 0.5),\n   219→                        \"temporal_context\": f.get(\"temporal_context\", \"present\"),\n   220→                        \"extracted_data\": f.get(\"extracted_data\"),\n   221→                    })\n   222→\n   223→        return findings\n   224→\n   225→    def get_supported_report_variants(self) -> List[str]:\n   226→        \"\"\"Reputation check supports trust_report variant.\"\"\"\n   227→        return [\"full_report\", \"executive_summary\", \"trust_report\"]\n   228→\n   229→    def generate_trust_report(\n   230→        self,\n   231→        result: Dict[str, Any],\n   232→        title: Optional[str] = None,\n   233→    ) -> str:\n   234→        \"\"\"Generate trust-focused report.\"\"\"\n   235→        query = result.get(\"query\", \"Unknown\")\n   236→        report_title = title or f\"Reputation Check: {query[:50]}\"\n   237→\n   238→        sections = []\n   239→        sections.append(f\"# {report_title}\")\n   240→        sections.append(\"\")\n   241→        sections.append(f\"**Subject:** {query}\")\n   242→        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n   243→        sections.append(\"\")\n   244→\n   245→        findings = result.get(\"findings\", [])\n   246→\n   247→        # Trust verdict\n   248→        warnings = [f for f in findings if f.get(\"finding_type\") == \"warning_sign\"]\n   249→        critical_warnings = [f for f in warnings\n   250→                           if f.get(\"extracted_data\", {}).get(\"severity\") == \"critical\"]\n   251→        trust_signals = [f for f in findings if f.get(\"finding_type\") == \"trust_signal\"]\n   252→        strong_signals = [f for f in trust_signals\n   253→                        if f.get(\"extracted_data\", {}).get(\"strength\") == \"strong\"]\n   254→\n   255→        sections.append(\"## Trust Verdict\")\n   256→        sections.append(\"\")\n   257→        if critical_warnings:\n   258→            sections.append(\"**DO NOT ENGAGE** - Critical warning signs detected\")\n   259→        elif len(warnings) > len(strong_signals):\n   260→            sections.append(\"**PROCEED WITH CAUTION** - More concerns than trust signals\")\n   261→        elif strong_signals and not warnings:\n   262→            sections.append(\"**APPEARS LEGITIMATE** - Strong trust signals, no warnings\")\n   263→        elif trust_signals and not critical_warnings:\n   264→            sections.append(\"**LIKELY LEGITIMATE** - Some trust signals, minor or no concerns\")\n   265→        else:\n   266→            sections.append(\"**INSUFFICIENT DATA** - Unable to verify, proceed carefully\")\n   267→        sections.append(\"\")\n   268→\n   269→        # Warning signs\n   270→        if warnings:\n   271→            sections.append(\"## Warning Signs\")\n   272→            sections.append(\"\")\n   273→            for w in warnings[:6]:\n   274→                extracted = w.get(\"extracted_data\", {})\n   275→                severity = extracted.get(\"severity\", \"\").upper() if extracted else \"\"\n   276→                prefix = f\"**[{severity}]** \" if severity else \"\"\n   277→                sections.append(f\"- {prefix}{w.get('summary', w.get('content', '')[:100])}\")\n   278→            sections.append(\"\")\n   279→\n   280→        # Complaint patterns\n   281→        complaints = [f for f in findings if f.get(\"finding_type\") == \"complaint_pattern\"]\n   282→        if complaints:\n   283→            sections.append(\"## Complaint Patterns\")\n   284→            sections.append(\"\")\n   285→            for c in complaints[:4]:\n   286→                sections.append(f\"- {c.get('summary', c.get('content', '')[:100])}\")\n   287→            sections.append(\"\")\n   288→\n   289→        # Trust signals\n   290→        if trust_signals:\n   291→            sections.append(\"## Trust Signals\")\n   292→            sections.append(\"\")\n   293→            for t in trust_signals[:5]:\n   294→                extracted = t.get(\"extracted_data\", {})\n   295→                strength = extracted.get(\"strength\", \"\").upper() if extracted else \"\"\n   296→                prefix = f\"**[{strength}]** \" if strength else \"\"\n   297→                sections.append(f\"- {prefix}{t.get('summary', t.get('content', '')[:100])}\")\n   298→            sections.append(\"\")\n   299→\n   300→        # Verification status\n   301→        verifications = [f for f in findings if f.get(\"finding_type\") == \"verification_status\"]\n   302→        if verifications:\n   303→            sections.append(\"## Verification Status\")\n   304→            sections.append(\"\")\n   305→            for v in verifications[:4]:\n   306→                extracted = v.get(\"extracted_data\", {})\n   307→                status = extracted.get(\"status\", \"\").upper() if extracted else \"\"\n   308→                credential = extracted.get(\"credential\", \"\") if extracted else \"\"\n   309→                if credential and status:\n   310→                    sections.append(f\"- **{credential}**: {status}\")\n   311→                else:\n   312→                    sections.append(f\"- {v.get('summary', v.get('content', '')[:100])}\")\n   313→            sections.append(\"\")\n   314→\n   315→        return \"\\n\".join(sections)\n   316→\n   317→    def _get_priority_findings(self, findings: List[Dict[str, Any]]) -> List[Dict[str, Any]]:\n   318→        \"\"\"Reputation check prioritizes warnings and complaint patterns.\"\"\"\n   319→        priority_types = [\"warning_sign\", \"complaint_pattern\", \"verification_status\",\n   320→                        \"trust_signal\", \"sentiment_trend\", \"comparison_benchmark\"]\n   321→        prioritized = []\n   322→\n   323→        for ftype in priority_types:\n   324→            type_findings = [f for f in findings if f.get(\"finding_type\") == ftype]\n   325→            prioritized.extend(sorted(\n   326→                type_findings,\n   327→                key=lambda x: x.get(\"confidence_score\", 0),\n   328→                reverse=True\n   329→            ))\n   330→\n   331→        remaining = [f for f in findings if f not in prioritized]\n   332→        prioritized.extend(sorted(remaining, key=lambda x: x.get(\"confidence_score\", 0), reverse=True))\n   333→\n   334→        return prioritized\n   335→\n   336→    def _group_findings(self, findings: List[Dict[str, Any]]) -> Dict[str, List[Dict[str, Any]]]:\n   337→        \"\"\"Group findings with reputation check priority order.\"\"\"\n   338→        order = [\"warning_sign\", \"complaint_pattern\", \"trust_signal\",\n   339→                \"verification_status\", \"sentiment_trend\", \"comparison_benchmark\"]\n   340→        grouped: Dict[str, List[Dict[str, Any]]] = {}\n   341→\n   342→        for ftype in order:\n   343→            type_findings = [f for f in findings if f.get(\"finding_type\") == ftype]\n   344→            if type_findings:\n   345→                grouped[ftype] = type_findings\n   346→\n   347→        for f in findings:\n   348→            ftype = f.get(\"finding_type\", \"other\")\n   349→            if ftype not in grouped:\n   350→                grouped[ftype] = []\n   351→            if f not in grouped.get(ftype, []):\n   352→                grouped.setdefault(ftype, []).append(f)\n   353→\n   354→        return grouped\n   355→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"82343d47-30e9-47a3-93fa-efd2489cfa93","uuid":"d6127503-fd2b-4475-9b29-6ea8888b441c","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\actor\\src\\templates\\reputation.py","content":"\"\"\"Reputation Check template for verifying legitimacy and trustworthiness.\"\"\"\n\nfrom typing import List, Dict, Any, Optional\nfrom datetime import datetime\n\nfrom .base import BaseTemplate\nfrom ..services.report_components import (\n    ComponentType, ComponentConfig, ReportHints, get_report_hints\n)\n\n\nclass ReputationTemplate(BaseTemplate):\n    \"\"\"Template for reputation and legitimacy checks.\n\n    Helps users verify whether a business, service, or professional\n    is legitimate and trustworthy before engaging with them.\n    \"\"\"\n\n    template_id = \"reputation\"\n    template_name = \"Reputation Check\"\n    description = \"Verify legitimacy and trustworthiness - scam detection, reviews, and trust signals\"\n\n    # Report hints for component-based rendering\n    report_hints = ReportHints(\n        template_type=\"reputation\",\n        structure=\"verdict_first\",\n        findings_grouping=\"sentiment\",\n        tone=\"advisory\",\n        decision_format=\"checklist\",\n        emphasis=[\"trust_score\", \"red_flags\", \"user_sentiment\", \"verification\"],\n        required_components=[\n            ComponentType.TRUST_DASHBOARD,\n            ComponentType.CHECKLIST,\n            ComponentType.FINDINGS_TABLE,\n        ],\n        optional_components=[\n            ComponentType.QUOTE_CAROUSEL,\n            ComponentType.TIMELINE,\n            ComponentType.KEY_INSIGHTS,\n            ComponentType.SOURCE_LIST,\n        ],\n        visualization_preference=[\"trust_gauge\", \"sentiment_chart\", \"verification_checklist\"],\n        custom_sections={\n            \"trust_score_prominent\": True,\n            \"red_flag_alerts\": True,\n            \"sentiment_breakdown\": True,\n        }\n    )\n\n    # Expert perspectives for reputation checks\n    default_perspectives = [\n        \"consumer_protection\",   # Scam detection focus\n        \"reputation_analyst\",    # Pattern analysis\n        \"fact_checker\",          # Verification specialist\n        \"industry_benchmarker\",  # Comparative assessment\n    ]\n\n    default_max_searches = 6\n\n    # Reputation checks need thorough bias detection (fake reviews are common)\n    verification_config = {\n        \"cross_reference\": \"thorough\",\n        \"bias_detection\": \"thorough\",\n        \"expert_sanity_check\": \"standard\",\n        \"source_quality\": \"thorough\",\n    }\n\n    async def generate_search_queries(\n        self,\n        query: str,\n        max_searches: int,\n        granularity: str = \"standard\",\n    ) -> List[str]:\n        \"\"\"Generate search queries for reputation check research.\"\"\"\n        prompt = f\"\"\"\nYou are a consumer protection researcher helping someone verify if an entity is trustworthy.\n\nSubject to Check: {query}\n\nDepth Level: {granularity}\n\nGenerate search queries to determine if this entity is legitimate and trustworthy. Cover:\n\n1. SCAM & FRAUD REPORTS\n   - Scam reports, fraud allegations\n   - BBB complaints, FTC reports\n   - Consumer protection warnings\n\n2. REVIEWS & COMPLAINTS\n   - Customer reviews across multiple platforms\n   - Complaint patterns and common issues\n   - Response to complaints\n\n3. LEGITIMACY VERIFICATION\n   - Business registration, licenses\n   - Physical address verification\n   - Contact information validity\n\n4. ONLINE PRESENCE\n   - Website age, domain history\n   - Social media presence and engagement\n   - Professional profiles (LinkedIn, industry directories)\n\n5. INDUSTRY REPUTATION\n   - Industry association membership\n   - Awards, certifications\n   - Peer recognition\n\n6. NEWS & MEDIA\n   - News coverage (positive and negative)\n   - Investigations or exposés\n   - Press releases vs. independent coverage\n\nFor a \"{granularity}\" depth level:\n- \"quick\": Focus on 3-4 angles (scam reports, reviews, legitimacy)\n- \"standard\": Cover 5-6 angles\n- \"deep\": Comprehensive coverage\n\nReturn a JSON array of exactly {max_searches} search query strings.\nInclude \"scam\", \"reviews\", \"complaints\", \"legitimate\" in relevant queries.\n\"\"\"\n\n        result = await self._call_gemini_json(prompt)\n\n        if isinstance(result, list):\n            return result[:max_searches]\n        return []\n\n    async def extract_findings(\n        self,\n        query: str,\n        sources: List[Dict[str, Any]],\n        synthesized_content: str,\n        granularity: str = \"standard\",\n    ) -> List[Dict[str, Any]]:\n        \"\"\"Extract reputation check findings.\"\"\"\n        source_context = \"\\n\\n\".join([\n            f\"Source: {s.get('title', 'Unknown')} ({s.get('url', '')})\\n\"\n            f\"Domain: {s.get('domain', '')}\"\n            for s in sources[:20]\n        ])\n\n        prompt = f\"\"\"\nYou are a consumer protection analyst checking if an entity is trustworthy.\n\nSubject: {query}\n\nSynthesized Research Content:\n{synthesized_content[:16000]}\n\nSources Referenced:\n{source_context}\n\nExtract findings in these categories:\n\n1. TRUST_SIGNAL (finding_type: \"trust_signal\")\n   - Positive indicators of legitimacy\n   - Must be verifiable, not self-reported\n   - extracted_data: {{\"signal_type\": \"\", \"verification_status\": \"verified/unverified/self_reported\", \"source\": \"\", \"strength\": \"strong/moderate/weak\"}}\n\n2. WARNING_SIGN (finding_type: \"warning_sign\")\n   - Red flags and concerns\n   - Be specific about what's concerning and why\n   - extracted_data: {{\"warning_type\": \"\", \"severity\": \"critical/significant/minor\", \"evidence\": \"\", \"recommendation\": \"\"}}\n\n3. COMPLAINT_PATTERN (finding_type: \"complaint_pattern\")\n   - Recurring issues reported by multiple people\n   - extracted_data: {{\"complaint_type\": \"\", \"frequency\": \"many/several/few\", \"resolution\": \"resolved/unresolved/mixed\", \"sources\": []}}\n\n4. VERIFICATION_STATUS (finding_type: \"verification_status\")\n   - Credentials, licenses, certifications\n   - extracted_data: {{\"credential\": \"\", \"issuer\": \"\", \"status\": \"valid/expired/unverifiable/fake\", \"verification_url\": \"\"}}\n\n5. SENTIMENT_TREND (finding_type: \"sentiment_trend\")\n   - How perception has changed over time\n   - extracted_data: {{\"direction\": \"improving/declining/stable\", \"timeframe\": \"\", \"key_events\": [], \"current_sentiment\": \"positive/negative/mixed\"}}\n\n6. COMPARISON_BENCHMARK (finding_type: \"comparison_benchmark\")\n   - How they compare to similar entities\n   - extracted_data: {{\"benchmark\": \"\", \"rating\": \"above_average/average/below_average\", \"comparison_basis\": \"\"}}\n\nFor each finding, return:\n- finding_type: One of the types above\n- content: Detailed finding with specific evidence\n- summary: One concise sentence (what users see first)\n- analysis: YOUR EXPERT REPUTATION ANALYSIS (REQUIRED - 2-4 sentences) explaining:\n  * WHY this signal matters for assessing trustworthiness\n  * What this PATTERN indicates about the entity's practices\n  * How this COMPARES to typical behavior of legitimate vs problematic actors\n  * What SPECIFIC RISKS or assurances this provides\n- confidence_score: 0.0-1.0 based on source quality and corroboration\n- temporal_context: 'past', 'present', 'ongoing'\n- extracted_data: Structured data for the finding type\n\nCRITICAL: The \"analysis\" field must provide substantive assessment reasoning, not just describe the finding.\nGood example: \"This pattern of unresolved complaints is a major red flag because legitimate companies typically respond to BBB complaints within 14 days. The consistent theme of delayed refunds suggests systemic cash flow issues or intentional delay tactics. Companies with this complaint volume and non-response rate have a 78% correlation with eventual enforcement action.\"\n\nIMPORTANT:\n- WARNING SIGNS are the most important - surface these first\n- Be skeptical of self-reported credentials\n- Note if reviews appear fake or manipulated\n- Distinguish between isolated incidents and patterns\n\nReturn as JSON array. Help the user avoid scams and bad actors.\n\"\"\"\n\n        result = await self._call_gemini_json(prompt)\n\n        findings = []\n        if isinstance(result, list):\n            for f in result:\n                if isinstance(f, dict):\n                    findings.append({\n                        \"finding_type\": f.get(\"finding_type\", \"fact\"),\n                        \"content\": f.get(\"content\", \"\"),\n                        \"summary\": f.get(\"summary\"),\n                        \"analysis\": f.get(\"analysis\", \"\"),\n                        \"confidence_score\": f.get(\"confidence_score\", 0.5),\n                        \"temporal_context\": f.get(\"temporal_context\", \"present\"),\n                        \"extracted_data\": f.get(\"extracted_data\"),\n                    })\n\n        return findings\n\n    def get_supported_report_variants(self) -> List[str]:\n        \"\"\"Reputation check supports trust_report variant.\"\"\"\n        return [\"full_report\", \"executive_summary\", \"trust_report\"]\n\n    def generate_trust_report(\n        self,\n        result: Dict[str, Any],\n        title: Optional[str] = None,\n    ) -> str:\n        \"\"\"Generate trust-focused report.\"\"\"\n        query = result.get(\"query\", \"Unknown\")\n        report_title = title or f\"Reputation Check: {query[:50]}\"\n\n        sections = []\n        sections.append(f\"# {report_title}\")\n        sections.append(\"\")\n        sections.append(f\"**Subject:** {query}\")\n        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n        sections.append(\"\")\n\n        findings = result.get(\"findings\", [])\n\n        # Trust verdict\n        warnings = [f for f in findings if f.get(\"finding_type\") == \"warning_sign\"]\n        critical_warnings = [f for f in warnings\n                           if f.get(\"extracted_data\", {}).get(\"severity\") == \"critical\"]\n        trust_signals = [f for f in findings if f.get(\"finding_type\") == \"trust_signal\"]\n        strong_signals = [f for f in trust_signals\n                        if f.get(\"extracted_data\", {}).get(\"strength\") == \"strong\"]\n\n        sections.append(\"## Trust Verdict\")\n        sections.append(\"\")\n        if critical_warnings:\n            sections.append(\"**DO NOT ENGAGE** - Critical warning signs detected\")\n        elif len(warnings) > len(strong_signals):\n            sections.append(\"**PROCEED WITH CAUTION** - More concerns than trust signals\")\n        elif strong_signals and not warnings:\n            sections.append(\"**APPEARS LEGITIMATE** - Strong trust signals, no warnings\")\n        elif trust_signals and not critical_warnings:\n            sections.append(\"**LIKELY LEGITIMATE** - Some trust signals, minor or no concerns\")\n        else:\n            sections.append(\"**INSUFFICIENT DATA** - Unable to verify, proceed carefully\")\n        sections.append(\"\")\n\n        # Warning signs\n        if warnings:\n            sections.append(\"## Warning Signs\")\n            sections.append(\"\")\n            for w in warnings[:6]:\n                extracted = w.get(\"extracted_data\", {})\n                severity = extracted.get(\"severity\", \"\").upper() if extracted else \"\"\n                prefix = f\"**[{severity}]** \" if severity else \"\"\n                sections.append(f\"- {prefix}{w.get('summary', w.get('content', '')[:100])}\")\n            sections.append(\"\")\n\n        # Complaint patterns\n        complaints = [f for f in findings if f.get(\"finding_type\") == \"complaint_pattern\"]\n        if complaints:\n            sections.append(\"## Complaint Patterns\")\n            sections.append(\"\")\n            for c in complaints[:4]:\n                sections.append(f\"- {c.get('summary', c.get('content', '')[:100])}\")\n            sections.append(\"\")\n\n        # Trust signals\n        if trust_signals:\n            sections.append(\"## Trust Signals\")\n            sections.append(\"\")\n            for t in trust_signals[:5]:\n                extracted = t.get(\"extracted_data\", {})\n                strength = extracted.get(\"strength\", \"\").upper() if extracted else \"\"\n                prefix = f\"**[{strength}]** \" if strength else \"\"\n                sections.append(f\"- {prefix}{t.get('summary', t.get('content', '')[:100])}\")\n            sections.append(\"\")\n\n        # Verification status\n        verifications = [f for f in findings if f.get(\"finding_type\") == \"verification_status\"]\n        if verifications:\n            sections.append(\"## Verification Status\")\n            sections.append(\"\")\n            for v in verifications[:4]:\n                extracted = v.get(\"extracted_data\", {})\n                status = extracted.get(\"status\", \"\").upper() if extracted else \"\"\n                credential = extracted.get(\"credential\", \"\") if extracted else \"\"\n                if credential and status:\n                    sections.append(f\"- **{credential}**: {status}\")\n                else:\n                    sections.append(f\"- {v.get('summary', v.get('content', '')[:100])}\")\n            sections.append(\"\")\n\n        return \"\\n\".join(sections)\n\n    def _get_priority_findings(self, findings: List[Dict[str, Any]]) -> List[Dict[str, Any]]:\n        \"\"\"Reputation check prioritizes warnings and complaint patterns.\"\"\"\n        priority_types = [\"warning_sign\", \"complaint_pattern\", \"verification_status\",\n                        \"trust_signal\", \"sentiment_trend\", \"comparison_benchmark\"]\n        prioritized = []\n\n        for ftype in priority_types:\n            type_findings = [f for f in findings if f.get(\"finding_type\") == ftype]\n            prioritized.extend(sorted(\n                type_findings,\n                key=lambda x: x.get(\"confidence_score\", 0),\n                reverse=True\n            ))\n\n        remaining = [f for f in findings if f not in prioritized]\n        prioritized.extend(sorted(remaining, key=lambda x: x.get(\"confidence_score\", 0), reverse=True))\n\n        return prioritized\n\n    def _group_findings(self, findings: List[Dict[str, Any]]) -> Dict[str, List[Dict[str, Any]]]:\n        \"\"\"Group findings with reputation check priority order.\"\"\"\n        order = [\"warning_sign\", \"complaint_pattern\", \"trust_signal\",\n                \"verification_status\", \"sentiment_trend\", \"comparison_benchmark\"]\n        grouped: Dict[str, List[Dict[str, Any]]] = {}\n\n        for ftype in order:\n            type_findings = [f for f in findings if f.get(\"finding_type\") == ftype]\n            if type_findings:\n                grouped[ftype] = type_findings\n\n        for f in findings:\n            ftype = f.get(\"finding_type\", \"other\")\n            if ftype not in grouped:\n                grouped[ftype] = []\n            if f not in grouped.get(ftype, []):\n                grouped.setdefault(ftype, []).append(f)\n\n        return grouped\n","numLines":355,"startLine":1,"totalLines":355}}}
