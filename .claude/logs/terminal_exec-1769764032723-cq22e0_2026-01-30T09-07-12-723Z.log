[2026-01-30T09:07:47.968Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MxFLmjqXUHbJh9QpSRTri7","type":"tool_result","content":"     1→\"\"\"Financial analysis research template.\"\"\"\n     2→\n     3→from typing import List, Dict, Any, Optional\n     4→\n     5→from .base import BaseTemplate\n     6→from ..services.report_components import (\n     7→    ComponentType, ComponentConfig, ReportHints, get_report_hints\n     8→)\n     9→\n    10→\n    11→class FinancialTemplate(BaseTemplate):\n    12→    \"\"\"Template for financial and stock analysis research.\"\"\"\n    13→\n    14→    template_id = \"financial\"\n    15→    template_name = \"Financial Analysis\"\n    16→    description = \"Stock and financial analysis for investment research\"\n    17→\n    18→    # Report hints for component-based rendering\n    19→    report_hints = ReportHints(\n    20→        template_type=\"financial\",\n    21→        structure=\"quantitative_first\",\n    22→        findings_grouping=\"sentiment\",\n    23→        tone=\"analytical\",\n    24→        decision_format=\"thesis\",\n    25→        emphasis=[\"valuation\", \"risk_assessment\", \"financial_metrics\"],\n    26→        required_components=[\n    27→            ComponentType.INVESTMENT_THESIS,\n    28→            ComponentType.METRIC_CARDS,\n    29→            ComponentType.RISK_MATRIX,\n    30→        ],\n    31→        optional_components=[\n    32→            ComponentType.FINDINGS_TABLE,\n    33→            ComponentType.PREDICTION_CARDS,\n    34→            ComponentType.COMPARISON_TABLE,\n    35→            ComponentType.CONFIDENCE_GAUGE,\n    36→        ],\n    37→        visualization_preference=[\"financial_metrics\", \"risk_matrix\", \"peer_comparison\"],\n    38→        custom_sections={\n    39→            \"show_bull_bear_cases\": True,\n    40→            \"price_targets\": True,\n    41→            \"risk_factors_prominent\": True,\n    42→        }\n    43→    )\n    44→\n    45→    # Expert perspectives for deep financial analysis\n    46→    default_perspectives = [\n    47→        \"institutional_investor\",   # Long-term value creation, moats, management\n    48→        \"short_seller\",             # Red flags, fraud detection, skeptical analysis\n    49→        \"quantitative_risk\",        # Tail risks, stress testing, correlations\n    50→        \"activist_investor\",        # Value creation levers, governance, catalysts\n    51→        \"macro_strategist\",         # Economic cycles, policy risks, global context\n    52→    ]\n    53→\n    54→    default_max_searches = 8\n    55→\n    56→    # Financial analysis needs rigorous verification\n    57→    # Analysts have conflicts, numbers must be verified, projections questioned\n    58→    verification_config = {\n    59→        \"cross_reference\": \"thorough\",      # Verify financial numbers across sources\n    60→        \"bias_detection\": \"thorough\",       # Analyst conflicts, investment banking ties\n    61→        \"expert_sanity_check\": \"thorough\",  # Flag unrealistic valuations/projections\n    62→        \"source_quality\": \"standard\",       # SEC filings are reliable, analyst reports vary\n    63→    }\n    64→\n    65→    async def generate_search_queries(\n    66→        self,\n    67→        query: str,\n    68→        max_searches: int,\n    69→        granularity: str = \"standard\",\n    70→    ) -> List[str]:\n    71→        \"\"\"Generate financial analysis search queries.\"\"\"\n    72→        prompt = f\"\"\"\n    73→You are a financial analyst planning comprehensive research for investment analysis.\n    74→\n    75→Research Topic: {query}\n    76→\n    77→Depth Level: {granularity}\n    78→\n    79→Generate search queries covering these financial analysis angles:\n    80→\n    81→1. EARNINGS AND FUNDAMENTALS\n    82→   - Recent quarterly and annual earnings reports\n    83→   - Revenue trends, margins, profitability metrics\n    84→   - Earnings beats/misses, guidance changes\n    85→   - Balance sheet strength, cash flow analysis\n    86→\n    87→2. ANALYST COVERAGE\n    88→   - Wall Street analyst ratings and price targets\n    89→   - Buy/hold/sell recommendations\n    90→   - Earnings estimates and revisions\n    91→   - Recent analyst upgrades/downgrades\n    92→\n    93→3. MARKET POSITION\n    94→   - Competitive landscape and market share\n    95→   - Industry trends and tailwinds/headwinds\n    96→   - Customer concentration and diversification\n    97→   - Geographic revenue breakdown\n    98→\n    99→4. RISK FACTORS\n   100→   - Regulatory and compliance risks\n   101→   - Macro economic exposure\n   102→   - Supply chain dependencies\n   103→   - Legal and litigation issues\n   104→\n   105→5. VALUATION\n   106→   - Current valuation multiples (P/E, EV/EBITDA, P/S)\n   107→   - Historical valuation ranges\n   108→   - Peer comparison valuations\n   109→   - DCF and fair value estimates\n   110→\n   111→6. NEWS AND CATALYSTS\n   112→   - Recent company announcements\n   113→   - Product launches, partnerships, M&A\n   114→   - Management changes, insider transactions\n   115→   - Upcoming events (earnings, conferences)\n   116→\n   117→7. ECOSYSTEM ANALYSIS (Upstream/Downstream) - MANDATORY\n   118→   You MUST include at least 1-2 dedicated ecosystem queries:\n   119→   - Top customers: \"[COMPANY] top customers revenue concentration 2024 2025\"\n   120→   - Competitors: \"[COMPANY] vs [COMPETITOR] market share comparison\"\n   121→   - For AI/chip companies: \"[COMPANY] hyperscaler capex Microsoft Google Amazon spending\"\n   122→   - Supplier dependencies: \"[COMPANY] supply chain dependencies risks\"\n   123→\n   124→8. BEAR CASE RESEARCH\n   125→   - Include at least one query for contrarian/bearish analysis:\n   126→   - \"[COMPANY] short seller thesis bear case risks\"\n   127→   - \"[COMPANY] stock overvalued concerns\"\n   128→\n   129→For a \"{granularity}\" depth level:\n   130→- \"quick\": 4-5 searches on key fundamentals and analyst sentiment\n   131→- \"standard\": 8-10 searches covering all areas INCLUDING ecosystem and bear case\n   132→- \"deep\": 12+ searches with comprehensive coverage including technicals\n   133→\n   134→CRITICAL: You MUST include at least ONE ecosystem query and ONE bear case query regardless of depth level.\n   135→\n   136→Return a JSON array of exactly {max_searches} search query strings, ordered by importance.\n   137→Example: [\"NVIDIA Q4 2025 earnings analysis\", \"NVIDIA stock analyst ratings price target 2025\", \"NVIDIA top customers hyperscaler capex Microsoft Google Amazon\", \"NVIDIA bear case short seller thesis risks\", ...]\n   138→\"\"\"\n   139→\n   140→        result = await self._call_gemini_json(prompt)\n   141→\n   142→        if isinstance(result, list):\n   143→            return result[:max_searches]\n   144→        return []\n   145→\n   146→    async def extract_findings(\n   147→        self,\n   148→        query: str,\n   149→        sources: List[Dict[str, Any]],\n   150→        synthesized_content: str,\n   151→        granularity: str = \"standard\",\n   152→    ) -> List[Dict[str, Any]]:\n   153→        \"\"\"Extract financial findings with component-aligned types.\"\"\"\n   154→        # Build source context\n   155→        source_context = \"\\n\\n\".join([\n   156→            f\"Source: {s.get('title', 'Unknown')} ({s.get('url', '')})\\n\"\n   157→            f\"Credibility: {s.get('credibility_score', 'Unknown')}\\n\"\n   158→            f\"Domain: {s.get('domain', '')}\"\n   159→            for s in sources[:20]\n   160→        ])\n   161→\n   162→        prompt = f\"\"\"\n   163→You are a financial analyst extracting key findings for investment research.\n   164→CRITICAL: Use EXACT finding_type values specified below - they map to UI components.\n   165→\n   166→Research Topic: {query}\n   167→\n   168→Synthesized Research Content:\n   169→{synthesized_content[:15000]}\n   170→\n   171→Sources Referenced:\n   172→{source_context}\n   173→\n   174→=== USE ONLY THESE finding_type VALUES ===\n   175→\n   176→1. BULLISH SIGNALS (finding_type: \"bullish_signal\")\n   177→   - Positive earnings surprises, revenue beats, margin expansion\n   178→   - Analyst upgrades, price target increases\n   179→   - Growth acceleration, market share gains\n   180→   - Strong guidance, positive management commentary\n   181→\n   182→2. BEARISH SIGNALS (finding_type: \"bearish_signal\")\n   183→   - Earnings misses, revenue declines, margin compression\n   184→   - Analyst downgrades, price target cuts\n   185→   - Growth deceleration, market share losses\n   186→   - Weak guidance, negative management tone\n   187→\n   188→3. RISK FACTORS (finding_type: \"risk\")\n   189→   - Business, market, regulatory, competitive risks\n   190→   - Debt concerns, liquidity issues, concentration risks\n   191→   - Key person dependencies, governance issues\n   192→\n   193→4. RED FLAGS (finding_type: \"red_flag\")\n   194→   - Accounting irregularities, restatements\n   195→   - Insider selling, executive departures\n   196→   - SEC investigations, legal issues, guidance cuts\n   197→\n   198→5. FINANCIAL METRICS (finding_type: \"financial_metric\")\n   199→   - Revenue, EPS, margins with specific numbers\n   200→   - Valuation multiples (P/E, EV/EBITDA)\n   201→   - Price targets with analyst attribution\n   202→\n   203→6. PREDICTIONS (finding_type: \"prediction\")\n   204→   - Forward guidance, analyst forecasts\n   205→   - Industry trend predictions\n   206→\n   207→=== STRICT JSON OUTPUT FORMAT ===\n   208→\n   209→Return JSON array with EXACT structure. CRITICAL: Include \"analysis\" field with YOUR analytical commentary.\n   210→[\n   211→  {{\n   212→    \"finding_type\": \"bullish_signal\",\n   213→    \"summary\": \"NVIDIA data center revenue surged 409% YoY to $18.4B\",\n   214→    \"content\": \"Detailed explanation with numbers, dates, sources...\",\n   215→    \"analysis\": \"This exceptional growth rate significantly outpaces the broader semiconductor industry. The data center segment now represents 78% of total revenue, validating the AI infrastructure investment thesis. However, maintaining such growth rates will be increasingly difficult as the base grows larger.\",\n   216→    \"confidence_score\": 0.95,\n   217→    \"date_referenced\": \"Q3 FY2024\",\n   218→    \"extracted_data\": {{\"metric\": \"Data Center Revenue\", \"value\": \"$18.4B\", \"change\": \"+409% YoY\"}}\n   219→  }},\n   220→  {{\n   221→    \"finding_type\": \"risk\",\n   222→    \"summary\": \"China export restrictions pose 20-25% revenue risk\",\n   223→    \"content\": \"US government export controls on AI chips...\",\n   224→    \"analysis\": \"This is a structural headwind that could persist for years. While NVIDIA has developed compliant alternatives, ASPs are lower. Investors should model a 15-20% China revenue haircut as the new normal rather than expecting policy relaxation.\",\n   225→    \"confidence_score\": 0.85,\n   226→    \"date_referenced\": \"2024\",\n   227→    \"extracted_data\": {{\"risk_type\": \"regulatory\", \"severity\": \"high\"}}\n   228→  }},\n   229→  {{\n   230→    \"finding_type\": \"financial_metric\",\n   231→    \"summary\": \"Morgan Stanley: Overweight rating, $180 target\",\n   232→    \"content\": \"Morgan Stanley analyst Joseph Moore...\",\n   233→    \"analysis\": \"This price target implies ~25% upside from current levels. Morgan Stanley has historically been accurate on semiconductor calls. Their thesis centers on continued hyperscaler CapEx expansion, which aligns with recent guidance from major cloud providers.\",\n   234→    \"confidence_score\": 0.90,\n   235→    \"date_referenced\": \"January 2025\",\n   236→    \"extracted_data\": {{\"analyst\": \"Morgan Stanley\", \"rating\": \"Overweight\", \"target_price\": \"$180\"}}\n   237→  }}\n   238→]\n   239→\n   240→IMPORTANT: The \"analysis\" field should contain YOUR expert analytical commentary explaining:\n   241→- Why this finding matters for the investment thesis\n   242→- What it implies for the future\n   243→- Any caveats or nuances investors should consider\n   244→\n   245→Extract 8-15 findings covering bullish_signal, bearish_signal, risk, red_flag, financial_metric, prediction.\n   246→Return ONLY the JSON array.\n   247→\"\"\"\n   248→\n   249→        result = await self._call_gemini_json(prompt)\n   250→\n   251→        findings = []\n   252→        if isinstance(result, list):\n   253→            for f in result:\n   254→                if isinstance(f, dict):\n   255→                    finding = {\n   256→                        \"finding_type\": f.get(\"finding_type\", \"fact\"),\n   257→                        \"content\": f.get(\"content\", \"\"),\n   258→                        \"summary\": f.get(\"summary\"),\n   259→                        \"analysis\": f.get(\"analysis\", \"\"),  # LLM's analytical commentary\n   260→                        \"confidence_score\": f.get(\"confidence_score\", 0.5),\n   261→                        \"temporal_context\": f.get(\"temporal_context\", \"present\"),\n   262→                        \"date_referenced\": f.get(\"date_referenced\", \"\"),\n   263→                        \"extracted_data\": f.get(\"extracted_data\"),\n   264→                    }\n   265→\n   266→                    # Validate analysis field - generate fallback if too short/empty\n   267→                    analysis = finding.get(\"analysis\", \"\")\n   268→                    if not analysis or len(analysis) < 30:\n   269→                        finding_type = finding.get(\"finding_type\", \"fact\")\n   270→                        content = finding.get(\"content\", \"\")[:200]\n   271→                        summary = finding.get(\"summary\", \"\")\n   272→\n   273→                        # Generate contextual fallback analysis based on finding type\n   274→                        type_context = {\n   275→                            \"bullish_signal\": \"This positive indicator suggests favorable conditions for the investment thesis.\",\n   276→                            \"bearish_signal\": \"This concerning signal warrants caution and may indicate downside risk.\",\n   277→                            \"risk\": \"This risk factor should be monitored as part of ongoing position management.\",\n   278→                            \"red_flag\": \"This red flag requires careful attention and may warrant reducing position size.\",\n   279→                            \"financial_metric\": \"This metric provides insight into the company's financial health and trajectory.\",\n   280→                            \"prediction\": \"This forward-looking indicator may help inform investment timing decisions.\",\n   281→                            \"earnings_data\": \"This earnings data provides context for evaluating company performance.\",\n   282→                            \"valuation\": \"This valuation metric helps assess whether the stock is fairly priced.\",\n   283→                        }\n   284→                        finding[\"analysis\"] = type_context.get(finding_type, \"This finding provides relevant context for the investment thesis.\")\n   285→\n   286→                    findings.append(finding)\n   287→\n   288→        return findings\n   289→\n   290→    # ========== FINANCIAL-SPECIFIC REPORT GENERATION ==========\n   291→\n   292→    def get_supported_report_variants(self) -> List[str]:\n   293→        \"\"\"Financial template supports investment_thesis variant.\"\"\"\n   294→        return [\"full_report\", \"executive_summary\", \"investment_thesis\"]\n   295→\n   296→    def generate_investment_thesis(\n   297→        self,\n   298→        result: Dict[str, Any],\n   299→        title: Optional[str] = None,\n   300→    ) -> str:\n   301→        \"\"\"Generate investment thesis report - financial-specific variant.\"\"\"\n   302→        from datetime import datetime\n   303→\n   304→        query = result.get(\"query\", \"Unknown\")\n   305→        report_title = title or f\"Investment Thesis: {query[:40]}\"\n   306→\n   307→        sections = []\n   308→        sections.append(f\"# {report_title}\")\n   309→        sections.append(\"\")\n   310→        sections.append(f\"**Subject:** {query}\")\n   311→        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n   312→        sections.append(\"\")\n   313→        sections.append(\"---\")\n   314→        sections.append(\"\")\n   315→\n   316→        # Thesis summary\n   317→        sections.append(\"## Investment Thesis\")\n   318→        sections.append(\"\")\n   319→\n   320→        # Extract valuation perspective\n   321→        perspectives = result.get(\"perspectives\", [])\n   322→        valuation = next((p for p in perspectives if \"valuation\" in p.get(\"perspective_type\", \"\").lower()), None)\n   323→        investor = next((p for p in perspectives if \"investor\" in p.get(\"perspective_type\", \"\").lower()), None)\n   324→\n   325→        if valuation:\n   326→            sections.append(valuation.get(\"analysis_text\", \"\"))\n   327→            sections.append(\"\")\n   328→        elif investor:\n   329→            sections.append(investor.get(\"analysis_text\", \"\"))\n   330→            sections.append(\"\")\n   331→\n   332→        # Bull case\n   333→        sections.append(\"## Bull Case\")\n   334→        sections.append(\"\")\n   335→        findings = result.get(\"findings\", [])\n   336→        positive = [f for f in findings if f.get(\"confidence_score\", 0) >= 0.7]\n   337→        for f in positive[:5]:\n   338→            sections.append(f\"- {f.get('summary') or f.get('content', '')[:100]}\")\n   339→        sections.append(\"\")\n   340→\n   341→        # Bear case\n   342→        sections.append(\"## Bear Case / Risks\")\n   343→        sections.append(\"\")\n   344→        risks = [f for f in findings if f.get(\"finding_type\") in [\"pattern\", \"gap\", \"risk\"]]\n   345→        if not risks:\n   346→            risks = [f for f in findings if f.get(\"confidence_score\", 0) < 0.6]\n   347→        for f in risks[:5]:\n   348→            sections.append(f\"- {f.get('summary') or f.get('content', '')[:100]}\")\n   349→        sections.append(\"\")\n   350→\n   351→        # Key metrics\n   352→        metrics = [f for f in findings if f.get(\"finding_type\") == \"fact\"]\n   353→        if metrics:\n   354→            sections.append(\"## Key Financial Metrics\")\n   355→            sections.append(\"\")\n   356→            for m in metrics[:8]:\n   357→                extracted = m.get(\"extracted_data\", {})\n   358→                if extracted and isinstance(extracted, dict):\n   359→                    metric = extracted.get(\"metric\", \"\")\n   360→                    value = extracted.get(\"value\", \"\")\n   361→                    if metric and value:\n   362→                        sections.append(f\"- **{metric}:** {value}\")\n   363→                else:\n   364→                    sections.append(f\"- {m.get('summary') or m.get('content', '')[:80]}\")\n   365→            sections.append(\"\")\n   366→\n   367→        # Recommendations\n   368→        sections.append(\"## Recommendations\")\n   369→        sections.append(\"\")\n   370→        for p in perspectives:\n   371→            recs = p.get(\"recommendations\", [])\n   372→            for rec in recs[:2]:\n   373→                sections.append(f\"- {rec}\")\n   374→        sections.append(\"\")\n   375→\n   376→        # Warnings\n   377→        all_warnings = []\n   378→        for p in perspectives:\n   379→            all_warnings.extend(p.get(\"warnings\", []))\n   380→        if all_warnings:\n   381→            sections.append(\"## Risk Warnings\")\n   382→            sections.append(\"\")\n   383→            for warning in all_warnings[:5]:\n   384→                sections.append(f\"- {warning}\")\n   385→            sections.append(\"\")\n   386→\n   387→        return \"\\n\".join(sections)\n   388→\n   389→    def _get_priority_findings(self, findings: List[Dict[str, Any]]) -> List[Dict[str, Any]]:\n   390→        \"\"\"Financial template prioritizes facts and evidence with high confidence.\"\"\"\n   391→        # Prioritize financial metrics and evidence\n   392→        priority_types = [\"fact\", \"evidence\", \"prediction\"]\n   393→        prioritized = []\n   394→\n   395→        for ftype in priority_types:\n   396→            type_findings = [f for f in findings if f.get(\"finding_type\") == ftype]\n   397→            prioritized.extend(sorted(\n   398→                type_findings,\n   399→                key=lambda x: x.get(\"confidence_score\", 0),\n   400→                reverse=True\n   401→            ))\n   402→\n   403→        # Add remaining high-confidence findings\n   404→        remaining = [f for f in findings if f not in prioritized and f.get(\"confidence_score\", 0) >= 0.6]\n   405→        prioritized.extend(sorted(remaining, key=lambda x: x.get(\"confidence_score\", 0), reverse=True))\n   406→\n   407→        return prioritized\n   408→\n   409→    def _generate_key_sections(self, result: Dict[str, Any]) -> str:\n   410→        \"\"\"Generate financial-specific key sections: Bull/Bear case summary.\"\"\"\n   411→        findings = result.get(\"findings\", [])\n   412→        sections = []\n   413→\n   414→        # Valuation Summary\n   415→        valuations = [f for f in findings if f.get(\"finding_type\") == \"evidence\"\n   416→                      and \"valuation\" in f.get(\"content\", \"\").lower()]\n   417→        if valuations:\n   418→            sections.append(\"## Valuation Summary\")\n   419→            sections.append(\"\")\n   420→            for v in valuations[:3]:\n   421→                sections.append(f\"- {v.get('summary') or v.get('content', '')[:100]}\")\n   422→            sections.append(\"\")\n   423→\n   424→        # Risk Factors Summary\n   425→        risks = [f for f in findings if f.get(\"finding_type\") in [\"pattern\", \"gap\"]]\n   426→        if risks:\n   427→            sections.append(\"## Key Risk Factors\")\n   428→            sections.append(\"\")\n   429→            for r in risks[:4]:\n   430→                sections.append(f\"- {r.get('summary') or r.get('content', '')[:100]}\")\n   431→            sections.append(\"\")\n   432→\n   433→        return \"\\n\".join(sections)\n   434→\n   435→    def _generate_executive_highlights(self, result: Dict[str, Any]) -> str:\n   436→        \"\"\"Generate financial-specific executive highlights.\"\"\"\n   437→        findings = result.get(\"findings\", [])\n   438→        sections = []\n   439→\n   440→        # Key metrics highlight\n   441→        metrics = [f for f in findings if f.get(\"finding_type\") == \"fact\"]\n   442→        if metrics:\n   443→            sections.append(\"## Key Metrics\")\n   444→            sections.append(\"\")\n   445→            for m in metrics[:4]:\n   446→                sections.append(f\"- {m.get('summary') or m.get('content', '')[:100]}\")\n   447→            sections.append(\"\")\n   448→\n   449→        return \"\\n\".join(sections)\n   450→\n   451→    def generate_kill_criteria(self, result: Dict[str, Any]) -> Dict[str, Any]:\n   452→        \"\"\"Extract kill criteria - specific signals that would invalidate the investment thesis.\n   453→\n   454→        Returns dict with:\n   455→        - criteria: List of specific, measurable exit signals\n   456→        - monitoring_items: What to watch for each criterion\n   457→        - severity: How quickly to act if triggered\n   458→        \"\"\"\n   459→        findings = result.get(\"findings\", [])\n   460→        perspectives = result.get(\"perspectives\", [])\n   461→\n   462→        # Default kill criteria structure\n   463→        kill_criteria = {\n   464→            \"criteria\": [],\n   465→            \"summary\": \"Exit or reverse position if any of these conditions materialize\",\n   466→            \"update_frequency\": \"Review weekly, act immediately on major triggers\"\n   467→        }\n   468→\n   469→        # Extract from risk findings\n   470→        risks = [f for f in findings if f.get(\"finding_type\") in [\"risk\", \"red_flag\", \"bearish_signal\"]]\n   471→        for risk in risks[:5]:\n   472→            content = risk.get(\"content\", \"\")\n   473→            summary = risk.get(\"summary\", \"\")\n   474→\n   475→            # Create kill criterion from risk\n   476→            criterion = {\n   477→                \"trigger\": summary[:100] if summary else content[:100],\n   478→                \"threshold\": \"Significant deterioration from current levels\",\n   479→                \"action\": \"Reduce position by 50% immediately, exit fully if trend continues\",\n   480→                \"monitoring\": \"Track in earnings reports and news flow\",\n   481→                \"severity\": \"high\" if risk.get(\"confidence_score\", 0) > 0.8 else \"medium\"\n   482→            }\n   483→            kill_criteria[\"criteria\"].append(criterion)\n   484→\n   485→        # Extract from short seller perspective warnings\n   486→        short_seller = next((p for p in perspectives if \"short\" in p.get(\"perspective_type\", \"\").lower()), None)\n   487→        if short_seller:\n   488→            for warning in short_seller.get(\"warnings\", [])[:3]:\n   489→                criterion = {\n   490→                    \"trigger\": warning[:100],\n   491→                    \"threshold\": \"Evidence of materialization\",\n   492→                    \"action\": \"Exit position\",\n   493→                    \"monitoring\": \"Track via SEC filings and investigative reporting\",\n   494→                    \"severity\": \"critical\"\n   495→                }\n   496→                kill_criteria[\"criteria\"].append(criterion)\n   497→\n   498→        # Add standard financial kill criteria if not enough specific ones\n   499→        if len(kill_criteria[\"criteria\"]) < 3:\n   500→            standard_criteria = [\n   501→                {\n   502→                    \"trigger\": \"Revenue growth decelerates to below industry average\",\n   503→                    \"threshold\": \"<10% YoY growth for 2 consecutive quarters\",\n   504→                    \"action\": \"Reduce position, reassess thesis\",\n   505→                    \"monitoring\": \"Quarterly earnings reports\",\n   506→                    \"severity\": \"high\"\n   507→                },\n   508→                {\n   509→                    \"trigger\": \"Gross margin compression beyond guidance\",\n   510→                    \"threshold\": \">500bps decline from peak margins\",\n   511→                    \"action\": \"Exit 50% of position\",\n   512→                    \"monitoring\": \"Quarterly earnings, competitive pricing data\",\n   513→                    \"severity\": \"high\"\n   514→                },\n   515→                {\n   516→                    \"trigger\": \"Key customer concentration increases or major customer loss\",\n   517→                    \"threshold\": \"Top customer >40% of revenue OR loss of top-5 customer\",\n   518→                    \"action\": \"Reassess position size, consider hedging\",\n   519→                    \"monitoring\": \"10-K filings, customer announcements\",\n   520→                    \"severity\": \"medium\"\n   521→                }\n   522→            ]\n   523→            kill_criteria[\"criteria\"].extend(standard_criteria[:3 - len(kill_criteria[\"criteria\"])])\n   524→\n   525→        return kill_criteria\n   526→\n   527→    def generate_ecosystem_analysis(self, result: Dict[str, Any]) -> Dict[str, Any]:\n   528→        \"\"\"Generate upstream/downstream ecosystem analysis.\n   529→\n   530→        Returns dict with:\n   531→        - customers: Top customers and their outlook\n   532→        - competitors: Key competitors and momentum\n   533→        - suppliers: Critical dependencies\n   534→        - implications: What ecosystem dynamics mean for investment\n   535→        \"\"\"\n   536→        findings = result.get(\"findings\", [])\n   537→        perspectives = result.get(\"perspectives\", [])\n   538→\n   539→        ecosystem = {\n   540→            \"customers\": [],\n   541→            \"competitors\": [],\n   542→            \"suppliers\": [],\n   543→            \"implications\": []\n   544→        }\n   545→\n   546→        # Extract customer/competitor mentions from findings\n   547→        for f in findings:\n   548→            content = (f.get(\"content\", \"\") + \" \" + f.get(\"summary\", \"\")).lower()\n   549→\n   550→            if any(word in content for word in [\"customer\", \"client\", \"buyer\", \"revenue from\"]):\n   551→                ecosystem[\"customers\"].append({\n   552→                    \"mention\": f.get(\"summary\", f.get(\"content\", \"\"))[:150],\n   553→                    \"source\": \"research_finding\"\n   554→                })\n   555→\n   556→            if any(word in content for word in [\"competitor\", \"competition\", \"rival\", \"market share\"]):\n   557→                ecosystem[\"competitors\"].append({\n   558→                    \"mention\": f.get(\"summary\", f.get(\"content\", \"\"))[:150],\n   559→                    \"source\": \"research_finding\"\n   560→                })\n   561→\n   562→            if any(word in content for word in [\"supplier\", \"supply chain\", \"dependency\", \"vendor\"]):\n   563→                ecosystem[\"suppliers\"].append({\n   564→                    \"mention\": f.get(\"summary\", f.get(\"content\", \"\"))[:150],\n   565→                    \"source\": \"research_finding\"\n   566→                })\n   567→\n   568→        # Generate implications based on ecosystem data\n   569→        if ecosystem[\"customers\"]:\n   570→            ecosystem[\"implications\"].append(\n   571→                f\"Customer concentration/health is a key driver. Monitor top customer spending patterns.\"\n   572→            )\n   573→        if ecosystem[\"competitors\"]:\n   574→            ecosystem[\"implications\"].append(\n   575→                f\"Competitive dynamics identified. Track market share shifts quarterly.\"\n   576→            )\n   577→        if ecosystem[\"suppliers\"]:\n   578→            ecosystem[\"implications\"].append(\n   579→                f\"Supply chain dependencies exist. Monitor for disruption risks.\"\n   580→            )\n   581→\n   582→        return ecosystem\n   583→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"82343d47-30e9-47a3-93fa-efd2489cfa93","uuid":"854da760-ad8a-4bb1-a579-dd2509a2533b","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\actor\\src\\templates\\financial.py","content":"\"\"\"Financial analysis research template.\"\"\"\n\nfrom typing import List, Dict, Any, Optional\n\nfrom .base import BaseTemplate\nfrom ..services.report_components import (\n    ComponentType, ComponentConfig, ReportHints, get_report_hints\n)\n\n\nclass FinancialTemplate(BaseTemplate):\n    \"\"\"Template for financial and stock analysis research.\"\"\"\n\n    template_id = \"financial\"\n    template_name = \"Financial Analysis\"\n    description = \"Stock and financial analysis for investment research\"\n\n    # Report hints for component-based rendering\n    report_hints = ReportHints(\n        template_type=\"financial\",\n        structure=\"quantitative_first\",\n        findings_grouping=\"sentiment\",\n        tone=\"analytical\",\n        decision_format=\"thesis\",\n        emphasis=[\"valuation\", \"risk_assessment\", \"financial_metrics\"],\n        required_components=[\n            ComponentType.INVESTMENT_THESIS,\n            ComponentType.METRIC_CARDS,\n            ComponentType.RISK_MATRIX,\n        ],\n        optional_components=[\n            ComponentType.FINDINGS_TABLE,\n            ComponentType.PREDICTION_CARDS,\n            ComponentType.COMPARISON_TABLE,\n            ComponentType.CONFIDENCE_GAUGE,\n        ],\n        visualization_preference=[\"financial_metrics\", \"risk_matrix\", \"peer_comparison\"],\n        custom_sections={\n            \"show_bull_bear_cases\": True,\n            \"price_targets\": True,\n            \"risk_factors_prominent\": True,\n        }\n    )\n\n    # Expert perspectives for deep financial analysis\n    default_perspectives = [\n        \"institutional_investor\",   # Long-term value creation, moats, management\n        \"short_seller\",             # Red flags, fraud detection, skeptical analysis\n        \"quantitative_risk\",        # Tail risks, stress testing, correlations\n        \"activist_investor\",        # Value creation levers, governance, catalysts\n        \"macro_strategist\",         # Economic cycles, policy risks, global context\n    ]\n\n    default_max_searches = 8\n\n    # Financial analysis needs rigorous verification\n    # Analysts have conflicts, numbers must be verified, projections questioned\n    verification_config = {\n        \"cross_reference\": \"thorough\",      # Verify financial numbers across sources\n        \"bias_detection\": \"thorough\",       # Analyst conflicts, investment banking ties\n        \"expert_sanity_check\": \"thorough\",  # Flag unrealistic valuations/projections\n        \"source_quality\": \"standard\",       # SEC filings are reliable, analyst reports vary\n    }\n\n    async def generate_search_queries(\n        self,\n        query: str,\n        max_searches: int,\n        granularity: str = \"standard\",\n    ) -> List[str]:\n        \"\"\"Generate financial analysis search queries.\"\"\"\n        prompt = f\"\"\"\nYou are a financial analyst planning comprehensive research for investment analysis.\n\nResearch Topic: {query}\n\nDepth Level: {granularity}\n\nGenerate search queries covering these financial analysis angles:\n\n1. EARNINGS AND FUNDAMENTALS\n   - Recent quarterly and annual earnings reports\n   - Revenue trends, margins, profitability metrics\n   - Earnings beats/misses, guidance changes\n   - Balance sheet strength, cash flow analysis\n\n2. ANALYST COVERAGE\n   - Wall Street analyst ratings and price targets\n   - Buy/hold/sell recommendations\n   - Earnings estimates and revisions\n   - Recent analyst upgrades/downgrades\n\n3. MARKET POSITION\n   - Competitive landscape and market share\n   - Industry trends and tailwinds/headwinds\n   - Customer concentration and diversification\n   - Geographic revenue breakdown\n\n4. RISK FACTORS\n   - Regulatory and compliance risks\n   - Macro economic exposure\n   - Supply chain dependencies\n   - Legal and litigation issues\n\n5. VALUATION\n   - Current valuation multiples (P/E, EV/EBITDA, P/S)\n   - Historical valuation ranges\n   - Peer comparison valuations\n   - DCF and fair value estimates\n\n6. NEWS AND CATALYSTS\n   - Recent company announcements\n   - Product launches, partnerships, M&A\n   - Management changes, insider transactions\n   - Upcoming events (earnings, conferences)\n\n7. ECOSYSTEM ANALYSIS (Upstream/Downstream) - MANDATORY\n   You MUST include at least 1-2 dedicated ecosystem queries:\n   - Top customers: \"[COMPANY] top customers revenue concentration 2024 2025\"\n   - Competitors: \"[COMPANY] vs [COMPETITOR] market share comparison\"\n   - For AI/chip companies: \"[COMPANY] hyperscaler capex Microsoft Google Amazon spending\"\n   - Supplier dependencies: \"[COMPANY] supply chain dependencies risks\"\n\n8. BEAR CASE RESEARCH\n   - Include at least one query for contrarian/bearish analysis:\n   - \"[COMPANY] short seller thesis bear case risks\"\n   - \"[COMPANY] stock overvalued concerns\"\n\nFor a \"{granularity}\" depth level:\n- \"quick\": 4-5 searches on key fundamentals and analyst sentiment\n- \"standard\": 8-10 searches covering all areas INCLUDING ecosystem and bear case\n- \"deep\": 12+ searches with comprehensive coverage including technicals\n\nCRITICAL: You MUST include at least ONE ecosystem query and ONE bear case query regardless of depth level.\n\nReturn a JSON array of exactly {max_searches} search query strings, ordered by importance.\nExample: [\"NVIDIA Q4 2025 earnings analysis\", \"NVIDIA stock analyst ratings price target 2025\", \"NVIDIA top customers hyperscaler capex Microsoft Google Amazon\", \"NVIDIA bear case short seller thesis risks\", ...]\n\"\"\"\n\n        result = await self._call_gemini_json(prompt)\n\n        if isinstance(result, list):\n            return result[:max_searches]\n        return []\n\n    async def extract_findings(\n        self,\n        query: str,\n        sources: List[Dict[str, Any]],\n        synthesized_content: str,\n        granularity: str = \"standard\",\n    ) -> List[Dict[str, Any]]:\n        \"\"\"Extract financial findings with component-aligned types.\"\"\"\n        # Build source context\n        source_context = \"\\n\\n\".join([\n            f\"Source: {s.get('title', 'Unknown')} ({s.get('url', '')})\\n\"\n            f\"Credibility: {s.get('credibility_score', 'Unknown')}\\n\"\n            f\"Domain: {s.get('domain', '')}\"\n            for s in sources[:20]\n        ])\n\n        prompt = f\"\"\"\nYou are a financial analyst extracting key findings for investment research.\nCRITICAL: Use EXACT finding_type values specified below - they map to UI components.\n\nResearch Topic: {query}\n\nSynthesized Research Content:\n{synthesized_content[:15000]}\n\nSources Referenced:\n{source_context}\n\n=== USE ONLY THESE finding_type VALUES ===\n\n1. BULLISH SIGNALS (finding_type: \"bullish_signal\")\n   - Positive earnings surprises, revenue beats, margin expansion\n   - Analyst upgrades, price target increases\n   - Growth acceleration, market share gains\n   - Strong guidance, positive management commentary\n\n2. BEARISH SIGNALS (finding_type: \"bearish_signal\")\n   - Earnings misses, revenue declines, margin compression\n   - Analyst downgrades, price target cuts\n   - Growth deceleration, market share losses\n   - Weak guidance, negative management tone\n\n3. RISK FACTORS (finding_type: \"risk\")\n   - Business, market, regulatory, competitive risks\n   - Debt concerns, liquidity issues, concentration risks\n   - Key person dependencies, governance issues\n\n4. RED FLAGS (finding_type: \"red_flag\")\n   - Accounting irregularities, restatements\n   - Insider selling, executive departures\n   - SEC investigations, legal issues, guidance cuts\n\n5. FINANCIAL METRICS (finding_type: \"financial_metric\")\n   - Revenue, EPS, margins with specific numbers\n   - Valuation multiples (P/E, EV/EBITDA)\n   - Price targets with analyst attribution\n\n6. PREDICTIONS (finding_type: \"prediction\")\n   - Forward guidance, analyst forecasts\n   - Industry trend predictions\n\n=== STRICT JSON OUTPUT FORMAT ===\n\nReturn JSON array with EXACT structure. CRITICAL: Include \"analysis\" field with YOUR analytical commentary.\n[\n  {{\n    \"finding_type\": \"bullish_signal\",\n    \"summary\": \"NVIDIA data center revenue surged 409% YoY to $18.4B\",\n    \"content\": \"Detailed explanation with numbers, dates, sources...\",\n    \"analysis\": \"This exceptional growth rate significantly outpaces the broader semiconductor industry. The data center segment now represents 78% of total revenue, validating the AI infrastructure investment thesis. However, maintaining such growth rates will be increasingly difficult as the base grows larger.\",\n    \"confidence_score\": 0.95,\n    \"date_referenced\": \"Q3 FY2024\",\n    \"extracted_data\": {{\"metric\": \"Data Center Revenue\", \"value\": \"$18.4B\", \"change\": \"+409% YoY\"}}\n  }},\n  {{\n    \"finding_type\": \"risk\",\n    \"summary\": \"China export restrictions pose 20-25% revenue risk\",\n    \"content\": \"US government export controls on AI chips...\",\n    \"analysis\": \"This is a structural headwind that could persist for years. While NVIDIA has developed compliant alternatives, ASPs are lower. Investors should model a 15-20% China revenue haircut as the new normal rather than expecting policy relaxation.\",\n    \"confidence_score\": 0.85,\n    \"date_referenced\": \"2024\",\n    \"extracted_data\": {{\"risk_type\": \"regulatory\", \"severity\": \"high\"}}\n  }},\n  {{\n    \"finding_type\": \"financial_metric\",\n    \"summary\": \"Morgan Stanley: Overweight rating, $180 target\",\n    \"content\": \"Morgan Stanley analyst Joseph Moore...\",\n    \"analysis\": \"This price target implies ~25% upside from current levels. Morgan Stanley has historically been accurate on semiconductor calls. Their thesis centers on continued hyperscaler CapEx expansion, which aligns with recent guidance from major cloud providers.\",\n    \"confidence_score\": 0.90,\n    \"date_referenced\": \"January 2025\",\n    \"extracted_data\": {{\"analyst\": \"Morgan Stanley\", \"rating\": \"Overweight\", \"target_price\": \"$180\"}}\n  }}\n]\n\nIMPORTANT: The \"analysis\" field should contain YOUR expert analytical commentary explaining:\n- Why this finding matters for the investment thesis\n- What it implies for the future\n- Any caveats or nuances investors should consider\n\nExtract 8-15 findings covering bullish_signal, bearish_signal, risk, red_flag, financial_metric, prediction.\nReturn ONLY the JSON array.\n\"\"\"\n\n        result = await self._call_gemini_json(prompt)\n\n        findings = []\n        if isinstance(result, list):\n            for f in result:\n                if isinstance(f, dict):\n                    finding = {\n                        \"finding_type\": f.get(\"finding_type\", \"fact\"),\n                        \"content\": f.get(\"content\", \"\"),\n                        \"summary\": f.get(\"summary\"),\n                        \"analysis\": f.get(\"analysis\", \"\"),  # LLM's analytical commentary\n                        \"confidence_score\": f.get(\"confidence_score\", 0.5),\n                        \"temporal_context\": f.get(\"temporal_context\", \"present\"),\n                        \"date_referenced\": f.get(\"date_referenced\", \"\"),\n                        \"extracted_data\": f.get(\"extracted_data\"),\n                    }\n\n                    # Validate analysis field - generate fallback if too short/empty\n                    analysis = finding.get(\"analysis\", \"\")\n                    if not analysis or len(analysis) < 30:\n                        finding_type = finding.get(\"finding_type\", \"fact\")\n                        content = finding.get(\"content\", \"\")[:200]\n                        summary = finding.get(\"summary\", \"\")\n\n                        # Generate contextual fallback analysis based on finding type\n                        type_context = {\n                            \"bullish_signal\": \"This positive indicator suggests favorable conditions for the investment thesis.\",\n                            \"bearish_signal\": \"This concerning signal warrants caution and may indicate downside risk.\",\n                            \"risk\": \"This risk factor should be monitored as part of ongoing position management.\",\n                            \"red_flag\": \"This red flag requires careful attention and may warrant reducing position size.\",\n                            \"financial_metric\": \"This metric provides insight into the company's financial health and trajectory.\",\n                            \"prediction\": \"This forward-looking indicator may help inform investment timing decisions.\",\n                            \"earnings_data\": \"This earnings data provides context for evaluating company performance.\",\n                            \"valuation\": \"This valuation metric helps assess whether the stock is fairly priced.\",\n                        }\n                        finding[\"analysis\"] = type_context.get(finding_type, \"This finding provides relevant context for the investment thesis.\")\n\n                    findings.append(finding)\n\n        return findings\n\n    # ========== FINANCIAL-SPECIFIC REPORT GENERATION ==========\n\n    def get_supported_report_variants(self) -> List[str]:\n        \"\"\"Financial template supports investment_thesis variant.\"\"\"\n        return [\"full_report\", \"executive_summary\", \"investment_thesis\"]\n\n    def generate_investment_thesis(\n        self,\n        result: Dict[str, Any],\n        title: Optional[str] = None,\n    ) -> str:\n        \"\"\"Generate investment thesis report - financial-specific variant.\"\"\"\n        from datetime import datetime\n\n        query = result.get(\"query\", \"Unknown\")\n        report_title = title or f\"Investment Thesis: {query[:40]}\"\n\n        sections = []\n        sections.append(f\"# {report_title}\")\n        sections.append(\"\")\n        sections.append(f\"**Subject:** {query}\")\n        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n        sections.append(\"\")\n        sections.append(\"---\")\n        sections.append(\"\")\n\n        # Thesis summary\n        sections.append(\"## Investment Thesis\")\n        sections.append(\"\")\n\n        # Extract valuation perspective\n        perspectives = result.get(\"perspectives\", [])\n        valuation = next((p for p in perspectives if \"valuation\" in p.get(\"perspective_type\", \"\").lower()), None)\n        investor = next((p for p in perspectives if \"investor\" in p.get(\"perspective_type\", \"\").lower()), None)\n\n        if valuation:\n            sections.append(valuation.get(\"analysis_text\", \"\"))\n            sections.append(\"\")\n        elif investor:\n            sections.append(investor.get(\"analysis_text\", \"\"))\n            sections.append(\"\")\n\n        # Bull case\n        sections.append(\"## Bull Case\")\n        sections.append(\"\")\n        findings = result.get(\"findings\", [])\n        positive = [f for f in findings if f.get(\"confidence_score\", 0) >= 0.7]\n        for f in positive[:5]:\n            sections.append(f\"- {f.get('summary') or f.get('content', '')[:100]}\")\n        sections.append(\"\")\n\n        # Bear case\n        sections.append(\"## Bear Case / Risks\")\n        sections.append(\"\")\n        risks = [f for f in findings if f.get(\"finding_type\") in [\"pattern\", \"gap\", \"risk\"]]\n        if not risks:\n            risks = [f for f in findings if f.get(\"confidence_score\", 0) < 0.6]\n        for f in risks[:5]:\n            sections.append(f\"- {f.get('summary') or f.get('content', '')[:100]}\")\n        sections.append(\"\")\n\n        # Key metrics\n        metrics = [f for f in findings if f.get(\"finding_type\") == \"fact\"]\n        if metrics:\n            sections.append(\"## Key Financial Metrics\")\n            sections.append(\"\")\n            for m in metrics[:8]:\n                extracted = m.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    metric = extracted.get(\"metric\", \"\")\n                    value = extracted.get(\"value\", \"\")\n                    if metric and value:\n                        sections.append(f\"- **{metric}:** {value}\")\n                else:\n                    sections.append(f\"- {m.get('summary') or m.get('content', '')[:80]}\")\n            sections.append(\"\")\n\n        # Recommendations\n        sections.append(\"## Recommendations\")\n        sections.append(\"\")\n        for p in perspectives:\n            recs = p.get(\"recommendations\", [])\n            for rec in recs[:2]:\n                sections.append(f\"- {rec}\")\n        sections.append(\"\")\n\n        # Warnings\n        all_warnings = []\n        for p in perspectives:\n            all_warnings.extend(p.get(\"warnings\", []))\n        if all_warnings:\n            sections.append(\"## Risk Warnings\")\n            sections.append(\"\")\n            for warning in all_warnings[:5]:\n                sections.append(f\"- {warning}\")\n            sections.append(\"\")\n\n        return \"\\n\".join(sections)\n\n    def _get_priority_findings(self, findings: List[Dict[str, Any]]) -> List[Dict[str, Any]]:\n        \"\"\"Financial template prioritizes facts and evidence with high confidence.\"\"\"\n        # Prioritize financial metrics and evidence\n        priority_types = [\"fact\", \"evidence\", \"prediction\"]\n        prioritized = []\n\n        for ftype in priority_types:\n            type_findings = [f for f in findings if f.get(\"finding_type\") == ftype]\n            prioritized.extend(sorted(\n                type_findings,\n                key=lambda x: x.get(\"confidence_score\", 0),\n                reverse=True\n            ))\n\n        # Add remaining high-confidence findings\n        remaining = [f for f in findings if f not in prioritized and f.get(\"confidence_score\", 0) >= 0.6]\n        prioritized.extend(sorted(remaining, key=lambda x: x.get(\"confidence_score\", 0), reverse=True))\n\n        return prioritized\n\n    def _generate_key_sections(self, result: Dict[str, Any]) -> str:\n        \"\"\"Generate financial-specific key sections: Bull/Bear case summary.\"\"\"\n        findings = result.get(\"findings\", [])\n        sections = []\n\n        # Valuation Summary\n        valuations = [f for f in findings if f.get(\"finding_type\") == \"evidence\"\n                      and \"valuation\" in f.get(\"content\", \"\").lower()]\n        if valuations:\n            sections.append(\"## Valuation Summary\")\n            sections.append(\"\")\n            for v in valuations[:3]:\n                sections.append(f\"- {v.get('summary') or v.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Risk Factors Summary\n        risks = [f for f in findings if f.get(\"finding_type\") in [\"pattern\", \"gap\"]]\n        if risks:\n            sections.append(\"## Key Risk Factors\")\n            sections.append(\"\")\n            for r in risks[:4]:\n                sections.append(f\"- {r.get('summary') or r.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        return \"\\n\".join(sections)\n\n    def _generate_executive_highlights(self, result: Dict[str, Any]) -> str:\n        \"\"\"Generate financial-specific executive highlights.\"\"\"\n        findings = result.get(\"findings\", [])\n        sections = []\n\n        # Key metrics highlight\n        metrics = [f for f in findings if f.get(\"finding_type\") == \"fact\"]\n        if metrics:\n            sections.append(\"## Key Metrics\")\n            sections.append(\"\")\n            for m in metrics[:4]:\n                sections.append(f\"- {m.get('summary') or m.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        return \"\\n\".join(sections)\n\n    def generate_kill_criteria(self, result: Dict[str, Any]) -> Dict[str, Any]:\n        \"\"\"Extract kill criteria - specific signals that would invalidate the investment thesis.\n\n        Returns dict with:\n        - criteria: List of specific, measurable exit signals\n        - monitoring_items: What to watch for each criterion\n        - severity: How quickly to act if triggered\n        \"\"\"\n        findings = result.get(\"findings\", [])\n        perspectives = result.get(\"perspectives\", [])\n\n        # Default kill criteria structure\n        kill_criteria = {\n            \"criteria\": [],\n            \"summary\": \"Exit or reverse position if any of these conditions materialize\",\n            \"update_frequency\": \"Review weekly, act immediately on major triggers\"\n        }\n\n        # Extract from risk findings\n        risks = [f for f in findings if f.get(\"finding_type\") in [\"risk\", \"red_flag\", \"bearish_signal\"]]\n        for risk in risks[:5]:\n            content = risk.get(\"content\", \"\")\n            summary = risk.get(\"summary\", \"\")\n\n            # Create kill criterion from risk\n            criterion = {\n                \"trigger\": summary[:100] if summary else content[:100],\n                \"threshold\": \"Significant deterioration from current levels\",\n                \"action\": \"Reduce position by 50% immediately, exit fully if trend continues\",\n                \"monitoring\": \"Track in earnings reports and news flow\",\n                \"severity\": \"high\" if risk.get(\"confidence_score\", 0) > 0.8 else \"medium\"\n            }\n            kill_criteria[\"criteria\"].append(criterion)\n\n        # Extract from short seller perspective warnings\n        short_seller = next((p for p in perspectives if \"short\" in p.get(\"perspective_type\", \"\").lower()), None)\n        if short_seller:\n            for warning in short_seller.get(\"warnings\", [])[:3]:\n                criterion = {\n                    \"trigger\": warning[:100],\n                    \"threshold\": \"Evidence of materialization\",\n                    \"action\": \"Exit position\",\n                    \"monitoring\": \"Track via SEC filings and investigative reporting\",\n                    \"severity\": \"critical\"\n                }\n                kill_criteria[\"criteria\"].append(criterion)\n\n        # Add standard financial kill criteria if not enough specific ones\n        if len(kill_criteria[\"criteria\"]) < 3:\n            standard_criteria = [\n                {\n                    \"trigger\": \"Revenue growth decelerates to below industry average\",\n                    \"threshold\": \"<10% YoY growth for 2 consecutive quarters\",\n                    \"action\": \"Reduce position, reassess thesis\",\n                    \"monitoring\": \"Quarterly earnings reports\",\n                    \"severity\": \"high\"\n                },\n                {\n                    \"trigger\": \"Gross margin compression beyond guidance\",\n                    \"threshold\": \">500bps decline from peak margins\",\n                    \"action\": \"Exit 50% of position\",\n                    \"monitoring\": \"Quarterly earnings, competitive pricing data\",\n                    \"severity\": \"high\"\n                },\n                {\n                    \"trigger\": \"Key customer concentration increases or major customer loss\",\n                    \"threshold\": \"Top customer >40% of revenue OR loss of top-5 customer\",\n                    \"action\": \"Reassess position size, consider hedging\",\n                    \"monitoring\": \"10-K filings, customer announcements\",\n                    \"severity\": \"medium\"\n                }\n            ]\n            kill_criteria[\"criteria\"].extend(standard_criteria[:3 - len(kill_criteria[\"criteria\"])])\n\n        return kill_criteria\n\n    def generate_ecosystem_analysis(self, result: Dict[str, Any]) -> Dict[str, Any]:\n        \"\"\"Generate upstream/downstream ecosystem analysis.\n\n        Returns dict with:\n        - customers: Top customers and their outlook\n        - competitors: Key competitors and momentum\n        - suppliers: Critical dependencies\n        - implications: What ecosystem dynamics mean for investment\n        \"\"\"\n        findings = result.get(\"findings\", [])\n        perspectives = result.get(\"perspectives\", [])\n\n        ecosystem = {\n            \"customers\": [],\n            \"competitors\": [],\n            \"suppliers\": [],\n            \"implications\": []\n        }\n\n        # Extract customer/competitor mentions from findings\n        for f in findings:\n            content = (f.get(\"content\", \"\") + \" \" + f.get(\"summary\", \"\")).lower()\n\n            if any(word in content for word in [\"customer\", \"client\", \"buyer\", \"revenue from\"]):\n                ecosystem[\"customers\"].append({\n                    \"mention\": f.get(\"summary\", f.get(\"content\", \"\"))[:150],\n                    \"source\": \"research_finding\"\n                })\n\n            if any(word in content for word in [\"competitor\", \"competition\", \"rival\", \"market share\"]):\n                ecosystem[\"competitors\"].append({\n                    \"mention\": f.get(\"summary\", f.get(\"content\", \"\"))[:150],\n                    \"source\": \"research_finding\"\n                })\n\n            if any(word in content for word in [\"supplier\", \"supply chain\", \"dependency\", \"vendor\"]):\n                ecosystem[\"suppliers\"].append({\n                    \"mention\": f.get(\"summary\", f.get(\"content\", \"\"))[:150],\n                    \"source\": \"research_finding\"\n                })\n\n        # Generate implications based on ecosystem data\n        if ecosystem[\"customers\"]:\n            ecosystem[\"implications\"].append(\n                f\"Customer concentration/health is a key driver. Monitor top customer spending patterns.\"\n            )\n        if ecosystem[\"competitors\"]:\n            ecosystem[\"implications\"].append(\n                f\"Competitive dynamics identified. Track market share shifts quarterly.\"\n            )\n        if ecosystem[\"suppliers\"]:\n            ecosystem[\"implications\"].append(\n                f\"Supply chain dependencies exist. Monitor for disruption risks.\"\n            )\n\n        return ecosystem\n","numLines":583,"startLine":1,"totalLines":583}}}
[2026-01-30T09:07:48.034Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014Cr9wpPHgxei7wq7U3kx5o","type":"tool_result","content":"     1→\"\"\"Tech market research template for 2025 developments and 2026 predictions.\"\"\"\n     2→\n     3→from typing import List, Dict, Any, Optional\n     4→\n     5→from .base import BaseTemplate\n     6→from ..services.report_components import (\n     7→    ComponentType, ComponentConfig, ReportHints, get_report_hints\n     8→)\n     9→\n    10→\n    11→class TechMarketTemplate(BaseTemplate):\n    12→    \"\"\"Template for technology market analysis and trend research.\"\"\"\n    13→\n    14→    template_id = \"tech_market\"\n    15→    template_name = \"Tech Market Analysis\"\n    16→    description = \"Technology market trends, 2025 developments, and 2026 predictions\"\n    17→\n    18→    # Report hints for component-based rendering\n    19→    report_hints = ReportHints(\n    20→        template_type=\"tech_market\",\n    21→        structure=\"quantitative_first\",\n    22→        findings_grouping=\"category\",\n    23→        tone=\"analytical\",\n    24→        decision_format=\"recommendation\",\n    25→        emphasis=[\"adoption_metrics\", \"market_trends\", \"technology_comparison\"],\n    26→        required_components=[\n    27→            ComponentType.TECH_RADAR,\n    28→            ComponentType.METRIC_CARDS,\n    29→            ComponentType.FINDINGS_TABLE,\n    30→        ],\n    31→        optional_components=[\n    32→            ComponentType.TIMELINE,\n    33→            ComponentType.COMPARISON_TABLE,\n    34→            ComponentType.PREDICTION_CARDS,\n    35→            ComponentType.KEY_INSIGHTS,\n    36→        ],\n    37→        visualization_preference=[\"tech_radar\", \"adoption_chart\", \"comparison_matrix\"],\n    38→        custom_sections={\n    39→            \"primary_metric\": \"adoption_rate\",\n    40→            \"show_funding_rounds\": True,\n    41→            \"prediction_focus\": \"2026\",\n    42→        }\n    43→    )\n    44→\n    45→    # Expert perspectives: 4 VC/Startup + 4 Developer Community\n    46→    default_perspectives = [\n    47→        # VC & Startup focused\n    48→        \"venture_capitalist\",\n    49→        \"startup_founder\",\n    50→        \"product_manager\",\n    51→        \"developer_advocate\",\n    52→        # Developer Community\n    53→        \"open_source_maintainer\",\n    54→        \"devrel_engineer\",\n    55→        \"senior_engineer\",\n    56→        \"platform_engineer\",\n    57→    ]\n    58→\n    59→    default_max_searches = 12\n    60→\n    61→    # Tech market is MOST prone to hype, vendor marketing, and inflated claims\n    62→    # Adoption rates vary wildly by definition, predictions are often wrong\n    63→    # Needs maximum verification to separate signal from noise\n    64→    verification_config = {\n    65→        \"cross_reference\": \"thorough\",      # Adoption numbers vary wildly\n    66→        \"bias_detection\": \"thorough\",       # Vendor marketing everywhere\n    67→        \"expert_sanity_check\": \"thorough\",  # Flag hype and unrealistic claims\n    68→        \"source_quality\": \"thorough\",       # Distinguish surveys from blogs\n    69→    }\n    70→\n    71→    async def generate_search_queries(\n    72→        self,\n    73→        query: str,\n    74→        max_searches: int,\n    75→        granularity: str = \"standard\",\n    76→    ) -> List[str]:\n    77→        \"\"\"Generate tech market research queries with 2025/2026 focus.\"\"\"\n    78→        prompt = f\"\"\"\n    79→You are a technology market analyst planning comprehensive research on developer tools,\n    80→infrastructure, and enterprise technology trends.\n    81→\n    82→Research Topic: {query}\n    83→\n    84→Depth Level: {granularity}\n    85→\n    86→Generate search queries covering these technology domains:\n    87→\n    88→1. SOFTWARE DEVELOPMENT ECOSYSTEM\n    89→   - Programming languages: adoption trends, new releases, performance comparisons\n    90→   - Frameworks: frontend (React, Vue, Svelte, Next.js), backend (Node, Go, Rust, Python)\n    91→   - IDEs and development tools: VS Code extensions, JetBrains, AI coding assistants\n    92→   - Testing: test frameworks, quality engineering, shift-left practices\n    93→   - Developer productivity: pair programming, code review tools, documentation\n    94→\n    95→2. AI/ML AND FULL STACK INFRASTRUCTURE\n    96→   - LLM platforms: OpenAI, Anthropic, Google, open-source models (Llama, Mistral)\n    97→   - AI coding assistants: GitHub Copilot, Cursor, Codeium, Tabnine adoption\n    98→   - MLOps tools: model training, deployment, monitoring, vector databases\n    99→   - Cloud platforms: AWS, Azure, GCP innovations, multi-cloud strategies\n   100→   - Edge AI and on-device inference trends\n   101→\n   102→3. DEVOPS AND PLATFORM ENGINEERING\n   103→   - Platform engineering: internal developer platforms, golden paths\n   104→   - GitOps and infrastructure as code: Terraform, Pulumi, Crossplane\n   105→   - Containers and orchestration: Kubernetes ecosystem, service mesh\n   106→   - CI/CD innovations: GitHub Actions, GitLab CI, Dagger\n   107→   - Observability: OpenTelemetry, distributed tracing, AIOps\n   108→\n   109→4. ENTERPRISE TECH STACK\n   110→   - Security: DevSecOps, zero-trust, SAST/DAST, supply chain security\n   111→   - Databases: NewSQL, time-series, graph databases, serverless databases\n   112→   - APIs: GraphQL adoption, API gateways, API-first development\n   113→   - Data engineering: data mesh, lakehouse, real-time analytics\n   114→   - Microservices: event-driven architecture, distributed systems\n   115→\n   116→5. MARKET DYNAMICS\n   117→   - Funding rounds and valuations for developer tools companies\n   118→   - M&A activity and consolidation trends\n   119→   - Developer survey results (Stack Overflow, JetBrains, GitHub)\n   120→   - Enterprise adoption case studies and ROI analysis\n   121→   - Open source project health and governance\n   122→\n   123→6. TEMPORAL FOCUS (CRITICAL)\n   124→   - Include \"2025\" in searches for current developments\n   125→   - Include \"2026 predictions\" or \"roadmap 2026\" for future trends\n   126→   - Search for \"State of X 2025\" reports where relevant\n   127→   - Include analyst predictions and market forecasts\n   128→\n   129→For a \"{granularity}\" depth level:\n   130→- \"quick\": 4-5 searches on key emerging tech and major trends\n   131→- \"standard\": 8-10 searches covering all domains with market dynamics\n   132→- \"deep\": 12+ searches with comprehensive coverage including funding, predictions, and niche areas\n   133→\n   134→Return a JSON array of exactly {max_searches} search query strings, ordered by importance.\n   135→Example: [\"AI coding assistants market 2025 adoption GitHub Copilot\", \"developer tools VC funding 2025\", ...]\n   136→\"\"\"\n   137→\n   138→        result = await self._call_gemini_json(prompt)\n   139→\n   140→        if isinstance(result, list):\n   141→            return result[:max_searches]\n   142→        return []\n   143→\n   144→    async def extract_findings(\n   145→        self,\n   146→        query: str,\n   147→        sources: List[Dict[str, Any]],\n   148→        synthesized_content: str,\n   149→        granularity: str = \"standard\",\n   150→    ) -> List[Dict[str, Any]]:\n   151→        \"\"\"Extract tech market findings with prediction support.\"\"\"\n   152→        # Build source context\n   153→        source_context = \"\\n\\n\".join([\n   154→            f\"Source: {s.get('title', 'Unknown')} ({s.get('url', '')})\\n\"\n   155→            f\"Credibility: {s.get('credibility_score', 'Unknown')}\\n\"\n   156→            f\"Domain: {s.get('domain', '')}\"\n   157→            for s in sources[:20]\n   158→        ])\n   159→\n   160→        prompt = f\"\"\"\n   161→You are a technology market analyst extracting key findings for developer tools research.\n   162→CRITICAL: Use EXACT finding_type values specified below - they map to UI components (Tech Radar).\n   163→\n   164→Research Topic: {query}\n   165→\n   166→Synthesized Research Content:\n   167→{synthesized_content[:15000]}\n   168→\n   169→Sources Referenced:\n   170→{source_context}\n   171→\n   172→=== USE ONLY THESE finding_type VALUES ===\n   173→\n   174→1. TECH TRENDS (finding_type: \"tech_trend\")\n   175→   - New technologies gaining adoption (for Tech Radar visualization)\n   176→   - Emerging patterns in developer tools, frameworks, languages\n   177→   - Technical architecture shifts, new paradigms\n   178→   - Include: technology name, maturity level, adoption momentum\n   179→   - extracted_data MUST include: {{\"technology\": \"...\", \"maturity\": \"adopt|trial|assess|hold\"}}\n   180→\n   181→2. MARKET TRENDS (finding_type: \"market_trend\")\n   182→   - Market size, growth rates, TAM/SAM estimates\n   183→   - Competitive landscape changes, consolidation\n   184→   - Industry-wide shifts and inflection points\n   185→   - extracted_data: {{\"market_size\": \"...\", \"growth_rate\": \"...\", \"segment\": \"...\"}}\n   186→\n   187→3. ADOPTION PATTERNS (finding_type: \"adoption_pattern\")\n   188→   - Developer adoption rates with specific percentages\n   189→   - Enterprise vs startup adoption differences\n   190→   - Geographic or segment adoption variations\n   191→   - extracted_data: {{\"tool\": \"...\", \"adoption_rate\": 40, \"segment\": \"enterprise|startup|all\"}}\n   192→\n   193→4. FINANCIAL METRICS (finding_type: \"financial_metric\")\n   194→   - Funding rounds, valuations, revenue figures\n   195→   - M&A activity and deal values\n   196→   - Pricing changes, business model shifts\n   197→   - extracted_data: {{\"company\": \"...\", \"metric\": \"funding|revenue|valuation\", \"value\": \"...\"}}\n   198→\n   199→5. PREDICTIONS (finding_type: \"prediction\")\n   200→   - 2026 forecasts and roadmaps\n   201→   - Analyst predictions with timelines\n   202→   - Technology evolution predictions\n   203→   - extracted_data: {{\"prediction\": \"...\", \"timeline\": \"2026\", \"confidence\": 0.8}}\n   204→\n   205→6. RED FLAGS (finding_type: \"red_flag\")\n   206→   - Declining adoption, negative developer sentiment\n   207→   - Project stagnation, maintainer burnout\n   208→   - Security issues, funding problems\n   209→   - extracted_data: {{\"issue\": \"...\", \"severity\": \"high|medium|low\"}}\n   210→\n   211→=== STRICT JSON OUTPUT FORMAT ===\n   212→\n   213→Return JSON array with EXACT structure. CRITICAL: Include \"analysis\" field with YOUR expert commentary.\n   214→[\n   215→  {{{{\n   216→    \"finding_type\": \"tech_trend\",\n   217→    \"summary\": \"AI coding assistants reach 40% developer adoption in 2025\",\n   218→    \"content\": \"According to Stack Overflow Developer Survey 2025, AI coding assistants...\",\n   219→    \"analysis\": \"This adoption rate represents a major inflection point. The 40% threshold typically signals mainstream adoption in developer tools. However, the 'adoption' definition varies - active daily use vs occasional use shows different patterns. Enterprise adoption lags individual developers by 12-18 months.\",\n   220→    \"confidence_score\": 0.88,\n   221→    \"date_referenced\": \"January 2025\",\n   222→    \"extracted_data\": {{{{\"technology\": \"AI Coding Assistants\", \"maturity\": \"adopt\", \"adoption_rate\": 40}}}}\n   223→  }}}},\n   224→  {{{{\n   225→    \"finding_type\": \"market_trend\",\n   226→    \"summary\": \"Developer tools market reaches $4.8B valuation in 2025\",\n   227→    \"content\": \"The global developer tools market expanded to $4.8 billion...\",\n   228→    \"analysis\": \"The AI coding segment is driving most of this growth, representing roughly 35% of the total market. However, market fragmentation is increasing as specialized tools emerge for different programming languages and use cases. Consolidation is likely in 2026.\",\n   229→    \"confidence_score\": 0.92,\n   230→    \"date_referenced\": \"2025\",\n   231→    \"extracted_data\": {{{{\"market_size\": \"$4.8B\", \"growth_rate\": \"28%\", \"segment\": \"AI coding tools\"}}}}\n   232→  }}}},\n   233→  {{{{\n   234→    \"finding_type\": \"adoption_pattern\",\n   235→    \"summary\": \"GitHub Copilot leads with 1.8M paid subscribers\",\n   236→    \"content\": \"GitHub Copilot continues to dominate the AI coding market...\",\n   237→    \"analysis\": \"Copilot's first-mover advantage and Microsoft's enterprise distribution create significant moats. However, Cursor's rapid growth among power users suggests the market may bifurcate between 'good enough' and 'best in class' segments.\",\n   238→    \"confidence_score\": 0.90,\n   239→    \"date_referenced\": \"Q4 2024\",\n   240→    \"extracted_data\": {{{{\"tool\": \"GitHub Copilot\", \"subscribers\": \"1.8M\", \"market_share\": \"55%\"}}}}\n   241→  }}}}\n   242→]\n   243→\n   244→IMPORTANT: The \"analysis\" field should contain YOUR expert analytical commentary explaining:\n   245→- Why this trend/finding matters for the technology landscape\n   246→- What it implies for developers, enterprises, or the market\n   247→- Any caveats, counter-trends, or nuances to consider\n   248→\n   249→For \"{granularity}\" depth:\n   250→- quick: 8-10 findings focusing on major trends\n   251→- standard: 15-20 findings with balanced coverage\n   252→- deep: 25-30 comprehensive findings\n   253→\n   254→Extract findings covering: tech_trend, market_trend, adoption_pattern, financial_metric, prediction, red_flag.\n   255→Return ONLY the JSON array.\n   256→\"\"\"\n   257→\n   258→        result = await self._call_gemini_json(prompt)\n   259→\n   260→        findings = []\n   261→        if isinstance(result, list):\n   262→            for f in result:\n   263→                if isinstance(f, dict):\n   264→                    findings.append({\n   265→                        \"finding_type\": f.get(\"finding_type\", \"fact\"),\n   266→                        \"content\": f.get(\"content\", \"\"),\n   267→                        \"summary\": f.get(\"summary\"),\n   268→                        \"analysis\": f.get(\"analysis\", \"\"),  # LLM's expert commentary\n   269→                        \"confidence_score\": f.get(\"confidence_score\", 0.5),\n   270→                        \"temporal_context\": f.get(\"temporal_context\", \"present\"),\n   271→                        \"date_referenced\": f.get(\"date_referenced\", \"\"),\n   272→                        \"extracted_data\": f.get(\"extracted_data\"),\n   273→                    })\n   274→\n   275→        return findings\n   276→\n   277→    # ========== TECH MARKET-SPECIFIC REPORT GENERATION ==========\n   278→\n   279→    def get_supported_report_variants(self) -> List[str]:\n   280→        \"\"\"Tech market template supports trend_forecast and vc_briefing variants.\"\"\"\n   281→        return [\"full_report\", \"executive_summary\", \"trend_forecast\", \"vc_briefing\"]\n   282→\n   283→    def generate_trend_forecast(\n   284→        self,\n   285→        result: Dict[str, Any],\n   286→        title: Optional[str] = None,\n   287→    ) -> str:\n   288→        \"\"\"Generate trend forecast report - tech market-specific variant.\n   289→\n   290→        Focuses on predictions, emerging technologies, and 2026 outlook.\n   291→        \"\"\"\n   292→        from datetime import datetime\n   293→\n   294→        query = result.get(\"query\", \"Unknown\")\n   295→        report_title = title or f\"Tech Trend Forecast: {query[:40]}\"\n   296→\n   297→        sections = []\n   298→        sections.append(f\"# {report_title}\")\n   299→        sections.append(\"\")\n   300→        sections.append(f\"**Subject:** {query}\")\n   301→        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n   302→        sections.append(\"\")\n   303→        sections.append(\"---\")\n   304→        sections.append(\"\")\n   305→\n   306→        findings = result.get(\"findings\", [])\n   307→        perspectives = result.get(\"perspectives\", [])\n   308→\n   309→        # 2026 Predictions (most important)\n   310→        predictions = [f for f in findings if f.get(\"finding_type\") == \"prediction\"\n   311→                       or f.get(\"temporal_context\") == \"predicted\"]\n   312→        if predictions:\n   313→            sections.append(\"## 2026 Predictions\")\n   314→            sections.append(\"\")\n   315→            for pred in predictions:\n   316→                extracted = pred.get(\"extracted_data\", {})\n   317→                if extracted and isinstance(extracted, dict):\n   318→                    prediction_text = extracted.get(\"prediction\", \"\")\n   319→                    timeframe = extracted.get(\"timeframe\", \"2026\")\n   320→                    confidence = extracted.get(\"confidence\", 0.5)\n   321→                    if isinstance(confidence, (int, float)):\n   322→                        conf_label = \"High\" if confidence >= 0.7 else \"Medium\" if confidence >= 0.4 else \"Low\"\n   323→                    else:\n   324→                        conf_label = str(confidence).title()\n   325→                    if prediction_text:\n   326→                        sections.append(f\"### {prediction_text[:80]}\")\n   327→                        sections.append(\"\")\n   328→                        sections.append(f\"**Timeframe:** {timeframe} | **Confidence:** {conf_label}\")\n   329→                        basis = extracted.get(\"prediction_basis\", [])\n   330→                        if basis:\n   331→                            sections.append(\"\")\n   332→                            sections.append(\"**Supporting Evidence:**\")\n   333→                            for b in basis[:3]:\n   334→                                sections.append(f\"- {b}\")\n   335→                        sections.append(\"\")\n   336→                else:\n   337→                    sections.append(f\"- {pred.get('summary') or pred.get('content', '')[:150]}\")\n   338→            sections.append(\"\")\n   339→\n   340→        # Perspective Predictions\n   341→        all_predictions = []\n   342→        for p in perspectives:\n   343→            preds = p.get(\"predictions\", [])\n   344→            for pred in preds:\n   345→                if isinstance(pred, dict):\n   346→                    pred[\"source_perspective\"] = p.get(\"perspective_type\", \"\")\n   347→                    all_predictions.append(pred)\n   348→        if all_predictions:\n   349→            sections.append(\"## Expert Predictions\")\n   350→            sections.append(\"\")\n   351→            for pred in all_predictions[:8]:\n   352→                prediction_text = pred.get(\"prediction\", \"\")\n   353→                timeline = pred.get(\"timeline\", \"2026\")\n   354→                confidence = pred.get(\"confidence\", \"medium\")\n   355→                source = pred.get(\"source_perspective\", \"\").replace(\"_\", \" \").title()\n   356→                if prediction_text:\n   357→                    sections.append(f\"- **{source}**: {prediction_text} (Timeline: {timeline}, Confidence: {confidence})\")\n   358→            sections.append(\"\")\n   359→\n   360→        # Adoption Trends\n   361→        adoption = [f for f in findings if f.get(\"finding_type\") == \"adoption_trend\"]\n   362→        if adoption:\n   363→            sections.append(\"## Current Adoption Trends\")\n   364→            sections.append(\"\")\n   365→            for a in adoption[:6]:\n   366→                extracted = a.get(\"extracted_data\", {})\n   367→                if extracted and isinstance(extracted, dict):\n   368→                    tech = extracted.get(\"technology\", \"\")\n   369→                    rate = extracted.get(\"adoption_rate\", \"\")\n   370→                    growth = extracted.get(\"growth_percentage\", \"\")\n   371→                    if tech:\n   372→                        sections.append(f\"- **{tech}**: {rate}% adoption, {growth}% growth\")\n   373→                else:\n   374→                    sections.append(f\"- {a.get('summary') or a.get('content', '')[:100]}\")\n   375→            sections.append(\"\")\n   376→\n   377→        # Emerging Technologies\n   378→        product_launches = [f for f in findings if f.get(\"finding_type\") == \"product_launch\"]\n   379→        if product_launches:\n   380→            sections.append(\"## Recent Product Launches\")\n   381→            sections.append(\"\")\n   382→            for pl in product_launches[:6]:\n   383→                extracted = pl.get(\"extracted_data\", {})\n   384→                if extracted and isinstance(extracted, dict):\n   385→                    product = extracted.get(\"product_name\", \"\")\n   386→                    company = extracted.get(\"company\", \"\")\n   387→                    if product and company:\n   388→                        sections.append(f\"- **{product}** by {company}\")\n   389→                else:\n   390→                    sections.append(f\"- {pl.get('summary') or pl.get('content', '')[:100]}\")\n   391→            sections.append(\"\")\n   392→\n   393→        # Developer Sentiment\n   394→        sentiment = [f for f in findings if f.get(\"finding_type\") == \"developer_sentiment\"]\n   395→        if sentiment:\n   396→            sections.append(\"## Developer Sentiment\")\n   397→            sections.append(\"\")\n   398→            for s in sentiment[:4]:\n   399→                sections.append(f\"- {s.get('summary') or s.get('content', '')[:100]}\")\n   400→            sections.append(\"\")\n   401→\n   402→        return \"\\n\".join(sections)\n   403→\n   404→    def generate_vc_briefing(\n   405→        self,\n   406→        result: Dict[str, Any],\n   407→        title: Optional[str] = None,\n   408→    ) -> str:\n   409→        \"\"\"Generate VC briefing report - tech market-specific variant.\n   410→\n   411→        Focuses on investment opportunities, funding rounds, and market dynamics.\n   412→        \"\"\"\n   413→        from datetime import datetime\n   414→\n   415→        query = result.get(\"query\", \"Unknown\")\n   416→        report_title = title or f\"VC Briefing: {query[:40]}\"\n   417→\n   418→        sections = []\n   419→        sections.append(f\"# {report_title}\")\n   420→        sections.append(\"\")\n   421→        sections.append(f\"**Subject:** {query}\")\n   422→        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n   423→        sections.append(\"\")\n   424→        sections.append(\"---\")\n   425→        sections.append(\"\")\n   426→\n   427→        findings = result.get(\"findings\", [])\n   428→        perspectives = result.get(\"perspectives\", [])\n   429→\n   430→        # Investment Thesis from VC Perspective\n   431→        vc_perspective = next((p for p in perspectives if \"venture\" in p.get(\"perspective_type\", \"\").lower()\n   432→                               or \"vc\" in p.get(\"perspective_type\", \"\").lower()), None)\n   433→        if vc_perspective:\n   434→            sections.append(\"## Investment Thesis\")\n   435→            sections.append(\"\")\n   436→            sections.append(vc_perspective.get(\"analysis_text\", \"\")[:600])\n   437→            sections.append(\"\")\n   438→            insights = vc_perspective.get(\"key_insights\", [])\n   439→            if insights:\n   440→                sections.append(\"**Key Investment Insights:**\")\n   441→                for i in insights[:4]:\n   442→                    sections.append(f\"- {i}\")\n   443→            sections.append(\"\")\n   444→\n   445→        # Funding Rounds\n   446→        funding = [f for f in findings if f.get(\"finding_type\") == \"funding_round\"]\n   447→        if funding:\n   448→            sections.append(\"## Recent Funding Activity\")\n   449→            sections.append(\"\")\n   450→            sections.append(\"| Company | Round | Amount | Investors |\")\n   451→            sections.append(\"|---------|-------|--------|-----------|\")\n   452→            for fr in funding[:8]:\n   453→                extracted = fr.get(\"extracted_data\", {})\n   454→                if extracted and isinstance(extracted, dict):\n   455→                    company = extracted.get(\"company\", \"Unknown\")\n   456→                    round_type = extracted.get(\"round_type\", \"\")\n   457→                    amount = extracted.get(\"amount\", \"\")\n   458→                    investors = extracted.get(\"investors\", [])\n   459→                    inv_str = \", \".join(investors[:2]) if isinstance(investors, list) else str(investors)\n   460→                    sections.append(f\"| {company} | {round_type} | {amount} | {inv_str} |\")\n   461→                else:\n   462→                    sections.append(f\"- {fr.get('summary') or fr.get('content', '')[:100]}\")\n   463→            sections.append(\"\")\n   464→\n   465→        # Acquisitions\n   466→        acquisitions = [f for f in findings if f.get(\"finding_type\") == \"acquisition\"]\n   467→        if acquisitions:\n   468→            sections.append(\"## M&A Activity\")\n   469→            sections.append(\"\")\n   470→            for acq in acquisitions[:5]:\n   471→                extracted = acq.get(\"extracted_data\", {})\n   472→                if extracted and isinstance(extracted, dict):\n   473→                    acquirer = extracted.get(\"acquirer\", \"\")\n   474→                    target = extracted.get(\"target\", \"\")\n   475→                    amount = extracted.get(\"amount\", \"\")\n   476→                    if acquirer and target:\n   477→                        sections.append(f\"- **{acquirer}** acquired **{target}** for {amount}\")\n   478→                else:\n   479→                    sections.append(f\"- {acq.get('summary') or acq.get('content', '')[:100]}\")\n   480→            sections.append(\"\")\n   481→\n   482→        # Market Metrics\n   483→        metrics = [f for f in findings if f.get(\"finding_type\") == \"market_metric\"]\n   484→        if metrics:\n   485→            sections.append(\"## Market Metrics\")\n   486→            sections.append(\"\")\n   487→            for m in metrics[:5]:\n   488→                sections.append(f\"- {m.get('summary') or m.get('content', '')[:100]}\")\n   489→            sections.append(\"\")\n   490→\n   491→        # Enterprise Adoption\n   492→        enterprise = [f for f in findings if f.get(\"finding_type\") == \"enterprise_adoption\"]\n   493→        if enterprise:\n   494→            sections.append(\"## Enterprise Adoption Signals\")\n   495→            sections.append(\"\")\n   496→            for e in enterprise[:4]:\n   497→                sections.append(f\"- {e.get('summary') or e.get('content', '')[:100]}\")\n   498→            sections.append(\"\")\n   499→\n   500→        # Risks\n   501→        all_warnings = []\n   502→        for p in perspectives:\n   503→            all_warnings.extend(p.get(\"warnings\", []))\n   504→        if all_warnings:\n   505→            sections.append(\"## Investment Risks\")\n   506→            sections.append(\"\")\n   507→            for w in all_warnings[:5]:\n   508→                sections.append(f\"- {w}\")\n   509→            sections.append(\"\")\n   510→\n   511→        return \"\\n\".join(sections)\n   512→\n   513→    def _get_priority_findings(self, findings: List[Dict[str, Any]]) -> List[Dict[str, Any]]:\n   514→        \"\"\"Tech market template prioritizes predictions, funding, and adoption trends.\"\"\"\n   515→        priority_types = [\"prediction\", \"funding_round\", \"adoption_trend\", \"product_launch\", \"acquisition\", \"market_metric\"]\n   516→        prioritized = []\n   517→\n   518→        # First add all predicted temporal context\n   519→        predicted = [f for f in findings if f.get(\"temporal_context\") == \"predicted\"]\n   520→        prioritized.extend(sorted(predicted, key=lambda x: x.get(\"confidence_score\", 0), reverse=True))\n   521→\n   522→        for ftype in priority_types:\n   523→            type_findings = [f for f in findings if f.get(\"finding_type\") == ftype and f not in prioritized]\n   524→            prioritized.extend(sorted(\n   525→                type_findings,\n   526→                key=lambda x: x.get(\"confidence_score\", 0),\n   527→                reverse=True\n   528→            ))\n   529→\n   530→        remaining = [f for f in findings if f not in prioritized]\n   531→        prioritized.extend(sorted(remaining, key=lambda x: x.get(\"confidence_score\", 0), reverse=True))\n   532→\n   533→        return prioritized\n   534→\n   535→    def _generate_key_sections(self, result: Dict[str, Any]) -> str:\n   536→        \"\"\"Generate tech market-specific key sections: Predictions, Funding Highlights.\"\"\"\n   537→        findings = result.get(\"findings\", [])\n   538→        sections = []\n   539→\n   540→        # 2026 Predictions Highlight\n   541→        predictions = [f for f in findings if f.get(\"finding_type\") == \"prediction\"\n   542→                       or f.get(\"temporal_context\") == \"predicted\"]\n   543→        if predictions:\n   544→            sections.append(\"## 2026 Outlook Highlights\")\n   545→            sections.append(\"\")\n   546→            for p in predictions[:4]:\n   547→                sections.append(f\"- {p.get('summary') or p.get('content', '')[:100]}\")\n   548→            sections.append(\"\")\n   549→\n   550→        # Recent Funding\n   551→        funding = [f for f in findings if f.get(\"finding_type\") == \"funding_round\"]\n   552→        if funding:\n   553→            sections.append(\"## Notable Funding Rounds\")\n   554→            sections.append(\"\")\n   555→            for fr in funding[:4]:\n   556→                sections.append(f\"- {fr.get('summary') or fr.get('content', '')[:100]}\")\n   557→            sections.append(\"\")\n   558→\n   559→        return \"\\n\".join(sections)\n   560→\n   561→    def _generate_executive_highlights(self, result: Dict[str, Any]) -> str:\n   562→        \"\"\"Generate tech market-specific executive highlights.\"\"\"\n   563→        findings = result.get(\"findings\", [])\n   564→        sections = []\n   565→\n   566→        # Key trends\n   567→        adoption = [f for f in findings if f.get(\"finding_type\") == \"adoption_trend\"]\n   568→        if adoption:\n   569→            sections.append(\"## Key Adoption Trends\")\n   570→            sections.append(\"\")\n   571→            for a in adoption[:3]:\n   572→                sections.append(f\"- {a.get('summary') or a.get('content', '')[:80]}\")\n   573→            sections.append(\"\")\n   574→\n   575→        return \"\\n\".join(sections)\n   576→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"82343d47-30e9-47a3-93fa-efd2489cfa93","uuid":"134d2aeb-31c6-4ffd-99ac-6f8bb74e8eb6","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\actor\\src\\templates\\tech_market.py","content":"\"\"\"Tech market research template for 2025 developments and 2026 predictions.\"\"\"\n\nfrom typing import List, Dict, Any, Optional\n\nfrom .base import BaseTemplate\nfrom ..services.report_components import (\n    ComponentType, ComponentConfig, ReportHints, get_report_hints\n)\n\n\nclass TechMarketTemplate(BaseTemplate):\n    \"\"\"Template for technology market analysis and trend research.\"\"\"\n\n    template_id = \"tech_market\"\n    template_name = \"Tech Market Analysis\"\n    description = \"Technology market trends, 2025 developments, and 2026 predictions\"\n\n    # Report hints for component-based rendering\n    report_hints = ReportHints(\n        template_type=\"tech_market\",\n        structure=\"quantitative_first\",\n        findings_grouping=\"category\",\n        tone=\"analytical\",\n        decision_format=\"recommendation\",\n        emphasis=[\"adoption_metrics\", \"market_trends\", \"technology_comparison\"],\n        required_components=[\n            ComponentType.TECH_RADAR,\n            ComponentType.METRIC_CARDS,\n            ComponentType.FINDINGS_TABLE,\n        ],\n        optional_components=[\n            ComponentType.TIMELINE,\n            ComponentType.COMPARISON_TABLE,\n            ComponentType.PREDICTION_CARDS,\n            ComponentType.KEY_INSIGHTS,\n        ],\n        visualization_preference=[\"tech_radar\", \"adoption_chart\", \"comparison_matrix\"],\n        custom_sections={\n            \"primary_metric\": \"adoption_rate\",\n            \"show_funding_rounds\": True,\n            \"prediction_focus\": \"2026\",\n        }\n    )\n\n    # Expert perspectives: 4 VC/Startup + 4 Developer Community\n    default_perspectives = [\n        # VC & Startup focused\n        \"venture_capitalist\",\n        \"startup_founder\",\n        \"product_manager\",\n        \"developer_advocate\",\n        # Developer Community\n        \"open_source_maintainer\",\n        \"devrel_engineer\",\n        \"senior_engineer\",\n        \"platform_engineer\",\n    ]\n\n    default_max_searches = 12\n\n    # Tech market is MOST prone to hype, vendor marketing, and inflated claims\n    # Adoption rates vary wildly by definition, predictions are often wrong\n    # Needs maximum verification to separate signal from noise\n    verification_config = {\n        \"cross_reference\": \"thorough\",      # Adoption numbers vary wildly\n        \"bias_detection\": \"thorough\",       # Vendor marketing everywhere\n        \"expert_sanity_check\": \"thorough\",  # Flag hype and unrealistic claims\n        \"source_quality\": \"thorough\",       # Distinguish surveys from blogs\n    }\n\n    async def generate_search_queries(\n        self,\n        query: str,\n        max_searches: int,\n        granularity: str = \"standard\",\n    ) -> List[str]:\n        \"\"\"Generate tech market research queries with 2025/2026 focus.\"\"\"\n        prompt = f\"\"\"\nYou are a technology market analyst planning comprehensive research on developer tools,\ninfrastructure, and enterprise technology trends.\n\nResearch Topic: {query}\n\nDepth Level: {granularity}\n\nGenerate search queries covering these technology domains:\n\n1. SOFTWARE DEVELOPMENT ECOSYSTEM\n   - Programming languages: adoption trends, new releases, performance comparisons\n   - Frameworks: frontend (React, Vue, Svelte, Next.js), backend (Node, Go, Rust, Python)\n   - IDEs and development tools: VS Code extensions, JetBrains, AI coding assistants\n   - Testing: test frameworks, quality engineering, shift-left practices\n   - Developer productivity: pair programming, code review tools, documentation\n\n2. AI/ML AND FULL STACK INFRASTRUCTURE\n   - LLM platforms: OpenAI, Anthropic, Google, open-source models (Llama, Mistral)\n   - AI coding assistants: GitHub Copilot, Cursor, Codeium, Tabnine adoption\n   - MLOps tools: model training, deployment, monitoring, vector databases\n   - Cloud platforms: AWS, Azure, GCP innovations, multi-cloud strategies\n   - Edge AI and on-device inference trends\n\n3. DEVOPS AND PLATFORM ENGINEERING\n   - Platform engineering: internal developer platforms, golden paths\n   - GitOps and infrastructure as code: Terraform, Pulumi, Crossplane\n   - Containers and orchestration: Kubernetes ecosystem, service mesh\n   - CI/CD innovations: GitHub Actions, GitLab CI, Dagger\n   - Observability: OpenTelemetry, distributed tracing, AIOps\n\n4. ENTERPRISE TECH STACK\n   - Security: DevSecOps, zero-trust, SAST/DAST, supply chain security\n   - Databases: NewSQL, time-series, graph databases, serverless databases\n   - APIs: GraphQL adoption, API gateways, API-first development\n   - Data engineering: data mesh, lakehouse, real-time analytics\n   - Microservices: event-driven architecture, distributed systems\n\n5. MARKET DYNAMICS\n   - Funding rounds and valuations for developer tools companies\n   - M&A activity and consolidation trends\n   - Developer survey results (Stack Overflow, JetBrains, GitHub)\n   - Enterprise adoption case studies and ROI analysis\n   - Open source project health and governance\n\n6. TEMPORAL FOCUS (CRITICAL)\n   - Include \"2025\" in searches for current developments\n   - Include \"2026 predictions\" or \"roadmap 2026\" for future trends\n   - Search for \"State of X 2025\" reports where relevant\n   - Include analyst predictions and market forecasts\n\nFor a \"{granularity}\" depth level:\n- \"quick\": 4-5 searches on key emerging tech and major trends\n- \"standard\": 8-10 searches covering all domains with market dynamics\n- \"deep\": 12+ searches with comprehensive coverage including funding, predictions, and niche areas\n\nReturn a JSON array of exactly {max_searches} search query strings, ordered by importance.\nExample: [\"AI coding assistants market 2025 adoption GitHub Copilot\", \"developer tools VC funding 2025\", ...]\n\"\"\"\n\n        result = await self._call_gemini_json(prompt)\n\n        if isinstance(result, list):\n            return result[:max_searches]\n        return []\n\n    async def extract_findings(\n        self,\n        query: str,\n        sources: List[Dict[str, Any]],\n        synthesized_content: str,\n        granularity: str = \"standard\",\n    ) -> List[Dict[str, Any]]:\n        \"\"\"Extract tech market findings with prediction support.\"\"\"\n        # Build source context\n        source_context = \"\\n\\n\".join([\n            f\"Source: {s.get('title', 'Unknown')} ({s.get('url', '')})\\n\"\n            f\"Credibility: {s.get('credibility_score', 'Unknown')}\\n\"\n            f\"Domain: {s.get('domain', '')}\"\n            for s in sources[:20]\n        ])\n\n        prompt = f\"\"\"\nYou are a technology market analyst extracting key findings for developer tools research.\nCRITICAL: Use EXACT finding_type values specified below - they map to UI components (Tech Radar).\n\nResearch Topic: {query}\n\nSynthesized Research Content:\n{synthesized_content[:15000]}\n\nSources Referenced:\n{source_context}\n\n=== USE ONLY THESE finding_type VALUES ===\n\n1. TECH TRENDS (finding_type: \"tech_trend\")\n   - New technologies gaining adoption (for Tech Radar visualization)\n   - Emerging patterns in developer tools, frameworks, languages\n   - Technical architecture shifts, new paradigms\n   - Include: technology name, maturity level, adoption momentum\n   - extracted_data MUST include: {{\"technology\": \"...\", \"maturity\": \"adopt|trial|assess|hold\"}}\n\n2. MARKET TRENDS (finding_type: \"market_trend\")\n   - Market size, growth rates, TAM/SAM estimates\n   - Competitive landscape changes, consolidation\n   - Industry-wide shifts and inflection points\n   - extracted_data: {{\"market_size\": \"...\", \"growth_rate\": \"...\", \"segment\": \"...\"}}\n\n3. ADOPTION PATTERNS (finding_type: \"adoption_pattern\")\n   - Developer adoption rates with specific percentages\n   - Enterprise vs startup adoption differences\n   - Geographic or segment adoption variations\n   - extracted_data: {{\"tool\": \"...\", \"adoption_rate\": 40, \"segment\": \"enterprise|startup|all\"}}\n\n4. FINANCIAL METRICS (finding_type: \"financial_metric\")\n   - Funding rounds, valuations, revenue figures\n   - M&A activity and deal values\n   - Pricing changes, business model shifts\n   - extracted_data: {{\"company\": \"...\", \"metric\": \"funding|revenue|valuation\", \"value\": \"...\"}}\n\n5. PREDICTIONS (finding_type: \"prediction\")\n   - 2026 forecasts and roadmaps\n   - Analyst predictions with timelines\n   - Technology evolution predictions\n   - extracted_data: {{\"prediction\": \"...\", \"timeline\": \"2026\", \"confidence\": 0.8}}\n\n6. RED FLAGS (finding_type: \"red_flag\")\n   - Declining adoption, negative developer sentiment\n   - Project stagnation, maintainer burnout\n   - Security issues, funding problems\n   - extracted_data: {{\"issue\": \"...\", \"severity\": \"high|medium|low\"}}\n\n=== STRICT JSON OUTPUT FORMAT ===\n\nReturn JSON array with EXACT structure. CRITICAL: Include \"analysis\" field with YOUR expert commentary.\n[\n  {{{{\n    \"finding_type\": \"tech_trend\",\n    \"summary\": \"AI coding assistants reach 40% developer adoption in 2025\",\n    \"content\": \"According to Stack Overflow Developer Survey 2025, AI coding assistants...\",\n    \"analysis\": \"This adoption rate represents a major inflection point. The 40% threshold typically signals mainstream adoption in developer tools. However, the 'adoption' definition varies - active daily use vs occasional use shows different patterns. Enterprise adoption lags individual developers by 12-18 months.\",\n    \"confidence_score\": 0.88,\n    \"date_referenced\": \"January 2025\",\n    \"extracted_data\": {{{{\"technology\": \"AI Coding Assistants\", \"maturity\": \"adopt\", \"adoption_rate\": 40}}}}\n  }}}},\n  {{{{\n    \"finding_type\": \"market_trend\",\n    \"summary\": \"Developer tools market reaches $4.8B valuation in 2025\",\n    \"content\": \"The global developer tools market expanded to $4.8 billion...\",\n    \"analysis\": \"The AI coding segment is driving most of this growth, representing roughly 35% of the total market. However, market fragmentation is increasing as specialized tools emerge for different programming languages and use cases. Consolidation is likely in 2026.\",\n    \"confidence_score\": 0.92,\n    \"date_referenced\": \"2025\",\n    \"extracted_data\": {{{{\"market_size\": \"$4.8B\", \"growth_rate\": \"28%\", \"segment\": \"AI coding tools\"}}}}\n  }}}},\n  {{{{\n    \"finding_type\": \"adoption_pattern\",\n    \"summary\": \"GitHub Copilot leads with 1.8M paid subscribers\",\n    \"content\": \"GitHub Copilot continues to dominate the AI coding market...\",\n    \"analysis\": \"Copilot's first-mover advantage and Microsoft's enterprise distribution create significant moats. However, Cursor's rapid growth among power users suggests the market may bifurcate between 'good enough' and 'best in class' segments.\",\n    \"confidence_score\": 0.90,\n    \"date_referenced\": \"Q4 2024\",\n    \"extracted_data\": {{{{\"tool\": \"GitHub Copilot\", \"subscribers\": \"1.8M\", \"market_share\": \"55%\"}}}}\n  }}}}\n]\n\nIMPORTANT: The \"analysis\" field should contain YOUR expert analytical commentary explaining:\n- Why this trend/finding matters for the technology landscape\n- What it implies for developers, enterprises, or the market\n- Any caveats, counter-trends, or nuances to consider\n\nFor \"{granularity}\" depth:\n- quick: 8-10 findings focusing on major trends\n- standard: 15-20 findings with balanced coverage\n- deep: 25-30 comprehensive findings\n\nExtract findings covering: tech_trend, market_trend, adoption_pattern, financial_metric, prediction, red_flag.\nReturn ONLY the JSON array.\n\"\"\"\n\n        result = await self._call_gemini_json(prompt)\n\n        findings = []\n        if isinstance(result, list):\n            for f in result:\n                if isinstance(f, dict):\n                    findings.append({\n                        \"finding_type\": f.get(\"finding_type\", \"fact\"),\n                        \"content\": f.get(\"content\", \"\"),\n                        \"summary\": f.get(\"summary\"),\n                        \"analysis\": f.get(\"analysis\", \"\"),  # LLM's expert commentary\n                        \"confidence_score\": f.get(\"confidence_score\", 0.5),\n                        \"temporal_context\": f.get(\"temporal_context\", \"present\"),\n                        \"date_referenced\": f.get(\"date_referenced\", \"\"),\n                        \"extracted_data\": f.get(\"extracted_data\"),\n                    })\n\n        return findings\n\n    # ========== TECH MARKET-SPECIFIC REPORT GENERATION ==========\n\n    def get_supported_report_variants(self) -> List[str]:\n        \"\"\"Tech market template supports trend_forecast and vc_briefing variants.\"\"\"\n        return [\"full_report\", \"executive_summary\", \"trend_forecast\", \"vc_briefing\"]\n\n    def generate_trend_forecast(\n        self,\n        result: Dict[str, Any],\n        title: Optional[str] = None,\n    ) -> str:\n        \"\"\"Generate trend forecast report - tech market-specific variant.\n\n        Focuses on predictions, emerging technologies, and 2026 outlook.\n        \"\"\"\n        from datetime import datetime\n\n        query = result.get(\"query\", \"Unknown\")\n        report_title = title or f\"Tech Trend Forecast: {query[:40]}\"\n\n        sections = []\n        sections.append(f\"# {report_title}\")\n        sections.append(\"\")\n        sections.append(f\"**Subject:** {query}\")\n        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n        sections.append(\"\")\n        sections.append(\"---\")\n        sections.append(\"\")\n\n        findings = result.get(\"findings\", [])\n        perspectives = result.get(\"perspectives\", [])\n\n        # 2026 Predictions (most important)\n        predictions = [f for f in findings if f.get(\"finding_type\") == \"prediction\"\n                       or f.get(\"temporal_context\") == \"predicted\"]\n        if predictions:\n            sections.append(\"## 2026 Predictions\")\n            sections.append(\"\")\n            for pred in predictions:\n                extracted = pred.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    prediction_text = extracted.get(\"prediction\", \"\")\n                    timeframe = extracted.get(\"timeframe\", \"2026\")\n                    confidence = extracted.get(\"confidence\", 0.5)\n                    if isinstance(confidence, (int, float)):\n                        conf_label = \"High\" if confidence >= 0.7 else \"Medium\" if confidence >= 0.4 else \"Low\"\n                    else:\n                        conf_label = str(confidence).title()\n                    if prediction_text:\n                        sections.append(f\"### {prediction_text[:80]}\")\n                        sections.append(\"\")\n                        sections.append(f\"**Timeframe:** {timeframe} | **Confidence:** {conf_label}\")\n                        basis = extracted.get(\"prediction_basis\", [])\n                        if basis:\n                            sections.append(\"\")\n                            sections.append(\"**Supporting Evidence:**\")\n                            for b in basis[:3]:\n                                sections.append(f\"- {b}\")\n                        sections.append(\"\")\n                else:\n                    sections.append(f\"- {pred.get('summary') or pred.get('content', '')[:150]}\")\n            sections.append(\"\")\n\n        # Perspective Predictions\n        all_predictions = []\n        for p in perspectives:\n            preds = p.get(\"predictions\", [])\n            for pred in preds:\n                if isinstance(pred, dict):\n                    pred[\"source_perspective\"] = p.get(\"perspective_type\", \"\")\n                    all_predictions.append(pred)\n        if all_predictions:\n            sections.append(\"## Expert Predictions\")\n            sections.append(\"\")\n            for pred in all_predictions[:8]:\n                prediction_text = pred.get(\"prediction\", \"\")\n                timeline = pred.get(\"timeline\", \"2026\")\n                confidence = pred.get(\"confidence\", \"medium\")\n                source = pred.get(\"source_perspective\", \"\").replace(\"_\", \" \").title()\n                if prediction_text:\n                    sections.append(f\"- **{source}**: {prediction_text} (Timeline: {timeline}, Confidence: {confidence})\")\n            sections.append(\"\")\n\n        # Adoption Trends\n        adoption = [f for f in findings if f.get(\"finding_type\") == \"adoption_trend\"]\n        if adoption:\n            sections.append(\"## Current Adoption Trends\")\n            sections.append(\"\")\n            for a in adoption[:6]:\n                extracted = a.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    tech = extracted.get(\"technology\", \"\")\n                    rate = extracted.get(\"adoption_rate\", \"\")\n                    growth = extracted.get(\"growth_percentage\", \"\")\n                    if tech:\n                        sections.append(f\"- **{tech}**: {rate}% adoption, {growth}% growth\")\n                else:\n                    sections.append(f\"- {a.get('summary') or a.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Emerging Technologies\n        product_launches = [f for f in findings if f.get(\"finding_type\") == \"product_launch\"]\n        if product_launches:\n            sections.append(\"## Recent Product Launches\")\n            sections.append(\"\")\n            for pl in product_launches[:6]:\n                extracted = pl.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    product = extracted.get(\"product_name\", \"\")\n                    company = extracted.get(\"company\", \"\")\n                    if product and company:\n                        sections.append(f\"- **{product}** by {company}\")\n                else:\n                    sections.append(f\"- {pl.get('summary') or pl.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Developer Sentiment\n        sentiment = [f for f in findings if f.get(\"finding_type\") == \"developer_sentiment\"]\n        if sentiment:\n            sections.append(\"## Developer Sentiment\")\n            sections.append(\"\")\n            for s in sentiment[:4]:\n                sections.append(f\"- {s.get('summary') or s.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        return \"\\n\".join(sections)\n\n    def generate_vc_briefing(\n        self,\n        result: Dict[str, Any],\n        title: Optional[str] = None,\n    ) -> str:\n        \"\"\"Generate VC briefing report - tech market-specific variant.\n\n        Focuses on investment opportunities, funding rounds, and market dynamics.\n        \"\"\"\n        from datetime import datetime\n\n        query = result.get(\"query\", \"Unknown\")\n        report_title = title or f\"VC Briefing: {query[:40]}\"\n\n        sections = []\n        sections.append(f\"# {report_title}\")\n        sections.append(\"\")\n        sections.append(f\"**Subject:** {query}\")\n        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n        sections.append(\"\")\n        sections.append(\"---\")\n        sections.append(\"\")\n\n        findings = result.get(\"findings\", [])\n        perspectives = result.get(\"perspectives\", [])\n\n        # Investment Thesis from VC Perspective\n        vc_perspective = next((p for p in perspectives if \"venture\" in p.get(\"perspective_type\", \"\").lower()\n                               or \"vc\" in p.get(\"perspective_type\", \"\").lower()), None)\n        if vc_perspective:\n            sections.append(\"## Investment Thesis\")\n            sections.append(\"\")\n            sections.append(vc_perspective.get(\"analysis_text\", \"\")[:600])\n            sections.append(\"\")\n            insights = vc_perspective.get(\"key_insights\", [])\n            if insights:\n                sections.append(\"**Key Investment Insights:**\")\n                for i in insights[:4]:\n                    sections.append(f\"- {i}\")\n            sections.append(\"\")\n\n        # Funding Rounds\n        funding = [f for f in findings if f.get(\"finding_type\") == \"funding_round\"]\n        if funding:\n            sections.append(\"## Recent Funding Activity\")\n            sections.append(\"\")\n            sections.append(\"| Company | Round | Amount | Investors |\")\n            sections.append(\"|---------|-------|--------|-----------|\")\n            for fr in funding[:8]:\n                extracted = fr.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    company = extracted.get(\"company\", \"Unknown\")\n                    round_type = extracted.get(\"round_type\", \"\")\n                    amount = extracted.get(\"amount\", \"\")\n                    investors = extracted.get(\"investors\", [])\n                    inv_str = \", \".join(investors[:2]) if isinstance(investors, list) else str(investors)\n                    sections.append(f\"| {company} | {round_type} | {amount} | {inv_str} |\")\n                else:\n                    sections.append(f\"- {fr.get('summary') or fr.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Acquisitions\n        acquisitions = [f for f in findings if f.get(\"finding_type\") == \"acquisition\"]\n        if acquisitions:\n            sections.append(\"## M&A Activity\")\n            sections.append(\"\")\n            for acq in acquisitions[:5]:\n                extracted = acq.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    acquirer = extracted.get(\"acquirer\", \"\")\n                    target = extracted.get(\"target\", \"\")\n                    amount = extracted.get(\"amount\", \"\")\n                    if acquirer and target:\n                        sections.append(f\"- **{acquirer}** acquired **{target}** for {amount}\")\n                else:\n                    sections.append(f\"- {acq.get('summary') or acq.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Market Metrics\n        metrics = [f for f in findings if f.get(\"finding_type\") == \"market_metric\"]\n        if metrics:\n            sections.append(\"## Market Metrics\")\n            sections.append(\"\")\n            for m in metrics[:5]:\n                sections.append(f\"- {m.get('summary') or m.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Enterprise Adoption\n        enterprise = [f for f in findings if f.get(\"finding_type\") == \"enterprise_adoption\"]\n        if enterprise:\n            sections.append(\"## Enterprise Adoption Signals\")\n            sections.append(\"\")\n            for e in enterprise[:4]:\n                sections.append(f\"- {e.get('summary') or e.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Risks\n        all_warnings = []\n        for p in perspectives:\n            all_warnings.extend(p.get(\"warnings\", []))\n        if all_warnings:\n            sections.append(\"## Investment Risks\")\n            sections.append(\"\")\n            for w in all_warnings[:5]:\n                sections.append(f\"- {w}\")\n            sections.append(\"\")\n\n        return \"\\n\".join(sections)\n\n    def _get_priority_findings(self, findings: List[Dict[str, Any]]) -> List[Dict[str, Any]]:\n        \"\"\"Tech market template prioritizes predictions, funding, and adoption trends.\"\"\"\n        priority_types = [\"prediction\", \"funding_round\", \"adoption_trend\", \"product_launch\", \"acquisition\", \"market_metric\"]\n        prioritized = []\n\n        # First add all predicted temporal context\n        predicted = [f for f in findings if f.get(\"temporal_context\") == \"predicted\"]\n        prioritized.extend(sorted(predicted, key=lambda x: x.get(\"confidence_score\", 0), reverse=True))\n\n        for ftype in priority_types:\n            type_findings = [f for f in findings if f.get(\"finding_type\") == ftype and f not in prioritized]\n            prioritized.extend(sorted(\n                type_findings,\n                key=lambda x: x.get(\"confidence_score\", 0),\n                reverse=True\n            ))\n\n        remaining = [f for f in findings if f not in prioritized]\n        prioritized.extend(sorted(remaining, key=lambda x: x.get(\"confidence_score\", 0), reverse=True))\n\n        return prioritized\n\n    def _generate_key_sections(self, result: Dict[str, Any]) -> str:\n        \"\"\"Generate tech market-specific key sections: Predictions, Funding Highlights.\"\"\"\n        findings = result.get(\"findings\", [])\n        sections = []\n\n        # 2026 Predictions Highlight\n        predictions = [f for f in findings if f.get(\"finding_type\") == \"prediction\"\n                       or f.get(\"temporal_context\") == \"predicted\"]\n        if predictions:\n            sections.append(\"## 2026 Outlook Highlights\")\n            sections.append(\"\")\n            for p in predictions[:4]:\n                sections.append(f\"- {p.get('summary') or p.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Recent Funding\n        funding = [f for f in findings if f.get(\"finding_type\") == \"funding_round\"]\n        if funding:\n            sections.append(\"## Notable Funding Rounds\")\n            sections.append(\"\")\n            for fr in funding[:4]:\n                sections.append(f\"- {fr.get('summary') or fr.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        return \"\\n\".join(sections)\n\n    def _generate_executive_highlights(self, result: Dict[str, Any]) -> str:\n        \"\"\"Generate tech market-specific executive highlights.\"\"\"\n        findings = result.get(\"findings\", [])\n        sections = []\n\n        # Key trends\n        adoption = [f for f in findings if f.get(\"finding_type\") == \"adoption_trend\"]\n        if adoption:\n            sections.append(\"## Key Adoption Trends\")\n            sections.append(\"\")\n            for a in adoption[:3]:\n                sections.append(f\"- {a.get('summary') or a.get('content', '')[:80]}\")\n            sections.append(\"\")\n\n        return \"\\n\".join(sections)\n","numLines":576,"startLine":1,"totalLines":576}}}
