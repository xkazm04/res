 useState } from 'react';\nimport { motion } from 'framer-motion';\nimport { useReportTheme } from '../core/ThemeContext';\nimport type { CausalChain } from '@/src/types/research';\n\ninterface CausalFlowProps {\n  chains: CausalChain[];\n  onStepClick?: (chainId: string, stepIndex: number) => void;\n}\n\nexport function CausalFlow({ chains, onStepClick }: CausalFlowProps) {\n  const { theme } = useReportTheme();\n  const isRadar = theme === 'radar';\n  const [activeChain, setActiveChain] = useState<string | null>(chains[0]?.id || null);\n  const [hoveredStep, setHoveredStep] = useState<number | null>(null);\n\n  const activeData = chains.find(c => c.id === activeChain);\n  const steps = activeData?.descriptions || [];\n\n  return (\n    <div className={`rounded-xl overflow-hidden ${isRadar ? 'bg-slate-900/60 border border-cyan-500/10' : 'bg-white border border-stone-200'}`}>\n      {/* Chain selector */}\n      {chains.length > 1 && (\n        <div className={`flex gap-2 p-3 border-b ${isRadar ? 'border-cyan-500/10 bg-slate-950/50' : 'border-stone-200 bg-stone-50'}`}>\n          {chains.map((chain, i) => (\n            <button\n              key={chain.id}\n              onClick={() => setActiveChain(chain.id)}\n              className={`px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${\n                activeChain === chain.id\n                  ? isRadar ? 'bg-cyan-500/20 text-cyan-300' : 'bg-stone-800 text-white'\n                  : isRadar ? 'text-slate-400 hover:text-white' : 'text-stone-600 hover:text-stone-900'\n              }`}\n            >\n              Chain {i + 1}\n            </button>\n          ))}\n        </div>\n      )}\n\n      {/* Flow visualization */}\n      <div className=\"p-6\">\n        <div className=\"relative\">\n          {/* Connection line */}\n          <div className={`absolute top-6 left-0 right-0 h-0.5 ${isRadar ? 'bg-gradient-to-r from-cyan-500/50 via-blue-500/50 to-violet-500/50' : 'bg-gradient-to-r from-blue-300 via-indigo-300 to-violet-300'}`} />\n\n          {/* Steps */}\n          <div className=\"relative flex justify-between\">\n            {steps.map((step, i) => {\n              const isHovered = hoveredStep === i;\n              const progress = i / Math.max(1, steps.length - 1);\n\n              return (\n                <motion.div\n                  key={i}\n                  initial={{ opacity: 0, y: 20 }}\n                  animate={{ opacity: 1, y: 0 }}\n                  transition={{ delay: i * 0.15 }}\n                  className=\"flex flex-col items-center\"\n                  style={{ width: `${100 / steps.length}%` }}\n                  onMouseEnter={() => setHoveredStep(i)}\n                  onMouseLeave={() => setHoveredStep(null)}\n                >\n                  {/* Node */}\n                  <motion.div\n                    animate={{ scale: isHovered ? 1.2 : 1 }}\n                    className={`relative z-10 w-12 h-12 rounded-full flex items-center justify-center cursor-pointer transition-all ${\n                      isRadar\n                        ? `bg-gradient-to-br from-cyan-500 to-blue-600 shadow-[0_0_${isHovered ? '20' : '10'}px_rgba(34,211,238,${isHovered ? '0.5' : '0.3'})]`\n                        : `bg-gradient-to-br from-blue-500 to-indigo-600 shadow-lg`\n                    }`}\n                    onClick={() => onStepClick?.(activeData?.id || '', i)}\n                  >\n                    <span className=\"text-white font-bold text-sm\">{i + 1}</span>\n                  </motion.div>\n\n                  {/* Label */}\n                  <motion.div\n                    animate={{ opacity: isHovered ? 1 : 0.7, y: isHovered ? 4 : 8 }}\n                    className={`mt-4 text-center max-w-[120px] ${isRadar ? 'text-slate-300' : 'text-stone-700'}`}\n                  >\n                    <p className=\"text-xs leading-tight\">{step}</p>\n                  </motion.div>\n\n                  {/* Arrow connector */}\n                  {i < steps.length - 1 && (\n                    <motion.div\n                      initial={{ opacity: 0, x: -10 }}\n                      animate={{ opacity: 1, x: 0 }}\n                      transition={{ delay: i * 0.15 + 0.1 }}\n                      className={`absolute top-5 left-[calc(50%+24px)] w-[calc(100%-48px)] flex items-center justify-center`}\n                    >\n                      <svg width=\"100%\" height=\"12\" className=\"overflow-visible\">\n                        <motion.path\n                          d={`M 0 6 L ${100}% 6`}\n                          stroke={isRadar ? 'rgba(34,211,238,0.5)' : 'rgba(99,102,241,0.5)'}\n                          strokeWidth={2}\n                          fill=\"none\"\n                          initial={{ pathLength: 0 }}\n                          animate={{ pathLength: 1 }}\n                          transition={{ delay: i * 0.2, duration: 0.5 }}\n                        />\n                      </svg>\n                    </motion.div>\n                  )}\n                </motion.div>\n              );\n            })}\n          </div>\n        </div>\n\n        {/* Impact indicator */}\n        <div className={`mt-8 p-3 rounded-lg ${isRadar ? 'bg-slate-800/50' : 'bg-stone-50'}`}>\n          <div className=\"flex items-center justify-between\">\n            <span className={`text-xs ${isRadar ? 'text-slate-400' : 'text-stone-500'}`}>Chain Complexity</span>\n            <div className=\"flex items-center gap-2\">\n              {[...Array(5)].map((_, i) => (\n                <motion.div\n                  key={i}\n                  initial={{ scale: 0 }}\n                  animate={{ scale: i < steps.length ? 1 : 0.5 }}\n                  transition={{ delay: 0.5 + i * 0.1 }}\n                  className={`w-2 h-2 rounded-full ${\n                    i < steps.length\n                      ? isRadar ? 'bg-cyan-400' : 'bg-indigo-500'\n                      : isRadar ? 'bg-slate-700' : 'bg-stone-300'\n                  }`}\n                />\n              ))}\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n","numLines":139,"startLine":1,"totalLines":139}}}
