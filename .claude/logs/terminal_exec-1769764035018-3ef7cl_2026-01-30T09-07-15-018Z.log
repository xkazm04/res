[2026-01-30T09:08:22.376Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TmVpePrSgcgSi3drB4ZV66","type":"tool_result","content":"     1→'use client';\n     2→\n     3→import { useEffect, useRef, useState } from 'react';\n     4→import { motion } from 'framer-motion';\n     5→import { useReportTheme } from '../core/ThemeContext';\n     6→\n     7→interface Node {\n     8→  id: string;\n     9→  label: string;\n    10→  type: 'finding' | 'source' | 'entity' | 'perspective';\n    11→  value: number; // 0-1 for sizing\n    12→  x?: number;\n    13→  y?: number;\n    14→}\n    15→\n    16→interface Edge {\n    17→  source: string;\n    18→  target: string;\n    19→  strength: number; // 0-1\n    20→  type?: 'supports' | 'contradicts' | 'references';\n    21→}\n    22→\n    23→interface NetworkGraphProps {\n    24→  nodes: Node[];\n    25→  edges: Edge[];\n    26→  onNodeClick?: (nodeId: string) => void;\n    27→  highlightedNode?: string;\n    28→}\n    29→\n    30→const typeColors = {\n    31→  finding: { radar: '#22d3ee', swiss: '#0ea5e9' },\n    32→  source: { radar: '#a78bfa', swiss: '#7c3aed' },\n    33→  entity: { radar: '#fb7185', swiss: '#e11d48' },\n    34→  perspective: { radar: '#34d399', swiss: '#059669' },\n    35→};\n    36→\n    37→export function NetworkGraph({ nodes, edges, onNodeClick, highlightedNode }: NetworkGraphProps) {\n    38→  const { theme } = useReportTheme();\n    39→  const containerRef = useRef<HTMLDivElement>(null);\n    40→  const [positions, setPositions] = useState<Map<string, { x: number; y: number }>>(new Map());\n    41→  const [hoveredNode, setHoveredNode] = useState<string | null>(null);\n    42→\n    43→  // Force-directed layout simulation\n    44→  useEffect(() => {\n    45→    if (!containerRef.current || nodes.length === 0) return;\n    46→\n    47→    const width = containerRef.current.offsetWidth;\n    48→    const height = containerRef.current.offsetHeight;\n    49→    const centerX = width / 2;\n    50→    const centerY = height / 2;\n    51→\n    52→    // Initialize positions in a circle\n    53→    const newPositions = new Map<string, { x: number; y: number }>();\n    54→    nodes.forEach((node, i) => {\n    55→      const angle = (i / nodes.length) * Math.PI * 2;\n    56→      const radius = Math.min(width, height) * 0.35;\n    57→      newPositions.set(node.id, {\n    58→        x: centerX + Math.cos(angle) * radius,\n    59→        y: centerY + Math.sin(angle) * radius,\n    60→      });\n    61→    });\n    62→\n    63→    // Simple force simulation\n    64→    const iterations = 50;\n    65→    for (let iter = 0; iter < iterations; iter++) {\n    66→      // Repulsion between all nodes\n    67→      nodes.forEach((nodeA) => {\n    68→        nodes.forEach((nodeB) => {\n    69→          if (nodeA.id === nodeB.id) return;\n    70→          const posA = newPositions.get(nodeA.id)!;\n    71→          const posB = newPositions.get(nodeB.id)!;\n    72→          const dx = posA.x - posB.x;\n    73→          const dy = posA.y - posB.y;\n    74→          const dist = Math.sqrt(dx * dx + dy * dy) || 1;\n    75→          const force = 1000 / (dist * dist);\n    76→          posA.x += (dx / dist) * force * 0.1;\n    77→          posA.y += (dy / dist) * force * 0.1;\n    78→        });\n    79→      });\n    80→\n    81→      // Attraction along edges\n    82→      edges.forEach((edge) => {\n    83→        const posA = newPositions.get(edge.source);\n    84→        const posB = newPositions.get(edge.target);\n    85→        if (!posA || !posB) return;\n    86→        const dx = posB.x - posA.x;\n    87→        const dy = posB.y - posA.y;\n    88→        const dist = Math.sqrt(dx * dx + dy * dy) || 1;\n    89→        const force = dist * 0.01 * edge.strength;\n    90→        posA.x += (dx / dist) * force;\n    91→        posA.y += (dy / dist) * force;\n    92→        posB.x -= (dx / dist) * force;\n    93→        posB.y -= (dy / dist) * force;\n    94→