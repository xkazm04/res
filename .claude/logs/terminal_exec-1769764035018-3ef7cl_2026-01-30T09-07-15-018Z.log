ng: { color: theme === 'radar' ? '#22d3ee' : '#0ea5e9', icon: '◆' },\n    event: { color: theme === 'radar' ? '#a78bfa' : '#7c3aed', icon: '●' },\n    prediction: { color: theme === 'radar' ? '#fbbf24' : '#d97706', icon: '◇' },\n  };\n\n  const isRadar = theme === 'radar';\n\n  return (\n    <div className={`relative p-4 rounded-xl ${isRadar ? 'bg-slate-900/60' : 'bg-stone-50'}`}>\n      {/* Header */}\n      <div className=\"flex items-center justify-between mb-4\">\n        <h4 className={`text-xs font-semibold uppercase tracking-wider ${styles.textMuted}`}>Timeline</h4>\n        <div className=\"flex gap-3 text-[10px]\">\n          {Object.entries(typeConfig).map(([type, config]) => (\n            <span key={type} className=\"flex items-center gap-1\" style={{ color: config.color }}>\n              {config.icon} {type}\n            </span>\n          ))}\n        </div>\n      </div>\n\n      {/* Timeline track */}\n      <div ref={containerRef} className=\"relative h-20\">\n        {/* Background track */}\n        <div className={`absolute top-1/2 left-0 right-0 h-0.5 -translate-y-1/2 ${isRadar ? 'bg-cyan-500/20' : 'bg-stone-300'}`}>\n          {/* Glow effect for radar */}\n          {isRadar && <div className=\"absolute inset-0 bg-cyan-400/30 blur-sm\" />}\n        </div>\n\n        {/* Date markers */}\n        <div className=\"absolute top-full left-0 right-0 flex justify-between pt-2 text-[10px]\" style={{ color: styles.textMuted }}>\n          <span>{sortedEvents[0].date.toLocaleDateString()}</span>\n          <span>{sortedEvents[sortedEvents.length - 1].date.toLocaleDateString()}</span>\n        </div>\n\n        {/* Events */}\n        {sortedEvents.map((event, i) => {\n          const pos = getPosition(event.date);\n          const config = typeConfig[event.type];\n          const isHovered = hoveredEvent === event.id;\n\n          return (\n            <motion.div\n              key={event.id}\n              initial={{ scale: 0, opacity: 0 }}\n              animate={{ scale: 1, opacity: 1 }}\n              transition={{ delay: i * 0.05, type: 'spring' }}\n              className=\"absolute top-1/2 -translate-y-1/2 cursor-pointer\"\n              style={{ left: `${pos}%` }}\n              onMouseEnter={() => setHoveredEvent(event.id)}\n              onMouseLeave={() => setHoveredEvent(null)}\n              onClick={() => onEventClick?.(event.id)}\n            >\n              {/* Event node */}\n              <motion.div\n                animate={{ scale: isHovered ? 1.5 : 1 }}\n                className=\"relative w-4 h-4 -ml-2 flex items-center justify-center text-xs\"\n                style={{\n                  color: config.color,\n                  filter: isHovered ? `drop-shadow(0 0 8px ${config.color})` : undefined,\n                }}\n              >\n                {config.icon}\n\n                {/* Confidence ring */}\n                {event.confidence !== undefined && (\n                  <svg className=\"absolute inset-0 w-full h-full -rotate-90\">\n                    <circle\n                      cx=\"8\" cy=\"8\" r=\"6\"\n                      fill=\"none\"\n                      stroke={config.color}\n                      strokeWidth=\"1\"\n                      strokeDasharray={`${event.confidence * 37.7} 37.7`}\n                      opacity={0.5}\n                    />\n                  </svg>\n                )}\n              </motion.div>\n\n              {/* Tooltip */}\n              {isHovered && (\n                <motion.div\n                  initial={{ opacity: 0, y: 5 }}\n                  animate={{ opacity: 1, y: 0 }}\n                  className={`absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 rounded text-[10px] whitespace-nowrap z-10 ${isRadar ? 'bg-slate-800 text-white' : 'bg-white text-stone-800 shadow-lg'}`}\n                >\n                  {event.label}\n                </motion.div>\n              )}\n            </motion.div>\n          );\n        })}\n      </div>\n    </div>\n  );\n}\n","numLines":132,"startLine":1,"totalLines":132}}}
