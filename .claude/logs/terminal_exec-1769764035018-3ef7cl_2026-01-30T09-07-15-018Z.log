ow-hidden`}\n    46→      style={{ transform: `translateX(${(1 - slideIn) * -100}%)` }}\n    47→    >\n    48→      <div className={`${isRadar ? 'bg-gradient-to-r from-cyan-600 to-blue-600' : 'bg-gradient-to-r from-stone-800 to-stone-700'} px-4 py-3 rounded-lg shadow-xl`}>\n    49→        <div className=\"flex items-center gap-3\">\n    50→          <div className={`w-1 h-10 ${isRadar ? 'bg-cyan-300' : 'bg-white'} rounded-full`} />\n    51→          <div>\n    52→            <h3 className=\"text-white font-bold text-lg\" style={{ opacity: titleFade }}>{title}</h3>\n    53→            {subtitle && <p className=\"text-white/70 text-sm\" style={{ opacity: subtitleFade }}>{subtitle}</p>}\n    54→          </div>\n    55→        </div>\n    56→      </div>\n    57→    </div>\n    58→  );\n    59→}\n    60→\n    61→interface MetricCardProps {\n    62→  label: string;\n    63→  value: number;\n    64→  suffix?: string;\n    65→  frame: number;\n    66→  fps: number;\n    67→  delay?: number;\n    68→  color?: 'cyan' | 'emerald' | 'amber' | 'rose';\n    69→  isRadar?: boolean;\n    70→}\n    71→\n    72→export function MetricCard({ label, value, suffix = '', frame, fps, delay = 0, color = 'cyan', isRadar = true }: MetricCardProps) {\n    73→  const scaleIn = spring({ frame, fps, delay, durationFrames: 20, easing: easeOutQuart });\n    74→  const countProgress = spring({ frame, fps, delay: delay + 5, durationFrames: 28, easing: easeOutCubic });\n    75→\n    76→  const colorClasses = {\n    77→    cyan: isRadar ? 'border-cyan-500/30 bg-cyan-500/10' : 'border-blue-200 bg-blue-50',\n    78→    emerald: isRadar ? 'border-emerald-500/30 bg-emerald-500/10' : 'border-emerald-200 bg-emerald-50',\n    79→    amber: isRadar ? 'border-amber-500/30 bg-amber-500/10' : 'border-amber-200 bg-amber-50',\n    80→    rose: isRadar ? 'border-rose-500/30 bg-rose-500/10' : 'border-rose-200 bg-rose-50',\n    81→  };\n    82→\n    83→  const textColors = {\n    84→    cyan: isRadar ? 'text-cyan-40