    49→    window.addEventListener('keydown', handleKeyDown);\n    50→    return () => window.removeEventListener('keydown', handleKeyDown);\n    51→  }, [toggle, reset, seekTo, frame, fps, durationInFrames]);\n    52→\n    53→  const formatTime = (f: number) => {\n    54→    const secs = Math.floor(f / fps);\n    55→    const mins = Math.floor(secs / 60);\n    56→    const remainingSecs = secs % 60;\n    57→    return `${mins}:${remainingSecs.toString().padStart(2, '0')}`;\n    58→  };\n    59→\n    60→  // Find current scene\n    61→  const currentSceneIndex = SCENES.reduce((acc, scene, i) => frame >= scene.start ? i : acc, 0);\n    62→\n    63→  // Mobile layout - compact controls\n    64→  if (isMobile) {\n    65→    return (\n    66→      <div className={`absolute bottom-0 left-0 right-0 ${isRadar ? 'bg-gradient-to-t from-slate-950 via-slate-950/95 to-transparent' : 'bg-gradient-to-t from-stone-200 via-stone-200/95 to-transparent'}`} style={{ paddingTop: 32 }}>\n    67→        <div className=\"px-3 pb-3\">\n    68→          {/* Minimal timeline */}\n    69→          <div className=\"mb-2\">\n    70→            <input\n    71→              type=\"range\"\n    72→              min={0}\n    73→              max={durationInFrames - 1}\n    74→              value={frame}\n    75→              onChange={e => seekTo(parseInt(e.target.value))}\n    76→              className=\"w-full h-1 rounded-full appearance-none cursor-pointer\"\n    77→              style={{\n    78→                background: `linear-gradient(to right, ${isRadar ? '#22d3ee' : '#57534e'} 0%, ${isRadar ? '#22d3ee' : '#57534e'} ${progress * 100}%, ${isRadar ? '#1e293b' : '#e7e5e4'} ${progress * 100}%, ${isRadar ? '#1e293b' : '#e7e5e4'} 100%)`\n    79→              }}\n    80→            />\n    81→          </div>\n    82→\n    83→          {/* Compact controls row */}\n    84→          <div className=\"flex items-center justify-between\">\n    85→            <div className=\"flex items-center gap-2