 35→              }`}\n    36→            >\n    37→              Chain {i + 1}\n    38→            </button>\n    39→          ))}\n    40→        </div>\n    41→      )}\n    42→\n    43→      {/* Flow visualization */}\n    44→      <div className=\"p-6\">\n    45→        <div className=\"relative\">\n    46→          {/* Connection line */}\n    47→          <div className={`absolute top-6 left-0 right-0 h-0.5 ${isRadar ? 'bg-gradient-to-r from-cyan-500/50 via-blue-500/50 to-violet-500/50' : 'bg-gradient-to-r from-blue-300 via-indigo-300 to-violet-300'}`} />\n    48→\n    49→          {/* Steps */}\n    50→          <div className=\"relative flex justify-between\">\n    51→            {steps.map((step, i) => {\n    52→              const isHovered = hoveredStep === i;\n    53→              const progress = i / Math.max(1, steps.length - 1);\n    54→\n    55→              return (\n    56→                <motion.div\n    57→                  key={i}\n    58→                  initial={{ opacity: 0, y: 20 }}\n    59→                  animate={{ opacity: 1, y: 0 }}\n    60→                  transition={{ delay: i * 0.15 }}\n    61→                  className=\"flex flex-col items-center\"\n    62→                  style={{ width: `${100 / steps.length}%` }}\n    63→                  onMouseEnter={() => setHoveredStep(i)}\n    64→                  onMouseLeave={() => setHoveredStep(null)}\n    65→                >\n    66→                  {/* Node */}\n    67→                  <motion.div\n    68→                    animate={{ scale: isHovered ? 1.2 : 1 }}\n    69→                    className={`relative z-10 w-12 h-12 rounded-full flex items-center justify-center cursor-pointer transition-all ${\n    70→                      isRadar\n    71→                        ? `bg-gradient-to-br from-cyan-500 to-blue-600 shadow-[0_0_${isHovered ? '20' : '10'}px_rgba(34,211,238,${isHovered ? '0.5' : '0.3'})]`\n    72→                        : `bg-gradient-to-br from-blue-500 to-indigo-600 shadow-lg`\n    73→                    }`}\n    74→                    onClick={() => onStepClick?.(activeData?.id || '', i)}\n    75→                  >\n    76→                    <span className=\"text-white font-bold text-sm\">{i + 1}</span>\n    77→                  </motion.div>\n    78→\n    79→                  {/* Label */}\n    80→                  <motion.div\n    81→                    animate={{ opacity: isHovered ? 1 : 0.7, y: isHovered ? 4 : 8 }}\n    82→                    className={`mt-4 text-center max-w-[120px] ${isRadar ? 'text-slate-300' : 'text-stone-700'}`}\n    83→                  >\n    84→                    <p className=\"text-xs leading-tight\">{step}</p>\n    85→                  </motion.div>\n    86→\n    87→                  {/* Arrow connector */}\n    88→                  {i < steps.length - 1 && (\n    89→                    <motion.div\n    90→                      initial={{ opacity: 0, x: -10 }}\n    91→                      animate={{ opacity: 1, x: 0 }}\n    92→                      transition={{ delay: i * 0.15 + 0.1 }}\n    93→                      className={`absolute top-5 left-[calc(50%+24px)] w-[calc(100%-48px)] flex items-center justify-center`}\n    94→                    >\n    95→                      <svg width=\"100%\" height=\"12\" className=\"overflow-visible\">\n    96→                        <motion.path\n    97→                          d={`M 0 6 L ${100}% 6`}\n    98→                          stroke={isRadar ? 'rgba(34,211,238,0.5)' : 'rgba(99,102,241,0.5)'}\n    99→                          strokeWidth={2}\n   100→                          fill=\"none\"\n   101→                          initial={{ pathLength: 0 }}\n   102→                          animate={{ pathLength: 1 }}\n   103→                          transition={{ delay: i * 0.2, duration: 0.5 }}\n   104→                        />\n   105→                      </svg>\n   106→                    </motion.div>\n   107→                  )}\n   108→                </motion.div>\n   109→              );\n   110→            })}\n   111→          </div>\n   112→        </div>\n   113→\n   114→        {/* Impact indicator */}\n   115→        <div className={`mt-8 p-3 rounded-lg ${isRadar ? 'bg-slate-800/50' : 'bg-stone-50'}`}>\n   116→          <div className=\"flex items-center justify-between\">\n   117→            <span className={`text-xs ${isRadar ? 'text-slate-400' : 'text-stone-500'}`}>Chain Complexity</span>\n   118→            <div className=\"flex items-center gap-2\">\n   119→              {[...Array(5)].map((_, i) => (\n   120→                <motion.div\n   121→                  key={i}\n   122→                  initial={{ scale: 0 }}\n   123→                  animate={{ scale: i < steps.length ? 1 : 0.5 }}\n   124→                  transition={{ delay: 0.5 + i * 0.1 }}\n   125→                  className={`w-2 h-2 rounded-full ${\n   126→                    i < steps.length\n   127→                      ? isRadar ? 'bg-cyan-400' : 'bg-indigo-500'\n   128→                      : isRadar ? 'bg-slate-700' : 'bg-stone-300'\n   129→                  }`}\n   130→                />\n   131→              ))}\n   132→            </div>\n   133→          </div>\n   134→        </div>\n   135→      </div>\n   136→    </div>\n   137→  );\n   138→}\n   139→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"56368c58-f692-49c5-b162-eafa9c314a50","uuid":"470178e1-61b9-470e-991e-3ee2731a2fa4","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\visualizations\\CausalFlow.tsx","content":"'use client';\n\nimport { useMemo, useState } from 'react';\nimport { motion } from 'framer-motion';\nimport { useReportTheme } from '../core/ThemeContext';\nimport type { CausalChain } from '@/src/types/research';\n\ninterface CausalFlowProps {\n  chains: CausalChain[];\n  onStepClick?: (chainId: string, stepIndex: number) => void;\n}\n\nexport function CausalFlow({ chains, onStepClick }: CausalFlowProps) {\n  const { theme } = useReportTheme();\n  const isRadar = theme === 'radar';\n  const [activeChain, setActiveChain] = useState<string | null>(chains[0]?.id || null);\n  const [hoveredStep, setHoveredStep] = useState<number | null>(null);\n\n  const activeData = chains.find(c => c.id === activeChain);\n  const steps = activeData?.descriptions || [];\n\n  return (\n    <div className={`rounded-xl overflow-hidden ${isRadar ? 'bg-slate-900/60 border border-cyan-500/10' : 'bg-white border border-stone-200'}`}>\n      {/* Chain selector */}\n      {chains.length > 1 && (\n        <div className={`flex gap-2 p-3 border-b ${isRadar ? 'border-cyan-500/10 bg-slate-950/50' : 'border-stone-200 bg-stone-50'}`}>\n          {chains.map((chain, i) => (\n            <button\n              key={chain.id}\n              onClick={() => setActiveChain(chain.id)}\n              className={`px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${\n                activeChain === chain.id\n                  ? isRadar ? 'bg-cyan-500/20 text-cyan-300' : 'bg-stone-800 text-white'\n                  : isRadar ? 'text-slate-400 hover:text-white' : 'text-stone-600 hover:text-stone-900'\n              }`}\n            >\n              Chain {i + 1}\n            </button>\n          ))}\n        </div>\n      )}\n\n      {/* Flow visualization */}\n      <div className=\"p-6\">\n        <div className=\"relative\">\n          {/* Connection line */}\n          <div className={`absolute top-6 left-0 right-0 h-0.5 ${isRadar ? 'bg-gradient-to-r from-cyan-500/50 via-blue-500/50 to-violet-500/50' : 'bg-gradient-to-r from-blue-300 via-indigo-300 to-violet-300'}`} />\n\n          {/* Steps */}\n          <div className=\"relative flex justify-between\">\n            {steps.map((step, i) => {\n              const isHovered = hoveredStep === i;\n              const progress = i / Math.max(1, steps.length - 1);\n\n              return (\n                <motion.div\n                  key={i}\n                  initial={{ opacity: 0, y: 20 }}\n                  animate={{ opacity: 1, y: 0 }}\n                  transition={{ delay: i * 0.15 }}\n                  className=\"flex flex-col items-center\"\n                  style={{ width: `${100 / steps.length}%` }}\n                  onMouseEnter={() => setHoveredStep(i)}\n                  onMouseLeave={() => setHoveredStep(null)}\n                >\n                  {/* Node */}\n                  <motion.div\n                    animate={{ scale: isHovered ? 1.2 : 1 }}\n                    className={`relative z-10 w-12 h-12 rounded-full flex items-center justify-center cursor-pointer transition-all ${\n                      isRadar\n                        ? `bg-gradient-to-br from-cyan-500 to-blue-600 shadow-[0_0_${isHovered ? '20' : '10'}px_rgba(34,211,238,${isHovered ? '0.5' : '0.3'})]`\n                        : `bg-gradient-to-br from-blue-500 to-indigo-600 shadow-lg`\n                    }`}\n                    onClick={() => onStepClick?.(activeData?.id || '', i)}\n                  >\n                    <span className=\"text-white font-bold text-sm\">{i + 1}</span>\n                  </motion.div>\n\n                  {/* Label */}\n                  <motion.div\n                    animate={{ opacity: isHovered ? 1 : 0.7, y: isHovered ? 4 : 8 }}\n                    className={`mt-4 text-center max-w-[120px] ${isRadar ? 'text-slate-300' : 'text-stone-700'}`}\n                  >\n                    <p className=\"text-xs leading-tight\">{step}</p>\n                  </motion.div>\n\n                  {/* Arrow connector */}\n   