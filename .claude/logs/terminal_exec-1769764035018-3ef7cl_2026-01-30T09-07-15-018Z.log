e=\"absolute inset-0 pointer-events-none\"\n   162→      style={{ backgroundColor: color, opacity: pulse * 0.1 }}\n   163→    />\n   164→  );\n   165→}\n   166→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"56368c58-f692-49c5-b162-eafa9c314a50","uuid":"61276cd0-c9f4-4fad-8f6b-80791e14c22f","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\video\\Transitions.tsx","content":"'use client';\n\nimport { spring, easeOutCubic, easeInOutCubic } from './useVideoPlayback';\n\n// Simple crossfade - no jarring wipes\ninterface CrossfadeProps {\n  frame: number;\n  fps: number;\n  fadeInFrames?: number;\n  fadeOutStart: number;\n  fadeOutFrames?: number;\n  children: React.ReactNode;\n}\n\nexport function Crossfade({ frame, fps, fadeInFrames = 15, fadeOutStart, fadeOutFrames = 15, children }: CrossfadeProps) {\n  const fadeIn = spring({ frame, fps, delay: 0, durationFrames: fadeInFrames, easing: easeOutCubic });\n  const fadeOut = frame >= fadeOutStart\n    ? 1 - spring({ frame: frame - fadeOutStart, fps, delay: 0, durationFrames: fadeOutFrames, easing: easeOutCubic })\n    : 1;\n\n  const opacity = Math.min(fadeIn, fadeOut);\n\n  return <div style={{ opacity }}>{children}</div>;\n}\n\n// Slide with fade - for elements entering from a direction\ninterface SlideProps {\n  frame: number;\n  fps: number;\n  direction?: 'left' | 'right' | 'up' | 'down';\n  delay?: number;\n  durationFrames?: number;\n  distance?: number;\n  children: React.ReactNode;\n}\n\nexport function Slide({ frame, fps, direction = 'up', delay = 0, durationFrames = 20, distance = 20, children }: SlideProps) {\n  const progress = spring({ frame, fps, delay, durationFrames, easing: easeOutCubic });\n\n  const transforms = {\n    left: `translateX(${(1 - progress) * -distance}px)`,\n    right: `translateX(${(1 - progress) * distance}px)`,\n    up: `translateY(${(1 - progress) * distance}px)`,\n    down: `translateY(${(1 - progress) * -distance}px)`,\n  };\n\n  return (\n    <div style={{ opacity: progress, transform: transforms[direction] }}>\n      {children}\n    </div>\n  );\n}\n\n// Scale with fade - for emphasis\ninterface ScaleProps {\n  frame: number;\n  fps: number;\n  delay?: number;\n  durationFrames?: number;\n  from?: number;\n  children: React.ReactNode;\n}\n\nexport function Scale({ frame, fps, delay = 0, durationFrames = 20, from = 0.85, children }: ScaleProps) {\n  const progress = spring({ frame, fps, delay, durationFrames, easing: easeOutCubic });\n\n  return (\n    <div style={{ opacity: progress, transform: `scale(${from + (1 - from) * progress})` }}>\n      {children}\n    </div>\n  );\n}\n\n// Staggered list items\ninterface StaggerProps {\n  frame: number;\n  fps: number;\n  delay?: number;\n  stagger?: number;\n  durationFrames?: number;\n  index: number;\n  direction?: 'left' | 'right' | 'up';\n  children: React.ReactNode;\n}\n\nexport function Stagger({ frame, fps, delay = 0, stagger = 5, durationFrames = 18, index, direction = 'right', children }: StaggerProps) {\n  const progress = spring({ frame, fps, delay: delay + index * stagger, durationFrames, easing: easeOutCubic });\n\n  const transforms = {\n    left: `translateX(${(1 - progress) * -20}px)`,\n    right: `translateX(${(1 - progress) * 20}px)`,\n    up: `translateY(${(1 - progress) * 15}px)`,\n  };\n\n  return (\n    <div style={{ opacity: progress, transform: transforms[direction] }}>\n      {children}\n    </div>\n  );\n}\n\n// Counter animation\ninterface CountUpProps {\n  value: number;\n  frame: number;\n  fps: number;\n  delay?: number;\n  durationFrames?: number;\n  decimals?: number;\n  suffix?: string;\n}\n\nexport function CountUp({ value, frame, fps, delay = 0, durationFrames = 30, decimals = 0, suffix = '' }: CountUpProps) {\n  const progress = spring({ frame, fps, delay, durationFrames, easing: easeOutCubic });\n  const current = value * progress;\n\n  return <>{current.toFixed(decimals)}{suffix}</>;\n}\n\n// Reveal mask - reveals content from a direction\ninterface RevealProps {\n  frame: number;\n  fps: number;\n  delay?: number;\n  durationFrames?: number;\n  direction?: 'left' | 'right' | 'up' | 'down';\n  children: React.ReactNode;\n}\n\nexport function Reveal({ frame, fps, delay = 0, durationFrames = 25, direction = 'left', children }: RevealProps) {\n  const progress = spring({ frame, fps, delay, durationFrames, easing: easeInOutCubic });\n\n  const clipPaths = {\n    left: `inset(0 ${(1 - progress) * 100}% 0 0)`,\n    right: `inset(0 0 0 ${(1 - progress) * 100}%)`,\n    up: `inset(${(1 - progress) * 100}% 0 0 0)`,\n    down: `inset(0 0 ${(1 - progress) * 100}% 0)`,\n  };\n\n  return (\n    <div style={{ clipPath: clipPaths[direction] }}>\n      {children}\n    </div>\n  );\n}\n\n// Background pulse effect\ninterface PulseProps {\n  frame: number;\n  fps: number;\n  intensity?: number;\n  color: string;\n}\n\nexport function Pulse({ frame, fps, intensity = 0.15, color }: PulseProps) {\n  const cycle = (frame / fps) * Math.PI * 2;\n  const pulse = Math.sin(cycle) * intensity + (1 - intensity);\n\n  return (\n    <div\n      className=\"absolute inset-0 pointer-events-none\"\n      style={{ backgroundColor: color, opacity: pulse * 0.1 }}\n    />\n  );\n}\n","numLines":166,"startLine":1,"totalLines":166}}}
