[2026-01-30T09:07:44.322Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016TvQLsZcMeSYjGzMTADbHd","type":"tool_result","content":"     1→\"\"\"Visualization components for rich HTML reports.\"\"\"\n     2→\n     3→from typing import Dict, Any, List, Optional, Tuple\n     4→import html as html_mod\n     5→import json\n     6→import math\n     7→\n     8→\n     9→class NetworkVisualization:\n    10→    \"\"\"Generate network graph visualizations for actor/relationship data.\"\"\"\n    11→\n    12→    # Node type color mapping\n    13→    NODE_COLORS = {\n    14→        \"core\": {\"bg\": \"#fff5f5\", \"border\": \"#e03131\", \"text\": \"#e03131\"},\n    15→        \"person\": {\"bg\": \"#fff5f5\", \"border\": \"#e03131\", \"text\": \"#e03131\"},\n    16→        \"financial\": {\"bg\": \"#fff9db\", \"border\": \"#f59f00\", \"text\": \"#b45309\"},\n    17→        \"finance\": {\"bg\": \"#fff9db\", \"border\": \"#f59f00\", \"text\": \"#b45309\"},\n    18→        \"political\": {\"bg\": \"#ebfbee\", \"border\": \"#2f9e44\", \"text\": \"#2f9e44\"},\n    19→        \"government\": {\"bg\": \"#ebfbee\", \"border\": \"#2f9e44\", \"text\": \"#2f9e44\"},\n    20→        \"intel\": {\"bg\": \"#f3f0ff\", \"border\": \"#7950f2\", \"text\": \"#7950f2\"},\n    21→        \"intelligence\": {\"bg\": \"#f3f0ff\", \"border\": \"#7950f2\", \"text\": \"#7950f2\"},\n    22→        \"corporate\": {\"bg\": \"#e7f5ff\", \"border\": \"#228be6\", \"text\": \"#228be6\"},\n    23→        \"organization\": {\"bg\": \"#e7f5ff\", \"border\": \"#228be6\", \"text\": \"#228be6\"},\n    24→        \"default\": {\"bg\": \"#f1f3f5\", \"border\": \"#adb5bd\", \"text\": \"#495057\"},\n    25→    }\n    26→\n    27→    # Relationship type styles\n    28→    EDGE_STYLES = {\n    29→        \"financial\": {\"color\": \"#f59f00\", \"width\": 3},\n    30→        \"personal\": {\"color\": \"#e03131\", \"width\": 2},\n    31→        \"professional\": {\"color\": \"#228be6\", \"width\": 2},\n    32→        \"political\": {\"color\": \"#2f9e44\", \"width\": 2},\n    33→        \"criminal\": {\"color\": \"#e03131\", \"width\": 3, \"dashed\": True},\n    34→        \"default\": {\"color\": \"#adb5bd\", \"width\": 1},\n    35→    }\n    36→\n    37→    @classmethod\n    38→    def extract_network_data(\n    39→        cls,\n    40→        findings: List[Dict[str, Any]],\n    41→    ) -> Tuple[List[Dict], List[Dict]]:\n    42→        \"\"\"Extract actors and relationships from findings.\"\"\"\n    43→        actors = []\n    44→        relationships = []\n    45→        actor_names = set()\n    46→\n    47→        for finding in findings:\n    48→            ftype = finding.get(\"finding_type\", \"\")\n    49→            extracted = finding.get(\"extracted_data\", {}) or {}\n    50→\n    51→            if ftype == \"actor\":\n    52→                name = extracted.get(\"name\", \"\")\n    53→                if not name and finding.get(\"summary\"):\n    54→                    # Try to extract name from summary\n    55→                    summary = finding.get(\"summary\", \"\")\n    56→                    if \" was \" in summary:\n    57→                        name = summary.split(\" was \")[0].strip()\n    58→                    elif \" is \" in summary:\n    59→                        name = summary.split(\" is \")[0].strip()\n    60→\n    61→                if name and name not in actor_names:\n    62→                    actor_names.add(name)\n    63→                    actors.append({\n    64→                        \"name\": name,\n    65→                        \"role\": extracted.get(\"role\", \"\"),\n    66→                        \"type\": cls._classify_actor_type(extracted, finding),\n    67→                        \"significance\": extracted.get(\"significance\", \"\"),\n    68→                        \"confidence\": finding.get(\"confidence_score\", 0.5),\n    69→                    })\n    70→\n    71→            elif ftype == \"relationship\":\n    72→                # Extract relationship data\n    73→                rel_type = extracted.get(\"type\", \"professional\")\n    74→                source = extracted.get(\"source\", extracted.get(\"actor1\", \"\"))\n    75→                target = extracted.get(\"target\", extracted.get(\"actor2\", \"\"))\n    76→\n    77→                if not source or not target:\n    78→                    # Try to parse from content\n    79→                    content = finding.get(\"content\", \"\")\n    80→                    if \" and \" in content:\n    81→                        parts = content.split(\" and \")\n    82→                        if len(parts) >= 2:\n    83→                            source = parts[0].split()[-1] if parts[0] else \"\"\n    84→                            target = parts[1].split()[0] if parts[1] else \"\"\n    85→\n    86→                if source and target:\n    87→                    relationships.append({\n    88→                        \"source\": source,\n    89→                        \"target\": target,\n    90→                        \"type\": rel_type,\n    91→                        \"description\": finding.get(\"summary\", \"\"),\n    92→                        \"confidence\": finding.get(\"confidence_score\", 0.5),\n    93→                    })\n    94→\n    95→        return actors, relationships\n    96→\n    97→    @classmethod\n    98→    def _classify_actor_type(cls, extracted: Dict, finding: Dict) -> str:\n    99→        \"\"\"Classify actor type based on extracted data.\"\"\"\n   100→        role = extracted.get(\"role\", \"\").lower()\n   101→        affiliations = extracted.get(\"affiliations\", \"\").lower()\n   102→        content = finding.get(\"content\", \"\").lower()\n   103→\n   104→        if any(kw in role + affiliations + content for kw in [\"bank\", \"fund\", \"financial\", \"investor\"]):\n   105→            return \"financial\"\n   106→        if any(kw in role + affiliations + content for kw in [\"senator\", \"governor\", \"president\", \"political\", \"government\"]):\n   107→            return \"political\"\n   108→        if any(kw in role + affiliations + content for kw in [\"cia\", \"fbi\", \"intelligence\", \"agent\"]):\n   109→            return \"intel\"\n   110→        if any(kw in role + affiliations + content for kw in [\"ceo\", \"coo\", \"founder\", \"executive\", \"company\"]):\n   111→            return \"corporate\"\n   112→        if any(kw in role + affiliations + content for kw in [\"central\", \"main\", \"primary\", \"key\"]):\n   113→            return \"core\"\n   114→\n   115→        return \"default\"\n   116→\n   117→    @classmethod\n   118→    def generate_network_html(\n   119→        cls,\n   120→        actors: List[Dict],\n   121→        relationships: List[Dict],\n   122→        width: int = 800,\n   123→        height: int = 500,\n   124→    ) -> str:\n   125→        \"\"\"Generate CSS-positioned network graph HTML.\"\"\"\n   126→        if not actors:\n   127→            return '<div class=\"empty-state\">No actor data available for network visualization</div>'\n   128→\n   129→        # Calculate node positions using circular layout\n   130→        positions = cls._calculate_positions(actors, width, height)\n   131→\n   132→        # Generate HTML\n   133→        html_parts = []\n   134→        html_parts.append(f'''\n   135→<div class=\"network-section\">\n   136→    <div class=\"network-container\" style=\"position: relative; width: 100%; height: {height}px; background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 6px; overflow: hidden;\">\n   137→''')\n   138→\n   139→        # Generate relationship lines first (behind nodes)\n   140→        for rel in relationships:\n   141→            source_pos = positions.get(rel[\"source\"])\n   142→            target_pos = positions.get(rel[\"target\"])\n   143→\n   144→            if source_pos and target_pos:\n   145→                style = cls.EDGE_STYLES.get(rel.get(\"type\", \"\"), cls.EDGE_STYLES[\"default\"])\n   146→                line_html = cls._generate_line_html(\n   147→                    source_pos, target_pos, style, rel.get(\"description\", \"\")\n   148→                )\n   149→                html_parts.append(line_html)\n   150→\n   151→        # Generate actor nodes\n   152→        for actor in actors:\n   153→            pos = positions.get(actor[\"name\"])\n   154→            if pos:\n   155→                colors = cls.NODE_COLORS.get(actor.get(\"type\", \"\"), cls.NODE_COLORS[\"default\"])\n   156→                node_html = cls._generate_node_html(actor, pos, colors)\n   157→                html_parts.append(node_html)\n   158→\n   159→        html_parts.append('    </div>')\n   160→\n   161→        # Generate legend\n   162→        html_parts.append(cls._generate_legend(actors))\n   163→\n   164→        html_parts.append('</div>')\n   165→\n   166→        return '\\n'.join(html_parts)\n   167→\n   168→    @classmethod\n   169→    def _calculate_positions(\n   170→        cls,\n   171→        actors: List[Dict],\n   172→        width: int,\n   173→        height: int,\n   174→    ) -> Dict[str, Tuple[int, int]]:\n   175→        \"\"\"Calculate node positions using circular layout with importance weighting.\"\"\"\n   176→        positions = {}\n   177→        n = len(actors)\n   178→        if n == 0:\n   179→            return positions\n   180→\n   181→        # Sort by confidence (importance)\n   182→        sorted_actors = sorted(actors, key=lambda a: a.get(\"confidence\", 0.5), reverse=True)\n   183→\n   184→        # Place most important in center, others in circle\n   185→        center_x = width // 2\n   186→        center_y = height // 2\n   187→        radius = min(width, height) * 0.35\n   188→\n   189→        for i, actor in enumerate(sorted_actors):\n   190→            if i == 0 and n > 3:\n   191→                # Most important actor in center\n   192→                positions[actor[\"name\"]] = (center_x, center_y)\n   193→            else:\n   194→                # Others in circle\n   195→                angle = (2 * math.pi * (i - 1 if n > 3 else i)) / (n - 1 if n > 3 else n)\n   196→                x = int(center_x + radius * math.cos(angle))\n   197→                y = int(center_y + radius * math.sin(angle))\n   198→                positions[actor[\"name\"]] = (x, y)\n   199→\n   200→        return positions\n   201→\n   202→    @classmethod\n   203→    def _generate_node_html(\n   204→        cls,\n   205→        actor: Dict,\n   206→        pos: Tuple[int, int],\n   207→        colors: Dict[str, str],\n   208→    ) -> str:\n   209→        \"\"\"Generate HTML for a single actor node.\"\"\"\n   210→        name = html_mod.escape(actor.get(\"name\", \"Unknown\"))\n   211→        role = html_mod.escape(actor.get(\"role\", \"\"))[:30]\n   212→        conf = actor.get(\"confidence\", 0.5)\n   213→\n   214→        x, y = pos\n   215→        return f'''\n   216→        <div class=\"network-node\" style=\"\n   217→            position: absolute;\n   218→            left: {x}px;\n   219→            top: {y}px;\n   220→            transform: translate(-50%, -50%);\n   221→            padding: 8px 12px;\n   222→            border-radius: 4px;\n   223→            font-size: 11px;\n   224→            font-weight: 600;\n   225→            white-space: nowrap;\n   226→            cursor: pointer;\n   227→            border: 2px solid {colors['border']};\n   228→            background: {colors['bg']};\n   229→            color: {colors['text']};\n   230→            z-index: 10;\n   231→            transition: transform 0.2s, box-shadow 0.2s;\n   232→        \" title=\"{role} (Confidence: {conf:.0%})\"\n   233→           onmouseover=\"this.style.transform='translate(-50%, -50%) scale(1.1)'; this.style.boxShadow='0 4px 12px rgba(0,0,0,0.15)';\"\n   234→           onmouseout=\"this.style.transform='translate(-50%, -50%)'; this.style.boxShadow='none';\">\n   235→            {name}\n   236→        </div>'''\n   237→\n   238→    @classmethod\n   239→    def _generate_line_html(\n   240→        cls,\n   241→        source_pos: Tuple[int, int],\n   242→        target_pos: Tuple[int, int],\n   243→        style: Dict[str, Any],\n   244→        description: str,\n   245→    ) -> str:\n   246→        \"\"\"Generate HTML/SVG for relationship line.\"\"\"\n   247→        x1, y1 = source_pos\n   248→        x2, y2 = target_pos\n   249→\n   250→        # Calculate line properties\n   251→        length = math.sqrt((x2 - x1) ** 2 + (y2 - y1) ** 2)\n   252→        angle = math.atan2(y2 - y1, x2 - x1) * 180 / math.pi\n   253→\n   254→        color = style.get(\"color\", \"#adb5bd\")\n   255→        width = style.get(\"width\", 1)\n   256→        dashed = \"5,5\" if style.get(\"dashed\") else \"\"\n   257→\n   258→        return f'''\n   259→        <svg style=\"position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1;\">\n   260→            <line x1=\"{x1}\" y1=\"{y1}\" x2=\"{x2}\" y2=\"{y2}\"\n   261→                  stroke=\"{color}\" stroke-width=\"{width}\" stroke-dasharray=\"{dashed}\"\n   262→                  opacity=\"0.6\">\n   263→                <title>{html_mod.escape(description)}</title>\n   264→            </line>\n   265→        </svg>'''\n   266→\n   267→    @classmethod\n   268→    def _generate_legend(cls, actors: List[Dict]) -> str:\n   269→        \"\"\"Generate legend showing node types present in the network.\"\"\"\n   270→        # Find unique types in the data\n   271→        types_present = set(a.get(\"type\", \"default\") for a in actors)\n   272→\n   273→        legend_items = []\n   274→        for node_type in types_present:\n   275→            colors = cls.NODE_COLORS.get(node_type, cls.NODE_COLORS[\"default\"])\n   276→            label = node_type.replace(\"_\", \" \").title()\n   277→            legend_items.append(f'''\n   278→            <div class=\"legend-item\" style=\"display: flex; align-items: center; gap: 6px;\">\n   279→                <div style=\"width: 12px; height: 12px; border-radius: 2px; background: {colors['bg']}; border: 2px solid {colors['border']};\"></div>\n   280→                <span style=\"font-size: 11px; color: #495057;\">{label}</span>\n   281→            </div>''')\n   282→\n   283→        return f'''\n   284→    <div class=\"network-legend\" style=\"display: flex; gap: 16px; margin-top: 12px; flex-wrap: wrap;\">\n   285→        {''.join(legend_items)}\n   286→    </div>'''\n   287→\n   288→\n   289→class TimelineVisualization:\n   290→    \"\"\"Generate parallel timeline visualizations.\"\"\"\n   291→\n   292→    STREAM_COLORS = {\n   293→        \"legal\": \"#e03131\",\n   294→        \"financial\": \"#f59f00\",\n   295→        \"public\": \"#228be6\",\n   296→        \"regulatory\": \"#2f9e44\",\n   297→        \"corporate\": \"#7950f2\",\n   298→        \"default\": \"#868e96\",\n   299→    }\n   300→\n   301→    @classmethod\n   302→    def extract_timeline_data(\n   303→        cls,\n   304→        findings: List[Dict[str, Any]],\n   305→    ) -> Dict[str, List[Dict]]:\n   306→        \"\"\"Extract and group events by stream/category.\"\"\"\n   307→        streams: Dict[str, List[Dict]] = {}\n   308→\n   309→        for finding in findings:\n   310→            ftype = finding.get(\"finding_type\", \"\")\n   311→            if ftype not in [\"event\", \"financial\"]:\n   312→                continue\n   313→\n   314→            extracted = finding.get(\"extracted_data\", {}) or {}\n   315→            event_date = finding.get(\"event_date\") or extracted.get(\"date\", \"\")\n   316→\n   317→            # Determine stream\n   318→            stream = cls._classify_stream(finding)\n   319→\n   320→            if stream not in streams:\n   321→                streams[stream] = []\n   322→\n   323→            streams[stream].append({\n   324→                \"date\": event_date,\n   325→                \"year\": cls._extract_year(event_date),\n   326→                \"summary\": finding.get(\"summary\", \"\")[:80],\n   327→                \"content\": finding.get(\"content\", \"\"),\n   328→                \"confidence\": finding.get(\"confidence_score\", 0.5),\n   329→                \"type\": ftype,\n   330→            })\n   331→\n   332→        # Sort events within each stream by date\n   333→        for stream in streams:\n   334→            streams[stream] = sorted(\n   335→                streams[stream],\n   336→                key=lambda e: e.get(\"date\", \"\") or e.get(\"year\", \"\"),\n   337→            )\n   338→\n   339→        return streams\n   340→\n   341→    @classmethod\n   342→    def _classify_stream(cls, finding: Dict) -> str:\n   343→        \"\"\"Classify event into a stream category.\"\"\"\n   344→        content = finding.get(\"content\", \"\").lower()\n   345→        summary = finding.get(\"summary\", \"\").lower()\n   346→        ftype = finding.get(\"finding_type\", \"\")\n   347→        text = content + \" \" + summary\n   348→\n   349→        if ftype == \"financial\" or any(kw in text for kw in [\"payment\", \"fund\", \"invest\", \"million\", \"billion\"]):\n   350→            return \"financial\"\n   351→        if any(kw in text for kw in [\"court\", \"trial\", \"lawsuit\", \"legal\", \"guilty\", \"sentence\"]):\n   352→            return \"legal\"\n   353→        if any(kw in text for kw in [\"sec\", \"fda\", \"regulatory\", \"compliance\", \"audit\"]):\n   354→            return \"regulatory\"\n   355→        if any(kw in text for kw in [\"public\", \"media\", \"press\", \"announce\", \"news\"]):\n   356→            return \"public\"\n   357→        if any(kw in text for kw in [\"company\", \"corporate\", \"ceo\", \"board\"]):\n   358→            return \"corporate\"\n   359→\n   360→        return \"default\"\n   361→\n   362→    @classmethod\n   363→    def _extract_year(cls, date_str: str) -> str:\n   364→        \"\"\"Extract year from date string.\"\"\"\n   365→        if not date_str:\n   366→            return \"\"\n   367→        # Handle various formats\n   368→        for fmt in [\"%Y-%m-%d\", \"%Y-%m\", \"%Y\", \"%B %Y\", \"%B %d, %Y\"]:\n   369→            try:\n   370→                from datetime import datetime\n   371→                dt = datetime.strptime(date_str[:10], fmt[:len(date_str[:10])])\n   372→                return str(dt.year)\n   373→            except (ValueError, IndexError):\n   374→                continue\n   375→        # Try to find 4-digit year\n   376→        import re\n   377→        match = re.search(r'(19|20)\\d{2}', date_str)\n   378→        if match:\n   379→            return match.group()\n   380→        return \"\"\n   381→\n   382→    @classmethod\n   383→    def generate_timeline_html(\n   384→        cls,\n   385→        streams: Dict[str, List[Dict]],\n   386→    ) -> str:\n   387→        \"\"\"Generate parallel timeline HTML.\"\"\"\n   388→        if not streams:\n   389→            return '<div class=\"empty-state\">No timeline data available</div>'\n   390→\n   391→        # Get all unique years\n   392→        all_years = set()\n   393→        for events in streams.values():\n   394→            for event in events:\n   395→                year = event.get(\"year\", \"\")\n   396→                if year:\n   397→                    all_years.add(year)\n   398→\n   399→        if not all_years:\n   400→            return '<div class=\"empty-state\">No dated events for timeline</div>'\n   401→\n   402→        years = sorted(all_years)\n   403→        stream_names = list(streams.keys())\n   404→\n   405→        # Build HTML\n   406→        html_parts = []\n   407→        html_parts.append('''\n   408→<div class=\"timeline-section\">\n   409→    <div class=\"parallel-timeline\" style=\"display: grid; grid-template-columns: 80px repeat(''' + str(len(stream_names)) + ''', 1fr); gap: 1px; background: #dee2e6; border: 1px solid #dee2e6; border-radius: 6px; overflow: hidden;\">\n   410→''')\n   411→\n   412→        # Header row\n   413→        html_parts.append('<div class=\"timeline-header\" style=\"background: #f1f3f5; padding: 10px 8px; font-size: 10px; font-weight: 600; text-transform: uppercase; text-align: center;\">Year</div>')\n   414→        for stream in stream_names:\n   415→            color = cls.STREAM_COLORS.get(stream, cls.STREAM_COLORS[\"default\"])\n   416→            html_parts.append(f'<div class=\"timeline-header\" style=\"background: #f1f3f5; padding: 10px 8px; font-size: 10px; font-weight: 600; text-transform: uppercase; text-align: center; color: {color};\">{stream.title()}</div>')\n   417→\n   418→        # Data rows by year\n   419→        for year in years:\n   420→            html_parts.append(f'<div class=\"timeline-year\" style=\"background: #f8f9fa; padding: 8px; font-weight: 600; font-size: 12px; text-align: center;\">{year}</div>')\n   421→\n   422→            for stream in stream_names:\n   423→                events = [e for e in streams.get(stream, []) if e.get(\"year\") == year]\n   424→                color = cls.STREAM_COLORS.get(stream, cls.STREAM_COLORS[\"default\"])\n   425→\n   426→                html_parts.append('<div class=\"timeline-cell\" style=\"background: #ffffff; padding: 8px; min-height: 60px; font-size: 11px;\">')\n   427→                for event in events:\n   428→                    html_parts.append(f'''\n   429→                    <div class=\"timeline-event\" style=\"padding: 4px 6px; border-radius: 3px; margin: 2px 0; font-size: 10px; line-height: 1.3; background: {color}15; border-left: 2px solid {color};\" title=\"{html_mod.escape(event.get('content', '')[:200])}\">\n   430→                        {html_mod.escape(event.get('summary', ''))}\n   431→                    </div>''')\n   432→                html_parts.append('</div>')\n   433→\n   434→        html_parts.append('    </div>')\n   435→\n   436→        # Legend\n   437→        html_parts.append('<div class=\"timeline-legend\" style=\"display: flex; gap: 16px; margin-top: 12px; flex-wrap: wrap;\">')\n   438→        for stream in stream_names:\n   439→            color = cls.STREAM_COLORS.get(stream, cls.STREAM_COLORS[\"default\"])\n   440→            html_parts.append(f'''\n   441→            <div style=\"display: flex; align-items: center; gap: 6px;\">\n   442→                <div style=\"width: 12px; height: 12px; border-radius: 2px; background: {color};\"></div>\n   443→                <span style=\"font-size: 11px; color: #495057;\">{stream.title()}</span>\n   444→            </div>''')\n   445→        html_parts.append('</div>')\n   446→\n   447→        html_parts.append('</div>')\n   448→\n   449→        return '\\n'.join(html_parts)\n   450→\n   451→\n   452→class MoneyFlowVisualization:\n   453→    \"\"\"Generate Sankey-style money flow diagrams.\"\"\"\n   454→\n   455→    @classmethod\n   456→    def extract_flow_data(\n   457→        cls,\n   458→        findings: List[Dict[str, Any]],\n   459→    ) -> List[Dict]:\n   460→        \"\"\"Extract financial flow data from findings.\"\"\"\n   461→        flows = []\n   462→\n   463→        for finding in findings:\n   464→            if finding.get(\"finding_type\") != \"financial\":\n   465→                continue\n   466→\n   467→            extracted = finding.get(\"extracted_data\", {}) or {}\n   468→            amount = extracted.get(\"amount\")\n   469→            payer = extracted.get(\"payer\", \"\")\n   470→            payee = extracted.get(\"payee\", \"\")\n   471→\n   472→            if amount and payer and payee:\n   473→                # Normalize amount to number\n   474→                if isinstance(amount, str):\n   475→                    amount = cls._parse_amount(amount)\n   476→\n   477→                flows.append({\n   478→                    \"source\": payer,\n   479→                    \"target\": payee,\n   480→                    \"amount\": amount,\n   481→                    \"type\": extracted.get(\"transaction_type\", \"payment\"),\n   482→                    \"date\": extracted.get(\"transaction_date\", \"\"),\n   483→                    \"purpose\": extracted.get(\"purpose\", \"\"),\n   484→                    \"confidence\": finding.get(\"confidence_score\", 0.5),\n   485→                })\n   486→\n   487→        # Sort by amount descending\n   488→        flows = sorted(flows, key=lambda f: f.get(\"amount\", 0) or 0, reverse=True)\n   489→        return flows\n   490→\n   491→    @classmethod\n   492→    def _parse_amount(cls, amount_str: str) -> float:\n   493→        \"\"\"Parse amount string to float.\"\"\"\n   494→        import re\n   495→        # Remove currency symbols and commas\n   496→        cleaned = re.sub(r'[,$]', '', str(amount_str))\n   497→        # Handle millions/billions\n   498→        multiplier = 1\n   499→        if 'million' in amount_str.lower() or 'm' in amount_str.lower():\n   500→            multiplier = 1_000_000\n   501→        elif 'billion' in amount_str.lower() or 'b' in amount_str.lower():\n   502→            multiplier = 1_000_000_000\n   503→\n   504→        try:\n   505→            base = float(re.search(r'[\\d.]+', cleaned).group())\n   506→            return base * multiplier\n   507→        except (AttributeError, ValueError):\n   508→            return 0\n   509→\n   510→    @classmethod\n   511→    def generate_flow_html(\n   512→        cls,\n   513→        flows: List[Dict],\n   514→        max_flows: int = 10,\n   515→    ) -> str:\n   516→        \"\"\"Generate Sankey-style money flow HTML.\"\"\"\n   517→        if not flows:\n   518→            return '<div class=\"empty-state\">No financial flow data available</div>'\n   519→\n   520→        flows = flows[:max_flows]\n   521→        max_amount = max(f.get(\"amount\", 0) or 1 for f in flows)\n   522→\n   523→        html_parts = []\n   524→        html_parts.append('''\n   525→<div class=\"flow-section\">\n   526→    <div class=\"flow-container\" style=\"background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 6px; padding: 20px;\">\n   527→''')\n   528→\n   529→        for flow in flows:\n   530→            amount = flow.get(\"amount\", 0) or 0\n   531→            # Calculate relative width (min 20%, max 100%)\n   532→            width_pct = max(20, min(100, (amount / max_amount) * 100))\n   533→\n   534→            # Determine thickness class\n   535→            thickness = \"thick\" if width_pct > 60 else \"medium\" if width_pct > 30 else \"thin\"\n   536→            line_height = 12 if thickness == \"thick\" else 8 if thickness == \"medium\" else 4\n   537→\n   538→            source = html_mod.escape(flow.get(\"source\", \"Unknown\"))\n   539→            target = html_mod.escape(flow.get(\"target\", \"Unknown\"))\n   540→            amount_str = cls._format_amount(amount)\n   541→            purpose = html_mod.escape(flow.get(\"purpose\", \"\")[:50])\n   542→\n   543→            html_parts.append(f'''\n   544→        <div class=\"flow-row\" style=\"display: flex; align-items: center; margin: 16px 0;\" title=\"{purpose}\">\n   545→            <div class=\"flow-source\" style=\"width: 160px; padding: 10px; border-radius: 4px; font-size: 11px; font-weight: 600; text-align: center; background: #e7f5ff; color: #228be6;\">\n   546→                {source}\n   547→            </div>\n   548→            <div class=\"flow-line\" style=\"flex: 1; margin: 0 12px; position: relative;\">\n   549→                <div class=\"flow-amount\" style=\"position: absolute; top: -18px; left: 50%; transform: translateX(-50%); font-size: 11px; font-weight: 700; white-space: nowrap; color: #495057;\">\n   550→                    {amount_str}\n   551→                </div>\n   552→                <div class=\"flow-line-inner\" style=\"height: {line_height}px; background: linear-gradient(90deg, #228be6, #e03131); border-radius: 4px; width: {width_pct}%;\"></div>\n   553→            </div>\n   554→            <div class=\"flow-target\" style=\"width: 160px; padding: 10px; border-radius: 4px; font-size: 11px; font-weight: 600; text-align: center; background: #fff5f5; color: #e03131;\">\n   555→                {target}\n   556→            </div>\n   557→        </div>''')\n   558→\n   559→        html_parts.append('    </div>')\n   560→\n   561→        # Summary\n   562→        total = sum(f.get(\"amount\", 0) or 0 for f in flows)\n   563→        html_parts.append(f'''\n   564→    <div class=\"flow-summary\" style=\"margin-top: 12px; font-size: 12px; color: #495057;\">\n   565→        <strong>Total tracked:</strong> {cls._format_amount(total)} across {len(flows)} transactions\n   566→    </div>\n   567→</div>''')\n   568→\n   569→        return '\\n'.join(html_parts)\n   570→\n   571→    @classmethod\n   572→    def _format_amount(cls, amount: float) -> str:\n   573→        \"\"\"Format amount for display.\"\"\"\n   574→        if amount >= 1_000_000_000:\n   575→            return f\"${amount / 1_000_000_000:.1f}B\"\n   576→        if amount >= 1_000_000:\n   577→            return f\"${amount / 1_000_000:.1f}M\"\n   578→        if amount >= 1_000:\n   579→            return f\"${amount / 1_000:.1f}K\"\n   580→        return f\"${amount:,.0f}\"\n   581→\n   582→\n   583→class StakeholderImpactMatrix:\n   584→    \"\"\"Generate stakeholder impact analysis matrix.\"\"\"\n   585→\n   586→    # Impact level colors\n   587→    IMPACT_COLORS = {\n   588→        \"positive\": {\"bg\": \"#d1fae5\", \"text\": \"#065f46\", \"symbol\": \"+\"},\n   589→        \"negative\": {\"bg\": \"#fee2e2\", \"text\": \"#991b1b\", \"symbol\": \"-\"},\n   590→        \"neutral\": {\"bg\": \"#f1f5f9\", \"text\": \"#64748b\", \"symbol\": \"~\"},\n   591→        \"mixed\": {\"bg\": \"#fef3c7\", \"text\": \"#92400e\", \"symbol\": \"±\"},\n   592→    }\n   593→\n   594→    # Common stakeholder categories\n   595→    STAKEHOLDER_CATEGORIES = [\n   596→        \"investors\", \"customers\", \"employees\", \"regulators\",\n   597→        \"competitors\", \"partners\", \"suppliers\", \"public\"\n   598→    ]\n   599→\n   600→    @classmethod\n   601→    def extract_stakeholders(cls, findings: List[Dict], perspectives: List[Dict]) -> List[str]:\n   602→        \"\"\"Extract stakeholder groups from findings and perspectives.\"\"\"\n   603→        stakeholders = set()\n   604→\n   605→        # Extract from findings\n   606→        for f in findings:\n   607→            content = (f.get(\"content\", \"\") + \" \" + f.get(\"summary\", \"\")).lower()\n   608→            for category in cls.STAKEHOLDER_CATEGORIES:\n   609→                if category in content or category[:-1] in content:  # \"investor\" or \"investors\"\n   610→                    stakeholders.add(category.title())\n   611→\n   612→            # Also check extracted_data\n   613→            extracted = f.get(\"extracted_data\", {}) or {}\n   614→            if extracted.get(\"stakeholders\"):\n   615→                for s in extracted.get(\"stakeholders\", []):\n   616→                    stakeholders.add(s.title() if isinstance(s, str) else str(s))\n   617→\n   618→        # Extract from perspective warnings/recommendations\n   619→        for p in perspectives:\n   620→            recommendations = p.get(\"recommendations\", [])\n   621→            for rec in recommendations:\n   622→                rec_lower = rec.lower() if isinstance(rec, str) else \"\"\n   623→                for category in cls.STAKEHOLDER_CATEGORIES:\n   624→                    if category in rec_lower:\n   625→                        stakeholders.add(category.title())\n   626→\n   627→        # Ensure we have at least some stakeholders\n   628→        if not stakeholders:\n   629→            stakeholders = {\"Investors\", \"Customers\", \"Regulators\"}\n   630→\n   631→        return sorted(list(stakeholders))[:6]  # Max 6 stakeholders\n   632→\n   633→    @classmethod\n   634→    def analyze_impacts(\n   635→        cls,\n   636→        findings: List[Dict],\n   637→        stakeholders: List[str],\n   638→    ) -> List[Dict]:\n   639→        \"\"\"Analyze impact of key findings on each stakeholder group.\"\"\"\n   640→        # Get top findings by confidence\n   641→        key_findings = sorted(\n   642→            findings,\n   643→            key=lambda f: f.get(\"confidence_score\", 0.5),\n   644→            reverse=True\n   645→        )[:8]\n   646→\n   647→        impact_data = []\n   648→        for finding in key_findings:\n   649→            summary = finding.get(\"summary\", \"\") or finding.get(\"content\", \"\")[:200]\n   650→            content = finding.get(\"content\", \"\").lower()\n   651→            ftype = finding.get(\"finding_type\", \"\")\n   652→\n   653→            impacts = {}\n   654→            for stakeholder in stakeholders:\n   655→                stakeholder_lower = stakeholder.lower()\n   656→                # Simple heuristic-based impact analysis\n   657→                impact = cls._determine_impact(content, ftype, stakeholder_lower)\n   658→                impacts[stakeholder] = impact\n   659→\n   660→            impact_data.append({\n   661→                \"summary\": summary,\n   662→                \"type\": ftype,\n   663→                \"impacts\": impacts,\n   664→            })\n   665→\n   666→        return impact_data\n   667→\n   668→    @classmethod\n   669→    def _determine_impact(cls, content: str, finding_type: str, stakeholder: str) -> str:\n   670→        \"\"\"Determine impact on stakeholder based on content and type.\"\"\"\n   671→        # Negative indicators\n   672→        negative_words = [\"loss\", \"decline\", \"risk\", \"threat\", \"penalty\", \"fine\", \"lawsuit\", \"violation\"]\n   673→        positive_words = [\"growth\", \"gain\", \"opportunity\", \"benefit\", \"improve\", \"increase\", \"success\"]\n   674→\n   675→        has_negative = any(word in content for word in negative_words)\n   676→        has_positive = any(word in content for word in positive_words)\n   677→        mentions_stakeholder = stakeholder in content or stakeholder[:-1] in content\n   678→\n   679→        if finding_type in [\"red_flag\", \"suspicious_element\"]:\n   680→            if stakeholder in [\"investors\", \"customers\", \"regulators\"]:\n   681→                return \"negative\"\n   682→\n   683→        if has_positive and has_negative:\n   684→            return \"mixed\"\n   685→        if has_negative:\n   686→            return \"negative\" if mentions_stakeholder else \"neutral\"\n   687→        if has_positive:\n   688→            return \"positive\" if mentions_stakeholder else \"neutral\"\n   689→\n   690→        return \"neutral\"\n   691→\n   692→    @classmethod\n   693→    def generate_matrix_html(\n   694→        cls,\n   695→        impact_data: List[Dict],\n   696→        stakeholders: List[str],\n   697→    ) -> str:\n   698→        \"\"\"Generate stakeholder impact matrix HTML.\"\"\"\n   699→        if not impact_data or not stakeholders:\n   700→            return '<div class=\"empty-state\">No stakeholder impact data available</div>'\n   701→\n   702→        html_parts = []\n   703→        html_parts.append('''\n   704→<div class=\"impact-matrix-section\">\n   705→    <style>\n   706→        .impact-matrix { width: 100%; border-collapse: collapse; font-size: 12px; }\n   707→        .impact-matrix th { background: #f1f3f5; padding: 8px 6px; text-align: center; font-weight: 600; border: 1px solid #dee2e6; }\n   708→        .impact-matrix th.finding-col { text-align: left; min-width: 280px; max-width: 400px; }\n   709→        .impact-matrix td { padding: 8px 6px; text-align: center; border: 1px solid #dee2e6; }\n   710→        .impact-matrix td.finding-cell { text-align: left; font-size: 11px; line-height: 1.4; word-wrap: break-word; max-width: 400px; }\n   711→        .impact-cell { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 4px; font-weight: 700; font-size: 14px; }\n   712→        .impact-legend { display: flex; gap: 16px; margin-top: 12px; font-size: 11px; flex-wrap: wrap; }\n   713→        .legend-item { display: flex; align-items: center; gap: 6px; }\n   714→    </style>\n   715→    <table class=\"impact-matrix\">\n   716→        <thead>\n   717→            <tr>\n   718→                <th class=\"finding-col\">Key Finding</th>\n   719→''')\n   720→\n   721→        # Header row with stakeholders\n   722→        for stakeholder in stakeholders:\n   723→            html_parts.append(f'                <th>{html_mod.escape(stakeholder)}</th>\\n')\n   724→        html_parts.append('            </tr>\\n        </thead>\\n        <tbody>\\n')\n   725→\n   726→        # Data rows\n   727→        for row in impact_data:\n   728→            html_parts.append(f'            <tr>\\n')\n   729→            html_parts.append(f'                <td class=\"finding-cell\">{html_mod.escape(row[\"summary\"])}</td>\\n')\n   730→\n   731→            for stakeholder in stakeholders:\n   732→                impact = row[\"impacts\"].get(stakeholder, \"neutral\")\n   733→                colors = cls.IMPACT_COLORS.get(impact, cls.IMPACT_COLORS[\"neutral\"])\n   734→                html_parts.append(\n   735→                    f'                <td><span class=\"impact-cell\" style=\"background:{colors[\"bg\"]};color:{colors[\"text\"]};\">'\n   736→                    f'{colors[\"symbol\"]}</span></td>\\n'\n   737→                )\n   738→\n   739→            html_parts.append('            </tr>\\n')\n   740→\n   741→        html_parts.append('        </tbody>\\n    </table>\\n')\n   742→\n   743→        # Legend\n   744→        html_parts.append('    <div class=\"impact-legend\">\\n')\n   745→        for impact_type, colors in cls.IMPACT_COLORS.items():\n   746→            html_parts.append(\n   747→                f'        <div class=\"legend-item\">'\n   748→                f'<span class=\"impact-cell\" style=\"background:{colors[\"bg\"]};color:{colors[\"text\"]};width:20px;height:20px;font-size:12px;\">'\n   749→                f'{colors[\"symbol\"]}</span>{impact_type.title()}</div>\\n'\n   750→            )\n   751→        html_parts.append('    </div>\\n</div>')\n   752→\n   753→        return ''.join(html_parts)\n   754→\n   755→\n   756→class PredictionTimeline:\n   757→    \"\"\"Generate prediction timeline visualization grouped by timeframe.\"\"\"\n   758→\n   759→    TIMEFRAME_ORDER = [\"immediate\", \"q1\", \"q2\", \"q3\", \"q4\", \"2025\", \"2026\", \"long-term\"]\n   760→\n   761→    @classmethod\n   762→    def group_predictions_by_timeline(cls, perspectives: List[Dict]) -> Dict[str, List[Dict]]:\n   763→        \"\"\"Group predictions by their timeline/timeframe.\"\"\"\n   764→        grouped: Dict[str, List[Dict]] = {}\n   765→\n   766→        for p in perspectives:\n   767→            predictions = p.get(\"predictions\", [])\n   768→            perspective_type = p.get(\"perspective_type\", \"unknown\")\n   769→\n   770→            for pred in predictions:\n   771→                if isinstance(pred, dict):\n   772→                    timeline = pred.get(\"timeline\", \"\").lower() if pred.get(\"timeline\") else \"unspecified\"\n   773→                    prediction_text = pred.get(\"prediction\", \"\")\n   774→                    confidence = pred.get(\"confidence\", \"medium\")\n   775→                else:\n   776→                    timeline = \"unspecified\"\n   777→                    prediction_text = str(pred)\n   778→                    confidence = \"medium\"\n   779→\n   780→                # Normalize timeline to standard categories\n   781→                normalized_timeline = cls._normalize_timeline(timeline)\n   782→\n   783→                if normalized_timeline not in grouped:\n   784→                    grouped[normalized_timeline] = []\n   785→\n   786→                grouped[normalized_timeline].append({\n   787→                    \"text\": prediction_text,\n   788→                    \"confidence\": confidence if isinstance(confidence, str) else (\n   789→                        \"high\" if confidence >= 0.8 else \"medium\" if confidence >= 0.5 else \"low\"\n   790→                    ),\n   791→                    \"source\": perspective_type,\n   792→                    \"rationale\": pred.get(\"rationale\", \"\") if isinstance(pred, dict) else \"\",\n   793→                })\n   794→\n   795→        return grouped\n   796→\n   797→    @classmethod\n   798→    def _normalize_timeline(cls, timeline: str) -> str:\n   799→        \"\"\"Normalize timeline string to standard category.\"\"\"\n   800→        if not timeline:\n   801→            return \"Unspecified\"\n   802→\n   803→        timeline_lower = timeline.lower()\n   804→\n   805→        if any(term in timeline_lower for term in [\"immediate\", \"now\", \"current\"]):\n   806→            return \"Immediate\"\n   807→        if \"q1\" in timeline_lower or \"quarter 1\" in timeline_lower:\n   808→            return \"Q1\"\n   809→        if \"q2\" in timeline_lower or \"quarter 2\" in timeline_lower:\n   810→            return \"Q2\"\n   811→        if \"q3\" in timeline_lower or \"quarter 3\" in timeline_lower:\n   812→            return \"Q3\"\n   813→        if \"q4\" in timeline_lower or \"quarter 4\" in timeline_lower:\n   814→            return \"Q4\"\n   815→        if \"2025\" in timeline_lower:\n   816→            return \"2025\"\n   817→        if \"2026\" in timeline_lower:\n   818→            return \"2026\"\n   819→        if any(term in timeline_lower for term in [\"long\", \"future\", \"years\"]):\n   820→            return \"Long-term\"\n   821→        if any(term in timeline_lower for term in [\"month\", \"near\"]):\n   822→            return \"Near-term\"\n   823→\n   824→        return timeline.title()[:20]\n   825→\n   826→    @classmethod\n   827→    def generate_timeline_html(cls, grouped_predictions: Dict[str, List[Dict]]) -> str:\n   828→        \"\"\"Generate prediction timeline HTML.\"\"\"\n   829→        if not grouped_predictions:\n   830→            return '<div class=\"empty-state\">No predictions available</div>'\n   831→\n   832→        # Sort timelines\n   833→        sorted_timelines = sorted(\n   834→            grouped_predictions.keys(),\n   835→            key=lambda t: cls.TIMEFRAME_ORDER.index(t.lower()) if t.lower() in cls.TIMEFRAME_ORDER else 99\n   836→        )\n   837→\n   838→        html_parts = []\n   839→        html_parts.append('''\n   840→<div class=\"prediction-timeline\">\n   841→    <style>\n   842→        .pred-timeline-row { display: flex; margin-bottom: 24px; }\n   843→        .pred-timeline-label { width: 100px; flex-shrink: 0; font-weight: 600; font-size: 12px; color: #6366f1; padding-top: 4px; }\n   844→        .pred-timeline-items { flex: 1; display: flex; flex-wrap: wrap; gap: 8px; }\n   845→        .pred-timeline-card { background: linear-gradient(135deg, #f0f9ff, #e0f2fe); border: 1px solid #bae6fd; border-radius: 6px; padding: 10px 12px; max-width: 300px; }\n   846→        .pred-timeline-text { font-size: 12px; color: #1e293b; margin-bottom: 6px; line-height: 1.4; }\n   847→        .pred-timeline-meta { display: flex; gap: 8px; align-items: center; font-size: 10px; }\n   848→        .pred-source { color: #6b7280; }\n   849→        .pred-conf { padding: 2px 6px; border-radius: 4px; font-weight: 600; }\n   850→        .pred-conf-high { background: #d1fae5; color: #065f46; }\n   851→        .pred-conf-medium { background: #fef3c7; color: #92400e; }\n   852→        .pred-conf-low { background: #f1f5f9; color: #64748b; }\n   853→    </style>\n   854→''')\n   855→\n   856→        for timeline in sorted_timelines:\n   857→            predictions = grouped_predictions[timeline]\n   858→            html_parts.append(f'    <div class=\"pred-timeline-row\">\\n')\n   859→            html_parts.append(f'        <div class=\"pred-timeline-label\">{html_mod.escape(timeline)}</div>\\n')\n   860→            html_parts.append('        <div class=\"pred-timeline-items\">\\n')\n   861→\n   862→            for pred in predictions[:4]:  # Max 4 per timeline\n   863→                conf_class = f\"pred-conf-{pred['confidence']}\"\n   864→                html_parts.append(f'''            <div class=\"pred-timeline-card\">\n   865→                <div class=\"pred-timeline-text\">{html_mod.escape(pred[\"text\"][:150])}</div>\n   866→                <div class=\"pred-timeline-meta\">\n   867→                    <span class=\"pred-source\">{html_mod.escape(pred[\"source\"].replace(\"_\", \" \").title())}</span>\n   868→                    <span class=\"pred-conf {conf_class}\">{pred[\"confidence\"].upper()}</span>\n   869→                </div>\n   870→            </div>\\n''')\n   871→\n   872→            html_parts.append('        </div>\\n    </div>\\n')\n   873→\n   874→        html_parts.append('</div>')\n   875→\n   876→        return ''.join(html_parts)\n   877→\n   878→\n   879→class FinancialTables:\n   880→    \"\"\"Generate financial data tables for earnings, valuations, and metrics.\"\"\"\n   881→\n   882→    @classmethod\n   883→    def extract_financial_metrics(cls, findings: List[Dict]) -> Dict[str, List[Dict]]:\n   884→        \"\"\"Extract financial metrics from findings.\"\"\"\n   885→        metrics = {\n   886→            \"earnings\": [],\n   887→            \"revenue\": [],\n   888→            \"margins\": [],\n   889→            \"valuations\": [],\n   890→            \"other\": [],\n   891→        }\n   892→\n   893→        for f in findings:\n   894→            if f.get(\"finding_type\") != \"financial\":\n   895→                continue\n   896→\n   897→            extracted = f.get(\"extracted_data\", {}) or {}\n   898→            metric_type = extracted.get(\"metric_type\", \"\").lower()\n   899→            content = f.get(\"content\", \"\").lower()\n   900→\n   901→            metric_entry = {\n   902→                \"period\": extracted.get(\"period\", extracted.get(\"quarter\", \"\")),\n   903→                \"value\": extracted.get(\"amount\", extracted.get(\"value\", \"\")),\n   904→                \"company\": extracted.get(\"company\", extracted.get(\"entity\", \"\")),\n   905→                \"comparison\": extracted.get(\"comparison\", \"\"),\n   906→                \"change\": extracted.get(\"change\", extracted.get(\"growth\", \"\")),\n   907→                \"confidence\": f.get(\"confidence_score\", 0.5),\n   908→            }\n   909→\n   910→            if any(term in metric_type + content for term in [\"eps\", \"earning\", \"profit\", \"income\"]):\n   911→                metrics[\"earnings\"].append(metric_entry)\n   912→            elif any(term in metric_type + content for term in [\"revenue\", \"sales\", \"top line\"]):\n   913→                metrics[\"revenue\"].append(metric_entry)\n   914→            elif any(term in metric_type + content for term in [\"margin\", \"gross\", \"operating\"]):\n   915→                metrics[\"margins\"].append(metric_entry)\n   916→            elif any(term in metric_type + content for term in [\"p/e\", \"valuation\", \"multiple\", \"ev\"]):\n   917→                metrics[\"valuations\"].append(metric_entry)\n   918→            else:\n   919→                metrics[\"other\"].append(metric_entry)\n   920→\n   921→        return metrics\n   922→\n   923→    @classmethod\n   924→    def generate_financial_table_html(cls, metrics: Dict[str, List[Dict]]) -> str:\n   925→        \"\"\"Generate HTML tables for financial metrics.\"\"\"\n   926→        if not any(metrics.values()):\n   927→            return '<div class=\"empty-state\">No financial metrics data available</div>'\n   928→\n   929→        html_parts = []\n   930→        html_parts.append('''\n   931→<div class=\"financial-tables\">\n   932→    <style>\n   933→        .fin-table { width: 100%; border-collapse: collapse; font-size: 11px; margin-bottom: 16px; }\n   934→        .fin-table th { background: #f1f3f5; padding: 8px 10px; text-align: left; font-weight: 600; border: 1px solid #dee2e6; }\n   935→        .fin-table td { padding: 8px 10px; border: 1px solid #dee2e6; }\n   936→        .fin-table tr:nth-child(even) { background: #f8f9fa; }\n   937→        .fin-section-title { font-weight: 600; color: #1e293b; font-size: 13px; margin: 12px 0 8px; }\n   938→        .fin-value { font-weight: 600; color: #1e293b; }\n   939→        .fin-change-positive { color: #059669; }\n   940→        .fin-change-negative { color: #dc2626; }\n   941→    </style>\n   942→''')\n   943→\n   944→        for category, items in metrics.items():\n   945→            if not items:\n   946→                continue\n   947→\n   948→            html_parts.append(f'    <div class=\"fin-section-title\">{category.title()}</div>\\n')\n   949→            html_parts.append('    <table class=\"fin-table\">\\n')\n   950→            html_parts.append('        <thead><tr><th>Company</th><th>Period</th><th>Value</th><th>Change</th></tr></thead>\\n')\n   951→            html_parts.append('        <tbody>\\n')\n   952→\n   953→            for item in items[:8]:\n   954→                company = html_mod.escape(str(item.get(\"company\", \"N/A\"))[:30])\n   955→                period = html_mod.escape(str(item.get(\"period\", \"N/A\"))[:20])\n   956→                value = html_mod.escape(str(item.get(\"value\", \"N/A\"))[:20])\n   957→                change = str(item.get(\"change\", \"\"))\n   958→                change_class = \"fin-change-positive\" if \"+\" in change or \"up\" in change.lower() else \\\n   959→                              \"fin-change-negative\" if \"-\" in change or \"down\" in change.lower() else \"\"\n   960→\n   961→                html_parts.append(f'            <tr>\\n')\n   962→                html_parts.append(f'                <td>{company}</td>\\n')\n   963→                html_parts.append(f'                <td>{period}</td>\\n')\n   964→                html_parts.append(f'                <td class=\"fin-value\">{value}</td>\\n')\n   965→                html_parts.append(f'                <td class=\"{change_class}\">{html_mod.escape(change[:20])}</td>\\n')\n   966→                html_parts.append(f'            </tr>\\n')\n   967→\n   968→            html_parts.append('        </tbody>\\n    </table>\\n')\n   969→\n   970→        html_parts.append('</div>')\n   971→        return ''.join(html_parts)\n   972→\n   973→\n   974→class FeatureComparisonMatrix:\n   975→    \"\"\"Generate feature comparison matrix for tech products.\"\"\"\n   976→\n   977→    @classmethod\n   978→    def extract_features(cls, findings: List[Dict]) -> Dict[str, Dict[str, str]]:\n   979→        \"\"\"Extract product features from findings.\"\"\"\n   980→        products = {}\n   981→\n   982→        for f in findings:\n   983→            extracted = f.get(\"extracted_data\", {}) or {}\n   984→            product = extracted.get(\"product\", extracted.get(\"tool\", extracted.get(\"company\", \"\")))\n   985→            feature = extracted.get(\"feature\", \"\")\n   986→            value = extracted.get(\"value\", extracted.get(\"capability\", \"\"))\n   987→\n   988→            if product and feature:\n   989→                if product not in products:\n   990→                    products[product] = {}\n   991→                products[product][feature] = value or \"\"\n   992→\n   993→        return products\n   994→\n   995→    @classmethod\n   996→    def generate_comparison_html(cls, products: Dict[str, Dict[str, str]]) -> str:\n   997→        \"\"\"Generate feature comparison matrix HTML.\"\"\"\n   998→        if not products:\n   999→            return '<div class=\"empty-state\">No feature comparison data available</div>'\n  1000→\n  1001→        # Get all unique features\n  1002→        all_features = set()\n  1003→        for features in products.values():\n  1004→            all_features.update(features.keys())\n  1005→        features_list = sorted(all_features)[:12]  # Max 12 features\n  1006→        product_list = list(products.keys())[:6]  # Max 6 products\n  1007→\n  1008→        html_parts = []\n  1009→        html_parts.append('''\n  1010→<div class=\"comparison-matrix\">\n  1011→    <style>\n  1012→        .comp-table { width: 100%; border-collapse: collapse; font-size: 11px; }\n  1013→        .comp-table th { background: #f1f3f5; padding: 8px; text-align: center; font-weight: 600; border: 1px solid #dee2e6; }\n  1014→        .comp-table th.feature-col { text-align: left; width: 150px; }\n  1015→        .comp-table td { padding: 8px; text-align: center; border: 1px solid #dee2e6; }\n  1016→        .comp-check { color: #059669; font-weight: bold; }\n  1017→        .comp-cross { color: #dc2626; }\n  1018→        .comp-partial { color: #d97706; }\n  1019→    </style>\n  1020→    <table class=\"comp-table\">\n  1021→        <thead>\n  1022→            <tr>\n  1023→                <th class=\"feature-col\">Feature</th>\n  1024→''')\n  1025→\n  1026→        for product in product_list:\n  1027→            html_parts.append(f'                <th>{html_mod.escape(product[:20])}</th>\\n')\n  1028→        html_parts.append('            </tr>\\n        </thead>\\n        <tbody>\\n')\n  1029→\n  1030→        for feature in features_list:\n  1031→            html_parts.append(f'            <tr>\\n')\n  1032→            html_parts.append(f'                <td class=\"feature-col\">{html_mod.escape(feature[:30])}</td>\\n')\n  1033→\n  1034→            for product in product_list:\n  1035→                value = products.get(product, {}).get(feature, \"\")\n  1036→                if value:\n  1037→                    if value.lower() in [\"yes\", \"true\", \"\"]:\n  1038→                        html_parts.append('                <td class=\"comp-check\">OK</td>\\n')\n  1039→                    elif value.lower() in [\"no\", \"false\", \"\"]:\n  1040→                        html_parts.append('                <td class=\"comp-cross\">X</td>\\n')\n  1041→                    elif value.lower() in [\"partial\", \"limited\"]:\n  1042→                        html_parts.append('                <td class=\"comp-partial\">~</td>\\n')\n  1043→                    else:\n  1044→                        html_parts.append(f'                <td>{html_mod.escape(str(value)[:15])}</td>\\n')\n  1045→                else:\n  1046→                    html_parts.append('                <td>-</td>\\n')\n  1047→\n  1048→            html_parts.append('            </tr>\\n')\n  1049→\n  1050→        html_parts.append('        </tbody>\\n    </table>\\n</div>')\n  1051→        return ''.join(html_parts)\n  1052→\n  1053→\n  1054→class ContractPricingTable:\n  1055→    \"\"\"Generate contract pricing and benchmark tables.\"\"\"\n  1056→\n  1057→    @classmethod\n  1058→    def extract_pricing_data(cls, findings: List[Dict]) -> List[Dict]:\n  1059→        \"\"\"Extract contract pricing data from findings.\"\"\"\n  1060→        pricing = []\n  1061→\n  1062→        for f in findings:\n  1063→            if f.get(\"finding_type\") not in [\"financial\", \"contract\", \"pricing\"]:\n  1064→                continue\n  1065→\n  1066→            extracted = f.get(\"extracted_data\", {}) or {}\n  1067→            content = f.get(\"content\", \"\").lower()\n  1068→\n  1069→            if any(term in content for term in [\"price\", \"cost\", \"rate\", \"fee\", \"value\"]):\n  1070→                pricing.append({\n  1071→                    \"item\": extracted.get(\"item\", extracted.get(\"service\", \"\"))[:50],\n  1072→                    \"vendor\": extracted.get(\"vendor\", extracted.get(\"contractor\", \"\")),\n  1073→                    \"price\": extracted.get(\"price\", extracted.get(\"amount\", \"\")),\n  1074→                    \"benchmark\": extracted.get(\"benchmark\", \"\"),\n  1075→                    \"variance\": extracted.get(\"variance\", extracted.get(\"difference\", \"\")),\n  1076→                    \"confidence\": f.get(\"confidence_score\", 0.5),\n  1077→                })\n  1078→\n  1079→        return pricing\n  1080→\n  1081→    @classmethod\n  1082→    def generate_pricing_table_html(cls, pricing: List[Dict]) -> str:\n  1083→        \"\"\"Generate pricing benchmark table HTML.\"\"\"\n  1084→        if not pricing:\n  1085→            return '<div class=\"empty-state\">No pricing data available</div>'\n  1086→\n  1087→        html_parts = []\n  1088→        html_parts.append('''\n  1089→<div class=\"pricing-table-section\">\n  1090→    <style>\n  1091→        .price-table { width: 100%; border-collapse: collapse; font-size: 11px; }\n  1092→        .price-table th { background: #f1f3f5; padding: 8px 10px; text-align: left; font-weight: 600; border: 1px solid #dee2e6; }\n  1093→        .price-table td { padding: 8px 10px; border: 1px solid #dee2e6; }\n  1094→        .price-table tr:nth-child(even) { background: #f8f9fa; }\n  1095→        .price-value { font-weight: 600; }\n  1096→        .variance-over { color: #dc2626; background: #fee2e2; padding: 2px 6px; border-radius: 3px; }\n  1097→        .variance-under { color: #059669; background: #d1fae5; padding: 2px 6px; border-radius: 3px; }\n  1098→    </style>\n  1099→    <table class=\"price-table\">\n  1100→        <thead>\n  1101→            <tr>\n  1102→                <th>Item/Service</th>\n  1103→                <th>Vendor</th>\n  1104→                <th>Price</th>\n  1105→                <th>Benchmark</th>\n  1106→                <th>Variance</th>\n  1107→            </tr>\n  1108→        </thead>\n  1109→        <tbody>\n  1110→''')\n  1111→\n  1112→        for item in pricing[:10]:\n  1113→            variance = str(item.get(\"variance\", \"\"))\n  1114→            variance_class = \"variance-over\" if \"over\" in variance.lower() or \"+\" in variance else \\\n  1115→                            \"variance-under\" if \"under\" in variance.lower() or \"-\" in variance else \"\"\n  1116→\n  1117→            html_parts.append(f'''            <tr>\n  1118→                <td>{html_mod.escape(str(item.get(\"item\", \"N/A\"))[:40])}</td>\n  1119→                <td>{html_mod.escape(str(item.get(\"vendor\", \"N/A\"))[:25])}</td>\n  1120→                <td class=\"price-value\">{html_mod.escape(str(item.get(\"price\", \"N/A\"))[:15])}</td>\n  1121→                <td>{html_mod.escape(str(item.get(\"benchmark\", \"-\"))[:15])}</td>\n  1122→                <td><span class=\"{variance_class}\">{html_mod.escape(variance[:15])}</span></td>\n  1123→            </tr>\\n''')\n  1124→\n  1125→        html_parts.append('        </tbody>\\n    </table>\\n</div>')\n  1126→        return ''.join(html_parts)\n  1127→\n  1128→\n  1129→class EvidenceChain:\n  1130→    \"\"\"Generate evidence chain visualization for investigative reports.\"\"\"\n  1131→\n  1132→    @classmethod\n  1133→    def build_evidence_chain(cls, findings: List[Dict]) -> List[Dict]:\n  1134→        \"\"\"Build evidence chain from findings.\"\"\"\n  1135→        chain = []\n  1136→\n  1137→        # Get findings that have evidence/claims\n  1138→        for f in findings:\n  1139→            if f.get(\"finding_type\") not in [\"fact\", \"claim\", \"evidence\"]:\n  1140→                continue\n  1141→\n  1142→            extracted = f.get(\"extracted_data\", {}) or {}\n  1143→            supporting = f.get(\"supporting_sources\", [])\n  1144→\n  1145→            chain.append({\n  1146→                \"claim\": f.get(\"summary\", \"\")[:100],\n  1147→                \"evidence_type\": f.get(\"finding_type\", \"\"),\n  1148→                \"source_count\": len(supporting),\n  1149→                \"sources\": [s.get(\"title\", s.get(\"url\", \"\"))[:40] for s in supporting[:3]],\n  1150→                \"confidence\": f.get(\"confidence_score\", 0.5),\n  1151→                \"corroborated\": len(supporting) > 1,\n  1152→            })\n  1153→\n  1154→        # Sort by confidence\n  1155→        chain = sorted(chain, key=lambda c: c[\"confidence\"], reverse=True)\n  1156→        return chain[:10]\n  1157→\n  1158→    @classmethod\n  1159→    def generate_chain_html(cls, chain: List[Dict]) -> str:\n  1160→        \"\"\"Generate evidence chain visualization HTML.\"\"\"\n  1161→        if not chain:\n  1162→            return '<div class=\"empty-state\">No evidence chain data available</div>'\n  1163→\n  1164→        html_parts = []\n  1165→        html_parts.append('''\n  1166→<div class=\"evidence-chain-section\">\n  1167→    <style>\n  1168→        .ev-chain { display: flex; flex-direction: column; gap: 12px; }\n  1169→        .ev-chain-item { display: flex; gap: 12px; align-items: flex-start; }\n  1170→        .ev-chain-connector { width: 24px; display: flex; flex-direction: column; align-items: center; }\n  1171→        .ev-chain-dot { width: 12px; height: 12px; border-radius: 50%; background: #6366f1; }\n  1172→        .ev-chain-line { width: 2px; flex: 1; background: #e2e8f0; margin-top: 4px; }\n  1173→        .ev-chain-content { flex: 1; background: #f8f9fa; border-radius: 6px; padding: 10px 12px; border-left: 3px solid #6366f1; }\n  1174→        .ev-chain-claim { font-size: 12px; color: #1e293b; margin-bottom: 6px; }\n  1175→        .ev-chain-meta { display: flex; gap: 8px; flex-wrap: wrap; font-size: 10px; }\n  1176→        .ev-chain-badge { padding: 2px 6px; border-radius: 3px; background: #e2e8f0; color: #475569; }\n  1177→        .ev-chain-badge.corroborated { background: #d1fae5; color: #065f46; }\n  1178→        .ev-chain-sources { margin-top: 6px; font-size: 10px; color: #6b7280; }\n  1179→    </style>\n  1180→    <div class=\"ev-chain\">\n  1181→''')\n  1182→\n  1183→        for i, item in enumerate(chain):\n  1184→            corr_class = \"corroborated\" if item[\"corroborated\"] else \"\"\n  1185→            corr_text = \"Corroborated\" if item[\"corroborated\"] else \"Single Source\"\n  1186→\n  1187→            html_parts.append(f'''        <div class=\"ev-chain-item\">\n  1188→            <div class=\"ev-chain-connector\">\n  1189→                <div class=\"ev-chain-dot\"></div>\n  1190→                {'<div class=\"ev-chain-line\"></div>' if i < len(chain) - 1 else ''}\n  1191→            </div>\n  1192→            <div class=\"ev-chain-content\">\n  1193→                <div class=\"ev-chain-claim\">{html_mod.escape(item[\"claim\"])}</div>\n  1194→                <div class=\"ev-chain-meta\">\n  1195→                    <span class=\"ev-chain-badge\">{item[\"evidence_type\"].upper()}</span>\n  1196→                    <span class=\"ev-chain-badge {corr_class}\">{corr_text}</span>\n  1197→                    <span class=\"ev-chain-badge\">{int(item[\"confidence\"]*100)}% conf</span>\n  1198→                </div>\n  1199→                <div class=\"ev-chain-sources\">Sources: {\", \".join([html_mod.escape(s) for s in item[\"sources\"]])}</div>\n  1200→            </div>\n  1201→        </div>\\n''')\n  1202→\n  1203→        html_parts.append('    </div>\\n</div>')\n  1204→
[2026-01-30T09:07:44.323Z] [STDOUT] return ''.join(html_parts)\n  1205→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"34eb5170-c9bb-41ec-b332-c49ff6c57668","uuid":"74230a36-ce63-4b44-b730-1b33bb743999","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\actor\\src\\services\\visualizations.py","content":"\"\"\"Visualization components for rich HTML reports.\"\"\"\n\nfrom typing import Dict, Any, List, Optional, Tuple\nimport html as html_mod\nimport json\nimport math\n\n\nclass NetworkVisualization:\n    \"\"\"Generate network graph visualizations for actor/relationship data.\"\"\"\n\n    # Node type color mapping\n    NODE_COLORS = {\n        \"core\": {\"bg\": \"#fff5f5\", \"border\": \"#e03131\", \"text\": \"#e03131\"},\n        \"person\": {\"bg\": \"#fff5f5\", \"border\": \"#e03131\", \"text\": \"#e03131\"},\n        \"financial\": {\"bg\": \"#fff9db\", \"border\": \"#f59f00\", \"text\": \"#b45309\"},\n        \"finance\": {\"bg\": \"#fff9db\", \"border\": \"#f59f00\", \"text\": \"#b45309\"},\n        \"political\": {\"bg\": \"#ebfbee\", \"border\": \"#2f9e44\", \"text\": \"#2f9e44\"},\n        \"government\": {\"bg\": \"#ebfbee\", \"border\": \"#2f9e44\", \"text\": \"#2f9e44\"},\n        \"intel\": {\"bg\": \"#f3f0ff\", \"border\": \"#7950f2\", \"text\": \"#7950f2\"},\n        \"intelligence\": {\"bg\": \"#f3f0ff\", \"border\": \"#7950f2\", \"text\": \"#7950f2\"},\n        \"corporate\": {\"bg\": \"#e7f5ff\", \"border\": \"#228be6\", \"text\": \"#228be6\"},\n        \"organization\": {\"bg\": \"#e7f5ff\", \"border\": \"#228be6\", \"text\": \"#228be6\"},\n        \"default\": {\"bg\": \"#f1f3f5\", \"border\": \"#adb5bd\", \"text\": \"#495057\"},\n    }\n\n    # Relationship type styles\n    EDGE_STYLES = {\n        \"financial\": {\"color\": \"#f59f00\", \"width\": 3},\n        \"personal\": {\"color\": \"#e03131\", \"width\": 2},\n        \"professional\": {\"color\": \"#228be6\", \"width\": 2},\n        \"political\": {\"color\": \"#2f9e44\", \"width\": 2},\n        \"criminal\": {\"color\": \"#e03131\", \"width\": 3, \"dashed\": True},\n        \"default\": {\"color\": \"#adb5bd\", \"width\": 1},\n    }\n\n    @classmethod\n    def extract_network_data(\n        cls,\n        findings: List[Dict[str, Any]],\n    ) -> Tuple[List[Dict], List[Dict]]:\n        \"\"\"Extract actors and relationships from findings.\"\"\"\n        actors = []\n        relationships = []\n        actor_names = set()\n\n        for finding in findings:\n            ftype = finding.get(\"finding_type\", \"\")\n            extracted = finding.get(\"extracted_data\", {}) or {}\n\n            if ftype == \"actor\":\n                name = extracted.get(\"name\", \"\")\n                if not name and finding.get(\"summary\"):\n                    # Try to extract name from summary\n                    summary = finding.get(\"summary\", \"\")\n                    if \" was \" in summary:\n                        name = summary.split(\" was \")[0].strip()\n                    elif \" is \" in summary:\n                        name = summary.split(\" is \")[0].strip()\n\n                if name and name not in actor_names:\n                    actor_names.add(name)\n                    actors.append({\n                        \"name\": name,\n                        \"role\": extracted.get(\"role\", \"\"),\n                        \"type\": cls._classify_actor_type(extracted, finding),\n                        \"significance\": extracted.get(\"significance\", \"\"),\n                        \"confidence\": finding.get(\"confidence_score\", 0.5),\n                    })\n\n            elif ftype == \"relationship\":\n                # Extract relationship data\n                rel_type = extracted.get(\"type\", \"professional\")\n                source = extracted.get(\"source\", extracted.get(\"actor1\", \"\"))\n                target = extracted.get(\"target\", extracted.get(\"actor2\", \"\"))\n\n                if not source or not target:\n                    # Try to parse from content\n                    content = finding.get(\"content\", \"\")\n                    if \" and \" in content:\n                        parts = content.split(\" and \")\n                        if len(parts) >= 2:\n                            source = parts[0].split()[-1] if parts[0] else \"\"\n                            target = parts[1].split()[0] if parts[1] else \"\"\n\n                if source and target:\n                    relationships.append({\n                        \"source\": source,\n                        \"target\": target,\n                        \"type\": rel_type,\n                        \"description\": finding.get(\"summary\", \"\"),\n                        \"confidence\": finding.get(\"confidence_score\", 0.5),\n                    })\n\n        return actors, relationships\n\n    @classmethod\n    def _classify_actor_type(cls, extracted: Dict, finding: Dict) -> str:\n        \"\"\"Classify actor type based on extracted data.\"\"\"\n        role = extracted.get(\"role\", \"\").lower()\n        affiliations = extracted.get(\"affiliations\", \"\").lower()\n        content = finding.get(\"content\", \"\").lower()\n\n        if any(kw in role + affiliations + content for kw in [\"bank\", \"fund\", \"financial\", \"investor\"]):\n            return \"financial\"\n        if any(kw in role + affiliations + content for kw in [\"senator\", \"governor\", \"president\", \"political\", \"government\"]):\n            return \"political\"\n        if any(kw in role + affiliations + content for kw in [\"cia\", \"fbi\", \"intelligence\", \"agent\"]):\n            return \"intel\"\n        if any(kw in role + affiliations + content for kw in [\"ceo\", \"coo\", \"founder\", \"executive\", \"company\"]):\n            return \"corporate\"\n        if any(kw in role + affiliations + content for kw in [\"central\", \"main\", \"primary\", \"key\"]):\n            return \"core\"\n\n        return \"default\"\n\n    @classmethod\n    def generate_network_html(\n        cls,\n        actors: List[Dict],\n        relationships: List[Dict],\n        width: int = 800,\n        height: int = 500,\n    ) -> str:\n        \"\"\"Generate CSS-positioned network graph HTML.\"\"\"\n        if not actors:\n            return '<div class=\"empty-state\">No actor data available for network visualization</div>'\n\n        # Calculate node positions using circular layout\n        positions = cls._calculate_positions(actors, width, height)\n\n        # Generate HTML\n        html_parts = []\n        html_parts.append(f'''\n<div class=\"network-section\">\n    <div class=\"network-container\" style=\"position: relative; width: 100%; height: {height}px; background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 6px; overflow: hidden;\">\n''')\n\n        # Generate relationship lines first (behind nodes)\n        for rel in relationships:\n            source_pos = positions.get(rel[\"source\"])\n            target_pos = positions.get(rel[\"target\"])\n\n            if source_pos and target_pos:\n                style = cls.EDGE_STYLES.get(rel.get(\"type\", \"\"), cls.EDGE_STYLES[\"default\"])\n                line_html = cls._generate_line_html(\n                    source_pos, target_pos, style, rel.get(\"description\", \"\")\n                )\n                html_parts.append(line_html)\n\n        # Generate actor nodes\n        for actor in actors:\n            pos = positions.get(actor[\"name\"])\n            if pos:\n                colors = cls.NODE_COLORS.get(actor.get(\"type\", \"\"), cls.NODE_COLORS[\"default\"])\n                node_html = cls._generate_node_html(actor, pos, colors)\n                html_parts.append(node_html)\n\n        html_parts.append('    </div>')\n\n        # Generate legend\n        html_parts.append(cls._generate_legend(actors))\n\n        html_parts.append('</div>')\n\n        return '\\n'.join(html_parts)\n\n    @classmethod\n    def _calculate_positions(\n        cls,\n        actors: List[Dict],\n        width: int,\n        height: int,\n    ) -> Dict[str, Tuple[int, int]]:\n        \"\"\"Calculate node positions using circular layout with importance weighting.\"\"\"\n        positions = {}\n        n = len(actors)\n        if n == 0:\n            return positions\n\n        # Sort by confidence (importance)\n        sorted_actors = sorted(actors, key=lambda a: a.get(\"confidence\", 0.5), reverse=True)\n\n        # Place most important in center, others in circle\n        center_x = width // 2\n        center_y = height // 2\n        radius = min(width, height) * 0.35\n\n        for i, actor in enumerate(sorted_actors):\n            if i == 0 and n > 3:\n                # Most important actor in center\n                positions[actor[\"name\"]] = (center_x, center_y)\n            else:\n                # Others in circle\n                angle = (2 * math.pi * (i - 1 if n > 3 else i)) / (n - 1 if n > 3 else n)\n                x = int(center_x + radius * math.cos(angle))\n                y = int(center_y + radius * math.sin(angle))\n                positions[actor[\"name\"]] = (x, y)\n\n        return positions\n\n    @classmethod\n    def _generate_node_html(\n        cls,\n        actor: Dict,\n        pos: Tuple[int, int],\n        colors: Dict[str, str],\n    ) -> str:\n        \"\"\"Generate HTML for a single actor node.\"\"\"\n        name = html_mod.escape(actor.get(\"name\", \"Unknown\"))\n        role = html_mod.escape(actor.get(\"role\", \"\"))[:30]\n        conf = actor.get(\"confidence\", 0.5)\n\n        x, y = pos\n        return f'''\n        <div class=\"network-node\" style=\"\n            position: absolute;\n            left: {x}px;\n            top: {y}px;\n            transform: translate(-50%, -50%);\n            padding: 8px 12px;\n            border-radius: 4px;\n            font-size: 11px;\n            font-weight: 600;\n            white-space: nowrap;\n            cursor: pointer;\n            border: 2px solid {colors['border']};\n            background: {colors['bg']};\n            color: {colors['text']};\n            z-index: 10;\n            transition: transform 0.2s, box-shadow 0.2s;\n        \" title=\"{role} (Confidence: {conf:.0%})\"\n           onmouseover=\"this.style.transform='translate(-50%, -50%) scale(1.1)'; this.style.boxShadow='0 4px 12px rgba(0,0,0,0.15)';\"\n           onmouseout=\"this.style.transform='translate(-50%, -50%)'; this.style.boxShadow='none';\">\n            {name}\n        </div>'''\n\n    @classmethod\n    def _generate_line_html(\n        cls,\n        source_pos: Tuple[int, int],\n        target_pos: Tuple[int, int],\n        style: Dict[str, Any],\n        description: str,\n    ) -> str:\n        \"\"\"Generate HTML/SVG for relationship line.\"\"\"\n        x1, y1 = source_pos\n        x2, y2 = target_pos\n\n        # Calculate line properties\n        length = math.sqrt((x2 - x1) ** 2 + (y2 - y1) ** 2)\n        angle = math.atan2(y2 - y1, x2 - x1) * 180 / math.pi\n\n        color = style.get(\"color\", \"#adb5bd\")\n        width = style.get(\"width\", 1)\n        dashed = \"5,5\" if style.get(\"dashed\") else \"\"\n\n        return f'''\n        <svg style=\"position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1;\">\n            <line x1=\"{x1}\" y1=\"{y1}\" x2=\"{x2}\" y2=\"{y2}\"\n                  stroke=\"{color}\" stroke-width=\"{width}\" stroke-dasharray=\"{dashed}\"\n                  opacity=\"0.6\">\n                <title>{html_mod.escape(description)}</title>\n            </line>\n        </svg>'''\n\n    @classmethod\n    def _generate_legend(cls, actors: List[Dict]) -> str:\n        \"\"\"Generate legend showing node types present in the network.\"\"\"\n        # Find unique types in the data\n        types_present = set(a.get(\"type\", \"default\") for a in actors)\n\n        legend_items = []\n        for node_type in types_present:\n            colors = cls.NODE_COLORS.get(node_type, cls.NODE_COLORS[\"default\"])\n            label = node_type.replace(\"_\", \" \").title()\n            legend_items.append(f'''\n            <div class=\"legend-item\" style=\"display: flex; align-items: center; gap: 6px;\">\n                <div style=\"width: 12px; height: 12px; border-radius: 2px; background: {colors['bg']}; border: 2px solid {colors['border']};\"></div>\n                <span style=\"font-size: 11px; color: #495057;\">{label}</span>\n            </div>''')\n\n        return f'''\n    <div class=\"network-legend\" style=\"display: flex; gap: 16px; margin-top: 12px; flex-wrap: wrap;\">\n        {''.join(legend_items)}\n    </div>'''\n\n\nclass TimelineVisualization:\n    \"\"\"Generate parallel timeline visualizations.\"\"\"\n\n    STREAM_COLORS = {\n        \"legal\": \"#e03131\",\n        \"financial\": \"#f59f00\",\n        \"public\": \"#228be6\",\n        \"regulatory\": \"#2f9e44\",\n        \"corporate\": \"#7950f2\",\n        \"default\": \"#868e96\",\n    }\n\n    @classmethod\n    def extract_timeline_data(\n        cls,\n        findings: List[Dict[str, Any]],\n    ) -> Dict[str, List[Dict]]:\n        \"\"\"Extract and group events by stream/category.\"\"\"\n        streams: Dict[str, List[Dict]] = {}\n\n        for finding in findings:\n            ftype = finding.get(\"finding_type\", \"\")\n            if ftype not in [\"event\", \"financial\"]:\n                continue\n\n            extracted = finding.get(\"extracted_data\", {}) or {}\n            event_date = finding.get(\"event_date\") or extracted.get(\"date\", \"\")\n\n            # Determine stream\n            stream = cls._classify_stream(finding)\n\n            if stream not in streams:\n                streams[stream] = []\n\n            streams[stream].append({\n                \"date\": event_date,\n                \"year\": cls._extract_year(event_date),\n                \"summary\": finding.get(\"summary\", \"\")[:80],\n                \"content\": finding.get(\"content\", \"\"),\n                \"confidence\": finding.get(\"confidence_score\", 0.5),\n                \"type\": ftype,\n            })\n\n        # Sort events within each stream by date\n        for stream in streams:\n            streams[stream] = sorted(\n                streams[stream],\n                key=lambda e: e.get(\"date\", \"\") or e.get(\"year\", \"\"),\n            )\n\n        return streams\n\n    @classmethod\n    def _classify_stream(cls, finding: Dict) -> str:\n        \"\"\"Classify event into a stream category.\"\"\"\n        content = finding.get(\"content\", \"\").lower()\n        summary = finding.get(\"summary\", \"\").lower()\n        ftype = finding.get(\"finding_type\", \"\")\n        text = content + \" \" + summary\n\n        if ftype == \"financial\" or any(kw in text for kw in [\"payment\", \"fund\", \"invest\", \"million\", \"billion\"]):\n            return \"financial\"\n        if any(kw in text for kw in [\"court\", \"trial\", \"lawsuit\", \"legal\", \"guilty\", \"sentence\"]):\n            return \"legal\"\n        if any(kw in text for kw in [\"sec\", \"fda\", \"regulatory\", \"compliance\", \"audit\"]):\n            return \"regulatory\"\n        if any(kw in text for kw in [\"public\", \"media\", \"press\", \"announce\", \"news\"]):\n            return \"public\"\n        if any(kw in text for kw in [\"company\", \"corporate\", \"ceo\", \"board\"]):\n            return \"corporate\"\n\n        return \"default\"\n\n    @classmethod\n    def _extract_year(cls, date_str: str) -> str:\n        \"\"\"Extract year from date string.\"\"\"\n        if not date_str:\n            return \"\"\n        # Handle various formats\n        for fmt in [\"%Y-%m-%d\", \"%Y-%m\", \"%Y\", \"%B %Y\", \"%B %d, %Y\"]:\n            try:\n                from datetime import datetime\n                dt = datetime.strptime(date_str[:10], fmt[:len(date_str[:10])])\n                return str(dt.year)\n            except (ValueError, IndexError):\n                continue\n        # Try to find 4-digit year\n        import re\n        match = re.search(r'(19|20)\\d{2}', date_str)\n        if match:\n            return match.group()\n        return \"\"\n\n    @classmethod\n    def generate_timeline_html(\n        cls,\n        streams: Dict[str, List[Dict]],\n    ) -> str:\n        \"\"\"Generate parallel timeline HTML.\"\"\"\n        if not streams:\n            return '<div class=\"empty-state\">No timeline data available</div>'\n\n        # Get all unique years\n        all_years = set()\n        for events in streams.values():\n            for event in events:\n                year = event.get(\"year\", \"\")\n                if year:\n                    all_years.add(year)\n\n        if not all_years:\n            return '<div class=\"empty-state\">No dated events for timeline</div>'\n\n        years = sorted(all_years)\n        stream_names = list(streams.keys())\n\n        # Build HTML\n        html_parts = []\n        html_parts.append('''\n<div class=\"timeline-section\">\n    <div class=\"parallel-timeline\" style=\"display: grid; grid-template-columns: 80px repeat(''' + str(len(stream_names)) + ''', 1fr); gap: 1px; background: #dee2e6; border: 1px solid #dee2e6; border-radius: 6px; overflow: hidden;\">\n''')\n\n        # Header row\n        html_parts.append('<div class=\"timeline-header\" style=\"background: #f1f3f5; padding: 10px 8px; font-size: 10px; font-weight: 600; text-transform: uppercase; text-align: center;\">Year</div>')\n        for stream in stream_names:\n            color = cls.STREAM_COLORS.get(stream, cls.STREAM_COLORS[\"default\"])\n            html_parts.append(f'<div class=\"timeline-header\" style=\"background: #f1f3f5; padding: 10px 8px; font-size: 10px; font-weight: 600; text-transform: uppercase; text-align: center; color: {color};\">{stream.title()}</div>')\n\n        # Data rows by year\n        for year in years:\n            html_parts.append(f'<div class=\"timeline-year\" style=\"background: #f8f9fa; padding: 8px; font-weight: 600; font-size: 12px; text-align: center;\">{year}</div>')\n\n            for stream in stream_names:\n                events = [e for e in streams.get(stream, []) if e.get(\"year\") == year]\n                color = cls.STREAM_COLORS.get(stream, cls.STREAM_COLORS[\"default\"])\n\n                html_parts.append('<div class=\"timeline-cell\" style=\"background: #ffffff; padding: 8px; min-height: 60px; font-size: 11px;\">')\n                for event in events:\n                    html_parts.append(f'''\n                    <div class=\"timeline-event\" style=\"padding: 4px 6px; border-radius: 3px; margin: 2px 0; font-size: 10px; line-height: 1.3; background: {color}15; border-left: 2px solid {color};\" title=\"{html_mod.escape(event.get('content', '')[:200])}\">\n                        {html_mod.escape(event.get('summary', ''))}\n                    </div>''')\n                html_parts.append('</div>')\n\n        html_parts.append('    </div>')\n\n        # Legend\n        html_parts.append('<div class=\"timeline-legend\" style=\"display: flex; gap: 16px; margin-top: 12px; flex-wrap: wrap;\">')\n        for stream in stream_names:\n            color = cls.STREAM_COLORS.get(stream, cls.STREAM_COLORS[\"default\"])\n            html_parts.append(f'''\n            <div style=\"display: flex; align-items: center; gap: 6px;\">\n                <div style=\"width: 12px; height: 12px; border-radius: 2px; background: {color};\"></div>\n                <span style=\"font-size: 11px; color: #495057;\">{stream.title()}</span>\n            </div>''')\n        html_parts.append('</div>')\n\n        html_parts.append('</div>')\n\n        return '\\n'.join(html_parts)\n\n\nclass MoneyFlowVisualization:\n    \"\"\"Generate Sankey-style money flow diagrams.\"\"\"\n\n    @classmethod\n    def extract_flow_data(\n        cls,\n        findings: List[Dict[str, Any]],\n    ) -> List[Dict]:\n        \"\"\"Extract financial flow data from findings.\"\"\"\n        flows = []\n\n        for finding in findings:\n            if finding.get(\"finding_type\") != \"financial\":\n                continue\n\n            extracted = finding.get(\"extracted_data\", {}) or {}\n            amount = extracted.get(\"amount\")\n            payer = extracted.get(\"payer\", \"\")\n            payee = extracted.get(\"payee\", \"\")\n\n            if amount and payer and payee:\n                # Normalize amount to number\n                if isinstance(amount, str):\n                    amount = cls._parse_amount(amount)\n\n                flows.append({\n                    \"source\": payer,\n                    \"target\": payee,\n                    \"amount\": amount,\n                    \"type\": extracted.get(\"transaction_type\", \"payment\"),\n                    \"date\": extracted.get(\"transaction_date\", \"\"),\n                    \"purpose\": extracted.get(\"purpose\", \"\"),\n                    \"confidence\": finding.get(\"confidence_score\", 0.5),\n                })\n\n        # Sort by amount descending\n        flows = sorted(flows, key=lambda f: f.get(\"amount\", 0) or 0, reverse=True)\n        return flows\n\n    @classmethod\n    def _parse_amount(cls, amount_str: str) -> float:\n        \"\"\"Parse amount string to float.\"\"\"\n        import re\n        # Remove currency symbols and commas\n        cleaned = re.sub(r'[,$]', '', str(amount_str))\n        # Handle millions/billions\n        multiplier = 1\n        if 'million' in amount_str.lower() or 'm' in amount_str.lower():\n            multiplier = 1_000_000\n        elif 'billion' in amount_str.lower() or 'b' in amount_str.lower():\n            multiplier = 1_000_000_000\n\n        try:\n            base = float(re.search(r'[\\d.]+', cleaned).group())\n            return base * multiplier\n        except (AttributeError, ValueError):\n            return 0\n\n    @classmethod\n    def generate_flow_html(\n        cls,\n        flows: List[Dict],\n        max_flows: int = 10,\n    ) -> str:\n        \"\"\"Generate Sankey-style money flow HTML.\"\"\"\n        if not flows:\n            return '<div class=\"empty-state\">No financial flow data available</div>'\n\n        flows = flows[:max_flows]\n        max_amount = max(f.get(\"amount\", 0) or 1 for f in flows)\n\n        html_parts = []\n        html_parts.append('''\n<div class=\"flow-section\">\n    <div class=\"flow-container\" style=\"background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 6px; padding: 20px;\">\n''')\n\n        for flow in flows:\n            amount = flow.get(\"amount\", 0) or 0\n            # Calculate relative width (min 20%, max 100%)\n            width_pct = max(20, min(100, (amount / max_amount) * 100))\n\n            # Determine thickness class\n            thickness = \"thick\" if width_pct > 60 else \"medium\" if width_pct > 30 else \"thin\"\n            line_height = 12 if thickness == \"thick\" else 8 if thickness == \"medium\" else 4\n\n            source = html_mod.escape(flow.get(\"source\", \"Unknown\"))\n            target = html_mod.escape(flow.get(\"target\", \"Unknown\"))\n            amount_str = cls._format_amount(amount)\n            purpose = html_mod.escape(flow.get(\"purpose\", \"\")[:50])\n\n            html_parts.append(f'''\n        <div class=\"flow-row\" style=\"display: flex; align-items: center; margin: 16px 0;\" title=\"{purpose}\">\n            <div class=\"flow-source\" style=\"width: 160px; padding: 10px; border-radius: 4px; font-size: 11px; font-weight: 600; text-align: center; background: #e7f5ff; color: #228be6;\">\n                {source}\n            </div>\n            <div class=\"flow-line\" style=\"flex: 1; margin: 0 12px; position: relative;\">\n                <div class=\"flow-amount\" style=\"position: absolute; top: -18px; left: 50%; transform: translateX(-50%); font-size: 11px; font-weight: 700; white-space: nowrap; color: #495057;\">\n                    {amount_str}\n                </div>\n                <div class=\"flow-line-inner\" style=\"height: {line_height}px; background: linear-gradient(90deg, #228be6, #e03131); border-radius: 4px; width: {width_pct}%;\"></div>\n            </div>\n            <div class=\"flow-target\" style=\"width: 160px; padding: 10px; border-radius: 4px; font-size: 11px; font-weight: 600; text-align: center; background: #fff5f5; color: #e03131;\">\n                {target}\n            </div>\n        </div>''')\n\n        html_parts.append('    </div>')\n\n        # Summary\n        total = sum(f.get(\"amount\", 0) or 0 for f in flows)\n        html_parts.append(f'''\n    <div class=\"flow-summary\" style=\"margin-top: 12px; font-size: 12px; color: #495057;\">\n        <strong>Total tracked:</strong> {cls._format_amount(total)} across {len(flows)} transactions\n    </div>\n</div>''')\n\n        return '\\n'.join(html_parts)\n\n    @classmethod\n    def _format_amount(cls, amount: float) -> str:\n        \"\"\"Format amount for display.\"\"\"\n        if amount >= 1_000_000_000:\n            return f\"${amount / 1_000_000_000:.1f}B\"\n        if amount >= 1_000_000:\n            return f\"${amount / 1_000_000:.1f}M\"\n        if amount >= 1_000:\n            return f\"${amount / 1_000:.1f}K\"\n        return f\"${amount:,.0f}\"\n\n\nclass StakeholderImpactMatrix:\n    \"\"\"Generate stakeholder impact analysis matrix.\"\"\"\n\n    # Impact level colors\n    IMPACT_COLORS = {\n        \"positive\": {\"bg\": \"#d1fae5\", \"text\": \"#065f46\", \"symbol\": \"+\"},\n        \"negative\": {\"bg\": \"#fee2e2\", \"text\": \"#991b1b\", \"symbol\": \"-\"},\n        \"neutral\": {\"bg\": \"#f1f5f9\", \"text\": \"#64748b\", \"symbol\": \"~\"},\n        \"mixed\": {\"bg\": \"#fef3c7\", \"text\": \"#92400e\", \"symbol\": \"±\"},\n    }\n\n    # Common stakeholder categories\n    STAKEHOLDER_CATEGORIES = [\n        \"investors\", \"customers\", \"employees\", \"regulators\",\n        \"competitors\", \"partners\", \"suppliers\", \"public\"\n    ]\n\n    @classmethod\n    def extract_stakeholders(cls, findings: List[Dict], perspectives: List[Dict]) -> List[str]:\n        \"\"\"Extract stakeholder groups from findings and perspectives.\"\"\"\n        stakeholders = set()\n\n        # Extract from findings\n        for f in findings:\n            content = (f.get(\"content\", \"\") + \" \" + f.get(\"summary\", \"\")).lower()\n            for category in cls.STAKEHOLDER_CATEGORIES:\n                if category in content or category[:-1] in content:  # \"investor\" or \"investors\"\n                    stakeholders.add(category.title())\n\n            # Also check extracted_data\n            extracted = f.get(\"extracted_data\", {}) or {}\n            if extracted.get(\"stakeholders\"):\n                for s in extracted.get(\"stakeholders\", []):\n                    stakeholders.add(s.title() if isinstance(s, str) else str(s))\n\n        # Extract from perspective warnings/recommendations\n        for p in perspectives:\n            recommendations = p.get(\"recommendations\", [])\n            for rec in recommendations:\n                rec_lower = rec.lower() if isinstance(rec, str) else \"\"\n                for category in cls.STAKEHOLDER_CATEGORIES:\n                    if category in rec_lower:\n                        stakeholders.add(category.title())\n\n        # Ensure we have at least some stakeholders\n        if not stakeholders:\n            stakeholders = {\"Investors\", \"Customers\", \"Regulators\"}\n\n        return sorted(list(stakeholders))[:6]  # Max 6 stakeholders\n\n    @classmethod\n    def analyze_impacts(\n        cls,\n        findings: List[Dict],\n        stakeholders: List[str],\n    ) -> List[Dict]:\n        \"\"\"Analyze impact of key findings on each stakeholder group.\"\"\"\n        # Get top findings by confidence\n        key_findings = sorted(\n            findings,\n            key=lambda f: f.get(\"confidence_score\", 0.5),\n            reverse=True\n        )[:8]\n\n        impact_data = []\n        for finding in key_findings:\n            summary = finding.get(\"summary\", \"\") or finding.get(\"content\", \"\")[:200]\n            content = finding.get(\"content\", \"\").lower()\n            ftype = finding.get(\"finding_type\", \"\")\n\n            impacts = {}\n            for stakeholder in stakeholders:\n                stakeholder_lower = stakeholder.lower()\n                # Simple heuristic-based impact analysis\n                impact = cls._determine_impact(content, ftype, stakeholder_lower)\n                impacts[stakeholder] = impact\n\n            impact_data.append({\n                \"summary\": summary,\n                \"type\": ftype,\n                \"impacts\": impacts,\n            })\n\n        return impact_data\n\n    @classmethod\n    def _determine_impact(cls, content: str, finding_type: str, stakeholder: str) -> str:\n        \"\"\"Determine impact on stakeholder based on content and type.\"\"\"\n        # Negative indicators\n        negative_words = [\"loss\", \"decline\", \"risk\", \"threat\", \"penalty\", \"fine\", \"lawsuit\", \"violation\"]\n        positive_words = [\"growth\", \"gain\", \"opportunity\", \"benefit\", \"improve\", \"increase\", \"success\"]\n\n        has_negative = any(word in content for word in negative_words)\n        has_positive = any(word in content for word in positive_words)\n        mentions_stakeholder = stakeholder in content or stakeholder[:-1] in content\n\n        if finding_type in [\"red_flag\", \"suspicious_element\"]:\n            if stakeholder in [\"investors\", \"customers\", \"regulators\"]:\n                return \"negative\"\n\n        if has_positive and has_negative:\n            return \"mixed\"\n        if has_negative:\n            return \"negative\" if mentions_stakeholder else \"neutral\"\n        if has_positive:\n            return \"positive\" if mentions_stakeholder else \"neutral\"\n\n        return \"neutral\"\n\n    @classmethod\n    def generate_matrix_html(\n        cls,\n        impact_data: List[Dict],\n        stakeholders: List[str],\n    ) -> str:\n        \"\"\"Generate stakeholder impact matrix HTML.\"\"\"\n        if not impact_data or not stakeholders:\n            return '<div class=\"empty-state\">No stakeholder impact data available</div>'\n\n        html_parts = []\n        html_parts.append('''\n<div class=\"impact-matrix-section\">\n    <style>\n        .impact-matrix { width: 100%; border-collapse: collapse; font-size: 12px; }\n        .impact-matrix th { background: #f1f3f5; padding: 8px 6px; text-align: center; font-weight: 600; border: 1px solid #dee2e6; }\n        .impact-matrix th.finding-col { text-align: left; min-width: 280px; max-width: 400px; }\n        .impact-matrix td { padding: 8px 6px; text-align: center; border: 1px solid #dee2e6; }\n        .impact-matrix td.finding-cell { text-align: left; font-size: 11px; line-height: 1.4; word-wrap: break-word; max-width: 400px; }\n        .impact-cell { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 4px; font-weight: 700; font-size: 14px; }\n        .impact-legend { display: flex; gap: 16px; margin-top: 12px; font-size: 11px; flex-wrap: wrap; }\n        .legend-item { display: flex; align-items: center; gap: 6px; }\n    </style>\n    <table class=\"impact-matrix\">\n        <thead>\n            <tr>\n                <th class=\"finding-col\">Key Finding</th>\n''')\n\n        # Header row with stakeholders\n        for stakeholder in stakeholders:\n            html_parts.append(f'                <th>{html_mod.escape(stakeholder)}</th>\\n')\n        html_parts.append('            </tr>\\n        </thead>\\n        <tbody>\\n')\n\n        # Data rows\n        for row in impact_data:\n            html_parts.append(f'            <tr>\\n')\n            html_parts.append(f'                <td class=\"finding-cell\">{html_mod.escape(row[\"summary\"])}</td>\\n')\n\n            for stakeholder in stakeholders:\n                impact = row[\"impacts\"].get(stakeholder, \"neutral\")\n                colors = cls.IMPACT_COLORS.get(impact, cls.IMPACT_COLORS[\"neutral\"])\n                html_parts.append(\n                    f'                <td><span class=\"impact-cell\" style=\"background:{colors[\"bg\"]};color:{colors[\"text\"]};\">'\n                    f'{colors[\"symbol\"]}</span></td>\\n'\n                )\n\n            html_parts.append('            </tr>\\n')\n\n        html_parts.append('        </tbody>\\n    </table>\\n')\n\n        # Legend\n        html_parts.append('    <div class=\"impact-legend\">\\n')\n        for impact_type, colors in cls.IMPACT_COLORS.items():\n            html_parts.append(\n                f'        <div class=\"legend-item\">'\n                f'<span class=\"impact-cell\" style=\"background:{colors[\"bg\"]};color:{colors[\"text\"]};width:20px;height:20px;font-size:12px;\">'\n                f'{colors[\"symbol\"]}</span>{impact_type.title()}</div>\\n'\n            )\n        html_parts.append('    </div>\\n</div>')\n\n        return ''.join(html_parts)\n\n\nclass PredictionTimeline:\n    \"\"\"Generate prediction timeline visualization grouped by timeframe.\"\"\"\n\n    TIMEFRAME_ORDER = [\"immediate\", \"q1\", \"q2\", \"q3\", \"q4\", \"2025\", \"2026\", \"long-term\"]\n\n    @classmethod\n    def group_predictions_by_timeline(cls, perspectives: List[Dict]) -> Dict[str, List[Dict]]:\n        \"\"\"Group predictions by their timeline/timeframe.\"\"\"\n        grouped: Dict[str, List[Dict]] = {}\n\n        for p in perspectives:\n            predictions = p.get(\"predictions\", [])\n            perspective_type = p.get(\"perspective_type\", \"unknown\")\n\n            for pred in predictions:\n                if isinstance(pred, dict):\n                    timeline = pred.get(\"timeline\", \"\").lower() if pred.get(\"timeline\") else \"unspecified\"\n                    prediction_text = pred.get(\"prediction\", \"\")\n                    confidence = pred.get(\"confidence\", \"medium\")\n                else:\n                    timeline = \"unspecified\"\n                    prediction_text = str(pred)\n                    confidence = \"medium\"\n\n                # Normalize timeline to standard categories\n                normalized_timeline = cls._normalize_timeline(timeline)\n\n                if normalized_timeline not in grouped:\n                    grouped[normalized_timeline] = []\n\n                grouped[normalized_timeline].append({\n                    \"text\": prediction_text,\n                    \"confidence\": confidence if isinstance(confidence, str) else (\n                        \"high\" if confidence >= 0.8 else \"medium\" if confidence >= 0.5 else \"low\"\n                    ),\n                    \"source\": perspective_type,\n                    \"rationale\": pred.get(\"rationale\", \"\") if isinstance(pred, dict) else \"\",\n                })\n\n        return grouped\n\n    @classmethod\n    def _normalize_timeline(cls, timeline: str) -> str:\n        \"\"\"Normalize timeline string to standard category.\"\"\"\n        if not timeline:\n            return \"Unspecified\"\n\n        timeline_lower = timeline.lower()\n\n        if any(term in timeline_lower for term in [\"immediate\", \"now\", \"current\"]):\n            return \"Immediate\"\n        if \"q1\" in timeline_lower or \"quarter 1\" in timeline_lower:\n            return \"Q1\"\n        if \"q2\" in timeline_lower or \"quarter 2\" in timeline_lower:\n            return \"Q2\"\n        if \"q3\" in timeline_lower or \"quarter 3\" in timeline_lower:\n            return \"Q3\"\n        if \"q4\" in timeline_lower or \"quarter 4\" in timeline_lower:\n            return \"Q4\"\n        if \"2025\" in timeline_lower:\n            return \"2025\"\n        if \"2026\" in timeline_lower:\n            return \"2026\"\n        if any(term in timeline_lower for term in [\"long\", \"future\", \"years\"]):\n            return \"Long-term\"\n        if any(term in timeline_lower for term in [\"month\", \"near\"]):\n            return \"Near-term\"\n\n        return timeline.title()[:20]\n\n    @classmethod\n    def generate_timeline_html(cls, grouped_predictions: Dict[str, List[Dict]]) -> str:\n        \"\"\"Generate prediction timeline HTML.\"\"\"\n        if not grouped_predictions:\n            return '<div class=\"empty-state\">No predictions available</div>'\n\n        # Sort timelines\n        sorted_timelines = sorted(\n            grouped_predictions.keys(),\n            key=lambda t: cls.TIMEFRAME_ORDER.index(t.lower()) if t.lower() in cls.TIMEFRAME_ORDER else 99\n        )\n\n        html_parts = []\n        html_parts.append('''\n<div class=\"prediction-timeline\">\n    <style>\n        .pred-timeline-row { display: flex; margin-bottom: 24px; }\n        .pred-timeline-label { width: 100px; flex-shrink: 0; font-weight: 600; font-size: 12px; color: #6366f1; padding-top: 4px; }\n        .pred-timeline-items { flex: 1; display: flex; flex-wrap: wrap; gap: 8px; }\n        .pred-timeline-card { background: linear-gradient(135deg, #f0f9ff, #e0f2fe); border: 1px solid #bae6fd; border-radius: 6px; padding: 10px 12px; max-width: 300px; }\n        .pred-timeline-text { font-size: 12px; color: #1e293b; margin-bottom: 6px; line-height: 1.4; }\n        .pred-timeline-meta { display: flex; gap: 8px; align-items: center; font-size: 10px; }\n        .pred-source { color: #6b7280; }\n        .pred-conf { padding: 2px 6px; border-radius: 4px; font-weight: 600; }\n        .pred-conf-high { background: #d1fae5; color: #065f46; }\n        .pred-conf-medium { background: #fef3c7; color: #92400e; }\n        .pred-conf-low { background: #f1f5f9; color: #64748b; }\n    </style>\n''')\n\n        for timeline in sorted_timelines:\n            predictions = grouped_predictions[timeline]\n            html_parts.append(f'    <div class=\"pred-timeline-row\">\\n')\n            html_parts.append(f'        <div class=\"pred-timeline-label\">{html_mod.escape(timeline)}</div>\\n')\n            html_parts.append('        <div class=\"pred-timeline-items\">\\n')\n\n            for pred in predictions[:4]:  # Max 4 per timeline\n                conf_class = f\"pred-conf-{pred['confidence']}\"\n                html_parts.append(f'''            <div class=\"pred-timeline-card\">\n                <div class=\"pred-timeline-text\">{html_mod.escape(pred[\"text\"][:150])}</div>\n                <div class=\"pred-timeline-meta\">\n                    <span class=\"pred-source\">{html_mod.escape(pred[\"source\"].replace(\"_\", \" \").title())}</span>\n                    <span class=\"pred-conf {conf_class}\">{pred[\"confidence\"].upper()}</span>\n                </div>\n            </div>\\n''')\n\n            html_parts.append('        </div>\\n    </div>\\n')\n\n        html_parts.append('</div>')\n\n        return ''.join(html_parts)\n\n\nclass FinancialTables:\n    \"\"\"Generate financial data tables for earnings, valuations, and metrics.\"\"\"\n\n    @classmethod\n    def extract_financial_metrics(cls, findings: List[Dict]) -> Dict[str, List[Dict]]:\n        \"\"\"Extract financial metrics from findings.\"\"\"\n        metrics = {\n            \"earnings\": [],\n            \"revenue\": [],\n            \"margins\": [],\n            \"valuations\": [],\n            \"other\": [],\n        }\n\n        for f in findings:\n            if f.get(\"finding_type\") != \"financial\":\n                continue\n\n            extracted = f.get(\"extracted_data\", {}) or {}\n            metric_type = extracted.get(\"metric_type\", \"\").lower()\n            content = f.get(\"content\", \"\").lower()\n\n            metric_entry = {\n                \"period\": extracted.get(\"period\", extracted.get(\"quarter\", \"\")),\n                \"value\": extracted.get(\"amount\", extracted.get(\"value\", \"\")),\n                \"company\": extracted.get(\"company\", extracted.get(\"entity\", \"\")),\n                \"comparison\": extracted.get(\"comparison\", \"\"),\n                \"change\": extracted.get(\"change\", extracted.get(\"growth\", \"\")),\n                \"confidence\": f.get(\"confidence_score\", 0.5),\n            }\n\n            if any(term in metric_type + content for term in [\"eps\", \"earning\", \"profit\", \"income\"]):\n                metrics[\"earnings\"].append(metric_entry)\n            elif any(term in metric_type + content for term in [\"revenue\", \"sales\", \"top line\"]):\n                metrics[\"revenue\"].append(metric_entry)\n            elif any(term in metric_type + content for term in [\"margin\", \"gross\", \"operating\"]):\n                metrics[\"margins\"].append(metric_entry)\n            elif any(term in metric_type + content for term in [\"p/e\", \"valuation\", \"multiple\", \"ev\"]):\n                metrics[\"valuations\"].append(metric_entry)\n            else:\n                metrics[\"other\"].append(metric_entry)\n\n        return metrics\n\n    @classmethod\n    def generate_financial_table_html(cls, metrics: Dict[str, List[Dict]]) -> str:\n        \"\"\"Generate HTML tables for financial metrics.\"\"\"\n        if not any(metrics.values()):\n            return '<div class=\"empty-state\">No financial metrics data available</div>'\n\n        html_parts = []\n        html_parts.append('''\n<div class=\"financial-tables\">\n    <style>\n        .fin-table { width: 100%; border-collapse: collapse; font-size: 11px; margin-bottom: 16px; }\n        .fin-table th { background: #f1f3f5; padding: 8px 10px; text-align: left; font-weight: 600; border: 1px solid #dee2e6; }\n        .fin-table td { padding: 8px 10px; border: 1px solid #dee2e6; }\n        .fin-table tr:nth-child(even) { background: #f8f9fa; }\n        .fin-section-title { font-weight: 600; color: #1e293b; font-size: 13px; margin: 12px 0 8px; }\n        .fin-value { font-weight: 600; color: #1e293b; }\n        .fin-change-positive { color: #059669; }\n        .fin-change-negative { color: #dc2626; }\n    </style>\n''')\n\n        for category, items in metrics.items():\n            if not items:\n                continue\n\n            html_parts.append(f'    <div class=\"fin-section-title\">{category.title()}</div>\\n')\n            html_parts.append('    <table class=\"fin-table\">\\n')\n            html_parts.append('        <thead><tr><th>Company</th><th>Period</th><th>Value</th><th>Change</th></tr></thead>\\n')\n            html_parts.append('        <tbody>\\n')\n\n            for item in items[:8]:\n                company = html_mod.escape(str(item.get(\"company\", \"N/A\"))[:30])\n                period = html_mod.escape(str(item.get(\"period\", \"N/A\"))[:20])\n                value = html_mod.escape(str(item.get(\"value\", \"N/A\"))[:20])\n                change = str(item.get(\"change\", \"\"))\n                change_class = \"fin-change-positive\" if \"+\" in change or \"up\" in change.lower() else \\\n                              \"fin-change-negative\" if \"-\" in change or \"down\" in change.lower() else \"\"\n\n                html_parts.append(f'            <tr>\\n')\n                html_parts.append(f'                <td>{company}</td>\\n')\n                html_parts.append(f'                <td>{period}</td>\\n')\n                html_parts.append(f'                <td class=\"fin-value\">{value}</td>\\n')\n                html_parts.append(f'                <td class=\"{change_class}\">{html_mod.escape(change[:20])}</td>\\n')\n                html_parts.append(f'            </tr>\\n')\n\n            html_parts.append('        </tbody>\\n    </table>\\n')\n\n        html_parts.append('</div>')\n        return ''.join(html_parts)\n\n\nclass FeatureComparisonMatrix:\n    \"\"\"Generate feature comparison matrix for tech products.\"\"\"\n\n    @classmethod\n    def extract_features(cls, findings: List[Dict]) -> Dict[str, Dict[str, str]]:\n        \"\"\"Extract product features from findings.\"\"\"\n        products = {}\n\n        for f in findings:\n            extracted = f.get(\"extracted_data\", {}) or {}\n            product = extracted.get(\"product\", extracted.get(\"tool\", extracted.get(\"company\", \"\")))\n            feature = extracted.get(\"feature\", \"\")\n            value = extracted.get(\"value\", extracted.get(\"capability\", \"\"))\n\n            if product and feature:\n                if product not in products:\n                    products[product] = {}\n                products[product][feature] = value or \"\"\n\n        return products\n\n    @classmethod\n    def generate_comparison_html(cls, products: Dict[str, Dict[str, str]]) -> str:\n        \"\"\"Generate feature comparison matrix HTML.\"\"\"\n        if not products:\n            return '<div class=\"empty-state\">No feature comparison data available</div>'\n\n        # Get all unique features\n        all_features = set()\n        for features in products.values():\n            all_features.update(features.keys())\n        features_list = sorted(all_features)[:12]  # Max 12 features\n        product_list = list(products.keys())[:6]  # Max 6 products\n\n        html_parts = []\n        html_parts.append('''\n<div class=\"comparison-matrix\">\n    <style>\n        .comp-table { width: 100%; border-collapse: collapse; font-size: 11px; }\n        .comp-table th { background: #f1f3f5; padding: 8px; text-align: center; font-weight: 600; border: 1px solid #dee2e6; }\n        .comp-table th.feature-col { text-align: left; width: 150px; }\n        .comp-table td { padding: 8px; text-align: center; border: 1px solid #dee2e6; }\n        .comp-check { color: #059669; font-weight: bold; }\n        .comp-cross { color: #dc2626; }\n        .comp-partial { color: #d97706; }\n    </style>\n    <table class=\"comp-table\">\n        <thead>\n            <tr>\n                <th class=\"feature-col\">Feature</th>\n''')\n\n        for product in product_list:\n            html_parts.append(f'                <th>{html_mod.escape(product[:20])}</th>\\n')\n        html_parts.append('            </tr>\\n        </thead>\\n        <tbody>\\n')\n\n        for feature in features_list:\n            html_parts.append(f'            <tr>\\n')\n            html_parts.append(f'                <td class=\"feature-col\">{html_mod.escape(feature[:30])}</td>\\n')\n\n            for product in product_list:\n                value = products.get(product, {}).get(feature, \"\")\n                if value:\n                    if value.lower() in [\"yes\", \"true\", \"\"]:\n                        html_parts.append('                <td class=\"comp-check\">OK</td>\\n')\n                    elif value.lower() in [\"no\", \"false\", \"\"]:\n                        html_parts.append('                <td class=\"comp-cross\">X</td>\\n')\n                    elif value.lower() in [\"partial\", \"limited\"]:\n                        html_parts.append('                <td class=\"comp-partial\">~</td>\\n')\n                    else:\n                        html_parts.append(f'                <td>{html_mod.escape(str(value)[:15])}</td>\\n')\n                else:\n                    html_parts.append('                <td>-</td>\\n')\n\n            html_parts.append('            </tr>\\n')\n\n        html_parts.append('        </tbody>\\n    </table>\\n</div>')\n        return ''.join(html_parts)\n\n\nclass ContractPricingTable:\n    \"\"\"Generate contract pricing and benchmark tables.\"\"\"\n\n    @classmethod\n    def extract_pricing_data(cls, findings: List[Dict]) -> List[Dict]:\n        \"\"\"Extract contract pricing data from findings.\"\"\"\n        pricing = []\n\n        for f in findings:\n            if f.get(\"finding_type\") not in [\"financial\", \"contract\", \"pricing\"]:\n                continue\n\n            extracted = f.get(\"extracted_data\", {}) or {}\n            content = f.get(\"content\", \"\").lower()\n\n            if any(term in content for term in [\"price\", \"cost\", \"rate\", \"fee\", \"value\"]):\n                pricing.append({\n                    \"item\": extracted.get(\"item\", extracted.get(\"service\", \"\"))[:50],\n                    \"vendor\": extracted.get(\"vendor\", extracted.get(\"contractor\", \"\")),\n                    \"price\": extracted.get(\"price\", extracted.get(\"amount\", \"\")),\n                    \"benchmark\": extracted.get(\"benchmark\", \"\"),\n                    \"variance\": extracted.get(\"variance\", extracted.get(\"difference\", \"\")),\n                    \"confidence\": f.get(\"confidence_score\", 0.5),\n                })\n\n        return pricing\n\n    @classmethod\n    def generate_pricing_table_html(cls, pricing: List[Dict]) -> str:\n        \"\"\"Generate pricing benchmark table HTML.\"\"\"\n        if not pricing:\n            return '<div class=\"empty-state\">No pricing data available</div>'\n\n        html_parts = []\n        html_parts.append('''\n<div class=\"pricing-table-section\">\n    <style>\n        .price-table { width: 100%; border-collapse: collapse; font-size: 11px; }\n        .price-table th { background: #f1f3f5; padding: 8px 10px; text-align: left; font-weight: 600; border: 1px solid #dee2e6; }\n        .price-table td { padding: 8px 10px; border: 1px solid #dee2e6; }\n        .price-table tr:nth-child(even) { background: #f8f9fa; }\n        .price-value { font-weight: 600; }\n        .variance-over { color: #dc2626; background: #fee2e2; padding: 2px 6px; border-radius: 3px; }\n        .variance-under { color: #059669; background: #d1fae5; padding: 2px 6px; border-radius: 3px; }\n    </style>\n    <table class=\"price-table\">\n        <thead>\n            <tr>\n                <th>Item/Service</th>\n                <th>Vendor</th>\n                <th>Price</th>\n                <th>Benchmark</th>\n                <th>Variance</th>\n            </tr>\n        </thead>\n        <tbody>\n''')\n\n        for item in pricing[:10]:\n            variance = str(item.get(\"variance\", \"\"))\n            variance_class = \"variance-over\" if \"over\" in variance.lower() or \"+\" in variance else \\\n                            \"variance-under\" if \"under\" in variance.lower() or \"-\" in variance else \"\"\n\n            html_parts.append(f'''            <tr>\n                <td>{html_mod.escape(str(item.get(\"item\", \"N/A\"))[:40])}</td>\n                <td>{html_mod.escape(str(item.get(\"vendor\", \"N/A\"))[:25])}</td>\n                <td class=\"price-value\">{html_mod.escape(str(item.get(\"price\", \"N/A\"))[:15])}</td>\n                <td>{html_mod.escape(str(item.get(\"benchmark\", \"-\"))[:15])}</td>\n                <td><span class=\"{variance_class}\">{html_mod.escape(variance[:15])}</span></td>\n            </tr>\\n''')\n\n        html_parts.append('        </tbody>\\n    </table>\\n</div>')\n        return ''.join(html_parts)\n\n\nclass EvidenceChain:\n    \"\"\"Generate evidence chain visualization for investigative reports.\"\"\"\n\n    @classmethod\n    def build_evidence_chain(cls, findings: List[Dict]) -> List[Dict]:\n        \"\"\"Build evidence chain from findings.\"\"\"\n        chain = []\n\n        # Get findings that have evidence/claims\n        for f in findings:\n            if f.get(\"finding_type\") not in [\"fact\", \"claim\", \"evidence\"]:\n                continue\n\n            extracted = f.get(\"extracted_data\", {}) or {}\n            supporting = f.get(\"supporting_sources\", [])\n\n            chain.append({\n                \"claim\": f.get(\"summary\", \"\")[:100],\n                \"evidence_type\": f.get(\"finding_type\", \"\"),\n                \"source_count\": len(supporting),\n                \"sources\": [s.get(\"title\", s.get(\"url\", \"\"))[:40] for s in supporting[:3]],\n                \"confidence\": f.get(\"confidence_score\", 0.5),\n                \"corroborated\": len(supporting) > 1,\n            })\n\n        # Sort by confidence\n        chain = sorted(chain, key=lambda c: c[\"confidence\"], reverse=True)\n        return chain[:10]\n\n    @classmethod\n    def generate_chain_html(cls, chain: List[Dict]) -> str:\n        \"\"\"Generate evidence chain visualization HTML.\"\"\"\n        if not chain:\n            return '<div class=\"empty-state\">No evidence chain data available</div>'\n\n        html_parts = []\n        html_parts.append('''\n<div class=\"evidence-chain-section\">\n    <style>\n        .ev-chain { display: flex; flex-direction: column; gap: 12px; }\n        .ev-chain-item { display: flex; gap: 12px; align-items: flex-start; }\n        .ev-chain-connector { width: 24px; display: flex; flex-direction: column; align-items: center; }\n        .ev-chain-dot { width: 12px; height: 12px; border-radius: 50%; background: #6366f1; }\n        .ev-chain-line { width: 2px; flex: 1; background: #e2e8f0; margin-top: 4px; }\n        .ev-chain-content { flex: 1; background: #f8f9fa; border-radius: 6px; padding: 10px 12px; border-left: 3px solid #6366f1; }\n        .ev-chain-claim { font-size: 12px; color: #1e293b; margin-bottom: 6px; }\n        .ev-chain-meta { display: flex; gap: 8px; flex-wrap: wrap; font-size: 10px; }\n        .ev-chain-badge { padding: 2px 6px; border-radius: 3px; background: #e2e8f0; color: #475569; }\n        .ev-chain-badge.corroborated { background: #d1fae5; color: #065f46; }\n        .ev-chain-sources { margin-top: 6px; font-size: 10px; color: #6b7280; }\n    </style>\n    <div class=\"ev-chain\">\n''')\n\n        for i, item in enumerate(chain):\n            corr_class = \"corroborated\" if item[\"corroborated\"] else \"\"\n            corr_text = \"Corroborated\" if item[\"corroborated\"] else \"Single Source\"\n\n            html_parts.append(f'''        <div class=\"ev-chain-item\">\n            <div class=\"ev-chain-connector\">\n                <div class=\"ev-chain-dot\"></div>\n                {'<div class=\"ev-chain-line\"></div>' if i < len(chain) - 1 else ''}\n            </div>\n            <div class=\"ev-chain-content\">\n                <div class=\"ev-chain-claim\">{html_mod.escape(item[\"claim\"])}</div>\n                <div class=\"ev-chain-meta\">\n                    <span class=\"ev-chain-badge\">{item[\"evidence_type\"].upper()}</span>\n                    <span class=\"ev-chain-badge {corr_class}\">{corr_text}</span>\n                    <span class=\"ev-chain-badge\">{int(item[\"confidence\"]*100)}% conf</span>\n                </div>\n                <div class=\"ev-chain-sources\">Sources: {\", \".join([html_mod.escape(s) for s in item[\"sources\"]])}</div>\n            </div>\n        </div>\\n''')\n\n        html_parts.append('    </div>\\n</div>')\n        return ''.join(html_parts)\n","numLines":1205,"startLine":1,"totalLines":1205}}}
[2026-01-30T09:07:44.604Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019YhWVrDgh8k5RJwFDmx4L4","type":"tool_result","content":"     1→\"\"\"\n     2→Report Component Renderer\n     3→\n     4→Bridge between report data and the component system.\n     5→Transforms research results into component-ready data structures.\n     6→\"\"\"\n     7→\n     8→from typing import Dict, Any, List, Optional\n     9→\n    10→try:\n    11→    from .report_components import (\n    12→        ComponentType, ComponentConfig, ReportHints,\n    13→        render_component, get_report_hints, get_default_components,\n    14→        TEMPLATE_REPORT_HINTS\n    15→    )\n    16→    from .report_component_styles import get_component_styles\n    17→except ImportError:\n    18→    from report_components import (\n    19→        ComponentType, ComponentConfig, ReportHints,\n    20→        render_component, get_report_hints, get_default_components,\n    21→        TEMPLATE_REPORT_HINTS\n    22→    )\n    23→    from report_component_styles import get_component_styles\n    24→\n    25→\n    26→def prepare_component_data(result: Dict[str, Any]) -> Dict[str, Any]:\n    27→    \"\"\"\n    28→    Transform research results into component-ready data structures.\n    29→\n    30→    Args:\n    31→        result: The research result dictionary\n    32→\n    33→    Returns:\n    34→        Dictionary with data ready for each component type\n    35→    \"\"\"\n    36→    findings = result.get(\"findings\", [])\n    37→    perspectives = result.get(\"perspectives\", [])\n    38→    sources = result.get(\"sources\", [])\n    39→    template = result.get(\"template\", \"unknown\")\n    40→    query = result.get(\"query\", \"\")\n    41→\n    42→    component_data = {}\n    43→\n    44→    # Verdict Hero data\n    45→    avg_conf = sum(f.get(\"confidence_score\", 0.5) for f in findings) / max(len(findings), 1)\n    46→    red_flags = [f for f in findings if f.get(\"finding_type\") in [\"red_flag\", \"warning_sign\", \"suspicious_element\"]]\n    47→\n    48→    verdict = \"Analysis Complete\"\n    49→    color = \"blue\"\n    50→    if len(red_flags) > 3:\n    51→        verdict = \"Significant Concerns\"\n    52→        color = \"red\"\n    53→    elif len(red_flags) > 0:\n    54→        verdict = \"Proceed with Caution\"\n    55→        color = \"yellow\"\n    56→    elif avg_conf >= 0.7:\n    57→        verdict = \"Strong Analysis\"\n    58→        color = \"green\"\n    59→\n    60→    component_data[\"verdict_hero\"] = {\n    61→        \"verdict\": verdict,\n    62→        \"score\": avg_conf,\n    63→        \"headline\": f\"{len(findings)} findings analyzed across {len(sources)} sources\",\n    64→        \"subtext\": f\"{len(red_flags)} concerns identified\" if red_flags else \"No major concerns detected\",\n    65→        \"color\": color,\n    66→    }\n    67→\n    68→    # Metric Cards data\n    69→    high_conf = len([f for f in findings if f.get(\"confidence_score\", 0) >= 0.8])\n    70→    high_cred_sources = len([s for s in sources if s.get(\"credibility_score\", 0) >= 0.8])\n    71→\n    72→    component_data[\"metric_cards\"] = {\n    73→        \"metrics\": [\n    74→            {\"label\": \"Total Findings\", \"value\": str(len(findings)), \"trend\": \"flat\"},\n    75→            {\"label\": \"High Confidence\", \"value\": str(high_conf), \"trend\": \"up\" if high_conf > len(findings) * 0.5 else \"flat\"},\n    76→            {\"label\": \"Sources\", \"value\": str(len(sources)), \"trend\": \"flat\"},\n    77→            {\"label\": \"High Credibility\", \"value\": str(high_cred_sources), \"trend\": \"up\" if high_cred_sources > len(sources) * 0.5 else \"flat\"},\n    78→            {\"label\": \"Perspectives\", \"value\": str(len(perspectives)), \"trend\": \"flat\"},\n    79→            {\"label\": \"Red Flags\", \"value\": str(len(red_flags)), \"trend\": \"down\" if red_flags else \"flat\"},\n    80→        ]\n    81→    }\n    82→\n    83→    # Findings Table data - now includes analysis field\n    84→    component_data[\"findings_table\"] = {\n    85→        \"findings\": [\n    86→            {\n    87→                \"type\": f.get(\"finding_type\", \"other\"),\n    88→                \"summary\": f.get(\"summary\", \"\"),\n    89→                \"content\": f.get(\"content\", \"\")[:200],\n    90→                \"analysis\": f.get(\"analysis\", \"\"),  # LLM's analytical commentary\n    91→                \"date\": f.get(\"date_referenced\", \"\") or f.get(\"date_range\", \"\"),\n    92→                \"confidence\": f.get(\"confidence_score\", 0.5),\n    93→            }\n    94→            for f in findings[:15]\n    95→        ]\n    96→    }\n    97→\n    98→    # Timeline data\n    99→    timeline_events = []\n   100→    for f in findings:\n   101→        if f.get(\"date_referenced\") or f.get(\"date_range\"):\n   102→            importance = \"high\" if f.get(\"confidence_score\", 0.5) >= 0.8 else \"normal\"\n   103→            if f.get(\"finding_type\") in [\"red_flag\", \"warning_sign\"]:\n   104→                importance = \"critical\"\n   105→            timeline_events.append({\n   106→                \"date\": f.get(\"date_referenced\", \"\") or f.get(\"date_range\", \"\"),\n   107→                \"title\": f.get(\"summary\", \"\")[:60],\n   108→                \"description\": f.get(\"content\", \"\")[:150],\n   109→                \"type\": f.get(\"finding_type\", \"\"),\n   110→                \"importance\": importance,\n   111→            })\n   112→    component_data[\"timeline\"] = {\"events\": timeline_events[:10]}\n   113→\n   114→    # Quote Carousel data - from perspective analyses\n   115→    quotes = []\n   116→    for p in perspectives:\n   117→        analysis = p.get(\"analysis_text\", \"\")\n   118→        if analysis and len(analysis) > 50:\n   119→            quotes.append({\n   120→                \"text\": analysis[:200] + \"...\" if len(analysis) > 200 else analysis,\n   121→                \"source\": p.get(\"perspective_type\", \"Expert\").replace(\"_\", \" \").title(),\n   122→                \"date\": \"\",\n   123→                \"sentiment\": \"neutral\",\n   124→            })\n   125→    component_data[\"quote_carousel\"] = {\"quotes\": quotes[:5]}\n   126→\n   127→    # Risk Matrix data\n   128→    risks = []\n   129→    for f in findings:\n   130→        if f.get(\"finding_type\") in [\"red_flag\", \"warning_sign\", \"risk\", \"concern\"]:\n   131→            conf = f.get(\"confidence_score\", 0.5)\n   132→            risks.append({\n   133→                \"name\": f.get(\"summary\", \"\")[:30],\n   134→                \"likelihood\": conf,\n   135→                \"impact\": 0.8 if f.get(\"finding_type\") == \"red_flag\" else 0.5,\n   136→                \"category\": f.get(\"finding_type\", \"general\"),\n   137→            })\n   138→    component_data[\"risk_matrix\"] = {\n   139→        \"risks\": risks[:10],\n   140→        \"x_label\": \"Likelihood\",\n   141→        \"y_label\": \"Impact\",\n   142→    }\n   143→\n   144→    # Checklist data\n   145→    checklist_items = []\n   146→    for f in findings[:12]:\n   147→        ftype = f.get(\"finding_type\", \"other\")\n   148→        status = \"checked\" if f.get(\"confidence_score\", 0.5) >= 0.8 else \"unchecked\"\n   149→        if ftype in [\"red_flag\", \"warning_sign\"]:\n   150→            status = \"critical\"\n   151→        elif ftype in [\"concern\", \"risk\"]:\n   152→            status = \"warning\"\n   153→        checklist_items.append({\n   154→            \"text\": f.get(\"summary\", \"\")[:80],\n   155→            \"status\": status,\n   156→            \"severity\": \"critical\" if status == \"critical\" else \"info\",\n   157→            \"detail\": f.get(\"content\", \"\")[:100],\n   158→        })\n   159→    component_data[\"checklist\"] = {\"items\": checklist_items}\n   160→\n   161→    # Source List data\n   162→    component_data[\"source_list\"] = {\n   163→        \"sources\": [\n   164→            {\n   165→                \"title\": s.get(\"title\", \"Unknown\")[:60],\n   166→                \"url\": s.get(\"url\", \"#\"),\n   167→                \"credibility\": \"high\" if s.get(\"credibility_score\", 0.5) >= 0.8 else \"medium\" if s.get(\"credibility_score\", 0.5) >= 0.6 else \"low\",\n   168→                \"type\": s.get(\"source_type\", \"web\"),\n   169→                \"date\": \"\",\n   170→            }\n   171→            for s in sources[:15]\n   172→        ]\n   173→    }\n   174→\n   175→    # Prediction Cards data\n   176→    all_predictions = []\n   177→    for p in perspectives:\n   178→        for pred in p.get(\"predictions\", []):\n   179→            if isinstance(pred, dict):\n   180→                all_predictions.append({\n   181→                    \"prediction\": pred.get(\"prediction\", \"\"),\n   182→                    \"rationale\": pred.get(\"rationale\", \"\"),\n   183→                    \"confidence\": pred.get(\"confidence\", \"medium\"),\n   184→                    \"timeline\": pred.get(\"timeline\", \"\"),\n   185→                    \"source_perspective\": p.get(\"perspective_type\", \"analyst\"),\n   186→                })\n   187→    component_data[\"prediction_cards\"] = {\"predictions\": all_predictions[:8]}\n   188→\n   189→    # Key Insights data - now includes descriptions from findings analysis\n   190→    insights = []\n   191→    # First pull top findings with analysis as insights\n   192→    for f in findings[:5]:\n   193→        if f.get(\"analysis\"):\n   194→            insights.append({\n   195→                \"insight\": f.get(\"summary\", \"\"),\n   196→                \"description\": f.get(\"analysis\", \"\"),\n   197→                \"category\": f.get(\"finding_type\", \"\").replace(\"_\", \" \").title(),\n   198→                \"importance\": \"high\" if f.get(\"confidence_score\", 0) >= 0.85 else \"normal\",\n   199→            })\n   200→    # Fill remaining from perspectives if needed\n   201→    for p in perspectives:\n   202→        if len(insights) >= 6:\n   203→            break\n   204→        for insight in p.get(\"key_insights\", [])[:1]:\n   205→            insights.append({\n   206→                \"insight\": insight,\n   207→                \"description\": \"\",  # Perspective insights don't have separate description\n   208→                \"category\": p.get(\"perspective_type\", \"\").replace(\"_\", \" \").title(),\n   209→                \"importance\": \"normal\",\n   210→            })\n   211→    component_data[\"key_insights\"] = {\"insights\": insights[:6]}\n   212→\n   213→    # Executive Summary data\n   214→    summary_text = \"\"\n   215→    key_points = []\n   216→    for p in perspectives[:1]:\n   217→        summary_text = p.get(\"analysis_text\", \"\")[:500]\n   218→        key_points = p.get(\"key_insights\", [])[:5]\n   219→    component_data[\"executive_summary\"] = {\n   220→        \"summary\": summary_text,\n   221→        \"key_points\": key_points,\n   222→        \"recommendation\": \"\",\n   223→    }\n   224→\n   225→    # Confidence Gauge data\n   226→    confidence_factors = []\n   227→    finding_types = {}\n   228→    for f in findings:\n   229→        ft = f.get(\"finding_type\", \"other\")\n   230→        if ft not in finding_types:\n   231→            finding_types[ft] = []\n   232→        finding_types[ft].append(f.get(\"confidence_score\", 0.5))\n   233→\n   234→    for ft, scores in list(finding_types.items())[:5]:\n   235→        avg = sum(scores) / len(scores)\n   236→        confidence_factors.append({\n   237→            \"name\": ft.replace(\"_\", \" \").title(),\n   238→            \"score\": avg,\n   239→        })\n   240→    component_data[\"confidence_gauge\"] = {\n   241→        \"score\": avg_conf,\n   242→        \"label\": \"Overall Confidence\",\n   243→        \"factors\": confidence_factors,\n   244→    }\n   245→\n   246→    # Action Items data (from warnings and recommendations)\n   247→    actions = []\n   248→    for p in perspectives:\n   249→        for warning in p.get(\"warnings\", [])[:2]:\n   250→            actions.append({\n   251→                \"action\": f\"Address: {warning}\",\n   252→                \"priority\": \"high\",\n   253→                \"owner\": \"\",\n   254→                \"deadline\": \"\",\n   255→            })\n   256→    for f in findings:\n   257→        if f.get(\"finding_type\") == \"recommendation\":\n   258→            actions.append({\n   259→                \"action\": f.get(\"summary\", \"\")[:80],\n   260→                \"priority\": \"medium\",\n   261→                \"owner\": \"\",\n   262→                \"deadline\": \"\",\n   263→            })\n   264→    component_data[\"action_items\"] = {\"actions\": actions[:6]}\n   265→\n   266→    # Pros & Cons data\n   267→    pros = []\n   268→    cons = []\n   269→    for f in findings:\n   270→        if f.get(\"finding_type\") in [\"strength\", \"positive\", \"opportunity\", \"product_strength\"]:\n   271→            pros.append({\"text\": f.get(\"summary\", \"\")[:80], \"weight\": \"normal\"})\n   272→        elif f.get(\"finding_type\") in [\"weakness\", \"negative\", \"risk\", \"red_flag\", \"product_weakness\"]:\n   273→            cons.append({\"text\": f.get(\"summary\", \"\")[:80], \"weight\": \"normal\"})\n   274→    component_data[\"pros_cons\"] = {\"pros\": pros[:6], \"cons\": cons[:6]}\n   275→\n   276→    # Comparison Table data (generic)\n   277→    component_data[\"comparison_table\"] = {\n   278→        \"headers\": [\"Aspect\", \"Finding\", \"Confidence\"],\n   279→        \"rows\": [\n   280→            [f.get(\"finding_type\", \"\").replace(\"_\", \" \").title(),\n   281→             f.get(\"summary\", \"\")[:50],\n   282→             f\"{int(f.get('confidence_score', 0.5) * 100)}%\"]\n   283→            for f in findings[:8]\n   284→        ],\n   285→        \"highlight_column\": -1,\n   286→    }\n   287→\n   288→    # Template-specific component data\n   289→    component_data = _prepare_template_specific_data(component_data, result, template)\n   290→\n   291→    return component_data\n   292→\n   293→\n   294→def _prepare_template_specific_data(data: Dict[str, Any], result: Dict[str, Any], template: str) -> Dict[str, Any]:\n   295→    \"\"\"Prepare template-specific component data with fallback handling for legacy finding types.\"\"\"\n   296→    findings = result.get(\"findings\", [])\n   297→    perspectives = result.get(\"perspectives\", [])\n   298→\n   299→    if template == \"tech_market\":\n   300→        # Tech Radar data - accept both new and legacy finding types\n   301→        # New types: tech_trend, market_trend, adoption_pattern\n   302→        # Legacy types: product_launch, funding_round, adoption_trend, market_metric\n   303→        tech_types = [\"tech_trend\", \"adoption_pattern\", \"market_trend\",\n   304→                      \"product_launch\", \"adoption_trend\", \"market_metric\"]\n   305→        technologies = []\n   306→        for f in findings:\n   307→            if f.get(\"finding_type\") in tech_types:\n   308→                # Try to get maturity from extracted_data, fallback to confidence-based\n   309→                extracted = f.get(\"extracted_data\", {}) or {}\n   310→                ring = extracted.get(\"maturity\", \"\")\n   311→                if ring not in [\"adopt\", \"trial\", \"assess\", \"hold\"]:\n   312→                    conf = f.get(\"confidence_score\", 0.5)\n   313→                    ring = \"adopt\" if conf >= 0.8 else \"trial\" if conf >= 0.6 else \"assess\" if conf >= 0.4 else \"hold\"\n   314→\n   315→                tech_name = extracted.get(\"technology\", \"\") or f.get(\"summary\", \"\")[:25]\n   316→                technologies.append({\n   317→                    \"name\": tech_name,\n   318→                    \"ring\": ring,\n   319→                    \"quadrant\": \"tools\",\n   320→                    \"moved\": \"none\",\n   321→                    \"description\": f.get(\"content\", \"\")[:100],\n   322→                })\n   323→        data[\"tech_radar\"] = {\"technologies\": technologies[:16]}\n   324→\n   325→    elif template == \"financial\":\n   326→        # Investment Thesis data - accept both new and legacy finding types\n   327→        # New types: bullish_signal, bearish_signal, risk, red_flag, financial_metric\n   328→        # Legacy types: fact, event, evidence, pattern, claim, prediction\n   329→        bull_points = []\n   330→        bear_points = []\n   331→        metrics_data = []\n   332→\n   333→        for f in findings:\n   334→            ftype = f.get(\"finding_type\", \"\")\n   335→            summary = f.get(\"summary\", \"\") or f.get(\"content\", \"\")[:100]\n   336→            conf = f.get(\"confidence_score\", 0.5)\n   337→\n   338→            # Direct mappings for new types\n   339→            if ftype in [\"bullish_signal\", \"positive\", \"strength\"]:\n   340→                bull_points.append(summary)\n   341→            elif ftype in [\"bearish_signal\", \"negative\", \"risk\", \"red_flag\"]:\n   342→                bear_points.append(summary)\n   343→            elif ftype == \"financial_metric\":\n   344→                extracted = f.get(\"extracted_data\", {}) or {}\n   345→                if extracted.get(\"target_price\"):\n   346→                    metrics_data.append(extracted)\n   347→                # High confidence metrics are bullish, low are bearish\n   348→                if conf >= 0.7:\n   349→                    bull_points.append(summary)\n   350→                elif conf < 0.5:\n   351→                    bear_points.append(summary)\n   352→            # Legacy type fallbacks - analyze content/confidence\n   353→            elif ftype in [\"fact\", \"event\", \"evidence\"]:\n   354→                if conf >= 0.7:\n   355→                    bull_points.append(summary)\n   356→            elif ftype in [\"pattern\", \"gap\"]:\n   357→                bear_points.append(summary)  # Patterns/gaps often indicate risks\n   358→            elif ftype == \"prediction\":\n   359→                if conf >= 0.6:\n   360→                    bull_points.append(summary)\n   361→\n   362→        # Extract price targets from metrics if available\n   363→        target_price = \"N/A\"\n   364→        for m in metrics_data:\n   365→            if m.get(\"target_price\"):\n   366→                target_price = m.get(\"target_price\")\n   367→                break\n   368→\n   369→        # Determine verdict based on bull/bear balance\n   370→        verdict = \"Hold\"\n   371→        if len(bull_points) > len(bear_points) * 1.5:\n   372→            verdict = \"Buy\"\n   373→        elif len(bear_points) > len(bull_points) * 1.5:\n   374→            verdict = \"Sell\"\n   375→\n   376→        data[\"investment_thesis\"] = {\n   377→            \"verdict\": verdict,\n   378→            \"target_price\": target_price,\n   379→            \"current_price\": \"N/A\",\n   380→            \"upside\": \"N/A\",\n   381→            \"risk_level\": \"High\" if len(bear_points) > 5 else \"Medium\" if len(bear_points) > 2 else \"Low\",\n   382→            \"time_horizon\": \"12 months\",\n   383→            \"bull_case\": \" \".join(bull_points[:2]) if bull_points else \"Limited upside catalysts identified\",\n   384→            \"bear_case\": \" \".join(bear_points[:2]) if bear_points else \"Limited downside risks identified\",\n   385→            \"key_catalysts\": bull_points[:4] if bull_points else [\"Strong fundamentals\"],\n   386→            \"key_risks\": bear_points[:4] if bear_points else [\"Market volatility\"],\n   387→        }\n   388→\n   389→    elif template == \"competitive\":\n   390→        # Competitor Matrix data\n   391→        competitors = []\n   392→        for f in findings:\n   393→            if f.get(\"finding_type\") in [\"competitor_analysis\", \"market_position\"]:\n   394→                extracted = f.get(\"extracted_data\", {}) or {}\n   395→                competitors.append({\n   396→                    \"name\": extracted.get(\"company\", f.get(\"summary\", \"\")[:20]),\n   397→                    \"scores\": {\n   398→                        \"Market Share\": extracted.get(\"market_share_score\", 5),\n   399→                        \"Product\": extracted.get(\"product_score\", 5),\n   400→                        \"Price\": extracted.get(\"price_score\", 5),\n   401→                        \"Support\": extracted.get(\"support_score\", 5),\n   402→                    }\n   403→                })\n   404→        data[\"competitor_matrix\"] = {\n   405→            \"competitors\": competitors[:6] if competitors else [\n   406→                {\"name\": \"Company A\", \"scores\": {\"Market Share\": 7, \"Product\": 8, \"Price\": 6, \"Support\": 7}},\n   407→                {\"name\": \"Company B\", \"scores\": {\"Market Share\": 6, \"Product\": 7, \"Price\": 8, \"Support\": 6}},\n   408→            ],\n   409→            \"categories\": [\"Market Share\", \"Product\", \"Price\", \"Support\"],\n   410→            \"leader\": competitors[0][\"name\"] if competitors else \"Company A\",\n   411→        }\n   412→\n   413→    elif template == \"investigative\":\n   414→        # Investigation Timeline data\n   415→        events = []\n   416→        for f in findings:\n   417→            if f.get(\"date_referenced\") or f.get(\"date_range\"):\n   418→                event_type = \"development\"\n   419→                if f.get(\"finding_type\") in [\"evidence\", \"revelation\"]:\n   420→                    event_type = \"revelation\"\n   421→                elif f.get(\"finding_type\") in [\"legal_action\", \"court_ruling\"]:\n   422→                    event_type = \"legal\"\n   423→                elif f.get(\"finding_type\") in [\"financial_event\", \"transaction\"]:\n   424→                    event_type = \"financial\"\n   425→\n   426→                events.append({\n   427→                    \"date\": f.get(\"date_referenced\", \"\") or f.get(\"date_range\", \"\"),\n   428→                    \"title\": f.get(\"summary\", \"\")[:60],\n   429→                    \"description\": f.get(\"content\", \"\")[:200],\n   430→                    \"type\": event_type,\n   431→                    \"severity\": \"high\" if f.get(\"confidence_score\", 0.5) >= 0.8 else \"medium\",\n   432→                    \"sources\": [],\n   433→                    \"key_actors\": [],\n   434→                })\n   435→        data[\"investigation_timeline\"] = {\"events\": events[:12]}\n   436→\n   437→    elif template == \"legal\":\n   438→        # Legal Case Tracker data\n   439→        cases = []\n   440→        for f in findings:\n   441→            if f.get(\"finding_type\") in [\"case_analysis\", \"ruling\", \"precedent\", \"legal_action\"]:\n   442→                extracted = f.get(\"extracted_data\", {}) or {}\n   443→                cases.append({\n   444→                    \"name\": extracted.get(\"case_name\", f.get(\"summary\", \"\")[:40]),\n   445→                    \"jurisdiction\": extracted.get(\"jurisdiction\", \"\"),\n   446→                    \"status\": extracted.get(\"status\", \"pending\"),\n   447→                    \"parties\": extracted.get(\"parties\", []),\n   448→                    \"key_dates\": [],\n   449→                    \"implications\": f.get(\"content\", \"\")[:150],\n   450→                    \"ruling\": extracted.get(\"ruling\", \"\"),\n   451→                })\n   452→        data[\"legal_case_tracker\"] = {\"cases\": cases[:5]}\n   453→\n   454→    elif template == \"contract\":\n   455→        # Contract Analysis data\n   456→        red_flags = [f.get(\"summary\", \"\") for f in findings if f.get(\"finding_type\") in [\"red_flag\", \"suspicious_element\"]]\n   457→        opportunities = [f.get(\"summary\", \"\") for f in findings if f.get(\"finding_type\") in [\"opportunity\", \"positive\"]]\n   458→\n   459→        data[\"contract_analysis\"] = {\n   460→            \"contract\": {\n   461→                \"name\": result.get(\"query\", \"Contract\")[:50],\n   462→                \"value\": \"TBD\",\n   463→                \"duration\": \"TBD\",\n   464→                \"parties\": [],\n   465→                \"type\": \"Government Contract\",\n   466→            },\n   467→            \"key_terms\": [],\n   468→            \"obligations\": [],\n   469→            \"red_flags\": red_flags[:4],\n   470→            \"opportunities\": opportunities[:4],\n   471→        }\n   472→\n   473→    elif template == \"due_diligence\":\n   474→        # Due Diligence Scorecard data\n   475→        red_flags = [f for f in findings if f.get(\"finding_type\") in [\"red_flag\", \"warning_sign\"]]\n   476→        strengths = [f.get(\"summary\", \"\") for f in findings if f.get(\"finding_type\") in [\"strength\", \"positive\"]]\n   477→\n   478→        # Calculate overall score\n   479→        avg_conf = sum(f.get(\"confidence_score\", 0.5) for f in findings) / max(len(findings), 1)\n   480→        red_flag_penalty = len(red_flags) * 10\n   481→        overall_score = max(0, min(100, int(avg_conf * 100) - red_flag_penalty))\n   482→\n   483→        recommendation = \"Proceed with Caution\"\n   484→        if overall_score >= 70:\n   485→            recommendation = \"Recommended\"\n   486→        elif overall_score < 50:\n   487→            recommendation = \"Not Recommended\"\n   488→\n   489→        data[\"due_diligence_scorecard\"] = {\n   490→            \"overall_score\": overall_score,\n   491→            \"recommendation\": recommendation,\n   492→            \"categories\": [\n   493→                {\"name\": \"Financial Health\", \"score\": 60, \"findings\": [], \"weight\": 1.0},\n   494→                {\"name\": \"Legal Standing\", \"score\": 70, \"findings\": [], \"weight\": 1.0},\n   495→                {\"name\": \"Reputation\", \"score\": 65, \"findings\": [], \"weight\": 1.0},\n   496→            ],\n   497→            \"red_flags\": [\n   498→                {\"issue\": rf.get(\"summary\", \"\"), \"severity\": \"high\", \"details\": rf.get(\"content\", \"\")[:100]}\n   499→                for rf in red_flags[:5]\n   500→            ],\n   501→            \"strengths\": strengths[:5],\n   502→        }\n   503→\n   504→    elif template == \"purchase_decision\":\n   505→        # Decision Matrix data\n   506→        options = []\n   507→        criteria = [\n   508→            {\"name\": \"Quality\", \"weight\": 1.0},\n   509→            {\"name\": \"Price\", \"weight\": 1.0},\n   510→            {\"name\": \"Features\", \"weight\": 0.8},\n   511→            {\"name\": \"Support\", \"weight\": 0.6},\n   512→        ]\n   513→\n   514→        # Extract options from findings\n   515→        for f in findings:\n   516→            if f.get(\"finding_type\") in [\"alternative_option\", \"product_comparison\"]:\n   517→                extracted = f.get(\"extracted_data\", {}) or {}\n   518→                options.append({\n   519→                    \"name\": extracted.get(\"product\", f.get(\"summary\", \"\")[:20]),\n   520→                    \"scores\": {\n   521→                        \"Quality\": extracted.get(\"quality_score\", 5),\n   522→                        \"Price\": extracted.get(\"price_score\", 5),\n   523→                        \"Features\": extracted.get(\"features_score\", 5),\n   524→                        \"Support\": extracted.get(\"support_score\", 5),\n   525→                    },\n   526→                    \"price\": extracted.get(\"price\", \"N/A\"),\n   527→                    \"recommendation\": False,\n   528→                })\n   529→\n   530→        if not options:\n   531→            options = [\n   532→                {\"name\": \"Option A\", \"scores\": {\"Quality\": 8, \"Price\": 6, \"Features\": 7, \"Support\": 8}, \"price\": \"$$$\", \"recommendation\": True},\n   533→                {\"name\": \"Option B\", \"scores\": {\"Quality\": 7, \"Price\": 8, \"Features\": 6, \"Support\": 7}, \"price\": \"$$\", \"recommendation\": False},\n   534→            ]\n   535→\n   536→        # Determine winner\n   537→        winner = max(options, key=lambda x: sum(x[\"scores\"].values())) if options else None\n   538→\n   539→        data[\"decision_matrix\"] = {\n   540→            \"options\": options[:5],\n   541→            \"criteria\": criteria,\n   542→            \"winner\": winner[\"name\"] if winner else \"\",\n   543→        }\n   544→\n   545→    elif template == \"reputation\":\n   546→        # Trust Dashboard data\n   547→        warnings = [f for f in findings if f.get(\"finding_type\") in [\"warning_sign\", \"red_flag\"]]\n   548→        trust_signals = [f for f in findings if f.get(\"finding_type\") in [\"trust_signal\", \"positive\"]]\n   549→\n   550→        trust_score = 50  # Start at neutral\n   551→        trust_score += len(trust_signals) * 10\n   552→        trust_score -= len(warnings) * 15\n   553→        trust_score = max(0, min(100, trust_score))\n   554→\n   555→        verdict = \"Unknown\"\n   556→        if trust_score >= 70:\n   557→            verdict = \"Appears Legitimate\"\n   558→        elif trust_score >= 40:\n   559→            verdict = \"Proceed with Caution\"\n   560→        else:\n   561→            verdict = \"Not Recommended\"\n   562→\n   563→        data[\"trust_dashboard\"] = {\n   564→            \"trust_score\": trust_score,\n   565→            \"verdict\": verdict,\n   566→            \"verification_status\": \"partially_verified\",\n   567→            \"trust_factors\": [\n   568→                {\"name\": \"Business Registration\", \"score\": 70, \"status\": \"positive\"},\n   569→                {\"name\": \"Customer Reviews\", \"score\": 60, \"status\": \"neutral\"},\n   570→                {\"name\": \"Online Presence\", \"score\": 55, \"status\": \"neutral\"},\n   571→            ],\n   572→            \"user_sentiment\": {\"positive\": 45, \"neutral\": 30, \"negative\": 25},\n   573→            \"red_flags\": [f.get(\"summary\", \"\") for f in warnings[:5]],\n   574→            \"green_flags\": [f.get(\"summary\", \"\") for f in trust_signals[:5]],\n   575→        }\n   576→\n   577→    elif template == \"understanding\":\n   578→        # Event Explainer data\n   579→        query = result.get(\"query\", \"Event\")\n   580→\n   581→        # Get key players from findings\n   582→        key_players = []\n   583→        for f in findings:\n   584→            if f.get(\"finding_type\") in [\"actor\", \"stakeholder\"]:\n   585→                extracted = f.get(\"extracted_data\", {}) or {}\n   586→                key_players.append({\n   587→                    \"name\": extracted.get(\"name\", f.get(\"summary\", \"\")[:30]),\n   588→                    \"role\": extracted.get(\"role\", \"\"),\n   589→                    \"action\": extracted.get(\"action\", \"\"),\n   590→                })\n   591→\n   592→        # Build timeline from dated findings\n   593→        timeline = []\n   594→        for f in findings:\n   595→            if f.get(\"date_referenced\") or f.get(\"date_range\"):\n   596→                timeline.append({\n   597→                    \"date\": f.get(\"date_referenced\", \"\") or f.get(\"date_range\", \"\"),\n   598→                    \"event\": f.get(\"summary\", \"\"),\n   599→                })\n   600→\n   601→        # Get implications\n   602→        implications = []\n   603→        for f in findings:\n   604→            if f.get(\"finding_type\") in [\"implication\", \"impact\", \"consequence\"]:\n   605→                implications.append({\n   606→                    \"area\": f.get(\"extracted_data\", {}).get(\"area\", \"General\"),\n   607→                    \"impact\": f.get(\"summary\", \"\"),\n   608→                })\n   609→\n   610→        data[\"event_explainer\"] = {\n   611→            \"event\": {\n   612→                \"title\": query[:60],\n   613→                \"date\": \"\",\n   614→                \"summary\": perspectives[0].get(\"analysis_text\", \"\")[:200] if perspectives else \"\",\n   615→            },\n   616→            \"what_happened\": perspectives[0].get(\"analysis_text\", \"\")[:300] if perspectives else \"\",\n   617→            \"why_it_matters\": \"\",\n   618→            \"key_players\": key_players[:5],\n   619→            \"timeline\": timeline[:6],\n   620→            \"implications\": implications[:4],\n   621→            \"different_perspectives\": [\n   622→                {\"perspective\": p.get(\"perspective_type\", \"\").replace(\"_\", \" \").title(),\n   623→                 \"view\": p.get(\"analysis_text\", \"\")[:150]}\n   624→                for p in perspectives[:3]\n   625→            ],\n   626→        }\n   627→\n   628→    return data\n   629→\n   630→\n   631→def render_template_components(result: Dict[str, Any], hints: Optional[ReportHints] = None) -> str:\n   632→    \"\"\"\n   633→    Render all components for a report based on template hints.\n   634→\n   635→    Args:\n   636→        result: Research result dictionary\n   637→        hints: Optional ReportHints override\n   638→\n   639→    Returns:\n   640→        HTML string with rendered components\n   641→    \"\"\"\n   642→    template = result.get(\"template\", \"unknown\")\n   643→\n   644→    # Get hints from template or use default\n   645→    if hints is None:\n   646→        hints = TEMPLATE_REPORT_HINTS.get(template, ReportHints(template_type=template))\n   647→\n   648→    # Prepare component data\n   649→    component_data = prepare_component_data(result)\n   650→\n   651→    # Get components to render\n   652→    components = []\n   653→\n   654→    # Add required components\n   655→    for comp_type in hints.required_components:\n   656→        config = ComponentConfig(\n   657→            component_type=comp_type,\n   658→            priority=90,\n   659→            position=\"main\"\n   660→        )\n   661→        components.append((comp_type, config))\n   662→\n   663→    # Add optional components\n   664→    for comp_type in hints.optional_components:\n   665→        config = ComponentConfig(\n   666→            component_type=comp_type,\n   667→            priority=50,\n   668→            position=\"main\"\n   669→        )\n   670→        components.append((comp_type, config))\n   671→\n   672→    # Render components\n   673→    html_parts = []\n   674→    for comp_type, config in components:\n   675→        data_key = comp_type.value\n   676→        if data_key in component_data:\n   677→            try:\n   678→                rendered = render_component(comp_type, component_data[data_key], config)\n   679→                html_parts.append(rendered)\n   680→            except Exception as e:\n   681→                html_parts.append(f'<!-- Component {comp_type.value} error: {e} -->')\n   682→\n   683→    return \"\\n\".join(html_parts)\n   684→\n   685→\n   686→def get_component_css() -> str:\n   687→    \"\"\"Get all component CSS styles.\"\"\"\n   688→    return get_component_styles()\n   689→\n   690→\n   691→def render_component_section(result: Dict[str, Any], component_type: ComponentType,\n   692→                             title: Optional[str] = None) -> str:\n   693→    \"\"\"\n   694→    Render a single component section.\n   695→\n   696→    Args:\n   697→        result: Research result dictionary\n   698→        component_type: The component type to render\n   699→        title: Optional title override\n   700→\n   701→    Returns:\n   702→        HTML string for the component section\n   703→    \"\"\"\n   704→    component_data = prepare_component_data(result)\n   705→    data_key = component_type.value\n   706→\n   707→    if data_key not in component_data:\n   708→        return f'<!-- No data for component {component_type.value} -->'\n   709→\n   710→    config = ComponentConfig(\n   711→        component_type=component_type,\n   712→        title=title,\n   713→        position=\"main\"\n   714→    )\n   715→\n   716→    return render_component(component_type, component_data[data_key], config)\n   717→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"34eb5170-c9bb-41ec-b332-c49ff6c57668","uuid":"403c229f-61e8-4c0b-bf82-3c918d5ed439","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\actor\\src\\services\\report_component_renderer.py","content":"\"\"\"\nReport Component Renderer\n\nBridge between report data and the component system.\nTransforms research results into component-ready data structures.\n\"\"\"\n\nfrom typing import Dict, Any, List, Optional\n\ntry:\n    from .report_components import (\n        ComponentType, ComponentConfig, ReportHints,\n        render_component, get_report_hints, get_default_components,\n        TEMPLATE_REPORT_HINTS\n    )\n    from .report_component_styles import get_component_styles\nexcept ImportError:\n    from report_components import (\n        ComponentType, ComponentConfig, ReportHints,\n        render_component, get_report_hints, get_default_components,\n        TEMPLATE_REPORT_HINTS\n    )\n    from report_component_styles import get_component_styles\n\n\ndef prepare_component_data(result: Dict[str, Any]) -> Dict[str, Any]:\n    \"\"\"\n    Transform research results into component-ready data structures.\n\n    Args:\n        result: The research result dictionary\n\n    Returns:\n        Dictionary with data ready for each component type\n    \"\"\"\n    findings = result.get(\"findings\", [])\n    perspectives = result.get(\"perspectives\", [])\n    sources = result.get(\"sources\", [])\n    template = result.get(\"template\", \"unknown\")\n    query = result.get(\"query\", \"\")\n\n    component_data = {}\n\n    # Verdict Hero data\n    avg_conf = sum(f.get(\"confidence_score\", 0.5) for f in findings) / max(len(findings), 1)\n    red_flags = [f for f in findings if f.get(\"finding_type\") in [\"red_flag\", \"warning_sign\", \"suspicious_element\"]]\n\n    verdict = \"Analysis Complete\"\n    color = \"blue\"\n    if len(red_flags) > 3:\n        verdict = \"Significant Concerns\"\n        color = \"red\"\n    elif len(red_flags) > 0:\n        verdict = \"Proceed with Caution\"\n        color = \"yellow\"\n    elif avg_conf >= 0.7:\n        verdict = \"Strong Analysis\"\n        color = \"green\"\n\n    component_data[\"verdict_hero\"] = {\n        \"verdict\": verdict,\n        \"score\": avg_conf,\n        \"headline\": f\"{len(findings)} findings analyzed across {len(sources)} sources\",\n        \"subtext\": f\"{len(red_flags)} concerns identified\" if red_flags else \"No major concerns detected\",\n        \"color\": color,\n    }\n\n    # Metric Cards data\n    high_conf = len([f for f in findings if f.get(\"confidence_score\", 0) >= 0.8])\n    high_cred_sources = len([s for s in sources if s.get(\"credibility_score\", 0) >= 0.8])\n\n    component_data[\"metric_cards\"] = {\n        \"metrics\": [\n            {\"label\": \"Total Findings\", \"value\": str(len(findings)), \"trend\": \"flat\"},\n            {\"label\": \"High Confidence\", \"value\": str(high_conf), \"trend\": \"up\" if high_conf > len(findings) * 0.5 else \"flat\"},\n            {\"label\": \"Sources\", \"value\": str(len(sources)), \"trend\": \"flat\"},\n            {\"label\": \"High Credibility\", \"value\": str(high_cred_sources), \"trend\": \"up\" if high_cred_sources > len(sources) * 0.5 else \"flat\"},\n            {\"label\": \"Perspectives\", \"value\": str(len(perspectives)), \"trend\": \"flat\"},\n            {\"label\": \"Red Flags\", \"value\": str(len(red_flags)), \"trend\": \"down\" if red_flags else \"flat\"},\n        ]\n    }\n\n    # Findings Table data - now includes analysis field\n    component_data[\"findings_table\"] = {\n        \"findings\": [\n            {\n                \"type\": f.get(\"finding_type\", \"other\"),\n                \"summary\": f.get(\"summary\", \"\"),\n                \"content\": f.get(\"content\", \"\")[:200],\n                \"analysis\": f.get(\"analysis\", \"\"),  # LLM's analytical commentary\n                \"date\": f.get(\"date_referenced\", \"\") or f.get(\"date_range\", \"\"),\n                \"confidence\": f.get(\"confidence_score\", 0.5),\n            }\n            for f in findings[:15]\n        ]\n    }\n\n    # Timeline data\n    timeline_events = []\n    for f in findings:\n        if f.get(\"date_referenced\") or f.get(\"date_range\"):\n            importance = \"high\" if f.get(\"confidence_score\", 0.5) >= 0.8 else \"normal\"\n            if f.get(\"finding_type\") in [\"red_flag\", \"warning_sign\"]:\n                importance = \"critical\"\n            timeline_events.append({\n                \"date\": f.get(\"date_referenced\", \"\") or f.get(\"date_range\", \"\"),\n                \"title\": f.get(\"summary\", \"\")[:60],\n                \"description\": f.get(\"content\", \"\")[:150],\n                \"type\": f.get(\"finding_type\", \"\"),\n                \"importance\": importance,\n            })\n    component_data[\"timeline\"] = {\"events\": timeline_events[:10]}\n\n    # Quote Carousel data - from perspective analyses\n    quotes = []\n    for p in perspectives:\n        analysis = p.get(\"analysis_text\", \"\")\n        if analysis and len(analysis) > 50:\n            quotes.append({\n                \"text\": analysis[:200] + \"...\" if len(analysis) > 200 else analysis,\n                \"source\": p.get(\"perspective_type\", \"Expert\").replace(\"_\", \" \").title(),\n                \"date\": \"\",\n                \"sentiment\": \"neutral\",\n            })\n    component_data[\"quote_carousel\"] = {\"quotes\": quotes[:5]}\n\n    # Risk Matrix data\n    risks = []\n    for f in findings:\n        if f.get(\"finding_type\") in [\"red_flag\", \"warning_sign\", \"risk\", \"concern\"]:\n            conf = f.get(\"confidence_score\", 0.5)\n            risks.append({\n                \"name\": f.get(\"summary\", \"\")[:30],\n                \"likelihood\": conf,\n                \"impact\": 0.8 if f.get(\"finding_type\") == \"red_flag\" else 0.5,\n                \"category\": f.get(\"finding_type\", \"general\"),\n            })\n    component_data[\"risk_matrix\"] = {\n        \"risks\": risks[:10],\n        \"x_label\": \"Likelihood\",\n        \"y_label\": \"Impact\",\n    }\n\n    # Checklist data\n    checklist_items = []\n    for f in findings[:12]:\n        ftype = f.get(\"finding_type\", \"other\")\n        status = \"checked\" if f.get(\"confidence_score\", 0.5) >= 0.8 else \"unchecked\"\n        if ftype in [\"red_flag\", \"warning_sign\"]:\n            status = \"critical\"\n        elif ftype in [\"concern\", \"risk\"]:\n            status = \"warning\"\n        checklist_items.append({\n            \"text\": f.get(\"summary\", \"\")[:80],\n            \"status\": status,\n            \"severity\": \"critical\" if status == \"critical\" else \"info\",\n            \"detail\": f.get(\"content\", \"\")[:100],\n        })\n    component_data[\"checklist\"] = {\"items\": checklist_items}\n\n    # Source List data\n    component_data[\"source_list\"] = {\n        \"sources\": [\n            {\n                \"title\": s.get(\"title\", \"Unknown\")[:60],\n                \"url\": s.get(\"url\", \"#\"),\n                \"credibility\": \"high\" if s.get(\"credibility_score\", 0.5) >= 0.8 else \"medium\" if s.get(\"credibility_score\", 0.5) >= 0.6 else \"low\",\n                \"type\": s.get(\"source_type\", \"web\"),\n                \"date\": \"\",\n            }\n            for s in sources[:15]\n        ]\n    }\n\n    # Prediction Cards data\n    all_predictions = []\n    for p in perspectives:\n        for pred in p.get(\"predictions\", []):\n            if isinstance(pred, dict):\n                all_predictions.append({\n                    \"prediction\": pred.get(\"prediction\", \"\"),\n                    \"rationale\": pred.get(\"rationale\", \"\"),\n                    \"confidence\": pred.get(\"confidence\", \"medium\"),\n                    \"timeline\": pred.get(\"timeline\", \"\"),\n                    \"source_perspective\": p.get(\"perspective_type\", \"analyst\"),\n                })\n    component_data[\"prediction_cards\"] = {\"predictions\": all_predictions[:8]}\n\n    # Key Insights data - now includes descriptions from findings analysis\n    insights = []\n    # First pull top findings with analysis as insights\n    for f in findings[:5]:\n        if f.get(\"analysis\"):\n            insights.append({\n                \"insight\": f.get(\"summary\", \"\"),\n                \"description\": f.get(\"analysis\", \"\"),\n                \"category\": f.get(\"finding_type\", \"\").replace(\"_\", \" \").title(),\n                \"importance\": \"high\" if f.get(\"confidence_score\", 0) >= 0.85 else \"normal\",\n            })\n    # Fill remaining from perspectives if needed\n    for p in perspectives:\n        if len(insights) >= 6:\n            break\n        for insight in p.get(\"key_insights\", [])[:1]:\n            insights.append({\n                \"insight\": insight,\n                \"description\": \"\",  # Perspective insights don't have separate description\n                \"category\": p.get(\"perspective_type\", \"\").replace(\"_\", \" \").title(),\n                \"importance\": \"normal\",\n            })\n    component_data[\"key_insights\"] = {\"insights\": insights[:6]}\n\n    # Executive Summary data\n    summary_text = \"\"\n    key_points = []\n    for p in perspectives[:1]:\n        summary_text = p.get(\"analysis_text\", \"\")[:500]\n        key_points = p.get(\"key_insights\", [])[:5]\n    component_data[\"executive_summary\"] = {\n        \"summary\": summary_text,\n        \"key_points\": key_points,\n        \"recommendation\": \"\",\n    }\n\n    # Confidence Gauge data\n    confidence_factors = []\n    finding_types = {}\n    for f in findings:\n        ft = f.get(\"finding_type\", \"other\")\n        if ft not in finding_types:\n            finding_types[ft] = []\n        finding_types[ft].append(f.get(\"confidence_score\", 0.5))\n\n    for ft, scores in list(finding_types.items())[:5]:\n        avg = sum(scores) / len(scores)\n        confidence_factors.append({\n            \"name\": ft.replace(\"_\", \" \").title(),\n            \"score\": avg,\n        })\n    component_data[\"confidence_gauge\"] = {\n        \"score\": avg_conf,\n        \"label\": \"Overall Confidence\",\n        \"factors\": confidence_factors,\n    }\n\n    # Action Items data (from warnings and recommendations)\n    actions = []\n    for p in perspectives:\n        for warning in p.get(\"warnings\", [])[:2]:\n            actions.append({\n                \"action\": f\"Address: {warning}\",\n                \"priority\": \"high\",\n                \"owner\": \"\",\n                \"deadline\": \"\",\n            })\n    for f in findings:\n        if f.get(\"finding_type\") == \"recommendation\":\n            actions.append({\n                \"action\": f.get(\"summary\", \"\")[:80],\n                \"priority\": \"medium\",\n                \"owner\": \"\",\n                \"deadline\": \"\",\n            })\n    component_data[\"action_items\"] = {\"actions\": actions[:6]}\n\n    # Pros & Cons data\n    pros = []\n    cons = []\n    for f in findings:\n        if f.get(\"finding_type\") in [\"strength\", \"positive\", \"opportunity\", \"product_strength\"]:\n            pros.append({\"text\": f.get(\"summary\", \"\")[:80], \"weight\": \"normal\"})\n        elif f.get(\"finding_type\") in [\"weakness\", \"negative\", \"risk\", \"red_flag\", \"product_weakness\"]:\n            cons.append({\"text\": f.get(\"summary\", \"\")[:80], \"weight\": \"normal\"})\n    component_data[\"pros_cons\"] = {\"pros\": pros[:6], \"cons\": cons[:6]}\n\n    # Comparison Table data (generic)\n    component_data[\"comparison_table\"] = {\n        \"headers\": [\"Aspect\", \"Finding\", \"Confidence\"],\n        \"rows\": [\n            [f.get(\"finding_type\", \"\").replace(\"_\", \" \").title(),\n             f.get(\"summary\", \"\")[:50],\n             f\"{int(f.get('confidence_score', 0.5) * 100)}%\"]\n            for f in findings[:8]\n        ],\n        \"highlight_column\": -1,\n    }\n\n    # Template-specific component data\n    component_data = _prepare_template_specific_data(component_data, result, template)\n\n    return component_data\n\n\ndef _prepare_template_specific_data(data: Dict[str, Any], result: Dict[str, Any], template: str) -> Dict[str, Any]:\n    \"\"\"Prepare template-specific component data with fallback handling for legacy finding types.\"\"\"\n    findings = result.get(\"findings\", [])\n    perspectives = result.get(\"perspectives\", [])\n\n    if template == \"tech_market\":\n        # Tech Radar data - accept both new and legacy finding types\n        # New types: tech_trend, market_trend, adoption_pattern\n        # Legacy types: product_launch, funding_round, adoption_trend, market_metric\n        tech_types = [\"tech_trend\", \"adoption_pattern\", \"market_trend\",\n                      \"product_launch\", \"adoption_trend\", \"market_metric\"]\n        technologies = []\n        for f in findings:\n            if f.get(\"finding_type\") in tech_types:\n                # Try to get maturity from extracted_data, fallback to confidence-based\n                extracted = f.get(\"extracted_data\", {}) or {}\n                ring = extracted.get(\"maturity\", \"\")\n                if ring not in [\"adopt\", \"trial\", \"assess\", \"hold\"]:\n                    conf = f.get(\"confidence_score\", 0.5)\n                    ring = \"adopt\" if conf >= 0.8 else \"trial\" if conf >= 0.6 else \"assess\" if conf >= 0.4 else \"hold\"\n\n                tech_name = extracted.get(\"technology\", \"\") or f.get(\"summary\", \"\")[:25]\n                technologies.append({\n                    \"name\": tech_name,\n                    \"ring\": ring,\n                    \"quadrant\": \"tools\",\n                    \"moved\": \"none\",\n                    \"description\": f.get(\"content\", \"\")[:100],\n                })\n        data[\"tech_radar\"] = {\"technologies\": technologies[:16]}\n\n    elif template == \"financial\":\n        # Investment Thesis data - accept both new and legacy finding types\n        # New types: bullish_signal, bearish_signal, risk, red_flag, financial_metric\n        # Legacy types: fact, event, evidence, pattern, claim, prediction\n        bull_points = []\n        bear_points = []\n        metrics_data = []\n\n        for f in findings:\n            ftype = f.get(\"finding_type\", \"\")\n            summary = f.get(\"summary\", \"\") or f.get(\"content\", \"\")[:100]\n            conf = f.get(\"confidence_score\", 0.5)\n\n            # Direct mappings for new types\n            if ftype in [\"bullish_signal\", \"positive\", \"strength\"]:\n                bull_points.append(summary)\n            elif ftype in [\"bearish_signal\", \"negative\", \"risk\", \"red_flag\"]:\n                bear_points.append(summary)\n            elif ftype == \"financial_metric\":\n                extracted = f.get(\"extracted_data\", {}) or {}\n                if extracted.get(\"target_price\"):\n                    metrics_data.append(extracted)\n                # High confidence metrics are bullish, low are bearish\n                if conf >= 0.7:\n                    bull_points.append(summary)\n                elif conf < 0.5:\n                    bear_points.append(summary)\n            # Legacy type fallbacks - analyze content/confidence\n            elif ftype in [\"fact\", \"event\", \"evidence\"]:\n                if conf >= 0.7:\n                    bull_points.append(summary)\n            elif ftype in [\"pattern\", \"gap\"]:\n                bear_points.append(summary)  # Patterns/gaps often indicate risks\n            elif ftype == \"prediction\":\n                if conf >= 0.6:\n                    bull_points.append(summary)\n\n        # Extract price targets from metrics if available\n        target_price = \"N/A\"\n        for m in metrics_data:\n            if m.get(\"target_price\"):\n                target_price = m.get(\"target_price\")\n                break\n\n        # Determine verdict based on bull/bear balance\n        verdict = \"Hold\"\n        if len(bull_points) > len(bear_points) * 1.5:\n            verdict = \"Buy\"\n        elif len(bear_points) > len(bull_points) * 1.5:\n            verdict = \"Sell\"\n\n        data[\"investment_thesis\"] = {\n            \"verdict\": verdict,\n            \"target_price\": target_price,\n            \"current_price\": \"N/A\",\n            \"upside\": \"N/A\",\n            \"risk_level\": \"High\" if len(bear_points) > 5 else \"Medium\" if len(bear_points) > 2 else \"Low\",\n            \"time_horizon\": \"12 months\",\n            \"bull_case\": \" \".join(bull_points[:2]) if bull_points else \"Limited upside catalysts identified\",\n            \"bear_case\": \" \".join(bear_points[:2]) if bear_points else \"Limited downside risks identified\",\n            \"key_catalysts\": bull_points[:4] if bull_points else [\"Strong fundamentals\"],\n            \"key_risks\": bear_points[:4] if bear_points else [\"Market volatility\"],\n        }\n\n    elif template == \"competitive\":\n        # Competitor Matrix data\n        competitors = []\n        for f in findings:\n            if f.get(\"finding_type\") in [\"competitor_analysis\", \"market_position\"]:\n                extracted = f.get(\"extracted_data\", {}) or {}\n                competitors.append({\n                    \"name\": extracted.get(\"company\", f.get(\"summary\", \"\")[:20]),\n                    \"scores\": {\n                        \"Market Share\": extracted.get(\"market_share_score\", 5),\n                        \"Product\": extracted.get(\"product_score\", 5),\n                        \"Price\": extracted.get(\"price_score\", 5),\n                        \"Support\": extracted.get(\"support_score\", 5),\n                    }\n                })\n        data[\"competitor_matrix\"] = {\n            \"competitors\": competitors[:6] if competitors else [\n                {\"name\": \"Company A\", \"scores\": {\"Market Share\": 7, \"Product\": 8, \"Price\": 6, \"Support\": 7}},\n                {\"name\": \"Company B\", \"scores\": {\"Market Share\": 6, \"Product\": 7, \"Price\": 8, \"Support\": 6}},\n            ],\n            \"categories\": [\"Market Share\", \"Product\", \"Price\", \"Support\"],\n            \"leader\": competitors[0][\"name\"] if competitors else \"Company A\",\n        }\n\n    elif template == \"investigative\":\n        # Investigation Timeline data\n        events = []\n        for f in findings:\n            if f.get(\"date_referenced\") or f.get(\"date_range\"):\n                event_type = \"development\"\n                if f.get(\"finding_type\") in [\"evidence\", \"revelation\"]:\n                    event_type = \"revelation\"\n                elif f.get(\"finding_type\") in [\"legal_action\", \"court_ruling\"]:\n                    event_type = \"legal\"\n                elif f.get(\"finding_type\") in [\"financial_event\", \"transaction\"]:\n                    event_type = \"financial\"\n\n                events.append({\n                    \"date\": f.get(\"date_referenced\", \"\") or f.get(\"date_range\", \"\"),\n                    \"title\": f.get(\"summary\", \"\")[:60],\n                    \"description\": f.get(\"content\", \"\")[:200],\n                    \"type\": event_type,\n                    \"severity\": \"high\" if f.get(\"confidence_score\", 0.5) >= 0.8 else \"medium\",\n                    \"sources\": [],\n                    \"key_actors\": [],\n                })\n        data[\"investigation_timeline\"] = {\"events\": events[:12]}\n\n    elif template == \"legal\":\n        # Legal Case Tracker data\n        cases = []\n        for f in findings:\n            if f.get(\"finding_type\") in [\"case_analysis\", \"ruling\", \"precedent\", \"legal_action\"]:\n                extracted = f.get(\"extracted_data\", {}) or {}\n                cases.append({\n                    \"name\": extracted.get(\"case_name\", f.get(\"summary\", \"\")[:40]),\n                    \"jurisdiction\": extracted.get(\"jurisdiction\", \"\"),\n                    \"status\": extracted.get(\"status\", \"pending\"),\n                    \"parties\": extracted.get(\"parties\", []),\n                    \"key_dates\": [],\n                    \"implications\": f.get(\"content\", \"\")[:150],\n                    \"ruling\": extracted.get(\"ruling\", \"\"),\n                })\n        data[\"legal_case_tracker\"] = {\"cases\": cases[:5]}\n\n    elif template == \"contract\":\n        # Contract Analysis data\n        red_flags = [f.get(\"summary\", \"\") for f in findings if f.get(\"finding_type\") in [\"red_flag\", \"suspicious_element\"]]\n        opportunities = [f.get(\"summary\", \"\") for f in findings if f.get(\"finding_type\") in [\"opportunity\", \"positive\"]]\n\n        data[\"contract_analysis\"] = {\n            \"contract\": {\n                \"name\": result.get(\"query\", \"Contract\")[:50],\n                \"value\": \"TBD\",\n                \"duration\": \"TBD\",\n                \"parties\": [],\n                \"type\": \"Government Contract\",\n            },\n            \"key_terms\": [],\n            \"obligations\": [],\n            \"red_flags\": red_flags[:4],\n            \"opportunities\": opportunities[:4],\n        }\n\n    elif template == \"due_diligence\":\n        # Due Diligence Scorecard data\n        red_flags = [f for f in findings if f.get(\"finding_type\") in [\"red_flag\", \"warning_sign\"]]\n        strengths = [f.get(\"summary\", \"\") for f in findings if f.get(\"finding_type\") in [\"strength\", \"positive\"]]\n\n        # Calculate overall score\n        avg_conf = sum(f.get(\"confidence_score\", 0.5) for f in findings) / max(len(findings), 1)\n        red_flag_penalty = len(red_flags) * 10\n        overall_score = max(0, min(100, int(avg_conf * 100) - red_flag_penalty))\n\n        recommendation = \"Proceed with Caution\"\n        if overall_score >= 70:\n            recommendation = \"Recommended\"\n        elif overall_score < 50:\n            recommendation = \"Not Recommended\"\n\n        data[\"due_diligence_scorecard\"] = {\n            \"overall_score\": overall_score,\n            \"recommendation\": recommendation,\n            \"categories\": [\n                {\"name\": \"Financial Health\", \"score\": 60, \"findings\": [], \"weight\": 1.0},\n                {\"name\": \"Legal Standing\", \"score\": 70, \"findings\": [], \"weight\": 1.0},\n                {\"name\": \"Reputation\", \"score\": 65, \"findings\": [], \"weight\": 1.0},\n            ],\n            \"red_flags\": [\n                {\"issue\": rf.get(\"summary\", \"\"), \"severity\": \"high\", \"details\": rf.get(\"content\", \"\")[:100]}\n                for rf in red_flags[:5]\n            ],\n            \"strengths\": strengths[:5],\n        }\n\n    elif template == \"purchase_decision\":\n        # Decision Matrix data\n        options = []\n        criteria = [\n            {\"name\": \"Quality\", \"weight\": 1.0},\n            {\"name\": \"Price\", \"weight\": 1.0},\n            {\"name\": \"Features\", \"weight\": 0.8},\n            {\"name\": \"Support\", \"weight\": 0.6},\n        ]\n\n        # Extract options from findings\n        for f in findings:\n            if f.get(\"finding_type\") in [\"alternative_option\", \"product_comparison\"]:\n                extracted = f.get(\"extracted_data\", {}) or {}\n                options.append({\n                    \"name\": extracted.get(\"product\", f.get(\"summary\", \"\")[:20]),\n                    \"scores\": {\n                        \"Quality\": extracted.get(\"quality_score\", 5),\n                        \"Price\": extracted.get(\"price_score\", 5),\n                        \"Features\": extracted.get(\"features_score\", 5),\n                        \"Support\": extracted.get(\"support_score\", 5),\n                    },\n                    \"price\": extracted.get(\"price\", \"N/A\"),\n                    \"recommendation\": False,\n                })\n\n        if not options:\n            options = [\n                {\"name\": \"Option A\", \"scores\": {\"Quality\": 8, \"Price\": 6, \"Features\": 7, \"Support\": 8}, \"price\": \"$$$\", \"recommendation\": True},\n                {\"name\": \"Option B\", \"scores\": {\"Quality\": 7, \"Price\": 8, \"Features\": 6, \"Support\": 7}, \"price\": \"$$\", \"recommendation\": False},\n            ]\n\n        # Determine winner\n        winner = max(options, key=lambda x: sum(x[\"scores\"].values())) if options else None\n\n        data[\"decision_matrix\"] = {\n            \"options\": options[:5],\n            \"criteria\": criteria,\n            \"winner\": winner[\"name\"] if winner else \"\",\n        }\n\n    elif template == \"reputation\":\n        # Trust Dashboard data\n        warnings = [f for f in findings if f.get(\"finding_type\") in [\"warning_sign\", \"red_flag\"]]\n        trust_signals = [f for f in findings if f.get(\"finding_type\") in [\"trust_signal\", \"positive\"]]\n\n        trust_score = 50  # Start at neutral\n        trust_score += len(trust_signals) * 10\n        trust_score -= len(warnings) * 15\n        trust_score = max(0, min(100, trust_score))\n\n        verdict = \"Unknown\"\n        if trust_score >= 70:\n            verdict = \"Appears Legitimate\"\n        elif trust_score >= 40:\n            verdict = \"Proceed with Caution\"\n        else:\n            verdict = \"Not Recommended\"\n\n        data[\"trust_dashboard\"] = {\n            \"trust_score\": trust_score,\n            \"verdict\": verdict,\n            \"verification_status\": \"partially_verified\",\n            \"trust_factors\": [\n                {\"name\": \"Business Registration\", \"score\": 70, \"status\": \"positive\"},\n                {\"name\": \"Customer Reviews\", \"score\": 60, \"status\": \"neutral\"},\n                {\"name\": \"Online Presence\", \"score\": 55, \"status\": \"neutral\"},\n            ],\n            \"user_sentiment\": {\"positive\": 45, \"neutral\": 30, \"negative\": 25},\n            \"red_flags\": [f.get(\"summary\", \"\") for f in warnings[:5]],\n            \"green_flags\": [f.get(\"summary\", \"\") for f in trust_signals[:5]],\n        }\n\n    elif template == \"understanding\":\n        # Event Explainer data\n        query = result.get(\"query\", \"Event\")\n\n        # Get key players from findings\n        key_players = []\n        for f in findings:\n            if f.get(\"finding_type\") in [\"actor\", \"stakeholder\"]:\n                extracted = f.get(\"extracted_data\", {}) or {}\n                key_players.append({\n                    \"name\": extracted.get(\"name\", f.get(\"summary\", \"\")[:30]),\n                    \"role\": extracted.get(\"role\", \"\"),\n                    \"action\": extracted.get(\"action\", \"\"),\n                })\n\n        # Build timeline from dated findings\n        timeline = []\n        for f in findings:\n            if f.get(\"date_referenced\") or f.get(\"date_range\"):\n                timeline.append({\n                    \"date\": f.get(\"date_referenced\", \"\") or f.get(\"date_range\", \"\"),
[2026-01-30T09:07:44.604Z] [STDOUT] \n                    \"event\": f.get(\"summary\", \"\"),\n                })\n\n        # Get implications\n        implications = []\n        for f in findings:\n            if f.get(\"finding_type\") in [\"implication\", \"impact\", \"consequence\"]:\n                implications.append({\n                    \"area\": f.get(\"extracted_data\", {}).get(\"area\", \"General\"),\n                    \"impact\": f.get(\"summary\", \"\"),\n                })\n\n        data[\"event_explainer\"] = {\n            \"event\": {\n                \"title\": query[:60],\n                \"date\": \"\",\n                \"summary\": perspectives[0].get(\"analysis_text\", \"\")[:200] if perspectives else \"\",\n            },\n            \"what_happened\": perspectives[0].get(\"analysis_text\", \"\")[:300] if perspectives else \"\",\n            \"why_it_matters\": \"\",\n            \"key_players\": key_players[:5],\n            \"timeline\": timeline[:6],\n            \"implications\": implications[:4],\n            \"different_perspectives\": [\n                {\"perspective\": p.get(\"perspective_type\", \"\").replace(\"_\", \" \").title(),\n                 \"view\": p.get(\"analysis_text\", \"\")[:150]}\n                for p in perspectives[:3]\n            ],\n        }\n\n    return data\n\n\ndef render_template_components(result: Dict[str, Any], hints: Optional[ReportHints] = None) -> str:\n    \"\"\"\n    Render all components for a report based on template hints.\n\n    Args:\n        result: Research result dictionary\n        hints: Optional ReportHints override\n\n    Returns:\n        HTML string with rendered components\n    \"\"\"\n    template = result.get(\"template\", \"unknown\")\n\n    # Get hints from template or use default\n    if hints is None:\n        hints = TEMPLATE_REPORT_HINTS.get(template, ReportHints(template_type=template))\n\n    # Prepare component data\n    component_data = prepare_component_data(result)\n\n    # Get components to render\n    components = []\n\n    # Add required components\n    for comp_type in hints.required_components:\n        config = ComponentConfig(\n            component_type=comp_type,\n            priority=90,\n            position=\"main\"\n        )\n        components.append((comp_type, config))\n\n    # Add optional components\n    for comp_type in hints.optional_components:\n        config = ComponentConfig(\n            component_type=comp_type,\n            priority=50,\n            position=\"main\"\n        )\n        components.append((comp_type, config))\n\n    # Render components\n    html_parts = []\n    for comp_type, config in components:\n        data_key = comp_type.value\n        if data_key in component_data:\n            try:\n                rendered = render_component(comp_type, component_data[data_key], config)\n                html_parts.append(rendered)\n            except Exception as e:\n                html_parts.append(f'<!-- Component {comp_type.value} error: {e} -->')\n\n    return \"\\n\".join(html_parts)\n\n\ndef get_component_css() -> str:\n    \"\"\"Get all component CSS styles.\"\"\"\n    return get_component_styles()\n\n\ndef render_component_section(result: Dict[str, Any], component_type: ComponentType,\n                             title: Optional[str] = None) -> str:\n    \"\"\"\n    Render a single component section.\n\n    Args:\n        result: Research result dictionary\n        component_type: The component type to render\n        title: Optional title override\n\n    Returns:\n        HTML string for the component section\n    \"\"\"\n    component_data = prepare_component_data(result)\n    data_key = component_type.value\n\n    if data_key not in component_data:\n        return f'<!-- No data for component {component_type.value} -->'\n\n    config = ComponentConfig(\n        component_type=component_type,\n        title=title,\n        position=\"main\"\n    )\n\n    return render_component(component_type, component_data[data_key], config)\n","numLines":717,"startLine":1,"totalLines":717}}}
[2026-01-30T09:07:44.809Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01V7cVrJ351mGtAsnH5M3u9M","type":"tool_result","content":"     1→\"\"\"\n     2→Report Components Library\n     3→\n     4→A hybrid component system for template-specific report rendering.\n     5→Defines common reusable components and template-specific components.\n     6→\"\"\"\n     7→\n     8→from typing import Dict, List, Any, Optional\n     9→from dataclasses import dataclass, field\n    10→from enum import Enum\n    11→\n    12→\n    13→class ComponentType(Enum):\n    14→    \"\"\"Types of visual components available for reports.\"\"\"\n    15→    # Common Components\n    16→    VERDICT_HERO = \"verdict_hero\"\n    17→    METRIC_CARDS = \"metric_cards\"\n    18→    FINDINGS_TABLE = \"findings_table\"\n    19→    TIMELINE = \"timeline\"\n    20→    QUOTE_CAROUSEL = \"quote_carousel\"\n    21→    RISK_MATRIX = \"risk_matrix\"\n    22→    CHECKLIST = \"checklist\"\n    23→    SOURCE_LIST = \"source_list\"\n    24→    PREDICTION_CARDS = \"prediction_cards\"\n    25→    KEY_INSIGHTS = \"key_insights\"\n    26→    EXECUTIVE_SUMMARY = \"executive_summary\"\n    27→    CONFIDENCE_GAUGE = \"confidence_gauge\"\n    28→    ACTION_ITEMS = \"action_items\"\n    29→    PROS_CONS = \"pros_cons\"\n    30→    COMPARISON_TABLE = \"comparison_table\"\n    31→\n    32→    # Template-Specific Components\n    33→    TECH_RADAR = \"tech_radar\"                    # tech_market\n    34→    INVESTMENT_THESIS = \"investment_thesis\"      # financial\n    35→    COMPETITOR_MATRIX = \"competitor_matrix\"      # competitive\n    36→    INVESTIGATION_TIMELINE = \"investigation_timeline\"  # investigative\n    37→    LEGAL_CASE_TRACKER = \"legal_case_tracker\"    # legal\n    38→    CONTRACT_ANALYSIS = \"contract_analysis\"      # contract\n    39→    DUE_DILIGENCE_SCORECARD = \"due_diligence_scorecard\"  # due_diligence\n    40→    DECISION_MATRIX = \"decision_matrix\"          # purchase_decision\n    41→    TRUST_DASHBOARD = \"trust_dashboard\"          # reputation\n    42→    EVENT_EXPLAINER = \"event_explainer\"          # understanding\n    43→\n    44→\n    45→@dataclass\n    46→class ComponentConfig:\n    47→    \"\"\"Configuration for a report component.\"\"\"\n    48→    component_type: ComponentType\n    49→    title: Optional[str] = None\n    50→    position: str = \"main\"  # main, sidebar, hero\n    51→    priority: int = 50  # 0-100, higher = rendered first\n    52→    max_items: Optional[int] = None\n    53→    collapsible: bool = False\n    54→    default_collapsed: bool = False\n    55→    css_class: str = \"\"\n    56→    options: Dict[str, Any] = field(default_factory=dict)\n    57→\n    58→\n    59→@dataclass\n    60→class ReportHints:\n    61→    \"\"\"Hints for report generation passed to LLM and renderer.\"\"\"\n    62→    template_type: str\n    63→    structure: str = \"balanced\"  # balanced, quantitative_first, narrative_first, verdict_first\n    64→    findings_grouping: str = \"chronological\"  # chronological, sentiment, category, impact\n    65→    tone: str = \"professional\"  # professional, analytical, advisory, investigative\n    66→    decision_format: str = \"recommendation\"  # recommendation, matrix, checklist, thesis\n    67→    emphasis: List[str] = field(default_factory=list)  # what to highlight\n    68→    required_components: List[ComponentType] = field(default_factory=list)\n    69→    optional_components: List[ComponentType] = field(default_factory=list)\n    70→    visualization_preference: List[str] = field(default_factory=list)\n    71→    custom_sections: Dict[str, Any] = field(default_factory=dict)\n    72→\n    73→\n    74→# =============================================================================\n    75→# COMMON COMPONENT RENDERERS\n    76→# =============================================================================\n    77→\n    78→def render_verdict_hero(data: Dict[str, Any], config: ComponentConfig) -> str:\n    79→    \"\"\"\n    80→    Hero section with prominent verdict/score display.\n    81→    data: {verdict: str, score: float, headline: str, subtext: str, color: str}\n    82→    \"\"\"\n    83→    verdict = data.get(\"verdict\", \"Analysis Complete\")\n    84→    score = data.get(\"score\", 0)\n    85→    headline = data.get(\"headline\", \"\")\n    86→    subtext = data.get(\"subtext\", \"\")\n    87→    color = data.get(\"color\", \"blue\")\n    88→\n    89→    score_display = f\"{score:.0%}\" if isinstance(score, float) and score <= 1 else str(score)\n    90→\n    91→    return f'''\n    92→    <div class=\"component verdict-hero verdict-{color} {config.css_class}\">\n    93→        <div class=\"verdict-score-ring\">\n    94→            <span class=\"verdict-score\">{score_display}</span>\n    95→        </div>\n    96→        <div class=\"verdict-content\">\n    97→            <h2 class=\"verdict-headline\">{verdict}</h2>\n    98→            <p class=\"verdict-subtext\">{headline}</p>\n    99→            {f'<p class=\"verdict-detail\">{subtext}</p>' if subtext else ''}\n   100→        </div>\n   101→    </div>\n   102→    '''\n   103→\n   104→\n   105→def render_metric_cards(data: Dict[str, Any], config: ComponentConfig) -> str:\n   106→    \"\"\"\n   107→    Grid of metric cards with labels and values.\n   108→    data: {metrics: [{label: str, value: str, trend: str, description: str}]}\n   109→    \"\"\"\n   110→    metrics = data.get(\"metrics\", [])[:config.max_items or 6]\n   111→\n   112→    cards_html = \"\"\n   113→    for metric in metrics:\n   114→        trend_icon = \"\"\n   115→        if metric.get(\"trend\") == \"up\":\n   116→            trend_icon = '<span class=\"trend-up\">↑</span>'\n   117→        elif metric.get(\"trend\") == \"down\":\n   118→            trend_icon = '<span class=\"trend-down\">↓</span>'\n   119→\n   120→        cards_html += f'''\n   121→        <div class=\"metric-card\">\n   122→            <div class=\"metric-value\">{metric.get(\"value\", \"N/A\")} {trend_icon}</div>\n   123→            <div class=\"metric-label\">{metric.get(\"label\", \"\")}</div>\n   124→            {f'<div class=\"metric-desc\">{metric.get(\"description\", \"\")}</div>' if metric.get(\"description\") else ''}\n   125→        </div>\n   126→        '''\n   127→\n   128→    title = f'<h3 class=\"component-title\">{config.title}</h3>' if config.title else ''\n   129→    return f'''\n   130→    <div class=\"component metric-cards-container {config.css_class}\">\n   131→        {title}\n   132→        <div class=\"metric-cards-grid\">\n   133→            {cards_html}\n   134→        </div>\n   135→    </div>\n   136→    '''\n   137→\n   138→\n   139→def render_findings_table(data: Dict[str, Any], config: ComponentConfig) -> str:\n   140→    \"\"\"\n   141→    Findings display with analysis commentary.\n   142→    data: {findings: [{type: str, summary: str, content: str, analysis: str, date: str, confidence: float}]}\n   143→    \"\"\"\n   144→    findings = data.get(\"findings\", [])[:config.max_items or 12]\n   145→\n   146→    items_html = \"\"\n   147→    for finding in findings:\n   148→        conf = finding.get(\"confidence\", 0)\n   149→        conf_class = \"high\" if conf >= 0.8 else \"medium\" if conf >= 0.6 else \"low\"\n   150→        finding_type = finding.get(\"type\", \"general\")\n   151→        analysis = finding.get(\"analysis\", \"\")\n   152→\n   153→        items_html += f'''\n   154→        <div class=\"finding-item\">\n   155→            <div class=\"finding-header\">\n   156→                <span class=\"finding-type-badge {finding_type}\">{finding_type.replace(\"_\", \" \")}</span>\n   157→                <span class=\"finding-date\">{finding.get(\"date\", \"\")}</span>\n   158→                <span class=\"confidence-badge {conf_class}\">{conf:.0%}</span>\n   159→            </div>\n   160→            <div class=\"finding-summary\">{finding.get(\"summary\", \"\")}</div>\n   161→            {f'<div class=\"finding-analysis\">{analysis}</div>' if analysis else ''}\n   162→        </div>\n   163→        '''\n   164→\n   165→    title = f'<h3 class=\"component-title\">{config.title or \"Key Findings\"}</h3>'\n   166→    return f'''\n   167→    <div class=\"component findings-container {config.css_class}\">\n   168→        {title}\n   169→        <div class=\"findings-list\">\n   170→            {items_html}\n   171→        </div>\n   172→    </div>\n   173→    '''\n   174→\n   175→\n   176→def render_timeline(data: Dict[str, Any], config: ComponentConfig) -> str:\n   177→    \"\"\"\n   178→    Vertical timeline of events.\n   179→    data: {events: [{date: str, title: str, description: str, type: str, importance: str}]}\n   180→    \"\"\"\n   181→    events = data.get(\"events\", [])[:config.max_items or 8]\n   182→\n   183→    events_html = \"\"\n   184→    for event in events:\n   185→        importance = event.get(\"importance\", \"normal\")\n   186→        events_html += f'''\n   187→        <div class=\"timeline-event timeline-{importance}\">\n   188→            <div class=\"timeline-marker\"></div>\n   189→            <div class=\"timeline-date\">{event.get(\"date\", \"\")}</div>\n   190→            <div class=\"timeline-content\">\n   191→                <h4 class=\"timeline-title\">{event.get(\"title\", \"\")}</h4>\n   192→                <p class=\"timeline-desc\">{event.get(\"description\", \"\")}</p>\n   193→                {f'<span class=\"timeline-type\">{event.get(\"type\", \"\")}</span>' if event.get(\"type\") else ''}\n   194→            </div>\n   195→        </div>\n   196→        '''\n   197→\n   198→    title = f'<h3 class=\"component-title\">{config.title or \"Timeline\"}</h3>' if config.title else '<h3 class=\"component-title\">Timeline</h3>'\n   199→    return f'''\n   200→    <div class=\"component timeline-container {config.css_class}\">\n   201→        {title}\n   202→        <div class=\"timeline\">\n   203→            {events_html}\n   204→        </div>\n   205→    </div>\n   206→    '''\n   207→\n   208→\n   209→def render_quote_carousel(data: Dict[str, Any], config: ComponentConfig) -> str:\n   210→    \"\"\"\n   211→    Carousel of quotes/testimonials.\n   212→    data: {quotes: [{text: str, source: str, date: str, sentiment: str}]}\n   213→    \"\"\"\n   214→    quotes = data.get(\"quotes\", [])[:config.max_items or 5]\n   215→\n   216→    quotes_html = \"\"\n   217→    for i, quote in enumerate(quotes):\n   218→        sentiment = quote.get(\"sentiment\", \"neutral\")\n   219→        active = \"active\" if i == 0 else \"\"\n   220→        quotes_html += f'''\n   221→        <div class=\"quote-slide {active}\" data-index=\"{i}\">\n   222→            <blockquote class=\"quote-text quote-{sentiment}\">\"{quote.get(\"text\", \"\")}\"</blockquote>\n   223→            <cite class=\"quote-source\">— {quote.get(\"source\", \"Unknown\")} {f'({quote.get(\"date\", \"\")})' if quote.get(\"date\") else ''}</cite>\n   224→        </div>\n   225→        '''\n   226→\n   227→    dots_html = \"\".join([f'<span class=\"carousel-dot {\"active\" if i == 0 else \"\"}\" data-index=\"{i}\"></span>' for i in range(len(quotes))])\n   228→\n   229→    title = f'<h3 class=\"component-title\">{config.title or \"Expert Perspectives\"}</h3>'\n   230→    return f'''\n   231→    <div class=\"component quote-carousel-container {config.css_class}\" x-data=\"{{currentSlide: 0, totalSlides: {len(quotes)}}}\">\n   232→        {title}\n   233→        <div class=\"quote-carousel\">\n   234→            {quotes_html}\n   235→        </div>\n   236→        <div class=\"carousel-controls\">\n   237→            <button class=\"carousel-btn prev\" @click=\"currentSlide = (currentSlide - 1 + totalSlides) % totalSlides\">‹</button>\n   238→            <div class=\"carousel-dots\">{dots_html}</div>\n   239→            <button class=\"carousel-btn next\" @click=\"currentSlide = (currentSlide + 1) % totalSlides\">›</button>\n   240→        </div>\n   241→    </div>\n   242→    '''\n   243→\n   244→\n   245→def render_risk_matrix(data: Dict[str, Any], config: ComponentConfig) -> str:\n   246→    \"\"\"\n   247→    2D risk assessment matrix.\n   248→    data: {risks: [{name: str, likelihood: float, impact: float, category: str}], x_label: str, y_label: str}\n   249→    \"\"\"\n   250→    risks = data.get(\"risks\", [])[:config.max_items or 10]\n   251→    x_label = data.get(\"x_label\", \"Likelihood\")\n   252→    y_label = data.get(\"y_label\", \"Impact\")\n   253→\n   254→    # Position risks on grid\n   255→    risk_items = \"\"\n   256→    for risk in risks:\n   257→        x_pos = risk.get(\"likelihood\", 0.5) * 100\n   258→        y_pos = (1 - risk.get(\"impact\", 0.5)) * 100  # Invert Y axis\n   259→        category = risk.get(\"category\", \"general\")\n   260→        risk_items += f'''\n   261→        <div class=\"risk-item risk-{category}\" style=\"left: {x_pos}%; top: {y_pos}%;\" title=\"{risk.get(\"name\", \"\")}\">\n   262→            <span class=\"risk-dot\"></span>\n   263→            <span class=\"risk-label\">{risk.get(\"name\", \"\")[:20]}</span>\n   264→        </div>\n   265→        '''\n   266→\n   267→    title = f'<h3 class=\"component-title\">{config.title or \"Risk Assessment Matrix\"}</h3>'\n   268→    return f'''\n   269→    <div class=\"component risk-matrix-container {config.css_class}\">\n   270→        {title}\n   271→        <div class=\"risk-matrix\">\n   272→            <div class=\"risk-y-axis\">\n   273→                <span class=\"axis-label\">{y_label}</span>\n   274→                <span class=\"axis-high\">High</span>\n   275→                <span class=\"axis-low\">Low</span>\n   276→            </div>\n   277→            <div class=\"risk-grid\">\n   278→                <div class=\"risk-quadrant risk-critical\">Critical</div>\n   279→                <div class=\"risk-quadrant risk-high\">High</div>\n   280→                <div class=\"risk-quadrant risk-medium\">Medium</div>\n   281→                <div class=\"risk-quadrant risk-low\">Low</div>\n   282→                {risk_items}\n   283→            </div>\n   284→            <div class=\"risk-x-axis\">\n   285→                <span class=\"axis-low\">Low</span>\n   286→                <span class=\"axis-label\">{x_label}</span>\n   287→                <span class=\"axis-high\">High</span>\n   288→            </div>\n   289→        </div>\n   290→    </div>\n   291→    '''\n   292→\n   293→\n   294→def render_checklist(data: Dict[str, Any], config: ComponentConfig) -> str:\n   295→    \"\"\"\n   296→    Interactive checklist with status indicators.\n   297→    data: {items: [{text: str, status: str, severity: str, detail: str}], title: str}\n   298→    \"\"\"\n   299→    items = data.get(\"items\", [])[:config.max_items or 12]\n   300→\n   301→    items_html = \"\"\n   302→    for item in items:\n   303→        status = item.get(\"status\", \"unchecked\")  # checked, unchecked, warning, critical\n   304→        severity = item.get(\"severity\", \"info\")\n   305→        icon = \"✓\" if status == \"checked\" else \"✗\" if status == \"critical\" else \"⚠\" if status == \"warning\" else \"○\"\n   306→\n   307→        items_html += f'''\n   308→        <li class=\"checklist-item checklist-{status} severity-{severity}\">\n   309→            <span class=\"checklist-icon\">{icon}</span>\n   310→            <span class=\"checklist-text\">{item.get(\"text\", \"\")}</span>\n   311→            {f'<span class=\"checklist-detail\">{item.get(\"detail\", \"\")}</span>' if item.get(\"detail\") else ''}\n   312→        </li>\n   313→        '''\n   314→\n   315→    title = f'<h3 class=\"component-title\">{config.title or \"Checklist\"}</h3>'\n   316→    return f'''\n   317→    <div class=\"component checklist-container {config.css_class}\">\n   318→        {title}\n   319→        <ul class=\"checklist\">\n   320→            {items_html}\n   321→        </ul>\n   322→    </div>\n   323→    '''\n   324→\n   325→\n   326→def render_source_list(data: Dict[str, Any], config: ComponentConfig) -> str:\n   327→    \"\"\"\n   328→    List of sources with credibility indicators.\n   329→    data: {sources: [{title: str, url: str, credibility: str, type: str, date: str}]}\n   330→    \"\"\"\n   331→    sources = data.get(\"sources\", [])[:config.max_items or 15]\n   332→\n   333→    sources_html = \"\"\n   334→    for source in sources:\n   335→        credibility = source.get(\"credibility\", \"medium\")\n   336→        sources_html += f'''\n   337→        <li class=\"source-item source-{credibility}\">\n   338→            <span class=\"source-credibility-dot\"></span>\n   339→            <a href=\"{source.get(\"url\", \"#\")}\" target=\"_blank\" class=\"source-link\">{source.get(\"title\", \"Unknown Source\")}</a>\n   340→            <span class=\"source-meta\">\n   341→                <span class=\"source-type\">{source.get(\"type\", \"\")}</span>\n   342→                <span class=\"source-date\">{source.get(\"date\", \"\")}</span>\n   343→            </span>\n   344→        </li>\n   345→        '''\n   346→\n   347→    title = f'<h3 class=\"component-title\">{config.title or \"Sources\"}</h3>'\n   348→    return f'''\n   349→    <div class=\"component source-list-container {config.css_class}\">\n   350→        {title}\n   351→        <ul class=\"source-list\">\n   352→            {sources_html}\n   353→        </ul>\n   354→    </div>\n   355→    '''\n   356→\n   357→\n   358→def render_prediction_cards(data: Dict[str, Any], config: ComponentConfig) -> str:\n   359→    \"\"\"\n   360→    Cards displaying predictions with confidence and timeline.\n   361→    data: {predictions: [{prediction: str, rationale: str, confidence: str, timeline: str, source_perspective: str}]}\n   362→    \"\"\"\n   363→    predictions = data.get(\"predictions\", [])[:config.max_items or 5]\n   364→\n   365→    cards_html = \"\"\n   366→    for pred in predictions:\n   367→        conf = pred.get(\"confidence\", \"medium\")\n   368→        # Handle both string and float confidence values\n   369→        if isinstance(conf, (int, float)):\n   370→            conf_label = \"high\" if conf >= 0.7 else \"medium\" if conf >= 0.4 else \"low\"\n   371→            conf_display = f\"{int(conf * 100)}%\"\n   372→        else:\n   373→            conf_label = str(conf).lower()\n   374→            conf_display = str(conf).upper()\n   375→        cards_html += f'''\n   376→        <div class=\"prediction-card prediction-{conf_label}\">\n   377→            <div class=\"prediction-header\">\n   378→                <span class=\"prediction-confidence\">{conf_display}</span>\n   379→                <span class=\"prediction-timeline\">{pred.get(\"timeline\", \"\")}</span>\n   380→            </div>\n   381→            <h4 class=\"prediction-text\">{pred.get(\"prediction\", \"\")}</h4>\n   382→            <p class=\"prediction-rationale\">{pred.get(\"rationale\", \"\")}</p>\n   383→            <div class=\"prediction-footer\">\n   384→                <span class=\"prediction-source\">Based on: {pred.get(\"source_perspective\", \"Analysis\")}</span>\n   385→            </div>\n   386→        </div>\n   387→        '''\n   388→\n   389→    title = f'<h3 class=\"component-title\">{config.title or \"Predictions & Outlook\"}</h3>'\n   390→    return f'''\n   391→    <div class=\"component prediction-cards-container {config.css_class}\">\n   392→        {title}\n   393→        <div class=\"prediction-cards\">\n   394→            {cards_html}\n   395→        </div>\n   396→    </div>\n   397→    '''\n   398→\n   399→\n   400→def render_key_insights(data: Dict[str, Any], config: ComponentConfig) -> str:\n   401→    \"\"\"\n   402→    Highlighted key insights with descriptions.\n   403→    data: {insights: [{insight: str, description: str, category: str, importance: str}]}\n   404→    \"\"\"\n   405→    insights = data.get(\"insights\", [])[:config.max_items or 6]\n   406→\n   407→    insights_html = \"\"\n   408→    for insight in insights:\n   409→        importance = insight.get(\"importance\", \"normal\")\n   410→        description = insight.get(\"description\", \"\")\n   411→        category = insight.get(\"category\", \"\")\n   412→\n   413→        insights_html += f'''\n   414→        <div class=\"insight-item insight-{importance}\">\n   415→            <div class=\"insight-header\">\n   416→                <span class=\"insight-text\">{insight.get(\"insight\", \"\")}</span>\n   417→                {f'<span class=\"insight-category\">{category}</span>' if category else ''}\n   418→            </div>\n   419→            {f'<div class=\"insight-description\">{description}</div>' if description else ''}\n   420→        </div>\n   421→        '''\n   422→\n   423→    title = f'<h3 class=\"component-title\">{config.title or \"Key Insights\"}</h3>'\n   424→    return f'''\n   425→    <div class=\"component key-insights-container {config.css_class}\">\n   426→        {title}\n   427→        <div class=\"insights-list\">\n   428→            {insights_html}\n   429→        </div>\n   430→    </div>\n   431→    '''\n   432→\n   433→\n   434→def render_executive_summary(data: Dict[str, Any], config: ComponentConfig) -> str:\n   435→    \"\"\"\n   436→    Executive summary section.\n   437→    data: {summary: str, key_points: [str], recommendation: str}\n   438→    \"\"\"\n   439→    summary = data.get(\"summary\", \"\")\n   440→    key_points = data.get(\"key_points\", [])[:5]\n   441→    recommendation = data.get(\"recommendation\", \"\")\n   442→\n   443→    points_html = \"\".join([f'<li>{point}</li>' for point in key_points])\n   444→\n   445→    title = f'<h3 class=\"component-title\">{config.title or \"Executive Summary\"}</h3>'\n   446→    return f'''\n   447→    <div class=\"component executive-summary-container {config.css_class}\">\n   448→        {title}\n   449→        <div class=\"summary-content\">\n   450→            <p class=\"summary-text\">{summary}</p>\n   451→            {f'<ul class=\"summary-points\">{points_html}</ul>' if key_points else ''}\n   452→            {f'<div class=\"summary-recommendation\"><strong>Recommendation:</strong> {recommendation}</div>' if recommendation else ''}\n   453→        </div>\n   454→    </div>\n   455→    '''\n   456→\n   457→\n   458→def render_confidence_gauge(data: Dict[str, Any], config: ComponentConfig) -> str:\n   459→    \"\"\"\n   460→    Visual confidence gauge.\n   461→    data: {score: float, label: str, factors: [{name: str, score: float}]}\n   462→    \"\"\"\n   463→    score = data.get(\"score\", 0.5)\n   464→    label = data.get(\"label\", \"Confidence\")\n   465→    factors = data.get(\"factors\", [])[:5]\n   466→\n   467→    percentage = score * 100\n   468→    color = \"green\" if score >= 0.7 else \"yellow\" if score >= 0.4 else \"red\"\n   469→\n   470→    factors_html = \"\"\n   471→    for factor in factors:\n   472→        f_pct = factor.get(\"score\", 0.5) * 100\n   473→        factors_html += f'''\n   474→        <div class=\"gauge-factor\">\n   475→            <span class=\"factor-name\">{factor.get(\"name\", \"\")}</span>\n   476→            <div class=\"factor-bar\"><div class=\"factor-fill\" style=\"width: {f_pct}%\"></div></div>\n   477→            <span class=\"factor-score\">{f_pct:.0f}%</span>\n   478→        </div>\n   479→        '''\n   480→\n   481→    title = f'<h3 class=\"component-title\">{config.title or label}</h3>'\n   482→    return f'''\n   483→    <div class=\"component confidence-gauge-container {config.css_class}\">\n   484→        {title}\n   485→        <div class=\"gauge-wrapper\">\n   486→            <div class=\"gauge-circle gauge-{color}\">\n   487→                <svg viewBox=\"0 0 100 100\">\n   488→                    <circle class=\"gauge-bg\" cx=\"50\" cy=\"50\" r=\"45\"/>\n   489→                    <circle class=\"gauge-fill\" cx=\"50\" cy=\"50\" r=\"45\" stroke-dasharray=\"{percentage * 2.83} 283\"/>\n   490→                </svg>\n   491→                <span class=\"gauge-value\">{percentage:.0f}%</span>\n   492→            </div>\n   493→        </div>\n   494→        {f'<div class=\"gauge-factors\">{factors_html}</div>' if factors else ''}\n   495→    </div>\n   496→    '''\n   497→\n   498→\n   499→def render_action_items(data: Dict[str, Any], config: ComponentConfig) -> str:\n   500→    \"\"\"\n   501→    Actionable next steps.\n   502→    data: {actions: [{action: str, priority: str, owner: str, deadline: str}]}\n   503→    \"\"\"\n   504→    actions = data.get(\"actions\", [])[:config.max_items or 6]\n   505→\n   506→    actions_html = \"\"\n   507→    for action in actions:\n   508→        priority = action.get(\"priority\", \"medium\")\n   509→        actions_html += f'''\n   510→        <div class=\"action-item action-{priority}\">\n   511→            <span class=\"action-priority\">{priority.upper()}</span>\n   512→            <span class=\"action-text\">{action.get(\"action\", \"\")}</span>\n   513→            <div class=\"action-meta\">\n   514→                {f'<span class=\"action-owner\">{action.get(\"owner\", \"\")}</span>' if action.get(\"owner\") else ''}\n   515→                {f'<span class=\"action-deadline\">{action.get(\"deadline\", \"\")}</span>' if action.get(\"deadline\") else ''}\n   516→            </div>\n   517→        </div>\n   518→        '''\n   519→\n   520→    title = f'<h3 class=\"component-title\">{config.title or \"Recommended Actions\"}</h3>'\n   521→    return f'''\n   522→    <div class=\"component action-items-container {config.css_class}\">\n   523→        {title}\n   524→        <div class=\"actions-list\">\n   525→            {actions_html}\n   526→        </div>\n   527→    </div>\n   528→    '''\n   529→\n   530→\n   531→def render_pros_cons(data: Dict[str, Any], config: ComponentConfig) -> str:\n   532→    \"\"\"\n   533→    Pros and cons comparison.\n   534→    data: {pros: [{text: str, weight: str}], cons: [{text: str, weight: str}]}\n   535→    \"\"\"\n   536→    pros = data.get(\"pros\", [])[:config.max_items or 6]\n   537→    cons = data.get(\"cons\", [])[:config.max_items or 6]\n   538→\n   539→    pros_html = \"\".join([f'<li class=\"pro-item weight-{p.get(\"weight\", \"normal\")}\"><span class=\"pro-icon\">✓</span>{p.get(\"text\", \"\")}</li>' for p in pros])\n   540→    cons_html = \"\".join([f'<li class=\"con-item weight-{c.get(\"weight\", \"normal\")}\"><span class=\"con-icon\">✗</span>{c.get(\"text\", \"\")}</li>' for c in cons])\n   541→\n   542→    title = f'<h3 class=\"component-title\">{config.title or \"Pros & Cons\"}</h3>'\n   543→    return f'''\n   544→    <div class=\"component pros-cons-container {config.css_class}\">\n   545→        {title}\n   546→        <div class=\"pros-cons-grid\">\n   547→            <div class=\"pros-column\">\n   548→                <h4 class=\"column-header pros-header\">Advantages</h4>\n   549→                <ul class=\"pros-list\">{pros_html}</ul>\n   550→            </div>\n   551→            <div class=\"cons-column\">\n   552→                <h4 class=\"column-header cons-header\">Disadvantages</h4>\n   553→                <ul class=\"cons-list\">{cons_html}</ul>\n   554→            </div>\n   555→        </div>\n   556→    </div>\n   557→    '''\n   558→\n   559→\n   560→def render_comparison_table(data: Dict[str, Any], config: ComponentConfig) -> str:\n   561→    \"\"\"\n   562→    Generic comparison table.\n   563→    data: {headers: [str], rows: [[str]], highlight_column: int}\n   564→    \"\"\"\n   565→    headers = data.get(\"headers\", [])\n   566→    rows = data.get(\"rows\", [])\n   567→    highlight_col = data.get(\"highlight_column\", -1)\n   568→\n   569→    header_html = \"\".join([f'<th class=\"{\"highlight\" if i == highlight_col else \"\"}\">{h}</th>' for i, h in enumerate(headers)])\n   570→\n   571→    rows_html = \"\"\n   572→    for row in rows:\n   573→        cells = \"\".join([f'<td class=\"{\"highlight\" if i == highlight_col else \"\"}\">{cell}</td>' for i, cell in enumerate(row)])\n   574→        rows_html += f'<tr>{cells}</tr>'\n   575→\n   576→    title = f'<h3 class=\"component-title\">{config.title or \"Comparison\"}</h3>'\n   577→    return f'''\n   578→    <div class=\"component comparison-table-container {config.css_class}\">\n   579→        {title}\n   580→        <div class=\"table-wrapper\">\n   581→            <table class=\"comparison-table\">\n   582→                <thead><tr>{header_html}</tr></thead>\n   583→                <tbody>{rows_html}</tbody>\n   584→            </table>\n   585→        </div>\n   586→    </div>\n   587→    '''\n   588→\n   589→\n   590→# =============================================================================\n   591→# TEMPLATE-SPECIFIC COMPONENT RENDERERS\n   592→# =============================================================================\n   593→\n   594→def render_tech_radar(data: Dict[str, Any], config: ComponentConfig) -> str:\n   595→    \"\"\"\n   596→    Technology radar visualization for tech_market template.\n   597→    data: {technologies: [{name: str, ring: str, quadrant: str, moved: str, description: str}]}\n   598→    Rings: adopt, trial, assess, hold\n   599→    Quadrants: techniques, tools, platforms, languages\n   600→    \"\"\"\n   601→    technologies = data.get(\"technologies\", [])\n   602→\n   603→    # Group by quadrant\n   604→    quadrants = {\"techniques\": [], \"tools\": [], \"platforms\": [], \"languages\": []}\n   605→    for tech in technologies:\n   606→        q = tech.get(\"quadrant\", \"tools\")\n   607→        if q in quadrants:\n   608→            quadrants[q].append(tech)\n   609→\n   610→    ring_radius = {\"adopt\": 25, \"trial\": 45, \"assess\": 65, \"hold\": 85}\n   611→\n   612→    blips_html = \"\"\n   613→    for q_idx, (quadrant, techs) in enumerate(quadrants.items()):\n   614→        angle_start = q_idx * 90\n   615→        for i, tech in enumerate(techs[:8]):\n   616→            ring = tech.get(\"ring\", \"assess\")\n   617→            radius = ring_radius.get(ring, 65)\n   618→            angle = angle_start + 10 + (i * 10)\n   619→            moved = tech.get(\"moved\", \"none\")\n   620→            moved_icon = \"↑\" if moved == \"up\" else \"↓\" if moved == \"down\" else \"\"\n   621→\n   622→            blips_html += f'''\n   623→            <div class=\"radar-blip ring-{ring} quadrant-{quadrant}\"\n   624→                 style=\"--angle: {angle}deg; --radius: {radius}%;\"\n   625→                 title=\"{tech.get(\"name\", \"\")}: {tech.get(\"description\", \"\")}\">\n   626→                <span class=\"blip-label\">{tech.get(\"name\", \"\")[:12]}</span>\n   627→                {f'<span class=\"blip-moved\">{moved_icon}</span>' if moved_icon else ''}\n   628→            </div>\n   629→            '''\n   630→\n   631→    title = f'<h3 class=\"component-title\">{config.title or \"Technology Radar\"}</h3>'\n   632→    return f'''\n   633→    <div class=\"component tech-radar-container {config.css_class}\">\n   634→        {title}\n   635→        <div class=\"tech-radar\">\n   636→            <div class=\"radar-rings\">\n   637→                <div class=\"radar-ring ring-hold\"><span>Hold</span></div>\n   638→                <div class=\"radar-ring ring-assess\"><span>Assess</span></div>\n   639→                <div class=\"radar-ring ring-trial\"><span>Trial</span></div>\n   640→                <div class=\"radar-ring ring-adopt\"><span>Adopt</span></div>\n   641→            </div>\n   642→            <div class=\"radar-quadrants\">\n   643→                <div class=\"quadrant-label q-techniques\">Techniques</div>\n   644→                <div class=\"quadrant-label q-tools\">Tools</div>\n   645→                <div class=\"quadrant-label q-platforms\">Platforms</div>\n   646→                <div class=\"quadrant-label q-languages\">Languages</div>\n   647→            </div>\n   648→            <div class=\"radar-blips\">\n   649→                {blips_html}\n   650→            </div>\n   651→        </div>\n   652→        <div class=\"radar-legend\">\n   653→            <span class=\"legend-item\"><span class=\"legend-dot ring-adopt\"></span>Adopt</span>\n   654→            <span class=\"legend-item\"><span class=\"legend-dot ring-trial\"></span>Trial</span>\n   655→            <span class=\"legend-item\"><span class=\"legend-dot ring-assess\"></span>Assess</span>\n   656→            <span class=\"legend-item\"><span class=\"legend-dot ring-hold\"></span>Hold</span>\n   657→        </div>\n   658→    </div>\n   659→    '''\n   660→\n   661→\n   662→def render_investment_thesis(data: Dict[str, Any], config: ComponentConfig) -> str:\n   663→    \"\"\"\n   664→    Investment thesis panel for financial template.\n   665→    data: {verdict: str, target_price: str, risk_level: str,\n   666→           bull_case: str, bear_case: str, key_catalysts: [str], key_risks: [str]}\n   667→    \"\"\"\n   668→    verdict = data.get(\"verdict\", \"Hold\")\n   669→    verdict_class = \"buy\" if verdict.lower() in [\"buy\", \"strong buy\"] else \"sell\" if verdict.lower() in [\"sell\", \"strong sell\"] else \"hold\"\n   670→    target_price = data.get(\"target_price\", \"\")\n   671→\n   672→    # Build compact header with verdict + optional target\n   673→    header_extra = f'<span class=\"thesis-target\">Target: {target_price}</span>' if target_price and target_price != \"N/A\" else \"\"\n   674→\n   675→    catalysts_html = \"\".join([f'<li>{c}</li>' for c in data.get(\"key_catalysts\", [])[:5]])\n   676→    risks_html = \"\".join([f'<li>{r}</li>' for r in data.get(\"key_risks\", [])[:5]])\n   677→\n   678→    title = f'<h3 class=\"component-title\">{config.title or \"Investment Thesis\"}</h3>'\n   679→    return f'''\n   680→    <div class=\"component investment-thesis-container {config.css_class}\">\n   681→        {title}\n   682→        <div class=\"thesis-panel\">\n   683→            <div class=\"thesis-header thesis-{verdict_class}\">\n   684→                <span class=\"thesis-verdict-label\">{verdict.upper()}</span>\n   685→                {header_extra}\n   686→            </div>\n   687→            <div class=\"thesis-cases\">\n   688→                <div class=\"bull-case\">\n   689→                    <h4>Bull Case</h4>\n   690→                    <p>{data.get(\"bull_case\", \"No bull case identified.\")}</p>\n   691→                </div>\n   692→                <div class=\"bear-case\">\n   693→                    <h4>Bear Case</h4>\n   694→                    <p>{data.get(\"bear_case\", \"No bear case identified.\")}</p>\n   695→                </div>\n   696→            </div>\n   697→            <div class=\"thesis-factors\">\n   698→                <div class=\"catalysts\">\n   699→                    <h4>Key Catalysts</h4>\n   700→                    <ul>{catalysts_html if catalysts_html else '<li>None identified</li>'}</ul>\n   701→                </div>\n   702→                <div class=\"risks\">\n   703→                    <h4>Key Risks</h4>\n   704→                    <ul>{risks_html if risks_html else '<li>None identified</li>'}</ul>\n   705→                </div>\n   706→            </div>\n   707→        </div>\n   708→    </div>\n   709→    '''\n   710→\n   711→\n   712→def render_competitor_matrix(data: Dict[str, Any], config: ComponentConfig) -> str:\n   713→    \"\"\"\n   714→    Competitive analysis matrix for competitive template.\n   715→    data: {competitors: [{name: str, scores: {category: score}}], categories: [str], leader: str}\n   716→    \"\"\"\n   717→    competitors = data.get(\"competitors\", [])[:6]\n   718→    categories = data.get(\"categories\", [\"Market Share\", \"Product\", \"Price\", \"Support\"])\n   719→    leader = data.get(\"leader\", \"\")\n   720→\n   721→    # Header row\n   722→    header_html = '<th class=\"category-header\">Competitor</th>'\n   723→    header_html += \"\".join([f'<th class=\"category-header\">{cat}</th>' for cat in categories])\n   724→    header_html += '<th class=\"category-header\">Overall</th>'\n   725→\n   726→    # Data rows\n   727→    rows_html = \"\"\n   728→    for comp in competitors:\n   729→        is_leader = comp.get(\"name\", \"\") == leader\n   730→        scores = comp.get(\"scores\", {})\n   731→        overall = sum(scores.values()) / len(scores) if scores else 0\n   732→\n   733→        cells = f'<td class=\"competitor-name {\"leader\" if is_leader else \"\"}\">{comp.get(\"name\", \"\")} {\"👑\" if is_leader else \"\"}</td>'\n   734→        for cat in categories:\n   735→            score = scores.get(cat, 0)\n   736→            score_class = \"high\" if score >= 8 else \"medium\" if score >= 5 else \"low\"\n   737→            cells += f'<td class=\"score-cell score-{score_class}\">{score:.1f}</td>'\n   738→\n   739→        overall_class = \"high\" if overall >= 8 else \"medium\" if overall >= 5 else \"low\"\n   740→        cells += f'<td class=\"score-cell overall score-{overall_class}\">{overall:.1f}</td>'\n   741→        rows_html += f'<tr class=\"{\"leader-row\" if is_leader else \"\"}\">{cells}</tr>'\n   742→\n   743→    title = f'<h3 class=\"component-title\">{config.title or \"Competitive Matrix\"}</h3>'\n   744→    return f'''\n   745→    <div class=\"component competitor-matrix-container {config.css_class}\">\n   746→        {title}\n   747→        <div class=\"matrix-wrapper\">\n   748→            <table class=\"competitor-matrix\">\n   749→                <thead><tr>{header_html}</tr></thead>\n   750→                <tbody>{rows_html}</tbody>\n   751→            </table>\n   752→        </div>\n   753→        <div class=\"matrix-legend\">\n   754→            <span class=\"legend-item\"><span class=\"score-dot score-high\"></span>Strong (8-10)</span>\n   755→            <span class=\"legend-item\"><span class=\"score-dot score-medium\"></span>Average (5-7)</span>\n   756→            <span class=\"legend-item\"><span class=\"score-dot score-low\"></span>Weak (0-4)</span>\n   757→        </div>\n   758→    </div>\n   759→    '''\n   760→\n   761→\n   762→def render_investigation_timeline(data: Dict[str, Any], config: ComponentConfig) -> str:\n   763→    \"\"\"\n   764→    Detailed investigation timeline for investigative template.\n   765→    data: {events: [{date: str, title: str, description: str, type: str,\n   766→                    severity: str, sources: [str], key_actors: [str]}]}\n   767→    Types: revelation, development, response, legal, financial\n   768→    \"\"\"\n   769→    events = data.get(\"events\", [])[:config.max_items or 12]\n   770→\n   771→    events_html = \"\"\n   772→    for event in events:\n   773→        event_type = event.get(\"type\", \"development\")\n   774→        severity = event.get(\"severity\", \"medium\")\n   775→        sources = event.get(\"sources\", [])[:2]\n   776→        actors = event.get(\"key_actors\", [])[:3]\n   777→\n   778→        sources_html = \"\".join([f'<span class=\"event-source\">{s}</span>' for s in sources])\n   779→        actors_html = \"\".join([f'<span class=\"event-actor\">{a}</span>' for a in actors])\n   780→\n   781→        events_html += f'''\n   782→        <div class=\"investigation-event event-{event_type} severity-{severity}\">\n   783→            <div class=\"event-timeline-marker\">\n   784→                <span class=\"event-type-icon\">{get_investigation_icon(event_type)}</span>\n   785→            </div>\n   786→            <div class=\"event-card\">\n   787→                <div class=\"event-header\">\n   788→                    <span class=\"event-date\">{event.get(\"date\", \"\")}</span>\n   789→                    <span class=\"event-type-badge\">{event_type.replace(\"_\", \" \").title()}</span>\n   790→                    <span class=\"event-severity severity-{severity}\">{severity.upper()}</span>\n   791→                </div>\n   792→                <h4 class=\"event-title\">{event.get(\"title\", \"\")}</h4>\n   793→                <p class=\"event-description\">{event.get(\"description\", \"\")}</p>\n   794→                <div class=\"event-footer\">\n   795→                    <div class=\"event-actors\">{actors_html}</div>\n   796→                    <div class=\"event-sources\">{sources_html}</div>\n   797→                </div>\n   798→            </div>\n   799→        </div>\n   800→        '''\n   801→\n   802→    title = f'<h3 class=\"component-title\">{config.title or \"Investigation Timeline\"}</h3>'\n   803→    return f'''\n   804→    <div class=\"component investigation-timeline-container {config.css_class}\">\n   805→        {title}\n   806→        <div class=\"investigation-timeline\">\n   807→            {events_html}\n   808→        </div>\n   809→    </div>\n   810→    '''\n   811→\n   812→\n   813→def get_investigation_icon(event_type: str) -> str:\n   814→    \"\"\"Get icon for investigation event type.\"\"\"\n   815→    icons = {\n   816→        \"revelation\": \"🔍\",\n   817→        \"development\": \"📰\",\n   818→        \"response\": \"💬\",\n   819→        \"legal\": \"⚖️\",\n   820→        \"financial\": \"💰\",\n   821→        \"regulatory\": \"🏛️\",\n   822→        \"whistleblower\": \"🚨\",\n   823→    }\n   824→    return icons.get(event_type, \"📌\")\n   825→\n   826→\n   827→def render_legal_case_tracker(data: Dict[str, Any], config: ComponentConfig) -> str:\n   828→    \"\"\"\n   829→    Legal case tracking panel for legal template.\n   830→    data: {cases: [{name: str, jurisdiction: str, status: str, parties: [str],\n   831→                   key_dates: [{date: str, event: str}], implications: str, ruling: str}]}\n   832→    \"\"\"\n   833→    cases = data.get(\"cases\", [])[:config.max_items or 5]\n   834→\n   835→    cases_html = \"\"\n   836→    for case in cases:\n   837→        status = case.get(\"status\", \"pending\")\n   838→        parties = \" vs \".join(case.get(\"parties\", [])[:2])\n   839→\n   840→        dates_html = \"\"\n   841→        for kd in case.get(\"key_dates\", [])[:3]:\n   842→            dates_html += f'<div class=\"case-date\"><span class=\"date\">{kd.get(\"date\", \"\")}</span><span class=\"event\">{kd.get(\"event\", \"\")}</span></div>'\n   843→\n   844→        cases_html += f'''\n   845→        <div class=\"legal-case case-{status}\">\n   846→            <div class=\"case-header\">\n   847→                <h4 class=\"case-name\">{case.get(\"name\", \"\")}</h4>\n   848→                <span class=\"case-status status-{status}\">{status.upper()}</span>\n   849→            </div>\n   850→            <div class=\"case-parties\">{parties}</div>\n   851→            <div class=\"case-jurisdiction\">📍 {case.get(\"jurisdiction\", \"\")}</div>\n   852→            <div class=\"case-dates\">{dates_html}</div>\n   853→            {f'<div class=\"case-ruling\"><strong>Ruling:</strong> {case.get(\"ruling\", \"\")}</div>' if case.get(\"ruling\") else ''}\n   854→            <div class=\"case-implications\"><strong>Implications:</strong> {case.get(\"implications\", \"\")}</div>\n   855→        </div>\n   856→        '''\n   857→\n   858→    title = f'<h3 class=\"component-title\">{config.title or \"Legal Case Tracker\"}</h3>'\n   859→    return f'''\n   860→    <div class=\"component legal-case-tracker-container {config.css_class}\">\n   861→        {title}\n   862→        <div class=\"legal-cases\">\n   863→            {cases_html}\n   864→        </div>\n   865→    </div>\n   866→    '''\n   867→\n   868→\n   869→def render_contract_analysis(data: Dict[str, Any], config: ComponentConfig) -> str:\n   870→    \"\"\"\n   871→    Contract analysis panel for contract template.\n   872→    data: {contract: {name: str, value: str, duration: str, parties: [str], type: str},\n   873→           key_terms: [{term: str, details: str, risk_level: str}],\n   874→           obligations: [{party: str, obligation: str, deadline: str}],\n   875→           red_flags: [str], opportunities: [str]}\n   876→    \"\"\"\n   877→    contract = data.get(\"contract\", {})\n   878→    key_terms = data.get(\"key_terms\", [])[:6]\n   879→    obligations = data.get(\"obligations\", [])[:6]\n   880→    red_flags = data.get(\"red_flags\", [])[:4]\n   881→    opportunities = data.get(\"opportunities\", [])[:4]\n   882→\n   883→    terms_html = \"\"\n   884→    for term in key_terms:\n   885→        risk = term.get(\"risk_level\", \"low\")\n   886→        terms_html += f'''\n   887→        <div class=\"contract-term risk-{risk}\">\n   888→            <span class=\"term-name\">{term.get(\"term\", \"\")}</span>\n   889→            <span class=\"term-details\">{term.get(\"details\", \"\")}</span>\n   890→            <span class=\"term-risk\">{risk.upper()}</span>\n   891→        </div>\n   892→        '''\n   893→\n   894→    obligations_html = \"\"\n   895→    for ob in obligations:\n   896→        obligations_html += f'''\n   897→        <div class=\"contract-obligation\">\n   898→            <span class=\"obligation-party\">{ob.get(\"party\", \"\")}</span>\n   899→            <span class=\"obligation-text\">{ob.get(\"obligation\", \"\")}</span>\n   900→            <span class=\"obligation-deadline\">{ob.get(\"deadline\", \"\")}</span>\n   901→        </div>\n   902→        '''\n   903→\n   904→    flags_html = \"\".join([f'<li class=\"red-flag\">🚩 {f}</li>' for f in red_flags])\n   905→    opps_html = \"\".join([f'<li class=\"opportunity\">✨ {o}</li>' for o in opportunities])\n   906→\n   907→    title = f'<h3 class=\"component-title\">{config.title or \"Contract Analysis\"}</h3>'\n   908→    return f'''\n   909→    <div class=\"component contract-analysis-container {config.css_class}\">\n   910→        {title}\n   911→        <div class=\"contract-overview\">\n   912→            <div class=\"contract-header\">\n   913→                <h4 class=\"contract-name\">{contract.get(\"name\", \"Contract\")}</h4>\n   914→                <span class=\"contract-type\">{contract.get(\"type\", \"\")}</span>\n   915→            </div>\n   916→            <div class=\"contract-meta\">\n   917→                <span class=\"contract-value\">💰 {contract.get(\"value\", \"N/A\")}</span>\n   918→                <span class=\"contract-duration\">📅 {contract.get(\"duration\", \"N/A\")}</span>\n   919→            </div>\n   920→        </div>\n   921→        <div class=\"contract-sections\">\n   922→            <div class=\"key-terms-section\">\n   923→                <h4>Key Terms</h4>\n   924→                <div class=\"terms-list\">{terms_html}</div>\n   925→            </div>\n   926→            <div class=\"obligations-section\">\n   927→                <h4>Obligations</h4>\n   928→                <div class=\"obligations-list\">{obligations_html}</div>\n   929→            </div>\n   930→        </div>\n   931→        <div class=\"contract-assessment\">\n   932→            <div class=\"red-flags-section\">\n   933→                <h4>🚩 Red Flags</h4>\n   934→                <ul>{flags_html}</ul>\n   935→            </div>\n   936→            <div class=\"opportunities-section\">\n   937→                <h4>✨ Opportunities</h4>\n   938→                <ul>{opps_html}</ul>\n   939→            </div>\n   940→        </div>\n   941→    </div>\n   942→    '''\n   943→\n   944→\n   945→def render_due_diligence_scorecard(data: Dict[str, Any], config: ComponentConfig) -> str:\n   946→    \"\"\"\n   947→    Due diligence scorecard for due_diligence template.\n   948→    data: {overall_score: float, recommendation: str,\n   949→           categories: [{name: str, score: float, findings: [str], weight: float}],\n   950→           red_flags: [{issue: str, severity: str, details: str}],\n   951→           strengths: [str]}\n   952→    \"\"\"\n   953→    overall = data.get(\"overall_score\", 0)\n   954→    recommendation = data.get(\"recommendation\", \"Further Review Needed\")\n   955→    categories = data.get(\"categories\", [])\n   956→    red_flags = data.get(\"red_flags\", [])[:5]\n   957→    strengths = data.get(\"strengths\", [])[:5]\n   958→\n   959→    overall_class = \"pass\" if overall >= 70 else \"caution\" if overall >= 50 else \"fail\"\n   960→\n   961→    categories_html = \"\"\n   962→    for cat in categories:\n   963→        score = cat.get(\"score\", 0)\n   964→        score_class = \"pass\" if score >= 70 else \"caution\" if score >= 50 else \"fail\"\n   965→        findings_html = \"\".join([f'<li>{f}</li>' for f in cat.get(\"findings\", [])[:3]])\n   966→\n   967→        categories_html += f'''\n   968→        <div class=\"dd-category\">\n   969→            <div class=\"dd-category-header\">\n   970→                <span class=\"category-name\">{cat.get(\"name\", \"\")}</span>\n   971→                <span class=\"category-score score-{score_class}\">{score:.0f}</span>\n   972→            </div>\n   973→            <div class=\"category-bar\">\n   974→                <div class=\"category-fill score-{score_class}\" style=\"width: {score}%\"></div>\n   975→            </div>\n   976→            <ul class=\"category-findings\">{findings_html}</ul>\n   977→        </div>\n   978→        '''\n   979→\n   980→    red_flags_html = \"\"\n   981→    for rf in red_flags:\n   982→        severity = rf.get(\"severity\", \"medium\")\n   983→        red_flags_html += f'''\n   984→        <div class=\"dd-red-flag severity-{severity}\">\n   985→            <span class=\"flag-icon\">🚩</span>\n   986→            <span class=\"flag-issue\">{rf.get(\"issue\", \"\")}</span>\n   987→            <span class=\"flag-severity\">{severity.upper()}</span>\n   988→        </div>\n   989→        '''\n   990→\n   991→    strengths_html = \"\".join([f'<li class=\"dd-strength\">✓ {s}</li>' for s in strengths])\n   992→\n   993→    title = f'<h3 class=\"component-title\">{config.title or \"Due Diligence Scorecard\"}</h3>'\n   994→    return f'''\n   995→    <div class=\"component due-diligence-scorecard-container {config.css_class}\">\n   996→        {title}\n   997→        <div class=\"dd-scorecard\">\n   998→            <div class=\"dd-overall score-{overall_class}\">\n   999→                <div class=\"overall-score-circle\">\n  1000→                    <span class=\"overall-value\">{overall:.0f}</span>\n  1001→                    <span class=\"overall-label\">/ 100</span>\n  1002→                </div>\n  1003→                <div class=\"overall-recommendation\">{recommendation}</div>\n  1004→            </div>\n  1005→            <div class=\"dd-categories\">\n  1006→                <h4>Category Scores</h4>\n  1007→                {categories_html}\n  1008→            </div>\n  1009→            <div class=\"dd-assessment\">\n  1010→                <div class=\"dd-red-flags\">\n  1011→                    <h4>Red Flags</h4>\n  1012→                    {red_flags_html}\n  1013→                </div>\n  1014→                <div class=\"dd-strengths\">\n  1015→                    <h4>Strengths</h4>\n  1016→                    <ul>{strengths_html}</ul>\n  1017→                </div>\n  1018→            </div>\n  1019→        </div>\n  1020→    </div>\n  1021→    '''\n  1022→\n  1023→\n  1024→def render_decision_matrix(data: Dict[str, Any], config: ComponentConfig) -> str:\n  1025→    \"\"\"\n  1026→    Purchase decision matrix for purchase_decision template.\n  1027→    data: {options: [{name: str, scores: {criterion: score}, price: str, recommendation: bool}],\n  1028→           criteria: [{name: str, weight: float}], winner: str}\n  1029→    \"\"\"\n  1030→    options = data.get(\"options\", [])[:5]\n  1031→    criteria = data.get(\"criteria\", [])\n  1032→    winner = data.get(\"winner\", \"\")\n  1033→\n  1034→    # Header\n  1035→    header_html = '<th class=\"option-header\">Criteria</th><th class=\"weight-header\">Weight</th>'\n  1036→    for opt in options:\n  1037→        is_winner = opt.get(\"name\", \"\") == winner\n  1038→        header_html += f'<th class=\"option-name {\"winner\" if is_winner else \"\"}\">{opt.get(\"name\", \"\")} {\"🏆\" if is_winner else \"\"}</th>'\n  1039→\n  1040→    # Criteria rows\n  1041→    rows_html = \"\"\n  1042→    for crit in criteria:\n  1043→        crit_name = crit.get(\"name\", \"\")\n  1044→        weight = crit.get(\"weight\", 1)\n  1045→        row = f'<td class=\"criterion-name\">{crit_name}</td><td class=\"criterion-weight\">{weight:.1f}x</td>'\n  1046→\n  1047→        for opt in options:\n  1048→            score = opt.get(\"scores\", {}).get(crit_name, 0)\n  1049→            weighted = score * weight\n  1050→            score_class = \"high\" if score >= 8 else \"medium\" if score >= 5 else \"low\"\n  1051→            is_winner = opt.get(\"name\", \"\") == winner\n  1052→            row += f'<td class=\"score-cell {\"winner-col\" if is_winner else \"\"} score-{score_class}\">{score:.1f}</td>'\n  1053→\n  1054→        rows_html += f'<tr>{row}</tr>'\n  1055→\n  1056→    # Total row\n  1057→    total_row = '<td class=\"total-label\"><strong>Weighted Total</strong></td><td></td>'\n  1058→    for opt in options:\n  1059→        total = sum(opt.get(\"scores\", {}).get(c.get(\"name\", \"\"), 0) * c.get(\"weight\", 1) for c in criteria)\n  1060→        is_winner = opt.get(\"name\", \"\") == winner\n  1061→        total_row += f'<td class=\"total-score {\"winner-col\" if is_winner else \"\"}\"><strong>{total:.1f}</strong></td>'\n  1062→    rows_html += f'<tr class=\"total-row\">{total_row}</tr>'\n  1063→\n  1064→    # Price row\n  1065→    price_row = '<td class=\"price-label\">Price</td><td></td>'\n  1066→    for opt in options:\n  1067→        is_winner = opt.get(\"name\", \"\") == winner\n  1068→        price_row += f'<td class=\"price-cell {\"winner-col\" if is_winner else \"\"}\">{opt.get(\"price\", \"N/A\")}</td>'\n  1069→    rows_html += f'<tr class=\"price-row\">{price_row}</tr>'\n  1070→\n  1071→    title = f'<h3 class=\"component-title\">{config.title or \"Decision Matrix\"}</h3>'\n  1072→    return f'''\n  1073→    <div class=\"component decision-matrix-container {config.css_class}\">\n  1074→        {title}\n  1075→        <div class=\"matrix-wrapper\">\n  1076→            <table class=\"decision-matrix\">\n  1077→                <thead><tr>{header_html}</tr></thead>\n  1078→                <tbody>{rows_html}</tbody>\n  1079→            </table>\n  1080→        </div>\n  1081→        <div class=\"matrix-recommendation\">\n  1082→            <span class=\"recommendation-label\">Recommended Choice:</span>\n  1083→            <span class=\"recommendation-winner\">🏆 {winner}</span>\n  1084→        </div>\n  1085→    </div>\n  1086→    '''\n  1087→\n  1088→\n  1089→def render_trust_dashboard(data: Dict[str, Any], config: ComponentConfig) -> str:\n  1090→    \"\"\"\n  1091→    Trust/reputation dashboard for reputation template.\n  1092→    data: {trust_score: float, verdict: str, verification_status: str,\n  1093→           trust_factors: [{name: str, score: float, status: str}],\n  1094→           user_sentiment: {positive: int, neutral: int, negative: int},\n  1095→           red_flags: [str], green_flags: [str]}\n  1096→    \"\"\"\n  1097→    trust_score = data.get(\"trust_score\", 0)\n  1098→    verdict = data.get(\"verdict\", \"Unknown\")\n  1099→    verification = data.get(\"verification_status\", \"unverified\")\n  1100→    factors = data.get(\"trust_factors\", [])\n  1101→    sentiment = data.get(\"user_sentiment\", {})\n  1102→    red_flags = data.get(\"red_flags\", [])[:5]\n  1103→    green_flags = data.get(\"green_flags\", [])[:5]\n  1104→\n  1105→    score_class = \"trusted\" if trust_score >= 70 else \"caution\" if trust_score >= 40 else \"untrusted\"\n  1106→\n  1107→    factors_html = \"\"\n  1108→    for factor in factors:\n  1109→        status = factor.get(\"status\", \"neutral\")\n  1110→        factors_html += f'''\n  1111→        <div class=\"trust-factor factor-{status}\">\n  1112→            <span class=\"factor-icon\">{get_trust_icon(status)}</span>\n  1113→            <span class=\"factor-name\">{factor.get(\"name\", \"\")}</span>\n  1114→            <span class=\"factor-score\">{factor.get(\"score\", 0):.0f}%</span>\n  1115→        </div>\n  1116→        '''\n  1117→\n  1118→    total_sentiment = sentiment.get(\"positive\", 0) + sentiment.get(\"neutral\", 0) + sentiment.get(\"negative\", 0)\n  1119→    pos_pct = (sentiment.get(\"positive\", 0) / total_sentiment * 100) if total_sentiment > 0 else 0\n  1120→    neu_pct = (sentiment.get(\"neutral\", 0) / total_sentiment * 100) if total_sentiment > 0 else 0\n  1121→    neg_pct = (sentiment.get(\"negative\", 0) / total_sentiment * 100) if total_sentiment > 0 else 0\n  1122→\n  1123→    red_html = \"\".join([f'<li class=\"flag-item red\">🚩 {f}</li>' for f in red_flags])\n  1124→    green_html = \"\".join([f'<li class=\"flag-item green\">✓ {f}</li>' for f in green_flags])\n  1125→\n  1126→    title = f'<h3 class=\"component-title\">{config.title or \"Trust Assessment\"}</h3>'\n  1127→    return f'''\n  1128→    <div class=\"component trust-dashboard-container {config.css_class}\">\n  1129→        {title}\n  1130→        <div class=\"trust-dashboard\">\n  1131→            <div class=\"trust-score-panel score-{score_class}\">\n  1132→                <div class=\"trust-score-circle\">\n  1133→                    <span class=\"trust-value\">{trust_score:.0f}</span>\n  1134→                </div>\n  1135→                <div class=\"trust-verdict\">{verdict}</div>\n  1136→                <div class=\"trust-verification verification-{verification}\">{verification.replace(\"_\", \" \").title()}</div>\n  1137→            </div>\n  1138→            <div class=\"trust-factors-panel\">\n  1139→                <h4>Trust Factors</h4>\n  1140→                {factors_html}\n  1141→            </div>\n  1142→            <div class=\"sentiment-panel\">\n  1143→                <h4>User Sentiment</h4>\n  1144→                <div class=\"sentiment-bar\">\n  1145→                    <div class=\"sentiment-positive\" style=\"width: {pos_pct}%\"></div>\n  1146→                    <div class=\"sentiment-neutral\" style=\"width: {neu_pct}%\"></div>\n  1147→                    <div class=\"sentiment-negative\" style=\"width: {neg_pct}%\"></div>\n  1148→                </div>\n  1149→                <div class=\"sentiment-labels\">\n  1150→                    <span class=\"positive\">👍 {sentiment.get(\"positive\", 0)}</span>\n  1151→                    <span class=\"neutral\">😐 {sentiment.get(\"neutral\", 0)}</span>\n  1152→                    <span class=\"negative\">👎 {sentiment.get(\"negative\", 0)}</span>\n  1153→                </div>\n  1154→            </div>\n  1155→            <div class=\"flags-panel\">\n  1156→                <div class=\"red-flags\">\n  1157→                    <h4>Concerns</h4>\n  1158→                    <ul>{red_html}</ul>\n  1159→                </div>\n  1160→                <div class=\"green-flags\">\n  1161→                    <h4>Positives</h4>\n  1162→                    <ul>{green_html}</ul>\n  1163→                </div>\n  1164→            </div>\n  1165→        </div>\n  1166→    </div>\n  1167→    '''\n  1168→\n  1169→\n  1170→def get_trust_icon(status: str) -> str:\n  1171→    \"\"\"Get icon for trust factor status.\"\"\"\n  1172→    icons = {\"positive\": \"✓\", \"negative\": \"✗\", \"neutral\": \"○\", \"warning\": \"⚠\"}\n  1173→    return icons.get(status, \"○\")\n  1174→\n  1175→\n  1176→def render_event_explainer(data: Dict[str, Any], config: ComponentConfig) -> str:\n  1177→    \"\"\"\n  1178→    Event explanation panel for understanding template.\n  1179→    data: {event: {title: str, date: str, summary: str},\n  1180→           what_happened: str, why_it_matters: str,\n  1181→           key_players: [{name: str, role: str, action: str}],\n  1182→           timeline: [{date: str, event: str}],\n  1183→           implications: [{area: str, impact: str}],\n  1184→           different_perspectives: [{perspective: str, view: str}]}\n  1185→    \"\"\"\n  1186→    event = data.get(\"event\", {})\n  1187→    what = data.get(\"what_happened\", \"\")\n  1188→    why = data.get(\"why_it_matters\", \"\")\n  1189→    players = data.get(\"key_players\", [])[:5]\n  1190→    timeline = data.get(\"timeline\", [])[:6]\n  1191→    implications = data.get(\"implications\", [])[:4]\n  1192→    perspectives = data.get(\"different_perspectives\", [])[:3]\n  1193→\n  1194→    players_html = \"\"\n  1195→    for player in players:\n  1196→        players_html += f'''\n  1197→        <div class=\"key-player\">\n  1198→            <span class=\"player-name\">{player.get(\"name\", \"\")}</span>\n  1199→            <span class=\"player-role\">{player.get(\"role\", \"\")}</span>\n  1200→            <span class=\"player-action\">{player.get(\"action\", \"\")}</span>\n  1201→        </div>\n  1202→        '''\n  1203→\n  1204→    timeline_html = \"\"\n  1205→    for item in timeline:\n  1206→        timeline_html += f'''\n  1207→        <div class=\"timeline-item\">\n  1208→            <span class=\"timeline-date\">{item.get(\"date\", \"\")}</span>\n  1209→            <span class=\"timeline-event\">{item.get(\"event\", \"\")}</span>\n  1210→        </div>\n  1211→        '''\n  1212→\n  1213→    implications_html = \"\"\n  1214→    for imp in implications:\n  1215→        implications_html += f'''\n  1216→        <div class=\"implication-item\">\n  1217→            <span class=\"implication-area\">{imp.get(\"area\", \"\")}</span>\n  1218→            <span class=\"implication-impact\">{imp.get(\"impact\", \"\")}</span>\n  1219→        </div>\n  1220→        '''\n  1221→\n  1222→    perspectives_html = \"\"\n  1223→    for persp in perspectives:\n  1224→        perspectives_html += f'''\n  1225→        <div class=\"perspective-item\">\n  1226→            <span class=\"perspective-name\">{persp.get(\"perspective\", \"\")}</span>\n  1227→            <p class=\"perspective-view\">{persp.get(\"view\", \"\")}</p>\n  1228→        </div>\n  1229→        '''\n  1230→\n  1231→    title = f'<h3 class=\"component-title\">{config.title or \"Event Explained\"}</h3>'\n  1232→    return f'''\n  1233→    <div class=\"component event-explainer-container {config.css_class}\">\n  1234→        {title}\n  1235→        <div class=\"event-explainer\">\n  1236→            <div class=\"event-header\">\n  1237→                <h2 class=\"event-title\">{event.get(\"title\", \"\")}</h2>\n  1238→                <span class=\"event-date\">{event.get(\"date\", \"\")}</span>\n  1239→            </div>\n  1240→            <div class=\"event-summary\">{event.get(\"summary\", \"\")}</div>\n  1241→\n  1242→            <div class=\"explainer-sections\">\n  1243→                <div class=\"what-happened\">\n  1244→                    <h4>📖 What Happened</h4>\n  1245→
[2026-01-30T09:07:44.810Z] [STDOUT] <p>{what}</p>\n  1246→                </div>\n  1247→                <div class=\"why-matters\">\n  1248→                    <h4>💡 Why It Matters</h4>\n  1249→                    <p>{why}</p>\n  1250→                </div>\n  1251→            </div>\n  1252→\n  1253→            <div class=\"key-players-section\">\n  1254→                <h4>👥 Key Players</h4>\n  1255→                <div class=\"players-grid\">{players_html}</div>\n  1256→            </div>\n  1257→\n  1258→            <div class=\"event-timeline-section\">\n  1259→                <h4>📅 Timeline</h4>\n  1260→                <div class=\"mini-timeline\">{timeline_html}</div>\n  1261→            </div>\n  1262→\n  1263→            <div class=\"implications-section\">\n  1264→                <h4>🎯 Implications</h4>\n  1265→                <div class=\"implications-grid\">{implications_html}</div>\n  1266→            </div>\n  1267→\n  1268→            <div class=\"perspectives-section\">\n  1269→                <h4>🔍 Different Perspectives</h4>\n  1270→                <div class=\"perspectives-list\">{perspectives_html}</div>\n  1271→            </div>\n  1272→        </div>\n  1273→    </div>\n  1274→    '''\n  1275→\n  1276→\n  1277→# =============================================================================\n  1278→# COMPONENT REGISTRY AND RENDERER\n  1279→# =============================================================================\n  1280→\n  1281→COMPONENT_RENDERERS = {\n  1282→    # Common components\n  1283→    ComponentType.VERDICT_HERO: render_verdict_hero,\n  1284→    ComponentType.METRIC_CARDS: render_metric_cards,\n  1285→    ComponentType.FINDINGS_TABLE: render_findings_table,\n  1286→    ComponentType.TIMELINE: render_timeline,\n  1287→    ComponentType.QUOTE_CAROUSEL: render_quote_carousel,\n  1288→    ComponentType.RISK_MATRIX: render_risk_matrix,\n  1289→    ComponentType.CHECKLIST: render_checklist,\n  1290→    ComponentType.SOURCE_LIST: render_source_list,\n  1291→    ComponentType.PREDICTION_CARDS: render_prediction_cards,\n  1292→    ComponentType.KEY_INSIGHTS: render_key_insights,\n  1293→    ComponentType.EXECUTIVE_SUMMARY: render_executive_summary,\n  1294→    ComponentType.CONFIDENCE_GAUGE: render_confidence_gauge,\n  1295→    ComponentType.ACTION_ITEMS: render_action_items,\n  1296→    ComponentType.PROS_CONS: render_pros_cons,\n  1297→    ComponentType.COMPARISON_TABLE: render_comparison_table,\n  1298→\n  1299→    # Template-specific components\n  1300→    ComponentType.TECH_RADAR: render_tech_radar,\n  1301→    ComponentType.INVESTMENT_THESIS: render_investment_thesis,\n  1302→    ComponentType.COMPETITOR_MATRIX: render_competitor_matrix,\n  1303→    ComponentType.INVESTIGATION_TIMELINE: render_investigation_timeline,\n  1304→    ComponentType.LEGAL_CASE_TRACKER: render_legal_case_tracker,\n  1305→    ComponentType.CONTRACT_ANALYSIS: render_contract_analysis,\n  1306→    ComponentType.DUE_DILIGENCE_SCORECARD: render_due_diligence_scorecard,\n  1307→    ComponentType.DECISION_MATRIX: render_decision_matrix,\n  1308→    ComponentType.TRUST_DASHBOARD: render_trust_dashboard,\n  1309→    ComponentType.EVENT_EXPLAINER: render_event_explainer,\n  1310→}\n  1311→\n  1312→\n  1313→def render_component(component_type: ComponentType, data: Dict[str, Any], config: ComponentConfig = None) -> str:\n  1314→    \"\"\"Render a single component.\"\"\"\n  1315→    if config is None:\n  1316→        config = ComponentConfig(component_type=component_type)\n  1317→\n  1318→    renderer = COMPONENT_RENDERERS.get(component_type)\n  1319→    if renderer:\n  1320→        return renderer(data, config)\n  1321→    return f'<!-- Unknown component: {component_type} -->'\n  1322→\n  1323→\n  1324→def render_components(components: List[tuple], report_data: Dict[str, Any]) -> Dict[str, str]:\n  1325→    \"\"\"\n  1326→    Render multiple components and return organized by position.\n  1327→    components: [(ComponentType, ComponentConfig)]\n  1328→    Returns: {position: html_string}\n  1329→    \"\"\"\n  1330→    rendered = {\"hero\": \"\", \"main\": \"\", \"sidebar\": \"\"}\n  1331→\n  1332→    # Sort by priority\n  1333→    sorted_components = sorted(components, key=lambda x: x[1].priority if x[1] else 50, reverse=True)\n  1334→\n  1335→    for comp_type, config in sorted_components:\n  1336→        if config is None:\n  1337→            config = ComponentConfig(component_type=comp_type)\n  1338→\n  1339→        # Get data for this component from report_data\n  1340→        data_key = comp_type.value\n  1341→        component_data = report_data.get(data_key, {})\n  1342→\n  1343→        html = render_component(comp_type, component_data, config)\n  1344→        position = config.position\n  1345→        rendered[position] = rendered.get(position, \"\") + html\n  1346→\n  1347→    return rendered\n  1348→\n  1349→\n  1350→# =============================================================================\n  1351→# TEMPLATE REPORT HINTS DEFINITIONS\n  1352→# =============================================================================\n  1353→\n  1354→TEMPLATE_REPORT_HINTS = {\n  1355→    \"tech_market\": ReportHints(\n  1356→        template_type=\"tech_market\",\n  1357→        structure=\"quantitative_first\",\n  1358→        findings_grouping=\"category\",\n  1359→        tone=\"analytical\",\n  1360→        decision_format=\"recommendation\",\n  1361→        emphasis=[\"adoption_metrics\", \"market_trends\", \"technology_comparison\"],\n  1362→        required_components=[\n  1363→            ComponentType.TECH_RADAR,\n  1364→            ComponentType.METRIC_CARDS,\n  1365→            ComponentType.FINDINGS_TABLE,\n  1366→        ],\n  1367→        optional_components=[\n  1368→            ComponentType.TIMELINE,\n  1369→            ComponentType.COMPARISON_TABLE,\n  1370→            ComponentType.PREDICTION_CARDS,\n  1371→            ComponentType.KEY_INSIGHTS,\n  1372→        ],\n  1373→        visualization_preference=[\"tech_radar\", \"adoption_chart\", \"comparison_matrix\"],\n  1374→    ),\n  1375→\n  1376→    \"financial\": ReportHints(\n  1377→        template_type=\"financial\",\n  1378→        structure=\"quantitative_first\",\n  1379→        findings_grouping=\"sentiment\",\n  1380→        tone=\"analytical\",\n  1381→        decision_format=\"thesis\",\n  1382→        emphasis=[\"valuation\", \"risk_assessment\", \"financial_metrics\"],\n  1383→        required_components=[\n  1384→            ComponentType.INVESTMENT_THESIS,\n  1385→            ComponentType.METRIC_CARDS,\n  1386→            ComponentType.RISK_MATRIX,\n  1387→        ],\n  1388→        optional_components=[\n  1389→            ComponentType.FINDINGS_TABLE,\n  1390→            ComponentType.PREDICTION_CARDS,\n  1391→            ComponentType.COMPARISON_TABLE,\n  1392→            ComponentType.CONFIDENCE_GAUGE,\n  1393→        ],\n  1394→        visualization_preference=[\"financial_metrics\", \"risk_matrix\", \"peer_comparison\"],\n  1395→    ),\n  1396→\n  1397→    \"competitive\": ReportHints(\n  1398→        template_type=\"competitive\",\n  1399→        structure=\"balanced\",\n  1400→        findings_grouping=\"category\",\n  1401→        tone=\"analytical\",\n  1402→        decision_format=\"matrix\",\n  1403→        emphasis=[\"market_position\", \"competitive_advantages\", \"strategic_gaps\"],\n  1404→        required_components=[\n  1405→            ComponentType.COMPETITOR_MATRIX,\n  1406→            ComponentType.COMPARISON_TABLE,\n  1407→            ComponentType.METRIC_CARDS,\n  1408→        ],\n  1409→        optional_components=[\n  1410→            ComponentType.FINDINGS_TABLE,\n  1411→            ComponentType.PROS_CONS,\n  1412→            ComponentType.KEY_INSIGHTS,\n  1413→            ComponentType.ACTION_ITEMS,\n  1414→        ],\n  1415→        visualization_preference=[\"competitor_matrix\", \"market_share_chart\", \"swot_grid\"],\n  1416→    ),\n  1417→\n  1418→    \"investigative\": ReportHints(\n  1419→        template_type=\"investigative\",\n  1420→        structure=\"narrative_first\",\n  1421→        findings_grouping=\"chronological\",\n  1422→        tone=\"investigative\",\n  1423→        decision_format=\"recommendation\",\n  1424→        emphasis=[\"evidence\", \"timeline\", \"key_actors\", \"implications\"],\n  1425→        required_components=[\n  1426→            ComponentType.INVESTIGATION_TIMELINE,\n  1427→            ComponentType.FINDINGS_TABLE,\n  1428→            ComponentType.QUOTE_CAROUSEL,\n  1429→        ],\n  1430→        optional_components=[\n  1431→            ComponentType.KEY_INSIGHTS,\n  1432→            ComponentType.RISK_MATRIX,\n  1433→            ComponentType.CHECKLIST,\n  1434→            ComponentType.SOURCE_LIST,\n  1435→        ],\n  1436→        visualization_preference=[\"investigation_timeline\", \"evidence_network\", \"actor_map\"],\n  1437→    ),\n  1438→\n  1439→    \"legal\": ReportHints(\n  1440→        template_type=\"legal\",\n  1441→        structure=\"narrative_first\",\n  1442→        findings_grouping=\"category\",\n  1443→        tone=\"professional\",\n  1444→        decision_format=\"recommendation\",\n  1445→        emphasis=[\"legal_precedents\", \"regulatory_implications\", \"compliance_requirements\"],\n  1446→        required_components=[\n  1447→            ComponentType.LEGAL_CASE_TRACKER,\n  1448→            ComponentType.FINDINGS_TABLE,\n  1449→            ComponentType.TIMELINE,\n  1450→        ],\n  1451→        optional_components=[\n  1452→            ComponentType.KEY_INSIGHTS,\n  1453→            ComponentType.CHECKLIST,\n  1454→            ComponentType.RISK_MATRIX,\n  1455→            ComponentType.ACTION_ITEMS,\n  1456→        ],\n  1457→        visualization_preference=[\"case_timeline\", \"jurisdiction_map\", \"precedent_chain\"],\n  1458→    ),\n  1459→\n  1460→    \"contract\": ReportHints(\n  1461→        template_type=\"contract\",\n  1462→        structure=\"balanced\",\n  1463→        findings_grouping=\"category\",\n  1464→        tone=\"professional\",\n  1465→        decision_format=\"checklist\",\n  1466→        emphasis=[\"key_terms\", \"obligations\", \"risks\", \"opportunities\"],\n  1467→        required_components=[\n  1468→            ComponentType.CONTRACT_ANALYSIS,\n  1469→            ComponentType.CHECKLIST,\n  1470→            ComponentType.RISK_MATRIX,\n  1471→        ],\n  1472→        optional_components=[\n  1473→            ComponentType.FINDINGS_TABLE,\n  1474→            ComponentType.ACTION_ITEMS,\n  1475→            ComponentType.COMPARISON_TABLE,\n  1476→            ComponentType.KEY_INSIGHTS,\n  1477→        ],\n  1478→        visualization_preference=[\"contract_structure\", \"obligation_timeline\", \"risk_assessment\"],\n  1479→    ),\n  1480→\n  1481→    \"due_diligence\": ReportHints(\n  1482→        template_type=\"due_diligence\",\n  1483→        structure=\"verdict_first\",\n  1484→        findings_grouping=\"category\",\n  1485→        tone=\"professional\",\n  1486→        decision_format=\"scorecard\",\n  1487→        emphasis=[\"overall_assessment\", \"red_flags\", \"strengths\", \"category_scores\"],\n  1488→        required_components=[\n  1489→            ComponentType.DUE_DILIGENCE_SCORECARD,\n  1490→            ComponentType.CHECKLIST,\n  1491→            ComponentType.FINDINGS_TABLE,\n  1492→        ],\n  1493→        optional_components=[\n  1494→            ComponentType.RISK_MATRIX,\n  1495→            ComponentType.KEY_INSIGHTS,\n  1496→            ComponentType.ACTION_ITEMS,\n  1497→            ComponentType.TIMELINE,\n  1498→        ],\n  1499→        visualization_preference=[\"scorecard\", \"category_radar\", \"red_flag_matrix\"],\n  1500→    ),\n  1501→\n  1502→    \"purchase_decision\": ReportHints(\n  1503→        template_type=\"purchase_decision\",\n  1504→        structure=\"verdict_first\",\n  1505→        findings_grouping=\"category\",\n  1506→        tone=\"advisory\",\n  1507→        decision_format=\"matrix\",\n  1508→        emphasis=[\"recommendation\", \"comparison\", \"value_assessment\", \"user_fit\"],\n  1509→        required_components=[\n  1510→            ComponentType.DECISION_MATRIX,\n  1511→            ComponentType.VERDICT_HERO,\n  1512→            ComponentType.PROS_CONS,\n  1513→        ],\n  1514→        optional_components=[\n  1515→            ComponentType.COMPARISON_TABLE,\n  1516→            ComponentType.METRIC_CARDS,\n  1517→            ComponentType.CHECKLIST,\n  1518→            ComponentType.QUOTE_CAROUSEL,\n  1519→        ],\n  1520→        visualization_preference=[\"decision_matrix\", \"comparison_chart\", \"value_radar\"],\n  1521→    ),\n  1522→\n  1523→    \"reputation\": ReportHints(\n  1524→        template_type=\"reputation\",\n  1525→        structure=\"verdict_first\",\n  1526→        findings_grouping=\"sentiment\",\n  1527→        tone=\"advisory\",\n  1528→        decision_format=\"checklist\",\n  1529→        emphasis=[\"trust_score\", \"red_flags\", \"user_sentiment\", \"verification\"],\n  1530→        required_components=[\n  1531→            ComponentType.TRUST_DASHBOARD,\n  1532→            ComponentType.CHECKLIST,\n  1533→            ComponentType.FINDINGS_TABLE,\n  1534→        ],\n  1535→        optional_components=[\n  1536→            ComponentType.QUOTE_CAROUSEL,\n  1537→            ComponentType.TIMELINE,\n  1538→            ComponentType.KEY_INSIGHTS,\n  1539→            ComponentType.SOURCE_LIST,\n  1540→        ],\n  1541→        visualization_preference=[\"trust_gauge\", \"sentiment_chart\", \"verification_checklist\"],\n  1542→    ),\n  1543→\n  1544→    \"understanding\": ReportHints(\n  1545→        template_type=\"understanding\",\n  1546→        structure=\"narrative_first\",\n  1547→        findings_grouping=\"chronological\",\n  1548→        tone=\"educational\",\n  1549→        decision_format=\"recommendation\",\n  1550→        emphasis=[\"context\", \"explanation\", \"implications\", \"perspectives\"],\n  1551→        required_components=[\n  1552→            ComponentType.EVENT_EXPLAINER,\n  1553→            ComponentType.TIMELINE,\n  1554→            ComponentType.KEY_INSIGHTS,\n  1555→        ],\n  1556→        optional_components=[\n  1557→            ComponentType.FINDINGS_TABLE,\n  1558→            ComponentType.QUOTE_CAROUSEL,\n  1559→            ComponentType.PREDICTION_CARDS,\n  1560→            ComponentType.SOURCE_LIST,\n  1561→        ],\n  1562→        visualization_preference=[\"event_timeline\", \"stakeholder_map\", \"impact_diagram\"],\n  1563→    ),\n  1564→}\n  1565→\n  1566→\n  1567→def get_report_hints(template_type: str) -> ReportHints:\n  1568→    \"\"\"Get report hints for a template type.\"\"\"\n  1569→    return TEMPLATE_REPORT_HINTS.get(template_type, ReportHints(template_type=template_type))\n  1570→\n  1571→\n  1572→def get_default_components(template_type: str) -> List[tuple]:\n  1573→    \"\"\"Get default component configuration for a template type.\"\"\"\n  1574→    hints = get_report_hints(template_type)\n  1575→    components = []\n  1576→\n  1577→    # Add required components with high priority\n  1578→    for i, comp in enumerate(hints.required_components):\n  1579→        config = ComponentConfig(\n  1580→            component_type=comp,\n  1581→            priority=90 - i * 5,\n  1582→            position=\"main\" if comp not in [ComponentType.VERDICT_HERO] else \"hero\"\n  1583→        )\n  1584→        components.append((comp, config))\n  1585→\n  1586→    # Add optional components with lower priority\n  1587→    for i, comp in enumerate(hints.optional_components):\n  1588→        config = ComponentConfig(\n  1589→            component_type=comp,\n  1590→            priority=50 - i * 5,\n  1591→            position=\"main\"\n  1592→        )\n  1593→        components.append((comp, config))\n  1594→\n  1595→    return components\n  1596→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"34eb5170-c9bb-41ec-b332-c49ff6c57668","uuid":"5ccb1dfc-7929-4d78-a7be-adfe0bd0d917","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\actor\\src\\services\\report_components.py","content":"\"\"\"\nReport Components Library\n\nA hybrid component system for template-specific report rendering.\nDefines common reusable components and template-specific components.\n\"\"\"\n\nfrom typing import Dict, List, Any, Optional\nfrom dataclasses import dataclass, field\nfrom enum import Enum\n\n\nclass ComponentType(Enum):\n    \"\"\"Types of visual components available for reports.\"\"\"\n    # Common Components\n    VERDICT_HERO = \"verdict_hero\"\n    METRIC_CARDS = \"metric_cards\"\n    FINDINGS_TABLE = \"findings_table\"\n    TIMELINE = \"timeline\"\n    QUOTE_CAROUSEL = \"quote_carousel\"\n    RISK_MATRIX = \"risk_matrix\"\n    CHECKLIST = \"checklist\"\n    SOURCE_LIST = \"source_list\"\n    PREDICTION_CARDS = \"prediction_cards\"\n    KEY_INSIGHTS = \"key_insights\"\n    EXECUTIVE_SUMMARY = \"executive_summary\"\n    CONFIDENCE_GAUGE = \"confidence_gauge\"\n    ACTION_ITEMS = \"action_items\"\n    PROS_CONS = \"pros_cons\"\n    COMPARISON_TABLE = \"comparison_table\"\n\n    # Template-Specific Components\n    TECH_RADAR = \"tech_radar\"                    # tech_market\n    INVESTMENT_THESIS = \"investment_thesis\"      # financial\n    COMPETITOR_MATRIX = \"competitor_matrix\"      # competitive\n    INVESTIGATION_TIMELINE = \"investigation_timeline\"  # investigative\n    LEGAL_CASE_TRACKER = \"legal_case_tracker\"    # legal\n    CONTRACT_ANALYSIS = \"contract_analysis\"      # contract\n    DUE_DILIGENCE_SCORECARD = \"due_diligence_scorecard\"  # due_diligence\n    DECISION_MATRIX = \"decision_matrix\"          # purchase_decision\n    TRUST_DASHBOARD = \"trust_dashboard\"          # reputation\n    EVENT_EXPLAINER = \"event_explainer\"          # understanding\n\n\n@dataclass\nclass ComponentConfig:\n    \"\"\"Configuration for a report component.\"\"\"\n    component_type: ComponentType\n    title: Optional[str] = None\n    position: str = \"main\"  # main, sidebar, hero\n    priority: int = 50  # 0-100, higher = rendered first\n    max_items: Optional[int] = None\n    collapsible: bool = False\n    default_collapsed: bool = False\n    css_class: str = \"\"\n    options: Dict[str, Any] = field(default_factory=dict)\n\n\n@dataclass\nclass ReportHints:\n    \"\"\"Hints for report generation passed to LLM and renderer.\"\"\"\n    template_type: str\n    structure: str = \"balanced\"  # balanced, quantitative_first, narrative_first, verdict_first\n    findings_grouping: str = \"chronological\"  # chronological, sentiment, category, impact\n    tone: str = \"professional\"  # professional, analytical, advisory, investigative\n    decision_format: str = \"recommendation\"  # recommendation, matrix, checklist, thesis\n    emphasis: List[str] = field(default_factory=list)  # what to highlight\n    required_components: List[ComponentType] = field(default_factory=list)\n    optional_components: List[ComponentType] = field(default_factory=list)\n    visualization_preference: List[str] = field(default_factory=list)\n    custom_sections: Dict[str, Any] = field(default_factory=dict)\n\n\n# =============================================================================\n# COMMON COMPONENT RENDERERS\n# =============================================================================\n\ndef render_verdict_hero(data: Dict[str, Any], config: ComponentConfig) -> str:\n    \"\"\"\n    Hero section with prominent verdict/score display.\n    data: {verdict: str, score: float, headline: str, subtext: str, color: str}\n    \"\"\"\n    verdict = data.get(\"verdict\", \"Analysis Complete\")\n    score = data.get(\"score\", 0)\n    headline = data.get(\"headline\", \"\")\n    subtext = data.get(\"subtext\", \"\")\n    color = data.get(\"color\", \"blue\")\n\n    score_display = f\"{score:.0%}\" if isinstance(score, float) and score <= 1 else str(score)\n\n    return f'''\n    <div class=\"component verdict-hero verdict-{color} {config.css_class}\">\n        <div class=\"verdict-score-ring\">\n            <span class=\"verdict-score\">{score_display}</span>\n        </div>\n        <div class=\"verdict-content\">\n            <h2 class=\"verdict-headline\">{verdict}</h2>\n            <p class=\"verdict-subtext\">{headline}</p>\n            {f'<p class=\"verdict-detail\">{subtext}</p>' if subtext else ''}\n        </div>\n    </div>\n    '''\n\n\ndef render_metric_cards(data: Dict[str, Any], config: ComponentConfig) -> str:\n    \"\"\"\n    Grid of metric cards with labels and values.\n    data: {metrics: [{label: str, value: str, trend: str, description: str}]}\n    \"\"\"\n    metrics = data.get(\"metrics\", [])[:config.max_items or 6]\n\n    cards_html = \"\"\n    for metric in metrics:\n        trend_icon = \"\"\n        if metric.get(\"trend\") == \"up\":\n            trend_icon = '<span class=\"trend-up\">↑</span>'\n        elif metric.get(\"trend\") == \"down\":\n            trend_icon = '<span class=\"trend-down\">↓</span>'\n\n        cards_html += f'''\n        <div class=\"metric-card\">\n            <div class=\"metric-value\">{metric.get(\"value\", \"N/A\")} {trend_icon}</div>\n            <div class=\"metric-label\">{metric.get(\"label\", \"\")}</div>\n            {f'<div class=\"metric-desc\">{metric.get(\"description\", \"\")}</div>' if metric.get(\"description\") else ''}\n        </div>\n        '''\n\n    title = f'<h3 class=\"component-title\">{config.title}</h3>' if config.title else ''\n    return f'''\n    <div class=\"component metric-cards-container {config.css_class}\">\n        {title}\n        <div class=\"metric-cards-grid\">\n            {cards_html}\n        </div>\n    </div>\n    '''\n\n\ndef render_findings_table(data: Dict[str, Any], config: ComponentConfig) -> str:\n    \"\"\"\n    Findings display with analysis commentary.\n    data: {findings: [{type: str, summary: str, content: str, analysis: str, date: str, confidence: float}]}\n    \"\"\"\n    findings = data.get(\"findings\", [])[:config.max_items or 12]\n\n    items_html = \"\"\n    for finding in findings:\n        conf = finding.get(\"confidence\", 0)\n        conf_class = \"high\" if conf >= 0.8 else \"medium\" if conf >= 0.6 else \"low\"\n        finding_type = finding.get(\"type\", \"general\")\n        analysis = finding.get(\"analysis\", \"\")\n\n        items_html += f'''\n        <div class=\"finding-item\">\n            <div class=\"finding-header\">\n                <span class=\"finding-type-badge {finding_type}\">{finding_type.replace(\"_\", \" \")}</span>\n                <span class=\"finding-date\">{finding.get(\"date\", \"\")}</span>\n                <span class=\"confidence-badge {conf_class}\">{conf:.0%}</span>\n            </div>\n            <div class=\"finding-summary\">{finding.get(\"summary\", \"\")}</div>\n            {f'<div class=\"finding-analysis\">{analysis}</div>' if analysis else ''}\n        </div>\n        '''\n\n    title = f'<h3 class=\"component-title\">{config.title or \"Key Findings\"}</h3>'\n    return f'''\n    <div class=\"component findings-container {config.css_class}\">\n        {title}\n        <div class=\"findings-list\">\n            {items_html}\n        </div>\n    </div>\n    '''\n\n\ndef render_timeline(data: Dict[str, Any], config: ComponentConfig) -> str:\n    \"\"\"\n    Vertical timeline of events.\n    data: {events: [{date: str, title: str, description: str, type: str, importance: str}]}\n    \"\"\"\n    events = data.get(\"events\", [])[:config.max_items or 8]\n\n    events_html = \"\"\n    for event in events:\n        importance = event.get(\"importance\", \"normal\")\n        events_html += f'''\n        <div class=\"timeline-event timeline-{importance}\">\n            <div class=\"timeline-marker\"></div>\n            <div class=\"timeline-date\">{event.get(\"date\", \"\")}</div>\n            <div class=\"timeline-content\">\n                <h4 class=\"timeline-title\">{event.get(\"title\", \"\")}</h4>\n                <p class=\"timeline-desc\">{event.get(\"description\", \"\")}</p>\n                {f'<span class=\"timeline-type\">{event.get(\"type\", \"\")}</span>' if event.get(\"type\") else ''}\n            </div>\n        </div>\n        '''\n\n    title = f'<h3 class=\"component-title\">{config.title or \"Timeline\"}</h3>' if config.title else '<h3 class=\"component-title\">Timeline</h3>'\n    return f'''\n    <div class=\"component timeline-container {config.css_class}\">\n        {title}\n        <div class=\"timeline\">\n            {events_html}\n        </div>\n    </div>\n    '''\n\n\ndef render_quote_carousel(data: Dict[str, Any], config: ComponentConfig) -> str:\n    \"\"\"\n    Carousel of quotes/testimonials.\n    data: {quotes: [{text: str, source: str, date: str, sentiment: str}]}\n    \"\"\"\n    quotes = data.get(\"quotes\", [])[:config.max_items or 5]\n\n    quotes_html = \"\"\n    for i, quote in enumerate(quotes):\n        sentiment = quote.get(\"sentiment\", \"neutral\")\n        active = \"active\" if i == 0 else \"\"\n        quotes_html += f'''\n        <div class=\"quote-slide {active}\" data-index=\"{i}\">\n            <blockquote class=\"quote-text quote-{sentiment}\">\"{quote.get(\"text\", \"\")}\"</blockquote>\n            <cite class=\"quote-source\">— {quote.get(\"source\", \"Unknown\")} {f'({quote.get(\"date\", \"\")})' if quote.get(\"date\") else ''}</cite>\n        </div>\n        '''\n\n    dots_html = \"\".join([f'<span class=\"carousel-dot {\"active\" if i == 0 else \"\"}\" data-index=\"{i}\"></span>' for i in range(len(quotes))])\n\n    title = f'<h3 class=\"component-title\">{config.title or \"Expert Perspectives\"}</h3>'\n    return f'''\n    <div class=\"component quote-carousel-container {config.css_class}\" x-data=\"{{currentSlide: 0, totalSlides: {len(quotes)}}}\">\n        {title}\n        <div class=\"quote-carousel\">\n            {quotes_html}\n        </div>\n        <div class=\"carousel-controls\">\n            <button class=\"carousel-btn prev\" @click=\"currentSlide = (currentSlide - 1 + totalSlides) % totalSlides\">‹</button>\n            <div class=\"carousel-dots\">{dots_html}</div>\n            <button class=\"carousel-btn next\" @click=\"currentSlide = (currentSlide + 1) % totalSlides\">›</button>\n        </div>\n    </div>\n    '''\n\n\ndef render_risk_matrix(data: Dict[str, Any], config: ComponentConfig) -> str:\n    \"\"\"\n    2D risk assessment matrix.\n    data: {risks: [{name: str, likelihood: float, impact: float, category: str}], x_label: str, y_label: str}\n    \"\"\"\n    risks = data.get(\"risks\", [])[:config.max_items or 10]\n    x_label = data.get(\"x_label\", \"Likelihood\")\n    y_label = data.get(\"y_label\", \"Impact\")\n\n    # Position risks on grid\n    risk_items = \"\"\n    for risk in risks:\n        x_pos = risk.get(\"likelihood\", 0.5) * 100\n        y_pos = (1 - risk.get(\"impact\", 0.5)) * 100  # Invert Y axis\n        category = risk.get(\"category\", \"general\")\n        risk_items += f'''\n        <div class=\"risk-item risk-{category}\" style=\"left: {x_pos}%; top: {y_pos}%;\" title=\"{risk.get(\"name\", \"\")}\">\n            <span class=\"risk-dot\"></span>\n            <span class=\"risk-label\">{risk.get(\"name\", \"\")[:20]}</span>\n        </div>\n        '''\n\n    title = f'<h3 class=\"component-title\">{config.title or \"Risk Assessment Matrix\"}</h3>'\n    return f'''\n    <div class=\"component risk-matrix-container {config.css_class}\">\n        {title}\n        <div class=\"risk-matrix\">\n            <div class=\"risk-y-axis\">\n                <span class=\"axis-label\">{y_label}</span>\n                <span class=\"axis-high\">High</span>\n                <span class=\"axis-low\">Low</span>\n            </div>\n            <div class=\"risk-grid\">\n                <div class=\"risk-quadrant risk-critical\">Critical</div>\n                <div class=\"risk-quadrant risk-high\">High</div>\n                <div class=\"risk-quadrant risk-medium\">Medium</div>\n                <div class=\"risk-quadrant risk-low\">Low</div>\n                {risk_items}\n            </div>\n            <div class=\"risk-x-axis\">\n                <span class=\"axis-low\">Low</span>\n                <span class=\"axis-label\">{x_label}</span>\n                <span class=\"axis-high\">High</span>\n            </div>\n        </div>\n    </div>\n    '''\n\n\ndef render_checklist(data: Dict[str, Any], config: ComponentConfig) -> str:\n    \"\"\"\n    Interactive checklist with status indicators.\n    data: {items: [{text: str, status: str, severity: str, detail: str}], title: str}\n    \"\"\"\n    items = data.get(\"items\", [])[:config.max_items or 12]\n\n    items_html = \"\"\n    for item in items:\n        status = item.get(\"status\", \"unchecked\")  # checked, unchecked, warning, critical\n        severity = item.get(\"severity\", \"info\")\n        icon = \"✓\" if status == \"checked\" else \"✗\" if status == \"critical\" else \"⚠\" if status == \"warning\" else \"○\"\n\n        items_html += f'''\n        <li class=\"checklist-item checklist-{status} severity-{severity}\">\n            <span class=\"checklist-icon\">{icon}</span>\n            <span class=\"checklist-text\">{item.get(\"text\", \"\")}</span>\n            {f'<span class=\"checklist-detail\">{item.get(\"detail\", \"\")}</span>' if item.get(\"detail\") else ''}\n        </li>\n        '''\n\n    title = f'<h3 class=\"component-title\">{config.title or \"Checklist\"}</h3>'\n    return f'''\n    <div class=\"component checklist-container {config.css_class}\">\n        {title}\n        <ul class=\"checklist\">\n            {items_html}\n        </ul>\n    </div>\n    '''\n\n\ndef render_source_list(data: Dict[str, Any], config: ComponentConfig) -> str:\n    \"\"\"\n    List of sources with credibility indicators.\n    data: {sources: [{title: str, url: str, credibility: str, type: str, date: str}]}\n    \"\"\"\n    sources = data.get(\"sources\", [])[:config.max_items or 15]\n\n    sources_html = \"\"\n    for source in sources:\n        credibility = source.get(\"credibility\", \"medium\")\n        sources_html += f'''\n        <li class=\"source-item source-{credibility}\">\n            <span class=\"source-credibility-dot\"></span>\n            <a href=\"{source.get(\"url\", \"#\")}\" target=\"_blank\" class=\"source-link\">{source.get(\"title\", \"Unknown Source\")}</a>\n            <span class=\"source-meta\">\n                <span class=\"source-type\">{source.get(\"type\", \"\")}</span>\n                <span class=\"source-date\">{source.get(\"date\", \"\")}</span>\n            </span>\n        </li>\n        '''\n\n    title = f'<h3 class=\"component-title\">{config.title or \"Sources\"}</h3>'\n    return f'''\n    <div class=\"component source-list-container {config.css_class}\">\n        {title}\n        <ul class=\"source-list\">\n            {sources_html}\n        </ul>\n    </div>\n    '''\n\n\ndef render_prediction_cards(data: Dict[str, Any], config: ComponentConfig) -> str:\n    \"\"\"\n    Cards displaying predictions with confidence and timeline.\n    data: {predictions: [{prediction: str, rationale: str, confidence: str, timeline: str, source_perspective: str}]}\n    \"\"\"\n    predictions = data.get(\"predictions\", [])[:config.max_items or 5]\n\n    cards_html = \"\"\n    for pred in predictions:\n        conf = pred.get(\"confidence\", \"medium\")\n        # Handle both string and float confidence values\n        if isinstance(conf, (int, float)):\n            conf_label = \"high\" if conf >= 0.7 else \"medium\" if conf >= 0.4 else \"low\"\n            conf_display = f\"{int(conf * 100)}%\"\n        else:\n            conf_label = str(conf).lower()\n            conf_display = str(conf).upper()\n        cards_html += f'''\n        <div class=\"prediction-card prediction-{conf_label}\">\n            <div class=\"prediction-header\">\n                <span class=\"prediction-confidence\">{conf_display}</span>\n                <span class=\"prediction-timeline\">{pred.get(\"timeline\", \"\")}</span>\n            </div>\n            <h4 class=\"prediction-text\">{pred.get(\"prediction\", \"\")}</h4>\n            <p class=\"prediction-rationale\">{pred.get(\"rationale\", \"\")}</p>\n            <div class=\"prediction-footer\">\n                <span class=\"prediction-source\">Based on: {pred.get(\"source_perspective\", \"Analysis\")}</span>\n            </div>\n        </div>\n        '''\n\n    title = f'<h3 class=\"component-title\">{config.title or \"Predictions & Outlook\"}</h3>'\n    return f'''\n    <div class=\"component prediction-cards-container {config.css_class}\">\n        {title}\n        <div class=\"prediction-cards\">\n            {cards_html}\n        </div>\n    </div>\n    '''\n\n\ndef render_key_insights(data: Dict[str, Any], config: ComponentConfig) -> str:\n    \"\"\"\n    Highlighted key insights with descriptions.\n    data: {insights: [{insight: str, description: str, category: str, importance: str}]}\n    \"\"\"\n    insights = data.get(\"insights\", [])[:config.max_items or 6]\n\n    insights_html = \"\"\n    for insight in insights:\n        importance = insight.get(\"importance\", \"normal\")\n        description = insight.get(\"description\", \"\")\n        category = insight.get(\"category\", \"\")\n\n        insights_html += f'''\n        <div class=\"insight-item insight-{importance}\">\n            <div class=\"insight-header\">\n                <span class=\"insight-text\">{insight.get(\"insight\", \"\")}</span>\n                {f'<span class=\"insight-category\">{category}</span>' if category else ''}\n            </div>\n            {f'<div class=\"insight-description\">{description}</div>' if description else ''}\n        </div>\n        '''\n\n    title = f'<h3 class=\"component-title\">{config.title or \"Key Insights\"}</h3>'\n    return f'''\n    <div class=\"component key-insights-container {config.css_class}\">\n        {title}\n        <div class=\"insights-list\">\n            {insights_html}\n        </div>\n    </div>\n    '''\n\n\ndef render_executive_summary(data: Dict[str, Any], config: ComponentConfig) -> str:\n    \"\"\"\n    Executive summary section.\n    data: {summary: str, key_points: [str], recommendation: str}\n    \"\"\"\n    summary = data.get(\"summary\", \"\")\n    key_points = data.get(\"key_points\", [])[:5]\n    recommendation = data.get(\"recommendation\", \"\")\n\n    points_html = \"\".join([f'<li>{point}</li>' for point in key_points])\n\n    title = f'<h3 class=\"component-title\">{config.title or \"Executive Summary\"}</h3>'\n    return f'''\n    <div class=\"component executive-summary-container {config.css_class}\">\n        {title}\n        <div class=\"summary-content\">\n            <p class=\"summary-text\">{summary}</p>\n            {f'<ul class=\"summary-points\">{points_html}</ul>' if key_points else ''}\n            {f'<div class=\"summary-recommendation\"><strong>Recommendation:</strong> {recommendation}</div>' if recommendation else ''}\n        </div>\n    </div>\n    '''\n\n\ndef render_confidence_gauge(data: Dict[str, Any], config: ComponentConfig) -> str:\n    \"\"\"\n    Visual confidence gauge.\n    data: {score: float, label: str, factors: [{name: str, score: float}]}\n    \"\"\"\n    score = data.get(\"score\", 0.5)\n    label = data.get(\"label\", \"Confidence\")\n    factors = data.get(\"factors\", [])[:5]\n\n    percentage = score * 100\n    color = \"green\" if score >= 0.7 else \"yellow\" if score >= 0.4 else \"red\"\n\n    factors_html = \"\"\n    for factor in factors:\n        f_pct = factor.get(\"score\", 0.5) * 100\n        factors_html += f'''\n        <div class=\"gauge-factor\">\n            <span class=\"factor-name\">{factor.get(\"name\", \"\")}</span>\n            <div class=\"factor-bar\"><div class=\"factor-fill\" style=\"width: {f_pct}%\"></div></div>\n            <span class=\"factor-score\">{f_pct:.0f}%</span>\n        </div>\n        '''\n\n    title = f'<h3 class=\"component-title\">{config.title or label}</h3>'\n    return f'''\n    <div class=\"component confidence-gauge-container {config.css_class}\">\n        {title}\n        <div class=\"gauge-wrapper\">\n            <div class=\"gauge-circle gauge-{color}\">\n                <svg viewBox=\"0 0 100 100\">\n                    <circle class=\"gauge-bg\" cx=\"50\" cy=\"50\" r=\"45\"/>\n                    <circle class=\"gauge-fill\" cx=\"50\" cy=\"50\" r=\"45\" stroke-dasharray=\"{percentage * 2.83} 283\"/>\n                </svg>\n                <span class=\"gauge-value\">{percentage:.0f}%</span>\n            </div>\n        </div>\n        {f'<div class=\"gauge-factors\">{factors_html}</div>' if factors else ''}\n    </div>\n    '''\n\n\ndef render_action_items(data: Dict[str, Any], config: ComponentConfig) -> str:\n    \"\"\"\n    Actionable next steps.\n    data: {actions: [{action: str, priority: str, owner: str, deadline: str}]}\n    \"\"\"\n    actions = data.get(\"actions\", [])[:config.max_items or 6]\n\n    actions_html = \"\"\n    for action in actions:\n        priority = action.get(\"priority\", \"medium\")\n        actions_html += f'''\n        <div class=\"action-item action-{priority}\">\n            <span class=\"action-priority\">{priority.upper()}</span>\n            <span class=\"action-text\">{action.get(\"action\", \"\")}</span>\n            <div class=\"action-meta\">\n                {f'<span class=\"action-owner\">{action.get(\"owner\", \"\")}</span>' if action.get(\"owner\") else ''}\n                {f'<span class=\"action-deadline\">{action.get(\"deadline\", \"\")}</span>' if action.get(\"deadline\") else ''}\n            </div>\n        </div>\n        '''\n\n    title = f'<h3 class=\"component-title\">{config.title or \"Recommended Actions\"}</h3>'\n    return f'''\n    <div class=\"component action-items-container {config.css_class}\">\n        {title}\n        <div class=\"actions-list\">\n            {actions_html}\n        </div>\n    </div>\n    '''\n\n\ndef render_pros_cons(data: Dict[str, Any], config: ComponentConfig) -> str:\n    \"\"\"\n    Pros and cons comparison.\n    data: {pros: [{text: str, weight: str}], cons: [{text: str, weight: str}]}\n    \"\"\"\n    pros = data.get(\"pros\", [])[:config.max_items or 6]\n    cons = data.get(\"cons\", [])[:config.max_items or 6]\n\n    pros_html = \"\".join([f'<li class=\"pro-item weight-{p.get(\"weight\", \"normal\")}\"><span class=\"pro-icon\">✓</span>{p.get(\"text\", \"\")}</li>' for p in pros])\n    cons_html = \"\".join([f'<li class=\"con-item weight-{c.get(\"weight\", \"normal\")}\"><span class=\"con-icon\">✗</span>{c.get(\"text\", \"\")}</li>' for c in cons])\n\n    title = f'<h3 class=\"component-title\">{config.title or \"Pros & Cons\"}</h3>'\n    return f'''\n    <div class=\"component pros-cons-container {config.css_class}\">\n        {title}\n        <div class=\"pros-cons-grid\">\n            <div class=\"pros-column\">\n                <h4 class=\"column-header pros-header\">Advantages</h4>\n                <ul class=\"pros-list\">{pros_html}</ul>\n            </div>\n            <div class=\"cons-column\">\n                <h4 class=\"column-header cons-header\">Disadvantages</h4>\n                <ul class=\"cons-list\">{cons_html}</ul>\n            </div>\n        </div>\n    </div>\n    '''\n\n\ndef render_comparison_table(data: Dict[str, Any], config: ComponentConfig) -> str:\n    \"\"\"\n    Generic comparison table.\n    data: {headers: [str], rows: [[str]], highlight_column: int}\n    \"\"\"\n    headers = data.get(\"headers\", [])\n    rows = data.get(\"rows\", [])\n    highlight_col = data.get(\"highlight_column\", -1)\n\n    header_html = \"\".join([f'<th class=\"{\"highlight\" if i == highlight_col else \"\"}\">{h}</th>' for i, h in enumerate(headers)])\n\n    rows_html = \"\"\n    for row in rows:\n        cells = \"\".join([f'<td class=\"{\"highlight\" if i == highlight_col else \"\"}\">{cell}</td>' for i, cell in enumerate(row)])\n        rows_html += f'<tr>{cells}</tr>'\n\n    title = f'<h3 class=\"component-title\">{config.title or \"Comparison\"}</h3>'\n    return f'''\n    <div class=\"component comparison-table-container {config.css_class}\">\n        {title}\n        <div class=\"table-wrapper\">\n            <table class=\"comparison-table\">\n                <thead><tr>{header_html}</tr></thead>\n                <tbody>{rows_html}</tbody>\n            </table>\n        </div>\n    </div>\n    '''\n\n\n# =============================================================================\n# TEMPLATE-SPECIFIC COMPONENT RENDERERS\n# =============================================================================\n\ndef render_tech_radar(data: Dict[str, Any], config: ComponentConfig) -> str:\n    \"\"\"\n    Technology radar visualization for tech_market template.\n    data: {technologies: [{name: str, ring: str, quadrant: str, moved: str, description: str}]}\n    Rings: adopt, trial, assess, hold\n    Quadrants: techniques, tools, platforms, languages\n    \"\"\"\n    technologies = data.get(\"technologies\", [])\n\n    # Group by quadrant\n    quadrants = {\"techniques\": [], \"tools\": [], \"platforms\": [], \"languages\": []}\n    for tech in technologies:\n        q = tech.get(\"quadrant\", \"tools\")\n        if q in quadrants:\n            quadrants[q].append(tech)\n\n    ring_radius = {\"adopt\": 25, \"trial\": 45, \"assess\": 65, \"hold\": 85}\n\n    blips_html = \"\"\n    for q_idx, (quadrant, techs) in enumerate(quadrants.items()):\n        angle_start = q_idx * 90\n        for i, tech in enumerate(techs[:8]):\n            ring = tech.get(\"ring\", \"assess\")\n            radius = ring_radius.get(ring, 65)\n            angle = angle_start + 10 + (i * 10)\n            moved = tech.get(\"moved\", \"none\")\n            moved_icon = \"↑\" if moved == \"up\" else \"↓\" if moved == \"down\" else \"\"\n\n            blips_html += f'''\n            <div class=\"radar-blip ring-{ring} quadrant-{quadrant}\"\n                 style=\"--angle: {angle}deg; --radius: {radius}%;\"\n                 title=\"{tech.get(\"name\", \"\")}: {tech.get(\"description\", \"\")}\">\n                <span class=\"blip-label\">{tech.get(\"name\", \"\")[:12]}</span>\n                {f'<span class=\"blip-moved\">{moved_icon}</span>' if moved_icon else ''}\n            </div>\n            '''\n\n    title = f'<h3 class=\"component-title\">{config.title or \"Technology Radar\"}</h3>'\n    return f'''\n    <div class=\"component tech-radar-container {config.css_class}\">\n        {title}\n        <div class=\"tech-radar\">\n            <div class=\"radar-rings\">\n                <div class=\"radar-ring ring-hold\"><span>Hold</span></div>\n                <div class=\"radar-ring ring-assess\"><span>Assess</span></div>\n                <div class=\"radar-ring ring-trial\"><span>Trial</span></div>\n                <div class=\"radar-ring ring-adopt\"><span>Adopt</span></div>\n            </div>\n            <div class=\"radar-quadrants\">\n                <div class=\"quadrant-label q-techniques\">Techniques</div>\n                <div class=\"quadrant-label q-tools\">Tools</div>\n                <div class=\"quadrant-label q-platforms\">Platforms</div>\n                <div class=\"quadrant-label q-languages\">Languages</div>\n            </div>\n            <div class=\"radar-blips\">\n                {blips_html}\n            </div>\n        </div>\n        <div class=\"radar-legend\">\n            <span class=\"legend-item\"><span class=\"legend-dot ring-adopt\"></span>Adopt</span>\n            <span class=\"legend-item\"><span class=\"legend-dot ring-trial\"></span>Trial</span>\n            <span class=\"legend-item\"><span class=\"legend-dot ring-assess\"></span>Assess</span>\n            <span class=\"legend-item\"><span class=\"legend-dot ring-hold\"></span>Hold</span>\n        </div>\n    </div>\n    '''\n\n\ndef render_investment_thesis(data: Dict[str, Any], config: ComponentConfig) -> str:\n    \"\"\"\n    Investment thesis panel for financial template.\n    data: {verdict: str, target_price: str, risk_level: str,\n           bull_case: str, bear_case: str, key_catalysts: [str], key_risks: [str]}\n    \"\"\"\n    verdict = data.get(\"verdict\", \"Hold\")\n    verdict_class = \"buy\" if verdict.lower() in [\"buy\", \"strong buy\"] else \"sell\" if verdict.lower() in [\"sell\", \"strong sell\"] else \"hold\"\n    target_price = data.get(\"target_price\", \"\")\n\n    # Build compact header with verdict + optional target\n    header_extra = f'<span class=\"thesis-target\">Target: {target_price}</span>' if target_price and target_price != \"N/A\" else \"\"\n\n    catalysts_html = \"\".join([f'<li>{c}</li>' for c in data.get(\"key_catalysts\", [])[:5]])\n    risks_html = \"\".join([f'<li>{r}</li>' for r in data.get(\"key_risks\", [])[:5]])\n\n    title = f'<h3 class=\"component-title\">{config.title or \"Investment Thesis\"}</h3>'\n    return f'''\n    <div class=\"component investment-thesis-container {config.css_class}\">\n        {title}\n        <div class=\"thesis-panel\">\n            <div class=\"thesis-header thesis-{verdict_class}\">\n                <span class=\"thesis-verdict-label\">{verdict.upper()}</span>\n                {header_extra}\n            </div>\n            <div class=\"thesis-cases\">\n                <div class=\"bull-case\">\n                    <h4>Bull Case</h4>\n                    <p>{data.get(\"bull_case\", \"No bull case identified.\")}</p>\n                </div>\n                <div class=\"bear-case\">\n                    <h4>Bear Case</h4>\n                    <p>{data.get(\"bear_case\", \"No bear case identified.\")}</p>\n                </div>\n            </div>\n            <div class=\"thesis-factors\">\n                <div class=\"catalysts\">\n                    <h4>Key Catalysts</h4>\n                    <ul>{catalysts_html if catalysts_html else '<li>None identified</li>'}</ul>\n                </div>\n                <div class=\"risks\">\n                    <h4>Key Risks</h4>\n                    <ul>{risks_html if risks_html else '<li>None identified</li>'}</ul>\n                </div>\n            </div>\n        </div>\n    </div>\n    '''\n\n\ndef render_competitor_matrix(data: Dict[str, Any], config: ComponentConfig) -> str:\n    \"\"\"\n    Competitive analysis matrix for competitive template.\n    data: {competitors: [{name: str, scores: {category: score}}], categories: [str], leader: str}\n    \"\"\"\n    competitors = data.get(\"competitors\", [])[:6]\n    categories = data.get(\"categories\", [\"Market Share\", \"Product\", \"Price\", \"Support\"])\n    leader = data.get(\"leader\", \"\")\n\n    # Header row\n    header_html = '<th class=\"category-header\">Competitor</th>'\n    header_html += \"\".join([f'<th class=\"category-header\">{cat}</th>' for cat in categories])\n    header_html += '<th class=\"category-header\">Overall</th>'\n\n    # Data rows\n    rows_html = \"\"\n    for comp in competitors:\n        is_leader = comp.get(\"name\", \"\") == leader\n        scores = comp.get(\"scores\", {})\n        overall = sum(scores.values()) / len(scores) if scores else 0\n\n        cells = f'<td class=\"competitor-name {\"leader\" if is_leader else \"\"}\">{comp.get(\"name\", \"\")} {\"👑\" if is_leader else \"\"}</td>'\n        for cat in categories:\n            score = scores.get(cat, 0)\n            score_class = \"high\" if score >= 8 else \"medium\" if score >= 5 else \"low\"\n            cells += f'<td class=\"score-cell score-{score_class}\">{score:.1f}</td>'\n\n        overall_class = \"high\" if overall >= 8 else \"medium\" if overall >= 5 else \"low\"\n        cells += f'<td class=\"score-cell overall score-{overall_class}\">{overall:.1f}</td>'\n        rows_html += f'<tr class=\"{\"leader-row\" if is_leader else \"\"}\">{cells}</tr>'\n\n    title = f'<h3 class=\"component-title\">{config.title or \"Competitive Matrix\"}</h3>'\n    return f'''\n    <div class=\"component competitor-matrix-container {config.css_class}\">\n        {title}\n        <div class=\"matrix-wrapper\">\n            <table class=\"competitor-matrix\">\n                <thead><tr>{header_html}</tr></thead>\n                <tbody>{rows_html}</tbody>\n            </table>\n        </div>\n        <div class=\"matrix-legend\">\n            <span class=\"legend-item\"><span class=\"score-dot score-high\"></span>Strong (8-10)</span>\n            <span class=\"legend-item\"><span class=\"score-dot score-medium\"></span>Average (5-7)</span>\n            <span class=\"legend-item\"><span class=\"score-dot score-low\"></span>Weak (0-4)</span>\n        </div>\n    </div>\n    '''\n\n\ndef render_investigation_timeline(data: Dict[str, Any], config: ComponentConfig) -> str:\n    \"\"\"\n    Detailed investigation timeline for investigative template.\n    data: {events: [{date: str, title: str, description: str, type: str,\n                    severity: str, sources: [str], key_actors: [str]}]}\n    Types: revelation, development, response, legal, financial\n    \"\"\"\n    events = data.get(\"events\", [])[:config.max_items or 12]\n\n    events_html = \"\"\n    for event in events:\n        event_type = event.get(\"type\", \"development\")\n        severity = event.get(\"severity\", \"medium\")\n        sources = event.get(\"sources\", [])[:2]\n        actors = event.get(\"key_actors\", [])[:3]\n\n        sources_html = \"\".join([f'<span class=\"event-source\">{s}</span>' for s in sources])\n        actors_html = \"\".join([f'<span class=\"event-actor\">{a}</span>' for a in actors])\n\n        events_html += f'''\n        <div class=\"investigation-event event-{event_type} severity-{severity}\">\n            <div class=\"event-timeline-marker\">\n                <span class=\"event-type-icon\">{get_investigation_icon(event_type)}</span>\n            </div>\n            <div class=\"event-card\">\n                <div class=\"event-header\">\n                    <span class=\"event-date\">{event.get(\"date\", \"\")}</span>\n                    <span class=\"event-type-badge\">{event_type.replace(\"_\", \" \").title()}</span>\n                    <span class=\"event-severity severity-{severity}\">{severity.upper()}</span>\n                </div>\n                <h4 class=\"event-title\">{event.get(\"title\", \"\")}</h4>\n                <p class=\"event-description\">{event.get(\"description\", \"\")}</p>\n                <div class=\"event-footer\">\n                    <div class=\"event-actors\">{actors_html}</div>\n                    <div class=\"event-sources\">{sources_html}</div>\n                </div>\n            </div>\n        </div>\n        '''\n\n    title = f'<h3 class=\"component-title\">{config.title or \"Investigation Timeline\"}</h3>'\n    return f'''\n    <div class=\"component investigation-timeline-container {config.css_class}\">\n        {title}\n        <div class=\"investigation-timeline\">\n            {events_html}\n        </div>\n    </div>\n    '''\n\n\ndef get_investigation_icon(event_type: str) -> str:\n    \"\"\"Get icon for investigation event type.\"\"\"\n    icons = {\n        \"revelation\": \"🔍\",\n        \"development\": \"📰\",\n        \"response\": \"💬\",\n        \"legal\": \"⚖️\",\n        \"financial\": \"💰\",\n        \"regulatory\": \"🏛️\",\n        \"whistleblower\": \"🚨\",\n    }\n    return icons.get(event_type, \"📌\")\n\n\ndef render_legal_case_tracker(data: Dict[str, Any], config: ComponentConfig) -> str:\n    \"\"\"\n    Legal case tracking panel for legal template.\n    data: {cases: [{name: str, jurisdiction: str, status: str, parties: [str],\n                   key_dates: [{date: str, event: str}], implications: str, ruling: str}]}\n    \"\"\"\n    cases = data.get(\"cases\", [])[:config.max_items or 5]\n\n    cases_html = \"\"\n    for case in cases:\n        status = case.get(\"status\", \"pending\")\n        parties = \" vs \".join(case.get(\"parties\", [])[:2])\n\n        dates_html = \"\"\n        for kd in case.get(\"key_dates\", [])[:3]:\n            dates_html += f'<div class=\"case-date\"><span class=\"date\">{kd.get(\"date\", \"\")}</span><span class=\"event\">{kd.get(\"event\", \"\")}</span></div>'\n\n        cases_html += f'''\n        <div class=\"legal-case case-{status}\">\n            <div class=\"case-header\">\n                <h4 class=\"case-name\">{case.get(\"name\", \"\")}</h4>\n                <span class=\"case-status status-{status}\">{status.upper()}</span>\n            </div>\n            <div class=\"case-parties\">{parties}</div>\n            <div class=\"case-jurisdiction\">📍 {case.get(\"jurisdiction\", \"\")}</div>\n            <div class=\"case-dates\">{dates_html}</div>\n            {f'<div class=\"case-ruling\"><strong>Ruling:</strong> {case.get(\"ruling\", \"\")}</div>' if case.get(\"ruling\") else ''}\n            <div class=\"case-implications\"><strong>Implications:</strong> {case.get(\"implications\", \"\")}</div>\n        </div>\n        '''\n\n    title = f'<h3 class=\"component-title\">{config.title or \"Legal Case Tracker\"}</h3>'\n    return f'''\n    <div class=\"component legal-case-tracker-container {config.css_class}\">\n        {title}\n        <div class=\"legal-cases\">\n            {cases_html}\n        </div>\n    </div>\n    '''\n\n\ndef render_contract_analysis(data: Dict[str, Any], config: ComponentConfig) -> str:\n    \"\"\"\n    Contract analysis panel for contract template.\n    data: {contract: {name: str, value: str, duration: str, parties: [str], type: str},\n           key_terms: [{term: str, details: str, risk_level: str}],\n           obligations: [{party: str, obligation: str, deadline: str}],\n           red_flags: [str], opportunities: [str]}\n    \"\"\"\n    contract = data.get(\"contract\", {})\n    key_terms = data.get(\"key_terms\", [])[:6]\n    obligations = data.get(\"obligations\", [])[:6]\n    red_flags = data.get(\"red_flags\", [])[:4]\n    opportunities = data.get(\"opportunities\", [])[:4]\n\n    terms_html = \"\"\n    for term in key_terms:\n        risk = term.get(\"risk_level\", \"low\")\n        terms_html += f'''\n        <div class=\"contract-term risk-{risk}\">\n            <span class=\"term-name\">{term.get(\"term\", \"\")}</span>\n            <span class=\"term-details\">{term.get(\"details\", \"\")}</span>\n            <span class=\"term-risk\">{risk.upper()}</span>\n        </div>\n        '''\n\n    obligations_html = \"\"\n    for ob in obligations:\n        obligations_html += f'''\n        <div class=\"contract-obligation\">\n            <span class=\"obligation-party\">{ob.get(\"party\", \"\")}</span>\n            <span class=\"obligation-text\">{ob.get(\"obligation\", \"\")}</span>\n            <span class=\"obligation-deadline\">{ob.get(\"deadline\", \"\")}</span>\n        </div>\n        '''\n\n    flags_html = \"\".join([f'<li class=\"red-flag\">🚩 {f}</li>' for f in red_flags])\n    opps_html = \"\".join([f'<li class=\"opportunity\">✨ {o}</li>' for o in opportunities])\n\n    title = f'<h3 class=\"component-title\">{config.title or \"Contract Analysis\"}</h3>'\n    return f'''\n    <div class=\"component contract-analysis-container {config.css_class}\">\n        {title}\n        <div class=\"contract-overview\">\n            <div class=\"contract-header\">\n                <h4 class=\"contract-name\">{contract.get(\"name\", \"Contract\")}</h4>\n                <span class=\"contract-type\">{contract.get(\"type\", \"\")}</span>\n            </div>\n            <div class=\"contract-meta\">\n                <span class=\"contract-value\">💰 {contract.get(\"value\", \"N/A\")}</span>\n                <span class=\"contract-duration\">📅 {contract.get(\"duration\", \"N/A\")}</span>\n            </div>\n        </div>\n        <div class=\"contract-sections\">\n            <div class=\"key-terms-section\">\n                <h4>Key Terms</h4>\n                <div class=\"terms-list\">{terms_html}</div>\n            </div>\n            <div class=\"obligations-section\">\n                <h4>Obligations</h4>\n                <div class=\"obligations-list\">{obligations_html}</div>\n            </div>\n        </div>\n        <div class=\"contract-assessment\">\n            <div class=\"red-flags-section\">\n                <h4>🚩 Red Flags</h4>\n                <ul>{flags_html}</ul>\n            </div>\n            <div class=\"opportunities-section\">\n                <h4>✨ Opportunities</h4>\n                <ul>{opps_html}</ul>\n            </div>\n        </div>\n    </div>\n    '''\n\n\ndef render_due_diligence_scorecard(data: Dict[str, Any], config: ComponentConfig) -> str:\n    \"\"\"\n    Due diligence scorecard for due_diligence template.\n    data: {overall_score: float, recommendation: str,\n           categories: [{name: str, score: float, findings: [str], weight: float}],\n           red_flags: [{issue: str, severity: str, details: str}],\n           strengths: [str]}\n    \"\"\"\n    overall = data.get(\"overall_score\", 0)\n    recommendation = data.get(\"recommendation\", \"Further Review Needed\")\n    categories = data.get(\"categories\", [])\n    red_flags = data.get(\"red_flags\", [])[:5]\n    strengths = data.get(\"strengths\", [])[:5]\n\n    overall_class = \"pass\" if overall >= 70 else \"caution\" if overall >= 50 else \"fail\"\n\n    categories_html = \"\"\n    for cat in categories:\n        score = cat.get(\"score\", 0)\n        score_class = \"pass\" if score >= 70 else \"caution\" if score >= 50 else \"fail\"\n        findings_html = \"\".join([f'<li>{f}</li>' for f in cat.get(\"findings\", [])[:3]])\n\n        categories_html += f'''\n        <div class=\"dd-category\">\n            <div class=\"dd-category-header\">\n                <span class=\"category-name\">{cat.get(\"name\", \"\")}</span>\n                <span class=\"category-score score-{score_class}\">{score:.0f}</span>\n            </div>\n            <div class=\"category-bar\">\n                <div class=\"category-fill score-{score_class}\" style=\"width: {score}%\"></div>\n            </div>\n            <ul class=\"category-findings\">{findings_html}</ul>\n        </div>\n        '''\n\n    red_flags_html = \"\"\n    for rf in red_flags:\n        severity = rf.get(\"severity\", \"medium\")\n        red_flags_html += f'''\n        <div class=\"dd-red-flag severity-{severity}\">\n            <span class=\"flag-icon\">🚩</span>\n            <span class=\"flag-issue\">{rf.get(\"issue\", \"\")}</span>\n            <span class=\"flag-severity\">{severity.upper()}</span>\n        </div>\n        '''\n\n    strengths_html = \"\".join([f'<li class=\"dd-strength\">✓ {s}</li>' for s in strengths])\n\n    title = f'<h3 class=\"component-title\">{config.title or \"Due Diligence Scorecard\"}</h3>'\n    return f'''\n    <div class=\"component due-diligence-scorecard-container {config.css_class}\">\n        {title}\n        <div class=\"dd-scorecard\">\n            <div class=\"dd-overall score-{overall_class}\">\n                <div class=\"overall-score-circle\">\n                    <span class=\"overall-value\">{overall:.0f}</span>\n                    <span class=\"overall-label\">/ 100</span>\n                </div>\n                <div class=\"overall-recommendation\">{recommendation}</div>\n            </div>\n            <div class=\"dd-categories\">\n                <h4>Category Scores</h4>\n                {categories_html}\n            </div>\n            <div class=\"dd-assessment\">\n                <div class=\"dd-red-flags\">\n                    <h4>Red Flags</h4>\n                    {red_flags_html}\n                </div>\n                <div class=\"dd-strengths\">\n                    <h4>Strengths</h4>\n                    <ul>{strengths_html}</ul>\n                </div>\n            </div>\n        </div>\n    </div>\n    '''\n\n\ndef render_decision_matrix(data: Dict[str, Any], config: ComponentConfig) -> str:\n    \"\"\"\n    Purchase decision matrix for purchase_decision template.\n    data: {options: [{name: str, scores: {criterion: score}, price: str, recommendation: bool}],\n           criteria: [{name: str, weight: float}], winner: str}\n    \"\"\"\n    options = data.get(\"options\", [])[:5]\n    criteria = data.get(\"criteria\", [])\n    winner = data.get(\"winner\", \"\")\n\n    # Header\n    header_html = '<th class=\"option-header\">Criteria</th><th class=\"weight-header\">Weight</th>'\n    for opt in options:\n        is_winner = opt.get(\"name\", \"\") == winner\n        header_html += f'<th class=\"option-name {\"winner\" if is_winner else \"\"}\">{opt.get(\"name\", \"\")} {\"🏆\" if is_winner else \"\"}</th>'\n\n    # Criteria rows\n    rows_html = \"\"\n    for crit in criteria:\n        crit_name = crit.get(\"name\", \"\")\n        weight = crit.get(\"weight\", 1)\n        row = f'<td class=\"criterion-name\">{crit_name}</td><td class=\"criterion-weight\">{weight:.1f}x</td>'\n\n        for opt in options:\n            score = opt.get(\"scores\", {}).get(crit_name, 0)\n            weighted = score * weight\n            score_class = \"high\" if score >= 8 else \"medium\" if score >= 5 else \"low\"\n            is_winner = opt.get(\"name\", \"\") == winner\n            row += f'<td class=\"score-cell {\"winner-col\" if is_winner else \"\"} score-{score_class}\">{score:.1f}</td>'\n\n        rows_html += f'<tr>{row}</tr>'\n\n    # Total row\n    total_row = '<td class=\"total-label\"><strong>Weighted Total</strong></td><td></td>'\n    for opt in options:\n        total = sum(opt.get(\"scores\", {}).get(c.get(\"name\", \"\"), 0) * c.get(\"weight\", 1) for c in criteria)\n        is_winner = opt.get(\"name\", \"\") == winner\n        total_row += f'<td class=\"total-score {\"winner-col\" if is_winner else \"\"}\"><strong>{total:.1f}</strong></td>'\n    rows_html += f'<tr class=\"total-row\">{total_row}</tr>'\n\n    # Price row\n    price_row = '<td class=\"price-label\">Price</td><td></td>'\n    for opt in options:\n        is_winner = opt.get(\"name\", \"\") == winner\n        price_row += f'<td class=\"price-cell {\"winner-col\" if is_winner else \"\"}\">{opt.get(\"price\", \"N/A\")}</td>'\n    rows_html += f'<tr class=\"price-row\">{price_row}</tr>'\n\n    title = f'<h3 class=\"component-title\">{config.title or \"Decision Matrix\"}</h3>'\n    return f'''\n    <div class=\"component decision-matrix-container {config.css_class}\">\n        {title}\n        <div class=\"matrix-wrapper\">\n            <table class=\"decision-matrix\">\n                <thead><tr>{header_html}</tr></thead>\n                <tbody>{rows_html}</tbody>\n            </table>\n        </div>\n        <div class=\"matrix-recommendation\">\n            <span class=\"recommendation-label\">Recommended Choice:</span>\n            <span class=\"recommendation-winner\">🏆 {winner}</span>\n        </div>\n    </div>\n    '''\n\n\ndef render_trust_dashboard(data: Dict[str, Any], config: ComponentConfig) -> str:\n    \"\"\"\n    Trust/reputation dashboard for reputation template.\n    data: {trust_score: float, verdict: str, verification_status: str,\n           trust_factors: [{name: str, score: float, status: str}],\n           user_sentiment: {positive: int, neutral: int, negative: int},\n           red_flags: [str], green_flags: [str]}\n    \"\"\"\n    trust_score = data.get(\"trust_score\", 0)\n    verdict = data.get(\"verdict\", \"Unknown\")\n    verification = data.get(\"verification_status\", \"unverified\")\n    factors = data.get(\"trust_factors\", [])\n    sentiment = data.get(\"user_sentiment\", {})\n    red_flags = data.get(\"red_flags\", [])[:5]\n    green_flags = data.get(\"green_flags\", [])[:5]\n\n    score_class = \"trusted\" if trust_score >= 70 else \"caution\" if trust_score >= 40 else \"untrusted\"\n\n    factors_html = \"\"\n    for factor in factors:\n        status = factor.get(\"status\", \"neutral\")\n        factors_html += f'''\n        <div class=\"trust-factor factor-{status}\">\n            <span class=\"factor-icon\">{get_trust_icon(stat
[2026-01-30T09:07:44.810Z] [STDOUT] us)}</span>\n            <span class=\"factor-name\">{factor.get(\"name\", \"\")}</span>\n            <span class=\"factor-score\">{factor.get(\"score\", 0):.0f}%</span>\n        </div>\n        '''\n\n    total_sentiment = sentiment.get(\"positive\", 0) + sentiment.get(\"neutral\", 0) + sentiment.get(\"negative\", 0)\n    pos_pct = (sentiment.get(\"positive\", 0) / total_sentiment * 100) if total_sentiment > 0 else 0\n    neu_pct = (sentiment.get(\"neutral\", 0) / total_sentiment * 100) if total_sentiment > 0 else 0\n    neg_pct = (sentiment.get(\"negative\", 0) / total_sentiment * 100) if total_sentiment > 0 else 0\n\n    red_html = \"\".join([f'<li class=\"flag-item red\">🚩 {f}</li>' for f in red_flags])\n    green_html = \"\".join([f'<li class=\"flag-item green\">✓ {f}</li>' for f in green_flags])\n\n    title = f'<h3 class=\"component-title\">{config.title or \"Trust Assessment\"}</h3>'\n    return f'''\n    <div class=\"component trust-dashboard-container {config.css_class}\">\n        {title}\n        <div class=\"trust-dashboard\">\n            <div class=\"trust-score-panel score-{score_class}\">\n                <div class=\"trust-score-circle\">\n                    <span class=\"trust-value\">{trust_score:.0f}</span>\n                </div>\n                <div class=\"trust-verdict\">{verdict}</div>\n                <div class=\"trust-verification verification-{verification}\">{verification.replace(\"_\", \" \").title()}</div>\n            </div>\n            <div class=\"trust-factors-panel\">\n                <h4>Trust Factors</h4>\n                {factors_html}\n            </div>\n            <div class=\"sentiment-panel\">\n                <h4>User Sentiment</h4>\n                <div class=\"sentiment-bar\">\n                    <div class=\"sentiment-positive\" style=\"width: {pos_pct}%\"></div>\n                    <div class=\"sentiment-neutral\" style=\"width: {neu_pct}%\"></div>\n                    <div class=\"sentiment-negative\" style=\"width: {neg_pct}%\"></div>\n                </div>\n                <div class=\"sentiment-labels\">\n                    <span class=\"positive\">👍 {sentiment.get(\"positive\", 0)}</span>\n                    <span class=\"neutral\">😐 {sentiment.get(\"neutral\", 0)}</span>\n                    <span class=\"negative\">👎 {sentiment.get(\"negative\", 0)}</span>\n                </div>\n            </div>\n            <div class=\"flags-panel\">\n                <div class=\"red-flags\">\n                    <h4>Concerns</h4>\n                    <ul>{red_html}</ul>\n                </div>\n                <div class=\"green-flags\">\n                    <h4>Positives</h4>\n                    <ul>{green_html}</ul>\n                </div>\n            </div>\n        </div>\n    </div>\n    '''\n\n\ndef get_trust_icon(status: str) -> str:\n    \"\"\"Get icon for trust factor status.\"\"\"\n    icons = {\"positive\": \"✓\", \"negative\": \"✗\", \"neutral\": \"○\", \"warning\": \"⚠\"}\n    return icons.get(status, \"○\")\n\n\ndef render_event_explainer(data: Dict[str, Any], config: ComponentConfig) -> str:\n    \"\"\"\n    Event explanation panel for understanding template.\n    data: {event: {title: str, date: str, summary: str},\n           what_happened: str, why_it_matters: str,\n           key_players: [{name: str, role: str, action: str}],\n           timeline: [{date: str, event: str}],\n           implications: [{area: str, impact: str}],\n           different_perspectives: [{perspective: str, view: str}]}\n    \"\"\"\n    event = data.get(\"event\", {})\n    what = data.get(\"what_happened\", \"\")\n    why = data.get(\"why_it_matters\", \"\")\n    players = data.get(\"key_players\", [])[:5]\n    timeline = data.get(\"timeline\", [])[:6]\n    implications = data.get(\"implications\", [])[:4]\n    perspectives = data.get(\"different_perspectives\", [])[:3]\n\n    players_html = \"\"\n    for player in players:\n        players_html += f'''\n        <div class=\"key-player\">\n            <span class=\"player-name\">{player.get(\"name\", \"\")}</span>\n            <span class=\"player-role\">{player.get(\"role\", \"\")}</span>\n            <span class=\"player-action\">{player.get(\"action\", \"\")}</span>\n        </div>\n        '''\n\n    timeline_html = \"\"\n    for item in timeline:\n        timeline_html += f'''\n        <div class=\"timeline-item\">\n            <span class=\"timeline-date\">{item.get(\"date\", \"\")}</span>\n            <span class=\"timeline-event\">{item.get(\"event\", \"\")}</span>\n        </div>\n        '''\n\n    implications_html = \"\"\n    for imp in implications:\n        implications_html += f'''\n        <div class=\"implication-item\">\n            <span class=\"implication-area\">{imp.get(\"area\", \"\")}</span>\n            <span class=\"implication-impact\">{imp.get(\"impact\", \"\")}</span>\n        </div>\n        '''\n\n    perspectives_html = \"\"\n    for persp in perspectives:\n        perspectives_html += f'''\n        <div class=\"perspective-item\">\n            <span class=\"perspective-name\">{persp.get(\"perspective\", \"\")}</span>\n            <p class=\"perspective-view\">{persp.get(\"view\", \"\")}</p>\n        </div>\n        '''\n\n    title = f'<h3 class=\"component-title\">{config.title or \"Event Explained\"}</h3>'\n    return f'''\n    <div class=\"component event-explainer-container {config.css_class}\">\n        {title}\n        <div class=\"event-explainer\">\n            <div class=\"event-header\">\n                <h2 class=\"event-title\">{event.get(\"title\", \"\")}</h2>\n                <span class=\"event-date\">{event.get(\"date\", \"\")}</span>\n            </div>\n            <div class=\"event-summary\">{event.get(\"summary\", \"\")}</div>\n\n            <div class=\"explainer-sections\">\n                <div class=\"what-happened\">\n                    <h4>📖 What Happened</h4>\n                    <p>{what}</p>\n                </div>\n                <div class=\"why-matters\">\n                    <h4>💡 Why It Matters</h4>\n                    <p>{why}</p>\n                </div>\n            </div>\n\n            <div class=\"key-players-section\">\n                <h4>👥 Key Players</h4>\n                <div class=\"players-grid\">{players_html}</div>\n            </div>\n\n            <div class=\"event-timeline-section\">\n                <h4>📅 Timeline</h4>\n                <div class=\"mini-timeline\">{timeline_html}</div>\n            </div>\n\n            <div class=\"implications-section\">\n                <h4>🎯 Implications</h4>\n                <div class=\"implications-grid\">{implications_html}</div>\n            </div>\n\n            <div class=\"perspectives-section\">\n                <h4>🔍 Different Perspectives</h4>\n                <div class=\"perspectives-list\">{perspectives_html}</div>\n            </div>\n        </div>\n    </div>\n    '''\n\n\n# =============================================================================\n# COMPONENT REGISTRY AND RENDERER\n# =============================================================================\n\nCOMPONENT_RENDERERS = {\n    # Common components\n    ComponentType.VERDICT_HERO: render_verdict_hero,\n    ComponentType.METRIC_CARDS: render_metric_cards,\n    ComponentType.FINDINGS_TABLE: render_findings_table,\n    ComponentType.TIMELINE: render_timeline,\n    ComponentType.QUOTE_CAROUSEL: render_quote_carousel,\n    ComponentType.RISK_MATRIX: render_risk_matrix,\n    ComponentType.CHECKLIST: render_checklist,\n    ComponentType.SOURCE_LIST: render_source_list,\n    ComponentType.PREDICTION_CARDS: render_prediction_cards,\n    ComponentType.KEY_INSIGHTS: render_key_insights,\n    ComponentType.EXECUTIVE_SUMMARY: render_executive_summary,\n    ComponentType.CONFIDENCE_GAUGE: render_confidence_gauge,\n    ComponentType.ACTION_ITEMS: render_action_items,\n    ComponentType.PROS_CONS: render_pros_cons,\n    ComponentType.COMPARISON_TABLE: render_comparison_table,\n\n    # Template-specific components\n    ComponentType.TECH_RADAR: render_tech_radar,\n    ComponentType.INVESTMENT_THESIS: render_investment_thesis,\n    ComponentType.COMPETITOR_MATRIX: render_competitor_matrix,\n    ComponentType.INVESTIGATION_TIMELINE: render_investigation_timeline,\n    ComponentType.LEGAL_CASE_TRACKER: render_legal_case_tracker,\n    ComponentType.CONTRACT_ANALYSIS: render_contract_analysis,\n    ComponentType.DUE_DILIGENCE_SCORECARD: render_due_diligence_scorecard,\n    ComponentType.DECISION_MATRIX: render_decision_matrix,\n    ComponentType.TRUST_DASHBOARD: render_trust_dashboard,\n    ComponentType.EVENT_EXPLAINER: render_event_explainer,\n}\n\n\ndef render_component(component_type: ComponentType, data: Dict[str, Any], config: ComponentConfig = None) -> str:\n    \"\"\"Render a single component.\"\"\"\n    if config is None:\n        config = ComponentConfig(component_type=component_type)\n\n    renderer = COMPONENT_RENDERERS.get(component_type)\n    if renderer:\n        return renderer(data, config)\n    return f'<!-- Unknown component: {component_type} -->'\n\n\ndef render_components(components: List[tuple], report_data: Dict[str, Any]) -> Dict[str, str]:\n    \"\"\"\n    Render multiple components and return organized by position.\n    components: [(ComponentType, ComponentConfig)]\n    Returns: {position: html_string}\n    \"\"\"\n    rendered = {\"hero\": \"\", \"main\": \"\", \"sidebar\": \"\"}\n\n    # Sort by priority\n    sorted_components = sorted(components, key=lambda x: x[1].priority if x[1] else 50, reverse=True)\n\n    for comp_type, config in sorted_components:\n        if config is None:\n            config = ComponentConfig(component_type=comp_type)\n\n        # Get data for this component from report_data\n        data_key = comp_type.value\n        component_data = report_data.get(data_key, {})\n\n        html = render_component(comp_type, component_data, config)\n        position = config.position\n        rendered[position] = rendered.get(position, \"\") + html\n\n    return rendered\n\n\n# =============================================================================\n# TEMPLATE REPORT HINTS DEFINITIONS\n# =============================================================================\n\nTEMPLATE_REPORT_HINTS = {\n    \"tech_market\": ReportHints(\n        template_type=\"tech_market\",\n        structure=\"quantitative_first\",\n        findings_grouping=\"category\",\n        tone=\"analytical\",\n        decision_format=\"recommendation\",\n        emphasis=[\"adoption_metrics\", \"market_trends\", \"technology_comparison\"],\n        required_components=[\n            ComponentType.TECH_RADAR,\n            ComponentType.METRIC_CARDS,\n            ComponentType.FINDINGS_TABLE,\n        ],\n        optional_components=[\n            ComponentType.TIMELINE,\n            ComponentType.COMPARISON_TABLE,\n            ComponentType.PREDICTION_CARDS,\n            ComponentType.KEY_INSIGHTS,\n        ],\n        visualization_preference=[\"tech_radar\", \"adoption_chart\", \"comparison_matrix\"],\n    ),\n\n    \"financial\": ReportHints(\n        template_type=\"financial\",\n        structure=\"quantitative_first\",\n        findings_grouping=\"sentiment\",\n        tone=\"analytical\",\n        decision_format=\"thesis\",\n        emphasis=[\"valuation\", \"risk_assessment\", \"financial_metrics\"],\n        required_components=[\n            ComponentType.INVESTMENT_THESIS,\n            ComponentType.METRIC_CARDS,\n            ComponentType.RISK_MATRIX,\n        ],\n        optional_components=[\n            ComponentType.FINDINGS_TABLE,\n            ComponentType.PREDICTION_CARDS,\n            ComponentType.COMPARISON_TABLE,\n            ComponentType.CONFIDENCE_GAUGE,\n        ],\n        visualization_preference=[\"financial_metrics\", \"risk_matrix\", \"peer_comparison\"],\n    ),\n\n    \"competitive\": ReportHints(\n        template_type=\"competitive\",\n        structure=\"balanced\",\n        findings_grouping=\"category\",\n        tone=\"analytical\",\n        decision_format=\"matrix\",\n        emphasis=[\"market_position\", \"competitive_advantages\", \"strategic_gaps\"],\n        required_components=[\n            ComponentType.COMPETITOR_MATRIX,\n            ComponentType.COMPARISON_TABLE,\n            ComponentType.METRIC_CARDS,\n        ],\n        optional_components=[\n            ComponentType.FINDINGS_TABLE,\n            ComponentType.PROS_CONS,\n            ComponentType.KEY_INSIGHTS,\n            ComponentType.ACTION_ITEMS,\n        ],\n        visualization_preference=[\"competitor_matrix\", \"market_share_chart\", \"swot_grid\"],\n    ),\n\n    \"investigative\": ReportHints(\n        template_type=\"investigative\",\n        structure=\"narrative_first\",\n        findings_grouping=\"chronological\",\n        tone=\"investigative\",\n        decision_format=\"recommendation\",\n        emphasis=[\"evidence\", \"timeline\", \"key_actors\", \"implications\"],\n        required_components=[\n            ComponentType.INVESTIGATION_TIMELINE,\n            ComponentType.FINDINGS_TABLE,\n            ComponentType.QUOTE_CAROUSEL,\n        ],\n        optional_components=[\n            ComponentType.KEY_INSIGHTS,\n            ComponentType.RISK_MATRIX,\n            ComponentType.CHECKLIST,\n            ComponentType.SOURCE_LIST,\n        ],\n        visualization_preference=[\"investigation_timeline\", \"evidence_network\", \"actor_map\"],\n    ),\n\n    \"legal\": ReportHints(\n        template_type=\"legal\",\n        structure=\"narrative_first\",\n        findings_grouping=\"category\",\n        tone=\"professional\",\n        decision_format=\"recommendation\",\n        emphasis=[\"legal_precedents\", \"regulatory_implications\", \"compliance_requirements\"],\n        required_components=[\n            ComponentType.LEGAL_CASE_TRACKER,\n            ComponentType.FINDINGS_TABLE,\n            ComponentType.TIMELINE,\n        ],\n        optional_components=[\n            ComponentType.KEY_INSIGHTS,\n            ComponentType.CHECKLIST,\n            ComponentType.RISK_MATRIX,\n            ComponentType.ACTION_ITEMS,\n        ],\n        visualization_preference=[\"case_timeline\", \"jurisdiction_map\", \"precedent_chain\"],\n    ),\n\n    \"contract\": ReportHints(\n        template_type=\"contract\",\n        structure=\"balanced\",\n        findings_grouping=\"category\",\n        tone=\"professional\",\n        decision_format=\"checklist\",\n        emphasis=[\"key_terms\", \"obligations\", \"risks\", \"opportunities\"],\n        required_components=[\n            ComponentType.CONTRACT_ANALYSIS,\n            ComponentType.CHECKLIST,\n            ComponentType.RISK_MATRIX,\n        ],\n        optional_components=[\n            ComponentType.FINDINGS_TABLE,\n            ComponentType.ACTION_ITEMS,\n            ComponentType.COMPARISON_TABLE,\n            ComponentType.KEY_INSIGHTS,\n        ],\n        visualization_preference=[\"contract_structure\", \"obligation_timeline\", \"risk_assessment\"],\n    ),\n\n    \"due_diligence\": ReportHints(\n        template_type=\"due_diligence\",\n        structure=\"verdict_first\",\n        findings_grouping=\"category\",\n        tone=\"professional\",\n        decision_format=\"scorecard\",\n        emphasis=[\"overall_assessment\", \"red_flags\", \"strengths\", \"category_scores\"],\n        required_components=[\n            ComponentType.DUE_DILIGENCE_SCORECARD,\n            ComponentType.CHECKLIST,\n            ComponentType.FINDINGS_TABLE,\n        ],\n        optional_components=[\n            ComponentType.RISK_MATRIX,\n            ComponentType.KEY_INSIGHTS,\n            ComponentType.ACTION_ITEMS,\n            ComponentType.TIMELINE,\n        ],\n        visualization_preference=[\"scorecard\", \"category_radar\", \"red_flag_matrix\"],\n    ),\n\n    \"purchase_decision\": ReportHints(\n        template_type=\"purchase_decision\",\n        structure=\"verdict_first\",\n        findings_grouping=\"category\",\n        tone=\"advisory\",\n        decision_format=\"matrix\",\n        emphasis=[\"recommendation\", \"comparison\", \"value_assessment\", \"user_fit\"],\n        required_components=[\n            ComponentType.DECISION_MATRIX,\n            ComponentType.VERDICT_HERO,\n            ComponentType.PROS_CONS,\n        ],\n        optional_components=[\n            ComponentType.COMPARISON_TABLE,\n            ComponentType.METRIC_CARDS,\n            ComponentType.CHECKLIST,\n            ComponentType.QUOTE_CAROUSEL,\n        ],\n        visualization_preference=[\"decision_matrix\", \"comparison_chart\", \"value_radar\"],\n    ),\n\n    \"reputation\": ReportHints(\n        template_type=\"reputation\",\n        structure=\"verdict_first\",\n        findings_grouping=\"sentiment\",\n        tone=\"advisory\",\n        decision_format=\"checklist\",\n        emphasis=[\"trust_score\", \"red_flags\", \"user_sentiment\", \"verification\"],\n        required_components=[\n            ComponentType.TRUST_DASHBOARD,\n            ComponentType.CHECKLIST,\n            ComponentType.FINDINGS_TABLE,\n        ],\n        optional_components=[\n            ComponentType.QUOTE_CAROUSEL,\n            ComponentType.TIMELINE,\n            ComponentType.KEY_INSIGHTS,\n            ComponentType.SOURCE_LIST,\n        ],\n        visualization_preference=[\"trust_gauge\", \"sentiment_chart\", \"verification_checklist\"],\n    ),\n\n    \"understanding\": ReportHints(\n        template_type=\"understanding\",\n        structure=\"narrative_first\",\n        findings_grouping=\"chronological\",\n        tone=\"educational\",\n        decision_format=\"recommendation\",\n        emphasis=[\"context\", \"explanation\", \"implications\", \"perspectives\"],\n        required_components=[\n            ComponentType.EVENT_EXPLAINER,\n            ComponentType.TIMELINE,\n            ComponentType.KEY_INSIGHTS,\n        ],\n        optional_components=[\n            ComponentType.FINDINGS_TABLE,\n            ComponentType.QUOTE_CAROUSEL,\n            ComponentType.PREDICTION_CARDS,\n            ComponentType.SOURCE_LIST,\n        ],\n        visualization_preference=[\"event_timeline\", \"stakeholder_map\", \"impact_diagram\"],\n    ),\n}\n\n\ndef get_report_hints(template_type: str) -> ReportHints:\n    \"\"\"Get report hints for a template type.\"\"\"\n    return TEMPLATE_REPORT_HINTS.get(template_type, ReportHints(template_type=template_type))\n\n\ndef get_default_components(template_type: str) -> List[tuple]:\n    \"\"\"Get default component configuration for a template type.\"\"\"\n    hints = get_report_hints(template_type)\n    components = []\n\n    # Add required components with high priority\n    for i, comp in enumerate(hints.required_components):\n        config = ComponentConfig(\n            component_type=comp,\n            priority=90 - i * 5,\n            position=\"main\" if comp not in [ComponentType.VERDICT_HERO] else \"hero\"\n        )\n        components.append((comp, config))\n\n    # Add optional components with lower priority\n    for i, comp in enumerate(hints.optional_components):\n        config = ComponentConfig(\n            component_type=comp,\n            priority=50 - i * 5,\n            position=\"main\"\n        )\n        components.append((comp, config))\n\n    return components\n","numLines":1596,"startLine":1,"totalLines":1596}}}
