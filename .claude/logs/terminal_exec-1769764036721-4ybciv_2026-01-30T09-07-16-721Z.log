[2026-01-30T09:07:24.914Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018de5jX1dPmSJvhKtR68DyY","type":"tool_result","content":"     1→\"\"\"Report generation service.\"\"\"\n     2→\n     3→from typing import List, Dict, Any, Optional, Union\n     4→from datetime import datetime\n     5→\n     6→from .report_interactive import generate_interactive_html\n     7→from .exporters import get_exporter, get_supported_formats, ExportResult\n     8→from ..templates import get_template, BaseTemplate\n     9→\n    10→\n    11→class ReportService:\n    12→    \"\"\"Generates markdown and HTML reports from research results.\n    13→\n    14→    Report generation is delegated to template classes, which have domain-specific\n    15→    knowledge about how to render findings for their particular research type.\n    16→    For example, FinancialTemplate knows how to render an investment thesis,\n    17→    while ContractTemplate knows how to render a red flags summary.\n    18→\n    19→    Supported formats:\n    20→    - markdown: Standard markdown format\n    21→    - html: Rich interactive HTML\n    22→    - pdf: Print-optimized HTML for PDF conversion\n    23→    - docx: DOCX structure as JSON (use with python-docx)\n    24→    - json_ld: JSON-LD structured data for SEO/knowledge graphs\n    25→    - obsidian: Obsidian markdown with wiki-links and frontmatter\n    26→    - slack: Slack Block Kit message JSON\n    27→    \"\"\"\n    28→\n    29→    @staticmethod\n    30→    def get_supported_formats() -> List[str]:\n    31→        \"\"\"Get list of all supported export formats.\"\"\"\n    32→        return [\"markdown\", \"html\"] + get_supported_formats()\n    33→\n    34→    def export(\n    35→        self,\n    36→        research_result: Dict[str, Any],\n    37→        format: str = \"markdown\",\n    38→        variant: str = \"full_report\",\n    39→        title: Optional[str] = None,\n    40→        options: Optional[Dict[str, Any]] = None,\n    41→    ) -> Dict[str, Any]:\n    42→        \"\"\"Export research results to specified format.\n    43→\n    44→        Args:\n    45→            research_result: Dict from ResearchService.execute_research()\n    46→            format: Export format (markdown, html, pdf, docx, json_ld, obsidian, slack)\n    47→            variant: Report variant for markdown/html (executive_summary, full_report, investment_thesis)\n    48→            title: Optional custom title\n    49→            options: Format-specific options\n    50→\n    51→        Returns:\n    52→            Dict with keys:\n    53→                - content: The exported content (str or bytes)\n    54→                - filename: Suggested filename\n    55→                - mime_type: MIME type for the content\n    56→                - format: Format name\n    57→                - metadata: Additional format-specific metadata\n    58→        \"\"\"\n    59→        options = options or {}\n    60→\n    61→        # Handle legacy formats\n    62→        if format == \"markdown\":\n    63→            content = self.generate_markdown(research_result, variant, title)\n    64→            query = research_result.get(\"query\", \"research\")[:40]\n    65→            filename = f\"research_{query.replace(' ', '_')}.md\"\n    66→            return {\n    67→                \"content\": content,\n    68→                \"filename\": filename,\n    69→                \"mime_type\": \"text/markdown\",\n    70→                \"format\": \"markdown\",\n    71→                \"metadata\": {\"variant\": variant},\n    72→            }\n    73→\n    74→        if format == \"html\":\n    75→            markdown_content = self.generate_markdown(research_result, variant, title)\n    76→            content = self.generate_html(markdown_content, title or \"Research Report\", research_result)\n    77→            query = research_result.get(\"query\", \"research\")[:40]\n    78→            filename = f\"research_{query.replace(' ', '_')}.html\"\n    79→            return {\n    80→                \"content\": content,\n    81→                \"filename\": filename,\n    82→                \"mime_type\": \"text/html\",\n    83→                \"format\": \"html\",\n    84→                \"metadata\": {\"variant\": variant, \"interactive\": bool(research_result)},\n    85→            }\n    86→\n    87→        # Use extended format exporters\n    88→        try:\n    89→            exporter = get_exporter(format)\n    90→            result = exporter.export(research_result, title, options)\n    91→            return {\n    92→                \"content\": result.content,\n    93→                \"filename\": result.filename,\n    94→                \"mime_type\": result.mime_type,\n    95→                \"format\": result.format,\n    96→                \"metadata\": result.metadata,\n    97→            }\n    98→        except ValueError as e:\n    99→            supported = \", \".join(self.get_supported_formats())\n   100→            raise ValueError(f\"Unsupported format: {format}. Supported formats: {supported}\")\n   101→\n   102→    def export_multiple(\n   103→        self,\n   104→        research_result: Dict[str, Any],\n   105→        formats: List[str],\n   106→        variant: str = \"full_report\",\n   107→        title: Optional[str] = None,\n   108→        options: Optional[Dict[str, Any]] = None,\n   109→    ) -> Dict[str, Dict[str, Any]]:\n   110→        \"\"\"Export research results to multiple formats at once.\n   111→\n   112→        Args:\n   113→            research_result: Dict from ResearchService.execute_research()\n   114→            formats: List of format names to export\n   115→            variant: Report variant for markdown/html\n   116→            title: Optional custom title\n   117→            options: Format-specific options (applied to all formats)\n   118→\n   119→        Returns:\n   120→            Dict mapping format name to export result\n   121→        \"\"\"\n   122→        results = {}\n   123→        for fmt in formats:\n   124→            try:\n   125→                results[fmt] = self.export(research_result, fmt, variant, title, options)\n   126→            except ValueError as e:\n   127→                results[fmt] = {\"error\": str(e)}\n   128→        return results\n   129→\n   130→    def get_supported_variants(\n   131→        self,\n   132→        research_result: Dict[str, Any],\n   133→    ) -> List[str]:\n   134→        \"\"\"Get list of report variants supported for this research result.\n   135→\n   136→        The available variants depend on the template used for research.\n   137→        For example, FinancialTemplate supports \"investment_thesis\",\n   138→        while ContractTemplate supports \"red_flags_summary\".\n   139→\n   140→        Args:\n   141→            research_result: Dict from ResearchService.execute_research()\n   142→\n   143→        Returns:\n   144→            List of supported variant names\n   145→        \"\"\"\n   146→        template_type = research_result.get(\"template\", \"investigative\")\n   147→        template = get_template(template_type)\n   148→        return template.get_supported_report_variants()\n   149→\n   150→    def generate_markdown(\n   151→        self,\n   152→        research_result: Dict[str, Any],\n   153→        variant: str = \"full_report\",\n   154→        title: Optional[str] = None,\n   155→    ) -> str:\n   156→        \"\"\"\n   157→        Generate markdown report from research results.\n   158→\n   159→        Report generation is delegated to the template class that matches\n   160→        the research type. Each template has domain-specific knowledge about\n   161→        how to render findings and supports different report variants.\n   162→\n   163→        Args:\n   164→            research_result: Dict from ResearchService.execute_research()\n   165→            variant: Report variant (depends on template):\n   166→                - All templates: \"full_report\", \"executive_summary\"\n   167→                - financial: \"investment_thesis\"\n   168→                - investigative: \"risk_assessment\"\n   169→                - contract: \"red_flags_summary\", \"pricing_analysis\"\n   170→                - competitive: \"competitor_matrix\"\n   171→                - legal: \"legal_brief\", \"compliance_assessment\"\n   172→                - tech_market: \"trend_forecast\", \"vc_briefing\"\n   173→            title: Optional custom title\n   174→\n   175→        Returns:\n   176→            Formatted markdown string\n   177→        \"\"\"\n   178→        # Get the template that was used for this research\n   179→        template_type = research_result.get(\"template\", \"investigative\")\n   180→        template = get_template(template_type)\n   181→\n   182→        # Delegate report generation to the template\n   183→        return template.generate_report(research_result, variant, title)\n   184→\n   185→    def generate_html(\n   186→        self,\n   187→        markdown_content: str,\n   188→        title: str = \"Research Report\",\n   189→        research_result: Optional[Dict[str, Any]] = None,\n   190→    ) -> str:\n   191→        \"\"\"\n   192→        Generate styled HTML report.\n   193→\n   194→        If research_result is provided, generates rich visual HTML.\n   195→        Otherwise, converts markdown to basic styled HTML.\n   196→        \"\"\"\n   197→        # Use interactive HTML if research result is available\n   198→        if research_result:\n   199→            # Enrich result with template-specific analysis for financial/due_diligence templates\n   200→            template_type = research_result.get(\"template\", \"investigative\")\n   201→            template = get_template(template_type)\n   202→\n   203→            # Generate kill criteria if template supports it\n   204→            if hasattr(template, \"generate_kill_criteria\") and template_type in [\"financial\", \"due_diligence\"]:\n   205→                try:\n   206→                    research_result[\"kill_criteria\"] = template.generate_kill_criteria(research_result)\n   207→                except Exception:\n   208→                    pass  # Don't fail report generation if this fails\n   209→\n   210→            # Generate ecosystem analysis if template supports it\n   211→            if hasattr(template, \"generate_ecosystem_analysis\") and template_type == \"financial\":\n   212→                try:\n   213→                    research_result[\"ecosystem_analysis\"] = template.generate_ecosystem_analysis(research_result)\n   214→                except Exception:\n   215→                    pass  # Don't fail report generation if this fails\n   216→\n   217→            return generate_interactive_html(research_result, title)\n   218→\n   219→        # Fallback to markdown conversion\n   220→        html_body = self._markdown_to_html(markdown_content)\n   221→\n   222→        return f\"\"\"<!DOCTYPE html>\n   223→<html lang=\"en\">\n   224→<head>\n   225→    <meta charset=\"UTF-8\">\n   226→    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n   227→    <title>{title}</title>\n   228→    <style>\n   229→        body {{\n   230→            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;\n   231→            line-height: 1.6;\n   232→            max-width: 900px;\n   233→            margin: 0 auto;\n   234→            padding: 2rem;\n   235→            color: #333;\n   236→        }}\n   237→        h1 {{ color: #1a1a1a; border-bottom: 2px solid #eee; padding-bottom: 0.5rem; }}\n   238→        h2 {{ color: #2a2a2a; margin-top: 2rem; }}\n   239→        h3 {{ color: #3a3a3a; }}\n   240→        .finding {{ background: #f9f9f9; padding: 1rem; margin: 1rem 0; border-left: 4px solid #007bff; }}\n   241→        .finding-type {{ font-size: 0.8rem; color: #666; text-transform: uppercase; }}\n   242→        .confidence {{ color: #666; font-size: 0.9rem; font-style: italic; }}\n   243→        .source {{ margin: 0.5rem 0; }}\n   244→        .source a {{ color: #007bff; text-decoration: none; }}\n   245→        .source a:hover {{ text-decoration: underline; }}\n   246→        .perspective {{ background: #f0f7ff; padding: 1rem; margin: 1rem 0; border-radius: 4px; }}\n   247→        .insight {{ margin: 0.25rem 0; padding-left: 1rem; border-left: 2px solid #28a745; }}\n   248→        .warning {{ margin: 0.25rem 0; padding-left: 1rem; border-left: 2px solid #dc3545; }}\n   249→        hr {{ border: none; border-top: 1px solid #eee; margin: 2rem 0; }}\n   250→        table {{ border-collapse: collapse; width: 100%; margin: 1rem 0; }}\n   251→        th, td {{ border: 1px solid #ddd; padding: 0.5rem; text-align: left; }}\n   252→        th {{ background: #f5f5f5; }}\n   253→    </style>\n   254→</head>\n   255→<body>\n   256→{html_body}\n   257→</body>\n   258→</html>\"\"\"\n   259→\n   260→    # NOTE: Report variant generation methods (_generate_full_report, _generate_executive_summary,\n   261→    # _generate_investment_thesis, etc.) have been moved to template classes.\n   262→    # Each template now has domain-specific knowledge about how to render its findings.\n   263→    # See:\n   264→    #   - BaseTemplate.generate_full_report() - default implementation\n   265→    #   - BaseTemplate.generate_executive_summary() - default implementation\n   266→    #   - FinancialTemplate.generate_investment_thesis() - financial-specific\n   267→    #   - InvestigativeTemplate.generate_risk_assessment() - investigative-specific\n   268→    #   - ContractTemplate.generate_red_flags_summary() - contract-specific\n   269→    #   - CompetitiveTemplate.generate_competitor_matrix() - competitive-specific\n   270→    #   - LegalTemplate.generate_legal_brief() - legal-specific\n   271→    #   - TechMarketTemplate.generate_trend_forecast() - tech market-specific\n   272→\n   273→    def _markdown_to_html(self, markdown: str) -> str:\n   274→        \"\"\"Simple markdown to HTML conversion.\"\"\"\n   275→        lines = markdown.split(\"\\n\")\n   276→        html_lines = []\n   277→        in_list = False\n   278→\n   279→        for line in lines:\n   280→            # Headers\n   281→            if line.startswith(\"# \"):\n   282→                html_lines.append(f\"<h1>{line[2:]}</h1>\")\n   283→            elif line.startswith(\"## \"):\n   284→                html_lines.append(f\"<h2>{line[3:]}</h2>\")\n   285→            elif line.startswith(\"### \"):\n   286→                html_lines.append(f\"<h3>{line[4:]}</h3>\")\n   287→            elif line.startswith(\"#### \"):\n   288→                html_lines.append(f\"<h4>{line[5:]}</h4>\")\n   289→            # Horizontal rule\n   290→            elif line.strip() == \"---\":\n   291→                html_lines.append(\"<hr>\")\n   292→            # List items\n   293→            elif line.startswith(\"- \"):\n   294→                if not in_list:\n   295→                    html_lines.append(\"<ul>\")\n   296→                    in_list = True\n   297→                # Handle bold and links\n   298→                content = self._format_inline(line[2:])\n   299→                html_lines.append(f\"<li>{content}</li>\")\n   300→            # Empty line\n   301→            elif line.strip() == \"\":\n   302→                if in_list:\n   303→                    html_lines.append(\"</ul>\")\n   304→                    in_list = False\n   305→                html_lines.append(\"\")\n   306→            # Regular paragraph\n   307→            else:\n   308→                if in_list:\n   309→                    html_lines.append(\"</ul>\")\n   310→                    in_list = False\n   311→                content = self._format_inline(line)\n   312→                html_lines.append(f\"<p>{content}</p>\")\n   313→\n   314→        if in_list:\n   315→            html_lines.append(\"</ul>\")\n   316→\n   317→        return \"\\n\".join(html_lines)\n   318→\n   319→    def _format_inline(self, text: str) -> str:\n   320→        \"\"\"Format inline markdown (bold, italic, links).\"\"\"\n   321→        import re\n   322→\n   323→        # Bold\n   324→        text = re.sub(r'\\*\\*(.+?)\\*\\*', r'<strong>\\1</strong>', text)\n   325→        # Italic\n   326→        text = re.sub(r'\\*(.+?)\\*', r'<em>\\1</em>', text)\n   327→        # Links\n   328→        text = re.sub(r'\\[(.+?)\\]\\((.+?)\\)', r'<a href=\"\\2\">\\1</a>', text)\n   329→\n   330→        return text\n   331→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"34eb5170-c9bb-41ec-b332-c49ff6c57668","uuid":"3cfb8bb8-532c-4b61-b2af-332e817e3f17","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\actor\\src\\services\\report.py","content":"\"\"\"Report generation service.\"\"\"\n\nfrom typing import List, Dict, Any, Optional, Union\nfrom datetime import datetime\n\nfrom .report_interactive import generate_interactive_html\nfrom .exporters import get_exporter, get_supported_formats, ExportResult\nfrom ..templates import get_template, BaseTemplate\n\n\nclass ReportService:\n    \"\"\"Generates markdown and HTML reports from research results.\n\n    Report generation is delegated to template classes, which have domain-specific\n    knowledge about how to render findings for their particular research type.\n    For example, FinancialTemplate knows how to render an investment thesis,\n    while ContractTemplate knows how to render a red flags summary.\n\n    Supported formats:\n    - markdown: Standard markdown format\n    - html: Rich interactive HTML\n    - pdf: Print-optimized HTML for PDF conversion\n    - docx: DOCX structure as JSON (use with python-docx)\n    - json_ld: JSON-LD structured data for SEO/knowledge graphs\n    - obsidian: Obsidian markdown with wiki-links and frontmatter\n    - slack: Slack Block Kit message JSON\n    \"\"\"\n\n    @staticmethod\n    def get_supported_formats() -> List[str]:\n        \"\"\"Get list of all supported export formats.\"\"\"\n        return [\"markdown\", \"html\"] + get_supported_formats()\n\n    def export(\n        self,\n        research_result: Dict[str, Any],\n        format: str = \"markdown\",\n        variant: str = \"full_report\",\n        title: Optional[str] = None,\n        options: Optional[Dict[str, Any]] = None,\n    ) -> Dict[str, Any]:\n        \"\"\"Export research results to specified format.\n\n        Args:\n            research_result: Dict from ResearchService.execute_research()\n            format: Export format (markdown, html, pdf, docx, json_ld, obsidian, slack)\n            variant: Report variant for markdown/html (executive_summary, full_report, investment_thesis)\n            title: Optional custom title\n            options: Format-specific options\n\n        Returns:\n            Dict with keys:\n                - content: The exported content (str or bytes)\n                - filename: Suggested filename\n                - mime_type: MIME type for the content\n                - format: Format name\n                - metadata: Additional format-specific metadata\n        \"\"\"\n        options = options or {}\n\n        # Handle legacy formats\n        if format == \"markdown\":\n            content = self.generate_markdown(research_result, variant, title)\n            query = research_result.get(\"query\", \"research\")[:40]\n            filename = f\"research_{query.replace(' ', '_')}.md\"\n            return {\n                \"content\": content,\n                \"filename\": filename,\n                \"mime_type\": \"text/markdown\",\n                \"format\": \"markdown\",\n                \"metadata\": {\"variant\": variant},\n            }\n\n        if format == \"html\":\n            markdown_content = self.generate_markdown(research_result, variant, title)\n            content = self.generate_html(markdown_content, title or \"Research Report\", research_result)\n            query = research_result.get(\"query\", \"research\")[:40]\n            filename = f\"research_{query.replace(' ', '_')}.html\"\n            return {\n                \"content\": content,\n                \"filename\": filename,\n                \"mime_type\": \"text/html\",\n                \"format\": \"html\",\n                \"metadata\": {\"variant\": variant, \"interactive\": bool(research_result)},\n            }\n\n        # Use extended format exporters\n        try:\n            exporter = get_exporter(format)\n            result = exporter.export(research_result, title, options)\n            return {\n                \"content\": result.content,\n                \"filename\": result.filename,\n                \"mime_type\": result.mime_type,\n                \"format\": result.format,\n                \"metadata\": result.metadata,\n            }\n        except ValueError as e:\n            supported = \", \".join(self.get_supported_formats())\n            raise ValueError(f\"Unsupported format: {format}. Supported formats: {supported}\")\n\n    def export_multiple(\n        self,\n        research_result: Dict[str, Any],\n        formats: List[str],\n        variant: str = \"full_report\",\n        title: Optional[str] = None,\n        options: Optional[Dict[str, Any]] = None,\n    ) -> Dict[str, Dict[str, Any]]:\n        \"\"\"Export research results to multiple formats at once.\n\n        Args:\n            research_result: Dict from ResearchService.execute_research()\n            formats: List of format names to export\n            variant: Report variant for markdown/html\n            title: Optional custom title\n            options: Format-specific options (applied to all formats)\n\n        Returns:\n            Dict mapping format name to export result\n        \"\"\"\n        results = {}\n        for fmt in formats:\n            try:\n                results[fmt] = self.export(research_result, fmt, variant, title, options)\n            except ValueError as e:\n                results[fmt] = {\"error\": str(e)}\n        return results\n\n    def get_supported_variants(\n        self,\n        research_result: Dict[str, Any],\n    ) -> List[str]:\n        \"\"\"Get list of report variants supported for this research result.\n\n        The available variants depend on the template used for research.\n        For example, FinancialTemplate supports \"investment_thesis\",\n        while ContractTemplate supports \"red_flags_summary\".\n\n        Args:\n            research_result: Dict from ResearchService.execute_research()\n\n        Returns:\n            List of supported variant names\n        \"\"\"\n        template_type = research_result.get(\"template\", \"investigative\")\n        template = get_template(template_type)\n        return template.get_supported_report_variants()\n\n    def generate_markdown(\n        self,\n        research_result: Dict[str, Any],\n        variant: str = \"full_report\",\n        title: Optional[str] = None,\n    ) -> str:\n        \"\"\"\n        Generate markdown report from research results.\n\n        Report generation is delegated to the template class that matches\n        the research type. Each template has domain-specific knowledge about\n        how to render findings and supports different report variants.\n\n        Args:\n            research_result: Dict from ResearchService.execute_research()\n            variant: Report variant (depends on template):\n                - All templates: \"full_report\", \"executive_summary\"\n                - financial: \"investment_thesis\"\n                - investigative: \"risk_assessment\"\n                - contract: \"red_flags_summary\", \"pricing_analysis\"\n                - competitive: \"competitor_matrix\"\n                - legal: \"legal_brief\", \"compliance_assessment\"\n                - tech_market: \"trend_forecast\", \"vc_briefing\"\n            title: Optional custom title\n\n        Returns:\n            Formatted markdown string\n        \"\"\"\n        # Get the template that was used for this research\n        template_type = research_result.get(\"template\", \"investigative\")\n        template = get_template(template_type)\n\n        # Delegate report generation to the template\n        return template.generate_report(research_result, variant, title)\n\n    def generate_html(\n        self,\n        markdown_content: str,\n        title: str = \"Research Report\",\n        research_result: Optional[Dict[str, Any]] = None,\n    ) -> str:\n        \"\"\"\n        Generate styled HTML report.\n\n        If research_result is provided, generates rich visual HTML.\n        Otherwise, converts markdown to basic styled HTML.\n        \"\"\"\n        # Use interactive HTML if research result is available\n        if research_result:\n            # Enrich result with template-specific analysis for financial/due_diligence templates\n            template_type = research_result.get(\"template\", \"investigative\")\n            template = get_template(template_type)\n\n            # Generate kill criteria if template supports it\n            if hasattr(template, \"generate_kill_criteria\") and template_type in [\"financial\", \"due_diligence\"]:\n                try:\n                    research_result[\"kill_criteria\"] = template.generate_kill_criteria(research_result)\n                except Exception:\n                    pass  # Don't fail report generation if this fails\n\n            # Generate ecosystem analysis if template supports it\n            if hasattr(template, \"generate_ecosystem_analysis\") and template_type == \"financial\":\n                try:\n                    research_result[\"ecosystem_analysis\"] = template.generate_ecosystem_analysis(research_result)\n                except Exception:\n                    pass  # Don't fail report generation if this fails\n\n            return generate_interactive_html(research_result, title)\n\n        # Fallback to markdown conversion\n        html_body = self._markdown_to_html(markdown_content)\n\n        return f\"\"\"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>{title}</title>\n    <style>\n        body {{\n            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;\n            line-height: 1.6;\n            max-width: 900px;\n            margin: 0 auto;\n            padding: 2rem;\n            color: #333;\n        }}\n        h1 {{ color: #1a1a1a; border-bottom: 2px solid #eee; padding-bottom: 0.5rem; }}\n        h2 {{ color: #2a2a2a; margin-top: 2rem; }}\n        h3 {{ color: #3a3a3a; }}\n        .finding {{ background: #f9f9f9; padding: 1rem; margin: 1rem 0; border-left: 4px solid #007bff; }}\n        .finding-type {{ font-size: 0.8rem; color: #666; text-transform: uppercase; }}\n        .confidence {{ color: #666; font-size: 0.9rem; font-style: italic; }}\n        .source {{ margin: 0.5rem 0; }}\n        .source a {{ color: #007bff; text-decoration: none; }}\n        .source a:hover {{ text-decoration: underline; }}\n        .perspective {{ background: #f0f7ff; padding: 1rem; margin: 1rem 0; border-radius: 4px; }}\n        .insight {{ margin: 0.25rem 0; padding-left: 1rem; border-left: 2px solid #28a745; }}\n        .warning {{ margin: 0.25rem 0; padding-left: 1rem; border-left: 2px solid #dc3545; }}\n        hr {{ border: none; border-top: 1px solid #eee; margin: 2rem 0; }}\n        table {{ border-collapse: collapse; width: 100%; margin: 1rem 0; }}\n        th, td {{ border: 1px solid #ddd; padding: 0.5rem; text-align: left; }}\n        th {{ background: #f5f5f5; }}\n    </style>\n</head>\n<body>\n{html_body}\n</body>\n</html>\"\"\"\n\n    # NOTE: Report variant generation methods (_generate_full_report, _generate_executive_summary,\n    # _generate_investment_thesis, etc.) have been moved to template classes.\n    # Each template now has domain-specific knowledge about how to render its findings.\n    # See:\n    #   - BaseTemplate.generate_full_report() - default implementation\n    #   - BaseTemplate.generate_executive_summary() - default implementation\n    #   - FinancialTemplate.generate_investment_thesis() - financial-specific\n    #   - InvestigativeTemplate.generate_risk_assessment() - investigative-specific\n    #   - ContractTemplate.generate_red_flags_summary() - contract-specific\n    #   - CompetitiveTemplate.generate_competitor_matrix() - competitive-specific\n    #   - LegalTemplate.generate_legal_brief() - legal-specific\n    #   - TechMarketTemplate.generate_trend_forecast() - tech market-specific\n\n    def _markdown_to_html(self, markdown: str) -> str:\n        \"\"\"Simple markdown to HTML conversion.\"\"\"\n        lines = markdown.split(\"\\n\")\n        html_lines = []\n        in_list = False\n\n        for line in lines:\n            # Headers\n            if line.startswith(\"# \"):\n                html_lines.append(f\"<h1>{line[2:]}</h1>\")\n            elif line.startswith(\"## \"):\n                html_lines.append(f\"<h2>{line[3:]}</h2>\")\n            elif line.startswith(\"### \"):\n                html_lines.append(f\"<h3>{line[4:]}</h3>\")\n            elif line.startswith(\"#### \"):\n                html_lines.append(f\"<h4>{line[5:]}</h4>\")\n            # Horizontal rule\n            elif line.strip() == \"---\":\n                html_lines.append(\"<hr>\")\n            # List items\n            elif line.startswith(\"- \"):\n                if not in_list:\n                    html_lines.append(\"<ul>\")\n                    in_list = True\n                # Handle bold and links\n                content = self._format_inline(line[2:])\n                html_lines.append(f\"<li>{content}</li>\")\n            # Empty line\n            elif line.strip() == \"\":\n                if in_list:\n                    html_lines.append(\"</ul>\")\n                    in_list = False\n                html_lines.append(\"\")\n            # Regular paragraph\n            else:\n                if in_list:\n                    html_lines.append(\"</ul>\")\n                    in_list = False\n                content = self._format_inline(line)\n                html_lines.append(f\"<p>{content}</p>\")\n\n        if in_list:\n            html_lines.append(\"</ul>\")\n\n        return \"\\n\".join(html_lines)\n\n    def _format_inline(self, text: str) -> str:\n        \"\"\"Format inline markdown (bold, italic, links).\"\"\"\n        import re\n\n        # Bold\n        text = re.sub(r'\\*\\*(.+?)\\*\\*', r'<strong>\\1</strong>', text)\n        # Italic\n        text = re.sub(r'\\*(.+?)\\*', r'<em>\\1</em>', text)\n        # Links\n        text = re.sub(r'\\[(.+?)\\]\\((.+?)\\)', r'<a href=\"\\2\">\\1</a>', text)\n\n        return text\n","numLines":331,"startLine":1,"totalLines":331}}}
