  50→    async def process_pdf(\n    51→        self,\n    52→        pdf_bytes: bytes,\n    53→        max_pages: int = 20,\n    54→    ) -> Dict[str, Any]:\n    55→        \"\"\"\n    56→        Process a PDF file with OCR.\n    57→\n    58→        Args:\n    59→            pdf_bytes: Raw PDF bytes\n    60→            max_pages: Maximum pages to process\n    61→\n    62→        Returns:\n    63→            Dict with 'text', 'pages_processed', 'tokens', 'cost'\n    64→        \"\"\"\n    65→        # Get PDF info\n    66→        info = get_pdf_info(pdf_bytes)\n    67→        total_pages = info.get(\"page_count\", 0)\n    68→\n    69→        # Convert to images\n    70→        images = pdf_to_images(pdf_bytes, dpi=150, max_pages=max_pages)\n    71→\n    72→        # Process each page\n    73→        all_text = []\n    74→        total_tokens = 0\n    75→        total_cost = 0.0\n    76→\n    77→        for img_bytes, page_num in images:\n    78→            try:\n    79→                result = await self.client.process_image(img_bytes)\n    80→                all_text.append(f\"## Page {page_num}\\n\\n{result['text']}\")\n    81→                total_tokens += result.get(\"tokens\", 0)\n    82→                total_cost += result.get(\"cost\", 0) or 0\n    83→\n    84→            except Exception as e:\n    85→                logger.warning(f\"Failed to process page {page_num}: {e}\")\n    86→                all_text.append(f\"## Page {page_num}\\n\\n[OCR failed: {str(e)}]\")\n    87→\n    88→        # Update totals\n    89→        self.total_tokens += total_tokens\n    90→        self.total_cost += total_cost\n    91→\n    92→        return {\n    93→            \"text\": \"\\n\\n\".join(all_text),\n    94→            \"pages_processed\": len(images),\n    95→            \"total_pages\": total_pages,\n    96→            \"tokens\": total_tokens,\n    97→            \"cost\": total_cost,\n    98→            \"metadata\": info,\n    99→        }\n   100→\n   101→    async def process_image(\n   102→        self,\n   103→        image_bytes: bytes,\n   104→    ) -> Dict[str, Any]:\n   105→        \"\"\"\n   106→        Process a single image with OCR.\n   107→\n   108→        Args:\n   109→            image_bytes: Raw image bytes\n   110→\n   111→        Returns:\n   112→            Dict with 'text', 'tokens', 'cost'\n   113→        \"\"\"\n   114→        result = await self.client.process_image(image_bytes)\n   115→\n   116→        # Update totals\n   117→        self.total_tokens += result.get(\"tokens\", 0)\n   118→        self.total_cost += result.get(\"cost\", 0) or 0\n   119→\n   120→        return {\n   121→            \"text\": result[\"text\"],\n   122→            \"pages_processed\": 1,\n   123→            \"tokens\": result.get(\"tokens\", 0),\n   124→            \"cost\": result.get(\"cost\", 0),\n   125→        }\n   126→\n   127→    def get_usage(self) -> Dict[str, Any]:\n   128→        \"\"\"Get total usage statistics.\"\"\"\n   129→        return {\n   130→            \"total_tokens\": self.total_tokens,\n   131→            \"total_cost_usd\": self.total_cost,\n   132→        }\n   133→\n   134→    def _is_pdf(self, file_bytes: bytes, content_type: str) -> bool:\n   135→        \"\"\"Check if file is a PDF.\"\"\"\n   136→        # Check magic bytes\n   137→        if file_bytes[:4] == b'%PDF':\n   138→            return True\n   139→        # Check content type\n   140→        if 'pdf' in content_type.lower():\n   141→            return True\n   142→        return False\n   143→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"34eb5170-c9bb-41ec-b332-c49ff6c57668","uuid":"bde24889-7758-43dc-9b1d-ae4fcf176720","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\serverless\\src\\services\\ocr.py","content":"\"\"\"OCR service for PDF and image processing.\"\"\"\n\nimport logging\nfrom typing import Optional, List, Dict, Any\n\nimport httpx\n\nfrom ..clients.openrouter import OpenRouterClient\nfrom ..utils.pdf import pdf_to_images, get_pdf_info\n\nlogger = logging.getLogger(__name__)\n\n\nclass OCRService:\n    \"\"\"Service for extracting text from PDFs and images.\"\"\"\n\n    def __init__(self, openrouter_client: OpenRouterClient):\n        self.client = openrouter_client\n        self.total_tokens = 0\n        self.total_cost = 0.0\n\n    async def process_file_url(\n        self,\n        file_url: str,\n        max_pages: int = 20,\n    ) -> Dict[str, Any]:\n        \"\"\"\n        Download and process a file from URL.\n\n        Args:\n            file_url: URL to PDF or image file\n            max_pages: Maximum pages to process for PDFs\n\n        Returns:\n            Dict with 'text', 'pages_processed', 'tokens', 'cost'\n        \"\"\"\n        # Download file\n        async with httpx.AsyncClient(timeout=60.0) as http_client:\n            response = await http_client.get(file_url)\n            response.raise_for_status()\n            file_bytes = response.content\n            content_type = response.headers.get(\"content-type\", \"\")\n\n        # Determine file type\n        if self._is_pdf(file_bytes, content_type):\n            return await self.process_pdf(file_bytes, max_pages)\n        else:\n            return await self.process_image(file_bytes)\n\n    async def process_pdf(\n        self,\n        pdf_bytes: bytes,\n        max_pages: int = 20,\n    ) -> Dict[str, Any]:\n        \"\"\"\n        Process a PDF file with OCR.\n\n        Args:\n            pdf_bytes: Raw PDF bytes\n            max_pages: Maximum pages to process\n\n        Returns:\n            Dict with 'text', 'pages_processed', 'tokens', 'cost'\n        \"\"\"\n        # Get PDF info\n        info = get_pdf_info(pdf_bytes)\n        total_pages = info.get(\"page_count\", 0)\n\n        # Convert to images\n        images = pdf_to_images(pdf_bytes, dpi=150, max_pages=max_pages)\n\n        # Process each page\n        all_text = []\n        total_tokens = 0\n        total_cost = 0.0\n\n        for img_bytes, page_num in images:\n            try:\n                result = await self.client.process_image(img_bytes)\n                all_text.append(f\"## Page {page_num}\\n\\n{result['text']}\")\n                total_tokens += result.get(\"tokens\", 0)\n                total_cost += result.get(\"cost\", 0) or 0\n\n            except Exception as e:\n                logger.warning(f\"Failed to process page {page_num}: {e}\")\n                all_text.append(f\"## Page {page_num}\\n\\n[OCR failed: {str(e)}]\")\n\n        # Update totals\n        self.total_tokens += total_tokens\n        self.total_cost += total_cost\n\n        return {\n            \"text\": \"\\n\\n\".join(all_text),\n            \"pages_processed\": len(images),\n            \"total_pages\": total_pages,\n            \"tokens\": total_tokens,\n            \"cost\": total_cost,\n            \"metadata\": info,\n        }\n\n    async def process_image(\n        self,\n        image_bytes: bytes,\n    ) -> Dict[str, Any]:\n        \"\"\"\n        Process a single image with OCR.\n\n        Args:\n            image_bytes: Raw image bytes\n\n        Returns:\n            Dict with 'text', 'tokens', 'cost'\n        \"\"\"\n        result = await self.client.process_image(image_bytes)\n\n        # Update totals\n        self.total_tokens += result.get(\"tokens\", 0)\n        self.total_cost += result.get(\"cost\", 0) or 0\n\n        return {\n            \"text\": result[\"text\"],\n            \"pages_processed\": 1,\n            \"tokens\": result.get(\"tokens\", 0),\n            \"cost\": result.get(\"cost\", 0),\n        }\n\n    def get_usage(self) -> Dict[str, Any]:\n        \"\"\"Get total usage statistics.\"\"\"\n        return {\n            \"total_tokens\": self.total_tokens,\n            \"total_cost_usd\": self.total_cost,\n        }\n\n    def _is_pdf(self, file_bytes: bytes, content_type: str) -> bool:\n        \"\"\"Check if file is a PDF.\"\"\"\n        # Check magic bytes\n        if file_bytes[:4] == b'%PDF':\n            return True\n        # Check content type\n        if 'pdf' in content_type.lower():\n            return True\n        return False\n","numLines":143,"startLine":1,"totalLines":143}}}
