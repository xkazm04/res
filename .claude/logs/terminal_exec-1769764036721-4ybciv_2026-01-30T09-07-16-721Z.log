[2026-01-30T09:08:44.726Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HPNdqpNn5YdZHgwbhGy3X2","type":"tool_result","content":"     1→\"\"\"Gemini client with Google Search grounding.\"\"\"\n     2→\n     3→import json\n     4→import logging\n     5→from enum import Enum\n     6→from typing import Optional, List, Dict, Any\n     7→from dataclasses import dataclass, field\n     8→\n     9→logger = logging.getLogger(__name__)\n    10→\n    11→# Import Google's genai SDK\n    12→try:\n    13→    from google import genai\n    14→    from google.genai import types\n    15→    GENAI_AVAILABLE = True\n    16→except ImportError:\n    17→    GENAI_AVAILABLE = False\n    18→    genai = None\n    19→    types = None\n    20→\n    21→\n    22→class SearchMode(Enum):\n    23→    \"\"\"Search mode for research queries.\"\"\"\n    24→    NONE = \"none\"\n    25→    SEARCH = \"search\"\n    26→    GROUNDED = \"grounded\"\n    27→\n    28→\n    29→@dataclass\n    30→class GroundingChunk:\n    31→    \"\"\"A grounding source chunk.\"\"\"\n    32→    uri: str\n    33→    title: str\n    34→    domain: str = \"\"\n    35→\n    36→    def __post_init__(self):\n    37→        if not self.domain and self.uri:\n    38→            # Extract domain from title or URI\n    39→            self.domain = self.title.replace(\".com\", \"\").replace(\".org\", \"\")\n    40→\n    41→\n    42→@dataclass\n    43→class GroundingSupport:\n    44→    \"\"\"Grounding support - links text segment to source chunks.\"\"\"\n    45→    text: str\n    46→    start_index: int\n    47→    end_index: int\n    48→    chunk_indices: List[int] = field(default_factory=list)\n    49→\n    50→\n    51→@dataclass\n    52→class GroundingMetadata:\n    53→    \"\"\"Full grounding metadata from response.\"\"\"\n    54→    web_search_queries: List[str] = field(default_factory=list)\n    55→    grounding_chunks: List[GroundingChunk] = field(default_factory=list)\n    56→    grounding_supports: List[GroundingSupport] = field(default_factory=list)\n    57→    search_entry_point_html: Optional[str] = None\n    58→\n    59→\n    60→@dataclass\n    61→class TokenUsage:\n    62→    \"\"\"Token usage from API response.\"\"\"\n    63→    input_tokens: int = 0\n    64→    output_tokens: int = 0\n    65→    total_tokens: int = 0\n    66→\n    67→    def to_dict(self) -> Dict[str, int]:\n    68→        return {\n    69→            \"input_tokens\": self.input_tokens,\n    70→            \"output_tokens\": self.output_tokens,\n    71→            \"total_tokens\": self.total_tokens,\n    72→        }\n    73→\n    74→\n    75→@dataclass\n    76→class Source:\n    77→    \"\"\"A source from grounded search.\"\"\"\n    78→    url: str\n    79→    title: str\n    80→    domain: str\n    81→    snippet: str = \"\"\n    82→    source_type: str = \"web\"\n    83→\n    84→\n    85→@dataclass\n    86→class ResearchResponse:\n    87→    \"\"\"Response from research query.\"\"\"\n    88→    text: str\n    89→    sources: List[Source] = field(default_factory=list)\n    90→    search_queries: List[str] = field(default_factory=list)\n    91→    grounding_metadata: Optional[GroundingMetadata] = None\n    92→    token_usage: Optional[TokenUsage] = None\n    93→    cost_usd: Optional[float] = None\n    94→    search_mode: SearchMode = SearchMode.NONE\n    95→    model: str = \"\"\n    96→    raw_response: Optional[Any] = None\n    97→    parse_error: Optional[str] = None\n    98→\n    99→\n   100→class GeminiClient:\n   101→    \"\"\"Gemini client with Google Search and Grounding.\"\"\"\n   102→\n   103→    DEFAULT_MODEL = \"gemini-3-flash-preview\"\n   104→\n   105→    COST_RATES = {\n   106→        \"gemini-3-flash-preview\": {\"input\": 0.10, \"output\": 0.40},\n   107→        \"gemini-2.5-flash-preview-05-20\": {\"input\": 0.15, \"output\": 0.60},\n   108→        \"gemini-2.0-flash\": {\"input\": 0.075, \"output\": 0.30},\n   109→        \"gemini-1.5-flash\": {\"input\": 0.075, \"output\": 0.30},\n   110→        \"gemini-1.5-pro\": {\"input\": 1.25, \"output\": 5.00},\n   111→    }\n   112→\n   113→    def __init__(\n   114→        self,\n   115→        api_key: str,\n   116→        model: Optional[str] = None,\n   117→        search_mode: SearchMode = SearchMode.GROUNDED,\n   118→    ):\n   119→        if not GENAI_AVAILABLE:\n   120→            raise ImportError(\n   121→                \"google-genai package not installed. \"\n   122→                \"Install with: pip install google-genai\"\n   123→            )\n   124→\n   125→        self.api_key = api_key\n   126→        self.model = model or self.DEFAULT_MODEL\n   127→        self.search_mode = search_mode\n   128→\n   129→        if not self.api_key:\n   130→            raise ValueError(\"Google API key required\")\n   131→\n   132→        self.client = genai.Client(api_key=self.api_key)\n   133→\n   134→    def is_available(self) -> bool:\n   135→        return bool(self.api_key) and GENAI_AVAILABLE\n   136→\n   137→    async def generate(\n   138→        self,\n   139→        prompt: str,\n   140→        system_prompt: Optional[str] = None,\n   141→        temperature: float = 0.7,\n   142→        max_tokens: int = 4096,\n   143→    ) -> ResearchResponse:\n   144→        \"\"\"Generate response without web search.\"\"\"\n   145→        full_prompt = self._build_prompt(prompt, system_prompt)\n   146→\n   147→        config = types.GenerateContentConfig(\n   148→            temperature=temperature,\n   149→            max_output_tokens=max_tokens,\n   150→        )\n   151→\n   152→        response = self.client.models.generate_content(\n   153→            model=self.model,\n   154→            contents=full_prompt,\n   155→            config=config,\n   156→        )\n   157→\n   158→        token_usage = self._get_token_usage(response)\n   159→        return ResearchResponse(\n   160→            text=response.text,\n   161→            token_usage=token_usage,\n   162→            cost_usd=self._estimate_cost(token_usage),\n   163→            search_mode=SearchMode.NONE,\n   164→            model=self.model,\n   165→            raw_response=response,\n   166→        )\n   167→\n   168→    async def generate_json(\n   169→        self,\n   170→        prompt: str,\n   171→        system_prompt: Optional[str] = None,\n   172→        temperature: float = 0.3,\n   173→    ) -> tuple[Any, ResearchResponse]:\n   174→        \"\"\"Generate JSON response.\"\"\"\n   175→        full_prompt = self._build_prompt(prompt, system_prompt)\n   176→\n   177→        config = types.GenerateContentConfig(\n   178→            temperature=temperature,\n   179→            response_mime_type=\"application/json\",\n   180→        )\n   181→\n   182→        response = self.client.models.generate_content(\n   183→            model=self.model,\n   184→            contents=full_prompt,\n   185→            config=config,\n   186→        )\n   187→\n   188→        parsed, parse_error = self._parse_json(response.text)\n   189→\n   190→        token_usage = self._get_token_usage(response)\n   191→        res = ResearchResponse(\n   192→            text=response.text,\n   193→            token_usage=token_usage,\n   194→            cost_usd=self._estimate_cost(token_usage),\n   195→            search_mode=SearchMode.NONE,\n   196→            model=self.model,\n   197→            raw_response=response,\n   198→        )\n   199→\n   200→        if parse_error:\n   201→            res.parse_error = parse_error\n   202→\n   203→        return parsed, res\n   204→\n   205→    async def research(\n   206→        self,\n   207→        query: str,\n   208→        system_prompt: Optional[str] = None,\n   209→        temperature: float = 0.3,\n   210→        max_tokens: int = 4096,\n   211→        mode: Optional[SearchMode] = None,\n   212→    ) -> ResearchResponse:\n   213→        \"\"\"Research query using Google Search.\"\"\"\n   214→        search_mode = mode or self.search_mode\n   215→\n   216→        if search_mode == SearchMode.NONE:\n   217→            return await self.generate(query, system_prompt, temperature, max_tokens)\n   218→\n   219→        full_prompt = self._build_prompt(query, system_prompt)\n   220→\n   221→        config = types.GenerateContentConfig(\n   222→            temperature=temperature,\n   223→            max_output_tokens=max_tokens,\n   224→            tools=[types.Tool(google_search=types.GoogleSearch())]\n   225→        )\n   226→\n   227→        response = self.client.models.generate_content(\n   228→            model=self.model,\n   229→            contents=full_prompt,\n   230→            config=config,\n   231→        )\n   232→\n   233→        grounding_meta = self._extract_grounding_metadata(response)\n   234→        sources = []\n   235→        search_queries = []\n   236→\n   237→        if grounding_meta:\n   238→            search_queries = grounding_meta.web_search_queries\n   239→            sources = [\n   240→                Source(\n   241→                    url=chunk.uri,\n   242→                    title=chunk.title,\n   243→                    domain=chunk.domain,\n   244→                )\n   245→                for chunk in grounding_meta.grounding_chunks\n   246→            ]\n   247→\n   248→        token_usage = self._get_token_usage(response)\n   249→        return ResearchResponse(\n   250→            text=response.text,\n   251→            sources=sources,\n   252→            search_queries=search_queries,\n   253→            grounding_metadata=grounding_meta if search_mode == SearchMode.GROUNDED else None,\n   254→            token_usage=token_usage,\n   255→            cost_usd=self._estimate_cost(token_usage),\n   256→            search_mode=search_mode,\n   257→            model=self.model,\n   258→            raw_response=response,\n   259→        )\n   260→\n   261→    async def multi_search(\n   262→        self,\n   263→        queries: List[str],\n   264→        system_prompt: Optional[str] = None,\n   265→    ) -> List[ResearchResponse]:\n   266→        \"\"\"Execute multiple research queries.\"\"\"\n   267→        results = []\n   268→        for query in queries:\n   269→            try:\n   270→                response = await self.research(query, system_prompt=system_prompt)\n   271→                results.append(response)\n   272→            except Exception as e:\n   273→                logger.warning(\"Multi-search query failed: %s\", e)\n   274→                results.append(ResearchResponse(\n   275→                    text=f\"Error: {str(e)}\",\n   276→                    search_mode=self.search_mode,\n   277→                    model=self.model,\n   278→                ))\n   279→        return results\n   280→\n   281→    def _extract_grounding_metadata(self, response) -> Optional[GroundingMetadata]:\n   282→        \"\"\"Extract full grounding metadata from response.\"\"\"\n   283→        if not hasattr(response, 'candidates') or not response.candidates:\n   284→            return None\n   285→\n   286→        candidate = response.candidates[0]\n   287→        if not hasattr(candidate, 'grounding_metadata'):\n   288→            return None\n   289→\n   290→        meta = candidate.grounding_metadata\n   291→        if not meta:\n   292→            return None\n   293→\n   294→        web_search_queries = []\n   295→        if hasattr(meta, 'web_search_queries') and meta.web_search_queries:\n   296→            web_search_queries = list(meta.web_search_queries)\n   297→\n   298→        grounding_chunks = []\n   299→        if hasattr(meta, 'grounding_chunks') and meta.grounding_chunks:\n   300→            for chunk in meta.grounding_chunks:\n   301→                if hasattr(chunk, 'web') and chunk.web:\n   302→                    uri = getattr(chunk.web, 'uri', '') or ''\n   303→                    title = getattr(chunk.web, 'title', '') or ''\n   304→                    grounding_chunks.append(GroundingChunk(\n   305→                        uri=uri,\n   306→                        title=title,\n   307→                    ))\n   308→\n   309→        grounding_supports = []\n   310→        if hasattr(meta, 'grounding_supports') and meta.grounding_supports:\n   311→            for support in meta.grounding_supports:\n   312→                segment = getattr(support, 'segment', None)\n   313→                if segment:\n   314→                    text = getattr(segment, 'text', '') or ''\n   315→                    start = getattr(segment, 'start_index', 0) or 0\n   316→                    end = getattr(segment, 'end_index', 0) or 0\n   317→\n   318→                    chunk_indices = []\n   319→                    if hasattr(support, 'grounding_chunk_indices'):\n   320→                        chunk_indices = list(support.grounding_chunk_indices or [])\n   321→\n   322→                    grounding_supports.append(GroundingSupport(\n   323→                        text=text,\n   324→                        start_index=start,\n   325→                        end_index=end,\n   326→                        chunk_indices=chunk_indices,\n   327→                    ))\n   328→\n   329→        search_entry_point_html = None\n   330→        if hasattr(meta, 'search_entry_point'):\n   331→            sep = meta.search_entry_point\n   332→            if hasattr(sep, 'rendered_content'):\n   333→                search_entry_point_html = sep.rendered_content\n   334→\n   335→        return GroundingMetadata(\n   336→            web_search_queries=web_search_queries,\n   337→            grounding_chunks=grounding_chunks,\n   338→            grounding_supports=grounding_supports,\n   339→            search_entry_point_html=search_entry_point_html,\n   340→        )\n   341→\n   342→    def _build_prompt(\n   343→        self,\n   344→        prompt: str,\n   345→        system_prompt: Optional[str] = None,\n   346→    ) -> str:\n   347→        if system_prompt:\n   348→            return f\"{system_prompt}\\n\\n{prompt}\"\n   349→        return prompt\n   350→\n   351→    def _get_token_usage(self, response) -> Optional[TokenUsage]:\n   352→        \"\"\"Extract token usage from response.\"\"\"\n   353→        if not hasattr(response, 'usage_metadata') or not response.usage_metadata:\n   354→            return None\n   355→\n   356→        usage = response.usage_metadata\n   357→        return TokenUsage(\n   358→            input_tokens=getattr(usage, 'prompt_token_count', 0) or 0,\n   359→            output_tokens=getattr(usage, 'candidates_token_count', 0) or 0,\n   360→            total_tokens=getattr(usage, 'total_token_count', 0) or 0,\n   361→        )\n   362→\n   363→    def _estimate_cost(self, token_usage: Optional[TokenUsage]) -> Optional[float]:\n   364→        \"\"\"Estimate cost based on token usage.\"\"\"\n   365→        if not token_usage:\n   366→            return None\n   367→\n   368→        rates = self.COST_RATES.get(\n   369→            self.model,\n   370→            {\"input\": 0.075, \"output\": 0.30}\n   371→        )\n   372→\n   373→        input_cost = (token_usage.input_tokens / 1_000_000) * rates[\"input\"]\n   374→        output_cost = (token_usage.output_tokens / 1_000_000) * rates[\"output\"]\n   375→\n   376→        return input_cost + output_cost\n   377→\n   378→    def _parse_json(self, text: str) -> tuple[Any, Optional[str]]:\n   379→        \"\"\"Parse JSON from text with fallback extraction.\"\"\"\n   380→        if not text or not text.strip():\n   381→            return None, \"Empty response text\"\n   382→\n   383→        try:\n   384→            return json.loads(text), None\n   385→        except json.JSONDecodeError as e:\n   386→            first_error = str(e)\n   387→\n   388→            # Try extracting from code block\n   389→            import re\n   390→            code_block_match = re.search(r'```(?:json)?\\s*\\n?([\\s\\S]*?)\\n?```', text)\n   391→            if code_block_match:\n   392→                try:\n   393→                    return json.loads(code_block_match.group(1)), None\n   394→                except json.JSONDecodeError:\n   395→                    pass\n   396→\n   397→            # Try finding JSON array or object\n   398→            for start_char, end_char in [('[', ']'), ('{', '}')]:\n   399→                start = text.find(start_char)\n   400→                end = text.rfind(end_char) + 1\n   401→                if start != -1 and end > start:\n   402→                    try:\n   403→                        return json.loads(text[start:end]), None\n   404→                    except json.JSONDecodeError:\n   405→                        continue\n   406→\n   407→            preview = text[:500] if len(text) > 500 else text\n   408→            error_msg = f\"JSON parsing failed: {first_error}. Response preview: {preview}\"\n   409→            logger.warning(error_msg)\n   410→            return None, error_msg\n   411→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"34eb5170-c9bb-41ec-b332-c49ff6c57668","uuid":"192aaadd-fd2b-42e5-95c7-9473ecfe2682","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\actor\\src\\clients\\gemini.py","content":"\"\"\"Gemini client with Google Search grounding.\"\"\"\n\nimport json\nimport logging\nfrom enum import Enum\nfrom typing import Optional, List, Dict, Any\nfrom dataclasses import dataclass, field\n\nlogger = logging.getLogger(__name__)\n\n# Import Google's genai SDK\ntry:\n    from google import genai\n    from google.genai import types\n    GENAI_AVAILABLE = True\nexcept ImportError:\n    GENAI_AVAILABLE = False\n    genai = None\n    types = None\n\n\nclass SearchMode(Enum):\n    \"\"\"Search mode for research queries.\"\"\"\n    NONE = \"none\"\n    SEARCH = \"search\"\n    GROUNDED = \"grounded\"\n\n\n@dataclass\nclass GroundingChunk:\n    \"\"\"A grounding source chunk.\"\"\"\n    uri: str\n    title: str\n    domain: str = \"\"\n\n    def __post_init__(self):\n        if not self.domain and self.uri:\n            # Extract domain from title or URI\n            self.domain = self.title.replace(\".com\", \"\").replace(\".org\", \"\")\n\n\n@dataclass\nclass GroundingSupport:\n    \"\"\"Grounding support - links text segment to source chunks.\"\"\"\n    text: str\n    start_index: int\n    end_index: int\n    chunk_indices: List[int] = field(default_factory=list)\n\n\n@dataclass\nclass GroundingMetadata:\n    \"\"\"Full grounding metadata from response.\"\"\"\n    web_search_queries: List[str] = field(default_factory=list)\n    grounding_chunks: List[GroundingChunk] = field(default_factory=list)\n    grounding_supports: List[GroundingSupport] = field(default_factory=list)\n    search_entry_point_html: Optional[str] = None\n\n\n@dataclass\nclass TokenUsage:\n    \"\"\"Token usage from API response.\"\"\"\n    input_tokens: int = 0\n    output_tokens: int = 0\n    total_tokens: int = 0\n\n    def to_dict(self) -> Dict[str, int]:\n        return {\n            \"input_tokens\": self.input_tokens,\n            \"output_tokens\": self.output_tokens,\n            \"total_tokens\": self.total_tokens,\n        }\n\n\n@dataclass\nclass Source:\n    \"\"\"A source from grounded search.\"\"\"\n    url: str\n    title: str\n    domain: str\n    snippet: str = \"\"\n    source_type: str = \"web\"\n\n\n@dataclass\nclass ResearchResponse:\n    \"\"\"Response from research query.\"\"\"\n    text: str\n    sources: List[Source] = field(default_factory=list)\n    search_queries: List[str] = field(default_factory=list)\n    grounding_metadata: Optional[GroundingMetadata] = None\n    token_usage: Optional[TokenUsage] = None\n    cost_usd: Optional[float] = None\n    search_mode: SearchMode = SearchMode.NONE\n    model: str = \"\"\n    raw_response: Optional[Any] = None\n    parse_error: Optional[str] = None\n\n\nclass GeminiClient:\n    \"\"\"Gemini client with Google Search and Grounding.\"\"\"\n\n    DEFAULT_MODEL = \"gemini-3-flash-preview\"\n\n    COST_RATES = {\n        \"gemini-3-flash-preview\": {\"input\": 0.10, \"output\": 0.40},\n        \"gemini-2.5-flash-preview-05-20\": {\"input\": 0.15, \"output\": 0.60},\n        \"gemini-2.0-flash\": {\"input\": 0.075, \"output\": 0.30},\n        \"gemini-1.5-flash\": {\"input\": 0.075, \"output\": 0.30},\n        \"gemini-1.5-pro\": {\"input\": 1.25, \"output\": 5.00},\n    }\n\n    def __init__(\n        self,\n        api_key: str,\n        model: Optional[str] = None,\n        search_mode: SearchMode = SearchMode.GROUNDED,\n    ):\n        if not GENAI_AVAILABLE:\n            raise ImportError(\n                \"google-genai package not installed. \"\n                \"Install with: pip install google-genai\"\n            )\n\n        self.api_key = api_key\n        self.model = model or self.DEFAULT_MODEL\n        self.search_mode = search_mode\n\n        if not self.api_key:\n            raise ValueError(\"Google API key required\")\n\n        self.client = genai.Client(api_key=self.api_key)\n\n    def is_available(self) -> bool:\n        return bool(self.api_key) and GENAI_AVAILABLE\n\n    async def generate(\n        self,\n        prompt: str,\n        system_prompt: Optional[str] = None,\n        temperature: float = 0.7,\n        max_tokens: int = 4096,\n    ) -> ResearchResponse:\n        \"\"\"Generate response without web search.\"\"\"\n        full_prompt = self._build_prompt(prompt, system_prompt)\n\n        config = types.GenerateContentConfig(\n            temperature=temperature,\n            max_output_tokens=max_tokens,\n        )\n\n        response = self.client.models.generate_content(\n            model=self.model,\n            contents=full_prompt,\n            config=config,\n        )\n\n        token_usage = self._get_token_usage(response)\n        return ResearchResponse(\n            text=response.text,\n            token_usage=token_usage,\n            cost_usd=self._estimate_cost(token_usage),\n            search_mode=SearchMode.NONE,\n            model=self.model,\n            raw_response=response,\n        )\n\n    async def generate_json(\n        self,\n        prompt: str,\n        system_prompt: Optional[str] = None,\n        temperature: float = 0.3,\n    ) -> tuple[Any, ResearchResponse]:\n        \"\"\"Generate JSON response.\"\"\"\n        full_prompt = self._build_prompt(prompt, system_prompt)\n\n        config = types.GenerateContentConfig(\n            temperature=temperature,\n            response_mime_type=\"application/json\",\n        )\n\n        response = self.client.models.generate_content(\n            model=self.model,\n            contents=full_prompt,\n            config=config,\n        )\n\n        parsed, parse_error = self._parse_json(response.text)\n\n        token_usage = self._get_token_usage(response)\n        res = ResearchResponse(\n            text=response.text,\n            token_usage=token_usage,\n            cost_usd=self._estimate_cost(token_usage),\n            search_mode=SearchMode.NONE,\n            model=self.model,\n            raw_response=response,\n        )\n\n        if parse_error:\n            res.parse_error = parse_error\n\n        return parsed, res\n\n    async def research(\n        self,\n        query: str,\n        system_prompt: Optional[str] = None,\n        temperature: float = 0.3,\n        max_tokens: int = 4096,\n        mode: Optional[SearchMode] = None,\n    ) -> ResearchResponse:\n        \"\"\"Research query using Google Search.\"\"\"\n        search_mode = mode or self.search_mode\n\n        if search_mode == SearchMode.NONE:\n            return await self.generate(query, system_prompt, temperature, max_tokens)\n\n        full_prompt = self._build_prompt(query, system_prompt)\n\n        config = types.GenerateContentConfig(\n            temperature=temperature,\n            max_output_tokens=max_tokens,\n            tools=[types.Tool(google_search=types.GoogleSearch())]\n        )\n\n        response = self.client.models.generate_content(\n            model=self.model,\n            contents=full_prompt,\n            config=config,\n        )\n\n        grounding_meta = self._extract_grounding_metadata(response)\n        sources = []\n        search_queries = []\n\n        if grounding_meta:\n            search_queries = grounding_meta.web_search_queries\n            sources = [\n                Source(\n                    url=chunk.uri,\n                    title=chunk.title,\n                    domain=chunk.domain,\n                )\n                for chunk in grounding_meta.grounding_chunks\n            ]\n\n        token_usage = self._get_token_usage(response)\n        return ResearchResponse(\n            text=response.text,\n            sources=sources,\n            search_queries=search_queries,\n            grounding_metadata=grounding_meta if search_mode == SearchMode.GROUNDED else None,\n            token_usage=token_usage,\n            cost_usd=self._estimate_cost(token_usage),\n            search_mode=search_mode,\n            model=self.model,\n            raw_response=response,\n        )\n\n    async def multi_search(\n        self,\n        queries: List[str],\n        system_prompt: Optional[str] = None,\n    ) -> List[ResearchResponse]:\n        \"\"\"Execute multiple research queries.\"\"\"\n        results = []\n        for query in queries:\n            try:\n                response = await self.research(query, system_prompt=system_prompt)\n                results.append(response)\n            except Exception as e:\n                logger.warning(\"Multi-search query failed: %s\", e)\n                results.append(ResearchResponse(\n                    text=f\"Error: {str(e)}\",\n                    search_mode=self.search_mode,\n                    model=self.model,\n                ))\n        return results\n\n    def _extract_grounding_metadata(self, response) -> Optional[GroundingMetadata]:\n        \"\"\"Extract full grounding metadata from response.\"\"\"\n        if not hasattr(response, 'candidates') or not response.candidates:\n            return None\n\n        candidate = response.candidates[0]\n        if not hasattr(candidate, 'grounding_metadata'):\n            return None\n\n        meta = candidate.grounding_metadata\n        if not meta:\n            return None\n\n        web_search_queries = []\n        if hasattr(meta, 'web_search_queries') and meta.web_search_queries:\n            web_search_queries = list(meta.web_search_queries)\n\n        grounding_chunks = []\n        if hasattr(meta, 'grounding_chunks') and meta.grounding_chunks:\n            for chunk in meta.grounding_chunks:\n                if hasattr(chunk, 'web') and chunk.web:\n                    uri = getattr(chunk.web, 'uri', '') or ''\n                    title = getattr(chunk.web, 'title', '') or ''\n                    grounding_chunks.append(GroundingChunk(\n                        uri=uri,\n                        title=title,\n                    ))\n\n        grounding_supports = []\n        if hasattr(meta, 'grounding_supports') and meta.grounding_supports:\n            for support in meta.grounding_supports:\n                segment = getattr(support, 'segment', None)\n                if segment:\n                    text = getattr(segment, 'text', '') or ''\n                    start = getattr(segment, 'start_index', 0) or 0\n                    end = getattr(segment, 'end_index', 0) or 0\n\n                    chunk_indices = []\n                    if hasattr(support, 'grounding_chunk_indices'):\n                        chunk_indices = list(support.grounding_chunk_indices or [])\n\n                    grounding_supports.append(GroundingSupport(\n                        text=text,\n                        start_index=start,\n                        end_index=end,\n                        chunk_indices=chunk_indices,\n                    ))\n\n        search_entry_point_html = None\n        if hasattr(meta, 'search_entry_point'):\n            sep = meta.search_entry_point\n            if hasattr(sep, 'rendered_content'):\n                search_entry_point_html = sep.rendered_content\n\n        return GroundingMetadata(\n            web_search_queries=web_search_queries,\n            grounding_chunks=grounding_chunks,\n            grounding_supports=grounding_supports,\n            search_entry_point_html=search_entry_point_html,\n        )\n\n    def _build_prompt(\n        self,\n        prompt: str,\n        system_prompt: Optional[str] = None,\n    ) -> str:\n        if system_prompt:\n            return f\"{system_prompt}\\n\\n{prompt}\"\n        return prompt\n\n    def _get_token_usage(self, response) -> Optional[TokenUsage]:\n        \"\"\"Extract token usage from response.\"\"\"\n        if not hasattr(response, 'usage_metadata') or not response.usage_metadata:\n            return None\n\n        usage = response.usage_metadata\n        return TokenUsage(\n            input_tokens=getattr(usage, 'prompt_token_count', 0) or 0,\n            output_tokens=getattr(usage, 'candidates_token_count', 0) or 0,\n            total_tokens=getattr(usage, 'total_token_count', 0) or 0,\n        )\n\n    def _estimate_cost(self, token_usage: Optional[TokenUsage]) -> Optional[float]:\n        \"\"\"Estimate cost based on token usage.\"\"\"\n        if not token_usage:\n            return None\n\n        rates = self.COST_RATES.get(\n            self.model,\n            {\"input\": 0.075, \"output\": 0.30}\n        )\n\n        input_cost = (token_usage.input_tokens / 1_000_000) * rates[\"input\"]\n        output_cost = (token_usage.output_tokens / 1_000_000) * rates[\"output\"]\n\n        return input_cost + output_cost\n\n    def _parse_json(self, text: str) -> tuple[Any, Optional[str]]:\n        \"\"\"Parse JSON from text with fallback extraction.\"\"\"\n        if not text or not text.strip():\n            return None, \"Empty response text\"\n\n        try:\n            return json.loads(text), None\n        except json.JSONDecodeError as e:\n            first_error = str(e)\n\n            # Try extracting from code block\n            import re\n            code_block_match = re.search(r'```(?:json)?\\s*\\n?([\\s\\S]*?)\\n?```', text)\n            if code_block_match:\n                try:\n                    return json.loads(code_block_match.group(1)), None\n                except json.JSONDecodeError:\n                    pass\n\n            # Try finding JSON array or object\n            for start_char, end_char in [('[', ']'), ('{', '}')]:\n                start = text.find(start_char)\n                end = text.rfind(end_char) + 1\n                if start != -1 and end > start:\n                    try:\n                        return json.loads(text[start:end]), None\n                    except json.JSONDecodeError:\n                        continue\n\n            preview = text[:500] if len(text) > 500 else text\n            error_msg = f\"JSON parsing failed: {first_error}. Response preview: {preview}\"\n            logger.warning(error_msg)\n            return None, error_msg\n","numLines":411,"startLine":1,"totalLines":411}}}
