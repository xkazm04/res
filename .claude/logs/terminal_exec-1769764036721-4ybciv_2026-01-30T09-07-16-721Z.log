[2026-01-30T09:08:24.049Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HygfxLHkGt6KaZaiPUoPjP","type":"tool_result","content":"     1→\"\"\"Intelligence analysis service for enhanced insights.\n     2→\n     3→Provides:\n     4→- Contradiction detection across findings\n     5→- Knowledge gaps analysis (\"What We Don't Know\")\n     6→- Role-specific executive summaries (CTO, CFO, CEO views)\n     7→\"\"\"\n     8→\n     9→import logging\n    10→from typing import List, Dict, Any, Optional, Tuple\n    11→from dataclasses import dataclass, asdict\n    12→\n    13→logger = logging.getLogger(__name__)\n    14→\n    15→\n    16→@dataclass\n    17→class Contradiction:\n    18→    \"\"\"A detected contradiction between findings.\"\"\"\n    19→    finding_a_id: str\n    20→    finding_a_summary: str\n    21→    finding_b_id: str\n    22→    finding_b_summary: str\n    23→    contradiction_type: str  # factual, temporal, quantitative, interpretive\n    24→    description: str\n    25→    severity: str  # high, medium, low\n    26→    resolution_hint: str\n    27→\n    28→\n    29→@dataclass\n    30→class KnowledgeGap:\n    31→    \"\"\"A gap in the research that affects conclusions.\"\"\"\n    32→    gap_id: str\n    33→    topic: str\n    34→    description: str\n    35→    importance: str  # critical, important, nice_to_have\n    36→    impact_on_conclusions: str\n    37→    suggested_query: str\n    38→    related_findings: List[str]\n    39→\n    40→\n    41→@dataclass\n    42→class RoleSummary:\n    43→    \"\"\"Role-specific summary for a stakeholder type.\"\"\"\n    44→    role: str  # cto, cfo, ceo, legal, product\n    45→    role_title: str\n    46→    headline: str\n    47→    key_points: List[str]\n    48→    action_items: List[str]\n    49→    risks_to_watch: List[str]\n    50→    metrics_of_interest: List[Dict[str, Any]]\n    51→    confidence_level: str  # high, medium, low\n    52→\n    53→\n    54→class IntelligenceAnalyzer:\n    55→    \"\"\"Analyzes findings for deeper insights.\"\"\"\n    56→\n    57→    def __init__(self, gemini_client=None):\n    58→        self.gemini_client = gemini_client\n    59→\n    60→    async def analyze(\n    61→        self,\n    62→        findings: List[Dict[str, Any]],\n    63→        perspectives: List[Dict[str, Any]],\n    64→        sources: List[Dict[str, Any]],\n    65→        query: str,\n    66→        template: str,\n    67→    ) -> Dict[str, Any]:\n    68→        \"\"\"\n    69→        Run full intelligence analysis on research results.\n    70→\n    71→        Returns:\n    72→            Dict with 'contradictions', 'knowledge_gaps', 'role_summaries'\n    73→        \"\"\"\n    74→        results = {\n    75→            \"contradictions\": [],\n    76→            \"knowledge_gaps\": [],\n    77→            \"role_summaries\": {},\n    78→        }\n    79→\n    80→        # Run analyses\n    81→        try:\n    82→            contradictions = await self.detect_contradictions(findings)\n    83→            results[\"contradictions\"] = [asdict(c) for c in contradictions]\n    84→        except Exception as e:\n    85→            logger.warning(f\"Contradiction detection failed: {e}\")\n    86→\n    87→        try:\n    88→            gaps = await self.identify_knowledge_gaps(findings, perspectives, query, template)\n    89→            results[\"knowledge_gaps\"] = [asdict(g) for g in gaps]\n    90→        except Exception as e:\n    91→            logger.warning(f\"Knowledge gap analysis failed: {e}\")\n    92→\n    93→        try:\n    94→            summaries = await self.generate_role_summaries(findings, perspectives, query, template)\n    95→            results[\"role_summaries\"] = {s.role: asdict(s) for s in summaries}\n    96→        except Exception as e:\n    97→            logger.warning(f\"Role summary generation failed: {e}\")\n    98→\n    99→        return results\n   100→\n   101→    async def detect_contradictions(\n   102→        self,\n   103→        findings: List[Dict[str, Any]],\n   104→    ) -> List[Contradiction]:\n   105→        \"\"\"\n   106→        Detect contradictions between findings.\n   107→\n   108→        Looks for:\n   109→        - Conflicting facts (A says X, B says not-X)\n   110→        - Quantitative disagreements (A says 40%, B says 77%)\n   111→        - Temporal inconsistencies (A says happened in 2024, B says 2023)\n   112→        - Interpretive conflicts (A says bullish, B says bearish on same data)\n   113→        \"\"\"\n   114→        if len(findings) < 2:\n   115→            return []\n   116→\n   117→        contradictions = []\n   118→\n   119→        # Group findings by topic for efficient comparison\n   120→        # Compare findings pairwise for contradictions\n   121→        for i, finding_a in enumerate(findings):\n   122→            for j, finding_b in enumerate(findings[i + 1:], i + 1):\n   123→                contradiction = self._check_contradiction(finding_a, finding_b)\n   124→                if contradiction:\n   125→                    contradictions.append(contradiction)\n   126→\n   127→        return contradictions\n   128→\n   129→    def _check_contradiction(\n   130→        self,\n   131→        finding_a: Dict[str, Any],\n   132→        finding_b: Dict[str, Any],\n   133→    ) -> Optional[Contradiction]:\n   134→        \"\"\"Check if two findings contradict each other.\"\"\"\n   135→        # Extract content and data\n   136→        content_a = finding_a.get(\"content\", \"\").lower()\n   137→        content_b = finding_b.get(\"content\", \"\").lower()\n   138→        data_a = finding_a.get(\"extracted_data\", {}) or {}\n   139→        data_b = finding_b.get(\"extracted_data\", {}) or {}\n   140→\n   141→        id_a = finding_a.get(\"finding_id\", \"f?\")\n   142→        id_b = finding_b.get(\"finding_id\", \"f?\")\n   143→        summary_a = finding_a.get(\"summary\", content_a[:100])\n   144→        summary_b = finding_b.get(\"summary\", content_b[:100])\n   145→\n   146→        # Check for quantitative contradictions\n   147→        quant_contradiction = self._check_quantitative_contradiction(data_a, data_b, finding_a, finding_b)\n   148→        if quant_contradiction:\n   149→            return Contradiction(\n   150→                finding_a_id=id_a,\n   151→                finding_a_summary=summary_a,\n   152→                finding_b_id=id_b,\n   153→                finding_b_summary=summary_b,\n   154→                contradiction_type=\"quantitative\",\n   155→                description=quant_contradiction[0],\n   156→                severity=quant_contradiction[1],\n   157→                resolution_hint=quant_contradiction[2],\n   158→            )\n   159→\n   160→        # Check for temporal contradictions\n   161→        temporal_contradiction = self._check_temporal_contradiction(finding_a, finding_b)\n   162→        if temporal_contradiction:\n   163→            return Contradiction(\n   164→                finding_a_id=id_a,\n   165→                finding_a_summary=summary_a,\n   166→                finding_b_id=id_b,\n   167→                finding_b_summary=summary_b,\n   168→                contradiction_type=\"temporal\",\n   169→                description=temporal_contradiction[0],\n   170→                severity=temporal_contradiction[1],\n   171→                resolution_hint=temporal_contradiction[2],\n   172→            )\n   173→\n   174→        # Check for semantic contradictions (opposing sentiment on same topic)\n   175→        semantic_contradiction = self._check_semantic_contradiction(content_a, content_b, data_a, data_b)\n   176→        if semantic_contradiction:\n   177→            return Contradiction(\n   178→                finding_a_id=id_a,\n   179→                finding_a_summary=summary_a,\n   180→                finding_b_id=id_b,\n   181→                finding_b_summary=summary_b,\n   182→                contradiction_type=\"interpretive\",\n   183→                description=semantic_contradiction[0],\n   184→                severity=semantic_contradiction[1],\n   185→                resolution_hint=semantic_contradiction[2],\n   186→            )\n   187→\n   188→        return None\n   189→\n   190→    def _check_quantitative_contradiction(\n   191→        self,\n   192→        data_a: Dict,\n   193→        data_b: Dict,\n   194→        finding_a: Dict,\n   195→        finding_b: Dict,\n   196→    ) -> Optional[Tuple[str, str, str]]:\n   197→        \"\"\"Check for conflicting numbers about the same metric.\"\"\"\n   198→        # Common metrics to check\n   199→        metric_keys = [\n   200→            \"adoption_rate\", \"growth_percentage\", \"market_share\",\n   201→            \"revenue\", \"subscribers\", \"users\", \"amount\", \"value\",\n   202→            \"growth\", \"rate\", \"percentage\"\n   203→        ]\n   204→\n   205→        for key in metric_keys:\n   206→            val_a = data_a.get(key)\n   207→            val_b = data_b.get(key)\n   208→\n   209→            if val_a and val_b:\n   210→                # Extract numeric values\n   211→                num_a = self._extract_number(str(val_a))\n   212→                num_b = self._extract_number(str(val_b))\n   213→\n   214→                if num_a is not None and num_b is not None:\n   215→                    # Check if they're about the same entity\n   216→                    entity_a = data_a.get(\"technology\") or data_a.get(\"company\") or data_a.get(\"product\")\n   217→                    entity_b = data_b.get(\"technology\") or data_b.get(\"company\") or data_b.get(\"product\")\n   218→\n   219→                    if entity_a and entity_b and entity_a.lower() == entity_b.lower():\n   220→                        # Calculate difference\n   221→                        diff = abs(num_a - num_b)\n   222→                        avg = (num_a + num_b) / 2 if (num_a + num_b) > 0 else 1\n   223→                        pct_diff = (diff / avg) * 100\n   224→\n   225→                        if pct_diff > 30:  # Significant difference\n   226→                            severity = \"high\" if pct_diff > 50 else \"medium\"\n   227→                            return (\n   228→                                f\"Conflicting {key} for {entity_a}: {val_a} vs {val_b} ({pct_diff:.0f}% difference)\",\n   229→                                severity,\n   230→                                f\"Check source dates and methodologies. The difference may be due to different time periods or measurement criteria.\"\n   231→                            )\n   232→\n   233→        return None\n   234→\n   235→    def _check_temporal_contradiction(\n   236→        self,\n   237→        finding_a: Dict,\n   238→        finding_b: Dict,\n   239→    ) -> Optional[Tuple[str, str, str]]:\n   240→        \"\"\"Check for conflicting dates about the same event.\"\"\"\n   241→        date_a = finding_a.get(\"date_referenced\") or finding_a.get(\"event_date\")\n   242→        date_b = finding_b.get(\"date_referenced\") or finding_b.get(\"event_date\")\n   243→\n   244→        if not date_a or not date_b:\n   245→            return None\n   246→\n   247→        # Check if findings are about the same event/topic\n   248→        type_a = finding_a.get(\"finding_type\", \"\")\n   249→        type_b = finding_b.get(\"finding_type\", \"\")\n   250→\n   251→        data_a = finding_a.get(\"extracted_data\", {}) or {}\n   252→        data_b = finding_b.get(\"extracted_data\", {}) or {}\n   253→\n   254→        # Same type and same entity suggests same topic\n   255→        if type_a == type_b:\n   256→            entity_a = data_a.get(\"company\") or data_a.get(\"technology\") or data_a.get(\"product\")\n   257→            entity_b = data_b.get(\"company\") or data_b.get(\"technology\") or data_b.get(\"product\")\n   258→\n   259→            if entity_a and entity_b and entity_a.lower() == entity_b.lower():\n   260→                if date_a != date_b:\n   261→                    return (\n   262→                        f\"Conflicting dates for {entity_a}: {date_a} vs {date_b}\",\n   263→                        \"medium\",\n   264→                        f\"The sources may be referring to different events or updates. Check context.\"\n   265→                    )\n   266→\n   267→        return None\n   268→\n   269→    def _check_semantic_contradiction(\n   270→        self,\n   271→        content_a: str,\n   272→        content_b: str,\n   273→        data_a: Dict,\n   274→        data_b: Dict,\n   275→    ) -> Optional[Tuple[str, str, str]]:\n   276→        \"\"\"Check for opposing interpretations of the same topic.\"\"\"\n   277→        # Look for opposing sentiment indicators\n   278→        bullish_terms = [\"growth\", \"surge\", \"boom\", \"accelerat\", \"outperform\", \"strong\", \"positive\", \"bullish\"]\n   279→        bearish_terms = [\"decline\", \"drop\", \"fall\", \"slow\", \"underperform\", \"weak\", \"negative\", \"bearish\"]\n   280→\n   281→        # Check if about same topic\n   282→        entity_a = data_a.get(\"technology\") or data_a.get(\"company\") or \"\"\n   283→        entity_b = data_b.get(\"technology\") or data_b.get(\"company\") or \"\"\n   284→\n   285→        if entity_a and entity_b and entity_a.lower() == entity_b.lower():\n   286→            has_bullish_a = any(term in content_a for term in bullish_terms)\n   287→            has_bearish_a = any(term in content_a for term in bearish_terms)\n   288→            has_bullish_b = any(term in content_b for term in bullish_terms)\n   289→            has_bearish_b = any(term in content_b for term in bearish_terms)\n   290→\n   291→            # Check for opposing sentiment\n   292→            if (has_bullish_a and has_bearish_b) or (has_bearish_a and has_bullish_b):\n   293→                return (\n   294→                    f\"Conflicting assessments of {entity_a}: one source is optimistic, another pessimistic\",\n   295→                    \"medium\",\n   296→                    f\"Consider both perspectives. The truth may depend on timeframe, market segment, or use case.\"\n   297→                )\n   298→\n   299→        return None\n   300→\n   301→    def _extract_number(self, text: str) -> Optional[float]:\n   302→        \"\"\"Extract a number from text like '77%' or '$1.8M' or '1,000'.\"\"\"\n   303→        import re\n   304→\n   305→        # Remove common formatting\n   306→        text = text.replace(\",\", \"\").replace(\"$\", \"\").replace(\"%\", \"\")\n   307→\n   308→        # Handle M/B/K suffixes\n   309→        multipliers = {\"m\": 1_000_000, \"b\": 1_000_000_000, \"k\": 1_000}\n   310→        for suffix, mult in multipliers.items():\n   311→            if text.lower().endswith(suffix):\n   312→                text = text[:-1]\n   313→                try:\n   314→                    return float(text) * mult\n   315→                except ValueError:\n   316→                    pass\n   317→\n   318→        # Try direct parse\n   319→        match = re.search(r'[\\d.]+', text)\n   320→        if match:\n   321→            try:\n   322→                return float(match.group())\n   323→            except ValueError:\n   324→                pass\n   325→\n   326→        return None\n   327→\n   328→    async def identify_knowledge_gaps(\n   329→        self,\n   330→        findings: List[Dict[str, Any]],\n   331→        perspectives: List[Dict[str, Any]],\n   332→        query: str,\n   333→        template: str,\n   334→    ) -> List[KnowledgeGap]:\n   335→        \"\"\"\n   336→        Identify what we don't know that would affect conclusions.\n   337→\n   338→        Analyzes:\n   339→        - Low-confidence findings that need more data\n   340→        - Topics mentioned but not fully explored\n   341→        - Missing data for key decisions\n   342→        - Unanswered questions from perspectives\n   343→        \"\"\"\n   344→        gaps = []\n   345→        gap_id = 1\n   346→\n   347→        # 1. Find low-confidence findings with high importance\n   348→        for finding in findings:\n   349→            confidence = finding.get(\"adjusted_confidence\") or finding.get(\"confidence_score\", 0.5)\n   350→            finding_type = finding.get(\"finding_type\", \"\")\n   351→\n   352→            # Important types that need high confidence\n   353→            critical_types = [\"prediction\", \"risk_factor\", \"red_flag\", \"earnings_metric\", \"valuation_signal\"]\n   354→\n   355→            if confidence < 0.6 and finding_type in critical_types:\n   356→                summary = finding.get(\"summary\", \"\")[:100]\n   357→                gaps.append(KnowledgeGap(\n   358→                    gap_id=f\"g{gap_id}\",\n   359→                    topic=f\"Uncertain: {finding_type.replace('_', ' ').title()}\",\n   360→                    description=f\"Low confidence ({confidence:.0%}) on critical finding: {summary}\",\n   361→                    importance=\"important\" if finding_type in [\"prediction\", \"earnings_metric\"] else \"critical\",\n   362→                    impact_on_conclusions=\"This uncertainty directly affects key conclusions and recommendations\",\n   363→                    suggested_query=f\"Additional sources for: {summary}\",\n   364→                    related_findings=[finding.get(\"finding_id\", \"\")],\n   365→                ))\n   366→                gap_id += 1\n   367→\n   368→        # 2. Identify gaps from perspective warnings\n   369→        for perspective in perspectives:\n   370→            warnings = perspective.get(\"warnings\", [])\n   371→            perspective_type = perspective.get(\"perspective_type\", \"\")\n   372→\n   373→            for warning in warnings:\n   374→                if any(term in warning.lower() for term in [\"unknown\", \"unclear\", \"missing\", \"need more\", \"no data\"]):\n   375→                    gaps.append(KnowledgeGap(\n   376→                        gap_id=f\"g{gap_id}\",\n   377→                        topic=f\"Expert Concern: {perspective_type.replace('_', ' ').title()}\",\n   378→                        description=warning,\n   379→                        importance=\"important\",\n   380→                        impact_on_conclusions=f\"The {perspective_type.replace('_', ' ')} perspective flagged this uncertainty\",\n   381→                        suggested_query=f\"Research to address: {warning[:80]}\",\n   382→                        related_findings=[],\n   383→                    ))\n   384→                    gap_id += 1\n   385→\n   386→        # 3. Template-specific gap detection\n   387→        template_gaps = self._get_template_specific_gaps(findings, template, query)\n   388→        for gap_info in template_gaps:\n   389→            gaps.append(KnowledgeGap(\n   390→                gap_id=f\"g{gap_id}\",\n   391→                **gap_info\n   392→            ))\n   393→            gap_id += 1\n   394→\n   395→        # 4. Check for missing finding types\n   396→        if template == \"financial\":\n   397→            expected_types = {\"earnings_metric\", \"valuation_signal\", \"risk_factor\", \"guidance\"}\n   398→            found_types = {f.get(\"finding_type\") for f in findings}\n   399→            missing = expected_types - found_types\n   400→\n   401→            if missing:\n   402→                gaps.append(KnowledgeGap(\n   403→                    gap_id=f\"g{gap_id}\",\n   404→                    topic=\"Missing Financial Data\",\n   405→                    description=f\"No findings for: {', '.join(t.replace('_', ' ') for t in missing)}\",\n   406→                    importance=\"critical\",\n   407→                    impact_on_conclusions=\"Investment analysis requires these data points for completeness\",\n   408→                    suggested_query=f\"{query} {' '.join(missing)}\",\n   409→                    related_findings=[],\n   410→                ))\n   411→                gap_id += 1\n   412→\n   413→        elif template == \"tech_market\":\n   414→            expected_types = {\"adoption_trend\", \"prediction\", \"market_metric\"}\n   415→            found_types = {f.get(\"finding_type\") for f in findings}\n   416→            missing = expected_types - found_types\n   417→\n   418→            if missing:\n   419→                gaps.append(KnowledgeGap(\n   420→                    gap_id=f\"g{gap_id}\",\n   421→                    topic=\"Missing Market Data\",\n   422→                    description=f\"No findings for: {', '.join(t.replace('_', ' ') for t in missing)}\",\n   423→                    importance=\"important\",\n   424→                    impact_on_conclusions=\"Market analysis benefits from trend and adoption data\",\n   425→                    suggested_query=f\"{query} market data statistics trends\",\n   426→                    related_findings=[],\n   427→                ))\n   428→                gap_id += 1\n   429→\n   430→        return gaps[:10]  # Limit to top 10 gaps\n   431→\n   432→    def _get_template_specific_gaps(\n   433→        self,\n   434→        findings: List[Dict[str, Any]],\n   435→        template: str,\n   436→        query: str,\n   437→    ) -> List[Dict[str, Any]]:\n   438→        \"\"\"Get template-specific knowledge gaps.\"\"\"\n   439→        gaps = []\n   440→\n   441→        # Check for common gaps based on template\n   442→        if template == \"investigative\":\n   443→            # Check for missing actor relationships\n   444→            has_relationships = any(f.get(\"finding_type\") == \"relationship\" for f in findings)\n   445→            if not has_relationships:\n   446→                gaps.append({\n   447→                    \"topic\": \"Missing Relationship Mapping\",\n   448→                    \"description\": \"No relationship network data found between key actors\",\n   449→                    \"importance\": \"critical\",\n   450→                    \"impact_on_conclusions\": \"Understanding connections is crucial for investigative analysis\",\n   451→                    \"suggested_query\": f\"{query} relationships connections network\",\n   452→                    \"related_findings\": [],\n   453→                })\n   454→\n   455→        elif template == \"competitive\":\n   456→            # Check for pricing data\n   457→            has_pricing = any(\"pricing\" in str(f.get(\"extracted_data\", {})).lower() for f in findings)\n   458→            if not has_pricing:\n   459→                gaps.append({\n   460→                    \"topic\": \"Missing Pricing Comparison\",\n   461→                    \"description\": \"No competitive pricing data available\",\n   462→                    \"importance\": \"important\",\n   463→                    \"impact_on_conclusions\": \"Pricing is key for competitive positioning analysis\",\n   464→                    \"suggested_query\": f\"{query} pricing plans cost comparison\",\n   465→                    \"related_findings\": [],\n   466→                })\n   467→\n   468→        return gaps\n   469→\n   470→    async def generate_role_summaries(\n   471→        self,\n   472→        findings: List[Dict[str, Any]],\n   473→        perspectives: List[Dict[str, Any]],\n   474→        query: str,\n   475→        template: str,\n   476→    ) -> List[RoleSummary]:\n   477→        \"\"\"\n   478→        Generate role-specific summaries for different stakeholders.\n   479→\n   480→        Roles:\n   481→        - CTO: Technical depth, integration effort, team readiness\n   482→        - CFO: Cost analysis, ROI, budget impact\n   483→        - CEO: Strategic fit, competitive position, market timing\n   484→        \"\"\"\n   485→        summaries = []\n   486→\n   487→        # Gather relevant data\n   488→        all_insights = []\n   489→        all_warnings = []\n   490→        all_recommendations = []\n   491→\n   492→        for p in perspectives:\n   493→            all_insights.extend(p.get(\"key_insights\", []))\n   494→            all_warnings.extend(p.get(\"warnings\", []))\n   495→            all_recommendations.extend(p.get(\"recommendations\", []))\n   496→\n   497→        # Calculate overall confidence\n   498→        confidences = [f.get(\"adjusted_confidence\") or f.get(\"confidence_score\", 0.5) for f in findings]\n   499→        avg_confidence = sum(confidences) / len(confidences) if confidences else 0.5\n   500→        confidence_level = \"high\" if avg_confidence >= 0.75 else \"medium\" if avg_confidence >= 0.5 else \"low\"\n   501→\n   502→        # Generate CTO Summary\n   503→        cto_summary = self._generate_cto_summary(findings, all_insights, all_warnings, all_recommendations, template, confidence_level)\n   504→        summaries.append(cto_summary)\n   505→\n   506→        # Generate CFO Summary\n   507→        cfo_summary = self._generate_cfo_summary(findings, all_insights, all_warnings, all_recommendations, template, confidence_level)\n   508→        summaries.append(cfo_summary)\n   509→\n   510→        # Generate CEO Summary\n   511→        ceo_summary = self._generate_ceo_summary(findings, all_insights, all_warnings, all_recommendations, template, confidence_level)\n   512→        summaries.append(ceo_summary)\n   513→\n   514→        return summaries\n   515→\n   516→    def _generate_cto_summary(\n   517→        self,\n   518→        findings: List[Dict],\n   519→        insights: List[str],\n   520→        warnings: List[str],\n   521→        recommendations: List[str],\n   522→        template: str,\n   523→        confidence_level: str,\n   524→    ) -> RoleSummary:\n   525→        \"\"\"Generate CTO-focused summary.\"\"\"\n   526→        # Filter for technical insights\n   527→        tech_keywords = [\"architecture\", \"integration\", \"api\", \"sdk\", \"developer\", \"engineering\", \"technical\",\n   528→                         \"performance\", \"scalability\", \"security\", \"infrastructure\", \"code\", \"implementation\"]\n   529→\n   530→        tech_insights = [i for i in insights if any(kw in i.lower() for kw in tech_keywords)]\n   531→        tech_warnings = [w for w in warnings if any(kw in w.lower() for kw in tech_keywords)]\n   532→        tech_recs = [r for r in recommendations if any(kw in r.lower() for kw in tech_keywords)]\n   533→\n   534→        # Extract technical metrics\n   535→        tech_metrics = []\n   536→        for f in findings:\n   537→            data = f.get(\"extracted_data\", {}) or {}\n   538→            finding_type = f.get(\"finding_type\", \"\")\n   539→\n   540→            if finding_type in [\"product_launch\", \"adoption_trend\", \"enterprise_adoption\"]:\n   541→                if data.get(\"technology\") or data.get(\"product\"):\n   542→                    tech_metrics.append({\n   543→                        \"metric\": data.get(\"technology\") or data.get(\"product\"),\n   544→                        \"value\": data.get(\"adoption_rate\") or data.get(\"growth_percentage\") or \"N/A\",\n   545→                        \"context\": f.get(\"analysis\") or f.get(\"summary\", \"\"),\n   546→                    })\n   547→\n   548→        # Generate headline\n   549→        headline = self._generate_headline(findings, \"technical\", template)\n   550→\n   551→        return RoleSummary(\n   552→            role=\"cto\",\n   553→            role_title=\"Chief Technology Officer\",\n   554→            headline=headline,\n   555→            key_points=tech_insights[:5] if tech_insights else [\"No specific technical insights extracted\"],\n   556→            action_items=[\n   557→                \"Evaluate technical integration requirements\",\n   558→                \"Assess team readiness and skill gaps\",\n   559→                \"Review security and compliance implications\",\n   560→            ] + tech_recs[:2],\n   561→            risks_to_watch=tech_warnings[:3] if tech_warnings else [\"Monitor for breaking changes\"],\n   562→            metrics_of_interest=tech_metrics[:5],\n   563→            confidence_level=confidence_level,\n   564→        )\n   565→\n   566→    def _generate_cfo_summary(\n   567→        self,\n   568→        findings: List[Dict],\n   569→        insights: List[str],\n   570→        warnings: List[str],\n   571→        recommendations: List[str],\n   572→        template: str,\n   573→        confidence_level: str,\n   574→    ) -> RoleSummary:\n   575→        \"\"\"Generate CFO-focused summary.\"\"\"\n   576→        # Filter for financial insights\n   577→        fin_keywords = [\"cost\", \"price\", \"revenue\", \"profit\", \"margin\", \"budget\", \"roi\", \"investment\",\n   578→                        \"valuation\", \"earnings\", \"growth\", \"market\", \"funding\", \"capital\"]\n   579→\n   580→        fin_insights = [i for i in insights if any(kw in i.lower() for kw in fin_keywords)]\n   581→        fin_warnings = [w for w in warnings if any(kw in w.lower() for kw in fin_keywords)]\n   582→        fin_recs = [r for r in recommendations if any(kw in r.lower() for kw in fin_keywords)]\n   583→\n   584→        # Extract financial metrics\n   585→        fin_metrics = []\n   586→        for f in findings:\n   587→            data = f.get(\"extracted_data\", {}) or {}\n   588→            finding_type = f.get(\"finding_type\", \"\")\n   589→\n   590→            if finding_type in [\"funding_round\", \"earnings_metric\", \"market_metric\", \"valuation_signal\"]:\n   591→                metric_name = data.get(\"company\") or data.get(\"metric_name\") or finding_type\n   592→                metric_value = data.get(\"amount\") or data.get(\"revenue\") or data.get(\"value\")\n   593→                if metric_value:\n   594→                    fin_metrics.append({\n   595→                        \"metric\": metric_name,\n   596→                        \"value\": str(metric_value),\n   597→                        \"context\": f.get(\"analysis\") or f.get(\"summary\", \"\"),\n   598→                    })\n   599→\n   600→        # Generate headline\n   601→        headline = self._generate_headline(findings, \"financial\", template)\n   602→\n   603→        return RoleSummary(\n   604→            role=\"cfo\",\n   605→            role_title=\"Chief Financial Officer\",\n   606→            headline=headline,\n   607→            key_points=fin_insights[:5] if fin_insights else [\"No specific financial insights extracted\"],\n   608→            action_items=[\n   609→                \"Evaluate budget implications\",\n   610→                \"Assess ROI and payback period\",\n   611→                \"Review vendor pricing and contracts\",\n   612→            ] + fin_recs[:2],\n   613→            risks_to_watch=fin_warnings[:3] if fin_warnings else [\"Monitor market pricing trends\"],\n   614→            metrics_of_interest=fin_metrics[:5],\n   615→            confidence_level=confidence_level,\n   616→        )\n   617→\n   618→    def _generate_ceo_summary(\n   619→        self,\n   620→        findings: List[Dict],\n   621→        insights: List[str],\n   622→        warnings: List[str],\n   623→        recommendations: List[str],\n   624→        template: str,\n   625→        confidence_level: str,\n   626→    ) -> RoleSummary:\n   627→        \"\"\"Generate CEO-focused summary.\"\"\"\n   628→        # Filter for strategic insights\n   629→        strat_keywords = [\"strategy\", \"competitive\", \"market\", \"position\", \"opportunity\", \"threat\",\n   630→                          \"acquisition\", \"partnership\", \"leadership\", \"trend\", \"industry\", \"future\"]\n   631→\n   632→        strat_insights = [i for i in insights if any(kw in i.lower() for kw in strat_keywords)]\n   633→        strat_warnings = [w for w in warnings if any(kw in w.lower() for kw in strat_keywords)]\n   634→        strat_recs = [r for r in recommendations if any(kw in r.lower() for kw in strat_keywords)]\n   635→\n   636→        # Extract strategic metrics\n   637→        strat_metrics = []\n   638→        for f in findings:\n   639→            data = f.get(\"extracted_data\", {}) or {}\n   640→            finding_type = f.get(\"finding_type\", \"\")\n   641→\n   642→            if finding_type in [\"acquisition\", \"prediction\", \"market_metric\", \"adoption_trend\"]:\n   643→                metric_name = data.get(\"company\") or data.get(\"technology\") or finding_type\n   644→                metric_value = data.get(\"market_share\") or data.get(\"adoption_rate\") or data.get(\"growth_percentage\")\n   645→                if metric_value:\n   646→                    strat_metrics.append({\n   647→                        \"metric\": metric_name,\n   648→                        \"value\": str(metric_value),\n   649→                        \"context\": f.get(\"analysis\") or f.get(\"summary\", \"\"),\n   650→                    })\n   651→\n   652→        # Generate headline\n   653→        headline = self._generate_headline(findings, \"strategic\", template)\n   654→\n   655→        return RoleSummary(\n   656→            role=\"ceo\",\n   657→            role_title=\"Chief Executive Officer\",\n   658→            headline=headline,\n   659→            key_points=strat_insights[:5] if strat_insights else [\"No specific strategic insights extracted\"],\n   660→            action_items=[\n   661→                \"Evaluate strategic fit with company direction\",\n   662→                \"Assess competitive implications\",\n   663→                \"Consider market timing for action\",\n   664→            ] + strat_recs[:2],\n   665→            risks_to_watch=strat_warnings[:3] if strat_warnings else [\"Monitor competitive landscape changes\"],\n   666→            metrics_of_interest=strat_metrics[:5],\n   667→            confidence_level=confidence_level,\n   668→        )\n   669→\n   670→    def _generate_headline(\n   671→        self,\n   672→        findings: List[Dict],\n   673→        focus: str,\n   674→        template: str,\n   675→    ) -> str:\n   676→        \"\"\"Generate a headline for the role summary.\"\"\"\n   677→        # Count finding types\n   678→        prediction_count = sum(1 for f in findings if f.get(\"finding_type\") == \"prediction\")\n   679→        high_conf_count = sum(1 for f in findings if (f.get(\"adjusted_confidence\") or f.get(\"confidence_score\", 0)) >= 0.8)\n   680→\n   681→        if focus == \"technical\":\n   682→            if template == \"tech_market\":\n   683→                return f\"Technology landscape analysis with {len(findings)} key findings, {high_conf_count} high-confidence\"\n   684→            return f\"Technical assessment across {len(findings)} findings\"\n   685→\n   686→        elif focus == \"financial\":\n   687→            if template == \"financial\":\n   688→                return f\"Financial analysis: {len(findings)} data points, {high_conf_count} verified\"\n   689→            return f\"Budget and ROI considerations from {len(findings)} findings\"\n   690→\n   691→        else:  # strategic\n   692→            if prediction_count > 0:\n   693→                return f\"Strategic outlook with {prediction_count} predictions across {len(findings)} findings\"\n   694→            return f\"Strategic assessment: {len(findings)} findings, {high_conf_count} high-confidence\"\n   695→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"34eb5170-c9bb-41ec-b332-c49ff6c57668","uuid":"9045f47b-f1ba-4cf3-8017-0b33f096de08","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\actor\\src\\services\\intelligence.py","content":"\"\"\"Intelligence analysis service for enhanced insights.\n\nProvides:\n- Contradiction detection across findings\n- Knowledge gaps analysis (\"What We Don't Know\")\n- Role-specific executive summaries (CTO, CFO, CEO views)\n\"\"\"\n\nimport logging\nfrom typing import List, Dict, Any, Optional, Tuple\nfrom dataclasses import dataclass, asdict\n\nlogger = logging.getLogger(__name__)\n\n\n@dataclass\nclass Contradiction:\n    \"\"\"A detected contradiction between findings.\"\"\"\n    finding_a_id: str\n    finding_a_summary: str\n    finding_b_id: str\n    finding_b_summary: str\n    contradiction_type: str  # factual, temporal, quantitative, interpretive\n    description: str\n    severity: str  # high, medium, low\n    resolution_hint: str\n\n\n@dataclass\nclass KnowledgeGap:\n    \"\"\"A gap in the research that affects conclusions.\"\"\"\n    gap_id: str\n    topic: str\n    description: str\n    importance: str  # critical, important, nice_to_have\n    impact_on_conclusions: str\n    suggested_query: str\n    related_findings: List[str]\n\n\n@dataclass\nclass RoleSummary:\n    \"\"\"Role-specific summary for a stakeholder type.\"\"\"\n    role: str  # cto, cfo, ceo, legal, product\n    role_title: str\n    headline: str\n    key_points: List[str]\n    action_items: List[str]\n    risks_to_watch: List[str]\n    metrics_of_interest: List[Dict[str, Any]]\n    confidence_level: str  # high, medium, low\n\n\nclass IntelligenceAnalyzer:\n    \"\"\"Analyzes findings for deeper insights.\"\"\"\n\n    def __init__(self, gemini_client=None):\n        self.gemini_client = gemini_client\n\n    async def analyze(\n        self,\n        findings: List[Dict[str, Any]],\n        perspectives: List[Dict[str, Any]],\n        sources: List[Dict[str, Any]],\n        query: str,\n        template: str,\n    ) -> Dict[str, Any]:\n        \"\"\"\n        Run full intelligence analysis on research results.\n\n        Returns:\n            Dict with 'contradictions', 'knowledge_gaps', 'role_summaries'\n        \"\"\"\n        results = {\n            \"contradictions\": [],\n            \"knowledge_gaps\": [],\n            \"role_summaries\": {},\n        }\n\n        # Run analyses\n        try:\n            contradictions = await self.detect_contradictions(findings)\n            results[\"contradictions\"] = [asdict(c) for c in contradictions]\n        except Exception as e:\n            logger.warning(f\"Contradiction detection failed: {e}\")\n\n        try:\n            gaps = await self.identify_knowledge_gaps(findings, perspectives, query, template)\n            results[\"knowledge_gaps\"] = [asdict(g) for g in gaps]\n        except Exception as e:\n            logger.warning(f\"Knowledge gap analysis failed: {e}\")\n\n        try:\n            summaries = await self.generate_role_summaries(findings, perspectives, query, template)\n            results[\"role_summaries\"] = {s.role: asdict(s) for s in summaries}\n        except Exception as e:\n            logger.warning(f\"Role summary generation failed: {e}\")\n\n        return results\n\n    async def detect_contradictions(\n        self,\n        findings: List[Dict[str, Any]],\n    ) -> List[Contradiction]:\n        \"\"\"\n        Detect contradictions between findings.\n\n        Looks for:\n        - Conflicting facts (A says X, B says not-X)\n        - Quantitative disagreements (A says 40%, B says 77%)\n        - Temporal inconsistencies (A says happened in 2024, B says 2023)\n        - Interpretive conflicts (A says bullish, B says bearish on same data)\n        \"\"\"\n        if len(findings) < 2:\n            return []\n\n        contradictions = []\n\n        # Group findings by topic for efficient comparison\n        # Compare findings pairwise for contradictions\n        for i, finding_a in enumerate(findings):\n            for j, finding_b in enumerate(findings[i + 1:], i + 1):\n                contradiction = self._check_contradiction(finding_a, finding_b)\n                if contradiction:\n                    contradictions.append(contradiction)\n\n        return contradictions\n\n    def _check_contradiction(\n        self,\n        finding_a: Dict[str, Any],\n        finding_b: Dict[str, Any],\n    ) -> Optional[Contradiction]:\n        \"\"\"Check if two findings contradict each other.\"\"\"\n        # Extract content and data\n        content_a = finding_a.get(\"content\", \"\").lower()\n        content_b = finding_b.get(\"content\", \"\").lower()\n        data_a = finding_a.get(\"extracted_data\", {}) or {}\n        data_b = finding_b.get(\"extracted_data\", {}) or {}\n\n        id_a = finding_a.get(\"finding_id\", \"f?\")\n        id_b = finding_b.get(\"finding_id\", \"f?\")\n        summary_a = finding_a.get(\"summary\", content_a[:100])\n        summary_b = finding_b.get(\"summary\", content_b[:100])\n\n        # Check for quantitative contradictions\n        quant_contradiction = self._check_quantitative_contradiction(data_a, data_b, finding_a, finding_b)\n        if quant_contradiction:\n            return Contradiction(\n                finding_a_id=id_a,\n                finding_a_summary=summary_a,\n                finding_b_id=id_b,\n                finding_b_summary=summary_b,\n                contradiction_type=\"quantitative\",\n                description=quant_contradiction[0],\n                severity=quant_contradiction[1],\n                resolution_hint=quant_contradiction[2],\n            )\n\n        # Check for temporal contradictions\n        temporal_contradiction = self._check_temporal_contradiction(finding_a, finding_b)\n        if temporal_contradiction:\n            return Contradiction(\n                finding_a_id=id_a,\n                finding_a_summary=summary_a,\n                finding_b_id=id_b,\n                finding_b_summary=summary_b,\n                contradiction_type=\"temporal\",\n                description=temporal_contradiction[0],\n                severity=temporal_contradiction[1],\n                resolution_hint=temporal_contradiction[2],\n            )\n\n        # Check for semantic contradictions (opposing sentiment on same topic)\n        semantic_contradiction = self._check_semantic_contradiction(content_a, content_b, data_a, data_b)\n        if semantic_contradiction:\n            return Contradiction(\n                finding_a_id=id_a,\n                finding_a_summary=summary_a,\n                finding_b_id=id_b,\n                finding_b_summary=summary_b,\n                contradiction_type=\"interpretive\",\n                description=semantic_contradiction[0],\n                severity=semantic_contradiction[1],\n                resolution_hint=semantic_contradiction[2],\n            )\n\n        return None\n\n    def _check_quantitative_contradiction(\n        self,\n        data_a: Dict,\n        data_b: Dict,\n        finding_a: Dict,\n        finding_b: Dict,\n    ) -> Optional[Tuple[str, str, str]]:\n        \"\"\"Check for conflicting numbers about the same metric.\"\"\"\n        # Common metrics to check\n        metric_keys = [\n            \"adoption_rate\", \"growth_percentage\", \"market_share\",\n            \"revenue\", \"subscribers\", \"users\", \"amount\", \"value\",\n            \"growth\", \"rate\", \"percentage\"\n        ]\n\n        for key in metric_keys:\n            val_a = data_a.get(key)\n            val_b = data_b.get(key)\n\n            if val_a and val_b:\n                # Extract numeric values\n                num_a = self._extract_number(str(val_a))\n                num_b = self._extract_number(str(val_b))\n\n                if num_a is not None and num_b is not None:\n                    # Check if they're about the same entity\n                    entity_a = data_a.get(\"technology\") or data_a.get(\"company\") or data_a.get(\"product\")\n                    entity_b = data_b.get(\"technology\") or data_b.get(\"company\") or data_b.get(\"product\")\n\n                    if entity_a and entity_b and entity_a.lower() == entity_b.lower():\n                        # Calculate difference\n                        diff = abs(num_a - num_b)\n                        avg = (num_a + num_b) / 2 if (num_a + num_b) > 0 else 1\n                        pct_diff = (diff / avg) * 100\n\n                        if pct_diff > 30:  # Significant difference\n                            severity = \"high\" if pct_diff > 50 else \"medium\"\n                            return (\n                                f\"Conflicting {key} for {entity_a}: {val_a} vs {val_b} ({pct_diff:.0f}% difference)\",\n                                severity,\n                                f\"Check source dates and methodologies. The difference may be due to different time periods or measurement criteria.\"\n                            )\n\n        return None\n\n    def _check_temporal_contradiction(\n        self,\n        finding_a: Dict,\n        finding_b: Dict,\n    ) -> Optional[Tuple[str, str, str]]:\n        \"\"\"Check for conflicting dates about the same event.\"\"\"\n        date_a = finding_a.get(\"date_referenced\") or finding_a.get(\"event_date\")\n        date_b = finding_b.get(\"date_referenced\") or finding_b.get(\"event_date\")\n\n        if not date_a or not date_b:\n            return None\n\n        # Check if findings are about the same event/topic\n        type_a = finding_a.get(\"finding_type\", \"\")\n        type_b = finding_b.get(\"finding_type\", \"\")\n\n        data_a = finding_a.get(\"extracted_data\", {}) or {}\n        data_b = finding_b.get(\"extracted_data\", {}) or {}\n\n        # Same type and same entity suggests same topic\n        if type_a == type_b:\n            entity_a = data_a.get(\"company\") or data_a.get(\"technology\") or data_a.get(\"product\")\n            entity_b = data_b.get(\"company\") or data_b.get(\"technology\") or data_b.get(\"product\")\n\n            if entity_a and entity_b and entity_a.lower() == entity_b.lower():\n                if date_a != date_b:\n                    return (\n                        f\"Conflicting dates for {entity_a}: {date_a} vs {date_b}\",\n                        \"medium\",\n                        f\"The sources may be referring to different events or updates. Check context.\"\n                    )\n\n        return None\n\n    def _check_semantic_contradiction(\n        self,\n        content_a: str,\n        content_b: str,\n        data_a: Dict,\n        data_b: Dict,\n    ) -> Optional[Tuple[str, str, str]]:\n        \"\"\"Check for opposing interpretations of the same topic.\"\"\"\n        # Look for opposing sentiment indicators\n        bullish_terms = [\"growth\", \"surge\", \"boom\", \"accelerat\", \"outperform\", \"strong\", \"positive\", \"bullish\"]\n        bearish_terms = [\"decline\", \"drop\", \"fall\", \"slow\", \"underperform\", \"weak\", \"negative\", \"bearish\"]\n\n        # Check if about same topic\n        entity_a = data_a.get(\"technology\") or data_a.get(\"company\") or \"\"\n        entity_b = data_b.get(\"technology\") or data_b.get(\"company\") or \"\"\n\n        if entity_a and entity_b and entity_a.lower() == entity_b.lower():\n            has_bullish_a = any(term in content_a for term in bullish_terms)\n            has_bearish_a = any(term in content_a for term in bearish_terms)\n            has_bullish_b = any(term in content_b for term in bullish_terms)\n            has_bearish_b = any(term in content_b for term in bearish_terms)\n\n            # Check for opposing sentiment\n            if (has_bullish_a and has_bearish_b) or (has_bearish_a and has_bullish_b):\n                return (\n                    f\"Conflicting assessments of {entity_a}: one source is optimistic, another pessimistic\",\n                    \"medium\",\n                    f\"Consider both perspectives. The truth may depend on timeframe, market segment, or use case.\"\n                )\n\n        return None\n\n    def _extract_number(self, text: str) -> Optional[float]:\n        \"\"\"Extract a number from text like '77%' or '$1.8M' or '1,000'.\"\"\"\n        import re\n\n        # Remove common formatting\n        text = text.replace(\",\", \"\").replace(\"$\", \"\").replace(\"%\", \"\")\n\n        # Handle M/B/K suffixes\n        multipliers = {\"m\": 1_000_000, \"b\": 1_000_000_000, \"k\": 1_000}\n        for suffix, mult in multipliers.items():\n            if text.lower().endswith(suffix):\n                text = text[:-1]\n                try:\n                    return float(text) * mult\n                except ValueError:\n                    pass\n\n        # Try direct parse\n        match = re.search(r'[\\d.]+', text)\n        if match:\n            try:\n                return float(match.group())\n            except ValueError:\n                pass\n\n        return None\n\n    async def identify_knowledge_gaps(\n        self,\n        findings: List[Dict[str, Any]],\n        perspectives: List[Dict[str, Any]],\n        query: str,\n        template: str,\n    ) -> List[KnowledgeGap]:\n        \"\"\"\n        Identify what we don't know that would affect conclusions.\n\n        Analyzes:\n        - Low-confidence findings that need more data\n        - Topics mentioned but not fully explored\n        - Missing data for key decisions\n        - Unanswered questions from perspectives\n        \"\"\"\n        gaps = []\n        gap_id = 1\n\n        # 1. Find low-confidence findings with high importance\n        for finding in findings:\n            confidence = finding.get(\"adjusted_confidence\") or finding.get(\"confidence_score\", 0.5)\n            finding_type = finding.get(\"finding_type\", \"\")\n\n            # Important types that need high confidence\n            critical_types = [\"prediction\", \"risk_factor\", \"red_flag\", \"earnings_metric\", \"valuation_signal\"]\n\n            if confidence < 0.6 and finding_type in critical_types:\n                summary = finding.get(\"summary\", \"\")[:100]\n                gaps.append(KnowledgeGap(\n                    gap_id=f\"g{gap_id}\",\n                    topic=f\"Uncertain: {finding_type.replace('_', ' ').title()}\",\n                    description=f\"Low confidence ({confidence:.0%}) on critical finding: {summary}\",\n                    importance=\"important\" if finding_type in [\"prediction\", \"earnings_metric\"] else \"critical\",\n                    impact_on_conclusions=\"This uncertainty directly affects key conclusions and recommendations\",\n                    suggested_query=f\"Additional sources for: {summary}\",\n                    related_findings=[finding.get(\"finding_id\", \"\")],\n                ))\n                gap_id += 1\n\n        # 2. Identify gaps from perspective warnings\n        for perspective in perspectives:\n            warnings = perspective.get(\"warnings\", [])\n            perspective_type = perspective.get(\"perspective_type\", \"\")\n\n            for warning in warnings:\n                if any(term in warning.lower() for term in [\"unknown\", \"unclear\", \"missing\", \"need more\", \"no data\"]):\n                    gaps.append(KnowledgeGap(\n                        gap_id=f\"g{gap_id}\",\n                        topic=f\"Expert Concern: {perspective_type.replace('_', ' ').title()}\",\n                        description=warning,\n                        importance=\"important\",\n                        impact_on_conclusions=f\"The {perspective_type.replace('_', ' ')} perspective flagged this uncertainty\",\n                        suggested_query=f\"Research to address: {warning[:80]}\",\n                        related_findings=[],\n                    ))\n                    gap_id += 1\n\n        # 3. Template-specific gap detection\n        template_gaps = self._get_template_specific_gaps(findings, template, query)\n        for gap_info in template_gaps:\n            gaps.append(KnowledgeGap(\n                gap_id=f\"g{gap_id}\",\n                **gap_info\n            ))\n            gap_id += 1\n\n        # 4. Check for missing finding types\n        if template == \"financial\":\n            expected_types = {\"earnings_metric\", \"valuation_signal\", \"risk_factor\", \"guidance\"}\n            found_types = {f.get(\"finding_type\") for f in findings}\n            missing = expected_types - found_types\n\n            if missing:\n                gaps.append(KnowledgeGap(\n                    gap_id=f\"g{gap_id}\",\n                    topic=\"Missing Financial Data\",\n                    description=f\"No findings for: {', '.join(t.replace('_', ' ') for t in missing)}\",\n                    importance=\"critical\",\n                    impact_on_conclusions=\"Investment analysis requires these data points for completeness\",\n                    suggested_query=f\"{query} {' '.join(missing)}\",\n                    related_findings=[],\n                ))\n                gap_id += 1\n\n        elif template == \"tech_market\":\n            expected_types = {\"adoption_trend\", \"prediction\", \"market_metric\"}\n            found_types = {f.get(\"finding_type\") for f in findings}\n            missing = expected_types - found_types\n\n            if missing:\n                gaps.append(KnowledgeGap(\n                    gap_id=f\"g{gap_id}\",\n                    topic=\"Missing Market Data\",\n                    description=f\"No findings for: {', '.join(t.replace('_', ' ') for t in missing)}\",\n                    importance=\"important\",\n                    impact_on_conclusions=\"Market analysis benefits from trend and adoption data\",\n                    suggested_query=f\"{query} market data statistics trends\",\n                    related_findings=[],\n                ))\n                gap_id += 1\n\n        return gaps[:10]  # Limit to top 10 gaps\n\n    def _get_template_specific_gaps(\n        self,\n        findings: List[Dict[str, Any]],\n        template: str,\n        query: str,\n    ) -> List[Dict[str, Any]]:\n        \"\"\"Get template-specific knowledge gaps.\"\"\"\n        gaps = []\n\n        # Check for common gaps based on template\n        if template == \"investigative\":\n            # Check for missing actor relationships\n            has_relationships = any(f.get(\"finding_type\") == \"relationship\" for f in findings)\n            if not has_relationships:\n                gaps.append({\n                    \"topic\": \"Missing Relationship Mapping\",\n                    \"description\": \"No relationship network data found between key actors\",\n                    \"importance\": \"critical\",\n                    \"impact_on_conclusions\": \"Understanding connections is crucial for investigative analysis\",\n                    \"suggested_query\": f\"{query} relationships connections network\",\n                    \"related_findings\": [],\n                })\n\n        elif template == \"competitive\":\n            # Check for pricing data\n            has_pricing = any(\"pricing\" in str(f.get(\"extracted_data\", {})).lower() for f in findings)\n            if not has_pricing:\n                gaps.append({\n                    \"topic\": \"Missing Pricing Comparison\",\n                    \"description\": \"No competitive pricing data available\",\n                    \"importance\": \"important\",\n                    \"impact_on_conclusions\": \"Pricing is key for competitive positioning analysis\",\n                    \"suggested_query\": f\"{query} pricing plans cost comparison\",\n                    \"related_findings\": [],\n                })\n\n        return gaps\n\n    async def generate_role_summaries(\n        self,\n        findings: List[Dict[str, Any]],\n        perspectives: List[Dict[str, Any]],\n        query: str,\n        template: str,\n    ) -> List[RoleSummary]:\n        \"\"\"\n        Generate role-specific summaries for different stakeholders.\n\n        Roles:\n        - CTO: Technical depth, integration effort, team readiness\n        - CFO: Cost analysis, ROI, budget impact\n        - CEO: Strategic fit, competitive position, market timing\n        \"\"\"\n        summaries = []\n\n        # Gather relevant data\n        all_insights = []\n        all_warnings = []\n        all_recommendations = []\n\n        for p in perspectives:\n            all_insights.extend(p.get(\"key_insights\", []))\n            all_warnings.extend(p.get(\"warnings\", []))\n            all_recommendations.extend(p.get(\"recommendations\", []))\n\n        # Calculate overall confidence\n        confidences = [f.get(\"adjusted_confidence\") or f.get(\"confidence_score\", 0.5) for f in findings]\n        avg_confidence = sum(confidences) / len(confidences) if confidences else 0.5\n        confidence_level = \"high\" if avg_confidence >= 0.75 else \"medium\" if avg_confidence >= 0.5 else \"low\"\n\n        # Generate CTO Summary\n        cto_summary = self._generate_cto_summary(findings, all_insights, all_warnings, all_recommendations, template, confidence_level)\n        summaries.append(cto_summary)\n\n        # Generate CFO Summary\n        cfo_summary = self._generate_cfo_summary(findings, all_insights, all_warnings, all_recommendations, template, confidence_level)\n        summaries.append(cfo_summary)\n\n        # Generate CEO Summary\n        ceo_summary = self._generate_ceo_summary(findings, all_insights, all_warnings, all_recommendations, template, confidence_level)\n        summaries.append(ceo_summary)\n\n        return summaries\n\n    def _generate_cto_summary(\n        self,\n        findings: List[Dict],\n        insights: List[str],\n        warnings: List[str],\n        recommendations: List[str],\n        template: str,\n        confidence_level: str,\n    ) -> RoleSummary:\n        \"\"\"Generate CTO-focused summary.\"\"\"\n        # Filter for technical insights\n        tech_keywords = [\"architecture\", \"integration\", \"api\", \"sdk\", \"developer\", \"engineering\", \"technical\",\n                         \"performance\", \"scalability\", \"security\", \"infrastructure\", \"code\", \"implementation\"]\n\n        tech_insights = [i for i in insights if any(kw in i.lower() for kw in tech_keywords)]\n        tech_warnings = [w for w in warnings if any(kw in w.lower() for kw in tech_keywords)]\n        tech_recs = [r for r in recommendations if any(kw in r.lower() for kw in tech_keywords)]\n\n        # Extract technical metrics\n        tech_metrics = []\n        for f in findings:\n            data = f.get(\"extracted_data\", {}) or {}\n            finding_type = f.get(\"finding_type\", \"\")\n\n            if finding_type in [\"product_launch\", \"adoption_trend\", \"enterprise_adoption\"]:\n                if data.get(\"technology\") or data.get(\"product\"):\n                    tech_metrics.append({\n                        \"metric\": data.get(\"technology\") or data.get(\"product\"),\n                        \"value\": data.get(\"adoption_rate\") or data.get(\"growth_percentage\") or \"N/A\",\n                        \"context\": f.get(\"analysis\") or f.get(\"summary\", \"\"),\n                    })\n\n        # Generate headline\n        headline = self._generate_headline(findings, \"technical\", template)\n\n        return RoleSummary(\n            role=\"cto\",\n            role_title=\"Chief Technology Officer\",\n            headline=headline,\n            key_points=tech_insights[:5] if tech_insights else [\"No specific technical insights extracted\"],\n            action_items=[\n                \"Evaluate technical integration requirements\",\n                \"Assess team readiness and skill gaps\",\n                \"Review security and compliance implications\",\n            ] + tech_recs[:2],\n            risks_to_watch=tech_warnings[:3] if tech_warnings else [\"Monitor for breaking changes\"],\n            metrics_of_interest=tech_metrics[:5],\n            confidence_level=confidence_level,\n        )\n\n    def _generate_cfo_summary(\n        self,\n        findings: List[Dict],\n        insights: List[str],\n        warnings: List[str],\n        recommendations: List[str],\n        template: str,\n        confidence_level: str,\n    ) -> RoleSummary:\n        \"\"\"Generate CFO-focused summary.\"\"\"\n        # Filter for financial insights\n        fin_keywords = [\"cost\", \"price\", \"revenue\", \"profit\", \"margin\", \"budget\", \"roi\", \"investment\",\n                        \"valuation\", \"earnings\", \"growth\", \"market\", \"funding\", \"capital\"]\n\n        fin_insights = [i for i in insights if any(kw in i.lower() for kw in fin_keywords)]\n        fin_warnings = [w for w in warnings if any(kw in w.lower() for kw in fin_keywords)]\n        fin_recs = [r for r in recommendations if any(kw in r.lower() for kw in fin_keywords)]\n\n        # Extract financial metrics\n        fin_metrics = []\n        for f in findings:\n            data = f.get(\"extracted_data\", {}) or {}\n            finding_type = f.get(\"finding_type\", \"\")\n\n            if finding_type in [\"funding_round\", \"earnings_metric\", \"market_metric\", \"valuation_signal\"]:\n                metric_name = data.get(\"company\") or data.get(\"metric_name\") or finding_type\n                metric_value = data.get(\"amount\") or data.get(\"revenue\") or data.get(\"value\")\n                if metric_value:\n                    fin_metrics.append({\n                        \"metric\": metric_name,\n                        \"value\": str(metric_value),\n                        \"context\": f.get(\"analysis\") or f.get(\"summary\", \"\"),\n                    })\n\n        # Generate headline\n        headline = self._generate_headline(findings, \"financial\", template)\n\n        return RoleSummary(\n            role=\"cfo\",\n            role_title=\"Chief Financial Officer\",\n            headline=headline,\n            key_points=fin_insights[:5] if fin_insights else [\"No specific financial insights extracted\"],\n            action_items=[\n                \"Evaluate budget implications\",\n                \"Assess ROI and payback period\",\n                \"Review vendor pricing and contracts\",\n            ] + fin_recs[:2],\n            risks_to_watch=fin_warnings[:3] if fin_warnings else [\"Monitor market pricing trends\"],\n            metrics_of_interest=fin_metrics[:5],\n            confidence_level=confidence_level,\n        )\n\n    def _generate_ceo_summary(\n        self,\n        findings: List[Dict],\n        insights: List[str],\n        warnings: List[str],\n        recommendations: List[str],\n        template: str,\n        confidence_level: str,\n    ) -> RoleSummary:\n        \"\"\"Generate CEO-focused summary.\"\"\"\n        # Filter for strategic insights\n        strat_keywords = [\"strategy\", \"competitive\", \"market\", \"position\", \"opportunity\", \"threat\",\n                          \"acquisition\", \"partnership\", \"leadership\", \"trend\", \"industry\", \"future\"]\n\n        strat_insights = [i for i in insights if any(kw in i.lower() for kw in strat_keywords)]\n        strat_warnings = [w for w in warnings if any(kw in w.lower() for kw in strat_keywords)]\n        strat_recs = [r for r in recommendations if any(kw in r.lower() for kw in strat_keywords)]\n\n        # Extract strategic metrics\n        strat_metrics = []\n        for f in findings:\n            data = f.get(\"extracted_data\", {}) or {}\n            finding_type = f.get(\"finding_type\", \"\")\n\n            if finding_type in [\"acquisition\", \"prediction\", \"market_metric\", \"adoption_trend\"]:\n                metric_name = data.get(\"company\") or data.get(\"technology\") or finding_type\n                metric_value = data.get(\"market_share\") or data.get(\"adoption_rate\") or data.get(\"growth_percentage\")\n                if metric_value:\n                    strat_metrics.append({\n                        \"metric\": metric_name,\n                        \"value\": str(metric_value),\n                        \"context\": f.get(\"analysis\") or f.get(\"summary\", \"\"),\n
[2026-01-30T09:08:24.050Z] [STDOUT] })\n\n        # Generate headline\n        headline = self._generate_headline(findings, \"strategic\", template)\n\n        return RoleSummary(\n            role=\"ceo\",\n            role_title=\"Chief Executive Officer\",\n            headline=headline,\n            key_points=strat_insights[:5] if strat_insights else [\"No specific strategic insights extracted\"],\n            action_items=[\n                \"Evaluate strategic fit with company direction\",\n                \"Assess competitive implications\",\n                \"Consider market timing for action\",\n            ] + strat_recs[:2],\n            risks_to_watch=strat_warnings[:3] if strat_warnings else [\"Monitor competitive landscape changes\"],\n            metrics_of_interest=strat_metrics[:5],\n            confidence_level=confidence_level,\n        )\n\n    def _generate_headline(\n        self,\n        findings: List[Dict],\n        focus: str,\n        template: str,\n    ) -> str:\n        \"\"\"Generate a headline for the role summary.\"\"\"\n        # Count finding types\n        prediction_count = sum(1 for f in findings if f.get(\"finding_type\") == \"prediction\")\n        high_conf_count = sum(1 for f in findings if (f.get(\"adjusted_confidence\") or f.get(\"confidence_score\", 0)) >= 0.8)\n\n        if focus == \"technical\":\n            if template == \"tech_market\":\n                return f\"Technology landscape analysis with {len(findings)} key findings, {high_conf_count} high-confidence\"\n            return f\"Technical assessment across {len(findings)} findings\"\n\n        elif focus == \"financial\":\n            if template == \"financial\":\n                return f\"Financial analysis: {len(findings)} data points, {high_conf_count} verified\"\n            return f\"Budget and ROI considerations from {len(findings)} findings\"\n\n        else:  # strategic\n            if prediction_count > 0:\n                return f\"Strategic outlook with {prediction_count} predictions across {len(findings)} findings\"\n            return f\"Strategic assessment: {len(findings)} findings, {high_conf_count} high-confidence\"\n","numLines":695,"startLine":1,"totalLines":695}}}
[2026-01-30T09:08:24.153Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GRKpewtU4SEETzi1KDhJQh","type":"tool_result","content":"     1→\"\"\"Bayesian confidence model for explainable AI confidence scores.\n     2→\n     3→This module implements a proper Bayesian inference model for calculating\n     4→confidence scores, making them interpretable and actionable. Instead of\n     5→ad-hoc additive adjustments, this uses proper probability propagation.\n     6→\n     7→Key concepts:\n     8→- P(finding is true) depends on P(source is credible)\n     9→- P(source is credible) depends on P(domain is authoritative)\n    10→- All probabilities are properly multiplied, not added\n    11→- Explanations are generated showing the reasoning chain\n    12→\"\"\"\n    13→\n    14→from dataclasses import dataclass, field\n    15→from typing import Any, Dict, List, Optional, Tuple\n    16→from enum import Enum\n    17→import math\n    18→\n    19→\n    20→class EvidenceType(Enum):\n    21→    \"\"\"Types of evidence that can affect confidence.\"\"\"\n    22→    SOURCE_CREDIBILITY = \"source_credibility\"\n    23→    CROSS_REFERENCE = \"cross_reference\"\n    24→    BIAS_DETECTION = \"bias_detection\"\n    25→    EXPERT_SANITY = \"expert_sanity\"\n    26→    CORROBORATION = \"corroboration\"\n    27→    CONTRADICTION = \"contradiction\"\n    28→\n    29→\n    30→@dataclass\n    31→class EvidenceNode:\n    32→    \"\"\"Represents a piece of evidence in the Bayesian network.\n    33→\n    34→    Each node has:\n    35→    - prior: Base probability before considering this evidence\n    36→    - likelihood: P(evidence | hypothesis is true)\n    37→    - marginal: P(evidence) - the probability of seeing this evidence\n    38→    - posterior: Calculated P(hypothesis | evidence)\n    39→    \"\"\"\n    40→    evidence_type: EvidenceType\n    41→    name: str\n    42→    prior: float\n    43→    likelihood: float\n    44→    marginal: float\n    45→    posterior: float = 0.0\n    46→    explanation: str = \"\"\n    47→    raw_data: Optional[Dict[str, Any]] = None\n    48→\n    49→    def __post_init__(self):\n    50→        \"\"\"Calculate posterior using Bayes' theorem.\"\"\"\n    51→        if self.marginal > 0:\n    52→            self.posterior = (self.likelihood * self.prior) / self.marginal\n    53→        else:\n    54→            self.posterior = self.prior\n    55→\n    56→    def to_dict(self) -> Dict[str, Any]:\n    57→        \"\"\"Convert to dictionary for serialization.\"\"\"\n    58→        return {\n    59→            \"evidence_type\": self.evidence_type.value,\n    60→            \"name\": self.name,\n    61→            \"prior\": round(self.prior, 4),\n    62→            \"likelihood\": round(self.likelihood, 4),\n    63→            \"marginal\": round(self.marginal, 4),\n    64→            \"posterior\": round(self.posterior, 4),\n    65→            \"explanation\": self.explanation,\n    66→        }\n    67→\n    68→\n    69→@dataclass\n    70→class ConfidenceExplanation:\n    71→    \"\"\"Structured explanation of how confidence was calculated.\"\"\"\n    72→\n    73→    base_confidence: float\n    74→    final_confidence: float\n    75→    evidence_chain: List[EvidenceNode] = field(default_factory=list)\n    76→    summary: str = \"\"\n    77→    what_would_increase: List[str] = field(default_factory=list)\n    78→    what_would_decrease: List[str] = field(default_factory=list)\n    79→\n    80→    def to_dict(self) -> Dict[str, Any]:\n    81→        \"\"\"Convert to dictionary for serialization.\"\"\"\n    82→        return {\n    83→            \"base_confidence\": round(self.base_confidence, 4),\n    84→            \"final_confidence\": round(self.final_confidence, 4),\n    85→            \"summary\": self.summary,\n    86→            \"evidence_chain\": [e.to_dict() for e in self.evidence_chain],\n    87→            \"what_would_increase\": self.what_would_increase,\n    88→            \"what_would_decrease\": self.what_would_decrease,\n    89→        }\n    90→\n    91→    def generate_narrative(self) -> str:\n    92→        \"\"\"Generate human-readable explanation of confidence.\"\"\"\n    93→        lines = []\n    94→        pct = lambda x: f\"{x*100:.0f}%\"\n    95→\n    96→        lines.append(f\"This finding has {pct(self.final_confidence)} confidence.\")\n    97→        lines.append(\"\")\n    98→        lines.append(\"Reasoning:\")\n    99→        lines.append(f\"  - Started with {pct(self.base_confidence)} base confidence\")\n   100→\n   101→        for evidence in self.evidence_chain:\n   102→            impact = evidence.posterior - evidence.prior\n   103→            direction = \"increased\" if impact > 0 else \"decreased\"\n   104→            lines.append(f\"  - {evidence.name}: {direction} to {pct(evidence.posterior)}\")\n   105→            if evidence.explanation:\n   106→                lines.append(f\"    ({evidence.explanation})\")\n   107→\n   108→        if self.what_would_increase:\n   109→            lines.append(\"\")\n   110→            lines.append(\"To increase confidence:\")\n   111→            for item in self.what_would_increase[:3]:\n   112→                lines.append(f\"  - {item}\")\n   113→\n   114→        if self.what_would_decrease:\n   115→            lines.append(\"\")\n   116→            lines.append(\"Factors that could lower confidence:\")\n   117→            for item in self.what_would_decrease[:3]:\n   118→                lines.append(f\"  - {item}\")\n   119→\n   120→        return \"\\n\".join(lines)\n   121→\n   122→\n   123→class BayesianConfidenceCalculator:\n   124→    \"\"\"Calculates confidence using Bayesian inference.\n   125→\n   126→    This replaces the additive adjustment model with proper probabilistic\n   127→    inference, making confidence scores interpretable and actionable.\n   128→    \"\"\"\n   129→\n   130→    # Domain authority priors - P(domain is authoritative)\n   131→    DOMAIN_AUTHORITY_PRIORS: Dict[str, float] = {\n   132→        # Highest authority - government and academic\n   133→        \"gov\": 0.95,\n   134→        \"edu\": 0.92,\n   135→        \"mil\": 0.93,\n   136→\n   137→        # High authority - major wire services and papers of record\n   138→        \"reuters.com\": 0.90,\n   139→        \"apnews.com\": 0.90,\n   140→        \"bbc.com\": 0.88,\n   141→        \"nytimes.com\": 0.87,\n   142→        \"wsj.com\": 0.88,\n   143→        \"ft.com\": 0.87,\n   144→        \"bloomberg.com\": 0.86,\n   145→        \"sec.gov\": 0.95,\n   146→\n   147→        # Medium-high authority - quality publications\n   148→        \"forbes.com\": 0.75,\n   149→        \"businessinsider.com\": 0.70,\n   150→        \"cnbc.com\": 0.72,\n   151→        \"marketwatch.com\": 0.70,\n   152→        \"washingtonpost.com\": 0.80,\n   153→        \"economist.com\": 0.85,\n   154→        \"nature.com\": 0.92,\n   155→        \"sciencedirect.com\": 0.88,\n   156→\n   157→        # Tech-focused high authority\n   158→        \"github.com\": 0.75,\n   159→        \"stackoverflow.com\": 0.70,\n   160→        \"arxiv.org\": 0.85,\n   161→        \"acm.org\": 0.88,\n   162→        \"ieee.org\": 0.88,\n   163→    }\n   164→\n   165→    # Default prior for unknown domains\n   166→    DEFAULT_DOMAIN_PRIOR = 0.50\n   167→\n   168→    def __init__(self):\n   169→        self.evidence_nodes: List[EvidenceNode] = []\n   170→\n   171→    def reset(self):\n   172→        \"\"\"Reset evidence chain for new calculation.\"\"\"\n   173→        self.evidence_nodes = []\n   174→\n   175→    def get_domain_authority(self, domain: str) -> Tuple[float, str]:\n   176→        \"\"\"Get domain authority prior probability.\n   177→\n   178→        Returns:\n   179→            Tuple of (probability, explanation)\n   180→        \"\"\"\n   181→        domain_lower = domain.lower()\n   182→\n   183→        # Check for exact match first\n   184→        if domain_lower in self.DOMAIN_AUTHORITY_PRIORS:\n   185→            prob = self.DOMAIN_AUTHORITY_PRIORS[domain_lower]\n   186→            return prob, f\"Known authoritative domain: {domain}\"\n   187→\n   188→        # Check for TLD-based matches\n   189→        for tld in [\"gov\", \"edu\", \"mil\"]:\n   190→            if domain_lower.endswith(f\".{tld}\"):\n   191→                prob = self.DOMAIN_AUTHORITY_PRIORS[tld]\n   192→                return prob, f\"Authoritative {tld.upper()} domain\"\n   193→\n   194→        # Check for partial domain matches\n   195→        for known_domain, prob in self.DOMAIN_AUTHORITY_PRIORS.items():\n   196→            if known_domain in domain_lower:\n   197→                return prob, f\"Associated with {known_domain}\"\n   198→\n   199→        return self.DEFAULT_DOMAIN_PRIOR, \"Unknown domain - using default prior\"\n   200→\n   201→    def calculate_source_credibility(\n   202→        self,\n   203→        source: Dict[str, Any],\n   204→    ) -> Tuple[float, EvidenceNode]:\n   205→        \"\"\"Calculate P(source is credible) using Bayesian inference.\n   206→\n   207→        The model:\n   208→        - P(credible | domain) = P(domain authoritative) * P(content quality)\n   209→        - Domain authority is a strong prior\n   210→        - Content indicators can adjust\n   211→\n   212→        Returns:\n   213→            Tuple of (credibility_score, evidence_node)\n   214→        \"\"\"\n   215→        domain = source.get(\"domain\", \"\")\n   216→\n   217→        # Get domain authority as prior\n   218→        domain_prior, domain_explanation = self.get_domain_authority(domain)\n   219→\n   220→        # Estimate content quality likelihood from available signals\n   221→        # P(quality content | source is credible) vs P(quality content | not credible)\n   222→        content_signals = self._assess_content_signals(source)\n   223→\n   224→        # Calculate using simplified Bayesian update\n   225→        # P(credible | signals) = P(signals | credible) * P(credible) / P(signals)\n   226→        likelihood_if_credible = content_signals\n   227→        likelihood_if_not_credible = 1 - content_signals\n   228→\n   229→        # Marginal: P(signals) = P(signals|credible)*P(credible) + P(signals|not)*P(not)\n   230→        marginal = (\n   231→            likelihood_if_credible * domain_prior +\n   232→            likelihood_if_not_credible * (1 - domain_prior)\n   233→        )\n   234→\n   235→        # Posterior: P(credible | signals)\n   236→        if marginal > 0:\n   237→            posterior = (likelihood_if_credible * domain_prior) / marginal\n   238→        else:\n   239→            posterior = domain_prior\n   240→\n   241→        # Clamp to reasonable range\n   242→        posterior = max(0.1, min(0.95, posterior))\n   243→\n   244→        evidence = EvidenceNode(\n   245→            evidence_type=EvidenceType.SOURCE_CREDIBILITY,\n   246→            name=f\"Source: {domain}\",\n   247→            prior=domain_prior,\n   248→            likelihood=likelihood_if_credible,\n   249→            marginal=marginal,\n   250→            posterior=posterior,\n   251→            explanation=domain_explanation,\n   252→            raw_data={\"domain\": domain, \"content_signals\": content_signals}\n   253→        )\n   254→\n   255→        return posterior, evidence\n   256→\n   257→    def _assess_content_signals(self, source: Dict[str, Any]) -> float:\n   258→        \"\"\"Assess content quality signals from source metadata.\n   259→\n   260→        Returns probability that content is high quality given observable signals.\n   261→        \"\"\"\n   262→        signals_score = 0.5  # Start at neutral\n   263→\n   264→        title = source.get(\"title\", \"\")\n   265→        snippet = source.get(\"snippet\", \"\")\n   266→        source_type = source.get(\"source_type\", \"web\")\n   267→\n   268→        # Title quality signals\n   269→        if title:\n   270→            # Longer, descriptive titles tend to be higher quality\n   271→            if len(title) > 30:\n   272→                signals_score += 0.05\n   273→            if len(title) > 60:\n   274→                signals_score += 0.05\n   275→\n   276→            # Marketing language is a negative signal\n   277→            marketing_words = [\"best\", \"top\", \"amazing\", \"revolutionary\", \"guaranteed\"]\n   278→            if any(w in title.lower() for w in marketing_words):\n   279→                signals_score -= 0.10\n   280→\n   281→        # Snippet quality signals\n   282→        if snippet:\n   283→            # Substantive snippets suggest better content\n   284→            if len(snippet) > 100:\n   285→                signals_score += 0.05\n   286→\n   287→            # Contains numbers/data (suggests factual content)\n   288→            if any(c.isdigit() for c in snippet):\n   289→                signals_score += 0.05\n   290→\n   291→        # Source type signals\n   292→        if source_type == \"academic\":\n   293→            signals_score += 0.15\n   294→        elif source_type == \"news\":\n   295→            signals_score += 0.05\n   296→        elif source_type == \"blog\":\n   297→            signals_score -= 0.05\n   298→        elif source_type == \"social\":\n   299→            signals_score -= 0.10\n   300→\n   301→        return max(0.1, min(0.9, signals_score))\n   302→\n   303→    def calculate_finding_confidence(\n   304→        self,\n   305→        finding: Dict[str, Any],\n   306→        sources: List[Dict[str, Any]],\n   307→        verification: Optional[Dict[str, Any]] = None,\n   308→    ) -> Tuple[float, ConfidenceExplanation]:\n   309→        \"\"\"Calculate P(finding is true) using full Bayesian network.\n   310→\n   311→        The network structure:\n   312→        - P(finding true) depends on P(sources credible)\n   313→        - Multiple credible sources increase confidence (corroboration)\n   314→        - Bias detection decreases confidence\n   315→        - Expert sanity check can increase or decrease\n   316→\n   317→        Returns:\n   318→            Tuple of (confidence_score, explanation)\n   319→        \"\"\"\n   320→        self.reset()\n   321→\n   322→        # Start with base confidence from finding extraction\n   323→        base_confidence = finding.get(\"confidence_score\", 0.5)\n   324→\n   325→        # Track cumulative probability\n   326→        current_confidence = base_confidence\n   327→\n   328→        # Phase 1: Source credibility\n   329→        # P(finding | sources) = product of P(source_i credible) for corroborating sources\n   330→        source_posteriors = []\n   331→        for source in sources[:5]:  # Limit to top 5 sources\n   332→            cred_score, evidence = self.calculate_source_credibility(source)\n   333→            source_posteriors.append(cred_score)\n   334→            self.evidence_nodes.append(evidence)\n   335→\n   336→        if source_posteriors:\n   337→            # Combine source credibilities using Bayesian combination\n   338→            # Multiple agreeing sources increase confidence\n   339→            combined_source_cred = self._combine_source_credibilities(source_posteriors)\n   340→\n   341→            # Update confidence based on source credibility\n   342→            # P(finding | sources) = P(finding) * adjustment_factor\n   343→            source_adjustment = self._calculate_source_adjustment(\n   344→                base_confidence, combined_source_cred\n   345→            )\n   346→            current_confidence = source_adjustment\n   347→\n   348→            self.evidence_nodes.append(EvidenceNode(\n   349→                evidence_type=EvidenceType.CORROBORATION,\n   350→                name=\"Source Agreement\",\n   351→                prior=base_confidence,\n   352→                likelihood=combined_source_cred,\n   353→                marginal=0.5,  # Neutral marginal\n   354→                posterior=current_confidence,\n   355→                explanation=f\"Combined credibility from {len(source_posteriors)} sources\"\n   356→            ))\n   357→\n   358→        # Phase 2: Verification adjustments\n   359→        if verification:\n   360→            current_confidence = self._apply_verification_evidence(\n   361→                current_confidence, verification\n   362→            )\n   363→\n   364→        # Generate explanation\n   365→        explanation = self._generate_explanation(\n   366→            base_confidence, current_confidence, finding, sources\n   367→        )\n   368→\n   369→        # Clamp final result\n   370→        final_confidence = max(0.1, min(0.95, current_confidence))\n   371→        explanation.final_confidence = final_confidence\n   372→\n   373→        return final_confidence, explanation\n   374→\n   375→    def _combine_source_credibilities(self, credibilities: List[float]) -> float:\n   376→        \"\"\"Combine multiple source credibilities using Bayesian update.\n   377→\n   378→        Multiple independent credible sources increase confidence:\n   379→        P(true | source1, source2) > P(true | source1) if source2 corroborates\n   380→\n   381→        We use a log-odds model for combining evidence.\n   382→        \"\"\"\n   383→        if not credibilities:\n   384→            return 0.5\n   385→\n   386→        if len(credibilities) == 1:\n   387→            return credibilities[0]\n   388→\n   389→        # Convert to log-odds and sum\n   390→        log_odds = []\n   391→        for p in credibilities:\n   392→            # Clamp to avoid log(0)\n   393→            p = max(0.01, min(0.99, p))\n   394→            log_odds.append(math.log(p / (1 - p)))\n   395→\n   396→        # Average log-odds (for independent evidence this is additive)\n   397→        # But we use a weighted average with diminishing returns\n   398→        # First source has full weight, subsequent sources have reduced weight\n   399→        weights = [1.0 / (i + 1) for i in range(len(log_odds))]\n   400→        total_weight = sum(weights)\n   401→        weighted_log_odds = sum(lo * w for lo, w in zip(log_odds, weights)) / total_weight\n   402→\n   403→        # Convert back to probability\n   404→        combined = 1 / (1 + math.exp(-weighted_log_odds))\n   405→\n   406→        # Apply bonus for multiple sources (corroboration boost)\n   407→        if len(credibilities) >= 3:\n   408→            combined = combined * 1.05  # 5% boost for 3+ sources\n   409→        if len(credibilities) >= 5:\n   410→            combined = combined * 1.05  # Additional 5% boost for 5+ sources\n   411→\n   412→        return min(0.95, combined)\n   413→\n   414→    def _calculate_source_adjustment(\n   415→        self,\n   416→        base_confidence: float,\n   417→        source_credibility: float\n   418→    ) -> float:\n   419→        \"\"\"Calculate adjusted confidence based on source credibility.\n   420→\n   421→        Uses a Bayesian update where source credibility affects our belief\n   422→        in the finding being true.\n   423→        \"\"\"\n   424→        # P(finding | sources) = P(sources support finding | finding true) * P(finding) / P(sources support)\n   425→        # Simplified: we weight the base confidence by source credibility\n   426→\n   427→        # If sources are highly credible, pull confidence toward their level\n   428→        # If sources are low credibility, pull down\n   429→\n   430→        # Weight based on how much evidence we have\n   431→        weight = 0.4  # How much source credibility affects the final score\n   432→\n   433→        adjusted = (1 - weight) * base_confidence + weight * source_credibility\n   434→\n   435→        return adjusted\n   436→\n   437→    def _apply_verification_evidence(\n   438→        self,\n   439→        current_confidence: float,\n   440→        verification: Dict[str, Any],\n   441→    ) -> float:\n   442→        \"\"\"Apply verification results using Bayesian updates.\n   443→\n   444→        Unlike additive adjustments, we use proper probability updates.\n   445→        \"\"\"\n   446→        confidence = current_confidence\n   447→\n   448→        # Bias detection evidence\n   449→        if \"bias\" in verification:\n   450→            bias = verification[\"bias\"]\n   451→            bias_score = bias.get(\"bias_score\", 0.0)\n   452→\n   453→            if bias_score > 0.3:\n   454→                # High bias detected - this is evidence against the finding\n   455→                # P(finding true | bias detected) = P(bias | true) * P(true) / P(bias)\n   456→                # If source is biased, less likely finding is objective truth\n   457→\n   458→                # Likelihood ratio: P(bias | finding true) / P(bias | finding false)\n   459→                # Biased sources more likely to push false narratives\n   460→                likelihood_ratio = 0.7 - (bias_score * 0.4)  # 0.3 to 0.7\n   461→\n   462→                confidence = self._bayesian_update(\n   463→                    prior=confidence,\n   464→                    likelihood_ratio=likelihood_ratio\n   465→                )\n   466→\n   467→                self.evidence_nodes.append(EvidenceNode(\n   468→                    evidence_type=EvidenceType.BIAS_DETECTION,\n   469→                    name=\"Bias Detection\",\n   470→                    prior=current_confidence,\n   471→                    likelihood=likelihood_ratio,\n   472→                    marginal=0.5,\n   473→                    posterior=confidence,\n   474→                    explanation=f\"Bias score: {bias_score:.2f} - {bias.get('bias_type', 'unknown')}\",\n   475→                    raw_data=bias\n   476→                ))\n   477→\n   478→        # Expert sanity check evidence\n   479→        if \"expert_check\" in verification:\n   480→            expert = verification[\"expert_check\"]\n   481→            plausibility = expert.get(\"plausibility\", \"plausible\")\n   482→            plausibility_score = expert.get(\"plausibility_score\", 0.7)\n   483→\n   484→            # Expert judgment provides strong evidence\n   485→            if plausibility == \"implausible\":\n   486→                # Strong evidence against\n   487→                likelihood_ratio = 0.3\n   488→                explanation = \"Expert assessment: claim is implausible\"\n   489→            elif plausibility == \"questionable\":\n   490→                # Moderate evidence against\n   491→                likelihood_ratio = 0.6\n   492→                explanation = \"Expert assessment: claim is questionable\"\n   493→            else:\n   494→                # Slight positive evidence\n   495→                likelihood_ratio = 1.0 + (plausibility_score - 0.7) * 0.3\n   496→                explanation = f\"Expert assessment: claim is plausible ({plausibility_score:.0%})\"\n   497→\n   498→            prior = confidence\n   499→            confidence = self._bayesian_update(\n   500→                prior=confidence,\n   501→                likelihood_ratio=likelihood_ratio\n   502→            )\n   503→\n   504→            self.evidence_nodes.append(EvidenceNode(\n   505→                evidence_type=EvidenceType.EXPERT_SANITY,\n   506→                name=\"Expert Sanity Check\",\n   507→                prior=prior,\n   508→                likelihood=likelihood_ratio if likelihood_ratio <= 1 else 1/likelihood_ratio,\n   509→                marginal=0.5,\n   510→                posterior=confidence,\n   511→                explanation=explanation,\n   512→                raw_data=expert\n   513→            ))\n   514→\n   515→            # Flag extraordinary claims\n   516→            if expert.get(\"extraordinary_claim\", False):\n   517→                # Extraordinary claims require extraordinary evidence\n   518→                confidence = confidence * 0.85\n   519→                self.evidence_nodes.append(EvidenceNode(\n   520→                    evidence_type=EvidenceType.EXPERT_SANITY,\n   521→                    name=\"Extraordinary Claim Flag\",\n   522→                    prior=confidence / 0.85,\n   523→                    likelihood=0.85,\n   524→                    marginal=0.5,\n   525→                    posterior=confidence,\n   526→                    explanation=\"Extraordinary claim requires stronger evidence\"\n   527→                ))\n   528→\n   529→        # Cross-reference evidence\n   530→        if \"cross_reference\" in verification:\n   531→            cross_ref = verification[\"cross_reference\"]\n   532→            corroboration = cross_ref.get(\"corroboration_level\", \"unknown\")\n   533→\n   534→            # Cross-reference provides corroboration evidence\n   535→            corroboration_map = {\n   536→                \"strong\": 1.3,      # Strong positive evidence\n   537→                \"moderate\": 1.1,    # Moderate positive\n   538→                \"weak\": 0.95,       # Slight negative\n   539→                \"uncorroborated\": 0.8,  # No corroboration is weak negative\n   540→                \"unknown\": 1.0      # Neutral\n   541→            }\n   542→\n   543→            likelihood_ratio = corroboration_map.get(corroboration, 1.0)\n   544→\n   545→            # Check for contradictions\n   546→            contradictions = cross_ref.get(\"contradicting_findings\", [])\n   547→            if contradictions:\n   548→                # Each contradiction is evidence against\n   549→                likelihood_ratio *= (0.9 ** len(contradictions))\n   550→\n   551→            prior = confidence\n   552→            confidence = self._bayesian_update(\n   553→                prior=confidence,\n   554→                likelihood_ratio=likelihood_ratio\n   555→            )\n   556→\n   557→            explanation = f\"Cross-reference: {corroboration}\"\n   558→            if contradictions:\n   559→                explanation += f\" ({len(contradictions)} contradictions)\"\n   560→\n   561→            self.evidence_nodes.append(EvidenceNode(\n   562→                evidence_type=EvidenceType.CROSS_REFERENCE,\n   563→                name=\"Cross-Reference Analysis\",\n   564→                prior=prior,\n   565→                likelihood=min(1.0, likelihood_ratio),\n   566→                marginal=0.5,\n   567→                posterior=confidence,\n   568→                explanation=explanation,\n   569→                raw_data=cross_ref\n   570→            ))\n   571→\n   572→        return confidence\n   573→\n   574→    def _bayesian_update(\n   575→        self,\n   576→        prior: float,\n   577→        likelihood_ratio: float,\n   578→    ) -> float:\n   579→        \"\"\"Apply Bayesian update using likelihood ratio.\n   580→\n   581→        posterior_odds = likelihood_ratio * prior_odds\n   582→\n   583→        Args:\n   584→            prior: Prior probability P(H)\n   585→            likelihood_ratio: P(E|H) / P(E|not H)\n   586→\n   587→        Returns:\n   588→            Posterior probability P(H|E)\n   589→        \"\"\"\n   590→        # Convert to odds\n   591→        if prior >= 0.99:\n   592→            prior = 0.99\n   593→        if prior <= 0.01:\n   594→            prior = 0.01\n   595→\n   596→        prior_odds = prior / (1 - prior)\n   597→\n   598→        # Update odds\n   599→        posterior_odds = likelihood_ratio * prior_odds\n   600→\n   601→        # Convert back to probability\n   602→        posterior = posterior_odds / (1 + posterior_odds)\n   603→\n   604→        return max(0.1, min(0.95, posterior))\n   605→\n   606→    def _generate_explanation(\n   607→        self,\n   608→        base_confidence: float,\n   609→        final_confidence: float,\n   610→        finding: Dict[str, Any],\n   611→        sources: List[Dict[str, Any]],\n   612→    ) -> ConfidenceExplanation:\n   613→        \"\"\"Generate structured explanation of confidence calculation.\"\"\"\n   614→\n   615→        # Determine what would increase confidence\n   616→        what_would_increase = []\n   617→        what_would_decrease = []\n   618→\n   619→        # Check source diversity\n   620→        domains = set(s.get(\"domain\", \"\") for s in sources)\n   621→        if len(domains) < 3:\n   622→            what_would_increase.append(\n   623→                \"Additional corroborating sources from different domains\"\n   624→            )\n   625→\n   626→        # Check for high-authority sources\n   627→        high_auth_count = sum(\n   628→            1 for s in sources\n   629→            if self.get_domain_authority(s.get(\"domain\", \"\"))[0] > 0.8\n   630→        )\n   631→        if high_auth_count < 2:\n   632→            what_would_increase.append(\n   633→                \"Citations from authoritative sources (academic, government, major publications)\"\n   634→            )\n   635→\n   636→        # Check verification status\n   637→        for node in self.evidence_nodes:\n   638→            if node.evidence_type == EvidenceType.BIAS_DETECTION:\n   639→                if node.posterior < node.prior:\n   640→                    what_would_decrease.append(\n   641→                        f\"Bias detected: {node.explanation}\"\n   642→                    )\n   643→            if node.evidence_type == EvidenceType.EXPERT_SANITY:\n   644→                if \"implausible\" in node.explanation.lower():\n   645→                    what_would_decrease.append(\n   646→                        \"Expert assessment flagged claim as implausible\"\n   647→                    )\n   648→                elif \"questionable\" in node.explanation.lower():\n   649→                    what_would_decrease.append(\n   650→                        \"Expert assessment flagged claim as questionable\"\n   651→                    )\n   652→\n   653→        # Add general factors\n   654→        if final_confidence < 0.7:\n   655→            what_would_increase.append(\n   656→                \"Verification by independent fact-checking\"\n   657→            )\n   658→\n   659→        if final_confidence > 0.8:\n   660→            what_would_decrease.append(\n   661→                \"Discovery of conflicting evidence or retractions\"\n   662→            )\n   663→\n   664→        # Generate summary\n   665→        pct = lambda x: f\"{x*100:.0f}%\"\n   666→\n   667→        if final_confidence >= base_confidence + 0.1:\n   668→            summary = (\n   669→                f\"Confidence increased from {pct(base_confidence)} to {pct(final_confidence)} \"\n   670→                f\"due to corroborating evidence from credible sources.\"\n   671→            )\n   672→        elif final_confidence <= base_confidence - 0.1:\n   673→            summary = (\n   674→                f\"Confidence decreased from {pct(base_confidence)} to {pct(final_confidence)} \"\n   675→                f\"due to verification concerns (bias, plausibility, or lack of corroboration).\"\n   676→            )\n   677→        else:\n   678→            summary = (\n   679→                f\"Confidence of {pct(final_confidence)} reflects balanced evidence \"\n   680→                f\"from the available sources and verification checks.\"\n   681→            )\n   682→\n   683→        return ConfidenceExplanation(\n   684→            base_confidence=base_confidence,\n   685→            final_confidence=final_confidence,\n   686→            evidence_chain=self.evidence_nodes.copy(),\n   687→            summary=summary,\n   688→            what_would_increase=what_would_increase[:5],\n   689→            what_would_decrease=what_would_decrease[:5],\n   690→        )\n   691→\n   692→\n   693→def calculate_bayesian_confidence(\n   694→    finding: Dict[str, Any],\n   695→    sources: List[Dict[str, Any]],\n   696→    verification: Optional[Dict[str, Any]] = None,\n   697→) -> Tuple[float, ConfidenceExplanation]:\n   698→    \"\"\"Convenience function for calculating Bayesian confidence.\n   699→\n   700→    Args:\n   701→        finding: Finding dictionary with confidence_score\n   702→        sources: List of source dictionaries\n   703→        verification: Optional verification results\n   704→\n   705→    Returns:\n   706→        Tuple of (confidence_score, explanation)\n   707→    \"\"\"\n   708→    calculator = BayesianConfidenceCalculator()\n   709→    return calculator.calculate_finding_confidence(finding, sources, verification)\n   710→\n   711→\n   712→def calculate_source_credibility(source: Dict[str, Any]) -> Tuple[float, str]:\n   713→    \"\"\"Calculate credibility score for a single source.\n   714→\n   715→    Returns:\n   716→        Tuple of (credibility_score, explanation_string)\n   717→    \"\"\"\n   718→    calculator = BayesianConfidenceCalculator()\n   719→    score, evidence = calculator.calculate_source_credibility(source)\n   720→    return score, evidence.explanation\n   721→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"34eb5170-c9bb-41ec-b332-c49ff6c57668","uuid":"698a7661-a912-4e6e-a5db-e2af4312f48e","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\actor\\src\\services\\bayesian_confidence.py","content":"\"\"\"Bayesian confidence model for explainable AI confidence scores.\n\nThis module implements a proper Bayesian inference model for calculating\nconfidence scores, making them interpretable and actionable. Instead of\nad-hoc additive adjustments, this uses proper probability propagation.\n\nKey concepts:\n- P(finding is true) depends on P(source is credible)\n- P(source is credible) depends on P(domain is authoritative)\n- All probabilities are properly multiplied, not added\n- Explanations are generated showing the reasoning chain\n\"\"\"\n\nfrom dataclasses import dataclass, field\nfrom typing import Any, Dict, List, Optional, Tuple\nfrom enum import Enum\nimport math\n\n\nclass EvidenceType(Enum):\n    \"\"\"Types of evidence that can affect confidence.\"\"\"\n    SOURCE_CREDIBILITY = \"source_credibility\"\n    CROSS_REFERENCE = \"cross_reference\"\n    BIAS_DETECTION = \"bias_detection\"\n    EXPERT_SANITY = \"expert_sanity\"\n    CORROBORATION = \"corroboration\"\n    CONTRADICTION = \"contradiction\"\n\n\n@dataclass\nclass EvidenceNode:\n    \"\"\"Represents a piece of evidence in the Bayesian network.\n\n    Each node has:\n    - prior: Base probability before considering this evidence\n    - likelihood: P(evidence | hypothesis is true)\n    - marginal: P(evidence) - the probability of seeing this evidence\n    - posterior: Calculated P(hypothesis | evidence)\n    \"\"\"\n    evidence_type: EvidenceType\n    name: str\n    prior: float\n    likelihood: float\n    marginal: float\n    posterior: float = 0.0\n    explanation: str = \"\"\n    raw_data: Optional[Dict[str, Any]] = None\n\n    def __post_init__(self):\n        \"\"\"Calculate posterior using Bayes' theorem.\"\"\"\n        if self.marginal > 0:\n            self.posterior = (self.likelihood * self.prior) / self.marginal\n        else:\n            self.posterior = self.prior\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Convert to dictionary for serialization.\"\"\"\n        return {\n            \"evidence_type\": self.evidence_type.value,\n            \"name\": self.name,\n            \"prior\": round(self.prior, 4),\n            \"likelihood\": round(self.likelihood, 4),\n            \"marginal\": round(self.marginal, 4),\n            \"posterior\": round(self.posterior, 4),\n            \"explanation\": self.explanation,\n        }\n\n\n@dataclass\nclass ConfidenceExplanation:\n    \"\"\"Structured explanation of how confidence was calculated.\"\"\"\n\n    base_confidence: float\n    final_confidence: float\n    evidence_chain: List[EvidenceNode] = field(default_factory=list)\n    summary: str = \"\"\n    what_would_increase: List[str] = field(default_factory=list)\n    what_would_decrease: List[str] = field(default_factory=list)\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Convert to dictionary for serialization.\"\"\"\n        return {\n            \"base_confidence\": round(self.base_confidence, 4),\n            \"final_confidence\": round(self.final_confidence, 4),\n            \"summary\": self.summary,\n            \"evidence_chain\": [e.to_dict() for e in self.evidence_chain],\n            \"what_would_increase\": self.what_would_increase,\n            \"what_would_decrease\": self.what_would_decrease,\n        }\n\n    def generate_narrative(self) -> str:\n        \"\"\"Generate human-readable explanation of confidence.\"\"\"\n        lines = []\n        pct = lambda x: f\"{x*100:.0f}%\"\n\n        lines.append(f\"This finding has {pct(self.final_confidence)} confidence.\")\n        lines.append(\"\")\n        lines.append(\"Reasoning:\")\n        lines.append(f\"  - Started with {pct(self.base_confidence)} base confidence\")\n\n        for evidence in self.evidence_chain:\n            impact = evidence.posterior - evidence.prior\n            direction = \"increased\" if impact > 0 else \"decreased\"\n            lines.append(f\"  - {evidence.name}: {direction} to {pct(evidence.posterior)}\")\n            if evidence.explanation:\n                lines.append(f\"    ({evidence.explanation})\")\n\n        if self.what_would_increase:\n            lines.append(\"\")\n            lines.append(\"To increase confidence:\")\n            for item in self.what_would_increase[:3]:\n                lines.append(f\"  - {item}\")\n\n        if self.what_would_decrease:\n            lines.append(\"\")\n            lines.append(\"Factors that could lower confidence:\")\n            for item in self.what_would_decrease[:3]:\n                lines.append(f\"  - {item}\")\n\n        return \"\\n\".join(lines)\n\n\nclass BayesianConfidenceCalculator:\n    \"\"\"Calculates confidence using Bayesian inference.\n\n    This replaces the additive adjustment model with proper probabilistic\n    inference, making confidence scores interpretable and actionable.\n    \"\"\"\n\n    # Domain authority priors - P(domain is authoritative)\n    DOMAIN_AUTHORITY_PRIORS: Dict[str, float] = {\n        # Highest authority - government and academic\n        \"gov\": 0.95,\n        \"edu\": 0.92,\n        \"mil\": 0.93,\n\n        # High authority - major wire services and papers of record\n        \"reuters.com\": 0.90,\n        \"apnews.com\": 0.90,\n        \"bbc.com\": 0.88,\n        \"nytimes.com\": 0.87,\n        \"wsj.com\": 0.88,\n        \"ft.com\": 0.87,\n        \"bloomberg.com\": 0.86,\n        \"sec.gov\": 0.95,\n\n        # Medium-high authority - quality publications\n        \"forbes.com\": 0.75,\n        \"businessinsider.com\": 0.70,\n        \"cnbc.com\": 0.72,\n        \"marketwatch.com\": 0.70,\n        \"washingtonpost.com\": 0.80,\n        \"economist.com\": 0.85,\n        \"nature.com\": 0.92,\n        \"sciencedirect.com\": 0.88,\n\n        # Tech-focused high authority\n        \"github.com\": 0.75,\n        \"stackoverflow.com\": 0.70,\n        \"arxiv.org\": 0.85,\n        \"acm.org\": 0.88,\n        \"ieee.org\": 0.88,\n    }\n\n    # Default prior for unknown domains\n    DEFAULT_DOMAIN_PRIOR = 0.50\n\n    def __init__(self):\n        self.evidence_nodes: List[EvidenceNode] = []\n\n    def reset(self):\n        \"\"\"Reset evidence chain for new calculation.\"\"\"\n        self.evidence_nodes = []\n\n    def get_domain_authority(self, domain: str) -> Tuple[float, str]:\n        \"\"\"Get domain authority prior probability.\n\n        Returns:\n            Tuple of (probability, explanation)\n        \"\"\"\n        domain_lower = domain.lower()\n\n        # Check for exact match first\n        if domain_lower in self.DOMAIN_AUTHORITY_PRIORS:\n            prob = self.DOMAIN_AUTHORITY_PRIORS[domain_lower]\n            return prob, f\"Known authoritative domain: {domain}\"\n\n        # Check for TLD-based matches\n        for tld in [\"gov\", \"edu\", \"mil\"]:\n            if domain_lower.endswith(f\".{tld}\"):\n                prob = self.DOMAIN_AUTHORITY_PRIORS[tld]\n                return prob, f\"Authoritative {tld.upper()} domain\"\n\n        # Check for partial domain matches\n        for known_domain, prob in self.DOMAIN_AUTHORITY_PRIORS.items():\n            if known_domain in domain_lower:\n                return prob, f\"Associated with {known_domain}\"\n\n        return self.DEFAULT_DOMAIN_PRIOR, \"Unknown domain - using default prior\"\n\n    def calculate_source_credibility(\n        self,\n        source: Dict[str, Any],\n    ) -> Tuple[float, EvidenceNode]:\n        \"\"\"Calculate P(source is credible) using Bayesian inference.\n\n        The model:\n        - P(credible | domain) = P(domain authoritative) * P(content quality)\n        - Domain authority is a strong prior\n        - Content indicators can adjust\n\n        Returns:\n            Tuple of (credibility_score, evidence_node)\n        \"\"\"\n        domain = source.get(\"domain\", \"\")\n\n        # Get domain authority as prior\n        domain_prior, domain_explanation = self.get_domain_authority(domain)\n\n        # Estimate content quality likelihood from available signals\n        # P(quality content | source is credible) vs P(quality content | not credible)\n        content_signals = self._assess_content_signals(source)\n\n        # Calculate using simplified Bayesian update\n        # P(credible | signals) = P(signals | credible) * P(credible) / P(signals)\n        likelihood_if_credible = content_signals\n        likelihood_if_not_credible = 1 - content_signals\n\n        # Marginal: P(signals) = P(signals|credible)*P(credible) + P(signals|not)*P(not)\n        marginal = (\n            likelihood_if_credible * domain_prior +\n            likelihood_if_not_credible * (1 - domain_prior)\n        )\n\n        # Posterior: P(credible | signals)\n        if marginal > 0:\n            posterior = (likelihood_if_credible * domain_prior) / marginal\n        else:\n            posterior = domain_prior\n\n        # Clamp to reasonable range\n        posterior = max(0.1, min(0.95, posterior))\n\n        evidence = EvidenceNode(\n            evidence_type=EvidenceType.SOURCE_CREDIBILITY,\n            name=f\"Source: {domain}\",\n            prior=domain_prior,\n            likelihood=likelihood_if_credible,\n            marginal=marginal,\n            posterior=posterior,\n            explanation=domain_explanation,\n            raw_data={\"domain\": domain, \"content_signals\": content_signals}\n        )\n\n        return posterior, evidence\n\n    def _assess_content_signals(self, source: Dict[str, Any]) -> float:\n        \"\"\"Assess content quality signals from source metadata.\n\n        Returns probability that content is high quality given observable signals.\n        \"\"\"\n        signals_score = 0.5  # Start at neutral\n\n        title = source.get(\"title\", \"\")\n        snippet = source.get(\"snippet\", \"\")\n        source_type = source.get(\"source_type\", \"web\")\n\n        # Title quality signals\n        if title:\n            # Longer, descriptive titles tend to be higher quality\n            if len(title) > 30:\n                signals_score += 0.05\n            if len(title) > 60:\n                signals_score += 0.05\n\n            # Marketing language is a negative signal\n            marketing_words = [\"best\", \"top\", \"amazing\", \"revolutionary\", \"guaranteed\"]\n            if any(w in title.lower() for w in marketing_words):\n                signals_score -= 0.10\n\n        # Snippet quality signals\n        if snippet:\n            # Substantive snippets suggest better content\n            if len(snippet) > 100:\n                signals_score += 0.05\n\n            # Contains numbers/data (suggests factual content)\n            if any(c.isdigit() for c in snippet):\n                signals_score += 0.05\n\n        # Source type signals\n        if source_type == \"academic\":\n            signals_score += 0.15\n        elif source_type == \"news\":\n            signals_score += 0.05\n        elif source_type == \"blog\":\n            signals_score -= 0.05\n        elif source_type == \"social\":\n            signals_score -= 0.10\n\n        return max(0.1, min(0.9, signals_score))\n\n    def calculate_finding_confidence(\n        self,\n        finding: Dict[str, Any],\n        sources: List[Dict[str, Any]],\n        verification: Optional[Dict[str, Any]] = None,\n    ) -> Tuple[float, ConfidenceExplanation]:\n        \"\"\"Calculate P(finding is true) using full Bayesian network.\n\n        The network structure:\n        - P(finding true) depends on P(sources credible)\n        - Multiple credible sources increase confidence (corroboration)\n        - Bias detection decreases confidence\n        - Expert sanity check can increase or decrease\n\n        Returns:\n            Tuple of (confidence_score, explanation)\n        \"\"\"\n        self.reset()\n\n        # Start with base confidence from finding extraction\n        base_confidence = finding.get(\"confidence_score\", 0.5)\n\n        # Track cumulative probability\n        current_confidence = base_confidence\n\n        # Phase 1: Source credibility\n        # P(finding | sources) = product of P(source_i credible) for corroborating sources\n        source_posteriors = []\n        for source in sources[:5]:  # Limit to top 5 sources\n            cred_score, evidence = self.calculate_source_credibility(source)\n            source_posteriors.append(cred_score)\n            self.evidence_nodes.append(evidence)\n\n        if source_posteriors:\n            # Combine source credibilities using Bayesian combination\n            # Multiple agreeing sources increase confidence\n            combined_source_cred = self._combine_source_credibilities(source_posteriors)\n\n            # Update confidence based on source credibility\n            # P(finding | sources) = P(finding) * adjustment_factor\n            source_adjustment = self._calculate_source_adjustment(\n                base_confidence, combined_source_cred\n            )\n            current_confidence = source_adjustment\n\n            self.evidence_nodes.append(EvidenceNode(\n                evidence_type=EvidenceType.CORROBORATION,\n                name=\"Source Agreement\",\n                prior=base_confidence,\n                likelihood=combined_source_cred,\n                marginal=0.5,  # Neutral marginal\n                posterior=current_confidence,\n                explanation=f\"Combined credibility from {len(source_posteriors)} sources\"\n            ))\n\n        # Phase 2: Verification adjustments\n        if verification:\n            current_confidence = self._apply_verification_evidence(\n                current_confidence, verification\n            )\n\n        # Generate explanation\n        explanation = self._generate_explanation(\n            base_confidence, current_confidence, finding, sources\n        )\n\n        # Clamp final result\n        final_confidence = max(0.1, min(0.95, current_confidence))\n        explanation.final_confidence = final_confidence\n\n        return final_confidence, explanation\n\n    def _combine_source_credibilities(self, credibilities: List[float]) -> float:\n        \"\"\"Combine multiple source credibilities using Bayesian update.\n\n        Multiple independent credible sources increase confidence:\n        P(true | source1, source2) > P(true | source1) if source2 corroborates\n\n        We use a log-odds model for combining evidence.\n        \"\"\"\n        if not credibilities:\n            return 0.5\n\n        if len(credibilities) == 1:\n            return credibilities[0]\n\n        # Convert to log-odds and sum\n        log_odds = []\n        for p in credibilities:\n            # Clamp to avoid log(0)\n            p = max(0.01, min(0.99, p))\n            log_odds.append(math.log(p / (1 - p)))\n\n        # Average log-odds (for independent evidence this is additive)\n        # But we use a weighted average with diminishing returns\n        # First source has full weight, subsequent sources have reduced weight\n        weights = [1.0 / (i + 1) for i in range(len(log_odds))]\n        total_weight = sum(weights)\n        weighted_log_odds = sum(lo * w for lo, w in zip(log_odds, weights)) / total_weight\n\n        # Convert back to probability\n        combined = 1 / (1 + math.exp(-weighted_log_odds))\n\n        # Apply bonus for multiple sources (corroboration boost)\n        if len(credibilities) >= 3:\n            combined = combined * 1.05  # 5% boost for 3+ sources\n        if len(credibilities) >= 5:\n            combined = combined * 1.05  # Additional 5% boost for 5+ sources\n\n        return min(0.95, combined)\n\n    def _calculate_source_adjustment(\n        self,\n        base_confidence: float,\n        source_credibility: float\n    ) -> float:\n        \"\"\"Calculate adjusted confidence based on source credibility.\n\n        Uses a Bayesian update where source credibility affects our belief\n        in the finding being true.\n        \"\"\"\n        # P(finding | sources) = P(sources support finding | finding true) * P(finding) / P(sources support)\n        # Simplified: we weight the base confidence by source credibility\n\n        # If sources are highly credible, pull confidence toward their level\n        # If sources are low credibility, pull down\n\n        # Weight based on how much evidence we have\n        weight = 0.4  # How much source credibility affects the final score\n\n        adjusted = (1 - weight) * base_confidence + weight * source_credibility\n\n        return adjusted\n\n    def _apply_verification_evidence(\n        self,\n        current_confidence: float,\n        verification: Dict[str, Any],\n    ) -> float:\n        \"\"\"Apply verification results using Bayesian updates.\n\n        Unlike additive adjustments, we use proper probability updates.\n        \"\"\"\n        confidence = current_confidence\n\n        # Bias detection evidence\n        if \"bias\" in verification:\n            bias = verification[\"bias\"]\n            bias_score = bias.get(\"bias_score\", 0.0)\n\n            if bias_score > 0.3:\n                # High bias detected - this is evidence against the finding\n                # P(finding true | bias detected) = P(bias | true) * P(true) / P(bias)\n                # If source is biased, less likely finding is objective truth\n\n                # Likelihood ratio: P(bias | finding true) / P(bias | finding false)\n                # Biased sources more likely to push false narratives\n                likelihood_ratio = 0.7 - (bias_score * 0.4)  # 0.3 to 0.7\n\n                confidence = self._bayesian_update(\n                    prior=confidence,\n                    likelihood_ratio=likelihood_ratio\n                )\n\n                self.evidence_nodes.append(EvidenceNode(\n                    evidence_type=EvidenceType.BIAS_DETECTION,\n                    name=\"Bias Detection\",\n                    prior=current_confidence,\n                    likelihood=likelihood_ratio,\n                    marginal=0.5,\n                    posterior=confidence,\n                    explanation=f\"Bias score: {bias_score:.2f} - {bias.get('bias_type', 'unknown')}\",\n                    raw_data=bias\n                ))\n\n        # Expert sanity check evidence\n        if \"expert_check\" in verification:\n            expert = verification[\"expert_check\"]\n            plausibility = expert.get(\"plausibility\", \"plausible\")\n            plausibility_score = expert.get(\"plausibility_score\", 0.7)\n\n            # Expert judgment provides strong evidence\n            if plausibility == \"implausible\":\n                # Strong evidence against\n                likelihood_ratio = 0.3\n                explanation = \"Expert assessment: claim is implausible\"\n            elif plausibility == \"questionable\":\n                # Moderate evidence against\n                likelihood_ratio = 0.6\n                explanation = \"Expert assessment: claim is questionable\"\n            else:\n                # Slight positive evidence\n                likelihood_ratio = 1.0 + (plausibility_score - 0.7) * 0.3\n                explanation = f\"Expert assessment: claim is plausible ({plausibility_score:.0%})\"\n\n            prior = confidence\n            confidence = self._bayesian_update(\n                prior=confidence,\n                likelihood_ratio=likelihood_ratio\n            )\n\n            self.evidence_nodes.append(EvidenceNode(\n                evidence_type=EvidenceType.EXPERT_SANITY,\n                name=\"Expert Sanity Check\",\n                prior=prior,\n                likelihood=likelihood_ratio if likelihood_ratio <= 1 else 1/likelihood_ratio,\n                marginal=0.5,\n                posterior=confidence,\n                explanation=explanation,\n                raw_data=expert\n            ))\n\n            # Flag extraordinary claims\n            if expert.get(\"extraordinary_claim\", False):\n                # Extraordinary claims require extraordinary evidence\n                confidence = confidence * 0.85\n                self.evidence_nodes.append(EvidenceNode(\n                    evidence_type=EvidenceType.EXPERT_SANITY,\n                    name=\"Extraordinary Claim Flag\",\n                    prior=confidence / 0.85,\n                    likelihood=0.85,\n                    marginal=0.5,\n                    posterior=confidence,\n                    explanation=\"Extraordinary claim requires stronger evidence\"\n                ))\n\n        # Cross-reference evidence\n        if \"cross_reference\" in verification:\n            cross_ref = verification[\"cross_reference\"]\n            corroboration = cross_ref.get(\"corroboration_level\", \"unknown\")\n\n            # Cross-reference provides corroboration evidence\n            corroboration_map = {\n                \"strong\": 1.3,      # Strong positive evidence\n                \"moderate\": 1.1,    # Moderate positive\n                \"weak\": 0.95,       # Slight negative\n                \"uncorroborated\": 0.8,  # No corroboration is weak negative\n                \"unknown\": 1.0      # Neutral\n            }\n\n            likelihood_ratio = corroboration_map.get(corroboration, 1.0)\n\n            # Check for contradictions\n            contradictions = cross_ref.get(\"contradicting_findings\", [])\n            if contradictions:\n                # Each contradiction is evidence against\n                likelihood_ratio *= (0.9 ** len(contradictions))\n\n            prior = confidence\n            confidence = self._bayesian_update(\n                prior=confidence,\n                likelihood_ratio=likelihood_ratio\n            )\n\n            explanation = f\"Cross-reference: {corroboration}\"\n            if contradictions:\n                explanation += f\" ({len(contradictions)} contradictions)\"\n\n            self.evidence_nodes.append(EvidenceNode(\n                evidence_type=EvidenceType.CROSS_REFERENCE,\n                name=\"Cross-Reference Analysis\",\n                prior=prior,\n                likelihood=min(1.0, likelihood_ratio),\n                marginal=0.5,\n                posterior=confidence,\n                explanation=explanation,\n                raw_data=cross_ref\n            ))\n\n        return confidence\n\n    def _bayesian_update(\n        self,\n        prior: float,\n        likelihood_ratio: float,\n    ) -> float:\n        \"\"\"Apply Bayesian update using likelihood ratio.\n\n        posterior_odds = likelihood_ratio * prior_odds\n\n        Args:\n            prior: Prior probability P(H)\n            likelihood_ratio: P(E|H) / P(E|not H)\n\n        Returns:\n            Posterior probability P(H|E)\n        \"\"\"\n        # Convert to odds\n        if prior >= 0.99:\n            prior = 0.99\n        if prior <= 0.01:\n            prior = 0.01\n\n        prior_odds = prior / (1 - prior)\n\n        # Update odds\n        posterior_odds = likelihood_ratio * prior_odds\n\n        # Convert back to probability\n        posterior = posterior_odds / (1 + posterior_odds)\n\n        return max(0.1, min(0.95, posterior))\n\n    def _generate_explanation(\n        self,\n        base_confidence: float,\n        final_confidence: float,\n        finding: Dict[str, Any],\n        sources: List[Dict[str, Any]],\n    ) -> ConfidenceExplanation:\n        \"\"\"Generate structured explanation of confidence calculation.\"\"\"\n\n        # Determine what would increase confidence\n        what_would_increase = []\n        what_would_decrease = []\n\n        # Check source diversity\n        domains = set(s.get(\"domain\", \"\") for s in sources)\n        if len(domains) < 3:\n            what_would_increase.append(\n                \"Additional corroborating sources from different domains\"\n            )\n\n        # Check for high-authority sources\n        high_auth_count = sum(\n            1 for s in sources\n            if self.get_domain_authority(s.get(\"domain\", \"\"))[0] > 0.8\n        )\n        if high_auth_count < 2:\n            what_would_increase.append(\n                \"Citations from authoritative sources (academic, government, major publications)\"\n            )\n\n        # Check verification status\n        for node in self.evidence_nodes:\n            if node.evidence_type == EvidenceType.BIAS_DETECTION:\n                if node.posterior < node.prior:\n                    what_would_decrease.append(\n                        f\"Bias detected: {node.explanation}\"\n                    )\n            if node.evidence_type == EvidenceType.EXPERT_SANITY:\n                if \"implausible\" in node.explanation.lower():\n                    what_would_decrease.append(\n                        \"Expert assessment flagged claim as implausible\"\n                    )\n                elif \"questionable\" in node.explanation.lower():\n                    what_would_decrease.append(\n                        \"Expert assessment flagged claim as questionable\"\n                    )\n\n        # Add general factors\n        if final_confidence < 0.7:\n            what_would_increase.append(\n                \"Verification by independent fact-checking\"\n            )\n\n        if final_confidence > 0.8:\n            what_would_decrease.append(\n                \"Discovery of conflicting evidence or retractions\"\n            )\n\n        # Generate summary\n        pct = lambda x: f\"{x*100:.0f}%\"\n\n        if final_confidence >= base_confidence + 0.1:\n            summary = (\n                f\"Confidence increased from {pct(base_confidence)} to {pct(final_confidence)} \"\n                f\"due to corroborating evidence from credible sources.\"\n            )\n        elif final_confidence <= base_confidence - 0.1:\n            summary = (\n                f\"Confidence decreased from {pct(base_confidence)} to {pct(final_confidence)} \"\n                f\"due to verification concerns (bias, plausibility, or lack of corroboration).\"\n            )\n        else:\n            summary = (\n                f\"Confidence of {pct(final_confidence)} reflects balanced evidence \"\n                f\"from the available sources and verification checks.\"\n            )\n\n        return ConfidenceExplanation(\n            base_confidence=base_confidence,\n            final_confidence=final_confidence,\n            evidence_chain=self.evidence_nodes.copy(),\n            summary=summary,\n            what_would_increase=what_would_increase[:5],\n            what_would_decrease=what_would_decrease[:5],\n        )\n\n\ndef calculate_bayesian_confidence(\n    finding: Dict[str, Any],\n    sources: List[Dict[str, Any]],\n    verification: Optional[Dict[str, Any]] = None,\n) -> Tuple[float, ConfidenceExplanation]:\n    \"\"\"Convenience function for calculating Bayesian confidence.\n\n    Args:\n        finding: Finding dictionary with confidence_score\n        sources: List of source dictionaries\n        verification: Optional verification results\n\n    Returns:\n        Tuple of (confidence_score, explanation)\n    \"\"\"\n    calculator = BayesianConfidenceCalculator()\n    return calculator.calculate_finding_confidence(finding, sources, verification)\n\n\ndef calculate_source_credibility(source: Dict[str, Any]) -> Tuple[float, str]:\n    \"\"\"Calculate credibility score for a single source.\n\n    Returns:\n        Tuple of (credibility_score, explanation_string)\n    \"\"\"\n    calculator = BayesianConfidenceCalculator()\n    score, evidence = calculator.calculate_source_credibility(source)\n    return score, evidence.explanation\n","numLines":721,"startLine":1,"totalLines":721}}}
[2026-01-30T09:08:24.257Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018HERf5gSa1gSq93vDTYAW7","type":"tool_result","content":"     1→\"\"\"Transform pipeline for typed data transformations.\n     2→\n     3→This module provides a declarative pipeline architecture for converting raw dicts\n     4→to typed Pydantic models with validation and enrichment stages.\n     5→\"\"\"\n     6→\n     7→from typing import Any, Callable, Dict, Generic, List, Optional, Type, TypeVar, Union\n     8→from dataclasses import dataclass, field\n     9→from pydantic import BaseModel\n    10→import logging\n    11→\n    12→from ..schemas import Finding, Source, Perspective, Prediction, CostSummary\n    13→\n    14→logger = logging.getLogger(__name__)\n    15→\n    16→T = TypeVar(\"T\", bound=BaseModel)\n    17→InputType = Dict[str, Any]\n    18→\n    19→\n    20→@dataclass\n    21→class TransformError:\n    22→    \"\"\"Represents an error during transformation.\"\"\"\n    23→\n    24→    stage: str  # converter, validator, enricher\n    25→    field: Optional[str] = None\n    26→    message: str = \"\"\n    27→    original_value: Any = None\n    28→\n    29→\n    30→@dataclass\n    31→class TransformResult(Generic[T]):\n    32→    \"\"\"Result of a transformation pipeline.\"\"\"\n    33→\n    34→    value: Optional[T] = None\n    35→    errors: List[TransformError] = field(default_factory=list)\n    36→\n    37→    @property\n    38→    def success(self) -> bool:\n    39→        return self.value is not None and not self.errors\n    40→\n    41→    @property\n    42→    def has_warnings(self) -> bool:\n    43→        return len(self.errors) > 0 and self.value is not None\n    44→\n    45→\n    46→# Type aliases for pipeline stages\n    47→Converter = Callable[[InputType], Dict[str, Any]]\n    48→Validator = Callable[[Dict[str, Any]], List[TransformError]]\n    49→Enricher = Callable[[Dict[str, Any], Optional[Any]], Dict[str, Any]]\n    50→\n    51→\n    52→class TransformPipeline(Generic[T]):\n    53→    \"\"\"\n    54→    A composable transformation pipeline that converts raw dicts to typed models.\n    55→\n    56→    The pipeline processes data through three stages:\n    57→    1. Converters: Map raw field names/values to model-compatible format\n    58→    2. Validators: Check data integrity and business rules\n    59→    3. Enrichers: Add computed fields or defaults\n    60→\n    61→    Example:\n    62→        pipeline = TransformPipeline(Finding)\n    63→        pipeline.add_converter(finding_converter)\n    64→        pipeline.add_validator(confidence_validator)\n    65→        pipeline.add_enricher(add_finding_id)\n    66→\n    67→        result = pipeline.transform(raw_dict, context={\"index\": 0})\n    68→    \"\"\"\n    69→\n    70→    def __init__(self, model_class: Type[T]):\n    71→        self.model_class = model_class\n    72→        self._converters: List[Converter] = []\n    73→        self._validators: List[Validator] = []\n    74→        self._enrichers: List[Enricher] = []\n    75→\n    76→    def add_converter(self, converter: Converter) -> \"TransformPipeline[T]\":\n    77→        \"\"\"Add a converter stage. Converters are applied in order.\"\"\"\n    78→        self._converters.append(converter)\n    79→        return self\n    80→\n    81→    def add_validator(self, validator: Validator) -> \"TransformPipeline[T]\":\n    82→        \"\"\"Add a validator stage. All validators are run, errors collected.\"\"\"\n    83→        self._validators.append(validator)\n    84→        return self\n    85→\n    86→    def add_enricher(self, enricher: Enricher) -> \"TransformPipeline[T]\":\n    87→        \"\"\"Add an enricher stage. Enrichers are applied in order.\"\"\"\n    88→        self._enrichers.append(enricher)\n    89→        return self\n    90→\n    91→    def transform(self, data: InputType, context: Optional[Any] = None) -> TransformResult[T]:\n    92→        \"\"\"\n    93→        Transform a raw dict through the pipeline.\n    94→\n    95→        Args:\n    96→            data: Raw dictionary to transform\n    97→            context: Optional context passed to enrichers (e.g., index, sources list)\n    98→\n    99→        Returns:\n   100→            TransformResult with the typed model or errors\n   101→        \"\"\"\n   102→        errors: List[TransformError] = []\n   103→        current_data = dict(data)  # Copy to avoid mutation\n   104→\n   105→        # Stage 1: Apply converters\n   106→        for converter in self._converters:\n   107→            try:\n   108→                current_data = converter(current_data)\n   109→            except Exception as e:\n   110→                errors.append(TransformError(\n   111→                    stage=\"converter\",\n   112→                    message=str(e),\n   113→                    original_value=data,\n   114→                ))\n   115→                return TransformResult(value=None, errors=errors)\n   116→\n   117→        # Stage 2: Run validators\n   118→        for validator in self._validators:\n   119→            try:\n   120→                validation_errors = validator(current_data)\n   121→                errors.extend(validation_errors)\n   122→            except Exception as e:\n   123→                errors.append(TransformError(\n   124→                    stage=\"validator\",\n   125→                    message=str(e),\n   126→                ))\n   127→\n   128→        # If validation errors are critical, stop here\n   129→        critical_errors = [e for e in errors if e.stage == \"validator\"]\n   130→        if critical_errors:\n   131→            return TransformResult(value=None, errors=errors)\n   132→\n   133→        # Stage 3: Apply enrichers\n   134→        for enricher in self._enrichers:\n   135→            try:\n   136→                current_data = enricher(current_data, context)\n   137→            except Exception as e:\n   138→                errors.append(TransformError(\n   139→                    stage=\"enricher\",\n   140→                    message=str(e),\n   141→                ))\n   142→\n   143→        # Stage 4: Create model instance\n   144→        try:\n   145→            model_instance = self.model_class(**current_data)\n   146→            return TransformResult(value=model_instance, errors=errors)\n   147→        except Exception as e:\n   148→            errors.append(TransformError(\n   149→                stage=\"model_creation\",\n   150→                message=str(e),\n   151→                original_value=current_data,\n   152→            ))\n   153→            return TransformResult(value=None, errors=errors)\n   154→\n   155→    def transform_many(\n   156→        self,\n   157→        items: List[InputType],\n   158→        context_factory: Optional[Callable[[int, InputType], Any]] = None,\n   159→    ) -> List[T]:\n   160→        \"\"\"\n   161→        Transform a list of items, returning only successful transformations.\n   162→\n   163→        Args:\n   164→            items: List of raw dictionaries\n   165→            context_factory: Optional function to create context for each item (index, item) -> context\n   166→\n   167→        Returns:\n   168→            List of successfully transformed models\n   169→        \"\"\"\n   170→        results = []\n   171→        for i, item in enumerate(items):\n   172→            context = context_factory(i, item) if context_factory else {\"index\": i}\n   173→            result = self.transform(item, context)\n   174→            if result.success:\n   175→                results.append(result.value)\n   176→            elif result.has_warnings:\n   177→                results.append(result.value)\n   178→                for error in result.errors:\n   179→                    logger.warning(f\"Transform warning for item {i}: {error.message}\")\n   180→            else:\n   181→                for error in result.errors:\n   182→                    logger.error(f\"Transform error for item {i}: {error.message}\")\n   183→        return results\n   184→\n   185→\n   186→# ============================================================================\n   187→# Pre-built converters for common transformations\n   188→# ============================================================================\n   189→\n   190→def finding_converter(data: InputType) -> Dict[str, Any]:\n   191→    \"\"\"Convert raw finding dict to Finding-compatible format.\"\"\"\n   192→    return {\n   193→        \"finding_id\": data.get(\"finding_id\", f\"f{data.get('_index', 0)}\"),\n   194→        \"finding_type\": data.get(\"finding_type\", \"fact\"),\n   195→        \"content\": data.get(\"content\", \"\"),\n   196→        \"summary\": data.get(\"summary\"),\n   197→        \"confidence_score\": data.get(\"confidence_score\", 0.5),\n   198→        \"temporal_context\": data.get(\"temporal_context\", \"present\"),\n   199→        \"extracted_data\": data.get(\"extracted_data\"),\n   200→        \"supporting_sources\": data.get(\"supporting_sources\", []),\n   201→        \"date_referenced\": data.get(\"date_referenced\"),\n   202→        \"date_range\": data.get(\"date_range\"),\n   203→    }\n   204→\n   205→\n   206→def source_converter(data: InputType) -> Dict[str, Any]:\n   207→    \"\"\"Convert raw source dict to Source-compatible format.\"\"\"\n   208→    return {\n   209→        \"url\": data.get(\"url\", \"\"),\n   210→        \"title\": data.get(\"title\", \"\"),\n   211→        \"domain\": data.get(\"domain\", \"\"),\n   212→        \"snippet\": data.get(\"snippet\", \"\"),\n   213→        \"source_type\": data.get(\"source_type\", \"web\"),\n   214→        \"credibility_score\": data.get(\"credibility_score\"),\n   215→        \"credibility_label\": data.get(\"credibility_label\"),\n   216→    }\n   217→\n   218→\n   219→def prediction_converter(data: InputType) -> Dict[str, Any]:\n   220→    \"\"\"Convert raw prediction dict or string to Prediction-compatible format.\"\"\"\n   221→    if isinstance(data, str):\n   222→        # Handle old-style string predictions\n   223→        return {\n   224→            \"prediction\": data,\n   225→            \"rationale\": \"Based on research findings\",\n   226→            \"confidence\": \"medium\",\n   227→            \"timeline\": \"2025-2026\",\n   228→            \"supporting_sources\": [],\n   229→        }\n   230→    return {\n   231→        \"prediction\": data.get(\"prediction\", \"\"),\n   232→        \"rationale\": data.get(\"rationale\", \"\"),\n   233→        \"confidence\": data.get(\"confidence\", \"medium\"),\n   234→        \"timeline\": data.get(\"timeline\", \"\"),\n   235→        \"supporting_sources\": data.get(\"supporting_sources\", []),\n   236→    }\n   237→\n   238→\n   239→def perspective_converter(data: InputType) -> Dict[str, Any]:\n   240→    \"\"\"Convert raw perspective dict to Perspective-compatible format (without predictions).\"\"\"\n   241→    return {\n   242→        \"perspective_type\": data.get(\"perspective_type\", \"unknown\"),\n   243→        \"analysis_text\": data.get(\"analysis_text\", \"\"),\n   244→        \"key_insights\": data.get(\"key_insights\", []),\n   245→        \"recommendations\": data.get(\"recommendations\", []),\n   246→        \"warnings\": data.get(\"warnings\", []),\n   247→        \"confidence\": data.get(\"confidence\", 0.5),\n   248→        # predictions handled separately by enricher\n   249→    }\n   250→\n   251→\n   252→def cost_summary_converter(data: InputType) -> Dict[str, Any]:\n   253→    \"\"\"Convert raw cost dict to CostSummary-compatible format.\"\"\"\n   254→    return {\n   255→        \"total_tokens\": data.get(\"total_tokens\", 0),\n   256→        \"input_tokens\": data.get(\"input_tokens\", 0),\n   257→        \"output_tokens\": data.get(\"output_tokens\", 0),\n   258→        \"gemini_cost_usd\": data.get(\"gemini_cost_usd\", 0),\n   259→        \"openrouter_cost_usd\": data.get(\"openrouter_cost_usd\", 0),\n   260→        \"total_cost_usd\": data.get(\"total_cost_usd\", 0),\n   261→    }\n   262→\n   263→\n   264→# ============================================================================\n   265→# Pre-built enrichers\n   266→# ============================================================================\n   267→\n   268→def add_finding_id_enricher(data: Dict[str, Any], context: Optional[Any]) -> Dict[str, Any]:\n   269→    \"\"\"Add finding ID based on index from context.\"\"\"\n   270→    if context and isinstance(context, dict) and \"index\" in context:\n   271→        if not data.get(\"finding_id\") or data[\"finding_id\"].startswith(\"f0\"):\n   272→            data[\"finding_id\"] = f\"f{context['index']}\"\n   273→    return data\n   274→\n   275→\n   276→def add_supporting_sources_enricher(data: Dict[str, Any], context: Optional[Any]) -> Dict[str, Any]:\n   277→    \"\"\"Add supporting sources from context.\"\"\"\n   278→    if context and isinstance(context, dict) and \"sources\" in context:\n   279→        sources = context[\"sources\"]\n   280→        if not data.get(\"supporting_sources\") and sources:\n   281→            data[\"supporting_sources\"] = [\n   282→                {\"url\": s.get(\"url\", s.url if hasattr(s, \"url\") else \"\"),\n   283→                 \"title\": s.get(\"title\", s.title if hasattr(s, \"title\") else \"\")}\n   284→                for s in sources[:3]\n   285→            ]\n   286→    return data\n   287→\n   288→\n   289→def convert_predictions_enricher(data: Dict[str, Any], context: Optional[Any]) -> Dict[str, Any]:\n   290→    \"\"\"Convert raw predictions list to Prediction objects.\"\"\"\n   291→    raw_predictions = data.get(\"_raw_predictions\", data.get(\"predictions\", []))\n   292→\n   293→    if not raw_predictions:\n   294→        data[\"predictions\"] = []\n   295→        return data\n   296→\n   297→    prediction_pipeline = create_prediction_pipeline()\n   298→    converted = []\n   299→\n   300→    for pred in raw_predictions:\n   301→        if isinstance(pred, Prediction):\n   302→            converted.append(pred)\n   303→        elif isinstance(pred, dict):\n   304→            result = prediction_pipeline.transform(pred)\n   305→            if result.success:\n   306→                converted.append(result.value)\n   307→        elif isinstance(pred, str):\n   308→            result = prediction_pipeline.transform(pred)\n   309→            if result.success:\n   310→                converted.append(result.value)\n   311→\n   312→    data[\"predictions\"] = converted\n   313→    # Remove temporary key\n   314→    data.pop(\"_raw_predictions\", None)\n   315→    return data\n   316→\n   317→\n   318→# ============================================================================\n   319→# Pre-built pipelines\n   320→# ============================================================================\n   321→\n   322→def create_finding_pipeline() -> TransformPipeline[Finding]:\n   323→    \"\"\"Create a pipeline for Finding transformations.\"\"\"\n   324→    return (\n   325→        TransformPipeline(Finding)\n   326→        .add_converter(finding_converter)\n   327→        .add_enricher(add_finding_id_enricher)\n   328→    )\n   329→\n   330→\n   331→def create_source_pipeline() -> TransformPipeline[Source]:\n   332→    \"\"\"Create a pipeline for Source transformations.\"\"\"\n   333→    return (\n   334→        TransformPipeline(Source)\n   335→        .add_converter(source_converter)\n   336→    )\n   337→\n   338→\n   339→def create_prediction_pipeline() -> TransformPipeline[Prediction]:\n   340→    \"\"\"Create a pipeline for Prediction transformations.\"\"\"\n   341→    return (\n   342→        TransformPipeline(Prediction)\n   343→        .add_converter(prediction_converter)\n   344→    )\n   345→\n   346→\n   347→def create_perspective_pipeline() -> TransformPipeline[Perspective]:\n   348→    \"\"\"Create a pipeline for Perspective transformations (including predictions).\"\"\"\n   349→\n   350→    def perspective_with_raw_predictions(data: InputType) -> Dict[str, Any]:\n   351→        \"\"\"Converter that preserves raw predictions for enricher.\"\"\"\n   352→        result = perspective_converter(data)\n   353→        result[\"_raw_predictions\"] = data.get(\"predictions\", [])\n   354→        return result\n   355→\n   356→    return (\n   357→        TransformPipeline(Perspective)\n   358→        .add_converter(perspective_with_raw_predictions)\n   359→        .add_enricher(convert_predictions_enricher)\n   360→    )\n   361→\n   362→\n   363→def create_cost_summary_pipeline() -> TransformPipeline[CostSummary]:\n   364→    \"\"\"Create a pipeline for CostSummary transformations.\"\"\"\n   365→    return (\n   366→        TransformPipeline(CostSummary)\n   367→        .add_converter(cost_summary_converter)\n   368→    )\n   369→\n   370→\n   371→# ============================================================================\n   372→# High-level transformation functions\n   373→# ============================================================================\n   374→\n   375→def transform_findings(\n   376→    raw_findings: List[Dict[str, Any]],\n   377→    sources: Optional[List[Dict[str, Any]]] = None,\n   378→) -> List[Finding]:\n   379→    \"\"\"\n   380→    Transform a list of raw finding dicts to Finding objects.\n   381→\n   382→    Args:\n   383→        raw_findings: List of raw finding dictionaries\n   384→        sources: Optional list of sources to attach as supporting sources\n   385→\n   386→    Returns:\n   387→        List of Finding objects\n   388→    \"\"\"\n   389→    pipeline = create_finding_pipeline()\n   390→    if sources:\n   391→        pipeline.add_enricher(add_supporting_sources_enricher)\n   392→\n   393→    def context_factory(index: int, item: Dict[str, Any]) -> Dict[str, Any]:\n   394→        ctx = {\"index\": index}\n   395→        if sources:\n   396→            ctx[\"sources\"] = sources\n   397→        return ctx\n   398→\n   399→    return pipeline.transform_many(raw_findings, context_factory)\n   400→\n   401→\n   402→def transform_sources(raw_sources: List[Dict[str, Any]]) -> List[Source]:\n   403→    \"\"\"Transform a list of raw source dicts to Source objects.\"\"\"\n   404→    pipeline = create_source_pipeline()\n   405→    return pipeline.transform_many(raw_sources)\n   406→\n   407→\n   408→def transform_perspectives(raw_perspectives: List[Dict[str, Any]]) -> List[Perspective]:\n   409→    \"\"\"Transform a list of raw perspective dicts to Perspective objects.\"\"\"\n   410→    pipeline = create_perspective_pipeline()\n   411→    return pipeline.transform_many(raw_perspectives)\n   412→\n   413→\n   414→def transform_cost_summary(raw_cost: Dict[str, Any]) -> CostSummary:\n   415→    \"\"\"Transform a raw cost dict to CostSummary object.\"\"\"\n   416→    pipeline = create_cost_summary_pipeline()\n   417→    result = pipeline.transform(raw_cost)\n   418→    if result.success:\n   419→        return result.value\n   420→    # Return default on failure\n   421→    return CostSummary()\n   422→\n   423→\n   424→# ============================================================================\n   425→# Source extraction and credibility assessment\n   426→# ============================================================================\n   427→\n   428→def extract_source_dict(gemini_source: Any) -> Dict[str, Any]:\n   429→    \"\"\"\n   430→    Extract a dict from a GeminiSource or similar source object.\n   431→\n   432→    Args:\n   433→        gemini_source: A source object with url, title, domain, snippet, source_type attributes\n   434→\n   435→    Returns:\n   436→        Dictionary representation of the source\n   437→    \"\"\"\n   438→    return {\n   439→        \"url\": getattr(gemini_source, \"url\", \"\"),\n   440→        \"title\": getattr(gemini_source, \"title\", \"\"),\n   441→        \"domain\": getattr(gemini_source, \"domain\", \"\"),\n   442→        \"snippet\": getattr(gemini_source, \"snippet\", \"\"),\n   443→        \"source_type\": getattr(gemini_source, \"source_type\", \"web\"),\n   444→    }\n   445→\n   446→\n   447→def assess_credibility(source: Dict[str, Any]) -> float:\n   448→    \"\"\"\n   449→    Assess source credibility using Bayesian probability inference.\n   450→\n   451→    This uses a proper probabilistic model where:\n   452→    - P(source is credible) depends on P(domain is authoritative)\n   453→    - Domain authority is based on known authoritative sources\n   454→    - Content signals can adjust the probability\n   455→\n   456→    Returns:\n   457→        Credibility score between 0 and 1 (probability of credibility)\n   458→    \"\"\"\n   459→    from .bayesian_confidence import calculate_source_credibility\n   460→\n   461→    score, _ = calculate_source_credibility(source)\n   462→    return score\n   463→\n   464→\n   465→def credibility_label(score: float) -> str:\n   466→    \"\"\"Get credibility label from score.\"\"\"\n   467→    if score >= 0.8:\n   468→        return \"high\"\n   469→    elif score >= 0.6:\n   470→        return \"medium\"\n   471→    else:\n   472→        return \"low\"\n   473→\n   474→\n   475→def enrich_source_credibility(source: Dict[str, Any]) -> Dict[str, Any]:\n   476→    \"\"\"Add credibility score and label to a source dict.\"\"\"\n   477→    source[\"credibility_score\"] = assess_credibility(source)\n   478→    source[\"credibility_label\"] = credibility_label(source[\"credibility_score\"])\n   479→    return source\n   480→\n   481→\n   482→def extract_and_deduplicate_sources(\n   483→    gemini_sources: List[Any],\n   484→    enrich_credibility: bool = True,\n   485→) -> List[Dict[str, Any]]:\n   486→    \"\"\"\n   487→    Extract sources from Gemini results, deduplicate, and optionally assess credibility.\n   488→\n   489→    Args:\n   490→        gemini_sources: List of GeminiSource objects\n   491→        enrich_credibility: Whether to add credibility scores\n   492→\n   493→    Returns:\n   494→        List of deduplicated source dicts\n   495→    \"\"\"\n   496→    seen_urls = set()\n   497→    unique_sources = []\n   498→\n   499→    for gs in gemini_sources:\n   500→        source_dict = extract_source_dict(gs)\n   501→        if source_dict[\"url\"] not in seen_urls:\n   502→            seen_urls.add(source_dict[\"url\"])\n   503→            if enrich_credibility:\n   504→                source_dict = enrich_source_credibility(source_dict)\n   505→            unique_sources.append(source_dict)\n   506→\n   507→    return unique_sources\n   508→\n   509→\n   510→def enrich_findings_with_ids_and_sources(\n   511→    findings: List[Dict[str, Any]],\n   512→    sources: List[Dict[str, Any]],\n   513→    max_sources_per_finding: int = 3,\n   514→) -> List[Dict[str, Any]]:\n   515→    \"\"\"\n   516→    Enrich findings with IDs and supporting sources.\n   517→\n   518→    Args:\n   519→        findings: List of raw finding dicts\n   520→        sources: List of source dicts to attach\n   521→        max_sources_per_finding: Maximum sources to attach per finding\n   522→\n   523→    Returns:\n   524→        Enriched findings list\n   525→    \"\"\"\n   526→    for i, finding in enumerate(findings):\n   527→        finding[\"finding_id\"] = f\"f{i+1}\"\n   528→        finding[\"supporting_sources\"] = [\n   529→            {\"url\": s[\"url\"], \"title\": s[\"title\"]}\n   530→            for s in sources[:max_sources_per_finding]\n   531→        ]\n   532→    return findings\n   533→\n   534→\n   535→# ============================================================================\n   536→# Batch transformation for complete research results\n   537→# ============================================================================\n   538→\n   539→@dataclass\n   540→class TransformedResult:\n   541→    \"\"\"Container for all transformed research result components.\"\"\"\n   542→\n   543→    findings: List[Finding]\n   544→    sources: List[Source]\n   545→    perspectives: List[Perspective]\n   546→    cost_summary: CostSummary\n   547→\n   548→\n   549→def transform_research_result(result: Dict[str, Any]) -> TransformedResult:\n   550→    \"\"\"\n   551→    Transform a complete research result dict into typed components.\n   552→\n   553→    This is the main entry point for converting Cloud Run / research service\n   554→    results into typed Pydantic models.\n   555→\n   556→    Args:\n   557→        result: Raw research result dictionary\n   558→\n   559→    Returns:\n   560→        TransformedResult with all typed components\n   561→    \"\"\"\n   562→    sources = transform_sources(result.get(\"sources\", []))\n   563→\n   564→    # Transform findings with sources context\n   565→    findings = transform_findings(\n   566→        result.get(\"findings\", []),\n   567→        sources=[{\"url\": s.url, \"title\": s.title} for s in sources],\n   568→    )\n   569→\n   570→    perspectives = transform_perspectives(result.get(\"perspectives\", []))\n   571→    cost_summary = transform_cost_summary(result.get(\"cost_summary\", {}))\n   572→\n   573→    return TransformedResult(\n   574→        findings=findings,\n   575→        sources=sources,\n   576→        perspectives=perspectives,\n   577→        cost_summary=cost_summary,\n   578→    )\n   579→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"34eb5170-c9bb-41ec-b332-c49ff6c57668","uuid":"5a6324f4-a736-44da-bba0-7b37bea25ff9","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\actor\\src\\services\\transform.py","content":"\"\"\"Transform pipeline for typed data transformations.\n\nThis module provides a declarative pipeline architecture for converting raw dicts\nto typed Pydantic models with validation and enrichment stages.\n\"\"\"\n\nfrom typing import Any, Callable, Dict, Generic, List, Optional, Type, TypeVar, Union\nfrom dataclasses import dataclass, field\nfrom pydantic import BaseModel\nimport logging\n\nfrom ..schemas import Finding, Source, Perspective, Prediction, CostSummary\n\nlogger = logging.getLogger(__name__)\n\nT = TypeVar(\"T\", bound=BaseModel)\nInputType = Dict[str, Any]\n\n\n@dataclass\nclass TransformError:\n    \"\"\"Represents an error during transformation.\"\"\"\n\n    stage: str  # converter, validator, enricher\n    field: Optional[str] = None\n    message: str = \"\"\n    original_value: Any = None\n\n\n@dataclass\nclass TransformResult(Generic[T]):\n    \"\"\"Result of a transformation pipeline.\"\"\"\n\n    value: Optional[T] = None\n    errors: List[TransformError] = field(default_factory=list)\n\n    @property\n    def success(self) -> bool:\n        return self.value is not None and not self.errors\n\n    @property\n    def has_warnings(self) -> bool:\n        return len(self.errors) > 0 and self.value is not None\n\n\n# Type aliases for pipeline stages\nConverter = Callable[[InputType], Dict[str, Any]]\nValidator = Callable[[Dict[str, Any]], List[TransformError]]\nEnricher = Callable[[Dict[str, Any], Optional[Any]], Dict[str, Any]]\n\n\nclass TransformPipeline(Generic[T]):\n    \"\"\"\n    A composable transformation pipeline that converts raw dicts to typed models.\n\n    The pipeline processes data through three stages:\n    1. Converters: Map raw field names/values to model-compatible format\n    2. Validators: Check data integrity and business rules\n    3. Enrichers: Add computed fields or defaults\n\n    Example:\n        pipeline = TransformPipeline(Finding)\n        pipeline.add_converter(finding_converter)\n        pipeline.add_validator(confidence_validator)\n        pipeline.add_enricher(add_finding_id)\n\n        result = pipeline.transform(raw_dict, context={\"index\": 0})\n    \"\"\"\n\n    def __init__(self, model_class: Type[T]):\n        self.model_class = model_class\n        self._converters: List[Converter] = []\n        self._validators: List[Validator] = []\n        self._enrichers: List[Enricher] = []\n\n    def add_converter(self, converter: Converter) -> \"TransformPipeline[T]\":\n        \"\"\"Add a converter stage. Converters are applied in order.\"\"\"\n        self._converters.append(converter)\n        return self\n\n    def add_validator(self, validator: Validator) -> \"TransformPipeline[T]\":\n        \"\"\"Add a validator stage. All validators are run, errors collected.\"\"\"\n        self._validators.append(validator)\n        return self\n\n    def add_enricher(self, enricher: Enricher) -> \"TransformPipeline[T]\":\n        \"\"\"Add an enricher stage. Enrichers are applied in order.\"\"\"\n        self._enrichers.append(enricher)\n        return self\n\n    def transform(self, data: InputType, context: Optional[Any] = None) -> TransformResult[T]:\n        \"\"\"\n        Transform a raw dict through the pipeline.\n\n        Args:\n            data: Raw dictionary to transform\n            context: Optional context passed to enrichers (e.g., index, sources list)\n\n        Returns:\n            TransformResult with the typed model or errors\n        \"\"\"\n        errors: List[TransformError] = []\n        current_data = dict(data)  # Copy to avoid mutation\n\n        # Stage 1: Apply converters\n        for converter in self._converters:\n            try:\n                current_data = converter(current_data)\n            except Exception as e:\n                errors.append(TransformError(\n                    stage=\"converter\",\n                    message=str(e),\n                    original_value=data,\n                ))\n                return TransformResult(value=None, errors=errors)\n\n        # Stage 2: Run validators\n        for validator in self._validators:\n            try:\n                validation_errors = validator(current_data)\n                errors.extend(validation_errors)\n            except Exception as e:\n                errors.append(TransformError(\n                    stage=\"validator\",\n                    message=str(e),\n                ))\n\n        # If validation errors are critical, stop here\n        critical_errors = [e for e in errors if e.stage == \"validator\"]\n        if critical_errors:\n            return TransformResult(value=None, errors=errors)\n\n        # Stage 3: Apply enrichers\n        for enricher in self._enrichers:\n            try:\n                current_data = enricher(current_data, context)\n            except Exception as e:\n                errors.append(TransformError(\n                    stage=\"enricher\",\n                    message=str(e),\n                ))\n\n        # Stage 4: Create model instance\n        try:\n            model_instance = self.model_class(**current_data)\n            return TransformResult(value=model_instance, errors=errors)\n        except Exception as e:\n            errors.append(TransformError(\n                stage=\"model_creation\",\n                message=str(e),\n                original_value=current_data,\n            ))\n            return TransformResult(value=None, errors=errors)\n\n    def transform_many(\n        self,\n        items: List[InputType],\n        context_factory: Optional[Callable[[int, InputType], Any]] = None,\n    ) -> List[T]:\n        \"\"\"\n        Transform a list of items, returning only successful transformations.\n\n        Args:\n            items: List of raw dictionaries\n            context_factory: Optional function to create context for each item (index, item) -> context\n\n        Returns:\n            List of successfully transformed models\n        \"\"\"\n        results = []\n        for i, item in enumerate(items):\n            context = context_factory(i, item) if context_factory else {\"index\": i}\n            result = self.transform(item, context)\n            if result.success:\n                results.append(result.value)\n            elif result.has_warnings:\n                results.append(result.value)\n                for error in result.errors:\n                    logger.warning(f\"Transform warning for item {i}: {error.message}\")\n            else:\n                for error in result.errors:\n                    logger.error(f\"Transform error for item {i}: {error.message}\")\n        return results\n\n\n# ============================================================================\n# Pre-built converters for common transformations\n# ============================================================================\n\ndef finding_converter(data: InputType) -> Dict[str, Any]:\n    \"\"\"Convert raw finding dict to Finding-compatible format.\"\"\"\n    return {\n        \"finding_id\": data.get(\"finding_id\", f\"f{data.get('_index', 0)}\"),\n        \"finding_type\": data.get(\"finding_type\", \"fact\"),\n        \"content\": data.get(\"content\", \"\"),\n        \"summary\": data.get(\"summary\"),\n        \"confidence_score\": data.get(\"confidence_score\", 0.5),\n        \"temporal_context\": data.get(\"temporal_context\", \"present\"),\n        \"extracted_data\": data.get(\"extracted_data\"),\n        \"supporting_sources\": data.get(\"supporting_sources\", []),\n        \"date_referenced\": data.get(\"date_referenced\"),\n        \"date_range\": data.get(\"date_range\"),\n    }\n\n\ndef source_converter(data: InputType) -> Dict[str, Any]:\n    \"\"\"Convert raw source dict to Source-compatible format.\"\"\"\n    return {\n        \"url\": data.get(\"url\", \"\"),\n        \"title\": data.get(\"title\", \"\"),\n        \"domain\": data.get(\"domain\", \"\"),\n        \"snippet\": data.get(\"snippet\", \"\"),\n        \"source_type\": data.get(\"source_type\", \"web\"),\n        \"credibility_score\": data.get(\"credibility_score\"),\n        \"credibility_label\": data.get(\"credibility_label\"),\n    }\n\n\ndef prediction_converter(data: InputType) -> Dict[str, Any]:\n    \"\"\"Convert raw prediction dict or string to Prediction-compatible format.\"\"\"\n    if isinstance(data, str):\n        # Handle old-style string predictions\n        return {\n            \"prediction\": data,\n            \"rationale\": \"Based on research findings\",\n            \"confidence\": \"medium\",\n            \"timeline\": \"2025-2026\",\n            \"supporting_sources\": [],\n        }\n    return {\n        \"prediction\": data.get(\"prediction\", \"\"),\n        \"rationale\": data.get(\"rationale\", \"\"),\n        \"confidence\": data.get(\"confidence\", \"medium\"),\n        \"timeline\": data.get(\"timeline\", \"\"),\n        \"supporting_sources\": data.get(\"supporting_sources\", []),\n    }\n\n\ndef perspective_converter(data: InputType) -> Dict[str, Any]:\n    \"\"\"Convert raw perspective dict to Perspective-compatible format (without predictions).\"\"\"\n    return {\n        \"perspective_type\": data.get(\"perspective_type\", \"unknown\"),\n        \"analysis_text\": data.get(\"analysis_text\", \"\"),\n        \"key_insights\": data.get(\"key_insights\", []),\n        \"recommendations\": data.get(\"recommendations\", []),\n        \"warnings\": data.get(\"warnings\", []),\n        \"confidence\": data.get(\"confidence\", 0.5),\n        # predictions handled separately by enricher\n    }\n\n\ndef cost_summary_converter(data: InputType) -> Dict[str, Any]:\n    \"\"\"Convert raw cost dict to CostSummary-compatible format.\"\"\"\n    return {\n        \"total_tokens\": data.get(\"total_tokens\", 0),\n        \"input_tokens\": data.get(\"input_tokens\", 0),\n        \"output_tokens\": data.get(\"output_tokens\", 0),\n        \"gemini_cost_usd\": data.get(\"gemini_cost_usd\", 0),\n        \"openrouter_cost_usd\": data.get(\"openrouter_cost_usd\", 0),\n        \"total_cost_usd\": data.get(\"total_cost_usd\", 0),\n    }\n\n\n# ============================================================================\n# Pre-built enrichers\n# ============================================================================\n\ndef add_finding_id_enricher(data: Dict[str, Any], context: Optional[Any]) -> Dict[str, Any]:\n    \"\"\"Add finding ID based on index from context.\"\"\"\n    if context and isinstance(context, dict) and \"index\" in context:\n        if not data.get(\"finding_id\") or data[\"finding_id\"].startswith(\"f0\"):\n            data[\"finding_id\"] = f\"f{context['index']}\"\n    return data\n\n\ndef add_supporting_sources_enricher(data: Dict[str, Any], context: Optional[Any]) -> Dict[str, Any]:\n    \"\"\"Add supporting sources from context.\"\"\"\n    if context and isinstance(context, dict) and \"sources\" in context:\n        sources = context[\"sources\"]\n        if not data.get(\"supporting_sources\") and sources:\n            data[\"supporting_sources\"] = [\n                {\"url\": s.get(\"url\", s.url if hasattr(s, \"url\") else \"\"),\n                 \"title\": s.get(\"title\", s.title if hasattr(s, \"title\") else \"\")}\n                for s in sources[:3]\n            ]\n    return data\n\n\ndef convert_predictions_enricher(data: Dict[str, Any], context: Optional[Any]) -> Dict[str, Any]:\n    \"\"\"Convert raw predictions list to Prediction objects.\"\"\"\n    raw_predictions = data.get(\"_raw_predictions\", data.get(\"predictions\", []))\n\n    if not raw_predictions:\n        data[\"predictions\"] = []\n        return data\n\n    prediction_pipeline = create_prediction_pipeline()\n    converted = []\n\n    for pred in raw_predictions:\n        if isinstance(pred, Prediction):\n            converted.append(pred)\n        elif isinstance(pred, dict):\n            result = prediction_pipeline.transform(pred)\n            if result.success:\n                converted.append(result.value)\n        elif isinstance(pred, str):\n            result = prediction_pipeline.transform(pred)\n            if result.success:\n                converted.append(result.value)\n\n    data[\"predictions\"] = converted\n    # Remove temporary key\n    data.pop(\"_raw_predictions\", None)\n    return data\n\n\n# ============================================================================\n# Pre-built pipelines\n# ============================================================================\n\ndef create_finding_pipeline() -> TransformPipeline[Finding]:\n    \"\"\"Create a pipeline for Finding transformations.\"\"\"\n    return (\n        TransformPipeline(Finding)\n        .add_converter(finding_converter)\n        .add_enricher(add_finding_id_enricher)\n    )\n\n\ndef create_source_pipeline() -> TransformPipeline[Source]:\n    \"\"\"Create a pipeline for Source transformations.\"\"\"\n    return (\n        TransformPipeline(Source)\n        .add_converter(source_converter)\n    )\n\n\ndef create_prediction_pipeline() -> TransformPipeline[Prediction]:\n    \"\"\"Create a pipeline for Prediction transformations.\"\"\"\n    return (\n        TransformPipeline(Prediction)\n        .add_converter(prediction_converter)\n    )\n\n\ndef create_perspective_pipeline() -> TransformPipeline[Perspective]:\n    \"\"\"Create a pipeline for Perspective transformations (including predictions).\"\"\"\n\n    def perspective_with_raw_predictions(data: InputType) -> Dict[str, Any]:\n        \"\"\"Converter that preserves raw predictions for enricher.\"\"\"\n        result = perspective_converter(data)\n        result[\"_raw_predictions\"] = data.get(\"predictions\", [])\n        return result\n\n    return (\n        TransformPipeline(Perspective)\n        .add_converter(perspective_with_raw_predictions)\n        .add_enricher(convert_predictions_enricher)\n    )\n\n\ndef create_cost_summary_pipeline() -> TransformPipeline[CostSummary]:\n    \"\"\"Create a pipeline for CostSummary transformations.\"\"\"\n    return (\n        TransformPipeline(CostSummary)\n        .add_converter(cost_summary_converter)\n    )\n\n\n# ============================================================================\n# High-level transformation functions\n# ============================================================================\n\ndef transform_findings(\n    raw_findings: List[Dict[str, Any]],\n    sources: Optional[List[Dict[str, Any]]] = None,\n) -> List[Finding]:\n    \"\"\"\n    Transform a list of raw finding dicts to Finding objects.\n\n    Args:\n        raw_findings: List of raw finding dictionaries\n        sources: Optional list of sources to attach as supporting sources\n\n    Returns:\n        List of Finding objects\n    \"\"\"\n    pipeline = create_finding_pipeline()\n    if sources:\n        pipeline.add_enricher(add_supporting_sources_enricher)\n\n    def context_factory(index: int, item: Dict[str, Any]) -> Dict[str, Any]:\n        ctx = {\"index\": index}\n        if sources:\n            ctx[\"sources\"] = sources\n        return ctx\n\n    return pipeline.transform_many(raw_findings, context_factory)\n\n\ndef transform_sources(raw_sources: List[Dict[str, Any]]) -> List[Source]:\n    \"\"\"Transform a list of raw source dicts to Source objects.\"\"\"\n    pipeline = create_source_pipeline()\n    return pipeline.transform_many(raw_sources)\n\n\ndef transform_perspectives(raw_perspectives: List[Dict[str, Any]]) -> List[Perspective]:\n    \"\"\"Transform a list of raw perspective dicts to Perspective objects.\"\"\"\n    pipeline = create_perspective_pipeline()\n    return pipeline.transform_many(raw_perspectives)\n\n\ndef transform_cost_summary(raw_cost: Dict[str, Any]) -> CostSummary:\n    \"\"\"Transform a raw cost dict to CostSummary object.\"\"\"\n    pipeline = create_cost_summary_pipeline()\n    result = pipeline.transform(raw_cost)\n    if result.success:\n        return result.value\n    # Return default on failure\n    return CostSummary()\n\n\n# ============================================================================\n# Source extraction and credibility assessment\n# ============================================================================\n\ndef extract_source_dict(gemini_source: Any) -> Dict[str, Any]:\n    \"\"\"\n    Extract a dict from a GeminiSource or similar source object.\n\n    Args:\n        gemini_source: A source object with url, title, domain, snippet, source_type attributes\n\n    Returns:\n        Dictionary representation of the source\n    \"\"\"\n    return {\n        \"url\": getattr(gemini_source, \"url\", \"\"),\n        \"title\": getattr(gemini_source, \"title\", \"\"),\n        \"domain\": getattr(gemini_source, \"domain\", \"\"),\n        \"snippet\": getattr(gemini_source, \"snippet\", \"\"),\n        \"source_type\": getattr(gemini_source, \"source_type\", \"web\"),\n    }\n\n\ndef assess_credibility(source: Dict[str, Any]) -> float:\n    \"\"\"\n    Assess source credibility using Bayesian probability inference.\n\n    This uses a proper probabilistic model where:\n    - P(source is credible) depends on P(domain is authoritative)\n    - Domain authority is based on known authoritative sources\n    - Content signals can adjust the probability\n\n    Returns:\n        Credibility score between 0 and 1 (probability of credibility)\n    \"\"\"\n    from .bayesian_confidence import calculate_source_credibility\n\n    score, _ = calculate_source_credibility(source)\n    return score\n\n\ndef credibility_label(score: float) -> str:\n    \"\"\"Get credibility label from score.\"\"\"\n    if score >= 0.8:\n        return \"high\"\n    elif score >= 0.6:\n        return \"medium\"\n    else:\n        return \"low\"\n\n\ndef enrich_source_credibility(source: Dict[str, Any]) -> Dict[str, Any]:\n    \"\"\"Add credibility score and label to a source dict.\"\"\"\n    source[\"credibility_score\"] = assess_credibility(source)\n    source[\"credibility_label\"] = credibility_label(source[\"credibility_score\"])\n    return source\n\n\ndef extract_and_deduplicate_sources(\n    gemini_sources: List[Any],\n    enrich_credibility: bool = True,\n) -> List[Dict[str, Any]]:\n    \"\"\"\n    Extract sources from Gemini results, deduplicate, and optionally assess credibility.\n\n    Args:\n        gemini_sources: List of GeminiSource objects\n        enrich_credibility: Whether to add credibility scores\n\n    Returns:\n        List of deduplicated source dicts\n    \"\"\"\n    seen_urls = set()\n    unique_sources = []\n\n    for gs in gemini_sources:\n        source_dict = extract_source_dict(gs)\n        if source_dict[\"url\"] not in seen_urls:\n            seen_urls.add(source_dict[\"url\"])\n            if enrich_credibility:\n                source_dict = enrich_source_credibility(source_dict)\n            unique_sources.append(source_dict)\n\n    return unique_sources\n\n\ndef enrich_findings_with_ids_and_sources(\n    findings: List[Dict[str, Any]],\n    sources: List[Dict[str, Any]],\n    max_sources_per_finding: int = 3,\n) -> List[Dict[str, Any]]:\n    \"\"\"\n    Enrich findings with IDs and supporting sources.\n\n    Args:\n        findings: List of raw finding dicts\n        sources: List of source dicts to attach\n        max_sources_per_finding: Maximum sources to attach per finding\n\n    Returns:\n        Enriched findings list\n    \"\"\"\n    for i, finding in enumerate(findings):\n        finding[\"finding_id\"] = f\"f{i+1}\"\n        finding[\"supporting_sources\"] = [\n            {\"url\": s[\"url\"], \"title\": s[\"title\"]}\n            for s in sources[:max_sources_per_finding]\n        ]\n    return findings\n\n\n# ============================================================================\n# Batch transformation for complete research results\n# ============================================================================\n\n@dataclass\nclass TransformedResult:\n    \"\"\"Container for all transformed research result components.\"\"\"\n\n    findings: List[Finding]\n    sources: List[Source]\n    perspectives: List[Perspective]\n    cost_summary: CostSummary\n\n\ndef transform_research_result(result: Dict[str, Any]) -> TransformedResult:\n    \"\"\"\n    Transform a complete research result dict into typed components.\n\n    This is the main entry point for converting Cloud Run / research service\n    results into typed Pydantic models.\n\n    Args:\n        result: Raw research result dictionary\n\n    Returns:\n        TransformedResult with all typed components\n    \"\"\"\n    sources = transform_sources(result.get(\"sources\", []))\n\n    # Transform findings with sources context\n    findings = transform_findings(\n        result.get(\"findings\", []),\n        sources=[{\"url\": s.url, \"title\": s.title} for s in sources],\n    )\n\n    perspectives = transform_perspectives(result.get(\"perspectives\", []))\n    cost_summary = transform_cost_summary(result.get(\"cost_summary\", {}))\n\n    return TransformedResult(\n        findings=findings,\n        sources=sources,\n        perspectives=perspectives,\n        cost_summary=cost_summary,\n    )\n","numLines":579,"startLine":1,"totalLines":579}}}
