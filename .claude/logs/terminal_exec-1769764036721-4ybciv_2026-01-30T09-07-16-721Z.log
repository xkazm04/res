[2026-01-30T09:07:58.805Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011hTgFMrnTmWAJUaqQDCwpX","type":"tool_result","content":"     1→\"\"\"Report generation service.\"\"\"\n     2→\n     3→from typing import List, Dict, Any, Optional\n     4→from datetime import datetime\n     5→\n     6→from .report_interactive import generate_interactive_html\n     7→\n     8→\n     9→class ReportService:\n    10→    \"\"\"Generates markdown and HTML reports from research results.\"\"\"\n    11→\n    12→    def generate_markdown(\n    13→        self,\n    14→        research_result: Dict[str, Any],\n    15→        variant: str = \"full_report\",\n    16→        title: Optional[str] = None,\n    17→    ) -> str:\n    18→        \"\"\"\n    19→        Generate markdown report from research results.\n    20→\n    21→        Args:\n    22→            research_result: Dict from ResearchService.execute_research()\n    23→            variant: \"executive_summary\", \"full_report\", or \"investment_thesis\"\n    24→            title: Optional custom title\n    25→\n    26→        Returns:\n    27→            Formatted markdown string\n    28→        \"\"\"\n    29→        if variant == \"executive_summary\":\n    30→            return self._generate_executive_summary(research_result, title)\n    31→        elif variant == \"investment_thesis\":\n    32→            return self._generate_investment_thesis(research_result, title)\n    33→        else:\n    34→            return self._generate_full_report(research_result, title)\n    35→\n    36→    def generate_html(\n    37→        self,\n    38→        markdown_content: str,\n    39→        title: str = \"Research Report\",\n    40→        research_result: Optional[Dict[str, Any]] = None,\n    41→    ) -> str:\n    42→        \"\"\"\n    43→        Generate styled HTML report.\n    44→\n    45→        If research_result is provided, generates rich visual HTML.\n    46→        Otherwise, converts markdown to basic styled HTML.\n    47→        \"\"\"\n    48→        # Use interactive HTML if research result is available\n    49→        if research_result:\n    50→            return generate_interactive_html(research_result, title)\n    51→\n    52→        # Fallback to markdown conversion\n    53→        html_body = self._markdown_to_html(markdown_content)\n    54→\n    55→        return f\"\"\"<!DOCTYPE html>\n    56→<html lang=\"en\">\n    57→<head>\n    58→    <meta charset=\"UTF-8\">\n    59→    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    60→    <title>{title}</title>\n    61→    <style>\n    62→        body {{\n    63→            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;\n    64→            line-height: 1.6;\n    65→            max-width: 900px;\n    66→            margin: 0 auto;\n    67→            padding: 2rem;\n    68→            color: #333;\n    69→        }}\n    70→        h1 {{ color: #1a1a1a; border-bottom: 2px solid #eee; padding-bottom: 0.5rem; }}\n    71→        h2 {{ color: #2a2a2a; margin-top: 2rem; }}\n    72→        h3 {{ color: #3a3a3a; }}\n    73→        .finding {{ background: #f9f9f9; padding: 1rem; margin: 1rem 0; border-left: 4px solid #007bff; }}\n    74→        .finding-type {{ font-size: 0.8rem; color: #666; text-transform: uppercase; }}\n    75→        .confidence {{ color: #666; font-size: 0.9rem; font-style: italic; }}\n    76→        .source {{ margin: 0.5rem 0; }}\n    77→        .source a {{ color: #007bff; text-decoration: none; }}\n    78→        .source a:hover {{ text-decoration: underline; }}\n    79→        .perspective {{ background: #f0f7ff; padding: 1rem; margin: 1rem 0; border-radius: 4px; }}\n    80→        .insight {{ margin: 0.25rem 0; padding-left: 1rem; border-left: 2px solid #28a745; }}\n    81→        .warning {{ margin: 0.25rem 0; padding-left: 1rem; border-left: 2px solid #dc3545; }}\n    82→        hr {{ border: none; border-top: 1px solid #eee; margin: 2rem 0; }}\n    83→        table {{ border-collapse: collapse; width: 100%; margin: 1rem 0; }}\n    84→        th, td {{ border: 1px solid #ddd; padding: 0.5rem; text-align: left; }}\n    85→        th {{ background: #f5f5f5; }}\n    86→    </style>\n    87→</head>\n    88→<body>\n    89→{html_body}\n    90→</body>\n    91→</html>\"\"\"\n    92→\n    93→    def _generate_full_report(\n    94→        self,\n    95→        result: Dict[str, Any],\n    96→        title: Optional[str],\n    97→    ) -> str:\n    98→        \"\"\"Generate full detailed report.\"\"\"\n    99→        query = result.get(\"query\", \"Unknown Query\")\n   100→        template = result.get(\"template\", \"unknown\")\n   101→        report_title = title or f\"Research Report: {query[:50]}\"\n   102→\n   103→        sections = []\n   104→\n   105→        # Header\n   106→        sections.append(f\"# {report_title}\")\n   107→        sections.append(\"\")\n   108→        sections.append(f\"**Research Query:** {query}\")\n   109→        sections.append(f\"**Template:** {template.title()} Research\")\n   110→        sections.append(f\"**Generated:** {datetime.now().strftime('%B %d, %Y at %H:%M')}\")\n   111→        sections.append(f\"**Status:** {result.get('status', 'unknown').title()}\")\n   112→        sections.append(\"\")\n   113→        sections.append(\"---\")\n   114→        sections.append(\"\")\n   115→\n   116→        # Executive Summary\n   117→        sections.append(\"## Executive Summary\")\n   118→        sections.append(\"\")\n   119→        findings = result.get(\"findings\", [])\n   120→        if findings:\n   121→            high_conf = [f for f in findings if f.get(\"confidence_score\", 0) >= 0.7]\n   122→            sections.append(f\"This research identified **{len(findings)}** key findings across multiple categories.\")\n   123→            sections.append(f\"**{len(high_conf)}** findings have high confidence (>70%).\")\n   124→            sections.append(\"\")\n   125→\n   126→            # Key findings summary\n   127→            for finding in findings[:5]:\n   128→                ftype = finding.get(\"finding_type\", \"fact\").upper()\n   129→                summary = finding.get(\"summary\") or finding.get(\"content\", \"\")[:100]\n   130→                sections.append(f\"- **[{ftype}]** {summary}\")\n   131→            sections.append(\"\")\n   132→        else:\n   133→            sections.append(\"No significant findings were extracted.\")\n   134→            sections.append(\"\")\n   135→\n   136→        sections.append(\"---\")\n   137→        sections.append(\"\")\n   138→\n   139→        # Detailed Findings\n   140→        sections.append(\"## Detailed Findings\")\n   141→        sections.append(\"\")\n   142→\n   143→        # Group by type\n   144→        finding_types = {}\n   145→        for f in findings:\n   146→            ftype = f.get(\"finding_type\", \"other\")\n   147→            if ftype not in finding_types:\n   148→                finding_types[ftype] = []\n   149→            finding_types[ftype].append(f)\n   150→\n   151→        for ftype, type_findings in finding_types.items():\n   152→            sections.append(f\"### {ftype.title()} ({len(type_findings)})\")\n   153→            sections.append(\"\")\n   154→\n   155→            for finding in type_findings:\n   156→                conf = finding.get(\"confidence_score\", 0.5)\n   157→                conf_label = \"High\" if conf >= 0.8 else \"Medium\" if conf >= 0.6 else \"Low\"\n   158→                sections.append(f\"#### {finding.get('summary', finding.get('content', '')[:60])}\")\n   159→                sections.append(\"\")\n   160→                sections.append(finding.get(\"content\", \"\"))\n   161→                sections.append(\"\")\n   162→                sections.append(f\"*Confidence: {conf_label} ({conf:.0%})*\")\n   163→                sections.append(\"\")\n   164→\n   165→        sections.append(\"---\")\n   166→        sections.append(\"\")\n   167→\n   168→        # Perspectives\n   169→        perspectives = result.get(\"perspectives\", [])\n   170→        if perspectives:\n   171→            sections.append(\"## Multi-Perspective Analysis\")\n   172→            sections.append(\"\")\n   173→\n   174→            for perspective in perspectives:\n   175→                ptype = perspective.get(\"perspective_type\", \"unknown\").title()\n   176→                sections.append(f\"### {ptype} Perspective\")\n   177→                sections.append(\"\")\n   178→                sections.append(perspective.get(\"analysis_text\", \"\"))\n   179→                sections.append(\"\")\n   180→\n   181→                insights = perspective.get(\"key_insights\", [])\n   182→                if insights:\n   183→                    sections.append(\"**Key Insights:**\")\n   184→                    for insight in insights:\n   185→                        sections.append(f\"- {insight}\")\n   186→                    sections.append(\"\")\n   187→\n   188→                recs = perspective.get(\"recommendations\", [])\n   189→                if recs:\n   190→                    sections.append(\"**Recommendations:**\")\n   191→                    for rec in recs:\n   192→                        sections.append(f\"- {rec}\")\n   193→                    sections.append(\"\")\n   194→\n   195→                warnings = perspective.get(\"warnings\", [])\n   196→                if warnings:\n   197→                    sections.append(\"**Warnings:**\")\n   198→                    for warning in warnings:\n   199→                        sections.append(f\"- {warning}\")\n   200→                    sections.append(\"\")\n   201→\n   202→            sections.append(\"---\")\n   203→            sections.append(\"\")\n   204→\n   205→        # Sources\n   206→        sources = result.get(\"sources\", [])\n   207→        if sources:\n   208→            sections.append(\"## Sources\")\n   209→            sections.append(\"\")\n   210→\n   211→            for source in sources[:20]:\n   212→                title_text = source.get(\"title\", source.get(\"url\", \"Unknown\"))\n   213→                url = source.get(\"url\", \"#\")\n   214→                cred = source.get(\"credibility_score\", 0.5)\n   215→                sections.append(f\"- [{title_text}]({url}) - Credibility: {cred:.0%}\")\n   216→\n   217→            sections.append(\"\")\n   218→            sections.append(\"---\")\n   219→            sections.append(\"\")\n   220→\n   221→        # Metadata\n   222→        sections.append(\"## Research Metadata\")\n   223→        sections.append(\"\")\n   224→        sections.append(f\"- **Session ID:** {result.get('session_id', 'N/A')}\")\n   225→        sections.append(f\"- **Execution Time:** {result.get('execution_time_seconds', 0):.1f} seconds\")\n   226→\n   227→        cost = result.get(\"cost_summary\", {})\n   228→        if cost:\n   229→            sections.append(f\"- **Total Tokens:** {cost.get('total_tokens', 0):,}\")\n   230→            sections.append(f\"- **Total Cost:** ${cost.get('total_cost_usd', 0):.4f}\")\n   231→\n   232→        queries = result.get(\"search_queries_executed\", [])\n   233→        if queries:\n   234→            sections.append(f\"- **Searches Executed:** {len(queries)}\")\n   235→\n   236→        return \"\\n\".join(sections)\n   237→\n   238→    def _generate_executive_summary(\n   239→        self,\n   240→        result: Dict[str, Any],\n   241→        title: Optional[str],\n   242→    ) -> str:\n   243→        \"\"\"Generate brief executive summary.\"\"\"\n   244→        query = result.get(\"query\", \"Unknown Query\")\n   245→        report_title = title or f\"Executive Summary: {query[:40]}\"\n   246→\n   247→        sections = []\n   248→        sections.append(f\"# {report_title}\")\n   249→        sections.append(\"\")\n   250→        sections.append(f\"**Research Query:** {query}\")\n   251→        sections.append(f\"**Generated:** {datetime.now().strftime('%B %d, %Y')}\")\n   252→        sections.append(\"\")\n   253→        sections.append(\"---\")\n   254→        sections.append(\"\")\n   255→\n   256→        # Key findings\n   257→        sections.append(\"## Key Findings\")\n   258→        sections.append(\"\")\n   259→\n   260→        findings = result.get(\"findings\", [])\n   261→        high_conf = sorted(\n   262→            [f for f in findings if f.get(\"confidence_score\", 0) >= 0.6],\n   263→            key=lambda x: x.get(\"confidence_score\", 0),\n   264→            reverse=True\n   265→        )\n   266→\n   267→        for finding in high_conf[:7]:\n   268→            ftype = finding.get(\"finding_type\", \"fact\").upper()\n   269→            summary = finding.get(\"summary\") or finding.get(\"content\", \"\")[:150]\n   270→            sections.append(f\"- **[{ftype}]** {summary}\")\n   271→\n   272→        sections.append(\"\")\n   273→\n   274→        # Key perspectives\n   275→        perspectives = result.get(\"perspectives\", [])\n   276→        if perspectives:\n   277→            sections.append(\"## Expert Perspectives\")\n   278→            sections.append(\"\")\n   279→\n   280→            for p in perspectives:\n   281→                ptype = p.get(\"perspective_type\", \"\").title()\n   282→                insights = p.get(\"key_insights\", [])\n   283→                if insights:\n   284→                    sections.append(f\"**{ptype}:** {insights[0]}\")\n   285→\n   286→            sections.append(\"\")\n   287→\n   288→        sections.append(\"---\")\n   289→        sections.append(\"\")\n   290→        sections.append(f\"*Full report contains {len(findings)} findings from {len(result.get('sources', []))} sources.*\")\n   291→\n   292→        return \"\\n\".join(sections)\n   293→\n   294→    def _generate_investment_thesis(\n   295→        self,\n   296→        result: Dict[str, Any],\n   297→        title: Optional[str],\n   298→    ) -> str:\n   299→        \"\"\"Generate investment thesis report.\"\"\"\n   300→        query = result.get(\"query\", \"Unknown\")\n   301→        report_title = title or f\"Investment Thesis: {query[:40]}\"\n   302→\n   303→        sections = []\n   304→        sections.append(f\"# {report_title}\")\n   305→        sections.append(\"\")\n   306→        sections.append(f\"**Subject:** {query}\")\n   307→        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n   308→        sections.append(\"\")\n   309→        sections.append(\"---\")\n   310→        sections.append(\"\")\n   311→\n   312→        # Thesis summary\n   313→        sections.append(\"## Investment Thesis\")\n   314→        sections.append(\"\")\n   315→\n   316→        # Extract valuation perspective\n   317→        perspectives = result.get(\"perspectives\", [])\n   318→        valuation = next((p for p in perspectives if \"valuation\" in p.get(\"perspective_type\", \"\").lower()), None)\n   319→\n   320→        if valuation:\n   321→            sections.append(valuation.get(\"analysis_text\", \"\"))\n   322→            sections.append(\"\")\n   323→\n   324→        # Bull case\n   325→        sections.append(\"## Bull Case\")\n   326→        sections.append(\"\")\n   327→        findings = result.get(\"findings\", [])\n   328→        positive = [f for f in findings if f.get(\"confidence_score\", 0) >= 0.7]\n   329→        for f in positive[:5]:\n   330→            sections.append(f\"- {f.get('summary') or f.get('content', '')[:100]}\")\n   331→        sections.append(\"\")\n   332→\n   333→        # Bear case\n   334→        sections.append(\"## Bear Case / Risks\")\n   335→        sections.append(\"\")\n   336→        risks = [f for f in findings if f.get(\"finding_type\") in [\"pattern\", \"gap\"]]\n   337→        for f in risks[:5]:\n   338→            sections.append(f\"- {f.get('summary') or f.get('content', '')[:100]}\")\n   339→        sections.append(\"\")\n   340→\n   341→        # Recommendations\n   342→        sections.append(\"## Recommendations\")\n   343→        sections.append(\"\")\n   344→        for p in perspectives:\n   345→            recs = p.get(\"recommendations\", [])\n   346→            for rec in recs[:2]:\n   347→                sections.append(f\"- {rec}\")\n   348→        sections.append(\"\")\n   349→\n   350→        return \"\\n\".join(sections)\n   351→\n   352→    def _markdown_to_html(self, markdown: str) -> str:\n   353→        \"\"\"Simple markdown to HTML conversion.\"\"\"\n   354→        lines = markdown.split(\"\\n\")\n   355→        html_lines = []\n   356→        in_list = False\n   357→\n   358→        for line in lines:\n   359→            # Headers\n   360→            if line.startswith(\"# \"):\n   361→                html_lines.append(f\"<h1>{line[2:]}</h1>\")\n   362→            elif line.startswith(\"## \"):\n   363→                html_lines.append(f\"<h2>{line[3:]}</h2>\")\n   364→            elif line.startswith(\"### \"):\n   365→                html_lines.append(f\"<h3>{line[4:]}</h3>\")\n   366→            elif line.startswith(\"#### \"):\n   367→                html_lines.append(f\"<h4>{line[5:]}</h4>\")\n   368→            # Horizontal rule\n   369→            elif line.strip() == \"---\":\n   370→                html_lines.append(\"<hr>\")\n   371→            # List items\n   372→            elif line.startswith(\"- \"):\n   373→                if not in_list:\n   374→                    html_lines.append(\"<ul>\")\n   375→                    in_list = True\n   376→                # Handle bold and links\n   377→                content = self._format_inline(line[2:])\n   378→                html_lines.append(f\"<li>{content}</li>\")\n   379→            # Empty line\n   380→            elif line.strip() == \"\":\n   381→                if in_list:\n   382→                    html_lines.append(\"</ul>\")\n   383→                    in_list = False\n   384→                html_lines.append(\"\")\n   385→            # Regular paragraph\n   386→            else:\n   387→                if in_list:\n   388→                    html_lines.append(\"</ul>\")\n   389→                    in_list = False\n   390→                content = self._format_inline(line)\n   391→                html_lines.append(f\"<p>{content}</p>\")\n   392→\n   393→        if in_list:\n   394→            html_lines.append(\"</ul>\")\n   395→\n   396→        return \"\\n\".join(html_lines)\n   397→\n   398→    def _format_inline(self, text: str) -> str:\n   399→        \"\"\"Format inline markdown (bold, italic, links).\"\"\"\n   400→        import re\n   401→\n   402→        # Bold\n   403→        text = re.sub(r'\\*\\*(.+?)\\*\\*', r'<strong>\\1</strong>', text)\n   404→        # Italic\n   405→        text = re.sub(r'\\*(.+?)\\*', r'<em>\\1</em>', text)\n   406→        # Links\n   407→        text = re.sub(r'\\[(.+?)\\]\\((.+?)\\)', r'<a href=\"\\2\">\\1</a>', text)\n   408→\n   409→        return text\n   410→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"34eb5170-c9bb-41ec-b332-c49ff6c57668","uuid":"c3f220db-ee44-4a68-9f7b-b43063cfd74c","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\serverless\\src\\services\\report.py","content":"\"\"\"Report generation service.\"\"\"\n\nfrom typing import List, Dict, Any, Optional\nfrom datetime import datetime\n\nfrom .report_interactive import generate_interactive_html\n\n\nclass ReportService:\n    \"\"\"Generates markdown and HTML reports from research results.\"\"\"\n\n    def generate_markdown(\n        self,\n        research_result: Dict[str, Any],\n        variant: str = \"full_report\",\n        title: Optional[str] = None,\n    ) -> str:\n        \"\"\"\n        Generate markdown report from research results.\n\n        Args:\n            research_result: Dict from ResearchService.execute_research()\n            variant: \"executive_summary\", \"full_report\", or \"investment_thesis\"\n            title: Optional custom title\n\n        Returns:\n            Formatted markdown string\n        \"\"\"\n        if variant == \"executive_summary\":\n            return self._generate_executive_summary(research_result, title)\n        elif variant == \"investment_thesis\":\n            return self._generate_investment_thesis(research_result, title)\n        else:\n            return self._generate_full_report(research_result, title)\n\n    def generate_html(\n        self,\n        markdown_content: str,\n        title: str = \"Research Report\",\n        research_result: Optional[Dict[str, Any]] = None,\n    ) -> str:\n        \"\"\"\n        Generate styled HTML report.\n\n        If research_result is provided, generates rich visual HTML.\n        Otherwise, converts markdown to basic styled HTML.\n        \"\"\"\n        # Use interactive HTML if research result is available\n        if research_result:\n            return generate_interactive_html(research_result, title)\n\n        # Fallback to markdown conversion\n        html_body = self._markdown_to_html(markdown_content)\n\n        return f\"\"\"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>{title}</title>\n    <style>\n        body {{\n            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;\n            line-height: 1.6;\n            max-width: 900px;\n            margin: 0 auto;\n            padding: 2rem;\n            color: #333;\n        }}\n        h1 {{ color: #1a1a1a; border-bottom: 2px solid #eee; padding-bottom: 0.5rem; }}\n        h2 {{ color: #2a2a2a; margin-top: 2rem; }}\n        h3 {{ color: #3a3a3a; }}\n        .finding {{ background: #f9f9f9; padding: 1rem; margin: 1rem 0; border-left: 4px solid #007bff; }}\n        .finding-type {{ font-size: 0.8rem; color: #666; text-transform: uppercase; }}\n        .confidence {{ color: #666; font-size: 0.9rem; font-style: italic; }}\n        .source {{ margin: 0.5rem 0; }}\n        .source a {{ color: #007bff; text-decoration: none; }}\n        .source a:hover {{ text-decoration: underline; }}\n        .perspective {{ background: #f0f7ff; padding: 1rem; margin: 1rem 0; border-radius: 4px; }}\n        .insight {{ margin: 0.25rem 0; padding-left: 1rem; border-left: 2px solid #28a745; }}\n        .warning {{ margin: 0.25rem 0; padding-left: 1rem; border-left: 2px solid #dc3545; }}\n        hr {{ border: none; border-top: 1px solid #eee; margin: 2rem 0; }}\n        table {{ border-collapse: collapse; width: 100%; margin: 1rem 0; }}\n        th, td {{ border: 1px solid #ddd; padding: 0.5rem; text-align: left; }}\n        th {{ background: #f5f5f5; }}\n    </style>\n</head>\n<body>\n{html_body}\n</body>\n</html>\"\"\"\n\n    def _generate_full_report(\n        self,\n        result: Dict[str, Any],\n        title: Optional[str],\n    ) -> str:\n        \"\"\"Generate full detailed report.\"\"\"\n        query = result.get(\"query\", \"Unknown Query\")\n        template = result.get(\"template\", \"unknown\")\n        report_title = title or f\"Research Report: {query[:50]}\"\n\n        sections = []\n\n        # Header\n        sections.append(f\"# {report_title}\")\n        sections.append(\"\")\n        sections.append(f\"**Research Query:** {query}\")\n        sections.append(f\"**Template:** {template.title()} Research\")\n        sections.append(f\"**Generated:** {datetime.now().strftime('%B %d, %Y at %H:%M')}\")\n        sections.append(f\"**Status:** {result.get('status', 'unknown').title()}\")\n        sections.append(\"\")\n        sections.append(\"---\")\n        sections.append(\"\")\n\n        # Executive Summary\n        sections.append(\"## Executive Summary\")\n        sections.append(\"\")\n        findings = result.get(\"findings\", [])\n        if findings:\n            high_conf = [f for f in findings if f.get(\"confidence_score\", 0) >= 0.7]\n            sections.append(f\"This research identified **{len(findings)}** key findings across multiple categories.\")\n            sections.append(f\"**{len(high_conf)}** findings have high confidence (>70%).\")\n            sections.append(\"\")\n\n            # Key findings summary\n            for finding in findings[:5]:\n                ftype = finding.get(\"finding_type\", \"fact\").upper()\n                summary = finding.get(\"summary\") or finding.get(\"content\", \"\")[:100]\n                sections.append(f\"- **[{ftype}]** {summary}\")\n            sections.append(\"\")\n        else:\n            sections.append(\"No significant findings were extracted.\")\n            sections.append(\"\")\n\n        sections.append(\"---\")\n        sections.append(\"\")\n\n        # Detailed Findings\n        sections.append(\"## Detailed Findings\")\n        sections.append(\"\")\n\n        # Group by type\n        finding_types = {}\n        for f in findings:\n            ftype = f.get(\"finding_type\", \"other\")\n            if ftype not in finding_types:\n                finding_types[ftype] = []\n            finding_types[ftype].append(f)\n\n        for ftype, type_findings in finding_types.items():\n            sections.append(f\"### {ftype.title()} ({len(type_findings)})\")\n            sections.append(\"\")\n\n            for finding in type_findings:\n                conf = finding.get(\"confidence_score\", 0.5)\n                conf_label = \"High\" if conf >= 0.8 else \"Medium\" if conf >= 0.6 else \"Low\"\n                sections.append(f\"#### {finding.get('summary', finding.get('content', '')[:60])}\")\n                sections.append(\"\")\n                sections.append(finding.get(\"content\", \"\"))\n                sections.append(\"\")\n                sections.append(f\"*Confidence: {conf_label} ({conf:.0%})*\")\n                sections.append(\"\")\n\n        sections.append(\"---\")\n        sections.append(\"\")\n\n        # Perspectives\n        perspectives = result.get(\"perspectives\", [])\n        if perspectives:\n            sections.append(\"## Multi-Perspective Analysis\")\n            sections.append(\"\")\n\n            for perspective in perspectives:\n                ptype = perspective.get(\"perspective_type\", \"unknown\").title()\n                sections.append(f\"### {ptype} Perspective\")\n                sections.append(\"\")\n                sections.append(perspective.get(\"analysis_text\", \"\"))\n                sections.append(\"\")\n\n                insights = perspective.get(\"key_insights\", [])\n                if insights:\n                    sections.append(\"**Key Insights:**\")\n                    for insight in insights:\n                        sections.append(f\"- {insight}\")\n                    sections.append(\"\")\n\n                recs = perspective.get(\"recommendations\", [])\n                if recs:\n                    sections.append(\"**Recommendations:**\")\n                    for rec in recs:\n                        sections.append(f\"- {rec}\")\n                    sections.append(\"\")\n\n                warnings = perspective.get(\"warnings\", [])\n                if warnings:\n                    sections.append(\"**Warnings:**\")\n                    for warning in warnings:\n                        sections.append(f\"- {warning}\")\n                    sections.append(\"\")\n\n            sections.append(\"---\")\n            sections.append(\"\")\n\n        # Sources\n        sources = result.get(\"sources\", [])\n        if sources:\n            sections.append(\"## Sources\")\n            sections.append(\"\")\n\n            for source in sources[:20]:\n                title_text = source.get(\"title\", source.get(\"url\", \"Unknown\"))\n                url = source.get(\"url\", \"#\")\n                cred = source.get(\"credibility_score\", 0.5)\n                sections.append(f\"- [{title_text}]({url}) - Credibility: {cred:.0%}\")\n\n            sections.append(\"\")\n            sections.append(\"---\")\n            sections.append(\"\")\n\n        # Metadata\n        sections.append(\"## Research Metadata\")\n        sections.append(\"\")\n        sections.append(f\"- **Session ID:** {result.get('session_id', 'N/A')}\")\n        sections.append(f\"- **Execution Time:** {result.get('execution_time_seconds', 0):.1f} seconds\")\n\n        cost = result.get(\"cost_summary\", {})\n        if cost:\n            sections.append(f\"- **Total Tokens:** {cost.get('total_tokens', 0):,}\")\n            sections.append(f\"- **Total Cost:** ${cost.get('total_cost_usd', 0):.4f}\")\n\n        queries = result.get(\"search_queries_executed\", [])\n        if queries:\n            sections.append(f\"- **Searches Executed:** {len(queries)}\")\n\n        return \"\\n\".join(sections)\n\n    def _generate_executive_summary(\n        self,\n        result: Dict[str, Any],\n        title: Optional[str],\n    ) -> str:\n        \"\"\"Generate brief executive summary.\"\"\"\n        query = result.get(\"query\", \"Unknown Query\")\n        report_title = title or f\"Executive Summary: {query[:40]}\"\n\n        sections = []\n        sections.append(f\"# {report_title}\")\n        sections.append(\"\")\n        sections.append(f\"**Research Query:** {query}\")\n        sections.append(f\"**Generated:** {datetime.now().strftime('%B %d, %Y')}\")\n        sections.append(\"\")\n        sections.append(\"---\")\n        sections.append(\"\")\n\n        # Key findings\n        sections.append(\"## Key Findings\")\n        sections.append(\"\")\n\n        findings = result.get(\"findings\", [])\n        high_conf = sorted(\n            [f for f in findings if f.get(\"confidence_score\", 0) >= 0.6],\n            key=lambda x: x.get(\"confidence_score\", 0),\n            reverse=True\n        )\n\n        for finding in high_conf[:7]:\n            ftype = finding.get(\"finding_type\", \"fact\").upper()\n            summary = finding.get(\"summary\") or finding.get(\"content\", \"\")[:150]\n            sections.append(f\"- **[{ftype}]** {summary}\")\n\n        sections.append(\"\")\n\n        # Key perspectives\n        perspectives = result.get(\"perspectives\", [])\n        if perspectives:\n            sections.append(\"## Expert Perspectives\")\n            sections.append(\"\")\n\n            for p in perspectives:\n                ptype = p.get(\"perspective_type\", \"\").title()\n                insights = p.get(\"key_insights\", [])\n                if insights:\n                    sections.append(f\"**{ptype}:** {insights[0]}\")\n\n            sections.append(\"\")\n\n        sections.append(\"---\")\n        sections.append(\"\")\n        sections.append(f\"*Full report contains {len(findings)} findings from {len(result.get('sources', []))} sources.*\")\n\n        return \"\\n\".join(sections)\n\n    def _generate_investment_thesis(\n        self,\n        result: Dict[str, Any],\n        title: Optional[str],\n    ) -> str:\n        \"\"\"Generate investment thesis report.\"\"\"\n        query = result.get(\"query\", \"Unknown\")\n        report_title = title or f\"Investment Thesis: {query[:40]}\"\n\n        sections = []\n        sections.append(f\"# {report_title}\")\n        sections.append(\"\")\n        sections.append(f\"**Subject:** {query}\")\n        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n        sections.append(\"\")\n        sections.append(\"---\")\n        sections.append(\"\")\n\n        # Thesis summary\n        sections.append(\"## Investment Thesis\")\n        sections.append(\"\")\n\n        # Extract valuation perspective\n        perspectives = result.get(\"perspectives\", [])\n        valuation = next((p for p in perspectives if \"valuation\" in p.get(\"perspective_type\", \"\").lower()), None)\n\n        if valuation:\n            sections.append(valuation.get(\"analysis_text\", \"\"))\n            sections.append(\"\")\n\n        # Bull case\n        sections.append(\"## Bull Case\")\n        sections.append(\"\")\n        findings = result.get(\"findings\", [])\n        positive = [f for f in findings if f.get(\"confidence_score\", 0) >= 0.7]\n        for f in positive[:5]:\n            sections.append(f\"- {f.get('summary') or f.get('content', '')[:100]}\")\n        sections.append(\"\")\n\n        # Bear case\n        sections.append(\"## Bear Case / Risks\")\n        sections.append(\"\")\n        risks = [f for f in findings if f.get(\"finding_type\") in [\"pattern\", \"gap\"]]\n        for f in risks[:5]:\n            sections.append(f\"- {f.get('summary') or f.get('content', '')[:100]}\")\n        sections.append(\"\")\n\n        # Recommendations\n        sections.append(\"## Recommendations\")\n        sections.append(\"\")\n        for p in perspectives:\n            recs = p.get(\"recommendations\", [])\n            for rec in recs[:2]:\n                sections.append(f\"- {rec}\")\n        sections.append(\"\")\n\n        return \"\\n\".join(sections)\n\n    def _markdown_to_html(self, markdown: str) -> str:\n        \"\"\"Simple markdown to HTML conversion.\"\"\"\n        lines = markdown.split(\"\\n\")\n        html_lines = []\n        in_list = False\n\n        for line in lines:\n            # Headers\n            if line.startswith(\"# \"):\n                html_lines.append(f\"<h1>{line[2:]}</h1>\")\n            elif line.startswith(\"## \"):\n                html_lines.append(f\"<h2>{line[3:]}</h2>\")\n            elif line.startswith(\"### \"):\n                html_lines.append(f\"<h3>{line[4:]}</h3>\")\n            elif line.startswith(\"#### \"):\n                html_lines.append(f\"<h4>{line[5:]}</h4>\")\n            # Horizontal rule\n            elif line.strip() == \"---\":\n                html_lines.append(\"<hr>\")\n            # List items\n            elif line.startswith(\"- \"):\n                if not in_list:\n                    html_lines.append(\"<ul>\")\n                    in_list = True\n                # Handle bold and links\n                content = self._format_inline(line[2:])\n                html_lines.append(f\"<li>{content}</li>\")\n            # Empty line\n            elif line.strip() == \"\":\n                if in_list:\n                    html_lines.append(\"</ul>\")\n                    in_list = False\n                html_lines.append(\"\")\n            # Regular paragraph\n            else:\n                if in_list:\n                    html_lines.append(\"</ul>\")\n                    in_list = False\n                content = self._format_inline(line)\n                html_lines.append(f\"<p>{content}</p>\")\n\n        if in_list:\n            html_lines.append(\"</ul>\")\n\n        return \"\\n\".join(html_lines)\n\n    def _format_inline(self, text: str) -> str:\n        \"\"\"Format inline markdown (bold, italic, links).\"\"\"\n        import re\n\n        # Bold\n        text = re.sub(r'\\*\\*(.+?)\\*\\*', r'<strong>\\1</strong>', text)\n        # Italic\n        text = re.sub(r'\\*(.+?)\\*', r'<em>\\1</em>', text)\n        # Links\n        text = re.sub(r'\\[(.+?)\\]\\((.+?)\\)', r'<a href=\"\\2\">\\1</a>', text)\n\n        return text\n","numLines":410,"startLine":1,"totalLines":410}}}
