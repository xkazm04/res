54→            Dict with 'text', 'tokens', 'cost' keys\n    55→        \"\"\"\n    56→        if not self.is_available():\n    57→            raise ValueError(\"OpenRouter API key not configured\")\n    58→\n    59→        mime_type = self._get_mime_type(image_bytes)\n    60→        base64_image = base64.b64encode(image_bytes).decode(\"utf-8\")\n    61→\n    62→        headers = {\n    63→            \"Authorization\": f\"Bearer {self.api_key}\",\n    64→            \"Content-Type\": \"application/json\",\n    65→            \"HTTP-Referer\": \"https://apify-deep-research.app\",\n    66→            \"X-Title\": \"Deep Research Actor\"\n    67→        }\n    68→\n    69→        payload = {\n    70→            \"model\": self.model,\n    71→            \"messages\": [{\n    72→                \"role\": \"user\",\n    73→                \"content\": [\n    74→                    {\"type\": \"text\", \"text\": prompt or OCR_PROMPT},\n    75→                    {\n    76→                        \"type\": \"image_url\",\n    77→                        \"image_url\": {\n    78→                            \"url\": f\"data:{mime_type};base64,{base64_image}\"\n    79→                        }\n    80→                    }\n    81→                ]\n    82→            }],\n    83→            \"max_tokens\": max_tokens\n    84→        }\n    85→\n    86→        async with httpx.AsyncClient(timeout=120.0) as client:\n    87→            response = await client.post(\n    88→                f\"{self.base_url}/chat/completions\",\n    89→                headers=headers,\n    90→                json=payload\n    91→            )\n    92→            response.raise_for_status()\n    93→            data = response.json()\n    94→\n    95→        text = data[\"choices\"][0][\"message\"][\"content\"]\n    96→        usage = data.get(\"usage\", {})\n    97→\n    98→        return {\n    99→            \"text\": text,\n   100→            \"tokens\": usage.get(\"total_tokens\", 0),\n   101→            \"cost\": self._estimate_cost(usage)\n   102→        }\n   103→\n   104→    async def analyze_document(\n   105→        self,\n   106→        image_bytes: bytes,\n   107→        analysis_prompt: str,\n   108→    ) -> Dict[str, Any]:\n   109→        \"\"\"\n   110→        Analyze a document image with custom prompt.\n   111→\n   112→        Args:\n   113→            image_bytes: Raw image bytes\n   114→            analysis_prompt: Custom analysis prompt\n   115→\n   116→        Returns:\n   117→            Dict with 'text', 'tokens', 'cost' keys\n   118→        \"\"\"\n   119→        return await self.process_image(image_bytes, prompt=analysis_prompt)\n   120→\n   121→    def _get_mime_type(self, image_bytes: bytes) -> str:\n   122→        \"\"\"Detect image MIME type from magic bytes.\"\"\"\n   123→        if image_bytes[:8] == b'\\x89PNG\\r\\n\\x1a\\n':\n   124→            return \"image/png\"\n   125→        elif image_bytes[:2] == b'\\xff\\xd8':\n   126→            return \"image/jpeg\"\n   127→        elif image_bytes[:4] == b'GIF8':\n   128→            return \"image/gif\"\n   129→        elif image_bytes[:4] == b'RIFF' and image_bytes[8:12] == b'WEBP':\n   130→            return \"image/webp\"\n   131→        else:\n   132→            return \"image/png\"  # Default\n   133→\n   134→    def _estimate_cost(self, usage: Dict[str, Any]) -> Optional[float]:\n   135→        \"\"\"Estimate cost based on token usage.\"\"\"\n   136→        total = usage.get(\"total_tokens\", 0)\n   137→        if not total:\n   138→            return None\n   139→        # Gemini Flash rate via OpenRouter: ~$0.50/1M tokens\n   140→        return (total / 1_000_000) * 0.50\n   141→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"34eb5170-c9bb-41ec-b332-c49ff6c57668","uuid":"b5133741-5d1b-44a8-a8f7-a953e86c1893","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\actor\\src\\clients\\openrouter.py","content":"\"\"\"OpenRouter client for OCR using vision models.\"\"\"\n\nimport base64\nimport logging\nfrom typing import Optional, Dict, Any\n\nimport httpx\n\nlogger = logging.getLogger(__name__)\n\nOCR_PROMPT = \"\"\"Extract all text from this document image.\nPreserve the original structure including:\n- Paragraphs and line breaks\n- Tables (use markdown table format)\n- Lists (numbered and bulleted)\n- Headers and sections\n\nOutput the extracted text in clean Markdown format.\nOnly output the extracted content, no explanations.\"\"\"\n\n\nclass OpenRouterClient:\n    \"\"\"OCR client using OpenRouter API with vision models.\"\"\"\n\n    def __init__(\n        self,\n        api_key: str,\n        base_url: str = \"https://openrouter.ai/api/v1\",\n        model: str = \"google/gemini-2.0-flash-001\",\n    ):\n        self.api_key = api_key\n        self.base_url = base_url\n        self.model = model\n\n    def is_available(self) -> bool:\n        \"\"\"Check if API key is configured.\"\"\"\n        return bool(self.api_key)\n\n    async def process_image(\n        self,\n        image_bytes: bytes,\n        prompt: Optional[str] = None,\n        max_tokens: int = 4096,\n    ) -> Dict[str, Any]:\n        \"\"\"\n        Process an image with OCR.\n\n        Args:\n            image_bytes: Raw image bytes\n            prompt: Optional custom prompt (defaults to OCR_PROMPT)\n            max_tokens: Maximum output tokens\n\n        Returns:\n            Dict with 'text', 'tokens', 'cost' keys\n        \"\"\"\n        if not self.is_available():\n            raise ValueError(\"OpenRouter API key not configured\")\n\n        mime_type = self._get_mime_type(image_bytes)\n        base64_image = base64.b64encode(image_bytes).decode(\"utf-8\")\n\n        headers = {\n            \"Authorization\": f\"Bearer {self.api_key}\",\n            \"Content-Type\": \"application/json\",\n            \"HTTP-Referer\": \"https://apify-deep-research.app\",\n            \"X-Title\": \"Deep Research Actor\"\n        }\n\n        payload = {\n            \"model\": self.model,\n            \"messages\": [{\n                \"role\": \"user\",\n                \"content\": [\n                    {\"type\": \"text\", \"text\": prompt or OCR_PROMPT},\n                    {\n                        \"type\": \"image_url\",\n                        \"image_url\": {\n                            \"url\": f\"data:{mime_type};base64,{base64_image}\"\n                        }\n                    }\n                ]\n            }],\n            \"max_tokens\": max_tokens\n        }\n\n        async with httpx.AsyncClient(timeout=120.0) as client:\n            response = await client.post(\n                f\"{self.base_url}/chat/completions\",\n                headers=headers,\n                json=payload\n            )\n            response.raise_for_status()\n            data = response.json()\n\n        text = data[\"choices\"][0][\"message\"][\"content\"]\n        usage = data.get(\"usage\", {})\n\n        return {\n            \"text\": text,\n            \"tokens\": usage.get(\"total_tokens\", 0),\n            \"cost\": self._estimate_cost(usage)\n        }\n\n    async def analyze_document(\n        self,\n        image_bytes: bytes,\n        analysis_prompt: str,\n    ) -> Dict[str, Any]:\n        \"\"\"\n        Analyze a document image with custom prompt.\n\n        Args:\n            image_bytes: Raw image bytes\n            analysis_prompt: Custom analysis prompt\n\n        Returns:\n            Dict with 'text', 'tokens', 'cost' keys\n        \"\"\"\n        return await self.process_image(image_bytes, prompt=analysis_prompt)\n\n    def _get_mime_type(self, image_bytes: bytes) -> str:\n        \"\"\"Detect image MIME type from magic bytes.\"\"\"\n        if image_bytes[:8] == b'\\x89PNG\\r\\n\\x1a\\n':\n            return \"image/png\"\n        elif image_bytes[:2] == b'\\xff\\xd8':\n            return \"image/jpeg\"\n        elif image_bytes[:4] == b'GIF8':\n            return \"image/gif\"\n        elif image_bytes[:4] == b'RIFF' and image_bytes[8:12] == b'WEBP':\n            return \"image/webp\"\n        else:\n            return \"image/png\"  # Default\n\n    def _estimate_cost(self, usage: Dict[str, Any]) -> Optional[float]:\n        \"\"\"Estimate cost based on token usage.\"\"\"\n        total = usage.get(\"total_tokens\", 0)\n        if not total:\n            return None\n        # Gemini Flash rate via OpenRouter: ~$0.50/1M tokens\n        return (total / 1_000_000) * 0.50\n","numLines":141,"startLine":1,"totalLines":141}}}
