[2026-01-30T12:19:07.259Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018HvuJGFHrche2ML792r1ki","type":"tool_result","content":"     1→'use client';\n     2→\n     3→import { spring, easeOutCubic, easeOutQuart, easeOutExpo, easeInOutCubic } from './useVideoPlayback';\n     4→import { AnimatedBarChart, AnimatedLineChart, AnimatedPieChart, AnimatedCounter } from './AnimatedCharts';\n     5→import type { VideoFormat } from './VideoOverview';\n     6→\n     7→interface SceneProps {\n     8→  frame: number;\n     9→  fps: number;\n    10→  isRadar: boolean;\n    11→  format: VideoFormat;\n    12→}\n    13→\n    14→// Subtle pulse effect for breathing animations\n    15→function pulse(frame: number, fps: number, speed: number = 1): number {\n    16→  return 0.97 + Math.sin((frame / fps) * Math.PI * speed) * 0.03;\n    17→}\n    18→\n    19→// ============================================\n    20→// TITLE SCENE - News-style with bold typography\n    21→// ============================================\n    22→interface TitleSceneProps extends SceneProps {\n    23→  title: string;\n    24→  subtitle: string;\n    25→  date: string;\n    26→}\n    27→\n    28→export function TitleScene({ frame, fps, isRadar, format, title, subtitle, date }: TitleSceneProps) {\n    29→  const isMobile = format === 'mobile';\n    30→  const logoProgress = spring({ frame, fps, delay: 0, durationFrames: 22, easing: easeOutQuart });\n    31→  const glowProgress = spring({ frame, fps, delay: 3, durationFrames: 28, easing: easeOutCubic });\n    32→  const titleProgress = spring({ frame, fps, delay: 8, durationFrames: 26, easing: easeOutCubic });\n    33→  const subtitleProgress = spring({ frame, fps, delay: 16, durationFrames: 22, easing: easeOutCubic });\n    34→  const dateProgress = spring({ frame, fps, delay: 24, durationFrames: 20, easing: easeOutCubic });\n    35→  const breathe = pulse(frame, fps, 0.8);\n    36→\n    37→  return (\n    38→    <div className={`absolute inset-0 flex flex-col items-center overflow-hidden ${isMobile ? 'justify-start pt-16' : 'justify-center'}`}>\n    39→      {/* Background gradient orb */}\n    40→      <div\n    41→        className={`absolute ${isMobile ? 'w-64 h-64 top-1/4' : 'w-96 h-96'} rounded-full blur-3xl ${isRadar ? 'bg-cyan-500/10' : 'bg-stone-400/10'}`}\n    42→        style={{ opacity: glowProgress * 0.6, transform: `scale(${0.5 + glowProgress * 0.5 * breathe})` }}\n    43→      />\n    44→\n    45→      {/* Decorative rings */}\n    46→      <div\n    47→        className={`absolute ${isMobile ? 'w-24 h-24' : 'w-32 h-32'} rounded-full border ${isRadar ? 'border-cyan-500/20' : 'border-stone-400/20'}`}\n    48→        style={{ opacity: logoProgress * 0.5, transform: `scale(${0.8 + logoProgress * 0.4})` }}\n    49→      />\n    50→\n    51→      {/* Logo with glow */}\n    52→      <div className=\"relative\">\n    53→        <div\n    54→          className={`absolute inset-0 rounded-2xl blur-xl ${isRadar ? 'bg-cyan-500/40' : 'bg-stone-600/30'}`}\n    55→          style={{ opacity: glowProgress * 0.6, transform: `scale(${1.2 * breathe})` }}\n    56→        />\n    57→        <div\n    58→          className={`relative ${isMobile ? 'w-14 h-14' : 'w-16 h-16'} rounded-2xl flex items-center justify-center shadow-2xl ${\n    59→            isRadar ? 'bg-gradient-to-br from-cyan-400 to-blue-600' : 'bg-gradient-to-br from-stone-600 to-stone-800'\n    60→          }`}\n    61→          style={{ opacity: logoProgress, transform: `scale(${0.5 + logoProgress * 0.5})` }}\n    62→        >\n    63→          <svg className={`${isMobile ? 'w-7 h-7' : 'w-8 h-8'} text-white`} fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n    64→            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z\" />\n    65→          </svg>\n    66→        </div>\n    67→      </div>\n    68→\n    69→      {/* Title container */}\n    70→      <div className={`${isMobile ? 'mt-6 px-4' : 'mt-6 px-6'} text-center`}>\n    71→        {/* Subtitle badge - NEWS CATEGORY */}\n    72→        <div\n    73→          className={`mb-3 inline-flex items-center gap-1.5 px-3 py-1 rounded-full ${\n    74→            isRadar ? 'bg-red-500/20 border border-red-500/30' : 'bg-red-100 border border-red-200'\n    75→          }`}\n    76→          style={{ opacity: subtitleProgress, transform: `scale(${0.9 + subtitleProgress * 0.1})` }}\n    77→        >\n    78→          <span className={`text-[10px] font-bold tracking-wider ${isRadar ? 'text-red-400' : 'text-red-600'}`}>\n    79→            {subtitle}\n    80→          </span>\n    81→        </div>\n    82→\n    83→        {/* Main Title */}\n    84→        <h1\n    85→          className={`${isMobile ? 'text-xl' : 'text-2xl'} font-bold tracking-tight leading-tight ${\n    86→            isRadar ? 'bg-gradient-to-r from-white to-cyan-200 bg-clip-text text-transparent' : 'text-stone-900'\n    87→          }`}\n    88→          style={{ opacity: titleProgress, transform: `translateY(${(1 - titleProgress) * 10}px)` }}\n    89→        >\n    90→          {title}\n    91→        </h1>\n    92→\n    93→        {/* Date line */}\n    94→        <div\n    95→          className={`mt-3 flex items-center justify-center gap-2 ${isMobile ? 'text-xs' : 'text-sm'}`}\n    96→          style={{ opacity: dateProgress }}\n    97→        >\n    98→          <div className={`w-8 h-px ${isRadar ? 'bg-slate-600' : 'bg-stone-300'}`} />\n    99→          <span className={`${isRadar ? 'text-slate-400' : 'text-stone-500'}`}>{date}</span>\n   100→          <div className={`w-8 h-px ${isRadar ? 'bg-slate-600' : 'bg-stone-300'}`} />\n   101→        </div>\n   102→      </div>\n   103→\n   104→      {/* Mobile: Additional bottom element */}\n   105→      {isMobile && (\n   106→        <div\n   107→          className=\"absolute bottom-20 left-4 right-4\"\n   108→          style={{ opacity: dateProgress, transform: `translateY(${(1 - dateProgress) * 20}px)` }}\n   109→        >\n   110→          <div className={`h-px ${isRadar ? 'bg-gradient-to-r from-transparent via-cyan-500/30 to-transparent' : 'bg-gradient-to-r from-transparent via-stone-400/30 to-transparent'}`} />\n   111→          <p className={`mt-3 text-center text-xs ${isRadar ? 'text-slate-500' : 'text-stone-400'}`}>\n   112→            Swipe for insights ↓\n   113→          </p>\n   114→        </div>\n   115→      )}\n   116→    </div>\n   117→  );\n   118→}\n   119→\n   120→// ============================================\n   121→// METRICS SCENE - Data-driven news style\n   122→// ============================================\n   123→interface MetricsSceneProps extends SceneProps {\n   124→  metrics: Array<{ label: string; value: number; suffix?: string; color: string }>;\n   125→}\n   126→\n   127→export function MetricsScene({ frame, fps, isRadar, format, metrics }: MetricsSceneProps) {\n   128→  const isMobile = format === 'mobile';\n   129→  const headerProgress = spring({ frame, fps, delay: 0, durationFrames: 18, easing: easeOutCubic });\n   130→  const lineProgress = spring({ frame, fps, delay: 3, durationFrames: 22, easing: easeInOutCubic });\n   131→\n   132→  return (\n   133→    <div className={`absolute inset-0 ${isMobile ? 'p-4 pt-8' : 'p-5'}`}>\n   134→      {/* Background accent */}\n   135→      <div\n   136→        className={`absolute ${isMobile ? 'top-1/3 right-0' : 'top-0 right-0'} w-48 h-48 rounded-full blur-3xl ${isRadar ? 'bg-cyan-500/5' : 'bg-stone-400/5'}`}\n   137→        style={{ opacity: headerProgress }}\n   138→      />\n   139→\n   140→      {/* Header */}\n   141→      <div className={`${isMobile ? 'mb-4' : 'mb-5'}`}>\n   142→        <div\n   143→          className=\"flex items-center gap-2\"\n   144→          style={{ opacity: headerProgress, transform: `translateX(${(1 - headerProgress) * -12}px)` }}\n   145→        >\n   146→          <div className={`w-1 ${isMobile ? 'h-6' : 'h-7'} rounded-full ${isRadar ? 'bg-gradient-to-b from-cyan-400 to-cyan-600' : 'bg-gradient-to-b from-stone-600 to-stone-800'}`} />\n   147→          <h2 className={`${isMobile ? 'text-base' : 'text-lg'} font-bold ${isRadar ? 'text-white' : 'text-stone-900'}`}>Key Metrics</h2>\n   148→        </div>\n   149→        <div className={`h-px mt-3 ${isRadar ? 'bg-cyan-500/20' : 'bg-stone-300'}`} style={{ transform: `scaleX(${lineProgress})`, transformOrigin: 'left' }} />\n   150→      </div>\n   151→\n   152→      {/* Metrics grid */}\n   153→      <div className={`grid ${isMobile ? 'grid-cols-2 gap-3' : 'grid-cols-4 gap-3'}`}>\n   154→        {metrics.map((m, i) => (\n   155→          <MetricCard key={i} {...m} index={i} frame={frame} fps={fps} isRadar={isRadar} format={format} />\n   156→        ))}\n   157→      </div>\n   158→    </div>\n   159→  );\n   160→}\n   161→\n   162→function MetricCard({ label, value, suffix = '', color, index, frame, fps, isRadar, format }: {\n   163→  label: string; value: number; suffix?: string; color: string; index: number; frame: number; fps: number; isRadar: boolean; format: VideoFormat;\n   164→}) {\n   165→  const isMobile = format === 'mobile';\n   166→  const progress = spring({ frame, fps, delay: 6 + index * 4, durationFrames: 22, easing: easeOutQuart });\n   167→  const countProgress = spring({ frame, fps, delay: 12 + index * 4, durationFrames: 32, easing: easeOutCubic });\n   168→  const glowProgress = spring({ frame, fps, delay: 16 + index * 4, durationFrames: 18, easing: easeOutCubic });\n   169→  const breathe = pulse(frame, fps, 0.6);\n   170→\n   171→  const colorMap: Record<string, { bg: string; border: string; text: string; glow: string }> = {\n   172→    cyan: {\n   173→      bg: isRadar ? 'bg-cyan-500/8' : 'bg-blue-50',\n   174→      border: isRadar ? 'border-cyan-500/25' : 'border-blue-200',\n   175→      text: isRadar ? 'text-cyan-400' : 'text-blue-600',\n   176→      glow: isRadar ? 'bg-cyan-500/20' : 'bg-blue-500/10'\n   177→    },\n   178→    emerald: {\n   179→      bg: isRadar ? 'bg-emerald-500/8' : 'bg-emerald-50',\n   180→      border: isRadar ? 'border-emerald-500/25' : 'border-emerald-200',\n   181→      text: isRadar ? 'text-emerald-400' : 'text-emerald-600',\n   182→      glow: isRadar ? 'bg-emerald-500/20' : 'bg-emerald-500/10'\n   183→    },\n   184→    amber: {\n   185→      bg: isRadar ? 'bg-amber-500/8' : 'bg-amber-50',\n   186→      border: isRadar ? 'border-amber-500/25' : 'border-amber-200',\n   187→      text: isRadar ? 'text-amber-400' : 'text-amber-600',\n   188→      glow: isRadar ? 'bg-amber-500/20' : 'bg-amber-500/10'\n   189→    },\n   190→    rose: {\n   191→      bg: isRadar ? 'bg-rose-500/8' : 'bg-rose-50',\n   192→      border: isRadar ? 'border-rose-500/25' : 'border-rose-200',\n   193→      text: isRadar ? 'text-rose-400' : 'text-rose-600',\n   194→      glow: isRadar ? 'bg-rose-500/20' : 'bg-rose-500/10'\n   195→    },\n   196→  };\n   197→\n   198→  const colors = colorMap[color] || colorMap.cyan;\n   199→\n   200→  return (\n   201→    <div className=\"relative\">\n   202→      <div\n   203→        className={`absolute inset-0 rounded-xl blur-xl ${colors.glow}`}\n   204→        style={{ opacity: glowProgress * 0.4, transform: `scale(${1.1 * breathe})` }}\n   205→      />\n   206→      <div\n   207→        className={`relative ${isMobile ? 'p-3' : 'p-3'} rounded-xl border backdrop-blur-sm ${colors.bg} ${colors.border}`}\n   208→        style={{ opacity: progress, transform: `translateY(${(1 - progress) * 15}px)` }}\n   209→      >\n   210→        <div className={`${isMobile ? 'text-[9px]' : 'text-[10px]'} uppercase tracking-wider font-medium mb-1 ${isRadar ? 'text-slate-400' : 'text-stone-500'}`}>\n   211→          {label}\n   212→        </div>\n   213→        <div className={`${isMobile ? 'text-2xl' : 'text-2xl'} font-bold tabular-nums ${colors.text}`}>\n   214→          {Math.round(value * countProgress)}{suffix}\n   215→        </div>\n   216→        {/* Mini progress bar */}\n   217→        <div className={`mt-2 h-0.5 rounded-full ${isRadar ? 'bg-slate-800' : 'bg-stone-200'}`}>\n   218→          <div\n   219→            className={`h-full rounded-full ${colors.text.replace('text-', 'bg-')}`}\n   220→            style={{ width: `${countProgress * 100}%`, opacity: 0.5 }}\n   221→          />\n   222→        </div>\n   223→      </div>\n   224→    </div>\n   225→  );\n   226→}\n   227→\n   228→// ============================================\n   229→// CHARTS SCENE - Data visualization\n   230→// ============================================\n   231→interface ChartsSceneProps extends SceneProps {\n   232→  barData: Array<{ label: string; value: number }>;\n   233→  lineData: number[];\n   234→  pieData: Array<{ label: string; value: number; color: string }>;\n   235→}\n   236→\n   237→export function ChartsScene({ frame, fps, isRadar, format, barData, lineData, pieData }: ChartsSceneProps) {\n   238→  const isMobile = format === 'mobile';\n   239→  const headerProgress = spring({ frame, fps, delay: 0, durationFrames: 18, easing: easeOutCubic });\n   240→  const lineProgress = spring({ frame, fps, delay: 3, durationFrames: 22, easing: easeInOutCubic });\n   241→  const chart1Progress = spring({ frame, fps, delay: 6, durationFrames: 20, easing: easeOutQuart });\n   242→  const chart2Progress = spring({ frame, fps, delay: 12, durationFrames: 20, easing: easeOutQuart });\n   243→  const chart3Progress = spring({ frame, fps, delay: 18, durationFrames: 20, easing: easeOutQuart });\n   244→\n   245→  // Mobile layout: vertical stack\n   246→  if (isMobile) {\n   247→    return (\n   248→      <div className=\"absolute inset-0 p-4 pt-8\">\n   249→        {/* Header */}\n   250→        <div className=\"mb-3\">\n   251→          <div\n   252→            className=\"flex items-center gap-2\"\n   253→            style={{ opacity: headerProgress, transform: `translateX(${(1 - headerProgress) * -12}px)` }}\n   254→          >\n   255→            <div className=\"w-1 h-6 rounded-full bg-gradient-to-b from-blue-400 to-cyan-600\" />\n   256→            <h2 className={`text-base font-bold ${isRadar ? 'text-white' : 'text-stone-900'}`}>Data Analysis</h2>\n   257→          </div>\n   258→          <div className={`h-px mt-2 ${isRadar ? 'bg-cyan-500/20' : 'bg-stone-300'}`} style={{ transform: `scaleX(${lineProgress})`, transformOrigin: 'left' }} />\n   259→        </div>\n   260→\n   261→        {/* Charts - vertical stack for mobile */}\n   262→        <div className=\"space-y-3\">\n   263→          {/* Bar + Pie row */}\n   264→          <div className=\"flex gap-3\">\n   265→            <div\n   266→              className={`flex-1 p-3 rounded-xl ${isRadar ? 'bg-slate-900/70 border border-cyan-500/15' : 'bg-white/90 border border-stone-200'}`}\n   267→              style={{ opacity: chart1Progress, transform: `translateY(${(1 - chart1Progress) * 10}px)` }}\n   268→            >\n   269→              <div className={`text-[9px] font-medium mb-2 ${isRadar ? 'text-cyan-400/80' : 'text-stone-500'}`}>Distribution</div>\n   270→              <AnimatedBarChart data={barData} frame={frame - 10} fps={fps} width={100} height={70} isRadar={isRadar} />\n   271→            </div>\n   272→\n   273→            <div\n   274→              className={`flex-1 p-3 rounded-xl flex flex-col items-center ${isRadar ? 'bg-slate-900/70 border border-violet-500/15' : 'bg-white/90 border border-stone-200'}`}\n   275→              style={{ opacity: chart3Progress, transform: `translateY(${(1 - chart3Progress) * 10}px)` }}\n   276→            >\n   277→              <div className={`text-[9px] font-medium mb-2 self-start ${isRadar ? 'text-violet-400/80' : 'text-stone-500'}`}>Sources</div>\n   278→              <AnimatedPieChart data={pieData} frame={frame - 24} fps={fps} size={70} isRadar={isRadar} />\n   279→            </div>\n   280→          </div>\n   281→\n   282→          {/* Line chart - full width */}\n   283→          <div\n   284→            className={`p-3 rounded-xl ${isRadar ? 'bg-slate-900/70 border border-emerald-500/15' : 'bg-white/90 border border-stone-200'}`}\n   285→            style={{ opacity: chart2Progress, transform: `translateY(${(1 - chart2Progress) * 10}px)` }}\n   286→          >\n   287→            <div className={`text-[9px] font-medium mb-2 ${isRadar ? 'text-emerald-400/80' : 'text-stone-500'}`}>Confidence Trend</div>\n   288→            <AnimatedLineChart data={lineData} frame={frame - 18} fps={fps} width={230} height={80} isRadar={isRadar} />\n   289→          </div>\n   290→        </div>\n   291→      </div>\n   292→    );\n   293→  }\n   294→\n   295→  // Standard layout: horizontal\n   296→  return (\n   297→    <div className=\"absolute inset-0 p-5\">\n   298→      <div\n   299→        className={`absolute bottom-0 left-0 w-48 h-48 rounded-full blur-3xl ${isRadar ? 'bg-blue-500/5' : 'bg-stone-400/5'}`}\n   300→        style={{ opacity: headerProgress }}\n   301→      />\n   302→\n   303→      <div className=\"mb-4\">\n   304→        <div\n   305→          className=\"flex items-center gap-2\"\n   306→          style={{ opacity: headerProgress, transform: `translateX(${(1 - headerProgress) * -12}px)` }}\n   307→        >\n   308→          <div className=\"w-1 h-7 rounded-full bg-gradient-to-b from-blue-400 to-cyan-600\" />\n   309→          <h2 className={`text-lg font-bold ${isRadar ? 'text-white' : 'text-stone-900'}`}>Data Analysis</h2>\n   310→        </div>\n   311→        <div className={`h-px mt-3 ${isRadar ? 'bg-cyan-500/20' : 'bg-stone-300'}`} style={{ transform: `scaleX(${lineProgress})`, transformOrigin: 'left' }} />\n   312→      </div>\n   313→\n   314→      <div className=\"grid grid-cols-3 gap-3\" style={{ height: 170 }}>\n   315→        <div className=\"relative\">\n   316→          <div\n   317→            className={`absolute inset-0 rounded-xl blur-lg ${isRadar ? 'bg-cyan-500/10' : 'bg-blue-500/5'}`}\n   318→            style={{ opacity: chart1Progress * 0.3 }}\n   319→          />\n   320→          <div\n   321→            className={`relative h-full p-3 rounded-xl backdrop-blur-sm ${isRadar ? 'bg-slate-900/70 border border-cyan-500/15' : 'bg-white/90 border border-stone-200'}`}\n   322→            style={{ opacity: chart1Progress, transform: `translateY(${(1 - chart1Progress) * 10}px) scale(${0.96 + chart1Progress * 0.04})` }}\n   323→          >\n   324→            <div className={`text-[10px] font-medium mb-2 ${isRadar ? 'text-cyan-400/80' : 'text-stone-500'}`}>Distribution</div>\n   325→            <AnimatedBarChart data={barData} frame={frame - 10} fps={fps} width={165} height={120} isRadar={isRadar} />\n   326→          </div>\n   327→        </div>\n   328→\n   329→        <div className=\"relative\">\n   330→          <div\n   331→            className={`absolute inset-0 rounded-xl blur-lg ${isRadar ? 'bg-emerald-500/10' : 'bg-emerald-500/5'}`}\n   332→            style={{ opacity: chart2Progress * 0.3 }}\n   333→          />\n   334→          <div\n   335→            className={`relative h-full p-3 rounded-xl backdrop-blur-sm ${isRadar ? 'bg-slate-900/70 border border-emerald-500/15' : 'bg-white/90 border border-stone-200'}`}\n   336→            style={{ opacity: chart2Progress, transform: `translateY(${(1 - chart2Progress) * 10}px) scale(${0.96 + chart2Progress * 0.04})` }}\n   337→          >\n   338→            <div className={`text-[10px] font-medium mb-2 ${isRadar ? 'text-emerald-400/80' : 'text-stone-500'}`}>Confidence Trend</div>\n   339→            <AnimatedLineChart data={lineData} frame={frame - 18} fps={fps} width={165} height={120} isRadar={isRadar} />\n   340→          </div>\n   341→        </div>\n   342→\n   343→        <div className=\"relative\">\n   344→          <div\n   345→            className={`absolute inset-0 rounded-xl blur-lg ${isRadar ? 'bg-violet-500/10' : 'bg-violet-500/5'}`}\n   346→            style={{ opacity: chart3Progress * 0.3 }}\n   347→          />\n   348→          <div\n   349→            className={`relative h-full p-3 rounded-xl flex flex-col backdrop-blur-sm ${isRadar ? 'bg-slate-900/70 border border-violet-500/15' : 'bg-white/90 border border-stone-200'}`}\n   350→            style={{ opacity: chart3Progress, transform: `translateY(${(1 - chart3Progress) * 10}px) scale(${0.96 + chart3Progress * 0.04})` }}\n   351→          >\n   352→            <div className={`text-[10px] font-medium mb-2 ${isRadar ? 'text-violet-400/80' : 'text-stone-500'}`}>Source Mix</div>\n   353→            <div className=\"flex-1 flex items-center justify-center\">\n   354→              <AnimatedPieChart data={pieData} frame={frame - 26} fps={fps} size={100} isRadar={isRadar} />\n   355→            </div>\n   356→          </div>\n   357→        </div>\n   358→      </div>\n   359→    </div>\n   360→  );\n   361→}\n   362→\n   363→// ============================================\n   364→// INSIGHTS SCENE - Key findings highlight\n   365→// ============================================\n   366→interface InsightsSceneProps extends SceneProps {\n   367→  insights: string[];\n   368→  warnings: string[];\n   369→}\n   370→\n   371→export function InsightsScene({ frame, fps, isRadar, format, insights, warnings }: InsightsSceneProps) {\n   372→  const isMobile = format === 'mobile';\n   373→  const headerProgress = spring({ frame, fps, delay: 0, durationFrames: 18, easing: easeOutCubic });\n   374→  const lineProgress = spring({ frame, fps, delay: 3, durationFrames: 22, easing: easeInOutCubic });\n   375→  const col1Progress = spring({ frame, fps, delay: 6, durationFrames: 20, easing: easeOutQuart });\n   376→  const col2Progress = spring({ frame, fps, delay: 12, durationFrames: 20, easing: easeOutQuart });\n   377→\n   378→  // Mobile: vertical stack\n   379→  if (isMobile) {\n   380→    return (\n   381→      <div className=\"absolute inset-0 p-4 pt-8\">\n   382→        <div\n   383→          className={`absolute top-1/3 left-1/2 w-32 h-32 rounded-full blur-3xl ${isRadar ? 'bg-emerald-500/5' : 'bg-emerald-400/5'}`}\n   384→          style={{ opacity: headerProgress }}\n   385→        />\n   386→\n   387→        <div className=\"mb-3\">\n   388→          <div\n   389→            className=\"flex items-center gap-2\"\n   390→            style={{ opacity: headerProgress, transform: `translateX(${(1 - headerProgress) * -12}px)` }}\n   391→          >\n   392→            <div className=\"w-1 h-6 rounded-full bg-gradient-to-b from-emerald-400 to-emerald-600\" />\n   393→            <h2 className={`text-base font-bold ${isRadar ? 'text-white' : 'text-stone-900'}`}>Key Findings</h2>\n   394→          </div>\n   395→          <div className={`h-px mt-2 ${isRadar ? 'bg-emerald-500/20' : 'bg-stone-300'}`} style={{ transform: `scaleX(${lineProgress})`, transformOrigin: 'left' }} />\n   396→        </div>\n   397→\n   398→        {/* Vertical stack for mobile */}\n   399→        <div className=\"space-y-3\">\n   400→          {/* Insights */}\n   401→          <div\n   402→            className={`p-3 rounded-xl ${isRadar ? 'bg-emerald-500/5 border border-emerald-500/15' : 'bg-emerald-50/50 border border-emerald-200'}`}\n   403→            style={{ opacity: col1Progress, transform: `translateY(${(1 - col1Progress) * 10}px)` }}\n   404→          >\n   405→            <div className={`text-[9px] uppercase tracking-wider font-semibold mb-2 flex items-center gap-1.5 ${isRadar ? 'text-emerald-400' : 'text-emerald-600'}`}>\n   406→              <span>💡</span> Insights\n   407→            </div>\n   408→            <div className=\"space-y-2\">\n   409→              {insights.slice(0, 2).map((text, i) => (\n   410→                <InsightItem key={i} text={text} type=\"insight\" index={i} frame={frame} fps={fps} isRadar={isRadar} format={format} />\n   411→              ))}\n   412→              {insights.length === 0 && (\n   413→                <p className={`text-xs italic ${isRadar ? 'text-slate-500' : 'text-stone-400'}`}>No insights available</p>\n   414→              )}\n   415→            </div>\n   416→          </div>\n   417→\n   418→          {/* Warnings */}\n   419→          <div\n   420→            className={`p-3 rounded-xl ${isRadar ? 'bg-amber-500/5 border border-amber-500/15' : 'bg-amber-50/50 border border-amber-200'}`}\n   421→            style={{ opacity: col2Progress, transform: `translateY(${(1 - col2Progress) * 10}px)` }}\n   422→          >\n   423→            <div className={`text-[9px] uppercase tracking-wider font-semibold mb-2 flex items-center gap-1.5 ${isRadar ? 'text-amber-400' : 'text-amber-600'}`}>\n   424→              <span>⚠️</span> Alerts\n   425→            </div>\n   426→            <div className=\"space-y-2\">\n   427→              {warnings.slice(0, 2).map((text, i) => (\n   428→                <InsightItem key={i} text={text} type=\"warning\" index={i + insights.length} frame={frame} fps={fps} isRadar={isRadar} format={format} />\n   429→              ))}\n   430→              {warnings.length === 0 && (\n   431→                <p className={`text-xs italic ${isRadar ? 'text-slate-500' : 'text-stone-400'}`}>No alerts</p>\n   432→              )}\n   433→            </div>\n   434→          </div>\n   435→        </div>\n   436→      </div>\n   437→    );\n   438→  }\n   439→\n   440→  // Standard: two columns\n   441→  return (\n   442→    <div className=\"absolute inset-0 p-5\">\n   443→      <div\n   444→        className={`absolute top-1/2 left-1/4 w-36 h-36 rounded-full blur-3xl ${isRadar ? 'bg-emerald-500/5' : 'bg-emerald-400/5'}`}\n   445→        style={{ opacity: headerProgress }}\n   446→      />\n   447→      <div\n   448→        className={`absolute top-1/2 right-1/4 w-36 h-36 rounded-full blur-3xl ${isRadar ? 'bg-amber-500/5' : 'bg-amber-400/5'}`}\n   449→        style={{ opacity: headerProgress }}\n   450→      />\n   451→\n   452→      <div className=\"mb-4\">\n   453→        <div\n   454→          className=\"flex items-center gap-2\"\n   455→          style={{ opacity: headerProgress, transform: `translateX(${(1 - headerProgress) * -12}px)` }}\n   456→        >\n   457→          <div className=\"w-1 h-7 rounded-full bg-gradient-to-b from-emerald-400 to-emerald-600\" />\n   458→          <h2 className={`text-lg font-bold ${isRadar ? 'text-white' : 'text-stone-900'}`}>Key Findings</h2>\n   459→        </div>\n   460→        <div className={`h-px mt-3 ${isRadar ? 'bg-emerald-500/20' : 'bg-stone-300'}`} style={{ transform: `scaleX(${lineProgress})`, transformOrigin: 'left' }} />\n   461→      </div>\n   462→\n   463→      <div className=\"grid grid-cols-2 gap-4\">\n   464→        <div\n   465→          className={`p-3 rounded-xl ${isRadar ? 'bg-emerald-500/5 border border-emerald-500/15' : 'bg-emerald-50/50 border border-emerald-200'}`}\n   466→          style={{ opacity: col1Progress, transform: `translateX(${(1 - col1Progress) * -12}px)` }}\n   467→        >\n   468→          <div className={`text-[10px] uppercase tracking-wider font-semibold mb-3 flex items-center gap-1.5 ${isRadar ? 'text-emerald-400' : 'text-emerald-600'}`}>\n   469→            <span>💡</span> Insights\n   470→          </div>\n   471→          <div className=\"space-y-2\">\n   472→            {insights.slice(0, 3).map((text, i) => (\n   473→              <InsightItem key={i} text={text} type=\"insight\" index={i} frame={frame} fps={fps} isRadar={isRadar} format={format} />\n   474→            ))}\n   475→            {insights.length === 0 && (\n   476→              <p className={`text-xs italic ${isRadar ? 'text-slate-500' : 'text-stone-400'}`}>No insights available</p>\n   477→            )}\n   478→          </div>\n   479→        </div>\n   480→\n   481→        <div\n   482→          className={`p-3 rounded-xl ${isRadar ? 'bg-amber-500/5 border border-amber-500/15' : 'bg-amber-50/50 border border-amber-200'}`}\n   483→          style={{ opacity: col2Progress, transform: `translateX(${(1 - col2Progress) * 12}px)` }}\n   484→        >\n   485→          <div className={`text-[10px] uppercase tracking-wider font-semibold mb-3 flex items-center gap-1.5 ${isRadar ? 'text-amber-400' : 'text-amber-600'}`}>\n   486→            <span>⚠️</span> Alerts\n   487→          </div>\n   488→          <div className=\"space-y-2\">\n   489→            {warnings.slice(0, 2).map((text, i) => (\n   490→              <InsightItem key={i} text={text} type=\"warning\" index={i + insights.length} frame={frame} fps={fps} isRadar={isRadar} format={format} />\n   491→            ))}\n   492→            {warnings.length === 0 && (\n   493→              <p className={`text-xs italic ${isRadar ? 'text-slate-500' : 'text-stone-400'}`}>No alerts</p>\n   494→            )}\n   495→          </div>\n   496→        </div>\n   497→      </div>\n   498→    </div>\n   499→  );\n   500→}\n   501→\n   502→function InsightItem({ text, type, index, frame, fps, isRadar, format }: {\n   503→  text: string; type: 'insight' | 'warning'; index: number; frame: number; fps: number; isRadar: boolean; format: VideoFormat;\n   504→}) {\n   505→  const isMobile = format === 'mobile';\n   506→  const progress = spring({ frame, fps, delay: 6 + index * 6, durationFrames: 22, easing: easeOutCubic });\n   507→  const color = type === 'insight'\n   508→    ? (isRadar ? 'text-emerald-200' : 'text-emerald-800')\n   509→    : (isRadar ? 'text-amber-200' : 'text-amber-800');\n   510→\n   511→  const maxLen = isMobile ? 60 : 85;\n   512→\n   513→  return (\n   514→    <div\n   515→      className={`flex items-start gap-2 p-2 rounded-lg ${isRadar ? 'bg-slate-900/30' : 'bg-white/60'}`}\n   516→      style={{ opacity: progress, transform: `translateY(${(1 - progress) * 8}px)` }}\n   517→    >\n   518→      <div className={`w-1 h-1 rounded-full mt-1.5 flex-shrink-0 ${type === 'insight' ? (isRadar ? 'bg-emerald-400' : 'bg-emerald-500') : (isRadar ? 'bg-amber-400' : 'bg-amber-500')}`} />\n   519→      <p className={`${isMobile ? 'text-[11px]' : 'text-xs'} leading-relaxed ${color}`}>{text.slice(0, maxLen)}{text.length > maxLen ? '...' : ''}</p>\n   520→    </div>\n   521→  );\n   522→}\n   523→\n   524→// ============================================\n   525→// SUMMARY SCENE - Dramatic finale\n   526→// ============================================\n   527→interface SummarySceneProps extends SceneProps {\n   528→  confidence: number;\n   529→  findings: number;\n   530→  sources: number;\n   531→}\n   532→\n   533→export function SummaryScene({ frame, fps, isRadar, format, confidence, findings, sources }: SummarySceneProps) {\n   534→  const isMobile = format === 'mobile';\n   535→  const bgProgress = spring({ frame, fps, delay: 0, durationFrames: 28, easing: easeOutCubic });\n   536→  const mainProgress = spring({ frame, fps, delay: 3, durationFrames: 26, easing: easeOutExpo });\n   537→  const ringProgress = spring({ frame, fps, delay: 6, durationFrames: 32, easing: easeOutCubic });\n   538→  const statsProgress = spring({ frame, fps, delay: 16, durationFrames: 22, easing: easeOutCubic });\n   539→  const badgeProgress = spring({ frame, fps, delay: 28, durationFrames: 20, easing: easeOutQuart });\n   540→  const breathe = pulse(frame, fps, 0.5);\n   541→\n   542→  const confidenceColor = confidence >= 80\n   543→    ? (isRadar ? 'text-emerald-400' : 'text-emerald-600')\n   544→    : confidence >= 60\n   545→      ? (isRadar ? 'text-cyan-400' : 'text-blue-600')\n   546→      : (isRadar ? 'text-amber-400' : 'text-amber-600');\n   547→\n   548→  return (\n   549→    <div className={`absolute inset-0 flex flex-col items-center overflow-hidden ${isMobile ? 'justify-start pt-12' : 'justify-center'}`}>\n   550→      {/* Radial gradient background */}\n   551→      <div\n   552→        className={`absolute ${isMobile ? 'w-64 h-64' : 'w-[400px] h-[400px]'} rounded-full ${isRadar ? 'bg-gradient-radial from-cyan-500/15 via-transparent to-transparent' : 'bg-gradient-radial from-stone-400/10 via-transparent to-transparent'}`}\n   553→        style={{ opacity: bgProgress }}\n   554→      />\n   555→\n   556→      {/* Animated rings */}\n   557→      <div\n   558→        className={`absolute ${isMobile ? 'w-32 h-32' : 'w-40 h-40'} rounded-full border-2 ${isRadar ? 'border-cyan-500/20' : 'border-stone-400/20'}`}\n   559→        style={{ opacity: ringProgress * 0.5, transform: `scale(${0.6 + ringProgress * 0.5 * breathe})` }}\n   560→      />\n   561→      <div\n   562→        className={`absolute ${isMobile ? 'w-48 h-48' : 'w-56 h-56'} rounded-full border ${isRadar ? 'border-cyan-500/10' : 'border-stone-400/10'}`}\n   563→        style={{ opacity: ringProgress * 0.3, transform: `scale(${0.5 + ringProgress * 0.6 * breathe})` }}\n   564→      />\n   565→\n   566→      {/* Main confidence display */}\n   567→      <div className=\"relative\" style={{ opacity: mainProgress, transform: `scale(${0.5 + mainProgress * 0.5})` }}>\n   568→        <div\n   569→          className={`absolute inset-0 blur-2xl ${confidence >= 80 ? (isRadar ? 'bg-emerald-500/30' : 'bg-emerald-500/20') : (isRadar ? 'bg-cyan-500/30' : 'bg-blue-500/20')}`}\n   570→          style={{ transform: `scale(${1.4 * breathe})` }}\n   571→        />\n   572→        <div className=\"relative text-center\">\n   573→          <div className={`${isMobile ? 'text-5xl' : 'text-6xl'} font-bold tabular-nums ${confidenceColor}`}>\n   574→            <AnimatedCounter value={confidence} frame={frame} fps={fps} delay={6} suffix=\"%\" />\n   575→          </div>\n   576→          <div className={`${isMobile ? 'text-sm' : 'text-base'} mt-1 font-medium ${isRadar ? 'text-white/90' : 'text-stone-700'}`}>\n   577→            Overall Confidence\n   578→          </div>\n   579→        </div>\n   580→      </div>\n   581→\n   582→      {/* Stats row */}\n   583→      <div\n   584→        className={`flex ${isMobile ? 'gap-4 mt-6' : 'gap-6 mt-8'}`}\n   585→        style={{ opacity: statsProgress, transform: `translateY(${(1 - statsProgress) * 10}px)` }}\n   586→      >\n   587→        <div className={`text-center ${isMobile ? 'px-4 py-2' : 'px-5 py-2.5'} rounded-xl ${isRadar ? 'bg-slate-800/60 border border-slate-700' : 'bg-white/80 border border-stone-200'}`}>\n   588→          <div className={`${isMobile ? 'text-xl' : 'text-2xl'} font-bold tabular-nums ${isRadar ? 'text-cyan-400' : 'text-blue-600'}`}>\n   589→            <AnimatedCounter value={findings} frame={frame} fps={fps} delay={20} />\n   590→          </div>\n   591→          <div className={`text-[10px] mt-0.5 ${isRadar ? 'text-slate-400' : 'text-stone-500'}`}>Findings</div>\n   592→        </div>\n   593→\n   594→        <div className={`text-center ${isMobile ? 'px-4 py-2' : 'px-5 py-2.5'} rounded-xl ${isRadar ? 'bg-slate-800/60 border border-slate-700' : 'bg-white/80 border border-stone-200'}`}>\n   595→          <div className={`${isMobile ? 'text-xl' : 'text-2xl'} font-bold tabular-nums ${isRadar ? 'text-emerald-400' : 'text-emerald-600'}`}>\n   596→            <AnimatedCounter value={sources} frame={frame} fps={fps} delay={24} />\n   597→          </div>\n   598→          <div className={`text-[10px] mt-0.5 ${isRadar ? 'text-slate-400' : 'text-stone-500'}`}>Sources</div>\n   599→        </div>\n   600→      </div>\n   601→\n   602→      {/* Completion badge */}\n   603→      <div\n   604→        className={`${isMobile ? 'mt-5 px-4 py-2' : 'mt-6 px-5 py-2.5'} rounded-full shadow-lg ${\n   605→          isRadar ? 'bg-gradient-to-r from-emerald-500/20 to-cyan-500/20 border border-emerald-500/30 text-emerald-300' : 'bg-gradient-to-r from-emerald-100 to-cyan-100 border border-emerald-300 text-emerald-700'\n   606→        }`}\n   607→        style={{ opacity: badgeProgress, transform: `scale(${0.88 + badgeProgress * 0.12})` }}\n   608→      >\n   609→        <div className=\"flex items-center gap-2\">\n   610→          <div className={`${isMobile ? 'w-4 h-4' : 'w-5 h-5'} rounded-full flex items-center justify-center ${isRadar ? 'bg-emerald-500/30' : 'bg-emerald-500/20'}`}>\n   611→            <svg className={`${isMobile ? 'w-2.5 h-2.5' : 'w-3 h-3'}`} fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" strokeWidth={3}>\n   612→              <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M5 13l4 4L19 7\" />\n   613→            </svg>\n   614→          </div>\n   615→          <span className={`font-semibold ${isMobile ? 'text-xs' : 'text-sm'}`}>Analysis Complete</span>\n   616→        </div>\n   617→      </div>\n   618→\n   619→      {/* Mobile: CTA at bottom */}\n   620→      {isMobile && (\n   621→        <div\n   622→          className=\"absolute bottom-16 left-4 right-4 text-center\"\n   623→          style={{ opacity: badgeProgress }}\n   624→        >\n   625→          <p className={`text-[10px] ${isRadar ? 'text-slate-500' : 'text-stone-400'}`}>\n   626→            Follow for more insights\n   627→          </p>\n   628→        </div>\n   629→      )}\n   630→    </div>\n   631→  );\n   632→}\n   633→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"9cec20cb-b613-4ab4-b437-0d4075a2df3d","uuid":"6b97f3d1-b75a-4c00-aeef-0c3b6a157941","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\video\\Scenes.tsx","content":"'use client';\n\nimport { spring, easeOutCubic, easeOutQuart, easeOutExpo, easeInOutCubic } from './useVideoPlayback';\nimport { AnimatedBarChart, AnimatedLineChart, AnimatedPieChart, AnimatedCounter } from './AnimatedCharts';\nimport type { VideoFormat } from './VideoOverview';\n\ninterface SceneProps {\n  frame: number;\n  fps: number;\n  isRadar: boolean;\n  format: VideoFormat;\n}\n\n// Subtle pulse effect for breathing animations\nfunction pulse(frame: number, fps: number, speed: number = 1): number {\n  return 0.97 + Math.sin((frame / fps) * Math.PI * speed) * 0.03;\n}\n\n// ============================================\n// TITLE SCENE - News-style with bold typography\n// ============================================\ninterface TitleSceneProps extends SceneProps {\n  title: string;\n  subtitle: string;\n  date: string;\n}\n\nexport function TitleScene({ frame, fps, isRadar, format, title, subtitle, date }: TitleSceneProps) {\n  const isMobile = format === 'mobile';\n  const logoProgress = spring({ frame, fps, delay: 0, durationFrames: 22, easing: easeOutQuart });\n  const glowProgress = spring({ frame, fps, delay: 3, durationFrames: 28, easing: easeOutCubic });\n  const titleProgress = spring({ frame, fps, delay: 8, durationFrames: 26, easing: easeOutCubic });\n  const subtitleProgress = spring({ frame, fps, delay: 16, durationFrames: 22, easing: easeOutCubic });\n  const dateProgress = spring({ frame, fps, delay: 24, durationFrames: 20, easing: easeOutCubic });\n  const breathe = pulse(frame, fps, 0.8);\n\n  return (\n    <div className={`absolute inset-0 flex flex-col items-center overflow-hidden ${isMobile ? 'justify-start pt-16' : 'justify-center'}`}>\n      {/* Background gradient orb */}\n      <div\n        className={`absolute ${isMobile ? 'w-64 h-64 top-1/4' : 'w-96 h-96'} rounded-full blur-3xl ${isRadar ? 'bg-cyan-500/10' : 'bg-stone-400/10'}`}\n        style={{ opacity: glowProgress * 0.6, transform: `scale(${0.5 + glowProgress * 0.5 * breathe})` }}\n      />\n\n      {/* Decorative rings */}\n      <div\n        className={`absolute ${isMobile ? 'w-24 h-24' : 'w-32 h-32'} rounded-full border ${isRadar ? 'border-cyan-500/20' : 'border-stone-400/20'}`}\n        style={{ opacity: logoProgress * 0.5, transform: `scale(${0.8 + logoProgress * 0.4})` }}\n      />\n\n      {/* Logo with glow */}\n      <div className=\"relative\">\n        <div\n          className={`absolute inset-0 rounded-2xl blur-xl ${isRadar ? 'bg-cyan-500/40' : 'bg-stone-600/30'}`}\n          style={{ opacity: glowProgress * 0.6, transform: `scale(${1.2 * breathe})` }}\n        />\n        <div\n          className={`relative ${isMobile ? 'w-14 h-14' : 'w-16 h-16'} rounded-2xl flex items-center justify-center shadow-2xl ${\n            isRadar ? 'bg-gradient-to-br from-cyan-400 to-blue-600' : 'bg-gradient-to-br from-stone-600 to-stone-800'\n          }`}\n          style={{ opacity: logoProgress, transform: `scale(${0.5 + logoProgress * 0.5})` }}\n        >\n          <svg className={`${isMobile ? 'w-7 h-7' : 'w-8 h-8'} text-white`} fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z\" />\n          </svg>\n        </div>\n      </div>\n\n      {/* Title container */}\n      <div className={`${isMobile ? 'mt-6 px-4' : 'mt-6 px-6'} text-center`}>\n        {/* Subtitle badge - NEWS CATEGORY */}\n        <div\n          className={`mb-3 inline-flex items-center gap-1.5 px-3 py-1 rounded-full ${\n            isRadar ? 'bg-red-500/20 border border-red-500/30' : 'bg-red-100 border border-red-200'\n          }`}\n          style={{ opacity: subtitleProgress, transform: `scale(${0.9 + subtitleProgress * 0.1})` }}\n        >\n          <span className={`text-[10px] font-bold tracking-wider ${isRadar ? 'text-red-400' : 'text-red-600'}`}>\n            {subtitle}\n          </span>\n        </div>\n\n        {/* Main Title */}\n        <h1\n          className={`${isMobile ? 'text-xl' : 'text-2xl'} font-bold tracking-tight leading-tight ${\n            isRadar ? 'bg-gradient-to-r from-white to-cyan-200 bg-clip-text text-transparent' : 'text-stone-900'\n          }`}\n          style={{ opacity: titleProgress, transform: `translateY(${(1 - titleProgress) * 10}px)` }}\n        >\n          {title}\n        </h1>\n\n        {/* Date line */}\n        <div\n          className={`mt-3 flex items-center justify-center gap-2 ${isMobile ? 'text-xs' : 'text-sm'}`}\n          style={{ opacity: dateProgress }}\n        >\n          <div className={`w-8 h-px ${isRadar ? 'bg-slate-600' : 'bg-stone-300'}`} />\n          <span className={`${isRadar ? 'text-slate-400' : 'text-stone-500'}`}>{date}</span>\n          <div className={`w-8 h-px ${isRadar ? 'bg-slate-600' : 'bg-stone-300'}`} />\n        </div>\n      </div>\n\n      {/* Mobile: Additional bottom element */}\n      {isMobile && (\n        <div\n          className=\"absolute bottom-20 left-4 right-4\"\n          style={{ opacity: dateProgress, transform: `translateY(${(1 - dateProgress) * 20}px)` }}\n        >\n          <div className={`h-px ${isRadar ? 'bg-gradient-to-r from-transparent via-cyan-500/30 to-transparent' : 'bg-gradient-to-r from-transparent via-stone-400/30 to-transparent'}`} />\n          <p className={`mt-3 text-center text-xs ${isRadar ? 'text-slate-500' : 'text-stone-400'}`}>\n            Swipe for insights ↓\n          </p>\n        </div>\n      )}\n    </div>\n  );\n}\n\n// ============================================\n// METRICS SCENE - Data-driven news style\n// ============================================\ninterface MetricsSceneProps extends SceneProps {\n  metrics: Array<{ label: string; value: number; suffix?: string; color: string }>;\n}\n\nexport function MetricsScene({ frame, fps, isRadar, format, metrics }: MetricsSceneProps) {\n  const isMobile = format === 'mobile';\n  const headerProgress = spring({ frame, fps, delay: 0, durationFrames: 18, easing: easeOutCubic });\n  const lineProgress = spring({ frame, fps, delay: 3, durationFrames: 22, easing: easeInOutCubic });\n\n  return (\n    <div className={`absolute inset-0 ${isMobile ? 'p-4 pt-8' : 'p-5'}`}>\n      {/* Background accent */}\n      <div\n        className={`absolute ${isMobile ? 'top-1/3 right-0' : 'top-0 right-0'} w-48 h-48 rounded-full blur-3xl ${isRadar ? 'bg-cyan-500/5' : 'bg-stone-400/5'}`}\n        style={{ opacity: headerProgress }}\n      />\n\n      {/* Header */}\n      <div className={`${isMobile ? 'mb-4' : 'mb-5'}`}>\n        <div\n          className=\"flex items-center gap-2\"\n          style={{ opacity: headerProgress, transform: `translateX(${(1 - headerProgress) * -12}px)` }}\n        >\n          <div className={`w-1 ${isMobile ? 'h-6' : 'h-7'} rounded-full ${isRadar ? 'bg-gradient-to-b from-cyan-400 to-cyan-600' : 'bg-gradient-to-b from-stone-600 to-stone-800'}`} />\n          <h2 className={`${isMobile ? 'text-base' : 'text-lg'} font-bold ${isRadar ? 'text-white' : 'text-stone-900'}`}>Key Metrics</h2>\n        </div>\n        <div className={`h-px mt-3 ${isRadar ? 'bg-cyan-500/20' : 'bg-stone-300'}`} style={{ transform: `scaleX(${lineProgress})`, transformOrigin: 'left' }} />\n      </div>\n\n      {/* Metrics grid */}\n      <div className={`grid ${isMobile ? 'grid-cols-2 gap-3' : 'grid-cols-4 gap-3'}`}>\n        {metrics.map((m, i) => (\n          <MetricCard key={i} {...m} index={i} frame={frame} fps={fps} isRadar={isRadar} format={format} />\n        ))}\n      </div>\n    </div>\n  );\n}\n\nfunction MetricCard({ label, value, suffix = '', color, index, frame, fps, isRadar, format }: {\n  label: string; value: number; suffix?: string; color: string; index: number; frame: number; fps: number; isRadar: boolean; format: VideoFormat;\n}) {\n  const isMobile = format === 'mobile';\n  const progress = spring({ frame, fps, delay: 6 + index * 4, durationFrames: 22, easing: easeOutQuart });\n  const countProgress = spring({ frame, fps, delay: 12 + index * 4, durationFrames: 32, easing: easeOutCubic });\n  const glowProgress = spring({ frame, fps, delay: 16 + index * 4, durationFrames: 18, easing: easeOutCubic });\n  const breathe = pulse(frame, fps, 0.6);\n\n  const colorMap: Record<string, { bg: string; border: string; text: string; glow: string }> = {\n    cyan: {\n      bg: isRadar ? 'bg-cyan-500/8' : 'bg-blue-50',\n      border: isRadar ? 'border-cyan-500/25' : 'border-blue-200',\n      text: isRadar ? 'text-cyan-400' : 'text-blue-600',\n      glow: isRadar ? 'bg-cyan-500/20' : 'bg-blue-500/10'\n    },\n    emerald: {\n      bg: isRadar ? 'bg-emerald-500/8' : 'bg-emerald-50',\n      border: isRadar ? 'border-emerald-500/25' : 'border-emerald-200',\n      text: isRadar ? 'text-emerald-400' : 'text-emerald-600',\n      glow: isRadar ? 'bg-emerald-500/20' : 'bg-emerald-500/10'\n    },\n    amber: {\n      bg: isRadar ? 'bg-amber-500/8' : 'bg-amber-50',\n      border: isRadar ? 'border-amber-500/25' : 'border-amber-200',\n      text: isRadar ? 'text-amber-400' : 'text-amber-600',\n      glow: isRadar ? 'bg-amber-500/20' : 'bg-amber-500/10'\n    },\n    rose: {\n      bg: isRadar ? 'bg-rose-500/8' : 'bg-rose-50',\n      border: isRadar ? 'border-rose-500/25' : 'border-rose-200',\n      text: isRadar ? 'text-rose-400' : 'text-rose-600',\n      glow: isRadar ? 'bg-rose-500/20' : 'bg-rose-500/10'\n    },\n  };\n\n  const colors = colorMap[color] || colorMap.cyan;\n\n  return (\n    <div className=\"relative\">\n      <div\n        className={`absolute inset-0 rounded-xl blur-xl ${colors.glow}`}\n        style={{ opacity: glowProgress * 0.4, transform: `scale(${1.1 * breathe})` }}\n      />\n      <div\n        className={`relative ${isMobile ? 'p-3' : 'p-3'} rounded-xl border backdrop-blur-sm ${colors.bg} ${colors.border}`}\n        style={{ opacity: progress, transform: `translateY(${(1 - progress) * 15}px)` }}\n      >\n        <div className={`${isMobile ? 'text-[9px]' : 'text-[10px]'} uppercase tracking-wider font-medium mb-1 ${isRadar ? 'text-slate-400' : 'text-stone-500'}`}>\n          {label}\n        </div>\n        <div className={`${isMobile ? 'text-2xl' : 'text-2xl'} font-bold tabular-nums ${colors.text}`}>\n          {Math.round(value * countProgress)}{suffix}\n        </div>\n        {/* Mini progress bar */}\n        <div className={`mt-2 h-0.5 rounded-full ${isRadar ? 'bg-slate-800' : 'bg-stone-200'}`}>\n          <div\n            className={`h-full rounded-full ${colors.text.replace('text-', 'bg-')}`}\n            style={{ width: `${countProgress * 100}%`, opacity: 0.5 }}\n          />\n        </div>\n      </div>\n    </div>\n  );\n}\n\n// ============================================\n// CHARTS SCENE - Data visualization\n// ============================================\ninterface ChartsSceneProps extends SceneProps {\n  barData: Array<{ label: string; value: number }>;\n  lineData: number[];\n  pieData: Array<{ label: string; value: number; color: string }>;\n}\n\nexport function ChartsScene({ frame, fps, isRadar, format, barData, lineData, pieData }: ChartsSceneProps) {\n  const isMobile = format === 'mobile';\n  const headerProgress = spring({ frame, fps, delay: 0, durationFrames: 18, easing: easeOutCubic });\n  const lineProgress = spring({ frame, fps, delay: 3, durationFrames: 22, easing: easeInOutCubic });\n  const chart1Progress = spring({ frame, fps, delay: 6, durationFrames: 20, easing: easeOutQuart });\n  const chart2Progress = spring({ frame, fps, delay: 12, durationFrames: 20, easing: easeOutQuart });\n  const chart3Progress = spring({ frame, fps, delay: 18, durationFrames: 20, easing: easeOutQuart });\n\n  // Mobile layout: vertical stack\n  if (isMobile) {\n    return (\n      <div className=\"absolute inset-0 p-4 pt-8\">\n        {/* Header */}\n        <div className=\"mb-3\">\n          <div\n            className=\"flex items-center gap-2\"\n            style={{ opacity: headerProgress, transform: `translateX(${(1 - headerProgress) * -12}px)` }}\n          >\n            <div className=\"w-1 h-6 rounded-full bg-gradient-to-b from-blue-400 to-cyan-600\" />\n            <h2 className={`text-base font-bold ${isRadar ? 'text-white' : 'text-stone-900'}`}>Data Analysis</h2>\n          </div>\n          <div className={`h-px mt-2 ${isRadar ? 'bg-cyan-500/20' : 'bg-stone-300'}`} style={{ transform: `scaleX(${lineProgress})`, transformOrigin: 'left' }} />\n        </div>\n\n        {/* Charts - vertical stack for mobile */}\n        <div className=\"space-y-3\">\n          {/* Bar + Pie row */}\n          <div className=\"flex gap-3\">\n            <div\n              className={`flex-1 p-3 rounded-xl ${isRadar ? 'bg-slate-900/70 border border-cyan-500/15' : 'bg-white/90 border border-stone-200'}`}\n              style={{ opacity: chart1Progress, transform: `translateY(${(1 - chart1Progress) * 10}px)` }}\n            >\n              <div className={`text-[9px] font-medium mb-2 ${isRadar ? 'text-cyan-400/80' : 'text-stone-500'}`}>Distribution</div>\n              <AnimatedBarChart data={barData} frame={frame - 10} fps={fps} width={100} height={70} isRadar={isRadar} />\n            </div>\n\n            <div\n              className={`flex-1 p-3 rounded-xl flex flex-col items-center ${isRadar ? 'bg-slate-900/70 border border-violet-500/15' : 'bg-white/90 border border-stone-200'}`}\n              style={{ opacity: chart3Progress, transform: `translateY(${(1 - chart3Progress) * 10}px)` }}\n            >\n              <div className={`text-[9px] font-medium mb-2 self-start ${isRadar ? 'text-violet-400/80' : 'text-stone-500'}`}>Sources</div>\n              <AnimatedPieChart data={pieData} frame={frame - 24} fps={fps} size={70} isRadar={isRadar} />\n            </div>\n          </div>\n\n          {/* Line chart - full width */}\n          <div\n            className={`p-3 rounded-xl ${isRadar ? 'bg-slate-900/70 border border-emerald-500/15' : 'bg-white/90 border border-stone-200'}`}\n            style={{ opacity: chart2Progress, transform: `translateY(${(1 - chart2Progress) * 10}px)` }}\n          >\n            <div className={`text-[9px] font-medium mb-2 ${isRadar ? 'text-emerald-400/80' : 'text-stone-500'}`}>Confidence Trend</div>\n            <AnimatedLineChart data={lineData} frame={frame - 18} fps={fps} width={230} height={80} isRadar={isRadar} />\n          </div>\n        </div>\n      </div>\n    );\n  }\n\n  // Standard layout: horizontal\n  return (\n    <div className=\"absolute inset-0 p-5\">\n      <div\n        className={`absolute bottom-0 left-0 w-48 h-48 rounded-full blur-3xl ${isRadar ? 'bg-blue-500/5' : 'bg-stone-400/5'}`}\n        style={{ opacity: headerProgress }}\n      />\n\n      <div className=\"mb-4\">\n        <div\n          className=\"flex items-center gap-2\"\n          style={{ opacity: headerProgress, transform: `translateX(${(1 - headerProgress) * -12}px)` }}\n        >\n          <div className=\"w-1 h-7 rounded-full bg-gradient-to-b from-blue-400 to-cyan-600\" />\n          <h2 className={`text-lg font-bold ${isRadar ? 'text-white' : 'text-stone-900'}`}>Data Analysis</h2>\n        </div>\n        <div className={`h-px mt-3 ${isRadar ? 'bg-cyan-500/20' : 'bg-stone-300'}`} style={{ transform: `scaleX(${lineProgress})`, transformOrigin: 'left' }} />\n      </div>\n\n      <div className=\"grid grid-cols-3 gap-3\" style={{ height: 170 }}>\n        <div className=\"relative\">\n          <div\n            className={`absolute inset-0 rounded-xl blur-lg ${isRadar ? 'bg-cyan-500/10' : 'bg-blue-500/5'}`}\n            style={{ opacity: chart1Progress * 0.3 }}\n          />\n          <div\n            className={`relative h-full p-3 rounded-xl backdrop-blur-sm ${isRadar ? 'bg-slate-900/70 border border-cyan-500/15' : 'bg-white/90 border border-stone-200'}`}\n            style={{ opacity: chart1Progress, transform: `translateY(${(1 - chart1Progress) * 10}px) scale(${0.96 + chart1Progress * 0.04})` }}\n          >\n            <div className={`text-[10px] font-medium mb-2 ${isRadar ? 'text-cyan-400/80' : 'text-stone-500'}`}>Distribution</div>\n            <AnimatedBarChart data={barData} frame={frame - 10} fps={fps} width={165} height={120} isRadar={isRadar} />\n          </div>\n        </div>\n\n        <div className=\"relative\">\n          <div\n            className={`absolute inset-0 rounded-xl blur-lg ${isRadar ? 'bg-emerald-500/10' : 'bg-emerald-500/5'}`}\n            style={{ opacity: chart2Progress * 0.3 }}\n          />\n          <div\n            className={`relative h-full p-3 rounded-xl backdrop-blur-sm ${isRadar ? 'bg-slate-900/70 border border-emerald-500/15' : 'bg-white/90 border border-stone-200'}`}\n            style={{ opacity: chart2Progress, transform: `translateY(${(1 - chart2Progress) * 10}px) scale(${0.96 + chart2Progress * 0.04})` }}\n          >\n            <div className={`text-[10px] font-medium mb-2 ${isRadar ? 'text-emerald-400/80' : 'text-stone-500'}`}>Confidence Trend</div>\n            <AnimatedLineChart data={lineData} frame={frame - 18} fps={fps} width={165} height={120} isRadar={isRadar} />\n          </div>\n        </div>\n\n        <div className=\"relative\">\n          <div\n            className={`absolute inset-0 rounded-xl blur-lg ${isRadar ? 'bg-violet-500/10' : 'bg-violet-500/5'}`}\n            style={{ opacity: chart3Progress * 0.3 }}\n          />\n          <div\n            className={`relative h-full p-3 rounded-xl flex flex-col backdrop-blur-sm ${isRadar ? 'bg-slate-900/70 border border-violet-500/15' : 'bg-white/90 border border-stone-200'}`}\n            style={{ opacity: chart3Progress, transform: `translateY(${(1 - chart3Progress) * 10}px) scale(${0.96 + chart3Progress * 0.04})` }}\n          >\n            <div className={`text-[10px] font-medium mb-2 ${isRadar ? 'text-violet-400/80' : 'text-stone-500'}`}>Source Mix</div>\n            <div className=\"flex-1 flex items-center justify-center\">\n              <AnimatedPieChart data={pieData} frame={frame - 26} fps={fps} size={100} isRadar={isRadar} />\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n\n// ============================================\n// INSIGHTS SCENE - Key findings highlight\n// ============================================\ninterface InsightsSceneProps extends SceneProps {\n  insights: string[];\n  warnings: string[];\n}\n\nexport function InsightsScene({ frame, fps, isRadar, format, insights, warnings }: InsightsSceneProps) {\n  const isMobile = format === 'mobile';\n  const headerProgress = spring({ frame, fps, delay: 0, durationFrames: 18, easing: easeOutCubic });\n  const lineProgress = spring({ frame, fps, delay: 3, durationFrames: 22, easing: easeInOutCubic });\n  const col1Progress = spring({ frame, fps, delay: 6, durationFrames: 20, easing: easeOutQuart });\n  const col2Progress = spring({ frame, fps, delay: 12, durationFrames: 20, easing: easeOutQuart });\n\n  // Mobile: vertical stack\n  if (isMobile) {\n    return (\n      <div className=\"absolute inset-0 p-4 pt-8\">\n        <div\n          className={`absolute top-1/3 left-1/2 w-32 h-32 rounded-full blur-3xl ${isRadar ? 'bg-emerald-500/5' : 'bg-emerald-400/5'}`}\n          style={{ opacity: headerProgress }}\n        />\n\n        <div className=\"mb-3\">\n          <div\n            className=\"flex items-center gap-2\"\n            style={{ opacity: headerProgress, transform: `translateX(${(1 - headerProgress) * -12}px)` }}\n          >\n            <div className=\"w-1 h-6 rounded-full bg-gradient-to-b from-emerald-400 to-emerald-600\" />\n            <h2 className={`text-base font-bold ${isRadar ? 'text-white' : 'text-stone-900'}`}>Key Findings</h2>\n          </div>\n          <div className={`h-px mt-2 ${isRadar ? 'bg-emerald-500/20' : 'bg-stone-300'}`} style={{ transform: `scaleX(${lineProgress})`, transformOrigin: 'left' }} />\n        </div>\n\n        {/* Vertical stack for mobile */}\n        <div className=\"space-y-3\">\n          {/* Insights */}\n          <div\n            className={`p-3 rounded-xl ${isRadar ? 'bg-emerald-500/5 border border-emerald-500/15' : 'bg-emerald-50/50 border border-emerald-200'}`}\n            style={{ opacity: col1Progress, transform: `translateY(${(1 - col1Progress) * 10}px)` }}\n          >\n            <div className={`text-[9px] uppercase tracking-wider font-semibold mb-2 flex items-center gap-1.5 ${isRadar ? 'text-emerald-400' : 'text-emerald-600'}`}>\n              <span>💡</span> Insights\n            </div>\n            <div className=\"space-y-2\">\n              {insights.slice(0, 2).map((text, i) => (\n                <InsightItem key={i} text={text} type=\"insight\" index={i} frame={frame} fps={fps} isRadar={isRadar} format={format} />\n              ))}\n              {insights.length === 0 && (\n                <p className={`text-xs italic ${isRadar ? 'text-slate-500' : 'text-stone-400'}`}>No insights available</p>\n              )}\n            </div>\n          </div>\n\n          {/* Warnings */}\n          <div\n            className={`p-3 rounded-xl ${isRadar ? 'bg-amber-500/5 border border-amber-500/15' : 'bg-amber-50/50 border border-amber-200'}`}\n            style={{ opacity: col2Progress, transform: `translateY(${(1 - col2Progress) * 10}px)` }}\n          >\n            <div className={`text-[9px] uppercase tracking-wider font-semibold mb-2 flex items-center gap-1.5 ${isRadar ? 'text-amber-400' : 'text-amber-600'}`}>\n              <span>⚠️</span> Alerts\n            </div>\n            <div className=\"space-y-2\">\n              {warnings.slice(0, 2).map((text, i) => (\n                <InsightItem key={i} text={text} type=\"warning\" index={i + insights.length} frame={frame} fps={fps} isRadar={isRadar} format={format} />\n              ))}\n              {warnings.length === 0 && (\n                <p className={`text-xs italic ${isRadar ? 'text-slate-500' : 'text-stone-400'}`}>No alerts</p>\n              )}\n            </div>\n          </div>\n        </div>\n      </div>\n    );\n  }\n\n  // Standard: two columns\n  return (\n    <div className=\"absolute inset-0 p-5\">\n      <div\n        className={`absolute top-1/2 left-1/4 w-36 h-36 rounded-full blur-3xl ${isRadar ? 'bg-emerald-500/5' : 'bg-emerald-400/5'}`}\n        style={{ opacity: headerProgress }}\n      />\n      <div\n        className={`absolute top-1/2 right-1/4 w-36 h-36 rounded-full blur-3xl ${isRadar ? 'bg-amber-500/5' : 'bg-amber-400/5'}`}\n        style={{ opacity: headerProgress }}\n      />\n\n      <div className=\"mb-4\">\n        <div\n          className=\"flex items-center gap-2\"\n          style={{ opacity: headerProgress, transform: `translateX(${(1 - headerProgress) * -12}px)` }}\n        >\n          <div className=\"w-1 h-7 rounded-full bg-gradient-to-b from-emerald-400 to-emerald-600\" />\n          <h2 className={`text-lg font-bold ${isRadar ? 'text-white' : 'text-stone-900'}`}>Key Findings</h2>\n        </div>\n        <div className={`h-px mt-3 ${isRadar ? 'bg-emerald-500/20' : 'bg-stone-300'}`} style={{ transform: `scaleX(${lineProgress})`, transformOrigin: 'left' }} />\n      </div>\n\n      <div className=\"grid grid-cols-2 gap-4\">\n        <div\n          className={`p-3 rounded-xl ${isRadar ? 'bg-emerald-500/5 border border-emerald-500/15' : 'bg-emerald-50/50 border border-emerald-200'}`}\n          style={{ opacity: col1Progress, transform: `translateX(${(1 - col1Progress) * -12}px)` }}\n        >\n          <div className={`text-[10px] uppercase tracking-wider font-semibold mb-3 flex items-center gap-1.5 ${isRadar ? 'text-emerald-400' : 'text-emerald-600'}`}>\n            <span>💡</span> Insights\n          </div>\n          <div className=\"space-y-2\">\n            {insights.slice(0, 3).map((text, i) => (\n              <InsightItem key={i} text={text} type=\"insight\" index={i} frame={frame} fps={fps} isRadar={isRadar} format={format} />\n            ))}\n            {insights.length === 0 && (\n              <p className={`text-xs italic ${isRadar ? 'text-slate-500' : 'text-stone-400'}`}>No insights available</p>\n            )}\n          </div>\n        </div>\n\n        <div\n          className={`p-3 rounded-xl ${isRadar ? 'bg-amber-500/5 border border-amber-500/15' : 'bg-amber-50/50 border border-amber-200'}`}\n          style={{ opacity: col2Progress, transform: `translateX(${(1 - col2Progress) * 12}px)` }}\n        >\n          <div className={`text-[10px] uppercase tracking-wider font-semibold mb-3 flex items-center gap-1.5 ${isRadar ? 'text-amber-400' : 'text-amber-600'}`}>\n            <span>⚠️</span> Alerts\n          </div>\n          <div className=\"space-y-2\">\n            {warnings.slice(0, 2).map((text, i) => (\n              <InsightItem key={i} text={text} type=\"warning\" index={i + insights.length} frame={frame} fps={fps} isRadar={isRadar} format={format} />\n            ))}\n            {warnings.length === 0 && (\n              <p className={`text-xs italic ${isRadar ? 'text-slate-500' : 'text-stone-400'}`}>No alerts</p>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n\nfunction InsightItem({ text, type, index, frame, fps, isRadar, format }: {\n  text: string; type: 'insight' | 'warning'; index: number; frame: number; fps: number; isRadar: boolean; format: VideoFormat;\n}) {\n  const isMobile = format === 'mobile';\n  const progress = spring({ frame, fps, delay: 6 + index * 6, durationFrames: 22, easing: easeOutCubic });\n  const color = type === 'insight'\n    ? (isRadar ? 'text-emerald-200' : 'text-emerald-800')\n    : (isRadar ? 'text-amber-200' : 'text-amber-800');\n\n  const maxLen = isMobile ? 60 : 85;\n\n  return (\n    <div\n      className={`flex items-start gap-2 p-2 rounded-lg ${isRadar ? 'bg-slate-900/30' : 'bg-white/60'}`}\n      style={{ opacity: progress, transform: `translateY(${(1 - progress) * 8}px)` }}\n    >\n      <div className={`w-1 h-1 rounded-full mt-1.5 flex-shrink-0 ${type === 'insight' ? (isRadar ? 'bg-emerald-400' : 'bg-emerald-500') : (isRadar ? 'bg-amber-400' : 'bg-amber-500')}`} />\n      <p className={`${isMobile ? 'text-[11px]' : 'text-xs'} leading-relaxed ${color}`}>{text.slice(0, maxLen)}{text.len
[2026-01-30T12:19:07.259Z] [STDOUT] gth > maxLen ? '...' : ''}</p>\n    </div>\n  );\n}\n\n// ============================================\n// SUMMARY SCENE - Dramatic finale\n// ============================================\ninterface SummarySceneProps extends SceneProps {\n  confidence: number;\n  findings: number;\n  sources: number;\n}\n\nexport function SummaryScene({ frame, fps, isRadar, format, confidence, findings, sources }: SummarySceneProps) {\n  const isMobile = format === 'mobile';\n  const bgProgress = spring({ frame, fps, delay: 0, durationFrames: 28, easing: easeOutCubic });\n  const mainProgress = spring({ frame, fps, delay: 3, durationFrames: 26, easing: easeOutExpo });\n  const ringProgress = spring({ frame, fps, delay: 6, durationFrames: 32, easing: easeOutCubic });\n  const statsProgress = spring({ frame, fps, delay: 16, durationFrames: 22, easing: easeOutCubic });\n  const badgeProgress = spring({ frame, fps, delay: 28, durationFrames: 20, easing: easeOutQuart });\n  const breathe = pulse(frame, fps, 0.5);\n\n  const confidenceColor = confidence >= 80\n    ? (isRadar ? 'text-emerald-400' : 'text-emerald-600')\n    : confidence >= 60\n      ? (isRadar ? 'text-cyan-400' : 'text-blue-600')\n      : (isRadar ? 'text-amber-400' : 'text-amber-600');\n\n  return (\n    <div className={`absolute inset-0 flex flex-col items-center overflow-hidden ${isMobile ? 'justify-start pt-12' : 'justify-center'}`}>\n      {/* Radial gradient background */}\n      <div\n        className={`absolute ${isMobile ? 'w-64 h-64' : 'w-[400px] h-[400px]'} rounded-full ${isRadar ? 'bg-gradient-radial from-cyan-500/15 via-transparent to-transparent' : 'bg-gradient-radial from-stone-400/10 via-transparent to-transparent'}`}\n        style={{ opacity: bgProgress }}\n      />\n\n      {/* Animated rings */}\n      <div\n        className={`absolute ${isMobile ? 'w-32 h-32' : 'w-40 h-40'} rounded-full border-2 ${isRadar ? 'border-cyan-500/20' : 'border-stone-400/20'}`}\n        st