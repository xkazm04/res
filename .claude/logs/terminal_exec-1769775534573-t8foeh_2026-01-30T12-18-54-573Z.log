aseOutQuart });\n  const hookProgress = spring({ frame: sceneFrame, fps, delay: 15, durationFrames: 30, easing: easeOutCubic });\n  const lineProgress = spring({ frame: sceneFrame, fps, delay: 30, durationFrames: 25, easing: easeOutCubic });\n  const titleProgress = spring({ frame: sceneFrame, fps, delay: 38, durationFrames: 22, easing: easeOutCubic });\n  const badgeProgress = spring({ frame: sceneFrame, fps, delay: 45, durationFrames: 20, easing: easeOutCubic });\n\n  // Subtle breathing effect for background elements\n  const breathe = 1 + Math.sin((sceneFrame / fps) * Math.PI * 0.5) * 0.02;\n\n  // Get template icon component\n  const TemplateIcon = getTemplateIcon(templateType);\n\n  // Template-specific visual treatment\n  const getTemplateEmphasis = () => {\n    const emphases: Record<TemplateType, string> = {\n      investigative: 'INVESTIGATION',\n      financial: 'ANALYSIS',\n      competitive: 'BATTLE REPORT',\n      legal: 'LEGAL IMPACT',\n      tech_market: 'MARKET INTEL',\n      contract: 'CONTRACT REVIEW',\n      understanding: 'DEEP DIVE',\n      due_diligence: 'DUE DILIGENCE',\n      purchase_decision: 'BUYER ALERT',\n      reputation: 'TRUST CHECK',\n    };\n    return emphases[templateType] || 'ANALYSIS';\n  };\n\n  return (\n    <div className={`absolute inset-0 flex flex-col items-center overflow-hidden ${isMobile ? 'justify-start pt-20' : 'justify-center'}`}>\n      {/* Initial flash effect */}\n      <div\n        className=\"absolute inset-0 pointer-events-none\"\n        style={{\n          background: `radial-gradient(circle at 50% ${isMobile ? '30%' : '50%'}, ${accentColor} 0%, transparent 70%)`,\n          opacity: (1 - flashProgress) * 0.4,\n        }}\n      />\n\n      {/* Animated background orbs */}\n      <div\n        className=\"absolute pointer-events-none\"\n        style={{\n          width: isMobile ? 200 : 350,\n          height: isMobile ? 200 : 350,\n          borderRadius: '50%',\n          background: `radial-gradient(circle, ${accentColor}25 0%, transparent 70%)`,\n          opacity: ringProgress * 0.6,\n          transform: `scale(${0.6 + ringProgress * 0.5 * breathe})`,\n          filter: 'blur(40px)',\n        }}\n      />\n\n      {/* Concentric rings */}\n      {[0.6, 0.8, 1].map((scale, i) => (\n        <div\n          key={i}\n          className=\"absolute pointer-events-none rounded-full\"\n          style={{\n            width: isMobile ? 100 + i * 30 : 160 + i * 50,\n            height: isMobile ? 100 + i * 30 : 160 + i * 50,\n            border: `1px solid ${accentColor}`,\n            opacity: ringProgress * (0.15 - i * 0.04),\n            transform: `scale(${scale + ringProgress * 0.2})`,\n          }}\n        />\n      ))}\n\n      {/* Icon container with glow */}\n      <div className=\"relative z-10\">\n        {/* Glow behind icon */}\n        <div\n          className=\"absolute inset-0 -m-6 rounded-full\"\n          style={{\n            background: `radial-gradient(circle, ${accentColor}50 0%, transparent 70%)`,\n            opacity: iconProgress * 0.7,\n            transform: `scale(${breathe * 1.2})`,\n            filter: 'blur(20px)',\n          }}\n        />\n\n        {/* Icon background circle */}\n        <div\n          className={`relative flex items-center justify-center rounded-full ${\n            isRadar ? 'bg-slate-900/80' : 'bg-white/80'\n          }`}\n          style={{\n            width: isMobile ? 72 : 100,\n            height: isMobile ? 72 : 100,\n            opacity: iconProgress,\n            transform: `scale(${0.5 + iconProgress * 0.5})`,\n            boxShadow: `0 0 40px ${accentColor}30`,\n            border: `2px solid ${accentColor}40`,\n          }}\n        >\n          <TemplateIcon\n            size={isMobile ? 36 : 48}\n            color={accentColor}\n          />\n        </div>\n      </div>\n\n      {/* Template type badge */}\n      <div\n        className={`mt-4 px-4 py-1.5 rounded-full text-xs font-bold tracking-widest ${\n          isRadar ? 'bg-slate-800/80' : 'bg-stone-200/80'\n        }`}\n        style={{\n          opacity: badgeProgress,\n          transform: `translateY(${(1 - badgeProgress) * 10}px)`,\n          color: accentColor,\n          border: `1px solid ${accentColor}30`,\n        }}\n      >\n        {getTemplateEmphasis()}\n      </div>\n\n      {/* Hook text container */}\n      <div className={`${isMobile ? 'mt-8 px-6' : 'mt-10 px-8'} text-center max-w-2xl`}>\n        {/* Main hook text */}\n        <p\n          className={`\n            font-bold leading-snug tracking-tight\n            ${isMobile ? 'text-2xl' : 'text-3xl'}\n            ${isRadar ? 'text-white' : 'text-stone-900'}\n          `}\n          style={{\n            opacity: hookProgress,\n            transform: `translateY(${(1 - hookProgress) * 30}px)`,\n          }}\n        >\n          {hook}\n        </p>\n\n        {/* Decorative accent line */}\n        <div className=\"relative mx-auto mt-6 h-0.5 overflow-hidden\" style={{ width: 160 }}>\n          <div\n            className=\"absolute inset-y-0 left-1/2\"\n            style={{\n              width: `${lineProgress * 100}%`,\n              transform: 'translateX(-50%)',\n              background: `linear-gradient(90deg, transparent, ${accentColor}, transparent)`,\n            }}\n          />\n        </div>\n\n        {/* Title/Subject */}\n        <h2\n          className={`\n            mt-5 font-medium\n            ${isMobile ? 'text-base' : 'text-lg'}\n            ${isRadar ? 'text-slate-400' : 'text-stone-600'}\n          `}\n          style={{\n            opacity: titleProgress,\n            transform: `translateY(${(1 - titleProgress) * 15}px)`,\n          }}\n        >\n          {title}\n        </h2>\n      </div>\n\n      {/* Corner accent decorations - desktop only */}\n      {!isMobile && (\n        <>\n          <div\n            className=\"absolute top-6 left-6\"\n            style={{ opacity: lineProgress * 0.5 }}\n          >\n            <div style={{ width: 40, height: 2, backgroundColor: accentColor }} />\n            <div style={{ width: 2, height: 40, backgroundColor: accentColor }} />\n          </div>\n          <div\n            className=\"absolute bottom-6 right-6\"\n            style={{ opacity: lineProgress * 0.5 }}\n          >\n            <div className=\"flex flex-col items-end\">\n              <div style={{ width: 40, height: 2, backgroundColor: accentColor }} />\n              <div style={{ width: 2, height: 40, backgroundColor: accentColor }} />\n            </div>\n          </div>\n        </>\n      )}\n\n      {/* Mobile scroll hint */}\n      {isMobile && (\n        <div\n          className=\"absolute bottom-20 left-0 right-0 flex flex-col items-center\"\n          style={{ opacity: titleProgress * 0.5 }}\n        >\n          <div\n            className={`w-6 h-10 rounded-full border-2 flex justify-center pt-2 ${\n              isRadar ? 'border-slate-600' : 'border-stone-400'\n            }`}\n          >\n            <div\n              className=\"w-1 h-2 rounded-full animate-bounce\"\n              style={{ backgroundColor: accentColor }}\n            />\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}\n","numLines":241,"startLine":1,"totalLines":241}}}
