Scene to separate file","status":"completed","activeForm":"Extracting ChartsScene"},{"content":"Extract InsightsScene with InsightItem to separate file","status":"completed","activeForm":"Extracting InsightsScene"},{"content":"Extract SummaryScene to separate file","status":"in_progress","activeForm":"Extracting SummaryScene"},{"content":"Update scenes/index.tsx with new exports","status":"pending","activeForm":"Updating scenes barrel exports"},{"content":"Update report/video/index.tsx exports","status":"pending","activeForm":"Updating main video exports"},{"content":"Delete old Scenes.tsx file","status":"pending","activeForm":"Deleting old Scenes.tsx"}]}}
[2026-01-30T12:22:33.929Z] [STDOUT] {"type":"assistant","message":{"model":"claude-opus-4-5-20251101","id":"msg_01SdVBQMFQjxSLS6umYQhqZi","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DfVvovrJzCTnYs98WsiG4T","name":"Write","input":{"file_path":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\video\\scenes\\SummaryScene.tsx","content":"'use client';\n\nimport { spring, easeOutCubic, easeOutQuart, easeOutExpo } from '../useVideoPlayback';\nimport { AnimatedCounter } from '../AnimatedCharts';\nimport { pulse, type SceneProps } from './primitives';\n\ninterface SummarySceneProps extends SceneProps {\n  confidence: number;\n  findings: number;\n  sources: number;\n}\n\n/**\n * Summary scene with dramatic confidence display and completion badge.\n */\nexport function SummaryScene({ frame, fps, isRadar, format, confidence, findings, sources }: SummarySceneProps) {\n  const isMobile = format === 'mobile';\n\n  // Animation timings\n  const bgProgress = spring({ frame, fps, delay: 0, durationFrames: 28, easing: easeOutCubic });\n  const mainProgress = spring({ frame, fps, delay: 3, durationFrames: 26, easing: easeOutExpo });\n  const ringProgress = spring({ frame, fps, delay: 6, durationFrames: 32, easing: easeOutCubic });\n  const statsProgress = spring({ frame, fps, delay: 16, durationFrames: 22, easing: easeOutCubic });\n  const badgeProgress = spring({ frame, fps, delay: 28, durationFrames: 20, easing: easeOutQuart });\n  const breathe = pulse(frame, fps, 0.5);\n\n  const confidenceColor = confidence >= 80\n    ? (isRadar ? 'text-emerald-400' : 'text-emerald-600')\n    : confidence >= 60\n      ? (isRadar ? 'text-cyan-400' : 'text-blue-600')\n      : (isRadar ? 'text-amber-400' : 'text-amber-600');\n\n  return (\n    <div className={`absolute inset-0 flex flex-col items-center overflow-hidden ${isMobile ? 'justify-start pt-12' : 'justify-center'}`}>\n      {/* Radial gradient background */}\n      <div\n        className={`absolute ${isMobile ? 'w-64 h-64' : 'w-[400px] h-[400px]'} rounded-full ${isRadar ? 'bg-gradient-radial from-cyan-500/15 via-transparent to-transparent' : 'bg-gradient-radial from-stone-400/10 via-transparent to-transparent'}`}\n        style={{ opacity: bgProgress }}\n      />\n\n      {/* Animated rings */}\n      <div\n        className={`absolute ${isMobile ? 'w-32 h-32' : 'w-40 h-40'} rounded-full border-2 ${isRadar ? 'border-cyan-500/20' : 'border-stone-400/20'}`}\n        style={{ opacity: ringProgress * 0.5, transform: `scale(${0.6 + ringProgress * 0.5 * breathe})` }}\n      />\n      <div\n        className={`absolute ${isMobile ? 'w-48 h-48' : 'w-56 h-56'} rounded-full border ${isRadar ? 'border-cyan-500/10' : 'border-stone-400/10'}`}\n        style={{ opacity: ringProgress * 0.3, transform: `scale(${0.5 + ringProgress * 0.6 * breathe})` }}\n      />\n\n      {/* Main confidence display */}\n      <div className=\"relative\" style={{ opacity: mainProgress, transform: `scale(${0.5 + mainProgress * 0.5})` }}>\n        <div\n          className={`absolute inset-0 blur-2xl ${confidence >= 80 ? (isRadar ? 'bg-emerald-500/30' : 'bg-emerald-500/20') : (isRadar ? 'bg-cyan-500/30' : 'bg-blue-500/20')}`}\n          style={{ transform: `scale(${1.4 * breathe})` }}\n        />\n        <div className=\"relative text-center\">\n          <div className={`${isMobile ? 'text-5xl' : 'text-6xl'} font-bold tabular-nums ${confidenceColor}`}>\n            <AnimatedCounter value={confidence} frame={frame} fps={fps} delay={6} suffix=\"%\" />\n          </div>\n          <div className={`${isMobile ? 'text-sm' : 'text-base'} mt-1 font-medium ${isRadar ? 'text-white/90' : 'text-stone-700'}`}>\n            Overall Confidence\n          </div>\n        </div>\n      </div>\n\n      {/* Stats row */}\n      <div\n        className={`flex ${isMobile ? 'gap-4 mt-6' : 'gap-6 mt-8'}`}\n        style={{ opacity: statsProgress, transform: `translateY(${(1 - statsProgress) * 10}px)` }}\n      >\n        <StatCard\n          value={findings}\n          label=\"Findings\"\n          frame={frame}\n          fps={fps}\n          delay={20}\n          isRadar={isRadar}\n          isMobile={isMobile}\n          color={isRadar ? 'text-cyan-400' : 'text-blue-600'}\n        />\n        <StatCard\n          value={sources}\n          label=\"Sources\"\n          frame={frame}\n          fps={fps}\n          delay={24}\n          isRadar={isRadar}\n          isMobile={isMobile}\n          color={isRadar ? 'text-emerald-400' : 'text-emerald-600'}\n        />\n      </div>\n\n      {/* Completion badge */}\n      <div\n        className={`${isMobile ? 'mt-5 px-4 py-2' : 'mt-6 px-5 py-2.5'} rounded-full shadow-lg ${\n          isRadar ? 'bg-gradient-to-r from-emerald-500/20 to-cyan-500/20 border border-emerald-500/30 text-emerald-300' : 'bg-gradient-to-r from-emerald-100 to-cyan-100 border border-emerald-300 text-emerald-700'\n        }`}\n        style={{ opacity: badgeProgress, transform: `scale(${0.88 + badgeProgress * 0.12})` }}\n      >\n        <div className=\"flex items-center gap-2\">\n          <div className={`${isMobile ? 'w-4 h-4' : 'w-5 h-5'} rounded-full flex items-center justify-center ${isRadar ? 'bg-emerald-500/30' : 'bg-emerald-500/20'}`}>\n            <svg className={`${isMobile ? 'w-2.5 h-2.5' : 'w-3 h-3'}`} fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" strokeWidth={3}>\n              <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M5 13l4 4L19 7\" />\n            </svg>\n          </div>\n          <span className={`font-semibold ${isMobile ? 'text-xs' : 'text-sm'}`}>Analysis Complete</span>\n        </div>\n      </div>\n\n      {/* Mobile: CTA at bottom */}\n      {isMobile && (\n        <div\n          className=\"absolute bottom-16 left-4 right-4 text-center\"\n          style={{ opacity: badgeProgress }}\n        >\n          <p className={`text-[10px] ${isRadar ? 'text-slate-500' : 'text-stone-400'}`}>\n            Follow for more insights\n          </p>\n        </div>\n      )}\n    </div>\n  );\n}\n\ninterface StatCardProps {\n  value: number;\n  label: string;\n  frame: number;\n  fps: number;\n  delay: number;\n  isRadar: boolean;\n  isMobile: boolean;\n  color: string;\n}\n\nfunction StatCard({ value, label, frame, fps, delay, isRadar, isMobile, color }: StatCardProps) {\n  return (\n    <div className={`text-center ${isMobile ? 'px-4 py-2' : 'px-5 py-2.5'} rounded-xl ${isRadar ? 'bg-slate-800/60 border border-slate-700' : 'bg-white/80 border border-stone-200'}`}>\n      <div className={`${isMobile ? 'text-xl' : 'text-2xl'} font-bold tabular-nums ${color}`}>\n        <AnimatedCounter value={value} frame={frame} fps={fps} delay={delay} />\n      </div>\n      <div className={`text-[10px] mt-0.5 ${isRadar ? 'text-slate-400' : 'text-stone-500'}`}>{label}</div>\n    </div>\n  );\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"cache_creation_input_tokens":401,"cache_read_input_tokens":60487,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":401},"output_tokens":24,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"9cec20cb-b613-4ab4-b437-0d4075a2df3d","uuid":"72df5adb-a183-40b6-bb26-26c6c31b750f"}
