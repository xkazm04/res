framesToAdd = Math.floor(delta / frameDuration);\n    47→        frameRef.current = Math.min(frameRef.current + framesToAdd, durationInFrames - 1);\n    48→        lastTimeRef.current = time - (delta % frameDuration);\n    49→\n    50→        setState(s => ({\n    51→          ...s,\n    52→          frame: frameRef.current,\n    53→          progress: frameRef.current / (durationInFrames - 1),\n    54→        }));\n    55→\n    56→        if (frameRef.current >= durationInFrames - 1) {\n    57→          setState(s => ({ ...s, playing: false }));\n    58→          return;\n    59→        }\n    60→      }\n    61→\n    62→      animationId = requestAnimationFrame(tick);\n    63→    };\n    64→\n    65→    lastTimeRef.current = 0;\n    66→    animationId = requestAnimationFrame(tick);\n    67→\n    68→    return () => cancelAnimationFrame(animationId);\n    69→  }, [state.playing, fps, durationInFrames]);\n    70→\n    71→  return { ...state, play, pause, toggle, reset, seekTo, config };\n    72→}\n    73→\n    74→// Smooth easing functions\n    75→export function easeOutCubic(t: number): number {\n    76→  return 1 - Math.pow(1 - t, 3);\n    77→}\n    78→\n    79→export function easeOutQuart(t: number): number {\n    80→  return 1 - Math.pow(1 - t, 4);\n    81→}\n    82→\n    83→export function easeInOutCubic(t: number): number {\n    84→  return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;\n    85→}\n    86→\n    87→export function easeOutExpo(t: number): number {\n    88→  return t === 1 ? 1 : 1 - Math.pow(2, -10 * t);\n    89→}\n    90→\n    91→// Interpolation with smooth easing\n    92→export function interpolate(\n    93→  input: number,\n    94→  inputRange: [number, number],\n    95→  outputRange: [number, number],\n    96→  options?: {\n    97→    extrapolateLeft?: 'clamp' | 'extend';\n    98→    extrapolateRight?: 'clamp' | 'extend';\n    99→    easing?: (t: number) => number;\n   100→  }\n   101→): number {\n   102→  const [inMin, inMax] = i