eferences';","+}","+","+interface NetworkGraphProps {","+  nodes: Node[];","+  edges: Edge[];","+  onNodeClick?: (nodeId: string) => void;","+  highlightedNode?: string;","+}","+","+export function NetworkGraph({ nodes, edges, onNodeClick, highlightedNode }: NetworkGraphProps) {","+  const { colors, isRadar, entityColors, getEntityColor, surfaceClasses, tooltipClasses } = useVisualizationTheme();","+  const containerRef = useRef<HTMLDivElement>(null);","+  const [positions, setPositions] = useState<Map<string, { x: number; y: number }>>(new Map());","+  const [hoveredNode, setHoveredNode] = useState<string | null>(null);","+","+  // Force-directed layout simulation","+  useEffect(() => {","+    if (!containerRef.current || nodes.length === 0) return;","+","+    const width = containerRef.current.offsetWidth;","+    const height = containerRef.current.offsetHeight;","+    const centerX = width / 2;","+    const centerY = height / 2;","+","+    // Initialize positions in a circle","+    const newPositions = new Map<string, { x: number; y: number }>();","+    nodes.forEach((node, i) => {","+      const angle = (i / nodes.length) * Math.PI * 2;","+      const radius = Math.min(width, height) * 0.35;","+      newPositions.set(node.id, {","+        x: centerX + Math.cos(angle) * radius,","+        y: centerY + Math.sin(angle) * radius,","+      });","+    });","+","+    // Simple force simulation","+    const iterations = 50;","+    for (let iter = 0; iter < iterations; iter++) {","+      // Repulsion between all nodes","+      nodes.forEach((nodeA) => {","+        nodes.forEach((nodeB) => {","+          if (nodeA.id === nodeB.id) return;","+          const posA = newPositions.get(nodeA.id)!;","+          const posB = newPositions.get(nodeB.id)!;","+          const dx = posA.x - posB.x;","+          const dy = posA.y - posB.y;","+          const dist = Math.sqrt(dx * dx + dy * dy) || 1;","+          const force = 1000 / (dist * dist);","+          posA.x += (dx / dist) * force * 0.1;","+          posA.y += (dy / dist) * force * 0.1;","+        });","+      });","+","+      // Attraction along edges","+      edges.forEach((edge) => {","+        const posA = newPositions.get(edge.source);","+        const posB = newPositions.get(edge.target);","+        if (!posA || !posB) return;","+        const dx = posB.x - posA.x;","+        const dy = posB.y - posA.y;","+        const dist = Math.sqrt(dx * dx + dy * dy) || 1;","+        const force = dist * 0.01 * edge.strength;","+        posA.x += (dx / dist) * force;","+        posA.y += (dy / dist) * force;","+        posB.x -= (dx / dist) * force;","+        posB.y -= (dy / dist) * force;","+      });","+","+      // Keep in bounds","+      nodes.forEach((node) => {","+        const pos = newPositions.get(node.id)!;","+        pos.x = Math.max(40, Math.min(width - 40, pos.x));","+        pos.y = Math.max(40, Math.min(height - 40, pos.y));","+      });","+    }","+","+    setPositions(newPositions);","+  }, [nodes, edges]);","+","+  return (","+    <div","+      ref={containerRef}","+      className={`relative w-full h-64 rounded-xl overflow-hidden ${surfaceClasses}`}","+    >","+      {/* Grid pattern */}","+      <svg className=\"absolute inset-0 w-full h-full opacity-10\">","+        <defs>","+          <pattern id=\"grid\" width=\"20\" height=\"20\" patternUnits=\"userSpaceOnUse\">","+            <path d=\"M 20 0 L 0 0 0 20\" fill=\"none\" stroke={colors.primary} strokeWidth=\"0.5\" />","+          </pattern>","+        </defs>","+        <rect width=\"100%\" height=\"100%\" fill=\"url(#grid)\" />","+      </svg>","+","+      {/* Edges */}","+      <svg className=\"absolute inset-0 w-full h-full\">","+        {edges.map((edge, i) => {","+          const from = positions.get(edge.source);","+          const to = positions.get(edge.target);","+          if (!from || !to) return null;","+          const isHighlighted = hoveredNode === edge.source || hoveredNode === edge.target;","+          return (","+            <motion.line","+              key={i}","+              initial={{ pathLength: 0, opacity: 0 }}","+              animate={{ pathLength: 1, opacity: isHighlighted ? 0.8 : 0.3 }}","+              transition={{ duration: 0.5, delay: i * 0.02 }}","+              x1={from.x}","+              y1={from.y}","+              x2={to.x}","+              y2={to.y}","+              stroke={edge.type === 'contradicts' ? colors.contradictionLine : colors.connectionLine}","+              strokeWidth={isHighlighted ? 2 : 1}","+              strokeDasharray={edge.type === 'contradicts' ? '4,4' : undefined}","+            />","+          );","+        })}","+      </svg>","+","+      {/* Nodes */}","+      {nodes.map((node, i) => {","+        const pos = positions.get(node.id);","+        if (!pos) return null;","+        const color = getEntityColor(node.type);","+        const size = 12 + node.value * 20;","+        const isHovered = hoveredNode === node.id;","+        const isHighlightedNode = highlightedNode === node.id;","+","+        return (","+          <motion.div","+            key={node.id}","+            initial={{ scale: 0, opacity: 0 }}","+            animate={{","+              scale: isHovered || isHighlightedNode ? 1.3 : 1,","+              opacity: 1,","+              x: pos.x - size / 2,","+              y: pos.y - size / 2,","+            }}","+            transition={{ type: 'spring', damping: 20, delay: i * 0.03 }}","+            className=\"absolute cursor-pointer\"","+            style={{ width: size, height: size }}","+            onMouseEnter={() => setHoveredNode(node.id)}","+            onMouseLeave={() => setHoveredNode(null)}","+            onClick={() => onNodeClick?.(node.id)}","+          >","+            <div","+              className=\"w-full h-full rounded-full flex items-center justify-center transition-shadow\"","+              style={{","+                backgroundColor: color,","+                boxShadow: isHovered || isHighlightedNode ? `0 0 20px ${color}` : `0 0 8px ${color}50`,","+              }}","+            >","+              {isHovered && (","+                <motion.div","+                  initial={{ opacity: 0, y: 10 }}","+                  animate={{ opacity: 1, y: 0 }}","+                  className={`absolute -bottom-8 left-1/2 -translate-x-1/2 whitespace-nowrap px-2 py-1 rounded text-[10px] font-medium ${tooltipClasses}`}","+                >","+                  {node.label}","+                </motion.div>","+              )}","+            </div>","+          </motion.div>","+        );","+      })}","+    </div>","+  );","+}"]}],"originalFile":"'use client';\r\n\r\nimport { useEffect, useRef, useState } from 'react';\r\nimport { motion } from 'framer-motion';\r\nimport { useReportTheme } from '../core/ThemeContext';\r\n\r\ninterface Node {\r\n  id: string;\r\n  label: string;\r\n  type: 'finding' | 'source' | 'entity' | 'perspective';\r\n  value: number; // 0-1 for sizing\r\n  x?: number;\r\n  y?: number;\r\n}\r\n\r\ninterface Edge {\r\n  source: string;\r\n  target: string;\r\n  strength: number; // 0-1\r\n  type?: 'supports' | 'contradicts' | 'references';\r\n}\r\n\r\ninterface NetworkGraphProps {\r\n  nodes: Node[];\r\n  edges: Edge[];\r\n  onNodeClick?: (nodeId: string) => void;\r\n  highlightedNode?: string;\r\n}\r\n\r\nconst typeColors = {\r\n  finding: { radar: '#22d3ee', swiss: '#0ea5e9' },\r\n  source: { radar: '#a78bfa', swiss: '#7c3aed' },\r\n  entity: { radar: '#fb7185', swiss: '#e11d48' },\r\n  perspective: { radar: '#34d399', swiss: '#059669' },\r\n};\r\n\r\nexport function NetworkGraph({ nodes, edges, onNodeClick, highlightedNode }: NetworkGraphProps) {\r\n  const { theme } = useReportTheme();\r\n  const containerRef = useRef<HTMLDivElement>(null);\r\n  const [positions, setPositions] = useState<Map<string, { x: number; y: number }>>(new Map());\r\n  const [hoveredNode, setHoveredNode] = useState<string | null>(null);\r\n\r\n  // Force-directed layout simulation\r\n  useEffect(() => {\r\n    if (!containerRef.current || nodes.length === 0) return;\r\n\r\n    const width = containerRef.current.offsetWidth;\r\n    const height = containerRef.current.offsetHeight;\r\n    const centerX = width / 2;\r\n    const centerY = height / 2;\r\n\r\n    // Initialize positions in a circle\r\n    const newPositions = new Map<string, { x: number; y: number }>();\r\n    nodes.forEach((node, i) => {\r\n      const angle = (i / nodes.length) * Math.PI * 2;\r\n      const radius = Math.min(width, height) * 0.35;\r\n      newPositions.set(node.id, {\r\n        x: centerX + Math.cos(angle) * radius,\r\n        y: centerY + Math.sin(angle) * radius,\r\n      });\r\n    });\r\n\r\n    // Simple force simulation\r\n    const iterations = 50;\r\n    for (let iter = 0; iter < iterations; iter++) {\r\n      // Repulsion between all nodes\r\n      nodes.forEach((nodeA) => {\r\n        nodes.forEach((nodeB) => {\r\n          if (nodeA.id === nodeB.id) return;\r\n          const posA = newPositions.get(nodeA.id)!;\r\n          const posB = newPositions.get(nodeB.id)!;\r\n          const dx = posA.x - posB.x;\r\n          const dy = posA.y - posB.y;\r\n          const dist = Math.sqrt(dx * dx + dy * dy) || 1;\r\n          const force = 1000 / (dist * dist);\r\n          posA.x += (dx / dist) * force * 0.1;\r\n          posA.y += (dy / dist) * force * 0.1;\r\n        });\r\n      });\r\n\r\n      // Attraction along edges\r\n      edges.forEach((edge) => {\r\n        const posA = newPositions.get(edge.source);\r\n        const posB = newPositions.get(edge.target);\r\n        if (!posA || !posB) return;\r\n        const dx = posB.x - posA.x;\r\n        const dy = posB.y - posA.y;\r\n        const dist = Math.sqrt(dx * dx + dy * dy) || 1;\r\n        const force = dist * 0.01 * edge.strength;\r\n        posA.x += (dx / dist) * force;\r\n        posA.y += (dy / dist) * force;\r\n        posB.x -= (dx / dist) * force;\r\n        posB.y -= (dy / dist) * force;\r\n      });\r\n\r\n      // Keep in bounds\r\n      nodes.forEach((node) => {\r\n        const pos = newPositions.get(node.id)!;\r\n        pos.x = Math.max(40, Math.min(width - 40, pos.x));\r\n        pos.y = Math.max(40, Math.min(height - 40, pos.y));\r\n      });\r\n    }\r\n\r\n    setPositions(newPositions);\r\n  }, [nodes, edges]);\r\n\r\n  const isRadar = theme === 'radar';\r\n\r\n  return (\r\n    <div\r\n      ref={containerRef}\r\n      className={`relative w-full h-64 rounded-xl overflow-hidden ${isRadar ? 'bg-slate-950' : 'bg-stone-100'}`}\r\n    >\r\n      {/* Grid pattern */}\r\n      <svg className=\"absolute inset-0 w-full h-full opacity-10\">\r\n        <defs>\r\n          <pattern id=\"grid\" width=\"20\" height=\"20\" patternUnits=\"userSpaceOnUse\">\r\n            <path d=\"M 20 0 L 0 0 0 20\" fill=\"none\" stroke={isRadar ? '#22d3ee' : '#78716c'} strokeWidth=\"0.5\" />\r\n          </pattern>\r\n        </defs>\r\n        <rect width=\"100%\" height=\"100%\" fill=\"url(#grid)\" />\r\n      </svg>\r\n\r\n      {/* Edges */}\r\n      <svg className=\"absolute inset-0 w-full h-full\">\r\n        {edges.map((edge, i) => {\r\n          const from = positions.get(edge.source);\r\n          const to = positions.get(edge.target);\r\n          if (!from || !to) return null;\r\n          const isHighlighted = hoveredNode === edge.source || hoveredNode === edge.target;\r\n          return (\r\n            <motion.line\r\n              key={i}\r\n              initial={{ pathLength: 0, opacity: 0 }}\r\n              animate={{ pathLength: 1, opacity: isHighlighted ? 0.8 : 0.3 }}\r\n              transition={{ duration: 0.5, delay: i * 0.02 }}\r\n              x1={from.x}\r\n              y1={from.y}\r\n              x2={to.x}\r\n              y2={to.y}\r\n              stroke={edge.type === 'contradicts' ? '#f87171' : isRadar ? '#22d3ee' : '#78716c'}\r\n              strokeWidth={isHighlighted ? 2 : 1}\r\n              strokeDasharray={edge.type === 'contradicts' ? '4,4' : undefined}\r\n            />\r\n          );\r\n        })}\r\n      </svg>\r\n\r\n      {/* Nodes */}\r\n      {nodes.map((node, i) => {\r\n        const pos = positions.get(node.id);\r\n        if (!pos) return null;\r\n        const color = typeColors[node.type][theme];\r\n        const size = 12 + node.value * 20;\r\n        const isHovered = hoveredNode === node.id;\r\n        const isHighlightedNode = highlightedNode === node.id;\r\n\r\n        return (\r\n          <motion.div\r\n            key={node.id}\r\n            initial={{ scale: 0, opacity: 0 }}\r\n            animate={{\r\n              scale: isHovered || isHighlightedNode ? 1.3 : 1,\r\n              opacity: 1,\r\n              x: pos.x - size / 2,\r\n              y: pos.y - size / 2,\r\n            }}\r\n            transition={{ type: 'spring', damping: 20, delay: i * 0.03 }}\r\n            className=\"absolute cursor-pointer\"\r\n            style={{ width: size, height: size }}\r\n            onMouseEnter={() => setHoveredNode(node.id)}\r\n            onMouseLeave={() => setHoveredNode(null)}\r\n            onClick={() => onNodeClick?.(node.id)}\r\n          >\r\n            <div\r\n              className=\"w-full h-full rounded-full flex items-center justify-center transition-shadow\"\r\n              style={{\r\n                backgroundColor: color,\r\n                boxShadow: isHovered || isHighlightedNode ? `0 0 20px ${color}` : `0 0 8px ${color}50`,\r\n              }}\r\n            >\r\n              {isHovered && (\r\n                <motion.div\r\n                  initial={{ opacity: 0, y: 10 }}\r\n                  animate={{ opacity: 1, y: 0 }}\r\n                  className={`absolute -bottom-8 left-1/2 -translate-x-1/2 whitespace-nowrap px-2 py-1 rounded text-[10px] font-medium ${isRadar ? 'bg-slate-800 text-white' : 'bg-white text-stone-800 shadow-lg'}`}\r\n                >\r\n                  {node.label}\r\n                </motion.div>\r\n              )}\r\n            </div>\r\n          </motion.div>\r\n        );\r\n      })}\r\n    </div>\r\n  );\r\n}\r\n"}}
