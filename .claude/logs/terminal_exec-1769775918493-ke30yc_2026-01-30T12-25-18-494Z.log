00/60 border ${status === 'resolved' ? 'border-emerald-500/30' : status === 'investigating' ? 'border-amber-500/30' : 'border-rose-500/30'}`\n                : `bg-white border ${status === 'resolved' ? 'border-emerald-300' : status === 'investigating' ? 'border-amber-300' : 'border-rose-300'}`\n            }`}\n          >\n            {/* Header */}\n            <button\n              onClick={() => setExpanded(isExpanded ? null : c.id)}\n              className=\"w-full p-4 flex items-center gap-4\"\n            >\n              {/* Severity indicator */}\n              <motion.div\n                animate={{ scale: status === 'unresolved' ? [1, 1.2, 1] : 1 }}\n                transition={{ duration: 2, repeat: status === 'unresolved' ? Infinity : 0 }}\n                className={`w-10 h-10 rounded-full flex items-center justify-center ${\n                  status === 'resolved'\n                    ? isRadar ? 'bg-emerald-500/20 text-emerald-400' : 'bg-emerald-100 text-emerald-600'\n                    : status === 'investigating'\n                      ? isRadar ? 'bg-amber-500/20 text-amber-400' : 'bg-amber-100 text-amber-600'\n                      : isRadar ? 'bg-rose-500/20 text-rose-400' : 'bg-rose-100 text-rose-600'\n                }`}\n              >\n                {status === 'resolved' ? '✓' : status === 'investigating' ? '?' : '⚡'}\n              </motion.div>\n\n              {/* Summary */}\n              <div className=\"flex-1 text-left\">\n                <div className={`text-sm font-medium ${styles.text}`}>\n                  {c.claim_1?.slice(0, 50)}... <span className={isRadar ? 'text-rose-400' : 'text-rose-500'}>vs</span> {c.claim_2?.slice(0, 50)}...\n                </div>\n                <div className={`text-xs mt-1 ${styles.textMuted}`}>\n                  {status === 'resolved' ? 'Resolved' : status === 'investigating' ? 'Under investigation' : 'Needs resolution'}\n                </div>\n              </div>\n\n              {/* Expand arrow */}\n              <motion.svg\n                animate={{ rotate: isExpanded ? 180 : 0 }}\n                className={`w-5 h-5 ${styles.textMuted}`}\n                fill=\"none\"\n                viewBox=\"0 0 24 24\"\n                stroke=\"currentColor\"\n              >\n                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M19 9l-7 7-7-7\" />\n              </motion.svg>\n            </button>\n\n            {/* Expanded content */}\n            <AnimatePresence>\n              {isExpanded && (\n                <motion.div\n                  initial={{ height: 0, opacity: 0 }}\n                  animate={{ height: 'auto', opacity: 1 }}\n                  exit={{ height: 0, opacity: 0 }}\n                  className={`border-t ${isRadar ? 'border-white/5' : 'border-stone-200'}`}\n                >\n                  <div className=\"p-4 space-y-4\">\n                    {/* Claims comparison */}\n                    <div className=\"grid grid-cols-2 gap-4\">\n                      <ClaimCard label=\"Claim A\" text={c.claim_1 || ''} isRadar={isRadar} />\n                      <ClaimCard label=\"Claim B\" text={c.claim_2 || ''} isRadar={isRadar} />\n                    </div>\n\n                    {/* Resolution hint */}\n                    {c.resolution_hint && (\n                      <div className={`p-3 rounded-lg ${isRadar ? 'bg-slate-800/50' : 'bg-stone-50'}`}>\n                        <div className={`text-[10px] uppercase tracking-wider mb-1 ${isRadar ? 'text-cyan-400/60' : 'text-stone-500'}`}>\n                          Resolution Hint\n                        </div>\n                        <p className={`text-sm ${styles.text}`}>{c.resolution_hint}</p>\n                      </div>\n                    )}\n\n                    {/* Actions */}\n                    <div className=\"flex gap-2\">\n                      {(['unresolved', 'investigating', 'resolved'] as ResolutionStatus[]).map(s => (\n                        <button\n                          key={s}\n                          onClick={() => setStatus(c.id, s)}\n                          className={`px-3 py-1.5 rounded-lg text-xs font-medium capitalize transition-all ${\n                            status === s\n                              ? isRadar ? 'bg-cyan-500/20 text-cyan-300' : 'bg-stone-800 text-white'\n                              : isRadar ? 'bg-slate-800/50 text-slate-400 hover:text-white' : 'bg-stone-100 text-stone-600 hover:bg-stone-200'\n                          }`}\n                        >\n                          {s}\n                        </button>\n                      ))}\n                    </div>\n                  </div>\n                </motion.div>\n              )}\n            </AnimatePresence>\n          </motion.div>\n        );\n      })}\n    </div>\n  );\n}\n\nfunction ClaimCard({ label, text, isRadar }: { label: string; text: string; isRadar: boolean }) {\n  return (\n    <div className={`p-3 rounded-lg ${isRadar ? 'bg-slate-800/50' : 'bg-stone-50'}`}>\n      <div className={`text-[10px] uppercase tracking-wider mb-2 ${isRadar ? 'text-rose-400/60' : 'text-rose-500'}`}>\n        {label}\n      </div>\n      <p className={`text-sm ${isRadar ? 'text-slate-300' : 'text-stone-700'}`}>{text}</p>\n    </div>\n  );\n}\n","numLines":149,"startLine":1,"totalLines":149}}}
