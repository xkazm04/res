3→                scale: hoveredNode === node.id || selectedSource === node.id ? 1.5 : 1,\n    94→                opacity: hoveredNode && hoveredNode !== node.id ? 0.4 : 1\n    95→              }}\n    96→              cx={node.x}\n    97→              cy={node.y}\n    98→              r={node.radius}\n    99→              fill={credColor(node.credibility)}\n   100→              stroke={selectedSource === node.id ? (isRadar ? '#fff' : '#000') : 'transparent'}\n   101→              strokeWidth={2}\n   102→              className=\"cursor-pointer\"\n   103→              onMouseEnter={() => setHoveredNode(node.id)}\n   104→              onMouseLeave={() => setHoveredNode(null)}\n   105→              onClick={() => onSourceSelect?.(node.id)}\n   106→            />\n   107→          </g>\n   108→        ))}\n   109→      </svg>\n   110→\n   111→      {/* Labels */}\n   112→      <div className={`absolute bottom-3 left-3 flex items-center gap-4 text-[10px] ${isRadar ? 'text-slate-400' : 'text-stone-500'}`}>\n   113→        <span className=\"flex items-center gap-1\"><span className=\"w-2 h-2 rounded-full bg-emerald-500\" /> High</span>\n   114→        <span className=\"flex items-center gap-1\"><span className=\"w-2 h-2 rounded-full bg-amber-500\" /> Medium</span>\n   115→        <span className=\"flex items-center gap-1\"><span className=\"w-2 h-2 rounded-full bg-rose-500\" /> Low</span>\n   116→      </div>\n   117→\n   118→      {/* Center label */}\n   119→      <div className={`absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-center pointer-events-none ${isRadar ? 'text-cyan-400/40' : 'text-stone-400'}`}>\n   120→        <div className=\"text-[10px] uppercase tracking-wider\">Trust Core</div>\n   121→      </div>\n   122→    </div>\n   123→  );\n   124→}\n   125→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"9cec20cb-b613-4ab4-b437-0d4075a2df3d","uuid":"46eb6111-9b8c-4ffc-b673-1714ffcc6d6c","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\visualizations\\SourceNetwork.tsx","content":"'use client';\n\nimport { useState, useEffect, useRef } from 'react';\nimport { motion } from 'framer-motion';\nimport { useReportTheme } from '../core/ThemeContext';\nimport type { ResearchSource } from '@/src/types/research';\n\ninterface SourceNetworkProps {\n  sources: ResearchSource[];\n  onSourceSelect?: (id: string) => void;\n  selectedSource?: string;\n}\n\ninterface SourceNode {\n  id: string;\n  x: number;\n  y: number;\n  radius: number;\n  credibility: number;\n  domain: string;\n  type: string;\n}\n\nexport function SourceNetwork({ sources, onSourceSelect, selectedSource }: SourceNetworkProps) {\n  const { theme } = useReportTheme();\n  const isRadar = theme === 'radar';\n  const containerRef = useRef<HTMLDivElement>(null);\n  const [nodes, setNodes] = useState<SourceNode[]>([]);\n  const [hoveredNode, setHoveredNode] = useState<string | null>(null);\n  const [dimensions, setDimensions] = useState({ width: 400, height: 300 });\n\n  // Group sources by domain and calculate positions\n  useEffect(() => {\n    if (!containerRef.current) return;\n    const rect = containerRef.current.getBoundingClientRect();\n    setDimensions({ width: rect.width, height: 300 });\n  }, []);\n\n  useEffect(() => {\n    const { width, height } = dimensions;\n    const centerX = width / 2;\n    const centerY = height / 2;\n    const maxRadius = Math.min(width, height) * 0.4;\n\n    // Position nodes in concentric circles by credibility\n    const positioned: SourceNode[] = sources.map((s, i) => {\n      const cred = s.credibility_score || 0.5;\n      const radius = maxRadius * (1 - cred * 0.8); // Higher cred = closer to center\n      const angle = (i / sources.length) * Math.PI * 2 + Math.random() * 0.3;\n\n      return {\n        id: s.id,\n        x: centerX + Math.cos(angle) * radius,\n        y: centerY + Math.sin(angle) * radius,\n        radius: 6 + cred * 14,\n        credibility: cred,\n        domain: s.domain || 'unknown',\n        type: s.source_type || 'web',\n      };\n    });\n\n    setNodes(positioned);\n  }, [sources, dimensions]);\n\n  const credColor = (cred: number) => {\n    if (cred >= 0.8) return isRadar ? '#34d399' : '#059669';\n    if (cred >= 0.5) return isRadar ? '#fbbf24' : '#d97706';\n    return isRadar ? '#f87171' : '#dc2626';\n  };\n\n  return (\n    <div ref={containerRef} className={`relative rounded-xl overflow-hidden ${isRadar ? 'bg-slate-950/50' : 'bg-stone-50'}`} style={{ height: 300 }}>\n      {/* Trust rings */}\n      <svg className=\"absolute inset-0\" width={dimensions.width} height={dimensions.height}>\n        {[0.8, 0.5, 0.2].map((level, i) => (\n          <circle\n            key={level}\n            cx={dimensions.width / 2}\n            cy={dimensions.height / 2}\n            r={Math.min(dimensions.width, dimensions.height) * 0.4 * (1 - level * 0.8)}\n            fill=\"none\"\n            stroke={isRadar ? 'rgba(34,211,238,0.1)' : 'rgba(0,0,0,0.05)'}\n            strokeDasharray=\"4 4\"\n          />\n        ))}\n\n        {/* Nodes */}\n        {nodes.map((node) => (\n          <g key={node.id}>\n            <motion.circle\n              initial={{ scale: 0 }}\n              animate={{\n                scale: hoveredNode === node.id || selectedSource === node.id ? 1.5 : 1,\n                opacity: hoveredNode && hoveredNode !== node.id ? 0.4 : 1\n              }}\n              cx={node.x}\n              cy={node.y}\n              r={node.radius}\n              fill={credColor(node.credibility)}\n              stroke={selectedSource === node.id ? (isRadar ? '#fff' : '#000') : 'transparent'}\n              strokeWidth={2}\n              className=\"cursor-pointer\"\n              onMouseEnter={() => setHoveredNode(node.id)}\n              onMouseLeave={() => setHoveredNode(null)}\n              onClick={() => onSourceSelect?.(node.id)}\n            />\n          </g>\n        ))}\n      </svg>\n\n      {/* Labels */}\n      <div className={`absolute bottom-3 left-3 flex items-center gap-4 text-[10px] ${isRadar ? 'text-slate-400' : 'text-stone-500'}`}>\n        <span className=\"flex items-center gap-1\"><span className=\"w-2 h-2 rounded-full bg-emerald-500\" /> High</span>\n        <span className=\"flex items-center gap-1\"><span className=\"w-2 h-2 rounded-full bg-amber-500\" /> Medium</span>\n        <span className=\"flex items-center gap-1\"><span className=\"w-2 h-2 rounded-full bg-rose-500\" /> Low</span>\n      </div>\n\n      {/* Center label */}\n      <div className={`absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-center pointer-events-none ${isRadar ? 'text-cyan-400/40' : 'text-stone-400'}`}>\n        <div className=\"text-[10px] uppercase tracking-wider\">Trust Core</div>\n      </div>\n    </div>\n  );\n}\n","numLines":125,"startLine":1,"totalLines":125}}}
