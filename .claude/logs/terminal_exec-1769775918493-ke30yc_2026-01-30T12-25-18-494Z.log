68, 68)';\n  };\n\n  const sorted = [...data].sort((a, b) => b.value - a.value);\n\n  return (\n    <div className={`rounded-xl p-4 ${isRadar ? 'bg-slate-900/60' : 'bg-stone-50'}`}>\n      {title && (\n        <h4 className={`text-xs font-semibold uppercase tracking-wider mb-3 ${styles.textMuted}`}>{title}</h4>\n      )}\n\n      {/* Legend */}\n      <div className=\"flex items-center gap-1 mb-3\">\n        <span className={`text-[10px] ${styles.textMuted}`}>Low</span>\n        <div className=\"flex-1 h-2 rounded-full overflow-hidden flex\">\n          {[0.1, 0.3, 0.5, 0.7, 0.9].map((v) => (\n            <div key={v} className=\"flex-1\" style={{ backgroundColor: getColor(v) }} />\n          ))}\n        </div>\n        <span className={`text-[10px] ${styles.textMuted}`}>High</span>\n      </div>\n\n      {/* Grid */}\n      <div className=\"grid grid-cols-5 gap-1\">\n        {sorted.map((cell, i) => (\n          <motion.button\n            key={cell.id}\n            initial={{ opacity: 0, scale: 0.8 }}\n            animate={{ opacity: 1, scale: 1 }}\n            transition={{ delay: i * 0.02 }}\n            whileHover={{ scale: 1.1, zIndex: 10 }}\n            onClick={() => onCellClick?.(cell.id)}\n            className=\"relative aspect-square rounded-md flex items-center justify-center cursor-pointer group\"\n            style={{\n              backgroundColor: getColor(cell.value),\n              boxShadow: isRadar && cell.value >= 0.8 ? `0 0 15px ${getColor(cell.value)}` : undefined,\n            }}\n          >\n            <span className={`text-[10px] font-bold ${cell.value >= 0.5 ? 'text-white' : isRadar ? 'text-white' : 'text-stone-800'}`}>\n              {Math.round(cell.value * 100)}\n            </span>\n\n            {/* Hover tooltip */}\n            <div className={`absolute -top-8 left-1/2 -translate-x-1/2 px-2 py-1 rounded text-[10px] whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity z-20 ${isRadar ? 'bg-slate-800 text-white' 