      });\n    95→\n    96→      // Keep in bounds\n    97→      nodes.forEach((node) => {\n    98→        const pos = newPositions.get(node.id)!;\n    99→        pos.x = Math.max(40, Math.min(width - 40, pos.x));\n   100→        pos.y = Math.max(40, Math.min(height - 40, pos.y));\n   101→      });\n   102→    }\n   103→\n   104→    setPositions(newPositions);\n   105→  }, [nodes, edges]);\n   106→\n   107→  const isRadar = theme === 'radar';\n   108→\n   109→  return (\n   110→    <div\n   111→      ref={containerRef}\n   112→      className={`relative w-full h-64 rounded-xl overflow-hidden ${isRadar ? 'bg-slate-950' : 'bg-stone-100'}`}\n   113→    >\n   114→      {/* Grid pattern */}\n   115→      <svg className=\"absolute inset-0 w-full h-full opacity-10\">\n   116→        <defs>\n   117→          <pattern id=\"grid\" width=\"20\" height=\"20\" patternUnits=\"userSpaceOnUse\">\n   118→            <path d=\"M 20 0 L 0 0 0 20\" fill=\"none\" stroke={isRadar ? '#22d3ee' : '#78716c'} strokeWidth=\"0.5\" />\n   119→          </pattern>\n   120→        </defs>\n   121→        <rect width=\"100%\" height=\"100%\" fill=\"url(#grid)\" />\n   122→      </svg>\n   123→\n   124→      {/* Edges */}\n   125→      <svg className=\"absolute inset-0 w-full h-full\">\n   126→        {edges.map((edge, i) => {\n   127→          const from = positions.get(edge.source);\n   128→          const to = positions.get(edge.target);\n   129→          if (!from || !to) return null;\n   130→          const isHighlighted = hoveredNode === edge.source || hoveredNode === edge.target;\n   131→          return (\n   132→            <motion.line\n   133→              key={i}\n   134→              initial={{ pathLength: 0, opacity: 0 }}\n   135→              animate={{ pathLength: 1, opacity: isHighlighted ? 0.8 : 0.3 }}\n   136→              transition={{ duration: 0.5, delay: i * 0.02 }}\n   137→              x1={from.x}\n   138→              y1={from.y}\n   139→              x2={to.x}\n   140→    