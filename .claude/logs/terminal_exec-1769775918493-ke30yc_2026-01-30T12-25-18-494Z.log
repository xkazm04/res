ary */}","+              <div className=\"flex-1 text-left\">","+                <div className=\"text-sm font-medium\" style={{ color: colors.textPrimary }}>","+                  {c.claim_1?.slice(0, 50)}... <span style={{ color: colors.danger }}>vs</span> {c.claim_2?.slice(0, 50)}...","+                </div>","+                <div className=\"text-xs mt-1\" style={{ color: colors.textSecondary }}>","+                  {status === 'resolved' ? 'Resolved' : status === 'investigating' ? 'Under investigation' : 'Needs resolution'}","+                </div>","+              </div>","+","+              {/* Expand arrow */}","+              <motion.svg","+                animate={{ rotate: isExpanded ? 180 : 0 }}","+                className=\"w-5 h-5\"","+                style={{ color: colors.textSecondary }}","+                fill=\"none\"","+                viewBox=\"0 0 24 24\"","+                stroke=\"currentColor\"","+              >","+                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M19 9l-7 7-7-7\" />","+              </motion.svg>","+            </button>","+","+            {/* Expanded content */}","+            <AnimatePresence>","+              {isExpanded && (","+                <motion.div","+                  initial={{ height: 0, opacity: 0 }}","+                  animate={{ height: 'auto', opacity: 1 }}","+                  exit={{ height: 0, opacity: 0 }}","+                  style={{ borderTop: `1px solid ${colors.borderSubtle}` }}","+                >","+                  <div className=\"p-4 space-y-4\">","+                    {/* Claims comparison */}","+                    <div className=\"grid grid-cols-2 gap-4\">","+                      <ClaimCard label=\"Claim A\" text={c.claim_1 || ''} colors={colors} />","+                      <ClaimCard label=\"Claim B\" text={c.claim_2 || ''} colors={colors} />","+                    </div>","+","+                    {/* Resolution hint */}","+                    {c.resolution_hint && (","+                      <div className={`p-3 rounded-lg ${surfaceClasses}`}>","+                        <div","+                          className=\"text-[10px] uppercase tracking-wider mb-1\"","+                          style={{ color: isRadar ? colors.primaryMuted : colors.textSecondary }}","+                        >","+                          Resolution Hint","+                        </div>","+                        <p className=\"text-sm\" style={{ color: colors.textPrimary }}>{c.resolution_hint}</p>","+                      </div>","+                    )}","+","+                    {/* Actions */}","+                    <div className=\"flex gap-2\">","+                      {(['unresolved', 'investigating', 'resolved'] as ResolutionStatus[]).map(s => (","+                        <button","+                          key={s}","+                          onClick={() => setStatus(c.id, s)}","+                          className={`px-3 py-1.5 rounded-lg text-xs font-medium capitalize transition-all ${getButtonClasses(status === s)}`}","+                        >","+                          {s}","+                        </button>","+                      ))}","+                    </div>","+                  </div>","+                </motion.div>","+              )}","+            </AnimatePresence>","+          </motion.div>","+        );","+      })}","+    </div>","+  );","+}","+","+function ClaimCard({ label, text, colors }: { label: string; text: string; colors: ReturnType<typeof useVisualizationTheme>['colors'] }) {","+  return (","+    <div className=\"p-3 rounded-lg\" style={{ backgroundColor: colors.surfaceBg }}>","+      <div","+        className=\"text-[10px] uppercase tracking-wider mb-2\"","+        style={{ color: `${colors.danger}99` }}","+      >","+        {label}","+      </div>","+      <p className=\"text-sm\" style={{ color: colors.textPrimary }}>{text}</p>","+    </div>","+  );","+}"]}],"originalFile":"'use client';\r\n\r\nimport { useState } from 'react';\r\nimport { motion, AnimatePresence } from 'framer-motion';\r\nimport { useReportTheme, useThemeStyles } from '../core/ThemeContext';\r\nimport type { ResearchContradiction } from '@/src/types/research';\r\n\r\ninterface ContradictionMatrixProps {\r\n  contradictions: ResearchContradiction[];\r\n}\r\n\r\ntype ResolutionStatus = 'unresolved' | 'investigating' | 'resolved';\r\n\r\nexport function ContradictionMatrix({ contradictions }: ContradictionMatrixProps) {\r\n  const { theme } = useReportTheme();\r\n  const isRadar = theme === 'radar';\r\n  const styles = useThemeStyles();\r\n  const [expanded, setExpanded] = useState<string | null>(null);\r\n  const [statuses, setStatuses] = useState<Record<string, ResolutionStatus>>({});\r\n\r\n  const setStatus = (id: string, status: ResolutionStatus) => {\r\n    setStatuses(prev => ({ ...prev, [id]: status }));\r\n  };\r\n\r\n  return (\r\n    <div className=\"space-y-3\">\r\n      {contradictions.map((c, i) => {\r\n        const status = statuses[c.id] || 'unresolved';\r\n        const isExpanded = expanded === c.id;\r\n\r\n        return (\r\n          <motion.div\r\n            key={c.id}\r\n            layout\r\n            initial={{ opacity: 0, x: -20 }}\r\n            animate={{ opacity: 1, x: 0 }}\r\n            transition={{ delay: i * 0.1 }}\r\n            className={`rounded-xl overflow-hidden ${\r\n              isRadar\r\n                ? `bg-slate-900/60 border ${status === 'resolved' ? 'border-emerald-500/30' : status === 'investigating' ? 'border-amber-500/30' : 'border-rose-500/30'}`\r\n                : `bg-white border ${status === 'resolved' ? 'border-emerald-300' : status === 'investigating' ? 'border-amber-300' : 'border-rose-300'}`\r\n            }`}\r\n          >\r\n            {/* Header */}\r\n            <button\r\n              onClick={() => setExpanded(isExpanded ? null : c.id)}\r\n              className=\"w-full p-4 flex items-center gap-4\"\r\n            >\r\n              {/* Severity indicator */}\r\n              <motion.div\r\n                animate={{ scale: status === 'unresolved' ? [1, 1.2, 1] : 1 }}\r\n                transition={{ duration: 2, repeat: status === 'unresolved' ? Infinity : 0 }}\r\n                className={`w-10 h-10 rounded-full flex items-center justify-center ${\r\n                  status === 'resolved'\r\n                    ? isRadar ? 'bg-emerald-500/20 text-emerald-400' : 'bg-emerald-100 text-emerald-600'\r\n                    : status === 'investigating'\r\n                      ? isRadar ? 'bg-amber-500/20 text-amber-400' : 'bg-amber-100 text-amber-600'\r\n                      : isRadar ? 'bg-rose-500/20 text-rose-400' : 'bg-rose-100 text-rose-600'\r\n                }`}\r\n              >\r\n                {status === 'resolved' ? '✓' : status === 'investigating' ? '?' : '⚡'}\r\n              </motion.div>\r\n\r\n              {/* Summary */}\r\n              <div className=\"flex-1 text-left\">\r\n                <div className={`text-sm font-medium ${styles.text}`}>\r\n                  {c.claim_1?.slice(0, 50)}... <span className={isRadar ? 'text-rose-400' : 'text-rose-500'}>vs</span> {c.claim_2?.slice(0, 50)}...\r\n                </div>\r\n                <div className={`text-xs mt-1 ${styles.textMuted}`}>\r\n                  {status === 'resolved' ? 'Resolved' : status === 'investigating' ? 'Under investigation' : 'Needs resolution'}\r\n                </div>\r\n              </div>\r\n\r\n              {/* Expand arrow */}\r\n              <motion.svg\r\n                animate={{ rotate: isExpanded ? 180 : 0 }}\r\n                className={`w-5 h-5 ${styles.textMuted}`}\r\n                fill=\"none\"\r\n                viewBox=\"0 0 24 24\"\r\n                stroke=\"currentColor\"\r\n              >\r\n                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M19 9l-7 7-7-7\" />\r\n              </motion.svg>\r\n            </button>\r\n\r\n            {/* Expanded content */}\r\n            <AnimatePresence>\r\n              {isExpanded && (\r\n                <motion.div\r\n                  initial={{ height: 0, opacity: 0 }}\r\n                  animate={{ height: 'auto', opacity: 1 }}\r\n                  exit={{ height: 0, opacity: 0 }}\r\n                  className={`border-t ${isRadar ? 'border-white/5' : 'border-stone-200'}`}\r\n                >\r\n                  <div className=\"p-4 space-y-4\">\r\n                    {/* Claims comparison */}\r\n                    <div className=\"grid grid-cols-2 gap-4\">\r\n                      <ClaimCard label=\"Claim A\" text={c.claim_1 || ''} isRadar={isRadar} />\r\n                      <ClaimCard label=\"Claim B\" text={c.claim_2 || ''} isRadar={isRadar} />\r\n                    </div>\r\n\r\n                    {/* Resolution hint */}\r\n                    {c.resolution_hint && (\r\n                      <div className={`p-3 rounded-lg ${isRadar ? 'bg-slate-800/50' : 'bg-stone-50'}`}>\r\n                        <div className={`text-[10px] uppercase tracking-wider mb-1 ${isRadar ? 'text-cyan-400/60' : 'text-stone-500'}`}>\r\n                          Resolution Hint\r\n                        </div>\r\n                        <p className={`text-sm ${styles.text}`}>{c.resolution_hint}</p>\r\n                      </div>\r\n                    )}\r\n\r\n                    {/* Actions */}\r\n                    <div className=\"flex gap-2\">\r\n                      {(['unresolved', 'investigating', 'resolved'] as ResolutionStatus[]).map(s => (\r\n                        <button\r\n                          key={s}\r\n                          onClick={() => setStatus(c.id, s)}\r\n                          className={`px-3 py-1.5 rounded-lg text-xs font-medium capitalize transition-all ${\r\n                            status === s\r\n                              ? isRadar ? 'bg-cyan-500/20 text-cyan-300' : 'bg-stone-800 text-white'\r\n                              : isRadar ? 'bg-slate-800/50 text-slate-400 hover:text-white' : 'bg-stone-100 text-stone-600 hover:bg-stone-200'\r\n                          }`}\r\n                        >\r\n                          {s}\r\n                        </button>\r\n                      ))}\r\n                    </div>\r\n                  </div>\r\n                </motion.div>\r\n              )}\r\n            </AnimatePresence>\r\n          </motion.div>\r\n        );\r\n      })}\r\n    </div>\r\n  );\r\n}\r\n\r\nfunction ClaimCard({ label, text, isRadar }: { label: string; text: string; isRadar: boolean }) {\r\n  return (\r\n    <div className={`p-3 rounded-lg ${isRadar ? 'bg-slate-800/50' : 'bg-stone-50'}`}>\r\n      <div className={`text-[10px] uppercase tracking-wider mb-2 ${isRadar ? 'text-rose-400/60' : 'text-rose-500'}`}>\r\n        {label}\r\n      </div>\r\n      <p className={`text-sm ${isRadar ? 'text-slate-300' : 'text-stone-700'}`}>{text}</p>\r\n    </div>\r\n  );\r\n}\r\n"}}
