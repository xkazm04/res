fill=\"none\"","+                      stroke={config.color}","+                      strokeWidth=\"1\"","+                      strokeDasharray={`${event.confidence * 37.7} 37.7`}","+                      opacity={0.5}","+                    />","+                  </svg>","+                )}","+              </motion.div>","+","+              {/* Tooltip */}","+              {isHovered && (","+                <motion.div","+                  initial={{ opacity: 0, y: 5 }}","+                  animate={{ opacity: 1, y: 0 }}","+                  className={`absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 rounded text-[10px] whitespace-nowrap z-10 ${tooltipClasses}`}","+                >","+                  {event.label}","+                </motion.div>","+              )}","+            </motion.div>","+          );","+        })}","+      </div>","+    </div>","+  );","+}"]}],"originalFile":"'use client';\r\n\r\nimport { useRef, useState } from 'react';\r\nimport { motion } from 'framer-motion';\r\nimport { useReportTheme, useThemeStyles } from '../core/ThemeContext';\r\n\r\ninterface TimelineEvent {\r\n  id: string;\r\n  date: Date;\r\n  label: string;\r\n  type: 'finding' | 'event' | 'prediction';\r\n  confidence?: number;\r\n}\r\n\r\ninterface TimelineProps {\r\n  events: TimelineEvent[];\r\n  onEventClick?: (eventId: string) => void;\r\n}\r\n\r\nexport function Timeline({ events, onEventClick }: TimelineProps) {\r\n  const { theme } = useReportTheme();\r\n  const styles = useThemeStyles();\r\n  const containerRef = useRef<HTMLDivElement>(null);\r\n  const [hoveredEvent, setHoveredEvent] = useState<string | null>(null);\r\n\r\n  if (events.length === 0) return null;\r\n\r\n  const sortedEvents = [...events].sort((a, b) => a.date.getTime() - b.date.getTime());\r\n  const minDate = sortedEvents[0].date.getTime();\r\n  const maxDate = sortedEvents[sortedEvents.length - 1].date.getTime();\r\n  const range = maxDate - minDate || 1;\r\n\r\n  const getPosition = (date: Date) => ((date.getTime() - minDate) / range) * 100;\r\n\r\n  const typeConfig = {\r\n    finding: { color: theme === 'radar' ? '#22d3ee' : '#0ea5e9', icon: '◆' },\r\n    event: { color: theme === 'radar' ? '#a78bfa' : '#7c3aed', icon: '●' },\r\n    prediction: { color: theme === 'radar' ? '#fbbf24' : '#d97706', icon: '◇' },\r\n  };\r\n\r\n  const isRadar = theme === 'radar';\r\n\r\n  return (\r\n    <div className={`relative p-4 rounded-xl ${isRadar ? 'bg-slate-900/60' : 'bg-stone-50'}`}>\r\n      {/* Header */}\r\n      <div className=\"flex items-center justify-between mb-4\">\r\n        <h4 className={`text-xs font-semibold uppercase tracking-wider ${styles.textMuted}`}>Timeline</h4>\r\n        <div className=\"flex gap-3 text-[10px]\">\r\n          {Object.entries(typeConfig).map(([type, config]) => (\r\n            <span key={type} className=\"flex items-center gap-1\" style={{ color: config.color }}>\r\n              {config.icon} {type}\r\n            </span>\r\n          ))}\r\n        </div>\r\n      </div>\r\n\r\n      {/* Timeline track */}\r\n      <div ref={containerRef} className=\"relative h-20\">\r\n        {/* Background track */}\r\n        <div className={`absolute top-1/2 left-0 right-0 h-0.5 -translate-y-1/2 ${isRadar ? 'bg-cyan-500/20' : 'bg-stone-300'}`}>\r\n          {/* Glow effect for radar */}\r\n          {isRadar && <div className=\"absolute inset-0 bg-cyan-400/30 blur-sm\" />}\r\n        </div>\r\n\r\n        {/* Date markers */}\r\n        <div className=\"absolute top-full left-0 right-0 flex justify-between pt-2 text-[10px]\" style={{ color: styles.textMuted }}>\r\n          <span>{sortedEvents[0].date.toLocaleDateString()}</span>\r\n          <span>{sortedEvents[sortedEvents.length - 1].date.toLocaleDateString()}</span>\r\n        </div>\r\n\r\n        {/* Events */}\r\n        {sortedEvents.map((event, i) => {\r\n          const pos = getPosition(event.date);\r\n          const config = typeConfig[event.type];\r\n          const isHovered = hoveredEvent === event.id;\r\n\r\n          return (\r\n            <motion.div\r\n              key={event.id}\r\n              initial={{ scale: 0, opacity: 0 }}\r\n              animate={{ scale: 1, opacity: 1 }}\r\n              transition={{ delay: i * 0.05, type: 'spring' }}\r\n              className=\"absolute top-1/2 -translate-y-1/2 cursor-pointer\"\r\n              style={{ left: `${pos}%` }}\r\n              onMouseEnter={() => setHoveredEvent(event.id)}\r\n              onMouseLeave={() => setHoveredEvent(null)}\r\n              onClick={() => onEventClick?.(event.id)}\r\n            >\r\n              {/* Event node */}\r\n              <motion.div\r\n                animate={{ scale: isHovered ? 1.5 : 1 }}\r\n                className=\"relative w-4 h-4 -ml-2 flex items-center justify-center text-xs\"\r\n                style={{\r\n                  color: config.color,\r\n                  filter: isHovered ? `drop-shadow(0 0 8px ${config.color})` : undefined,\r\n                }}\r\n              >\r\n                {config.icon}\r\n\r\n                {/* Confidence ring */}\r\n                {event.confidence !== undefined && (\r\n                  <svg className=\"absolute inset-0 w-full h-full -rotate-90\">\r\n                    <circle\r\n                      cx=\"8\" cy=\"8\" r=\"6\"\r\n                      fill=\"none\"\r\n                      stroke={config.color}\r\n                      strokeWidth=\"1\"\r\n                      strokeDasharray={`${event.confidence * 37.7} 37.7`}\r\n                      opacity={0.5}\r\n                    />\r\n                  </svg>\r\n                )}\r\n              </motion.div>\r\n\r\n              {/* Tooltip */}\r\n              {isHovered && (\r\n                <motion.div\r\n                  initial={{ opacity: 0, y: 5 }}\r\n                  animate={{ opacity: 1, y: 0 }}\r\n                  className={`absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 rounded text-[10px] whitespace-nowrap z-10 ${isRadar ? 'bg-slate-800 text-white' : 'bg-white text-stone-800 shadow-lg'}`}\r\n                >\r\n                  {event.label}\r\n                </motion.div>\r\n              )}\r\n            </motion.div>\r\n          );\r\n        })}\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n"}}
