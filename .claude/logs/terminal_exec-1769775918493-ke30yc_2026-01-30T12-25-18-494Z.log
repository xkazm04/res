te top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-center pointer-events-none ${isRadar ? 'text-cyan-400/40' : 'text-stone-400'}`}>\r","-        <div className=\"text-[10px] uppercase tracking-wider\">Trust Core</div>\r","-      </div>\r","-    </div>\r","-  );\r","-}\r","+'use client';","+","+import { useState, useEffect, useRef } from 'react';","+import { motion } from 'framer-motion';","+import { useVisualizationTheme } from './useVisualizationTheme';","+import type { ResearchSource } from '@/src/types/research';","+","+interface SourceNetworkProps {","+  sources: ResearchSource[];","+  onSourceSelect?: (id: string) => void;","+  selectedSource?: string;","+}","+","+interface SourceNode {","+  id: string;","+  x: number;","+  y: number;","+  radius: number;","+  credibility: number;","+  domain: string;","+  type: string;","+}","+","+export function SourceNetwork({ sources, onSourceSelect, selectedSource }: SourceNetworkProps) {","+  const { colors, isRadar, surfaceClasses, getCredibilityColor } = useVisualizationTheme();","+  const containerRef = useRef<HTMLDivElement>(null);","+  const [nodes, setNodes] = useState<SourceNode[]>([]);","+  const [hoveredNode, setHoveredNode] = useState<string | null>(null);","+  const [dimensions, setDimensions] = useState({ width: 400, height: 300 });","+","+  // Group sources by domain and calculate positions","+  useEffect(() => {","+    if (!containerRef.current) return;","+    const rect = containerRef.current.getBoundingClientRect();","+    setDimensions({ width: rect.width, height: 300 });","+  }, []);","+","+  useEffect(() => {","+    const { width, height } = dimensions;","+    const centerX = width / 2;","+    const centerY = height / 2;","+    const maxRadius = Math.min(width, height) * 0.4;","+","+    // Position nodes in concentric circles by credibility","+    const positioned: SourceNode[] = sources.map((s, i) => {","+      const cred = s.credibility_score || 0.5;","+      const radius = maxRadius * (1 - cred * 0.8); // Higher cred = closer to center","+      const angle = (i / sources.length) * Math.PI * 2 + Math.random() * 0.3;","+","+      return {","+        id: s.id,","+        x: centerX + Math.cos(angle) * radius,","+        y: centerY + Math.sin(angle) * radius,","+        radius: 6 + cred * 14,","+        credibility: cred,","+        domain: s.domain || 'unknown',","+        type: s.source_type || 'web',","+      };","+    });","+","+    setNodes(positioned);","+  }, [sources, dimensions]);","+","+  return (","+    <div ref={containerRef} className={`relative rounded-xl overflow-hidden ${surfaceClasses}`} style={{ height: 300 }}>","+      {/* Trust rings */}","+      <svg className=\"absolute inset-0\" width={dimensions.width} height={dimensions.height}>","+        {[0.8, 0.5, 0.2].map((level) => (","+          <circle","+            key={level}","+            cx={dimensions.width / 2}","+            cy={dimensions.height / 2}","+            r={Math.min(dimensions.width, dimensions.height) * 0.4 * (1 - level * 0.8)}","+            fill=\"none\"","+            stroke={colors.gridLine}","+            strokeDasharray=\"4 4\"","+          />","+        ))}","+","+        {/* Nodes */}","+        {nodes.map((node) => (","+          <g key={node.id}>","+            <motion.circle","+              initial={{ scale: 0 }}","+              animate={{","+                scale: hoveredNode === node.id || selectedSource === node.id ? 1.5 : 1,","+                opacity: hoveredNode && hoveredNode !== node.id ? 0.4 : 1","+              }}","+              cx={node.x}","+              cy={node.y}","+              r={node.radius}","+              fill={getCredibilityColor(node.credibility)}","+              stroke={selectedSource === node.id ? (isRadar ? '#fff' : '#000') : 'transparent'}","+              strokeWidth={2}","+              className=\"cursor-pointer\"","+              onMouseEnter={() => setHoveredNode(node.id)}","+              onMouseLeave={() => setHoveredNode(null)}","+              onClick={() => onSourceSelect?.(node.id)}","+            />","+          </g>","+        ))}","+      </svg>","+","+      {/* Labels */}","+      <div className=\"absolute bottom-3 left-3 flex items-center gap-4 text-[10px]\" style={{ color: colors.textSecondary }}>","+        <span className=\"flex items-center gap-1\">","+          <span className=\"w-2 h-2 rounded-full\" style={{ backgroundColor: colors.success }} /> High","+        </span>","+        <span className=\"flex items-center gap-1\">","+          <span className=\"w-2 h-2 rounded-full\" style={{ backgroundColor: colors.warning }} /> Medium","+        </span>","+        <span className=\"flex items-center gap-1\">","+          <span className=\"w-2 h-2 rounded-full\" style={{ backgroundColor: colors.danger }} /> Low","+        </span>","+      </div>","+","+      {/* Center label */}","+      <div","+        className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-center pointer-events-none\"","+        style={{ color: isRadar ? colors.primaryMuted : colors.textMuted }}","+      >","+        <div className=\"text-[10px] uppercase tracking-wider\">Trust Core</div>","+      </div>","+    </div>","+  );","+}"]}],"originalFile":"'use client';\r\n\r\nimport { useState, useEffect, useRef } from 'react';\r\nimport { motion } from 'framer-motion';\r\nimport { useReportTheme } from '../core/ThemeContext';\r\nimport type { ResearchSource } from '@/src/types/research';\r\n\r\ninterface SourceNetworkProps {\r\n  sources: ResearchSource[];\r\n  onSourceSelect?: (id: string) => void;\r\n  selectedSource?: string;\r\n}\r\n\r\ninterface SourceNode {\r\n  id: string;\r\n  x: number;\r\n  y: number;\r\n  radius: number;\r\n  credibility: number;\r\n  domain: string;\r\n  type: string;\r\n}\r\n\r\nexport function SourceNetwork({ sources, onSourceSelect, selectedSource }: SourceNetworkProps) {\r\n  const { theme } = useReportTheme();\r\n  const isRadar = theme === 'radar';\r\n  const containerRef = useRef<HTMLDivElement>(null);\r\n  const [nodes, setNodes] = useState<SourceNode[]>([]);\r\n  const [hoveredNode, setHoveredNode] = useState<string | null>(null);\r\n  const [dimensions, setDimensions] = useState({ width: 400, height: 300 });\r\n\r\n  // Group sources by domain and calculate positions\r\n  useEffect(() => {\r\n    if (!containerRef.current) return;\r\n    const rect = containerRef.current.getBoundingClientRect();\r\n    setDimensions({ width: rect.width, height: 300 });\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    const { width, height } = dimensions;\r\n    const centerX = width / 2;\r\n    const centerY = height / 2;\r\n    const maxRadius = Math.min(width, height) * 0.4;\r\n\r\n    // Position nodes in concentric circles by credibility\r\n    const positioned: SourceNode[] = sources.map((s, i) => {\r\n      const cred = s.credibility_score || 0.5;\r\n      const radius = maxRadius * (1 - cred * 0.8); // Higher cred = closer to center\r\n      const angle = (i / sources.length) * Math.PI * 2 + Math.random() * 0.3;\r\n\r\n      return {\r\n        id: s.id,\r\n        x: centerX + Math.cos(angle) * radius,\r\n        y: centerY + Math.sin(angle) * radius,\r\n        radius: 6 + cred * 14,\r\n        credibility: cred,\r\n        domain: s.domain || 'unknown',\r\n        type: s.source_type || 'web',\r\n      };\r\n    });\r\n\r\n    setNodes(positioned);\r\n  }, [sources, dimensions]);\r\n\r\n  const credColor = (cred: number) => {\r\n    if (cred >= 0.8) return isRadar ? '#34d399' : '#059669';\r\n    if (cred >= 0.5) return isRadar ? '#fbbf24' : '#d97706';\r\n    return isRadar ? '#f87171' : '#dc2626';\r\n  };\r\n\r\n  return (\r\n    <div ref={containerRef} className={`relative rounded-xl overflow-hidden ${isRadar ? 'bg-slate-950/50' : 'bg-stone-50'}`} style={{ height: 300 }}>\r\n      {/* Trust rings */}\r\n      <svg className=\"absolute inset-0\" width={dimensions.width} height={dimensions.height}>\r\n        {[0.8, 0.5, 0.2].map((level, i) => (\r\n          <circle\r\n            key={level}\r\n            cx={dimensions.width / 2}\r\n            cy={dimensions.height / 2}\r\n            r={Math.min(dimensions.width, dimensions.height) * 0.4 * (1 - level * 0.8)}\r\n            fill=\"none\"\r\n            stroke={isRadar ? 'rgba(34,211,238,0.1)' : 'rgba(0,0,0,0.05)'}\r\n            strokeDasharray=\"4 4\"\r\n          />\r\n        ))}\r\n\r\n        {/* Nodes */}\r\n        {nodes.map((node) => (\r\n          <g key={node.id}>\r\n            <motion.circle\r\n              initial={{ scale: 0 }}\r\n              animate={{\r\n                scale: hoveredNode === node.id || selectedSource === node.id ? 1.5 : 1,\r\n                opacity: hoveredNode && hoveredNode !== node.id ? 0.4 : 1\r\n              }}\r\n              cx={node.x}\r\n              cy={node.y}\r\n              r={node.radius}\r\n              fill={credColor(node.credibility)}\r\n              stroke={selectedSource === node.id ? (isRadar ? '#fff' : '#000') : 'transparent'}\r\n              strokeWidth={2}\r\n              className=\"cursor-pointer\"\r\n              onMouseEnter={() => setHoveredNode(node.id)}\r\n              onMouseLeave={() => setHoveredNode(null)}\r\n              onClick={() => onSourceSelect?.(node.id)}\r\n            />\r\n          </g>\r\n        ))}\r\n      </svg>\r\n\r\n      {/* Labels */}\r\n      <div className={`absolute bottom-3 left-3 flex items-center gap-4 text-[10px] ${isRadar ? 'text-slate-400' : 'text-stone-500'}`}>\r\n        <span className=\"flex items-center gap-1\"><span className=\"w-2 h-2 rounded-full bg-emerald-500\" /> High</span>\r\n        <span className=\"flex items-center gap-1\"><span className=\"w-2 h-2 rounded-full bg-amber-500\" /> Medium</span>\r\n        <span className=\"flex items-center gap-1\"><span className=\"w-2 h-2 rounded-full bg-rose-500\" /> Low</span>\r\n      </div>\r\n\r\n      {/* Center label */}\r\n      <div className={`absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-center pointer-events-none ${isRadar ? 'text-cyan-400/40' : 'text-stone-400'}`}>\r\n        <div className=\"text-[10px] uppercase tracking-wider\">Trust Core</div>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n"}}
