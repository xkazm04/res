idth / 2;\n    50→    const centerY = height / 2;\n    51→\n    52→    // Initialize positions in a circle\n    53→    const newPositions = new Map<string, { x: number; y: number }>();\n    54→    nodes.forEach((node, i) => {\n    55→      const angle = (i / nodes.length) * Math.PI * 2;\n    56→      const radius = Math.min(width, height) * 0.35;\n    57→      newPositions.set(node.id, {\n    58→        x: centerX + Math.cos(angle) * radius,\n    59→        y: centerY + Math.sin(angle) * radius,\n    60→      });\n    61→    });\n    62→\n    63→    // Simple force simulation\n    64→    const iterations = 50;\n    65→    for (let iter = 0; iter < iterations; iter++) {\n    66→      // Repulsion between all nodes\n    67→      nodes.forEach((nodeA) => {\n    68→        nodes.forEach((nodeB) => {\n    69→          if (nodeA.id === nodeB.id) return;\n    70→          const posA = newPositions.get(nodeA.id)!;\n    71→          const posB = newPositions.get(nodeB.id)!;\n    72→          const dx = posA.x - posB.x;\n    73→          const dy = posA.y - posB.y;\n    74→          const dist = Math.sqrt(dx * dx + dy * dy) || 1;\n    75→          const force = 1000 / (dist * dist);\n    76→          posA.x += (dx / dist) * force * 0.1;\n    77→          posA.y += (dy / dist) * force * 0.1;\n    78→        });\n    79→      });\n    80→\n    81→      // Attraction along edges\n    82→      edges.forEach((edge) => {\n    83→        const posA = newPositions.get(edge.source);\n    84→        const posB = newPositions.get(edge.target);\n    85→        if (!posA || !posB) return;\n    86→        const dx = posB.x - posA.x;\n    87→        const dy = posB.y - posA.y;\n    88→        const dist = Math.sqrt(dx * dx + dy * dy) || 1;\n    89→        const force = dist * 0.01 * edge.strength;\n    90→        posA.x += (dx / dist) * force;\n    91→        posA.y += (dy / dist) * force;\n    92→        posB.x -= (dx / dist) * force;\n    93→        posB.y -= (dy / dist) * force;\n    94→