v key={v} className=\"flex-1\" style={{ backgroundColor: getConfidenceColor(v) }} />","+          ))}","+        </div>","+        <span className=\"text-[10px]\" style={{ color: colors.textMuted }}>High</span>","+      </div>","+","+      {/* Grid */}","+      <div className=\"grid grid-cols-5 gap-1\">","+        {sorted.map((cell, i) => {","+          const cellColor = getConfidenceColor(cell.value);","+          return (","+            <motion.button","+              key={cell.id}","+              initial={{ opacity: 0, scale: 0.8 }}","+              animate={{ opacity: 1, scale: 1 }}","+              transition={{ delay: i * 0.02 }}","+              whileHover={{ scale: 1.1, zIndex: 10 }}","+              onClick={() => onCellClick?.(cell.id)}","+              className=\"relative aspect-square rounded-md flex items-center justify-center cursor-pointer group\"","+              style={{","+                backgroundColor: cellColor,","+                boxShadow: isRadar && cell.value >= 0.8 ? `0 0 15px ${cellColor}` : undefined,","+              }}","+            >","+              <span","+                className=\"text-[10px] font-bold\"","+                style={{ color: cell.value >= 0.5 || isRadar ? colors.textOnDark : colors.textOnLight }}","+              >","+                {Math.round(cell.value * 100)}","+              </span>","+","+              {/* Hover tooltip */}","+              <div className={`absolute -top-8 left-1/2 -translate-x-1/2 px-2 py-1 rounded text-[10px] whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity z-20 ${tooltipClasses}`}>","+                {cell.label}","+              </div>","+            </motion.button>","+          );","+        })}","+      </div>","+    </div>","+  );","+}"]}],"originalFile":"'use client';\r\n\r\nimport { motion } from 'framer-motion';\r\nimport { useReportTheme, useThemeStyles } from '../core/ThemeContext';\r\n\r\ninterface HeatmapCell {\r\n  id: string;\r\n  label: string;\r\n  value: number; // 0-1\r\n  category?: string;\r\n}\r\n\r\ninterface ConfidenceHeatmapProps {\r\n  data: HeatmapCell[];\r\n  title?: string;\r\n  onCellClick?: (id: string) => void;\r\n}\r\n\r\nexport function ConfidenceHeatmap({ data, title, onCellClick }: ConfidenceHeatmapProps) {\r\n  const { theme } = useReportTheme();\r\n  const styles = useThemeStyles();\r\n  const isRadar = theme === 'radar';\r\n\r\n  const getColor = (value: number) => {\r\n    if (isRadar) {\r\n      if (value >= 0.8) return 'rgba(34, 211, 238, 0.8)';  // cyan\r\n      if (value >= 0.6) return 'rgba(52, 211, 153, 0.7)';  // emerald\r\n      if (value >= 0.4) return 'rgba(251, 191, 36, 0.6)';  // amber\r\n      if (value >= 0.2) return 'rgba(251, 146, 60, 0.5)';  // orange\r\n      return 'rgba(248, 113, 113, 0.4)';                    // rose\r\n    }\r\n    if (value >= 0.8) return 'rgb(16, 185, 129)';\r\n    if (value >= 0.6) return 'rgb(34, 197, 94)';\r\n    if (value >= 0.4) return 'rgb(234, 179, 8)';\r\n    if (value >= 0.2) return 'rgb(249, 115, 22)';\r\n    return 'rgb(239, 68, 68)';\r\n  };\r\n\r\n  const sorted = [...data].sort((a, b) => b.value - a.value);\r\n\r\n  return (\r\n    <div className={`rounded-xl p-4 ${isRadar ? 'bg-slate-900/60' : 'bg-stone-50'}`}>\r\n      {title && (\r\n        <h4 className={`text-xs font-semibold uppercase tracking-wider mb-3 ${styles.textMuted}`}>{title}</h4>\r\n      )}\r\n\r\n      {/* Legend */}\r\n      <div className=\"flex items-center gap-1 mb-3\">\r\n        <span className={`text-[10px] ${styles.textMuted}`}>Low</span>\r\n        <div className=\"flex-1 h-2 rounded-full overflow-hidden flex\">\r\n          {[0.1, 0.3, 0.5, 0.7, 0.9].map((v) => (\r\n            <div key={v} className=\"flex-1\" style={{ backgroundColor: getColor(v) }} />\r\n          ))}\r\n        </div>\r\n        <span className={`text-[10px] ${styles.textMuted}`}>High</span>\r\n      </div>\r\n\r\n      {/* Grid */}\r\n      <div className=\"grid grid-cols-5 gap-1\">\r\n        {sorted.map((cell, i) => (\r\n          <motion.button\r\n            key={cell.id}\r\n            initial={{ opacity: 0, scale: 0.8 }}\r\n            animate={{ opacity: 1, scale: 1 }}\r\n            transition={{ delay: i * 0.02 }}\r\n            whileHover={{ scale: 1.1, zIndex: 10 }}\r\n            onClick={() => onCellClick?.(cell.id)}\r\n            className=\"relative aspect-square rounded-md flex items-center justify-center cursor-pointer group\"\r\n            style={{\r\n              backgroundColor: getColor(cell.value),\r\n              boxShadow: isRadar && cell.value >= 0.8 ? `0 0 15px ${getColor(cell.value)}` : undefined,\r\n            }}\r\n          >\r\n            <span className={`text-[10px] font-bold ${cell.value >= 0.5 ? 'text-white' : isRadar ? 'text-white' : 'text-stone-800'}`}>\r\n              {Math.round(cell.value * 100)}\r\n            </span>\r\n\r\n            {/* Hover tooltip */}\r\n            <div className={`absolute -top-8 left-1/2 -translate-x-1/2 px-2 py-1 rounded text-[10px] whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity z-20 ${isRadar ? 'bg-slate-800 text-white' : 'bg-white text-stone-800 shadow-lg'}`}>\r\n              {cell.label}\r\n            </div>\r\n          </motion.button>\r\n        ))}\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n"}}
