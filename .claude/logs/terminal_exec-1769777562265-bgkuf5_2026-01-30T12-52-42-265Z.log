bar' : 'Collapse sidebar'}\n    46→    >\n    47→      <motion.svg\n    48→        animate={{ rotate: collapsed ? 180 : 0 }}\n    49→        transition={{ type: 'spring', stiffness: 300, damping: 25 }}\n    50→        className=\"w-5 h-5\"\n    51→        viewBox=\"0 0 24 24\"\n    52→        fill=\"none\"\n    53→        stroke=\"currentColor\"\n    54→        strokeWidth=\"2\"\n    55→      >\n    56→        <path d=\"M11 19l-7-7 7-7M18 19l-7-7 7-7\" />\n    57→      </motion.svg>\n    58→    </button>\n    59→  );\n    60→}\n    61→\n    62→// Unified tab indicator with smooth sliding animation via layoutId\n    63→function TabIndicator({ theme }: { theme: 'radar' | 'swiss' }) {\n    64→  const isRadar = theme === 'radar';\n    65→  return (\n    66→    <motion.div\n    67→      layoutId=\"tab-indicator\"\n    68→      className={`absolute left-0 top-1 bottom-1 w-[3px] rounded-full ${\n    69→        isRadar ? 'bg-cyan-400' : 'bg-stone-900'\n    70→      }`}\n    71→      transition={{\n    72→        type: 'spring',\n    73→        stiffness: 500,\n    74→        damping: 35,\n    75→      }}\n    76→    />\n    77→  );\n    78→}\n    79→\n    80→interface ThemedSidebarProps {\n    81→  activeTab: TabId;\n    82→  onTabChange: (tab: TabId) => void;\n    83→  stats: {\n    84→    findings: number;\n    85→    sources: number;\n    86→    perspectives: number;\n    87→    contradictions: number;\n    88→    gaps: number;\n    89→    avgConfidence: number;\n    90→    redFlags: number;\n    91→    entities: number;\n    92→  };\n    93→  onClose: () => void;\n    94→}\n    95→\n    96→const tabs: { id: TabId; label: string; key: keyof ThemedSidebarProps['stats'] | null }[] = [\n    97→  { id: 'overview', label: 'Overview', key: null },\n    98→  { id: 'findings', label: 'Findings', key: 'findings' },\n    99→  { id: 'sources', label: 'Sources', key: 'sources' },\n   100→  { id: 'perspectives', label: 'Perspectives', key: 'perspectives' },\n   101→  { id: 'analysis', label: 'Analysis', key: null },\n   102→  { id: 'entities', label: 'Entities', key: 'entities' },\n   103→];\n   104→\n   105→export function ThemedSidebar({ activeTab, onTabChange, stats, onClose }: ThemedSidebarProps) {\n   106→  const { theme } = useReportTheme();\n   107→  const { collapsed, toggle } = useSidebarCollapsed();\n   108→\n   109→  return theme === 'radar' ? (\n   110→    <RadarSidebar activeTab={activeTab} onTabChange={onTabChange} stats={stats} onClose={onClose} collapsed={collapsed} onToggleCollapse={toggle} />\n   111→  ) : (\n   112→    <SwissSidebar activeTab={activeTab} onTabChange={onTabChange} stats={stats} onClose={onClose} collapsed={collapsed} onToggleCollapse={toggle} />\n   113→  );\n   114→}\n   115→\n   116→function RadarSidebar({ activeTab, onTabChange, stats, onClose, collapsed, onToggleCollapse }: ThemedSidebarProps & { collapsed: boolean; onToggleCollapse: () => void }) {\n   117→  return (\n   118→    <motion.aside\n   119→      initial={false}\n   120→      animate={{ width: collapsed ? 56 : 224 }}\n   121→      transition={{ type: 'spring', stiffness: 300, damping: 30 }}\n   122→      className=\"flex flex-col border-r border-cyan-500/20 bg-slate-950/50 overflow-hidden\"\n   123→    >\n   124→      {/* Header */}\n   125→      <div className=\"p-4 border-b border-cyan-500/20\">\n   126→        <div className=\"flex items-center gap-2\">\n   127→          <div className=\"w-8 h-8 rounded-lg bg-gradient-to-br from-cyan-400 to-blue-500 flex items-center justify-center flex-shrink-0\">\n   128→            <span className=\"text-white text-xs font-bold\">DR</span>\n   129→          </div>\n   130→          {!collapsed && (\n   131→            <motion.div\n   132→              initial={{ opacity: 0 }}\n   133→              animate={{ opacity: 1 }}\n   134→              exit={{ opacity: 0 }}\n   135→            >\n   136→              <div className=\"text-sm font-semibold text-white whitespace-nowrap\">Deep Research</div>\n   137→ 