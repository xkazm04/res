tic colors for a KeyPoint type from the theme\n    47→  const getSemanticColors = (type: KeyPoint['type']) => styles.semantic[type];\n    48→\n    49→  return (\n    50→    <div className={`rounded-2xl overflow-hidden ${isRadar ? 'bg-slate-900/60 border border-cyan-500/10' : 'bg-white border border-stone-200'}`}>\n    51→      {/* Header */}\n    52→      <div className={`p-4 border-b ${isRadar ? 'border-cyan-500/10' : 'border-stone-200'}`}>\n    53→        <div className=\"flex items-center justify-between mb-3\">\n    54→          <h3 className={`font-semibold ${styles.text}`}>Key Points</h3>\n    55→          <span className={`text-xs ${styles.textMuted}`}>\n    56→            <AnimatedNumber value={filteredPoints.length} /> points\n    57→          </span>\n    58→        </div>\n    59→\n    60→        {/* Filters */}\n    61→        <div className=\"flex flex-wrap gap-2\">\n    62→          <FilterButton\n    63→            label=\"All\"\n    64→            count={points.length}\n    65→            active={filter === 'all'}\n    66→            onClick={() => setFilter('all')}\n    67→          />\n    68→          {(Object.keys(typeConfig) as KeyPoint['type'][]).map(type => (\n    69→            <FilterButton\n    70→              key={type}\n    71→              label={typeConfig[type].icon}\n    72→              count={typeCounts[type]}\n    73→              active={filter === type}\n    74→              onClick={() => setFilter(type)}\n    75→            />\n    76→          ))}\n    77→        </div>\n    78→      </div>\n    79→\n    80→      {/* Points list */}\n    81→      <div className=\"p-3 space-y-2 max-h-96 overflow-y-auto\">\n    82→        <AnimatePresence mode=\"popLayout\">\n    83→          {filteredPoints.map((point, i) => {\n    84→            const config = typeConfig[point.type];\n    85→            const isExpanded = expanded === point.id;\n    86→            const isHighlighted = highlightedPoint === point.id;\n    87→\n    88→            return (\n    89→              <motion.div\n    90→                key={point.id}\n    91→                layout\n    92→                initial={{ opacity: 0, x: -20 }}\n    93→                animate={{ opacity: 1, x: 0 }}\n    94→                exit={{ opacity: 0, x: 20 }}\n    95→                transition={{ delay: i * 0.03 }}\n    96→                className={`rounded-xl border cursor-pointer overflow-hidden transition-all ${\n    97→                  isRadar ? config.radarBg : config.swissBg\n    98→                } ${isHighlighted ? (isRadar ? 'ring-2 ring-cyan-400' : 'ring-2 ring-stone-800') : ''}`}\n    99→                onClick={() => {\n   100→                  setExpanded(isExpanded ? null : point.id);\n   101→                  onPointClick?.(point.id);\n   102→                }}\n   103→              >\n   104→                {/* Main content */}\n   105→                <div className=\"p-3\">\n   106→                  <div className=\"flex items-start gap-2\">\n   107→                    <span className=\"text-lg flex-shrink-0\">{config.icon}</span>\n   108→                    <div className=\"flex-1 min-w-0\">\n   109→                      <p className={`text-sm ${isRadar ? config.radarText : config.swissText}`}>\n   110→                        {point.text}\n   111→                      </p>\n   112→                      <div className=\"flex items-center gap-3 mt-2\">\n   113→                        <span className={`text-[10px] ${styles.textMuted}`}>\n   114→                          {Math.round(point.confidence * 100)}% confidence\n   115→                        </span>\n   116→                        <span className={`text-[10px] ${styles.textMuted}`}>\n   117→                          {point.sourceCount} sources\n   118→                        </span>\n   119→                      </div>\n   120→                    </div>\n   121→                  </div>\n   122→                </div>\n   123→\n   124→                {/* Expanded details 