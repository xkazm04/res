[2026-01-30T13:00:52.798Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01J7pQEGADxswPLhLQ86voaR","type":"tool_result","content":"     1→'use client';\n     2→\n     3→import { useMemo, useState } from 'react';\n     4→import { motion, AnimatePresence } from 'framer-motion';\n     5→import type { KnowledgeEntity } from '@/src/types/research';\n     6→import { useReportTheme, useThemeStyles } from '../core/ThemeContext';\n     7→import { AnimatedNumber } from '../core/AnimatedNumber';\n     8→import { EntityConstellation } from '../visualizations/EntityConstellation';\n     9→import { ViewHeader } from '../shared/ViewHeader';\n    10→import { EmptyState } from '../shared/EmptyState';\n    11→\n    12→interface EntitiesViewProps {\n    13→  entities: KnowledgeEntity[];\n    14→}\n    15→\n    16→type EntityType = 'person' | 'organization' | 'location' | 'event' | 'other';\n    17→type ViewMode = 'constellation' | 'cards';\n    18→\n    19→const entityConfig: Record<EntityType, { icon: string; gradient: string }> = {\n    20→  person: { icon: '👤', gradient: 'from-rose-500 to-pink-600' },\n    21→  organization: { icon: '🏢', gradient: 'from-blue-500 to-indigo-600' },\n    22→  location: { icon: '📍', gradient: 'from-emerald-500 to-teal-600' },\n    23→  event: { icon: '📅', gradient: 'from-amber-500 to-orange-600' },\n    24→  other: { icon: '🔹', gradient: 'from-slate-500 to-gray-600' },\n    25→};\n    26→\n    27→// Stagger animation variants - calculated once at parent level\n    28→const listContainerVariants = {\n    29→  hidden: { opacity: 1 },\n    30→  visible: {\n    31→    opacity: 1,\n    32→    transition: {\n    33→      staggerChildren: 0.03,\n    34→    },\n    35→  },\n    36→};\n    37→\n    38→const listItemVariants = {\n    39→  hidden: { opacity: 0 },\n    40→  visible: { opacity: 1 },\n    41→};\n    42→\n    43→export function EntitiesView({ entities }: EntitiesViewProps) {\n    44→  const { theme } = useReportTheme();\n    45→  const styles = useThemeStyles();\n    46→  const isRadar = theme === 'radar';\n    47→  const [viewMode, setViewMode] = useState<ViewMode>('constellation');\n    48→  const [selectedEntity, setSelectedEntity] = useState<string | null>(null);\n    49→  const [filterType, setFilterType] = useState<EntityType | 'all'>('all');\n    50→\n    51→  const grouped = useMemo(() => {\n    52→    const groups: Record<EntityType, KnowledgeEntity[]> = {\n    53→      person: [], organization: [], location: [], event: [], other: [],\n    54→    };\n    55→    entities.forEach(e => {\n    56→      const type = (e.entity_type?.toLowerCase() || 'other') as EntityType;\n    57→      (groups[type] || groups.other).push(e);\n    58→    });\n    59→    return groups;\n    60→  }, [entities]);\n    61→\n    62→  const filtered = useMemo(() => {\n    63→    if (filterType === 'all') return entities;\n    64→    return grouped[filterType];\n    65→  }, [entities, grouped, filterType]);\n    66→\n    67→  const selectedData = selectedEntity ? entities.find(e => e.id === selectedEntity) : null;\n    68→\n    69→  if (entities.length === 0) {\n    70→    return (\n    71→      <EmptyState\n    72→        type=\"users\"\n    73→        title=\"No entities extracted\"\n    74→        description=\"The research hasn't identified any people, organizations, or locations yet.\"\n    75→      />\n    76→    );\n    77→  }\n    78→\n    79→  const viewToggle = (\n    80→    <div className={`flex rounded-lg overflow-hidden ${isRadar ? 'bg-slate-800' : 'bg-stone-200'}`}>\n    81→      {(['constellation', 'cards'] as ViewMode[]).map(mode => (\n    82→        <button\n    83→          key={mode}\n    84→          onClick={() => setViewMode(mode)}\n    85→          className={`px-3 py-1.5 text-xs font-medium capitalize transition-colors ${\n    86→            viewMode === mode\n    87→              ? isRadar ? 'bg-cyan-500/20 text-cyan-300' : 'bg-white text-stone-900'\n    88→              : isRadar ? 'text-slate-400 hover:text-white' : 'text-stone-600 hover:text-stone-900'\n    89→          }`}\n    90→        >\n    91→          {mode}\n    92→        </button>\n    93→      ))}\n    94→    </div>\n    95→  );\n    96→\n    97→  return (\n    98→    <div className=\"space-y-4\">\n    99→      <ViewHeader title=\"Entities\" count={entities.length} actions={viewToggle} />\n   100→\n   101→      {/* Type filters */}\n   102→      <div className=\"flex gap-2\">\n   103→        <FilterChip label=\"All\" count={entities.length} active={filterType === 'all'} onClick={() => setFilterType('all')} />\n   104→        {(['person', 'organization', 'location', 'event'] as EntityType[]).map(type => (\n   105→          <FilterChip\n   106→            key={type}\n   107→            label={entityConfig[type].icon}\n   108→            count={grouped[type].length}\n   109→            active={filterType === type}\n   110→            onClick={() => setFilterType(type)}\n   111→          />\n   112→        ))}\n   113→      </div>\n   114→\n   115→      {/* Constellation view */}\n   116→      {viewMode === 'constellation' && (\n   117→        <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }}>\n   118→          <EntityConstellation\n   119→            entities={filtered}\n   120→            selectedEntity={selectedEntity || undefined}\n   121→            onEntitySelect={setSelectedEntity}\n   122→          />\n   123→        </motion.div>\n   124→      )}\n   125→\n   126→      {/* Cards view */}\n   127→      {viewMode === 'cards' && (\n   128→        <div className=\"grid grid-cols-2 md:grid-cols-4 gap-3\">\n   129→          {(['person', 'organization', 'location', 'event'] as EntityType[]).map(type => {\n   130→            const list = filterType === 'all' ? grouped[type] : (filterType === type ? grouped[type] : []);\n   131→            if (list.length === 0) return null;\n   132→\n   133→            return (\n   134→              <EntityTypeColumn\n   135→                key={type}\n   136→                type={type}\n   137→                entities={list}\n   138→                selectedEntity={selectedEntity}\n   139→                onSelect={setSelectedEntity}\n   140→              />\n   141→            );\n   142→          })}\n   143→        </div>\n   144→      )}\n   145→\n   146→      {/* Selected entity detail */}\n   147→      <AnimatePresence>\n   148→        {selectedData && (\n   149→          <EntityDetail entity={selectedData} onClose={() => setSelectedEntity(null)} />\n   150→        )}\n   151→      </AnimatePresence>\n   152→    </div>\n   153→  );\n   154→}\n   155→\n   156→function FilterChip({ label, count, active, onClick }: { label: string; count: number; active: boolean; onClick: () => void }) {\n   157→  const { theme } = useReportTheme();\n   158→  const isRadar = theme === 'radar';\n   159→\n   160→  return (\n   161→    <button\n   162→      onClick={onClick}\n   163→      className={`px-2 py-1 rounded-lg text-xs flex items-center gap-1 transition-all ${\n   164→        active\n   165→          ? isRadar ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/30' : 'bg-stone-800 text-white'\n   166→          : isRadar ? 'bg-slate-800/50 text-slate-400 hover:text-white' : 'bg-stone-100 text-stone-600 hover:bg-stone-200'\n   167→      }`}\n   168→    >\n   169→      {label}\n   170→      <span className={`px-1 py-0.5 rounded text-[9px] ${active ? (isRadar ? 'bg-cyan-500/30' : 'bg-white/20') : 'bg-black/10'}`}>\n   171→        {count}\n   172→      </span>\n   173→    </button>\n   174→  );\n   175→}\n   176→\n   177→function EntityTypeColumn({ type, entities, selectedEntity, onSelect }: {\n   178→  type: EntityType;\n   179→  entities: KnowledgeEntity[];\n   180→  selectedEntity: string | null;\n   181→  onSelect: (id: string | null) => void;\n   182→}) {\n   183→  const { theme } = useReportTheme();\n   184→  const isRadar = theme === 'radar';\n   185→  const config = entityConfig[type];\n   186→\n   187→  return (\n   188→    <motion.div\n   189→      initial={{ opacity: 0, y: 20 }}\n   190→      animate={{ opacity: 1, y: 0 }}\n   191→      className={`rounded-xl overflow-hidden ${isRadar ? 'bg-slate-900/60 border border-cyan-500/10' : 'bg-white border border-stone-200'}`}\n   192→    >\n   193→      <div className={`sticky top-0 z-10 p-3 backdrop-blur-sm ${isRadar ? `bg-gradient-to-r ${config.gradient}/95` : 'bg-stone-50/95 border-b border-stone-200'}`}>\n   194→        <h4 className={`text-xs font-semibold capitalize flex items-center gap-2 ${isRadar ? 'text-white' : 'text-stone-900'}`}>\n   195→          {config.icon} {type}s (<AnimatedNumber value={entities.length} />)\n   196→        </h4>\n   197→      </div>\n   198→      <motion.div\n   199→        className=\"p-2 max-h-64 overflow-y-auto space-y-1 scroll-smooth\"\n   200→        variants={listContainerVariants}\n   201→        initial=\"hidden\"\n   202→        animate=\"visible\"\n   203→      >\n   204→        {entities.slice(0, 10).map((e) => (\n   205→          <motion.button\n   206→            key={e.id}\n   207→            variants={listItemVariants}\n   208→            onClick={() => onSelect(selectedEntity === e.id ? null : e.id)}\n   209→            className={`w-full text-left p-2 rounded-lg text-xs transition-all ${\n   210→              selectedEntity === e.id\n   211→                ? isRadar ? 'bg-cyan-500/20 text-cyan-300' : 'bg-stone-800 text-white'\n   212→                : isRadar ? 'text-slate-300 hover:bg-slate-800/50' : 'text-stone-700 hover:bg-stone-50'\n   213→            }`}\n   214→          >\n   215→            {e.canonical_name}\n   216→          </motion.button>\n   217→        ))}\n   218→      </motion.div>\n   219→    </motion.div>\n   220→  );\n   221→}\n   222→\n   223→function EntityDetail({ entity, onClose }: { entity: KnowledgeEntity; onClose: () => void }) {\n   224→  const { theme } = useReportTheme();\n   225→  const styles = useThemeStyles();\n   226→  const isRadar = theme === 'radar';\n   227→  const type = (entity.entity_type?.toLowerCase() || 'other') as EntityType;\n   228→  const config = entityConfig[type];\n   229→\n   230→  return (\n   231→    <motion.div\n   232→      initial={{ opacity: 0, y: 20 }}\n   233→      animate={{ opacity: 1, y: 0 }}\n   234→      exit={{ opacity: 0, y: 20 }}\n   235→      className={`p-4 rounded-xl ${isRadar ? 'bg-slate-900/80 border border-cyan-500/20' : 'bg-white border border-stone-200 shadow-lg'}`}\n   236→    >\n   237→      <div className=\"flex items-start justify-between mb-3\">\n   238→        <div className=\"flex items-center gap-3\">\n   239→          <span className=\"text-2xl\">{config.icon}</span>\n   240→          <div>\n   241→            <h3 className={`font-semibold ${styles.text}`}>{entity.canonical_name}</h3>\n   242→            <p className={`text-xs ${styles.textMuted}`}>{entity.mention_count || 0} mentions</p>\n   243→          </div>\n   244→        </div>\n   245→        <button onClick={onClose} className={`p-1 rounded ${isRadar ? 'hover:bg-slate-800' : 'hover:bg-stone-100'}`}>\n   246→          <svg className={`w-5 h-5 ${styles.textMuted}`} fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n   247→            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M6 18L18 6M6 6l12 12\" />\n   248→          </svg>\n   249→        </button>\n   250→      </div>\n   251→\n   252→      {entity.description && <p className={`text-sm mb-3 ${styles.text}`}>{entity.description}</p>}\n   253→\n   254→      {entity.aliases && entity.aliases.length > 0 && (\n   255→        <div className={`p-3 rounded-lg ${isRadar ? 'bg-slate-800/50' : 'bg-stone-50'}`}>\n   256→          <div className={`text-[10px] uppercase tracking-wider mb-2 ${styles.textMuted}`}>Also known as</div>\n   257→          <div className=\"flex flex-wrap gap-1\">\n   258→            {entity.aliases.map((alias, i) => (\n   259→              <span key={i} className={`px-2 py-1 rounded text-xs ${isRadar ? 'bg-slate-700 text-slate-300' : 'bg-stone-200 text-stone-700'}`}>\n   260→                {alias}\n   261→              </span>\n   262→            ))}\n   263→          </div>\n   264→        </div>\n   265→      )}\n   266→    </motion.div>\n   267→  );\n   268→}\n   269→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"9cec20cb-b613-4ab4-b437-0d4075a2df3d","uuid":"4d302c3a-37b8-4937-b248-07499da2123e","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\views\\EntitiesView.tsx","content":"'use client';\n\nimport { useMemo, useState } from 'react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport type { KnowledgeEntity } from '@/src/types/research';\nimport { useReportTheme, useThemeStyles } from '../core/ThemeContext';\nimport { AnimatedNumber } from '../core/AnimatedNumber';\nimport { EntityConstellation } from '../visualizations/EntityConstellation';\nimport { ViewHeader } from '../shared/ViewHeader';\nimport { EmptyState } from '../shared/EmptyState';\n\ninterface EntitiesViewProps {\n  entities: KnowledgeEntity[];\n}\n\ntype EntityType = 'person' | 'organization' | 'location' | 'event' | 'other';\ntype ViewMode = 'constellation' | 'cards';\n\nconst entityConfig: Record<EntityType, { icon: string; gradient: string }> = {\n  person: { icon: '👤', gradient: 'from-rose-500 to-pink-600' },\n  organization: { icon: '🏢', gradient: 'from-blue-500 to-indigo-600' },\n  location: { icon: '📍', gradient: 'from-emerald-500 to-teal-600' },\n  event: { icon: '📅', gradient: 'from-amber-500 to-orange-600' },\n  other: { icon: '🔹', gradient: 'from-slate-500 to-gray-600' },\n};\n\n// Stagger animation variants - calculated once at parent level\nconst listContainerVariants = {\n  hidden: { opacity: 1 },\n  visible: {\n    opacity: 1,\n    transition: {\n      staggerChildren: 0.03,\n    },\n  },\n};\n\nconst listItemVariants = {\n  hidden: { opacity: 0 },\n  visible: { opacity: 1 },\n};\n\nexport function EntitiesView({ entities }: EntitiesViewProps) {\n  const { theme } = useReportTheme();\n  const styles = useThemeStyles();\n  const isRadar = theme === 'radar';\n  const [viewMode, setViewMode] = useState<ViewMode>('constellation');\n  const [selectedEntity, setSelectedEntity] = useState<string | null>(null);\n  const [filterType, setFilterType] = useState<EntityType | 'all'>('all');\n\n  const grouped = useMemo(() => {\n    const groups: Record<EntityType, KnowledgeEntity[]> = {\n      person: [], organization: [], location: [], event: [], other: [],\n    };\n    entities.forEach(e => {\n      const type = (e.entity_type?.toLowerCase() || 'other') as EntityType;\n      (groups[type] || groups.other).push(e);\n    });\n    return groups;\n  }, [entities]);\n\n  const filtered = useMemo(() => {\n    if (filterType === 'all') return entities;\n    return grouped[filterType];\n  }, [entities, grouped, filterType]);\n\n  const selectedData = selectedEntity ? entities.find(e => e.id === selectedEntity) : null;\n\n  if (entities.length === 0) {\n    return (\n      <EmptyState\n        type=\"users\"\n        title=\"No entities extracted\"\n        description=\"The research hasn't identified any people, organizations, or locations yet.\"\n      />\n    );\n  }\n\n  const viewToggle = (\n    <div className={`flex rounded-lg overflow-hidden ${isRadar ? 'bg-slate-800' : 'bg-stone-200'}`}>\n      {(['constellation', 'cards'] as ViewMode[]).map(mode => (\n        <button\n          key={mode}\n          onClick={() => setViewMode(mode)}\n          className={`px-3 py-1.5 text-xs font-medium capitalize transition-colors ${\n            viewMode === mode\n              ? isRadar ? 'bg-cyan-500/20 text-cyan-300' : 'bg-white text-stone-900'\n              : isRadar ? 'text-slate-400 hover:text-white' : 'text-stone-600 hover:text-stone-900'\n          }`}\n        >\n          {mode}\n        </button>\n      ))}\n    </div>\n  );\n\n  return (\n    <div className=\"space-y-4\">\n      <ViewHeader title=\"Entities\" count={entities.length} actions={viewToggle} />\n\n      {/* Type filters */}\n      <div className=\"flex gap-2\">\n        <FilterChip label=\"All\" count={entities.length} active={filterType === 'all'} onClick={() => setFilterType('all')} />\n        {(['person', 'organization', 'location', 'event'] as EntityType[]).map(type => (\n          <FilterChip\n            key={type}\n            label={entityConfig[type].icon}\n            count={grouped[type].length}\n            active={filterType === type}\n            onClick={() => setFilterType(type)}\n          />\n        ))}\n      </div>\n\n      {/* Constellation view */}\n      {viewMode === 'constellation' && (\n        <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }}>\n          <EntityConstellation\n            entities={filtered}\n            selectedEntity={selectedEntity || undefined}\n            onEntitySelect={setSelectedEntity}\n          />\n        </motion.div>\n      )}\n\n      {/* Cards view */}\n      {viewMode === 'cards' && (\n        <div className=\"grid grid-cols-2 md:grid-cols-4 gap-3\">\n          {(['person', 'organization', 'location', 'event'] as EntityType[]).map(type => {\n            const list = filterType === 'all' ? grouped[type] : (filterType === type ? grouped[type] : []);\n            if (list.length === 0) return null;\n\n            return (\n              <EntityTypeColumn\n                key={type}\n                type={type}\n                entities={list}\n                selectedEntity={selectedEntity}\n                onSelect={setSelectedEntity}\n              />\n            );\n          })}\n        </div>\n      )}\n\n      {/* Selected entity detail */}\n      <AnimatePresence>\n        {selectedData && (\n          <EntityDetail entity={selectedData} onClose={() => setSelectedEntity(null)} />\n        )}\n      </AnimatePresence>\n    </div>\n  );\n}\n\nfunction FilterChip({ label, count, active, onClick }: { label: string; count: number; active: boolean; onClick: () => void }) {\n  const { theme } = useReportTheme();\n  const isRadar = theme === 'radar';\n\n  return (\n    <button\n      onClick={onClick}\n      className={`px-2 py-1 rounded-lg text-xs flex items-center gap-1 transition-all ${\n        active\n          ? isRadar ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/30' : 'bg-stone-800 text-white'\n          : isRadar ? 'bg-slate-800/50 text-slate-400 hover:text-white' : 'bg-stone-100 text-stone-600 hover:bg-stone-200'\n      }`}\n    >\n      {label}\n      <span className={`px-1 py-0.5 rounded text-[9px] ${active ? (isRadar ? 'bg-cyan-500/30' : 'bg-white/20') : 'bg-black/10'}`}>\n        {count}\n      </span>\n    </button>\n  );\n}\n\nfunction EntityTypeColumn({ type, entities, selectedEntity, onSelect }: {\n  type: EntityType;\n  entities: KnowledgeEntity[];\n  selectedEntity: string | null;\n  onSelect: (id: string | null) => void;\n}) {\n  const { theme } = useReportTheme();\n  const isRadar = theme === 'radar';\n  const config = entityConfig[type];\n\n  return (\n    <motion.div\n      initial={{ opacity: 0, y: 20 }}\n      animate={{ opacity: 1, y: 0 }}\n      className={`rounded-xl overflow-hidden ${isRadar ? 'bg-slate-900/60 border border-cyan-500/10' : 'bg-white border border-stone-200'}`}\n    >\n      <div className={`sticky top-0 z-10 p-3 backdrop-blur-sm ${isRadar ? `bg-gradient-to-r ${config.gradient}/95` : 'bg-stone-50/95 border-b border-stone-200'}`}>\n        <h4 className={`text-xs font-semibold capitalize flex items-center gap-2 ${isRadar ? 'text-white' : 'text-stone-900'}`}>\n          {config.icon} {type}s (<AnimatedNumber value={entities.length} />)\n        </h4>\n      </div>\n      <motion.div\n        className=\"p-2 max-h-64 overflow-y-auto space-y-1 scroll-smooth\"\n        variants={listContainerVariants}\n        initial=\"hidden\"\n        animate=\"visible\"\n      >\n        {entities.slice(0, 10).map((e) => (\n          <motion.button\n            key={e.id}\n            variants={listItemVariants}\n            onClick={() => onSelect(selectedEntity === e.id ? null : e.id)}\n            className={`w-full text-left p-2 rounded-lg text-xs transition-all ${\n              selectedEntity === e.id\n                ? isRadar ? 'bg-cyan-500/20 text-cyan-300' : 'bg-stone-800 text-white'\n                : isRadar ? 'text-slate-300 hover:bg-slate-800/50' : 'text-stone-700 hover:bg-stone-50'\n            }`}\n          >\n            {e.canonical_name}\n          </motion.button>\n        ))}\n      </motion.div>\n    </motion.div>\n  );\n}\n\nfunction EntityDetail({ entity, onClose }: { entity: KnowledgeEntity; onClose: () => void }) {\n  const { theme } = useReportTheme();\n  const styles = useThemeStyles();\n  const isRadar = theme === 'radar';\n  const type = (entity.entity_type?.toLowerCase() || 'other') as EntityType;\n  const config = entityConfig[type];\n\n  return (\n    <motion.div\n      initial={{ opacity: 0, y: 20 }}\n      animate={{ opacity: 1, y: 0 }}\n      exit={{ opacity: 0, y: 20 }}\n      className={`p-4 rounded-xl ${isRadar ? 'bg-slate-900/80 border border-cyan-500/20' : 'bg-white border border-stone-200 shadow-lg'}`}\n    >\n      <div className=\"flex items-start justify-between mb-3\">\n        <div className=\"flex items-center gap-3\">\n          <span className=\"text-2xl\">{config.icon}</span>\n          <div>\n            <h3 className={`font-semibold ${styles.text}`}>{entity.canonical_name}</h3>\n            <p className={`text-xs ${styles.textMuted}`}>{entity.mention_count || 0} mentions</p>\n          </div>\n        </div>\n        <button onClick={onClose} className={`p-1 rounded ${isRadar ? 'hover:bg-slate-800' : 'hover:bg-stone-100'}`}>\n          <svg className={`w-5 h-5 ${styles.textMuted}`} fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M6 18L18 6M6 6l12 12\" />\n          </svg>\n        </button>\n      </div>\n\n      {entity.description && <p className={`text-sm mb-3 ${styles.text}`}>{entity.description}</p>}\n\n      {entity.aliases && entity.aliases.length > 0 && (\n        <div className={`p-3 rounded-lg ${isRadar ? 'bg-slate-800/50' : 'bg-stone-50'}`}>\n          <div className={`text-[10px] uppercase tracking-wider mb-2 ${styles.textMuted}`}>Also known as</div>\n          <div className=\"flex flex-wrap gap-1\">\n            {entity.aliases.map((alias, i) => (\n              <span key={i} className={`px-2 py-1 rounded text-xs ${isRadar ? 'bg-slate-700 text-slate-300' : 'bg-stone-200 text-stone-700'}`}>\n                {alias}\n              </span>\n            ))}\n          </div>\n        </div>\n      )}\n    </motion.div>\n  );\n}\n","numLines":269,"startLine":1,"totalLines":269}}}
