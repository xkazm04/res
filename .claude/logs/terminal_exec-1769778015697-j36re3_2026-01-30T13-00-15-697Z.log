"wait\">\n    79→        {activeTab === 'contradictions' && contradictions.length > 0 && (\n    80→          <motion.div key=\"contradictions\" initial={{ opacity: 0, y: 10 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0, y: -10 }}>\n    81→            <ContradictionMatrix contradictions={contradictions} />\n    82→          </motion.div>\n    83→        )}\n    84→\n    85→        {activeTab === 'gaps' && gaps.length > 0 && (\n    86→          <motion.div key=\"gaps\" initial={{ opacity: 0, y: 10 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0, y: -10 }} className=\"space-y-3\">\n    87→            {gaps.map((g, i) => <GapCard key={g.id} gap={g} delay={i * 0.05} />)}\n    88→          </motion.div>\n    89→        )}\n    90→\n    91→        {activeTab === 'chains' && causalChains.length > 0 && (\n    92→          <motion.div key=\"chains\" initial={{ opacity: 0, y: 10 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0, y: -10 }}>\n    93→            <CausalFlow chains={causalChains} />\n    94→          </motion.div>\n    95→        )}\n    96→      </AnimatePresence>\n    97→    </div>\n    98→  );\n    99→}\n   100→\n   101→function GapCard({ gap, delay }: { gap: ResearchGap; delay: number }) {\n   102→  const { theme } = useReportTheme();\n   103→  const styles = useThemeStyles();\n   104→  const isRadar = theme === 'radar';\n   105→  const [showQueries, setShowQueries] = useState(false);\n   106→  const queries = gap.suggested_queries || [];\n   107→\n   108→  const priorityColors = {\n   109→    high: isRadar ? 'text-rose-400 bg-rose-500/20' : 'text-rose-700 bg-rose-100',\n   110→    medium: isRadar ? 'text-amber-400 bg-amber-500/20' : 'text-amber-700 bg-amber-100',\n   111→    low: isRadar ? 'text-emerald-400 bg-emerald-500/20' : 'text-emerald-700 bg-emerald-100',\n   112→  };\n   113→\n   114→  return (\n   115→    <motion.div\n   116→      initial={{ opacity: 0, x: -10 }}\n   117→      animate={{ opacity: 1, x: 0 }}\n   118→      transition={{ 