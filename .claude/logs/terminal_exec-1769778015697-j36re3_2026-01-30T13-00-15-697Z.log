[2026-01-30T13:00:40.724Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QDLf8roSbbR3XUNNgcqR2i","type":"tool_result","content":"     1→'use client';\n     2→\n     3→import { useMemo, useState, lazy, Suspense } from 'react';\n     4→import { motion } from 'framer-motion';\n     5→import type { SessionWithDetails } from '@/src/types/research';\n     6→import { useReportTheme, useThemeStyles } from '../core/ThemeContext';\n     7→import { ThemedSection, ThemedBadge } from '../ThemedCards';\n     8→import { AnimatedNumber } from '../core/AnimatedNumber';\n     9→import { IntelDashboard } from '../features/IntelDashboard';\n    10→import { KeyPointsPanel } from '../features/KeyPointsPanel';\n    11→import { ViewHeader } from '../shared/ViewHeader';\n    12→\n    13→// Lazy load heavy visualization components to reduce initial bundle size\n    14→const ConfidenceHeatmap = lazy(() => import('../visualizations/ConfidenceHeatmap').then(m => ({ default: m.ConfidenceHeatmap })));\n    15→const Timeline = lazy(() => import('../visualizations/Timeline').then(m => ({ default: m.Timeline })));\n    16→const VideoOverview = lazy(() => import('../video/VideoOverview').then(m => ({ default: m.VideoOverview })));\n    17→\n    18→// Loading fallback for lazy-loaded components\n    19→function VisualizationSkeleton({ height = 'h-48' }: { height?: string }) {\n    20→  const { theme } = useReportTheme();\n    21→  const isRadar = theme === 'radar';\n    22→  return (\n    23→    <div className={`${height} rounded-xl animate-pulse ${isRadar ? 'bg-slate-800/50' : 'bg-stone-100'}`}>\n    24→      <div className=\"h-full flex items-center justify-center\">\n    25→        <div className={`w-6 h-6 rounded-full border-2 border-t-transparent animate-spin ${isRadar ? 'border-cyan-500/30' : 'border-stone-300'}`} />\n    26→      </div>\n    27→    </div>\n    28→  );\n    29→}\n    30→\n    31→interface OverviewViewProps {\n    32→  session: SessionWithDetails;\n    33→  stats: {\n    34→    findings: number;\n    35→    sources: number;\n    36→    perspectives: number;\n    37→    avgConfidence: number;\n    38→    highConfidence: number;\n    39→    redFlags: number;\n    40→    gaps: number;\n    41→  };\n    42→}\n    43→\n    44→type ViewMode = 'video' | 'static';\n    45→\n    46→export function OverviewView({ session, stats }: OverviewViewProps) {\n    47→  const { theme } = useReportTheme();\n    48→  const styles = useThemeStyles();\n    49→  const findings = session.findings || [];\n    50→  const isRadar = theme === 'radar';\n    51→  const [viewMode, setViewMode] = useState<ViewMode>('video');\n    52→\n    53→  // Calculate metrics for dashboard\n    54→  const coverage = Math.min(100, Math.round((stats.sources / Math.max(10, stats.findings * 2)) * 100));\n    55→  const reliability = Math.round((findings.filter(f => (f.confidence_score || 0) >= 0.7).length / Math.max(1, findings.length)) * 100);\n    56→  const completeness = Math.min(100, 100 - (stats.gaps * 10));\n    57→\n    58→  const allWarnings = session.perspectives?.flatMap(p => p.warnings || []) || [];\n    59→\n    60→  const viewToggle = (\n    61→    <div className={`flex rounded-lg overflow-hidden ${isRadar ? 'bg-slate-800' : 'bg-stone-200'}`}>\n    62→      <button\n    63→        onClick={() => setViewMode('video')}\n    64→        className={`px-3 py-1.5 text-xs font-medium flex items-center gap-1 transition-colors ${\n    65→          viewMode === 'video'\n    66→            ? isRadar ? 'bg-cyan-500/20 text-cyan-300' : 'bg-white text-stone-900'\n    67→            : isRadar ? 'text-slate-400 hover:text-white' : 'text-stone-600 hover:text-stone-900'\n    68→        }`}\n    69→      >\n    70→        <svg className=\"w-3 h-3\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M8 5v14l11-7z\" /></svg>\n    71→        Video\n    72→      </button>\n    73→      <button\n    74→        onClick={() => setViewMode('static')}\n    75→        className={`px-3 py-1.5 text-xs font-medium flex items-center gap-1 transition-colors ${\n    76→          viewMode === 'static'\n    77→            ? isRadar ? 'bg-cyan-500/20 text-cyan-300' : 'bg-white text-stone-900'\n    78→            : isRadar ? 'text-slate-400 hover:text-white' : 'text-stone-600 hover:text-stone-900'\n    79→        }`}\n    80→      >\n    81→        <svg className=\"w-3 h-3\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M4 6h16M4 12h16M4 18h16\" /></svg>\n    82→        Static\n    83→      </button>\n    84→    </div>\n    85→  );\n    86→\n    87→  return (\n    88→    <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} className=\"space-y-6\">\n    89→      <ViewHeader title=\"Overview\" actions={viewToggle} />\n    90→\n    91→      {/* Video mode */}\n    92→      {viewMode === 'video' && (\n    93→        <Suspense fallback={<VisualizationSkeleton height=\"h-96\" />}>\n    94→          <VideoOverview session={session} stats={stats} />\n    95→        </Suspense>\n    96→      )}\n    97→\n    98→      {/* Static mode */}\n    99→      {viewMode === 'static' && <StaticOverview session={session} stats={stats} coverage={coverage} reliability={reliability} completeness={completeness} allWarnings={allWarnings} />}\n   100→    </motion.div>\n   101→  );\n   102→}\n   103→\n   104→function StaticOverview({ session, stats, coverage, reliability, completeness, allWarnings }: {\n   105→  session: SessionWithDetails;\n   106→  stats: OverviewViewProps['stats'];\n   107→  coverage: number;\n   108→  reliability: number;\n   109→  completeness: number;\n   110→  allWarnings: string[];\n   111→}) {\n   112→  const { theme } = useReportTheme();\n   113→  const styles = useThemeStyles();\n   114→  const isRadar = theme === 'radar';\n   115→  const findings = session.findings || [];\n   116→\n   117→  // Single memoized computation for all derived data, keyed by session.id for stability\n   118→  const { keyPoints, heatmapData, timelineEvents } = useMemo(() => {\n   119→    // Key points from perspectives and findings\n   120→    const points: Array<{ id: string; text: string; type: 'insight' | 'warning' | 'action' | 'fact'; confidence: number; sourceCount: number }> = [];\n   121→    session.perspectives?.forEach(p => {\n   122→      p.key_insights?.forEach((insight, i) => { points.push({ id: `insight-${p.id}-${i}`, text: insight, type: 'insight', confidence: p.confidence || 0.7, sourceCount: p.sources_cited?.length || 0 }); });\n   123→      p.warnings?.forEach((warning, i) => { points.push({ id: `warning-${p.id}-${i}`, text: warning, type: 'warning', confidence: 0.9, sourceCount: 1 }); });\n   124→      p.recommendations?.forEach((rec, i) => { points.push({ id: `action-${p.id}-${i}`, text: rec, type: 'action', confidence: 0.8, sourceCount: 1 }); });\n   125→    });\n   126→    findings.slice(0, 5).forEach(f => { points.push({ id: f.id, text: f.content.slice(0, 150), type: 'fact', confidence: f.confidence_score || 0.5, sourceCount: f.supporting_sources?.length || 0 }); });\n   127→\n   128→    // Heatmap data from findings confidence\n   129→    const heatmap = findings.slice(0, 25).map(f => ({ id: f.id, label: f.content.slice(0, 40) + '...', value: f.confidence_score || 0.5 }));\n   130→\n   131→    // Timeline events from dated findings\n   132→    const timeline = findings.filter(f => f.event_date).map(f => ({\n   133→      id: f.id,\n   134→      date: new Date(f.event_date!),\n   135→      label: f.content.slice(0, 50) + '...',\n   136→      type: (f.temporal_context === 'prediction' ? 'prediction' : f.finding_type === 'event' ? 'event' : 'finding') as 'finding' | 'event' | 'prediction',\n   137→      confidence: f.confidence_score,\n   138→    })).slice(0, 15);\n   139→\n   140→    return {\n   141→      keyPoints: points.slice(0, 12),\n   142→      heatmapData: heatmap,\n   143→      timelineEvents: timeline,\n   144→    };\n   145→  }, [session.id, session.perspectives, findings]);\n   146→\n   147→  return (\n   148→    <>\n   149→      <IntelDashboard\n   150→        confidence={stats.avgConfidence}\n   151→        findings={{ label: 'Findings', value: stats.findings, sublabel: `${stats.highConfidence} verified` }}\n   152→        sources={{ label: 'Sources', value: stats.sources, sublabel: 'analyzed' }}\n   153→        coverage={coverage}\n   154→        reliability={reliability}\n   155→        completeness={completeness}\n   156→        alerts={stats.redFlags + allWarnings.length}\n   157→      />\n   158→\n   159→      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n   160→        <KeyPointsPanel points={keyPoints} />\n   161→        {heatmapData.length > 0 && (\n   162→          <Suspense fallback={<VisualizationSkeleton />}>\n   163→            <ConfidenceHeatmap data={heatmapData} title=\"Finding Confidence Distribution\" />\n   164→          </Suspense>\n   165→        )}\n   166→      </div>\n   167→\n   168→      {timelineEvents.length > 0 && (\n   169→        <Suspense fallback={<VisualizationSkeleton height=\"h-32\" />}>\n   170→          <Timeline events={timelineEvents} />\n   171→        </Suspense>\n   172→      )}\n   173→\n   174→      {allWarnings.length > 0 && (\n   175→        <motion.div initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.3 }}\n   176→          className={`rounded-xl p-4 ${isRadar ? 'bg-rose-500/10 border border-rose-500/30' : 'bg-rose-50 border-l-4 border-rose-600'}`}>\n   177→          <div className={`flex items-center gap-2 mb-3 ${isRadar ? 'text-rose-400' : 'text-rose-700'}`}>\n   178→            <motion.span animate={{ scale: [1, 1.2, 1] }} transition={{ duration: 2, repeat: Infinity }}>⚠️</motion.span>\n   179→            <span className=\"font-semibold\">Critical Warnings ({allWarnings.length})</span>\n   180→          </div>\n   181→          <ul className=\"space-y-