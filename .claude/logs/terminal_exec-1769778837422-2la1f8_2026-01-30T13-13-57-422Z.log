[2026-01-30T13:14:06.852Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RUMap8mtu4e4XKVBC69LUm","type":"tool_result","content":"     1→'use client';\n     2→\n     3→import { useMemo, useState } from 'react';\n     4→import { motion, AnimatePresence } from 'framer-motion';\n     5→import type { ResearchSource } from '@/src/types/research';\n     6→import { useReportTheme, useThemeStyles } from '../core/ThemeContext';\n     7→import { ThemedBadge } from '../ThemedCards';\n     8→import { AnimatedNumber, AnimatedProgressRing } from '../core/AnimatedNumber';\n     9→import { SourceNetwork } from '../visualizations/SourceNetwork';\n    10→import { TrustRadar } from '../visualizations/TrustRadar';\n    11→import { ViewHeader } from '../shared/ViewHeader';\n    12→import { EmptyState } from '../shared/EmptyState';\n    13→\n    14→interface SourcesViewProps {\n    15→  sources: ResearchSource[];\n    16→  searchQuery: string;\n    17→  filterConfidence: string;\n    18→}\n    19→\n    20→type ViewMode = 'cards' | 'network' | 'radar';\n    21→\n    22→// Stagger animation variants - calculated once at parent level\n    23→const containerVariants = {\n    24→  hidden: { opacity: 0 },\n    25→  visible: {\n    26→    opacity: 1,\n    27→    transition: {\n    28→      staggerChildren: 0.03,\n    29→    },\n    30→  },\n    31→};\n    32→\n    33→const itemVariants = {\n    34→  hidden: { opacity: 0, y: 10 },\n    35→  visible: { opacity: 1, y: 0 },\n    36→  exit: { opacity: 0, scale: 0.95 },\n    37→};\n    38→\n    39→export function SourcesView({ sources, searchQuery, filterConfidence }: SourcesViewProps) {\n    40→  const { theme } = useReportTheme();\n    41→  const styles = useThemeStyles();\n    42→  const isRadar = theme === 'radar';\n    43→  const [viewMode, setViewMode] = useState<ViewMode>('cards');\n    44→  const [selectedSource, setSelectedSource] = useState<string | null>(null);\n    45→\n    46→  const filtered = useMemo(() => {\n    47→    return sources.filter((s) => {\n    48→      if (searchQuery) {\n    49→        const q = searchQuery.toLowerCase();\n    50→        if (!s.title?.toLowerCase().includes(q) && !s.domain?.toLowerCase().includes(q)) return false;\n    51→      }\n    52→      const cred = s.credibility_score || 0;\n    53→      if (filterConfidence === 'high' && cred < 0.8) return false;\n    54→      if (filterConfidence === 'medium' && (cred < 0.5 || cred >= 0.8)) return false;\n    55→      if (filterConfidence === 'low' && cred >= 0.5) return false;\n    56→      return true;\n    57→    });\n    58→  }, [sources, searchQuery, filterConfidence]);\n    59→\n    60→  const stats = useMemo(() => {\n    61→    const high = filtered.filter(s => (s.credibility_score || 0) >= 0.8).length;\n    62→    const med = filtered.filter(s => { const c = s.credibility_score || 0; return c >= 0.5 && c < 0.8; }).length;\n    63→    return { high, med, low: filtered.length - high - med };\n    64→  }, [filtered]);\n    65→\n    66→  if (filtered.length === 0) {\n    67→    return (\n    68→      <EmptyState\n    69→        type=\"search\"\n    70→        title=\"No sources match your filters\"\n    71→        description=\"Try adjusting your search or confidence filters to see more results.\"\n    72→      />\n    73→    );\n    74→  }\n    75→\n    76→  return (\n    77→    <div className=\"space-y-4\">\n    78→      <ViewHeader\n    79→        title=\"Sources\"\n    80→        count={filtered.length}\n    81→        actions={<ViewToggle mode={viewMode} onChange={setViewMode} />}\n    82→      />\n    83→      {/* Credibility summary bar */}\n    84→      <CredibilityBar stats={stats} total={filtered.length} />\n    85→\n    86→      {/* Network View */}\n    87→      {viewMode === 'network' && (\n    88→        <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }}>\n    89→          <SourceNetwork sources={filtered} selectedSource={selectedSource || undefined} onSourceSelect={setSelectedSource} />\n    90→        </motion.div>\n    91→      )}\n    92→\n    93→      {/* Radar View */}\n    94→      {viewMode === 'radar' && (\n    95→        <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }}>\n    96→          <TrustRadar sources={filtered} />\n    97→        </motion.div>\n    98→      )}\n    99→\n   100→      {/* Cards View */}\n   101→      {viewMode === 'cards' && (\n   102→        <motion.div\n   103→          layout\n   104→          className=\"grid grid-cols-1 md:grid-cols-2 gap-3\"\n   105→          variants={containerVariants}\n   106→          initial=\"hidden\"\n   107→          animate=\"visible\"\n   108→        >\n   109→          <AnimatePresence>\n   110→            {filtered.map((source) => (\n   111→              <SourceCard key={source.id} source={source} isSelected={selectedSource === source.id} onSelect={setSelectedSource} />\n   112→            ))}\n   113→          </AnimatePresence>\n   114→        </motion.div>\n   115→      )}\n   116→    </div>\n   117→  );\n   118→}\n   119→\n   120→function CredibilityBar({ stats, total }: { stats: { high: number; med: number; low: number }; total: number }) {\n   121→  const { theme } = useReportTheme();\n   122→  const styles = useThemeStyles();\n   123→  const isRadar = theme === 'radar';\n   124→\n   125→  return (\n   126→    <div className={`flex items-center gap-4`}>\n   127→      <div className={`text-sm ${styles.textMuted}`}><AnimatedNumber value={total} /> sources</div>\n   128→      <div className=\"flex items-center gap-1 h-2 w-32 rounded-full overflow-hidden bg-slate-700/20\">\n   129→        <motion.div initial={{ width: 0 }} animate={{ width: `${(stats.high / total) * 100}%` }} className=\"h-full bg-emerald-500\" />\n   130→        <motion.div initial={{ width: 0 }} animate={{ width: `${(stats.med / total) * 100}%` }} className=\"h-full bg-amber-500\" />\n   131→        <motion.div initial={{ width: 0 }} animate={{ width: `${(stats.low / total) * 100}%` }} className=\"h-full bg-rose-500\" />\n   132→      </div>\n   133→    </div>\n   134→  );\n   135→}\n   136→\n   137→function ViewToggle({ mode, onChange }: { mode: ViewMode; onChange: (m: ViewMode) => void }) {\n   138→  const { theme } = useReportTheme();\n   139→  const isRadar = theme === 'radar';\n   140→  const options: ViewMode[] = ['cards', 'network', 'radar'];\n   141→\n   142→  return (\n   143→    <div className={`flex rounded-lg overflow-hidden ${isRadar ? 'bg-slate-800' : 'bg-stone-200'}`}>\n   144→      {options.map(opt => (\n   145→        <button\n   146→          key={opt}\n   147→          onClick={() => onChange(opt)}\n   148→          className={`px-3 py-1.5 text-xs font-medium capitalize transition-colors ${\n   149→            mode === opt\n   150→              ? isRadar ? 'bg-cyan-500/20 text-cyan-300' : 'bg-white text-stone-900'\n   151→              : isRadar ? 'text-slate-400 hover:text-white' : 'text-stone-600 hover:text-stone-900'\n   152→          }`}\n   153→        >\n   154→          {opt}\n   155→        </button>\n   156→      ))}\n   157→    </div>\n   158→  );\n   159→}\n   160→\n   161→function SourceCard({ source, isSelected, onSelect }: {\n   162→  source: ResearchSource;\n   163→  isSelected: boolean;\n   164→  onSelect: (id: string | null) => void;\n   165→}) {\n   166→  const { theme } = useReportTheme();\n   167→  const styles = useThemeStyles();\n   168→  const isRadar = theme === 'radar';\n   169→  const cred = source.credibility_score || 0;\n   170→\n   171→  return (\n   172→    <motion.div\n   173→      layout\n   174→      variants={itemVariants}\n   175→      exit=\"exit\"\n   176→      onClick={() => onSelect(isSelected ? null : source.id)}\n   177→      className={`p-4 rounded-xl cursor-pointer transition-all ${\n   178→        isRadar\n   179→          ? `bg-slate-900/60 border ${isSelected ? 'border-cyan-400 shadow-[0_0_20px_rgba(34,211,238,0.2)]' : 'border-cyan-500/10 hover:border-cyan-500/30'}`\n   180→          : `bg-white border ${isSelected ? 'border-stone-800 shadow-lg' : 'border-stone-200 hover:border-stone-400'}`\n   181→      }`}\n   182→    >\n   183→      <div className=\"flex items-start gap-3\">\n   184→        <AnimatedProgressRing\n   185→          value={cred * 100}\n   186→          size={44}\n   187→          strokeWidth={3}\n   188→          color={cred >= 0.8 ? '#34d399' : cred >= 0.5 ? '#fbbf24' : '#f87171'}\n   189→          bgColor={isRadar ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)'}\n   190→        />\n   191→        <div className=\"flex-1 min-w-0\">\n   192→          <div className=\"flex items-center gap-2 mb-1\">\n   193→            <ThemedBadge>{source.source_type || 'web'}</ThemedBadge>\n   194→            <span className={`text-[10px] ${styles.textMuted}`}>{Math.round(cred * 100)}%</span>\n   195→          </div>\n   196→          <a href={source.url} target=\"_blank\" rel=\"noopener noreferrer\" onClick={e => e.stopPropagation()}\n   197→            className={`text-sm font-medium line-clamp-1 transition-colors ${isRadar ? 'text-cyan-300 hover:text-cyan-200' : 'text-blue-600 hover:text-blue-800'}`}>\n   198→            {source.title || source.domain}\n   199→          </a>\n   200→          <p className={`text-[10px] ${styles.textMuted} mt-0.5`}>{source.domain}</p>\n   201→          {source.snippet && (\n   202→            <p className={`text-xs ${styles.textMuted} mt-2 line-clamp-2 italic`}>\"{source.snippet}\"</p>\n   203→          )}\n   204→        </div>\n   205→      </div>\n   206→    </motion.div>\n   207→  );\n   208→}\n   209→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"bbdddf83-efc9-404e-b6a3-e0a9e67b2ab3","uuid":"0c912d04-bb7f-4e2d-91e6-8f002ff290f2","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\views\\SourcesView.tsx","content":"'use client';\n\nimport { useMemo, useState } from 'react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport type { ResearchSource } from '@/src/types/research';\nimport { useReportTheme, useThemeStyles } from '../core/ThemeContext';\nimport { ThemedBadge } from '../ThemedCards';\nimport { AnimatedNumber, AnimatedProgressRing } from '../core/AnimatedNumber';\nimport { SourceNetwork } from '../visualizations/SourceNetwork';\nimport { TrustRadar } from '../visualizations/TrustRadar';\nimport { ViewHeader } from '../shared/ViewHeader';\nimport { EmptyState } from '../shared/EmptyState';\n\ninterface SourcesViewProps {\n  sources: ResearchSource[];\n  searchQuery: string;\n  filterConfidence: string;\n}\n\ntype ViewMode = 'cards' | 'network' | 'radar';\n\n// Stagger animation variants - calculated once at parent level\nconst containerVariants = {\n  hidden: { opacity: 0 },\n  visible: {\n    opacity: 1,\n    transition: {\n      staggerChildren: 0.03,\n    },\n  },\n};\n\nconst itemVariants = {\n  hidden: { opacity: 0, y: 10 },\n  visible: { opacity: 1, y: 0 },\n  exit: { opacity: 0, scale: 0.95 },\n};\n\nexport function SourcesView({ sources, searchQuery, filterConfidence }: SourcesViewProps) {\n  const { theme } = useReportTheme();\n  const styles = useThemeStyles();\n  const isRadar = theme === 'radar';\n  const [viewMode, setViewMode] = useState<ViewMode>('cards');\n  const [selectedSource, setSelectedSource] = useState<string | null>(null);\n\n  const filtered = useMemo(() => {\n    return sources.filter((s) => {\n      if (searchQuery) {\n        const q = searchQuery.toLowerCase();\n        if (!s.title?.toLowerCase().includes(q) && !s.domain?.toLowerCase().includes(q)) return false;\n      }\n      const cred = s.credibility_score || 0;\n      if (filterConfidence === 'high' && cred < 0.8) return false;\n      if (filterConfidence === 'medium' && (cred < 0.5 || cred >= 0.8)) return false;\n      if (filterConfidence === 'low' && cred >= 0.5) return false;\n      return true;\n    });\n  }, [sources, searchQuery, filterConfidence]);\n\n  const stats = useMemo(() => {\n    const high = filtered.filter(s => (s.credibility_score || 0) >= 0.8).length;\n    const med = filtered.filter(s => { const c = s.credibility_score || 0; return c >= 0.5 && c < 0.8; }).length;\n    return { high, med, low: filtered.length - high - med };\n  }, [filtered]);\n\n  if (filtered.length === 0) {\n    return (\n      <EmptyState\n        type=\"search\"\n        title=\"No sources match your filters\"\n        description=\"Try adjusting your search or confidence filters to see more results.\"\n      />\n    );\n  }\n\n  return (\n    <div className=\"space-y-4\">\n      <ViewHeader\n        title=\"Sources\"\n        count={filtered.length}\n        actions={<ViewToggle mode={viewMode} onChange={setViewMode} />}\n      />\n      {/* Credibility summary bar */}\n      <CredibilityBar stats={stats} total={filtered.length} />\n\n      {/* Network View */}\n      {viewMode === 'network' && (\n        <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }}>\n          <SourceNetwork sources={filtered} selectedSource={selectedSource || undefined} onSourceSelect={setSelectedSource} />\n        </motion.div>\n      )}\n\n      {/* Radar View */}\n      {viewMode === 'radar' && (\n        <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }}>\n          <TrustRadar sources={filtered} />\n        </motion.div>\n      )}\n\n      {/* Cards View */}\n      {viewMode === 'cards' && (\n        <motion.div\n          layout\n          className=\"grid grid-cols-1 md:grid-cols-2 gap-3\"\n          variants={containerVariants}\n          initial=\"hidden\"\n          animate=\"visible\"\n        >\n          <AnimatePresence>\n            {filtered.map((source) => (\n              <SourceCard key={source.id} source={source} isSelected={selectedSource === source.id} onSelect={setSelectedSource} />\n            ))}\n          </AnimatePresence>\n        </motion.div>\n      )}\n    </div>\n  );\n}\n\nfunction CredibilityBar({ stats, total }: { stats: { high: number; med: number; low: number }; total: number }) {\n  const { theme } = useReportTheme();\n  const styles = useThemeStyles();\n  const isRadar = theme === 'radar';\n\n  return (\n    <div className={`flex items-center gap-4`}>\n      <div className={`text-sm ${styles.textMuted}`}><AnimatedNumber value={total} /> sources</div>\n      <div className=\"flex items-center gap-1 h-2 w-32 rounded-full overflow-hidden bg-slate-700/20\">\n        <motion.div initial={{ width: 0 }} animate={{ width: `${(stats.high / total) * 100}%` }} className=\"h-full bg-emerald-500\" />\n        <motion.div initial={{ width: 0 }} animate={{ width: `${(stats.med / total) * 100}%` }} className=\"h-full bg-amber-500\" />\n        <motion.div initial={{ width: 0 }} animate={{ width: `${(stats.low / total) * 100}%` }} className=\"h-full bg-rose-500\" />\n      </div>\n    </div>\n  );\n}\n\nfunction ViewToggle({ mode, onChange }: { mode: ViewMode; onChange: (m: ViewMode) => void }) {\n  const { theme } = useReportTheme();\n  const isRadar = theme === 'radar';\n  const options: ViewMode[] = ['cards', 'network', 'radar'];\n\n  return (\n    <div className={`flex rounded-lg overflow-hidden ${isRadar ? 'bg-slate-800' : 'bg-stone-200'}`}>\n      {options.map(opt => (\n        <button\n          key={opt}\n          onClick={() => onChange(opt)}\n          className={`px-3 py-1.5 text-xs font-medium capitalize transition-colors ${\n            mode === opt\n              ? isRadar ? 'bg-cyan-500/20 text-cyan-300' : 'bg-white text-stone-900'\n              : isRadar ? 'text-slate-400 hover:text-white' : 'text-stone-600 hover:text-stone-900'\n          }`}\n        >\n          {opt}\n        </button>\n      ))}\n    </div>\n  );\n}\n\nfunction SourceCard({ source, isSelected, onSelect }: {\n  source: ResearchSource;\n  isSelected: boolean;\n  onSelect: (id: string | null) => void;\n}) {\n  const { theme } = useReportTheme();\n  const styles = useThemeStyles();\n  const isRadar = theme === 'radar';\n  const cred = source.credibility_score || 0;\n\n  return (\n    <motion.div\n      layout\n      variants={itemVariants}\n      exit=\"exit\"\n      onClick={() => onSelect(isSelected ? null : source.id)}\n      className={`p-4 rounded-xl cursor-pointer transition-all ${\n        isRadar\n          ? `bg-slate-900/60 border ${isSelected ? 'border-cyan-400 shadow-[0_0_20px_rgba(34,211,238,0.2)]' : 'border-cyan-500/10 hover:border-cyan-500/30'}`\n          : `bg-white border ${isSelected ? 'border-stone-800 shadow-lg' : 'border-stone-200 hover:border-stone-400'}`\n      }`}\n    >\n      <div className=\"flex items-start gap-3\">\n        <AnimatedProgressRing\n          value={cred * 100}\n          size={44}\n          strokeWidth={3}\n          color={cred >= 0.8 ? '#34d399' : cred >= 0.5 ? '#fbbf24' : '#f87171'}\n          bgColor={isRadar ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)'}\n        />\n        <div className=\"flex-1 min-w-0\">\n          <div className=\"flex items-center gap-2 mb-1\">\n            <ThemedBadge>{source.source_type || 'web'}</ThemedBadge>\n            <span className={`text-[10px] ${styles.textMuted}`}>{Math.round(cred * 100)}%</span>\n          </div>\n          <a href={source.url} target=\"_blank\" rel=\"noopener noreferrer\" onClick={e => e.stopPropagation()}\n            className={`text-sm font-medium line-clamp-1 transition-colors ${isRadar ? 'text-cyan-300 hover:text-cyan-200' : 'text-blue-600 hover:text-blue-800'}`}>\n            {source.title || source.domain}\n          </a>\n          <p className={`text-[10px] ${styles.textMuted} mt-0.5`}>{source.domain}</p>\n          {source.snippet && (\n            <p className={`text-xs ${styles.textMuted} mt-2 line-clamp-2 italic`}>\"{source.snippet}\"</p>\n          )}\n        </div>\n      </div>\n    </motion.div>\n  );\n}\n","numLines":209,"startLine":1,"totalLines":209}}}
