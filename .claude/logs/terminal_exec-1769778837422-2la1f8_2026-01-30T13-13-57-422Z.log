ty: 1, y: 0 },\n  exit: { opacity: 0, scale: 0.95 },\n};\n\nexport function SourcesView({ sources, searchQuery, filterConfidence }: SourcesViewProps) {\n  const { theme } = useReportTheme();\n  const styles = useThemeStyles();\n  const isRadar = theme === 'radar';\n  const [viewMode, setViewMode] = useState<ViewMode>('cards');\n  const [selectedSource, setSelectedSource] = useState<string | null>(null);\n\n  const filtered = useMemo(() => {\n    return sources.filter((s) => {\n      if (searchQuery) {\n        const q = searchQuery.toLowerCase();\n        if (!s.title?.toLowerCase().includes(q) && !s.domain?.toLowerCase().includes(q)) return false;\n      }\n      const cred = s.credibility_score || 0;\n      if (filterConfidence === 'high' && cred < 0.8) return false;\n      if (filterConfidence === 'medium' && (cred < 0.5 || cred >= 0.8)) return false;\n      if (filterConfidence === 'low' && cred >= 0.5) return false;\n      return true;\n    });\n  }, [sources, searchQuery, filterConfidence]);\n\n  const stats = useMemo(() => {\n    const high = filtered.filter(s => (s.credibility_score || 0) >= 0.8).length;\n    const med = filtered.filter(s => { const c = s.credibility_score || 0; return c >= 0.5 && c < 0.8; }).length;\n    return { high, med, low: filtered.length - high - med };\n  }, [filtered]);\n\n  if (filtered.length === 0) {\n    return (\n      <EmptyState\n        type=\"search\"\n        title=\"No sources match your filters\"\n        description=\"Try adjusting your search or confidence filters to see more results.\"\n      />\n    );\n  }\n\n  return (\n    <div className=\"space-y-4\">\n      <ViewHeader\n        title=\"Sources\"\n        count={filtered.length}\n        actions={<ViewToggle mode={viewMode} onChange={setViewMode} />}\n      />\n      {/* Credibility summary bar */}\n      <CredibilityBar stats={stats} total={filtered.length} />\n\n      {/* Network View */}\n      {viewMode === 'network' && (\n        <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }}>\n          <SourceNetwork sources={filtered} selectedSource={selectedSource || undefined} onSourceSelect={setSelectedSource} />\n        </motion.div>\n      )}\n\n      {/* Radar View */}\n      {viewMode === 'radar' && (\n        <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }}>\n          <TrustRadar sources={filtered} />\n        </motion.div>\n      )}\n\n      {/* Cards View */}\n      {viewMode === 'cards' && (\n        <motion.div\n          layout\n          className=\"grid grid-cols-1 md:grid-cols-2 gap-3\"\n          variants={containerVariants}\n          initial=\"hidden\"\n          animate=\"visible\"\n        >\n          <AnimatePresence>\n            {filtered.map((source) => (\n              <SourceCard key={source.id} source={source} isSelected={selectedSource === source.id} onSelect={setSelectedSource} />\n            ))}\n          </AnimatePresence>\n        </motion.div>\n      )}\n    </div>\n  );\n}\n\nfunction CredibilityBar({ stats, total }: { stats: { high: number; med: number; low: number }; total: number }) {\n  const { theme } = useReportTheme();\n  const styles = useThemeStyles();\n  const isRadar = theme === 'radar';\n\n  return (\n    <div className={`flex items-center gap-4`}>\n      <div className={`text-sm ${styles.textMuted}`}><AnimatedNumber value={total} /> sources</div>\n      <div className=\"flex items-center gap-1 h-2 w-32 rounded-full overflow-hidden bg-slate-700/20\">\n        <motion.div initial={{ width: 0 }} animate={{ width: `${(stats.high / total) * 100}%` }} className=\"h-full bg-emerald-500\" />\n        <motion.div initial={{ width: 0 }} animate={{ width: `${(stats.med / total) * 100}%` }} className=\"h-full bg-amber-500\" />\n        <motion.div initial={{ width: 0 }} animate={{ width: `${(stats.low / total) * 100}%` }} className=\"h-full bg-rose-500\" />\n      </div>\n    </div>\n  );\n}\n\nfunction ViewToggle({ mode, onChange }: { mode: ViewMode; onChange: (m: ViewMode) => void }) {\n  const { theme } = useReportTheme();\n  const isRadar = theme === 'radar';\n  const options: ViewMode[] = ['cards', 'network', 'radar'];\n\n  return (\n    <div className={`flex rounded-lg overflow-hidden ${isRadar ? 'bg-slate-800' : 'bg-stone-200'}`}>\n      {options.map(opt => (\n        <button\n          key={opt}\n          onClick={() => onChange(opt)}\n          className={`px-3 py-1.5 text-xs font-medium capitalize transition-colors ${\n            mode === opt\n              ? isRadar ? 'bg-cyan-500/20 text-cyan-300' : 'bg-white text-stone-900'\n              : isRadar ? 'text-slate-400 hover:text-white' : 'text-stone-600 hover:text-stone-900'\n          }`}\n        >\n          {opt}\n        </button>\n      ))}\n    </div>\n  );\n}\n\nfunction SourceCard({ source, isSelected, onSelect }: {\n  source: ResearchSource;\n  isSelected: boolean;\n  onSelect: (id: string | null) => void;\n}) {\n  const { theme } = useReportTheme();\n  const styles = useThemeStyles();\n  const isRadar = theme === 'radar';\n  const cred = source.credibility_score || 0;\n\n  return (\n    <motion.div\n      layout\n      variants={itemVariants}\n      exit=\"exit\"\n      onClick={() => onSelect(isSelected ? null : source.id)}\n      className={`p-4 rounded-xl cursor-pointer transition-all ${\n        isRadar\n          ? `bg-slate-900/60 border ${isSelected ? 'border-cyan-400 shadow-[0_0_20px_rgba(34,211,238,0.2)]' : 'border-cyan-500/10 hover:border-cyan-500/30'}`\n          : `bg-white border ${isSelected ? 'border-stone-800 shadow-lg' : 'border-stone-200 hover:border-stone-400'}`\n      }`}\n    >\n      <div className=\"flex items-start gap-3\">\n        <AnimatedProgressRing\n          value={cred * 100}\n          size={44}\n          strokeWidth={3}\n          color={cred >= 0.8 ? '#34d399' : cred >= 0.5 ? '#fbbf24' : '#f87171'}\n          bgColor={isRadar ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)'}\n        />\n        <div className=\"flex-1 min-w-0\">\n          <div className=\"flex items-center gap-2 mb-1\">\n            <ThemedBadge>{source.source_type || 'web'}</ThemedBadge>\n            <span className={`text-[10px] ${styles.textMuted}`}>{Math.round(cred * 100)}%</span>\n          </div>\n          <a href={source.url} target=\"_blank\" rel=\"noopener noreferrer\" onClick={e => e.stopPropagation()}\n            className={`text-sm font-medium line-clamp-1 transition-colors ${isRadar ? 'text-cyan-300 hover:text-cyan-200' : 'text-blue-600 hover:text-blue-800'}`}>\n            {source.title || source.domain}\n          </a>\n          <p className={`text-[10px] ${styles.textMuted} mt-0.5`}>{source.domain}</p>\n          {source.snippet && (\n            <p className={`text-xs ${styles.textMuted} mt-2 line-clamp-2 italic`}>\"{source.snippet}\"</p>\n          )}\n        </div>\n      </div>\n    </motion.div>\n  );\n}\n","structuredPatch":[{"oldStart":20,"oldLines":6,"newStart":20,"newLines":12,"lines":[" "," type ViewMode = 'cards' | 'network' | 'radar';"," ","+const viewModeOptions: ViewModeOption<ViewMode>[] = [","+  { value: 'cards', label: 'Cards' },","+  { value: 'network', label: 'Network' },","+  { value: 'radar', label: 'Radar' },","+];","+"," // Stagger animation variants - calculated once at parent level"," const containerVariants = {","   hidden: { opacity: 0 },"]}],"userModified":false,"replaceAll":false}}
