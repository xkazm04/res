4→  }, []);\n    45→\n    46→  const reset = useCallback(() => {\n    47→    pause();\n    48→    setCurrentIndex(0);\n    49→  }, [pause]);\n    50→\n    51→  useEffect(() => {\n    52→    if (isPlaying && currentIndex < words.length - 1) {\n    53→      const msPerWord = 60000 / wpm;\n    54→      intervalRef.current = setInterval(() => {\n    55→        setCurrentIndex(i => Math.min(i + 1, words.length - 1));\n    56→      }, msPerWord);\n    57→      return () => {\n    58→        if (intervalRef.current) clearInterval(intervalRef.current);\n    59→      };\n    60→    } else if (currentIndex >= words.length - 1) {\n    61→      pause();\n    62→    }\n    63→  }, [isPlaying, wpm, words.length, currentIndex, pause]);\n    64→\n    65→  useEffect(() => {\n    66→    if (!isActive) {\n    67→      reset();\n    68→    }\n    69→  }, [isActive, reset]);\n    70→\n    71→  useEffect(() => {\n    72→    const handleKeyDown = (e: KeyboardEvent) => {\n    73→      if (!isActive) return;\n    74→      if (e.key === ' ') { e.preventDefault(); isPlaying ? pause() : play(); }\n    75→      if (e.key === 'ArrowLeft') setCurrentIndex(i => Math.max(0, i - 5));\n    76→      if (e.key === 'ArrowRight') setCurrentIndex(i => Math.min(words.length - 1, i + 5));\n    77→      if (e.key === 'Escape') onClose();\n    78→    };\n    79→    window.addEventListener('keydown', handleKeyDown);\n    80→    return () => window.removeEventListener('keydown', handleKeyDown);\n    81→  }, [isActive, isPlaying, play, pause, onClose, words.length]);\n    82→\n    83→  return (\n    84→    <AnimatePresence>\n    85→      {isActive && (\n    86→        <motion.div\n    87→          initial={{ opacity: 0 }}\n    88→          animate={{ opacity: 1 }}\n    89→          exit={{ opacity: 0 }}\n    90→          className={`fixed inset-0 z-50 flex flex-col items-center justify-center ${isRadar ? 'bg-slate-950' : 'bg-stone-100'}`}\n    91→        >\n    92→          {/* Word display */}\n    93→          <div className=\"flex-1 flex items-center justify-center\">\n    94→            <div className={`relative px-16 py-8 rounded-2xl ${isRadar ? 'bg-slate-900/80' : 'bg-white shadow-xl'}`}>\n    95→              {/* Focal point marker */}\n    96→              <div className={`absolute top-0 left-1/2 w-0.5 h-3 -translate-x-1/2 ${isRadar ? 'bg-cyan-400' : 'bg-stone-800'}`} />\n    97→              <div className={`absolute bottom-0 left-1/2 w-0.5 h-3 -translate-x-1/2 ${isRadar ? 'bg-cyan-400' : 'bg-stone-800'}`} />\n    98→\n    99→              {/* Word */}\n   100→              <motion.div\n   101→                key={currentIndex}\n   102→                initial={{ opacity: 0, y: 10 }}\n   103→                animate={{ opacity: 1, y: 0 }}\n   104→                className=\"text-5xl font-mono tracking-wider flex justify-center\"\n   105→              >\n   106→                <span className={styles.textMuted}>{beforeFocal}</span>\n   107→                <span className={isRadar ? 'text-cyan-400' : 'text-rose-600'}>{focal}</span>\n   108→                <span className={styles.text}>{afterFocal}</span>\n   109→              </motion.div>\n   110→            </div>\n   111→          </div>\n   112→\n   113→          {/* Controls */}\n   114→          <div className={`w-full max-w-md p-6 ${isRadar ? 'border-t border-cyan-500/20' : 'border-t border-stone-200'}`}>\n   115→            {/* Progress bar */}\n   116→            <div className={`h-1 rounded-full mb-4 ${isRadar ? 'bg-slate-800' : 'bg-stone-200'}`}>\n   117→              <motion.div\n   118→                className={`h-full rounded-full ${isRadar ? 'bg-cyan-400' : 'bg-stone-800'}`}\n   119→                animate={{ width: `${progress}%` }}\n   120→              />\n   121→            </div>\n   122→\n   123→            {/* Button row */}\n   124→            <div className=\"flex items-center justify-between\">\n   125→              <button onClick={reset} className={`px-4 py-2 rounded-lg text-sm ${isRadar ? 'bg-slate-800 text-slate-300 hover:bg-slate-700' : 'bg-stone-200 text-stone-700 hover:bg-stone-300'}`}>\n   126→                Reset\n   127→              </button>\n   128→\n   129→              <button\n   130→                onClick={isPlaying ? pause : play}\n   131→                className={`px-8 py-3 rounded-xl font-semibold ${isRadar ? 'bg-cyan-500 text-slate-900 hover:bg-cyan-400' : 'bg-stone-800 text-white hover:bg-stone-700'}`}\n   132→              >\n   133→                {isPlaying ? 'Pause' : 'Play'}\n   134→              </button>\n   135→\n   136→              <div className=\"flex items-center gap-2\">\n   137→                <span className={`text-xs ${styles.textMuted}`}>WPM:</span>\n   138→                <input\n   139→                  type=\"range\"\n   140→                  min=\"100\"\n   141→                  max=\"600\"\n   142→                  step=\"50\"\n   143→                  value={wpm}\n   144→                  onChange={(e) => setWpm(Number(e.target.value))}\n   145→                  className=\"w-20\"\n   146→                />\n   147→                <span className={`text-xs font-mono ${styles.text}`}>{wpm}</span>\n   148→              </div>\n   149→            </div>\n   150→\n   151→            {/* Keyboard hints */}\n   152→            <div className={`mt-4 text-center text-[10px] ${styles.textMuted}`}>\n   153→              Space: Play/Pause • ← →: Skip • ESC: Close\n   154→            </div>\n   155→          </div>\n   156→        </motion.div>\n   157→      )}\n   158→    </AnimatePresence>\n   159→  );\n   160→}\n   161→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"bbdddf83-efc9-404e-b6a3-e0a9e67b2ab3","uuid":"4f36c372-6c51-4aeb-9e7a-966285f3307e","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\features\\SpeedReader.tsx","content":"'use client';\n\nimport { useState, useEffect, useCallback, useRef } from 'react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport { useReportTheme, useThemeStyles } from '../core/ThemeContext';\n\ninterface SpeedReaderProps {\n  text: string;\n  isActive: boolean;\n  onClose: () => void;\n  wordsPerMinute?: number;\n}\n\nexport function SpeedReader({ text, isActive, onClose, wordsPerMinute = 300 }: SpeedReaderProps) {\n  const { theme } = useReportTheme();\n  const styles = useThemeStyles();\n  const isRadar = theme === 'radar';\n\n  const words = text.split(/\\s+/).filter(w => w.length > 0);\n  const [currentIndex, setCurrentIndex] = useState(0);\n  const [isPlaying, setIsPlaying] = useState(false);\n  const [wpm, setWpm] = useState(wordsPerMinute);\n  const intervalRef = useRef<NodeJS.Timeout | null>(null);\n\n  const currentWord = words[currentIndex] || '';\n  const progress = words.length > 0 ? (currentIndex / words.length) * 100 : 0;\n\n  // Find the optimal focal point (slightly left of center for English)\n  const focalIndex = Math.floor(currentWord.length * 0.35);\n  const beforeFocal = currentWord.slice(0, focalIndex);\n  const focal = currentWord[focalIndex] || '';\n  const afterFocal = currentWord.slice(focalIndex + 1);\n\n  const play = useCallback(() => {\n    setIsPlaying(true);\n  }, []);\n\n  const pause = useCallback(() => {\n    setIsPlaying(false);\n    if (intervalRef.current) {\n      clearInterval(intervalRef.current);\n      intervalRef.current = null;\n    }\n  }, []);\n\n  const reset = useCallback(() => {\n    pause();\n    setCurrentIndex(0);\n  }, [pause]);\n\n  useEffect(() => {\n    if (isPlaying && currentIndex < words.length - 1) {\n      const msPerWord = 60000 / wpm;\n      intervalRef.current = setInterval(() => {\n        setCurrentIndex(i => Math.min(i + 1, words.length - 1));\n      }, msPerWord);\n      return () => {\n        if (intervalRef.current) clearInterval(intervalRef.current);\n      };\n    } else if (currentIndex >= words.length - 1) {\n      pause();\n    }\n  }, [isPlaying, wpm, words.length, currentIndex, pause]);\n\n  useEffect(() => {\n    if (!isActive) {\n      reset();\n    }\n  }, [isActive, reset]);\n\n  useEffect(() => {\n    const handleKeyDown = (e: KeyboardEvent) => {\n      if (!isActive) return;\n      if (e.key === ' ') { e.preventDefault(); isPlaying ? pause() : play(); }\n      if (e.key === 'ArrowLeft') setCurrentIndex(i => Math.max(0, i - 5));\n      if (e.key === 'ArrowRight') setCurrentIndex(i => Math.min(words.length - 1, i + 5));\n      if (e.key === 'Escape') onClose();\n    };\n    window.addEventListener('keydown', handleKeyDown);\n    return () => window.removeEventListener('keydown', handleKeyDown);\n  }, [isActive, isPlaying, play, pause, onClose, words.length]);\n\n  return (\n    <AnimatePresence>\n      {isActive && (\n        <motion.div\n          initial={{ opacity: 0 }}\n          animate={{ opacity: 1 }}\n          exit={{ opacity: 0 }}\n          className={`fixed inset-0 z-50 flex flex-col items-center justify-center ${isRadar ? 'bg-slate-950' : 'bg-stone-100'}`}\n        >\n          {/* Word display */}\n          <div className=\"flex-1 flex items-center justify-center\">\n            <div className={`relative px-16 py-8 rounded-2xl ${isRadar ? 'bg-slate-900/80' : 'bg-white shadow-xl'}`}>\n              {/* Focal point marker */}\n              <div className={`absolute top-0 left-1/2 w-0.5 h-3 -translate-x-1/2 ${isRadar ? 'bg-cyan-400' : 'bg-stone-800'}`} />\n              <div className={`absolute bottom-0 left-1/2 w-0.5 h-3 -translate-x-1/2 ${isRadar ? 'bg-cyan-400' : 'bg-stone-800'}`} />\n\n              {/* Word */}\n              <motion.div\n                key={currentIndex}\n                initial={{ opacity: 0, y: 10 }}\n                animate={{ opacity: 1, y: 0 }}\n                className=\"text-5xl font-mono tracking-wider flex justify-center\"\n              >\n                <span className={styles.textMuted}>{beforeFocal}</span>\n                <span className={isRadar ? 'text-cyan-400' : 'text-rose-600'}>{focal}</span>\n                <span className={styles.text}>{afterFocal}</span>\n              </motion.div>\n            </div>\n          </div>\n\n          {/* Controls */}\n          <div className={`w-full max-w-md p-6 ${isRadar ? 'border-t border-cyan-500/20' : 'border-t border-stone-200'}`}>\n            {/* Progress bar */}\n            <div className={`h-1 rounded-full mb-4 ${isRadar ? 'bg-slate-800' : 'bg-stone-200'}`}>\n              <motion.div\n                className={`h-full rounded-full ${isRadar ? 'bg-cyan-400' : 'bg-stone-800'}`}\n                animate={{ width: `${progress}%` }}\n              />\n            </div>\n\n            {/* Button row */}\n            <div className=\"flex items-center justify-between\">\n              <button onClick={reset} className={`px-4 py-2 rounded-lg text-sm ${isRadar ? 'bg-slate-800 text-slate-300 hover:bg-slate-700' : 'bg-stone-200 text-stone-700 hover:bg-stone-300'}`}>\n                Reset\n              </button>\n\n              <button\n                onClick={isPlaying ? pause : play}\n                className={`px-8 py-3 rounded-xl font-semibold ${isRadar ? 'bg-cyan-500 text-slate-900 hover:bg-cyan-400' : 'bg-stone-800 text-white hover:bg-stone-700'}`}\n              >\n                {isPlaying ? 'Pause' : 'Play'}\n              </button>\n\n              <div className=\"flex items-center gap-2\">\n                <span className={`text-xs ${styles.textMuted}`}>WPM:</span>\n                <input\n                  type=\"range\"\n                  min=\"100\"\n                  max=\"600\"\n                  step=\"50\"\n                  value={wpm}\n                  onChange={(e) => setWpm(Number(e.target.value))}\n                  className=\"w-20\"\n                />\n                <span className={`text-xs font-mono ${styles.text}`}>{wpm}</span>\n              </div>\n            </div>\n\n            {/* Keyboard hints */}\n            <div className={`mt-4 text-center text-[10px] ${styles.textMuted}`}>\n              Space: Play/Pause • ← →: Skip • ESC: Close\n            </div>\n          </div>\n        </motion.div>\n      )}\n    </AnimatePresence>\n  );\n}\n","numLines":161,"startLine":1,"totalLines":161}}}
