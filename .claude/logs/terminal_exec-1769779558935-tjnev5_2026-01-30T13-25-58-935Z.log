     if (e.key === ' ') { e.preventDefault(); isPlaying ? pause() : play(); }\n      if (e.key === 'ArrowLeft') setCurrentIndex(i => Math.max(0, i - 5));\n      if (e.key === 'ArrowRight') setCurrentIndex(i => Math.min(words.length - 1, i + 5));\n      if (e.key === 'Escape') onClose();\n    };\n    window.addEventListener('keydown', handleKeyDown);\n    return () => window.removeEventListener('keydown', handleKeyDown);\n  }, [isActive, isPlaying, play, pause, onClose, words.length]);\n\n  return (\n    <AnimatePresence>\n      {isActive && (\n        <motion.div\n          initial={{ opacity: 0 }}\n          animate={{ opacity: 1 }}\n          exit={{ opacity: 0 }}\n          className={`fixed inset-0 z-50 flex flex-col items-center justify-center ${isRadar ? 'bg-slate-950' : 'bg-stone-100'}`}\n        >\n          {/* Word display */}\n          <div className=\"flex-1 flex items-center justify-center\">\n            <div className={`relative px-16 py-8 rounded-2xl ${isRadar ? 'bg-slate-900/80' : 'bg-white shadow-xl'}`}>\n              {/* Focal point marker */}\n              <div className={`absolute top-0 left-1/2 w-0.5 h-3 -translate-x-1/2 ${isRadar ? 'bg-cyan-400' : 'bg-stone-800'}`} />\n              <div className={`absolute bottom-0 left-1/2 w-0.5 h-3 -translate-x-1/2 ${isRadar ? 'bg-cyan-400' : 'bg-stone-800'}`} />\n\n              {/* Word */}\n              <motion.div\n                key={currentIndex}\n                initial={{ opacity: 0, y: 10 }}\n                animate={{ opacity: 1, y: 0 }}\n                className=\"text-5xl font-mono tracking-wider flex justify-center\"\n              >\n                <span className={styles.textMuted}>{beforeFocal}</span>\n                <span className={isRadar ? 'text-cyan-400' : 'text-rose-600'}>{focal}</span>\n                <span className={styles.text}>{afterFocal}</span>\n              </motion.div>\n            </div>\n          </div>\n\n          {/* Controls */}\n          <div className={`w-full max-w-md p-6 ${isRadar ? 'border-t border-cyan-500/20' : 'border-t border-stone-200'}`}>\n            {/* Progress bar */}\n            <div className={`h-1 rounded-full mb-4 ${isRadar ? 'bg-slate-800' : 'bg-stone-200'}`}>\n              <motion.div\n                className={`h-full rounded-full ${isRadar ? 'bg-cyan-400' : 'bg-stone-800'}`}\n                animate={{ width: `${progress}%` }}\n              />\n            </div>\n\n            {/* Button row */}\n            <div className=\"flex items-center justify-between\">\n              <button onClick={reset} className={`px-4 py-2 rounded-lg text-sm ${isRadar ? 'bg-slate-800 text-slate-300 hover:bg-slate-700' : 'bg-stone-200 text-stone-700 hover:bg-stone-300'}`}>\n                Reset\n              </button>\n\n              <button\n                onClick={isPlaying ? pause : play}\n                className={`px-8 py-3 rounded-xl font-semibold ${isRadar ? 'bg-cyan-500 text-slate-900 hover:bg-cyan-400' : 'bg-stone-800 text-white hover:bg-stone-700'}`}\n              >\n                {isPlaying ? 'Pause' : 'Play'}\n              </button>\n\n              <div className=\"flex items-center gap-2\">\n                <span className={`text-xs ${styles.textMuted}`}>WPM:</span>\n                <input\n                  type=\"range\"\n                  min=\"100\"\n                  max=\"600\"\n                  step=\"50\"\n                  value={wpm}\n                  onChange={(e) => setWpm(Number(e.target.value))}\n                  className=\"w-20\"\n                />\n                <span className={`text-xs font-mono ${styles.text}`}>{wpm}</span>\n              </div>\n            </div>\n\n            {/* Keyboard hints */}\n            <div className={`mt-4 text-center text-[10px] ${styles.textMuted}`}>\n              Space: Play/Pause • ← →: Skip • ESC: Close\n            </div>\n          </div>\n        </motion.div>\n      )}\n    </AnimatePresence>\n  );\n}\n","structuredPatch"