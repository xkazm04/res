-1.5 py-0.5 bg-slate-100 border border-slate-200 rounded text-[9px] font-mono\">j</kbd>\n          <kbd className=\"px-1.5 py-0.5 bg-slate-100 border border-slate-200 rounded text-[9px] font-mono\">k</kbd>\n          <span>navigate</span>\n          <kbd className=\"px-1.5 py-0.5 bg-slate-100 border border-slate-200 rounded text-[9px] font-mono\">Enter</kbd>\n          <span>expand</span>\n        </div>\n      )}\n    </Section>\n  );\n}\n\ninterface FindingCardProps {\n  finding: ResearchFinding;\n  sourceMap: Map<string, ResearchSource>;\n  isFocused: boolean;\n  isExpanded: boolean;\n  onToggleExpanded: () => void;\n  onFocus: () => void;\n}\n\nconst FindingCard = forwardRef<HTMLDivElement, FindingCardProps>(function FindingCard(\n  { finding, sourceMap, isFocused, isExpanded, onToggleExpanded, onFocus },\n  ref\n) {\n  const supportingSources = finding.supporting_sources || [];\n  const confidence = finding.confidence_score || 0;\n\n  // Get summary (first sentence or first 120 chars)\n  const summary = finding.content.split('.')[0] + '.';\n\n  return (\n    <div\n      ref={ref}\n      className={`border rounded-lg overflow-hidden bg-white transition-all ${\n        isFocused\n          ? 'border-blue-400 ring-2 ring-blue-100 shadow-sm'\n          : 'border-slate-200'\n      }`}\n      onClick={onFocus}\n    >\n      {/* Header - always visible */}\n      <div\n        className={`flex items-center gap-3 px-4 py-3 cursor-pointer transition-colors ${\n          isFocused ? 'bg-blue-50/50 hover:bg-blue-50' : 'bg-slate-50/50 hover:bg-slate-50'\n        }`}\n        onClick={onToggleExpanded}\n      >\n        <span className={`w-5 h-5 transition-transform ${isFocused ? 'text-blue-500' : 'text-slate-400'} ${isExpanded ? 'rotate-90' : ''}`}>\n          <ChevronRightIcon />\n        </span>\n        <TypeBadge type={finding.finding_type} />\n        <span className=\"flex-1 text-sm text-slate-700 line-clamp-1\">{summary}</span>\n        <ConfidenceBadge score={confidence} />\n      </div>\n\n      {/* Body - expandable */}\n      {isExpanded && (\n        <div className=\"px-4 py-3 border-t border-slate-100\">\n          {/* Full content */}\n          <p className=\"text-sm text-slate-700 leading-relaxed mb-3\">{finding.content}</p>\n\n          {/* Meta row */}\n          <div className=\"flex flex-wrap items-center gap-3 text-xs text-slate-500 mb-3\">\n            {finding.temporal_context && (\n              <span className=\"flex items-center gap-1\">\n                <span className=\"w-3.5 h-3.5\"><ClockIcon /></span>\n                {finding.temporal_context}\n                {finding.event_date && ` • ${new Date(finding.event_date).toLocaleDateString()}`}\n              </span>\n            )}\n            <span className=\"flex items-center gap-1\">\n              Confidence:\n              <span className=\"w-16\"><ProgressBar value={confidence * 100} size=\"sm\" /></span>\n            </span>\n          </div>\n\n          {/* Extracted Data */}\n          {finding.extracted_data && Object.keys(finding.extracted_data).length > 0 && (\n            <div className=\"bg-indigo-50 border border-indigo-100 rounded-md p-3 mb-3\">\n              <div className=\"text-[10px] font-semibold text-indigo-600 uppercase mb-2\">\n                Extracted Data\n              </div>\n              <div className=\"grid grid-cols-2 md:grid-cols-3 gap-2\">\n                {Object.entries(finding.extracted_data).slice(0, 6).map(([key, value]) => (\n                  <div key={key} className=\"text-xs\">\n                    <span className=\"text-slate-500\">{key}: </span>\n                    <span className=\"text-slate-700 font-medium\">\n                      {typeof value === 'object' ? JSON.stringify(value) : String(value)}\n                    </span>\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n\n          {/* Supporting Sources */}\n          {supportingSources.length > 0 && (\n            <div className=\"bg-slate-50 rounded-md p-3 border-l-3 border-blue-400\">\n              <div className=\"text-[10px] font-semibold text-blue-600 uppercase mb-2 flex items-center gap-1\">\n                <span className=\"w-3 h-3\"><LinkIcon /></span>\n                Sources ({supportingSources.length})\n              </div>\n              <div className=\"space-y-1\">\n                {supportingSources.slice(0, 3).map((sourceId) => {\n                  const source = sourceMap.get(sourceId);\n                  if (!source) return null;\n                  return (\n                    <a\n                      key={sourceId}\n                      href={source.url}\n                      target=\"_blank\"\n                      rel=\"noopener noreferrer\"\n                      className=\"block text-xs text-blue-600 hover:underline truncate\"\n                    >\n                      {source.title || source.domain || source.url}\n                      {source.credibility_score && (\n                        <span className=\"text-slate-400 ml-1\">\n                          ({Math.round(source.credibility_score * 100)}% cred)\n                        </span>\n                      )}\n                    </a>\n                  );\n                })}\n              </div>\n            </div>\n          )}\n        </div>\n      )}\n    </div>\n  );\n});\n","structuredPatch":[{"oldStart":136,"oldLines":7,"newStart":136,"newLines":7,"lines":["   }"," ","   return (","-    <Section title=\"Findings\" count={filteredFindings.length}>","+    <ThemedSection title=\"Findings\" count={filteredFindings.length}>","       <div ref={containerRef} className=\"space-y-2\" tabIndex={-1}>","         {filteredFindings.map((finding, index) => (","           <FindingCard"]}],"userModified":false,"replaceAll":true}}
