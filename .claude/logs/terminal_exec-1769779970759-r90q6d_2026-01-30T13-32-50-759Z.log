>\n          <div className=\"space-y-3\">\n            {gaps.map((g) => (\n              <GapCard key={g.id} gap={g} />\n            ))}\n          </div>\n        </Section>\n      )}\n\n      {/* Causal Chains */}\n      {causalChains.length > 0 && (\n        <Section title=\"Causal Chains\" count={causalChains.length} collapsible defaultExpanded>\n          <div className=\"space-y-3\">\n            {causalChains.map((chain) => (\n              <CausalChainCard key={chain.id} chain={chain} />\n            ))}\n          </div>\n        </Section>\n      )}\n    </div>\n  );\n}\n\nfunction ContradictionCard({ contradiction }: { contradiction: ResearchContradiction }) {\n  return (\n    <div className=\"p-4 bg-red-50 border border-red-200 rounded-lg\">\n      <div className=\"flex items-center gap-2 mb-2\">\n        <span className=\"w-4 h-4 text-red-600\"><AlertIcon /></span>\n        <span className=\"text-xs font-semibold text-red-700 uppercase\">Contradiction</span>\n        {contradiction.significance && (\n          <span className=\"text-[10px] px-1.5 py-0.5 bg-red-100 text-red-700 rounded\">\n            {contradiction.significance}\n          </span>\n        )}\n      </div>\n\n      {/* Conflicting claims */}\n      <div className=\"space-y-2 mb-3\">\n        <div className=\"p-2 bg-white rounded border border-red-100\">\n          <div className=\"text-[10px] text-red-500 mb-1\">Claim A</div>\n          <p className=\"text-sm text-slate-700\">{contradiction.claim_1}</p>\n          {contradiction.source_1 && (\n            <p className=\"text-[10px] text-slate-500 mt-1\">Source: {contradiction.source_1}</p>\n          )}\n        </div>\n        <div className=\"flex justify-center\">\n          <span className=\"text-xs text-red-400\">VS</span>\n        </div>\n        <div className=\"p-2 bg-white rounded border border-red-100\">\n          <div className=\"text-[10px] text-red-500 mb-1\">Claim B</div>\n          <p className=\"text-sm text-slate-700\">{contradiction.claim_2}</p>\n          {contradiction.source_2 && (\n            <p className=\"text-[10px] text-slate-500 mt-1\">Source: {contradiction.source_2}</p>\n          )}\n        </div>\n      </div>\n\n      {/* Resolution hint */}\n      {contradiction.resolution_hint && (\n        <div className=\"text-xs text-slate-600 bg-white p-2 rounded border border-slate-100\">\n          <span className=\"font-medium\">Resolution hint:</span> {contradiction.resolution_hint}\n        </div>\n      )}\n    </div>\n  );\n}\n\nfunction GapCard({ gap }: { gap: ResearchGap }) {\n  const suggestedQueries = gap.suggested_queries || [];\n\n  return (\n    <div className=\"p-4 bg-violet-50 border border-violet-200 rounded-lg\">\n      <div className=\"flex items-center justify-between mb-2\">\n        <div className=\"flex items-center gap-2\">\n          <span className=\"w-4 h-4 text-violet-600\"><TargetIcon /></span>\n          <span className=\"text-xs font-semibold text-violet-700 uppercase\">{gap.gap_type} Gap</span>\n        </div>\n        <PriorityBadge priority={gap.priority} />\n      </div>\n\n      <p className=\"text-sm text-slate-700 mb-3\">{gap.description}</p>\n\n      {suggestedQueries.length > 0 && (\n        <div className=\"bg-white p-2 rounded border border-violet-100\">\n          <div className=\"text-[10px] text-violet-600 font-medium mb-1\">Suggested Queries</div>\n          <ul className=\"space-y-1\">\n            {suggestedQueries.slice(0, 3).map((query, i) => (\n              <li key={i} className=\"text-xs text-slate-600 flex items-center gap-1\">\n                <span className=\"w-3 h-3 text-violet-400\"><ArrowRightIcon /></span>\n                {query}\n              </li>\n            ))}\n          </ul>\n        </div>\n      )}\n    </div>\n  );\n}\n\nfunction CausalChainCard({ chain }: { chain: CausalChain }) {\n  const descriptions = chain.descriptions || [];\n\n  return (\n    <div className=\"p-4 bg-blue-50 border border-blue-200 rounded-lg\">\n      <div className=\"flex items-center gap-2 mb-3\">\n        <span className=\"text-xs font-semibold text-blue-700 uppercase\">Causal Chain</span>\n        <span className=\"text-[10px] text-blue-500\">\n          {descriptions.length} step{descriptions.length !== 1 ? 's' : ''}\n        </span>\n      </div>\n\n      {/* Chain visualization with continuous connector line */}\n      <div className=\"relative\">\n        {/* Continuous connecting line */}\n        {descriptions.length > 1 && (\n          <div className=\"absolute top-1/2 left-0 right-0 h-0.5 bg-blue-300 -translate-y-1/2\" />\n        )}\n\n        {/* Steps floating above the line */}\n        <div className=\"relative z-10 flex flex-wrap items-center gap-4\">\n          {descriptions.map((desc, i) => (\n            <div key={i} className=\"flex items-center gap-4\">\n              {/* Node circle */}\n              <div className=\"flex flex-col items-center gap-1\">\n                <div className=\"w-2 h-2 rounded-full bg-blue-500 ring-2 ring-blue-100\" />\n                <div className=\"px-2 py-1 bg-white rounded border border-blue-200 text-xs text-slate-700 shadow-sm\">\n                  {desc}\n                </div>\n              </div>\n\n              {/* Connector line segment between nodes (visual flow indicator) */}\n              {i < descriptions.length - 1 && (\n                <div className=\"flex items-center\">\n                  <div className=\"w-6 h-0.5 bg-blue-300\" />\n                  <div className=\"w-0 h-0 border-t-[4px] border-t-transparent border-b-[4px] border-b-transparent border-l-[6px] border-l-blue-400\" />\n                </div>\n              )}\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n}\n","structuredPatch":[{"oldStart":1,"oldLines":7,"newStart":1,"newLines":7,"lines":[" 'use client';"," "," import type { ResearchContradiction, ResearchGap, CausalChain } from '@/src/types/research';","-import {