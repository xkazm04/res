ion-500 ${colorClass[getColor()]}`}\n    54→          style={{ width: `${percent}%` }}\n    55→        />\n    56→      </div>\n    57→      {showLabel && (\n    58→        <span className=\"text-[10px] font-medium text-slate-600 w-8 text-right\" aria-hidden=\"true\">\n    59→          {Math.round(percent)}%\n    60→        </span>\n    61→      )}\n    62→    </div>\n    63→  );\n    64→}\n    65→\n    66→interface MiniChartProps {\n    67→  data: number[];\n    68→  color?: 'blue' | 'emerald' | 'amber' | 'auto';\n    69→  height?: number;\n    70→}\n    71→\n    72→export function MiniChart({ data, color = 'blue', height = 20 }: MiniChartProps) {\n    73→  const max = Math.max(...data, 1);\n    74→\n    75→  const getBarColor = (value: number) => {\n    76→    if (color !== 'auto') {\n    77→      const colors = {\n    78→        blue: 'bg-blue-500',\n    79→        emerald: 'bg-emerald-500',\n    80→        amber: 'bg-amber-500',\n    81→      };\n    82→      return colors[color];\n    83→    }\n    84→    const percent = (value / max) * 100;\n    85→    if (percent >= 80) return 'bg-emerald-500';\n    86→    if (percent >= 50) return 'bg-amber-500';\n    87→    return 'bg-red-500';\n    88→  };\n    89→\n    90→  return (\n    91→    <div className=\"flex gap-0.5 items-end\" style={{ height }}>\n    92→      {data.map((value, i) => (\n    93→        <div\n    94→          key={i}\n    95→          className={`flex-1 rounded-t-sm transition-all ${getBarColor(value)}`}\n    96→          style={{ height: `${(value / max) * 100}%`, minWidth: 3 }}\n    97→        />\n    98→      ))}\n    99→    </div>\n   100→  );\n   101→}\n   102→\n   103→interface ConfidenceDistributionProps {\n   104→  high: number;\n   105→  medium: number;\n   106→  low: number;\n   107→}\n   108→\n   109→export function ConfidenceDistribution({ high, medium, low }: ConfidenceDistributionProps) {\n   110→  const total = high + medium + low || 1;\n   111→\n   112→  return (\n   113→    <div className=\"flex h-1.5 rounded-full overflow-hidden bg-slate-200\">\n   114→      <div\n   115→        className=\"bg-emerald-500 transition-all\"\n   116→        style={{ width: `${(high / total) * 100}%` }}\n   117→      />\n   118→      <div\n   119→        className=\"bg-amber-500 transition-all\"\n   120→        style={{ width: `${(medium / total) * 100}%` }}\n   121→      />\n   122→      <div\n   123→        className=\"bg-red-500 transition-all\"\n   124→        style={{ width: `${(low / total) * 100}%` }}\n   125→      />\n   126→    </div>\n   127→  );\n   128→}\n   129→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"bbdddf83-efc9-404e-b6a3-e0a9e67b2ab3","uuid":"5dc60fe4-d567-4fa6-8ac0-ea86ca26414f","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\shared\\ProgressBar.tsx","content":"'use client';\n\ninterface ProgressBarProps {\n  value: number;\n  max?: number;\n  color?: 'blue' | 'emerald' | 'amber' | 'red' | 'auto';\n  size?: 'sm' | 'md';\n  showLabel?: boolean;\n  /** Accessible label describing what this progress bar represents */\n  'aria-label'?: string;\n}\n\nexport function ProgressBar({\n  value,\n  max = 100,\n  color = 'auto',\n  size = 'md',\n  showLabel = false,\n  'aria-label': ariaLabel,\n}: ProgressBarProps) {\n  const percent = Math.min(100, Math.max(0, (value / max) * 100));\n\n  const getColor = () => {\n    if (color !== 'auto') return color;\n    if (percent >= 80) return 'emerald';\n    if (percent >= 50) return 'amber';\n    return 'red';\n  };\n\n  const colorClass = {\n    blue: 'bg-gradient-to-r from-blue-500 to-blue-600',\n    emerald: 'bg-gradient-to-r from-emerald-500 to-emerald-600',\n    amber: 'bg-gradient-to-r from-amber-500 to-amber-600',\n    red: 'bg-gradient-to-r from-red-500 to-red-600',\n  };\n\n  const sizeClass = {\n    sm: 'h-1',\n    md: 'h-1.5',\n  };\n\n  return (\n    <div className=\"flex items-center gap-2\">\n      <div\n        className={`flex-1 bg-slate-200 rounded-full overflow-hidden ${sizeClass[size]}`}\n        role=\"progressbar\"\n        aria-valuenow={Math.round(percent)}\n        aria-valuemin={0}\n        aria-valuemax={100}\n        aria-label={ariaLabel || 'Progress'}\n      >\n        <div\n          className={`h-full rounded-full transition-all duration-500 ${colorClass[getColor()]}`}\n          style={{ width: `${percent}%` }}\n        />\n      </div>\n      {showLabel && (\n        <span className=\"text-[10px] font-medium text-slate-600 w-8 text-right\" aria-hidden=\"true\">\n          {Math.round(percent)}%\n        </span>\n      )}\n    </div>\n  );\n}\n\ninterface MiniChartProps {\n  data: number[];\n  color?: 'blue' | 'emerald' | 'amber' | 'auto';\n  height?: number;\n}\n\nexport function MiniChart({ data, color = 'blue', height = 20 }: MiniChartProps) {\n  const max = Math.max(...data, 1);\n\n  const getBarColor = (value: number) => {\n    if (color !== 'auto') {\n      const colors = {\n        blue: 'bg-blue-500',\n        emerald: 'bg-emerald-500',\n        amber: 'bg-amber-500',\n      };\n      return colors[color];\n    }\n    const percent = (value / max) * 100;\n    if (percent >= 80) return 'bg-emerald-500';\n    if (percent >= 50) return 'bg-amber-500';\n    return 'bg-red-500';\n  };\n\n  return (\n    <div className=\"flex gap-0.5 items-end\" style={{ height }}>\n      {data.map((value, i) => (\n        <div\n          key={i}\n          className={`flex-1 rounded-t-sm transition-all ${getBarColor(value)}`}\n          style={{ height: `${(value / max) * 100}%`, minWidth: 3 }}\n        />\n      ))}\n    </div>\n  );\n}\n\ninterface ConfidenceDistributionProps {\n  high: number;\n  medium: number;\n  low: number;\n}\n\nexport function ConfidenceDistribution({ high, medium, low }: ConfidenceDistributionProps) {\n  const total = high + medium + low || 1;\n\n  return (\n    <div className=\"flex h-1.5 rounded-full overflow-hidden bg-slate-200\">\n      <div\n        className=\"bg-emerald-500 transition-all\"\n        style={{ width: `${(high / total) * 100}%` }}\n      />\n      <div\n        className=\"bg-amber-500 transition-all\"\n        style={{ width: `${(medium / total) * 100}%` }}\n      />\n      <div\n        className=\"bg-red-500 transition-all\"\n        style={{ width: `${(low / total) * 100}%` }}\n      />\n    </div>\n  );\n}\n","numLines":129,"startLine":1,"totalLines":129}}}
