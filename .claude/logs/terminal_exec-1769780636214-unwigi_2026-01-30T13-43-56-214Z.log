[2026-01-30T13:44:08.418Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GpzKnY7tX6PFuyvqdaGs6z","type":"tool_result","content":"     1→'use client';\n     2→\n     3→import type { SessionWithDetails } from '@/src/types/research';\n     4→import { QuickStatCard, AlertBanner } from '../shared/Cards';\n     5→import { ThemedSection } from '../ThemedCards';\n     6→import { ProgressBar, ConfidenceDistribution } from '../shared/ProgressBar';\n     7→import { DocumentIcon, LinkIcon, UsersIcon, AlertIcon, TargetIcon, CheckCircleIcon } from '../shared/Icons';\n     8→\n     9→interface OverviewTabProps {\n    10→  session: SessionWithDetails;\n    11→  stats: {\n    12→    findings: number;\n    13→    sources: number;\n    14→    perspectives: number;\n    15→    contradictions: number;\n    16→    gaps: number;\n    17→    avgConfidence: number;\n    18→    highConfidence: number;\n    19→    redFlags: number;\n    20→    highCredSources: number;\n    21→    entities: number;\n    22→  };\n    23→}\n    24→\n    25→export function OverviewTab({ session, stats }: OverviewTabProps) {\n    26→  const findings = session.findings || [];\n    27→  const allInsights = session.perspectives?.flatMap(p => p.key_insights || []) || [];\n    28→  const allWarnings = session.perspectives?.flatMap(p => p.warnings || []) || [];\n    29→  const allRecommendations = session.perspectives?.flatMap(p => p.recommendations || []) || [];\n    30→\n    31→  // Calculate confidence distribution\n    32→  const highConf = findings.filter(f => (f.confidence_score || 0) >= 0.8).length;\n    33→  const medConf = findings.filter(f => {\n    34→    const c = f.confidence_score || 0;\n    35→    return c >= 0.5 && c < 0.8;\n    36→  }).length;\n    37→  const lowConf = findings.filter(f => (f.confidence_score || 0) < 0.5).length;\n    38→\n    39→  return (\n    40→    <div className=\"space-y-4\">\n    41→      {/* Stats Grid */}\n    42→      <div className=\"grid grid-cols-2 md:grid-cols-5 gap-3\">\n    43→        <StatCard\n    44→          label=\"Findings\"\n    45→          value={stats.findings}\n    46→          subtext={`${stats.highConfidence} high confidence`}\n    47→          icon={<DocumentIcon />}\n    48→          color=\"blue\"\n    49→        >\n    50→          <ConfidenceDistribution high={highConf} medium={medConf} low={lowConf} />\n    51→        </StatCard>\n    52→        <StatCard\n    53→          label=\"Avg Confidence\"\n    54→          value={`${stats.avgConfidence}%`}\n    55→          icon={<TargetIcon />}\n    56→          color={stats.avgConfidence >= 80 ? 'emerald' : stats.avgConfidence >= 50 ? 'amber' : 'red'}\n    57→        >\n    58→          <ProgressBar value={stats.avgConfidence} color=\"auto\" size=\"sm\" />\n    59→        </StatCard>\n    60→        <StatCard\n    61→          label=\"Sources\"\n    62→          value={stats.sources}\n    63→          subtext={`${stats.highCredSources} high credibility`}\n    64→          icon={<LinkIcon />}\n    65→          color=\"emerald\"\n    66→        />\n    67→        <StatCard\n    68→          label=\"Perspectives\"\n    69→          value={stats.perspectives}\n    70→          icon={<UsersIcon />}\n    71→          color=\"slate\"\n    72→        />\n    73→        <StatCard\n    74→          label=\"Red Flags\"\n    75→          value={stats.redFlags}\n    76→          subtext={stats.redFlags > 0 ? 'Review needed' : 'Clear'}\n    77→          icon={<AlertIcon />}\n    78→          color={stats.redFlags > 0 ? 'red' : 'slate'}\n    79→        />\n    80→      </div>\n    81→\n    82→      {/* Warnings Banner */}\n    83→      {allWarnings.length > 0 && (\n    84→        <div className=\"bg-gradient-to-br from-amber-50 to-orange-50 border border-amber-200 rounded-lg p-4\">\n    85→          <div className=\"flex items-center gap-2 text-amber-700 font-semibold text-sm mb-2\">\n    86→            <span className=\"w-4 h-4\"><AlertIcon /></span>\n    87→            Warnings ({allWarnings.length})\n    88→          </div>\n    89→          <ul className=\"space-y-1\">\n    90→            {allWarnings.slice(0, 4).map((w, i) => (\n    91→              <li key={i} className=\"text-sm text-amber-800 pl-6 relative before:content-['•'] before:absolute before:left-2 before:text-amber-400\">\n    92→                {w}\n    93→              </li>\n    94→            ))}\n    95→          </ul>\n    96→        </div>\n    97→      )}\n    98→\n    99→      {/* Key Insights */}\n   100→      {allInsights.length > 0 && (\n   101→        <ThemedSection title=\"Key Insights\" count={allInsights.length}>\n   102→          <ul className=\"space-y-2\">\n   103→            {allInsights.slice(0, 6).map((insight, i) => (\n   104→              <li key={i} className=\"flex items-start gap-2 text-sm text-slate-700 pl-3 border-l-2 border-emerald-400 py-1\">\n   105→                {insight}\n   106→              </li>\n   107→            ))}\n   108→          </ul>\n   109→        </ThemedSection>\n   110→      )}\n   111→\n   112→      {/* Recommendations */}\n   113→      {allRecommendations.length > 0 && (\n   114→        <ThemedSection title=\"Recommended Actions\" count={allRecommendations.length}>\n   115→          <div className=\"space-y-2\">\n   116→            {allRecommendations.slice(0, 5).map((rec, i) => (\n   117→              <div key={i} className=\"flex items-start gap-3 p-2 bg-blue-50 rounded-lg\">\n   118→                <span className=\"w-5 h-5 bg-blue-500 text-white rounded-full flex items-center justify-center text-[10px] font-bold flex-shrink-0 mt-0.5\">\n   119→                  {i + 1}\n   120→                </span>\n   121→                <span className=\"text-sm text-slate-700\">{rec}</span>\n   122→              </div>\n   123→            ))}\n   124→          </div>\n   125→        </ThemedSection>\n   126→      )}\n   127→\n   128→      {/* Gaps */}\n   129→      {stats.gaps > 0 && (\n   130→        <ThemedSection title=\"Research Gaps\" count={stats.gaps}>\n   131→          <div className=\"space-y-2\">\n   132→            {session.gaps?.slice(0, 3).map((gap, i) => (\n   133→              <div key={i} className=\"p-3 bg-violet-50 border-l-3 border-violet-500 rounded-r-lg\">\n   134→                <div className=\"flex items-center gap-2 mb-1\">\n   135→                  <span className=\"text-[10px] font-semibold text-violet-600 uppercase px-1.5 py-0.5 bg-violet-100 rounded\">\n   136→                    {gap.gap_type}\n   137→                  </span>\n   138→                  <span className=\"text-[10px] text-violet-500\">{gap.priority} priority</span>\n   139→                </div>\n   140→                <p className=\"text-sm text-slate-700\">{gap.description}</p>\n   141→              </div>\n   142→            ))}\n   143→          </div>\n   144→        </ThemedSection>\n   145→      )}\n   146→    </div>\n   147→  );\n   148→}\n   149→\n   150→function StatCard({\n   151→  label,\n   152→  value,\n   153→  subtext,\n   154→  icon,\n   155→  color,\n   156→  children,\n   157→}: {\n   158→  label: string;\n   159→  value: string | number;\n   160→  subtext?: string;\n   161→  icon: React.ReactNode;\n   162→  color: 'blue' | 'emerald' | 'amber' | 'red' | 'slate';\n   163→  children?: React.ReactNode;\n   164→}) {\n   165→  const colors = {\n   166→    blue: 'text-blue-600',\n   167→    emerald: 'text-emerald-600',\n   168→    amber: 'text-amber-600',\n   169→    red: 'text-red-600',\n   170→    slate: 'text-slate-600',\n   171→  };\n   172→\n   173→  return (\n   174→    <div className=\"bg-white rounded-lg border border-slate-200 p-3 shadow-sm\">\n   175→      <div className=\"flex items-center justify-between mb-1\">\n   176→        <span className={`w-4 h-4 ${colors[color]}`}>{icon}</span>\n   177→        <span className=\"text-[9px] uppercase tracking-wider text-slate-400\">{label}</span>\n   178→      </div>\n   179→      <div className={`text-2xl font-bold ${colors[color]}`}>{value}</div>\n   180→      {subtext && <div className=\"text-[10px] text-slate-400 mt-0.5\">{subtext}</div>}\n   181→      {children && <div className=\"mt-2\">{children}</div>}\n   182→    </div>\n   183→  );\n   184→}\n   185→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"bbdddf83-efc9-404e-b6a3-e0a9e67b2ab3","uuid":"e681314f-3c5c-4013-9c4c-458c9961da39","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\tabs\\OverviewTab.tsx","content":"'use client';\n\nimport type { SessionWithDetails } from '@/src/types/research';\nimport { QuickStatCard, AlertBanner } from '../shared/Cards';\nimport { ThemedSection } from '../ThemedCards';\nimport { ProgressBar, ConfidenceDistribution } from '../shared/ProgressBar';\nimport { DocumentIcon, LinkIcon, UsersIcon, AlertIcon, TargetIcon, CheckCircleIcon } from '../shared/Icons';\n\ninterface OverviewTabProps {\n  session: SessionWithDetails;\n  stats: {\n    findings: number;\n    sources: number;\n    perspectives: number;\n    contradictions: number;\n    gaps: number;\n    avgConfidence: number;\n    highConfidence: number;\n    redFlags: number;\n    highCredSources: number;\n    entities: number;\n  };\n}\n\nexport function OverviewTab({ session, stats }: OverviewTabProps) {\n  const findings = session.findings || [];\n  const allInsights = session.perspectives?.flatMap(p => p.key_insights || []) || [];\n  const allWarnings = session.perspectives?.flatMap(p => p.warnings || []) || [];\n  const allRecommendations = session.perspectives?.flatMap(p => p.recommendations || []) || [];\n\n  // Calculate confidence distribution\n  const highConf = findings.filter(f => (f.confidence_score || 0) >= 0.8).length;\n  const medConf = findings.filter(f => {\n    const c = f.confidence_score || 0;\n    return c >= 0.5 && c < 0.8;\n  }).length;\n  const lowConf = findings.filter(f => (f.confidence_score || 0) < 0.5).length;\n\n  return (\n    <div className=\"space-y-4\">\n      {/* Stats Grid */}\n      <div className=\"grid grid-cols-2 md:grid-cols-5 gap-3\">\n        <StatCard\n          label=\"Findings\"\n          value={stats.findings}\n          subtext={`${stats.highConfidence} high confidence`}\n          icon={<DocumentIcon />}\n          color=\"blue\"\n        >\n          <ConfidenceDistribution high={highConf} medium={medConf} low={lowConf} />\n        </StatCard>\n        <StatCard\n          label=\"Avg Confidence\"\n          value={`${stats.avgConfidence}%`}\n          icon={<TargetIcon />}\n          color={stats.avgConfidence >= 80 ? 'emerald' : stats.avgConfidence >= 50 ? 'amber' : 'red'}\n        >\n          <ProgressBar value={stats.avgConfidence} color=\"auto\" size=\"sm\" />\n        </StatCard>\n        <StatCard\n          label=\"Sources\"\n          value={stats.sources}\n          subtext={`${stats.highCredSources} high credibility`}\n          icon={<LinkIcon />}\n          color=\"emerald\"\n        />\n        <StatCard\n          label=\"Perspectives\"\n          value={stats.perspectives}\n          icon={<UsersIcon />}\n          color=\"slate\"\n        />\n        <StatCard\n          label=\"Red Flags\"\n          value={stats.redFlags}\n          subtext={stats.redFlags > 0 ? 'Review needed' : 'Clear'}\n          icon={<AlertIcon />}\n          color={stats.redFlags > 0 ? 'red' : 'slate'}\n        />\n      </div>\n\n      {/* Warnings Banner */}\n      {allWarnings.length > 0 && (\n        <div className=\"bg-gradient-to-br from-amber-50 to-orange-50 border border-amber-200 rounded-lg p-4\">\n          <div className=\"flex items-center gap-2 text-amber-700 font-semibold text-sm mb-2\">\n            <span className=\"w-4 h-4\"><AlertIcon /></span>\n            Warnings ({allWarnings.length})\n          </div>\n          <ul className=\"space-y-1\">\n            {allWarnings.slice(0, 4).map((w, i) => (\n              <li key={i} className=\"text-sm text-amber-800 pl-6 relative before:content-['•'] before:absolute before:left-2 before:text-amber-400\">\n                {w}\n              </li>\n            ))}\n          </ul>\n        </div>\n      )}\n\n      {/* Key Insights */}\n      {allInsights.length > 0 && (\n        <ThemedSection title=\"Key Insights\" count={allInsights.length}>\n          <ul className=\"space-y-2\">\n            {allInsights.slice(0, 6).map((insight, i) => (\n              <li key={i} className=\"flex items-start gap-2 text-sm text-slate-700 pl-3 border-l-2 border-emerald-400 py-1\">\n                {insight}\n              </li>\n            ))}\n          </ul>\n        </ThemedSection>\n      )}\n\n      {/* Recommendations */}\n      {allRecommendations.length > 0 && (\n        <ThemedSection title=\"Recommended Actions\" count={allRecommendations.length}>\n          <div className=\"space-y-2\">\n            {allRecommendations.slice(0, 5).map((rec, i) => (\n              <div key={i} className=\"flex items-start gap-3 p-2 bg-blue-50 rounded-lg\">\n                <span className=\"w-5 h-5 bg-blue-500 text-white rounded-full flex items-center justify-center text-[10px] font-bold flex-shrink-0 mt-0.5\">\n                  {i + 1}\n                </span>\n                <span className=\"text-sm text-slate-700\">{rec}</span>\n              </div>\n            ))}\n          </div>\n        </ThemedSection>\n      )}\n\n      {/* Gaps */}\n      {stats.gaps > 0 && (\n        <ThemedSection title=\"Research Gaps\" count={stats.gaps}>\n          <div className=\"space-y-2\">\n            {session.gaps?.slice(0, 3).map((gap, i) => (\n              <div key={i} className=\"p-3 bg-violet-50 border-l-3 border-violet-500 rounded-r-lg\">\n                <div className=\"flex items-center gap-2 mb-1\">\n                  <span className=\"text-[10px] font-semibold text-violet-600 uppercase px-1.5 py-0.5 bg-violet-100 rounded\">\n                    {gap.gap_type}\n                  </span>\n                  <span className=\"text-[10px] text-violet-500\">{gap.priority} priority</span>\n                </div>\n                <p className=\"text-sm text-slate-700\">{gap.description}</p>\n              </div>\n            ))}\n          </div>\n        </ThemedSection>\n      )}\n    </div>\n  );\n}\n\nfunction StatCard({\n  label,\n  value,\n  subtext,\n  icon,\n  color,\n  children,\n}: {\n  label: string;\n  value: string | number;\n  subtext?: string;\n  icon: React.ReactNode;\n  color: 'blue' | 'emerald' | 'amber' | 'red' | 'slate';\n  children?: React.ReactNode;\n}) {\n  const colors = {\n    blue: 'text-blue-600',\n    emerald: 'text-emerald-600',\n    amber: 'text-amber-600',\n    red: 'text-red-600',\n    slate: 'text-slate-600',\n  };\n\n  return (\n    <div className=\"bg-white rounded-lg border border-slate-200 p-3 shadow-sm\">\n      <div className=\"flex items-center justify-between mb-1\">\n        <span className={`w-4 h-4 ${colors[color]}`}>{icon}</span>\n        <span className=\"text-[9px] uppercase tracking-wider text-slate-400\">{label}</span>\n      </div>\n      <div className={`text-2xl font-bold ${colors[color]}`}>{value}</div>\n      {subtext && <div className=\"text-[10px] text-slate-400 mt-0.5\">{subtext}</div>}\n      {children && <div className=\"mt-2\">{children}</div>}\n    </div>\n  );\n}\n","numLines":185,"startLine":1,"totalLines":185}}}
