tityTypeConfig {\n    39→  const normalized = type.toLowerCase() as EntityType;\n    40→  return entityTypeConfig[normalized] || entityTypeConfig.other;\n    41→}\n    42→\n    43→// Helper to get perspective gradient with fallback\n    44→export function getPerspectiveGradient(type: string): string {\n    45→  const normalized = type.toLowerCase() as PerspectiveType;\n    46→  return perspectiveTypeConfig[normalized]?.gradient || defaultGradient;\n    47→}\n    48→\n    49→// ============================================\n    50→// Confidence/Credibility Color Utilities\n    51→// ============================================\n    52→\n    53→/** Thresholds for confidence/credibility color coding */\n    54→export const CONFIDENCE_THRESHOLDS = {\n    55→  high: 80,\n    56→  medium: 50,\n    57→} as const;\n    58→\n    59→/** Confidence level based on score */\n    60→export type ConfidenceLevel = 'high' | 'medium' | 'low';\n    61→\n    62→/** Get confidence level from a score (0-100 or 0-1) */\n    63→export function getConfidenceLevel(score: number): ConfidenceLevel {\n    64→  // Normalize to percentage if passed as decimal\n    65→  const pct = score <= 1 ? score * 100 : score;\n    66→  if (pct >= CONFIDENCE_THRESHOLDS.high) return 'high';\n    67→  if (pct >= CONFIDENCE_THRESHOLDS.medium) return 'medium';\n    68→  return 'low';\n    69→}\n    70→\n    71→/** Badge color classes by confidence level */\n    72→export const confidenceBadgeColors: Record<ConfidenceLevel, string> = {\n    73→  high: 'bg-emerald-100 text-emerald-700',\n    74→  medium: 'bg-amber-100 text-amber-700',\n    75→  low: 'bg-slate-100 text-slate-600',\n    76→};\n    77→\n    78→/** Credibility badge color classes (uses red for low instead of slate) */\n    79→export const credibilityBadgeColors: Record<ConfidenceLevel, string> = {\n    80→  high: 'bg-emerald-100 text-emerald-700',\n    81→  medium: 'bg-amber-100 text-amber-700',\n    82→  low: 'bg-red-100 text-red-700',\n    83→};\n    84→\n    85→/** Simple color names for progress bars and charts */\n    86→export type ConfidenceColorName = 'emerald' | 'amber' | 'red';\n    87→\n    88→/** Get color name for progress bars and charts */\n    89→export function getConfidenceColorName(score: number): ConfidenceColorName {\n    90→  const level = getConfidenceLevel(score);\n    91→  return level === 'high' ? 'emerald' : level === 'medium' ? 'amber' : 'red';\n    92→}\n    93→\n    94→/** Background color classes for bars */\n    95→export const confidenceBarColors: Record<ConfidenceColorName, string> = {\n    96→  emerald: 'bg-emerald-500',\n    97→  amber: 'bg-amber-500',\n    98→  red: 'bg-red-500',\n    99→};\n   100→\n   101→/** Gradient color classes for progress bars */\n   102→export const confidenceGradientColors: Record<ConfidenceColorName, string> = {\n   103→  emerald: 'bg-gradient-to-r from-emerald-500 to-emerald-600',\n   104→  amber: 'bg-gradient-to-r from-amber-500 to-amber-600',\n   105→  red: 'bg-gradient-to-r from-red-500 to-red-600',\n   106→};\n   107→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"bbdddf83-efc9-404e-b6a3-e0a9e67b2ab3","uuid":"6920a93b-efda-4b2b-95ee-5e190741a793","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\shared\\typeConfig.ts","content":"/**\n * Centralized type-to-style configuration for entities and perspectives.\n * Provides consistent gradients and icons across all report views.\n */\n\n// Entity types configuration\nexport type EntityType = 'person' | 'organization' | 'location' | 'event' | 'other';\n\nexport interface EntityTypeConfig {\n  icon: string;\n  gradient: string;\n}\n\nexport const entityTypeConfig: Record<EntityType, EntityTypeConfig> = {\n  person: { icon: '👤', gradient: 'from-rose-500 to-pink-600' },\n  organization: { icon: '🏢', gradient: 'from-blue-500 to-indigo-600' },\n  location: { icon: '📍', gradient: 'from-emerald-500 to-teal-600' },\n  event: { icon: '📅', gradient: 'from-amber-500 to-orange-600' },\n  other: { icon: '🔹', gradient: 'from-slate-500 to-gray-600' },\n};\n\n// Perspective types configuration\nexport type PerspectiveType = 'financial' | 'investigative' | 'strategic' | 'competitive' | 'technical' | 'legal';\n\nexport const perspectiveTypeConfig: Record<PerspectiveType, { gradient: string }> = {\n  financial: { gradient: 'from-emerald-500 to-teal-600' },\n  investigative: { gradient: 'from-rose-500 to-pink-600' },\n  strategic: { gradient: 'from-blue-500 to-indigo-600' },\n  competitive: { gradient: 'from-amber-500 to-orange-600' },\n  technical: { gradient: 'from-violet-500 to-purple-600' },\n  legal: { gradient: 'from-slate-500 to-gray-600' },\n};\n\n// Default fallback gradient\nexport const defaultGradient = 'from-slate-500 to-gray-600';\n\n// Helper to get entity config with fallback\nexport function getEntityConfig(type: string): EntityTypeConfig {\n  const normalized = type.toLowerCase() as EntityType;\n  return entityTypeConfig[normalized] || entityTypeConfig.other;\n}\n\n// Helper to get perspective gradient with fallback\nexport function getPerspectiveGradient(type: string): string {\n  const normalized = type.toLowerCase() as PerspectiveType;\n  return perspectiveTypeConfig[normalized]?.gradient || defaultGradient;\n}\n\n// ============================================\n// Confidence/Credibility Color Utilities\n// ============================================\n\n/** Thresholds for confidence/credibility color coding */\nexport const CONFIDENCE_THRESHOLDS = {\n  high: 80,\n  medium: 50,\n} as const;\n\n/** Confidence level based on score */\nexport type ConfidenceLevel = 'high' | 'medium' | 'low';\n\n/** Get confidence level from a score (0-100 or 0-1) */\nexport function getConfidenceLevel(score: number): ConfidenceLevel {\n  // Normalize to percentage if passed as decimal\n  const pct = score <= 1 ? score * 100 : score;\n  if (pct >= CONFIDENCE_THRESHOLDS.high) return 'high';\n  if (pct >= CONFIDENCE_THRESHOLDS.medium) return 'medium';\n  return 'low';\n}\n\n/** Badge color classes by confidence level */\nexport const confidenceBadgeColors: Record<ConfidenceLevel, string> = {\n  high: 'bg-emerald-100 text-emerald-700',\n  medium: 'bg-amber-100 text-amber-700',\n  low: 'bg-slate-100 text-slate-600',\n};\n\n/** Credibility badge color classes (uses red for low instead of slate) */\nexport const credibilityBadgeColors: Record<ConfidenceLevel, string> = {\n  high: 'bg-emerald-100 text-emerald-700',\n  medium: 'bg-amber-100 text-amber-700',\n  low: 'bg-red-100 text-red-700',\n};\n\n/** Simple color names for progress bars and charts */\nexport type ConfidenceColorName = 'emerald' | 'amber' | 'red';\n\n/** Get color name for progress bars and charts */\nexport function getConfidenceColorName(score: number): ConfidenceColorName {\n  const level = getConfidenceLevel(score);\n  return level === 'high' ? 'emerald' : level === 'medium' ? 'amber' : 'red';\n}\n\n/** Background color classes for bars */\nexport const confidenceBarColors: Record<ConfidenceColorName, string> = {\n  emerald: 'bg-emerald-500',\n  amber: 'bg-amber-500',\n  red: 'bg-red-500',\n};\n\n/** Gradient color classes for progress bars */\nexport const confidenceGradientColors: Record<ConfidenceColorName, string> = {\n  emerald: 'bg-gradient-to-r from-emerald-500 to-emerald-600',\n  amber: 'bg-gradient-to-r from-amber-500 to-amber-600',\n  red: 'bg-gradient-to-r from-red-500 to-red-600',\n};\n","numLines":107,"startLine":1,"totalLines":107}}}
