nfidence: findings.filter(f => (f.confidence_score || 0) >= 0.8).length,\n   122→      redFlags: findings.filter(f => f.finding_type === 'gap' || f.content.toLowerCase().includes('risk')).length,\n   123→      entities: session.entities?.length || 0,\n   124→    };\n   125→  }, [session]);\n   126→\n   127→  const findingTypes = useMemo(() =>\n   128→    Array.from(new Set(session.findings?.map(f => f.finding_type) || [])),\n   129→    [session.findings]\n   130→  );\n   131→\n   132→  return (\n   133→    <ReportShell onClose={onClose} titleId={titleId}>\n   134→      <ThemedSidebar activeTab={activeTab} onTabChange={handleTabChange} onTabHover={handleTabHover} stats={stats} onClose={onClose} />\n   135→\n   136→      <main className={`flex-1 flex flex-col overflow-hidden ${styles.bg}`}>\n   137→        {/* Header */}\n   138→        <header className={`px-6 py-4 border-b ${styles.border}`}>\n   139→          <motion.h1 id={titleId} initial={{ opacity: 0, y: -10 }} animate={{ opacity: 1, y: 0 }} className={`text-lg font-bold ${styles.text}`}>\n   140→            {session.title}\n   141→          </motion.h1>\n   142→        </header>\n   143→\n   144→        {/* Toolbar */}\n   145→        {activeTab !== 'overview' && (\n   146→          <Toolbar\n   147→            searchQuery={searchQuery}\n   148→            onSearchChange={setSearchQuery}\n   149→            filterType={filterType}\n   150→            onFilterTypeChange={setFilterType}\n   151→            filterConfidence={filterConfidence}\n   152→            onFilterConfidenceChange={setFilterConfidence}\n   153→            findingTypes={findingTypes}\n   154→            showTypeFilter={activeTab === 'findings'}\n   155→            showConfidenceFilter={activeTab === 'findings' || activeTab === 'sources'}\n   156→          />\n   157→        )}\n   158→\n   159→        {/* Content */}\n   160→        <div className=\"flex-1 overflow-y-auto p-6\">\n   161→          <div className=\"max-w-5xl mx-auto\">\n   162