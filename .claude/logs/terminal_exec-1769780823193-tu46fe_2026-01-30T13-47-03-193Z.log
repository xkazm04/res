ng, ResearchSource>;\n   166→  isExpanded: boolean;\n   167→  onToggle: () => void;\n   168→}) {\n   169→  const { theme } = useReportTheme();\n   170→  const styles = useThemeStyles();\n   171→  const isRadar = theme === 'radar';\n   172→  const conf = finding.confidence_score || 0;\n   173→  const srcCount = finding.supporting_sources?.length || 0;\n   174→\n   175→  const confColor = conf >= 0.8 ? 'text-emerald-500' : conf >= 0.5 ? 'text-amber-500' : 'text-rose-500';\n   176→  const confBg = conf >= 0.8 ? 'bg-emerald-500' : conf >= 0.5 ? 'bg-amber-500' : 'bg-rose-500';\n   177→\n   178→  return (\n   179→    <div className={`${isRadar ? 'hover:bg-slate-800/50' : 'hover:bg-stone-50'} transition-colors`}>\n   180→      <button onClick={onToggle} className=\"w-full grid grid-cols-12 gap-2 px-3 py-2 text-left items-center\">\n   181→        {/* Confidence */}\n   182→        <div className=\"col-span-1 flex items-center gap-1\">\n   183→          <div className={`w-1.5 h-1.5 rounded-full ${confBg}`} />\n   184→          <span className={`text-xs font-mono ${confColor}`}>{Math.round(conf * 100)}</span>\n   185→        </div>\n   186→\n   187→        {/* Type */}\n   188→        <div className=\"col-span-2\">\n   189→          <span className={`text-[10px] px-1.5 py-0.5 rounded ${isRadar ? 'bg-slate-800 text-slate-300' : 'bg-stone-200 text-stone-600'}`}>\n   190→            {finding.finding_type}\n   191→          </span>\n   192→        </div>\n   193→\n   194→        {/* Content */}\n   195→        <div className={`col-span-7 text-xs ${styles.text} ${!isExpanded ? 'truncate' : ''}`}>\n   196→          {finding.content.split('.')[0]}.\n   197→        </div>\n   198→\n   199→        {/* Sources */}\n   200→        <div className={`col-span-1 text-xs text-center ${styles.textMuted}`}>{srcCount}</div>\n   201→\n   202→        {/* Date */}\n   203→        <div className={`col-span-1 text-[10px] ${styles.textMuted}`}>\n   204→          {finding.event_date ? new Date(findin