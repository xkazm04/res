[2026-01-30T13:51:40.326Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UhxUVv9uykSWZwH5ku22pQ","type":"tool_result","content":"     1→'use client';\n     2→\n     3→import { useState, useMemo, useRef, useCallback } from 'react';\n     4→import { motion, AnimatePresence } from 'framer-motion';\n     5→import { useVirtualizer } from '@tanstack/react-virtual';\n     6→import type { ResearchFinding, ResearchSource } from '@/src/types/research';\n     7→import { useReportTheme, useThemeStyles } from '../core/ThemeContext';\n     8→import { useNavigation } from '../core/NavigationContext';\n     9→import { AnimatedNumber } from '../core/AnimatedNumber';\n    10→import { ViewHeader } from '../shared/ViewHeader';\n    11→import { EmptyState } from '../shared/EmptyState';\n    12→\n    13→interface FindingsViewProps {\n    14→  findings: ResearchFinding[];\n    15→  sources: ResearchSource[];\n    16→  searchQuery: string;\n    17→  filterType: string;\n    18→  filterConfidence: string;\n    19→}\n    20→\n    21→type SortKey = 'confidence' | 'type' | 'date' | 'sources';\n    22→type SortDir = 'asc' | 'desc';\n    23→\n    24→export function FindingsView({ findings, sources, searchQuery, filterType, filterConfidence }: FindingsViewProps) {\n    25→  const { theme } = useReportTheme();\n    26→  const styles = useThemeStyles();\n    27→  const isRadar = theme === 'radar';\n    28→  const [sortKey, setSortKey] = useState<SortKey>('confidence');\n    29→  const [sortDir, setSortDir] = useState<SortDir>('desc');\n    30→  const [expandedId, setExpandedId] = useState<string | null>(null);\n    31→\n    32→  const sourceMap = useMemo(() => new Map(sources.map(s => [s.id, s])), [sources]);\n    33→\n    34→  const filtered = useMemo(() => {\n    35→    return findings.filter((f) => {\n    36→      if (searchQuery && !f.content.toLowerCase().includes(searchQuery.toLowerCase())) return false;\n    37→      if (filterType !== 'all' && f.finding_type !== filterType) return false;\n    38→      const conf = f.confidence_score || 0;\n    39→      if (filterConfidence === 'high' && conf < 0.8) return false;\n    40→      if (filterConfidence === 'medium' && (conf < 0.5 || conf >= 0.8)) return false;\n    41→      if (filterConfidence === 'low' && conf >= 0.5) return false;\n    42→      return true;\n    43→    });\n    44→  }, [findings, searchQuery, filterType, filterConfidence]);\n    45→\n    46→  const sorted = useMemo(() => {\n    47→    return [...filtered].sort((a, b) => {\n    48→      let cmp = 0;\n    49→      switch (sortKey) {\n    50→        case 'confidence': cmp = (a.confidence_score || 0) - (b.confidence_score || 0); break;\n    51→        case 'type': cmp = (a.finding_type || '').localeCompare(b.finding_type || ''); break;\n    52→        case 'date': cmp = new Date(a.event_date || 0).getTime() - new Date(b.event_date || 0).getTime(); break;\n    53→        case 'sources': cmp = (a.supporting_sources?.length || 0) - (b.supporting_sources?.length || 0); break;\n    54→      }\n    55→      return sortDir === 'desc' ? -cmp : cmp;\n    56→    });\n    57→  }, [filtered, sortKey, sortDir]);\n    58→\n    59→  const toggleSort = (key: SortKey) => {\n    60→    if (sortKey === key) setSortDir(d => d === 'asc' ? 'desc' : 'asc');\n    61→    else { setSortKey(key); setSortDir('desc'); }\n    62→  };\n    63→\n    64→  // Virtualization setup\n    65→  const parentRef = useRef<HTMLDivElement>(null);\n    66→  const rowVirtualizer = useVirtualizer({\n    67→    count: sorted.length,\n    68→    getScrollElement: () => parentRef.current,\n    69→    estimateSize: useCallback((index: number) => {\n    70→      // Estimate larger size for expanded rows\n    71→      return expandedId === sorted[index]?.id ? 180 : 44;\n    72→    }, [expandedId, sorted]),\n    73→    overscan: 5,\n    74→  });\n    75→\n    76→  if (filtered.length === 0) {\n    77→    return (\n    78→      <EmptyState\n    79→        type=\"search\"\n    80→        title=\"No findings match your filters\"\n    81→        description=\"Try adjusting your search terms or filter criteria to see more results.\"\n    82→      />\n    83→    );\n    84→  }\n    85→\n    86→  return (\n    87→    <div className=\"space-y-4\">\n    88→      <ViewHeader title=\"Findings\" count={filtered.length} />\n    89→\n    90→      {/* Table */}\n    91→      <div className={`rounded-xl overflow-hidden border ${isRadar ? 'border-cyan-500/10' : 'border-stone-200'}`}>\n    92→        {/* Header */}\n    93→        <div className={`grid grid-cols-12 gap-2 px-3 py-2 text-[10px] uppercase tracking-wider font-semibold ${isRadar ? 'bg-slate-900/80 text-slate-400' : 'bg-stone-100 text-stone-500'}`}>\n    94→          <SortHeader label=\"Conf\" col={1} sortKey=\"confidence\" current={sortKey} dir={sortDir} onSort={toggleSort} />\n    95→          <SortHeader label=\"Type\" col={2} sortKey=\"type\" current={sortKey} dir={sortDir} onSort={toggleSort} />\n    96→          <div className=\"col-span-7\">Finding</div>\n    97→          <SortHeader label=\"Src\" col={1} sortKey=\"sources\" current={sortKey} dir={sortDir} onSort={toggleSort} />\n    98→          <SortHeader label=\"Date\" col={1} sortKey=\"date\" current={sortKey} dir={sortDir} onSort={toggleSort} />\n    99→        </div>\n   100→\n   101→        {/* Virtualized Rows */}\n   102→        <div\n   103→          ref={parentRef}\n   104→          className={`max-h-[600px] overflow-auto ${isRadar ? 'divide-cyan-500/5' : 'divide-stone-100'}`}\n   105→        >\n   106→          <div\n   107→            style={{\n   108→              height: `${rowVirtualizer.getTotalSize()}px`,\n   109→              width: '100%',\n   110→              position: 'relative',\n   111→            }}\n   112→          >\n   113→            {rowVirtualizer.getVirtualItems().map((virtualRow) => {\n   114→              const f = sorted[virtualRow.index];\n   115→              return (\n   116→                <div\n   117→                  key={f.id}\n   118→                  data-index={virtualRow.index}\n   119→                  ref={rowVirtualizer.measureElement}\n   120→                  style={{\n   121→                    position: 'absolute',\n   122→                    top: 0,\n   123→                    left: 0,\n   124→                    width: '100%',\n   125→                    transform: `translateY(${virtualRow.start}px)`,\n   126→                  }}\n   127→                  className={`border-b ${isRadar ? 'border-cyan-500/5' : 'border-stone-100'}`}\n   128→                >\n   129→                  <FindingRow\n   130→                    finding={f}\n   131→                    sourceMap={sourceMap}\n   132→                    isExpanded={expandedId === f.id}\n   133→                    onToggle={() => setExpandedId(expandedId === f.id ? null : f.id)}\n   134→                  />\n   135→                </div>\n   136→              );\n   137→            })}\n   138→          </div>\n   139→        </div>\n   140→      </div>\n   141→    </div>\n   142→  );\n   143→}\n   144→\n   145→function SortHeader({ label, col, sortKey, current, dir, onSort }: {\n   146→  label: string; col: number; sortKey: SortKey; current: SortKey; dir: SortDir;\n   147→  onSort: (k: SortKey) => void;\n   148→}) {\n   149→  const { theme } = useReportTheme();\n   150→  const isRadar = theme === 'radar';\n   151→  const isActive = current === sortKey;\n   152→\n   153→  return (\n   154→    <button\n   155→      onClick={() => onSort(sortKey)}\n   156→      className={`col-span-${col} flex items-center gap-1 hover:text-white transition-colors ${isActive ? (isRadar ? 'text-cyan-400' : 'text-stone-900') : ''}`}\n   157→    >\n   158→      {label}\n   159→      {isActive && <span className=\"text-[8px]\">{dir === 'desc' ? '▼' : '▲'}</span>}\n   160→    </button>\n   161→  );\n   162→}\n   163→\n   164→function FindingRow({ finding, sourceMap, isExpanded, onToggle }: {\n   165→  finding: ResearchFinding;\n   166→  sourceMap: Map<string, ResearchSource>;\n   167→  isExpanded: boolean;\n   168→  onToggle: () => void;\n   169→}) {\n   170→  const { theme } = useReportTheme();\n   171→  const styles = useThemeStyles();\n   172→  const { navigateTo } = useNavigation();\n   173→  const isRadar = theme === 'radar';\n   174→  const conf = finding.confidence_score || 0;\n   175→  const srcCount = finding.supporting_sources?.length || 0;\n   176→\n   177→  const confColor = conf >= 0.8 ? 'text-emerald-500' : conf >= 0.5 ? 'text-amber-500' : 'text-rose-500';\n   178→  const confBg = conf >= 0.8 ? 'bg-emerald-500' : conf >= 0.5 ? 'bg-amber-500' : 'bg-rose-500';\n   179→\n   180→  const handleSourceClick = (sourceId: string, e: React.MouseEvent) => {\n   181→    e.preventDefault();\n   182→    e.stopPropagation();\n   183→    navigateTo({ tab: 'sources', sourceId });\n   184→  };\n   185→\n   186→  return (\n   187→    <div className={`${isRadar ? 'hover:bg-slate-800/50' : 'hover:bg-stone-50'} transition-colors`}>\n   188→      <button onClick={onToggle} className=\"w-full grid grid-cols-12 gap-2 px-3 py-2 text-left items-center\">\n   189→        {/* Confidence */}\n   190→        <div className=\"col-span-1 flex items-center gap-1\">\n   191→          <div className={`w-1.5 h-1.5 rounded-full ${confBg}`} />\n   192→          <span className={`text-xs font-mono ${confColor}`}>{Math.round(conf * 100)}</span>\n   193→        </div>\n   194→\n   195→        {/* Type */}\n   196→        <div className=\"col-span-2\">\n   197→          <span className={`text-[10px] px-1.5 py-0.5 rounded ${isRadar ? 'bg-slate-800 text-slate-300' : 'bg-stone-200 text-stone-600'}`}>\n   198→            {finding.finding_type}\n   199→          </span>\n   200→        </div>\n   201→\n   202→        {/* Content */}\n   203→        <div className={`col-span-7 text-xs ${styles.text} ${!isExpanded ? 'truncate' : ''}`}>\n   204→          {finding.content.split('.')[0]}.\n   205→        </div>\n   206→\n   207→        {/* Sources */}\n   208→        <div className={`col-span-1 text-xs text-center ${styles.textMuted}`}>{srcCount}</div>\n   209→\n   210→        {/* Date */}\n   211→        <div className={`col-span-1 text-[10px] ${styles.textMuted}`}>\n   212→          {finding.event_date ? new Date(finding.event_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '—'}\n   213→        </div>\n   214→      </button>\n   215→\n   216→      {/* Expanded content */}\n   217→      <AnimatePresence>\n   218→        {isExpanded && (\n   219→          <motion.div\n   220→            initial={{ height: 0, opacity: 0 }}\n   221→            animate={{ height: 'auto', opacity: 1 }}\n   222→            exit={{ height: 0, opacity: 0 }}\n   223→            className={`px-3 pb-3 ${isRadar ? 'bg-slate-900/50' : 'bg-stone-50'}`}\n   224→          >\n   225→            <div className=\"pl-3 border-l-2 border-cyan-500/30 space-y-2\">\n   226→              <p className={`text-xs leading-relaxed ${styles.text}`}>{finding.content}</p>\n   227→\n   228→              {finding.extracted_data && Object.keys(finding.extracted_data).length > 0 && (\n   229→                <div className=\"flex flex-wrap gap-2\">\n   230→                  {Object.entries(finding.extracted_data).slice(0, 4).map(([k, v]) => (\n   231→                    <span key={k} className={`text-[10px] px-2 py-1 rounded ${isRadar ? 'bg-indigo-500/10 text-indigo-300' : 'bg-indigo-50 text-indigo-700'}`}>\n   232→                      {k}: {String(v)}\n   233→                    </span>\n   234→                  ))}\n   235→                </div>\n   236→              )}\n   237→\n   238→              {srcCount > 0 && (\n   239→                <div className=\"flex flex-wrap gap-1\">\n   240→                  {finding.supporting_sources?.slice(0, 3).map(id => {\n   241→                    const src = sourceMap.get(id);\n   242→                    return src ? (\n   243→                      <button\n   244→                        key={id}\n   245→                        onClick={(e) => handleSourceClick(id, e)}\n   246→                        className={`text-[10px] ${isRadar ? 'text-cyan-400 hover:text-cyan-300' : 'text-blue-600 hover:underline'} flex items-center gap-1`}\n   247→                        title=\"View source details\"\n   248→                      >\n   249→                        <span className=\"underline\">{src.domain}</span>\n   250→                        <svg className=\"w-3 h-3 opacity-50\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n   251→                          <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14\" />\n   252→                        </svg>\n   253→                      </button>\n   254→                    ) : null;\n   255→                  })}\n   256→                </div>\n   257→              )}\n   258→            </div>\n   259→          </motion.div>\n   260→        )}\n   261→      </AnimatePresence>\n   262→    </div>\n   263→  );\n   264→}\n   265→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"bbdddf83-efc9-404e-b6a3-e0a9e67b2ab3","uuid":"da1846f3-114b-4db9-b0c3-eff67f1e7a43","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\views\\FindingsView.tsx","content":"'use client';\n\nimport { useState, useMemo, useRef, useCallback } from 'react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport { useVirtualizer } from '@tanstack/react-virtual';\nimport type { ResearchFinding, ResearchSource } from '@/src/types/research';\nimport { useReportTheme, useThemeStyles } from '../core/ThemeContext';\nimport { useNavigation } from '../core/NavigationContext';\nimport { AnimatedNumber } from '../core/AnimatedNumber';\nimport { ViewHeader } from '../shared/ViewHeader';\nimport { EmptyState } from '../shared/EmptyState';\n\ninterface FindingsViewProps {\n  findings: ResearchFinding[];\n  sources: ResearchSource[];\n  searchQuery: string;\n  filterType: string;\n  filterConfidence: string;\n}\n\ntype SortKey = 'confidence' | 'type' | 'date' | 'sources';\ntype SortDir = 'asc' | 'desc';\n\nexport function FindingsView({ findings, sources, searchQuery, filterType, filterConfidence }: FindingsViewProps) {\n  const { theme } = useReportTheme();\n  const styles = useThemeStyles();\n  const isRadar = theme === 'radar';\n  const [sortKey, setSortKey] = useState<SortKey>('confidence');\n  const [sortDir, setSortDir] = useState<SortDir>('desc');\n  const [expandedId, setExpandedId] = useState<string | null>(null);\n\n  const sourceMap = useMemo(() => new Map(sources.map(s => [s.id, s])), [sources]);\n\n  const filtered = useMemo(() => {\n    return findings.filter((f) => {\n      if (searchQuery && !f.content.toLowerCase().includes(searchQuery.toLowerCase())) return false;\n      if (filterType !== 'all' && f.finding_type !== filterType) return false;\n      const conf = f.confidence_score || 0;\n      if (filterConfidence === 'high' && conf < 0.8) return false;\n      if (filterConfidence === 'medium' && (conf < 0.5 || conf >= 0.8)) return false;\n      if (filterConfidence === 'low' && conf >= 0.5) return false;\n      return true;\n    });\n  }, [findings, searchQuery, filterType, filterConfidence]);\n\n  const sorted = useMemo(() => {\n    return [...filtered].sort((a, b) => {\n      let cmp = 0;\n      switch (sortKey) {\n        case 'confidence': cmp = (a.confidence_score || 0) - (b.confidence_score || 0); break;\n        case 'type': cmp = (a.finding_type || '').localeCompare(b.finding_type || ''); break;\n        case 'date': cmp = new Date(a.event_date || 0).getTime() - new Date(b.event_date || 0).getTime(); break;\n        case 'sources': cmp = (a.supporting_sources?.length || 0) - (b.supporting_sources?.length || 0); break;\n      }\n      return sortDir === 'desc' ? -cmp : cmp;\n    });\n  }, [filtered, sortKey, sortDir]);\n\n  const toggleSort = (key: SortKey) => {\n    if (sortKey === key) setSortDir(d => d === 'asc' ? 'desc' : 'asc');\n    else { setSortKey(key); setSortDir('desc'); }\n  };\n\n  // Virtualization setup\n  const parentRef = useRef<HTMLDivElement>(null);\n  const rowVirtualizer = useVirtualizer({\n    count: sorted.length,\n    getScrollElement: () => parentRef.current,\n    estimateSize: useCallback((index: number) => {\n      // Estimate larger size for expanded rows\n      return expandedId === sorted[index]?.id ? 180 : 44;\n    }, [expandedId, sorted]),\n    overscan: 5,\n  });\n\n  if (filtered.length === 0) {\n    return (\n      <EmptyState\n        type=\"search\"\n        title=\"No findings match your filters\"\n        description=\"Try adjusting your search terms or filter criteria to see more results.\"\n      />\n    );\n  }\n\n  return (\n    <div className=\"space-y-4\">\n      <ViewHeader title=\"Findings\" count={filtered.length} />\n\n      {/* Table */}\n      <div className={`rounded-xl overflow-hidden border ${isRadar ? 'border-cyan-500/10' : 'border-stone-200'}`}>\n        {/* Header */}\n        <div className={`grid grid-cols-12 gap-2 px-3 py-2 text-[10px] uppercase tracking-wider font-semibold ${isRadar ? 'bg-slate-900/80 text-slate-400' : 'bg-stone-100 text-stone-500'}`}>\n          <SortHeader label=\"Conf\" col={1} sortKey=\"confidence\" current={sortKey} dir={sortDir} onSort={toggleSort} />\n          <SortHeader label=\"Type\" col={2} sortKey=\"type\" current={sortKey} dir={sortDir} onSort={toggleSort} />\n          <div className=\"col-span-7\">Finding</div>\n          <SortHeader label=\"Src\" col={1} sortKey=\"sources\" current={sortKey} dir={sortDir} onSort={toggleSort} />\n          <SortHeader label=\"Date\" col={1} sortKey=\"date\" current={sortKey} dir={sortDir} onSort={toggleSort} />\n        </div>\n\n        {/* Virtualized Rows */}\n        <div\n          ref={parentRef}\n          className={`max-h-[600px] overflow-auto ${isRadar ? 'divide-cyan-500/5' : 'divide-stone-100'}`}\n        >\n          <div\n            style={{\n              height: `${rowVirtualizer.getTotalSize()}px`,\n              width: '100%',\n              position: 'relative',\n            }}\n          >\n            {rowVirtualizer.getVirtualItems().map((virtualRow) => {\n              const f = sorted[virtualRow.index];\n              return (\n                <div\n                  key={f.id}\n                  data-index={virtualRow.index}\n                  ref={rowVirtualizer.measureElement}\n                  style={{\n                    position: 'absolute',\n                    top: 0,\n                    left: 0,\n                    width: '100%',\n                    transform: `translateY(${virtualRow.start}px)`,\n                  }}\n                  className={`border-b ${isRadar ? 'border-cyan-500/5' : 'border-stone-100'}`}\n                >\n                  <FindingRow\n                    finding={f}\n                    sourceMap={sourceMap}\n                    isExpanded={expandedId === f.id}\n                    onToggle={() => setExpandedId(expandedId === f.id ? null : f.id)}\n                  />\n                </div>\n              );\n            })}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n\nfunction SortHeader({ label, col, sortKey, current, dir, onSort }: {\n  label: string; col: number; sortKey: SortKey; current: SortKey; dir: SortDir;\n  onSort: (k: SortKey) => void;\n}) {\n  const { theme } = useReportTheme();\n  const isRadar = theme === 'radar';\n  const isActive = current === sortKey;\n\n  return (\n    <button\n      onClick={() => onSort(sortKey)}\n      className={`col-span-${col} flex items-center gap-1 hover:text-white transition-colors ${isActive ? (isRadar ? 'text-cyan-400' : 'text-stone-900') : ''}`}\n    >\n      {label}\n      {isActive && <span className=\"text-[8px]\">{dir === 'desc' ? '▼' : '▲'}</span>}\n    </button>\n  );\n}\n\nfunction FindingRow({ finding, sourceMap, isExpanded, onToggle }: {\n  finding: ResearchFinding;\n  sourceMap: Map<string, ResearchSource>;\n  isExpanded: boolean;\n  onToggle: () => void;\n}) {\n  const { theme } = useReportTheme();\n  const styles = useThemeStyles();\n  const { navigateTo } = useNavigation();\n  const isRadar = theme === 'radar';\n  const conf = finding.confidence_score || 0;\n  const srcCount = finding.supporting_sources?.length || 0;\n\n  const confColor = conf >= 0.8 ? 'text-emerald-500' : conf >= 0.5 ? 'text-amber-500' : 'text-rose-500';\n  const confBg = conf >= 0.8 ? 'bg-emerald-500' : conf >= 0.5 ? 'bg-amber-500' : 'bg-rose-500';\n\n  const handleSourceClick = (sourceId: string, e: React.MouseEvent) => {\n    e.preventDefault();\n    e.stopPropagation();\n    navigateTo({ tab: 'sources', sourceId });\n  };\n\n  return (\n    <div className={`${isRadar ? 'hover:bg-slate-800/50' : 'hover:bg-stone-50'} transition-colors`}>\n      <button onClick={onToggle} className=\"w-full grid grid-cols-12 gap-2 px-3 py-2 text-left items-center\">\n        {/* Confidence */}\n        <div className=\"col-span-1 flex items-center gap-1\">\n          <div className={`w-1.5 h-1.5 rounded-full ${confBg}`} />\n          <span className={`text-xs font-mono ${confColor}`}>{Math.round(conf * 100)}</span>\n        </div>\n\n        {/* Type */}\n        <div className=\"col-span-2\">\n          <span className={`text-[10px] px-1.5 py-0.5 rounded ${isRadar ? 'bg-slate-800 text-slate-300' : 'bg-stone-200 text-stone-600'}`}>\n            {finding.finding_type}\n          </span>\n        </div>\n\n        {/* Content */}\n        <div className={`col-span-7 text-xs ${styles.text} ${!isExpanded ? 'truncate' : ''}`}>\n          {finding.content.split('.')[0]}.\n        </div>\n\n        {/* Sources */}\n        <div className={`col-span-1 text-xs text-center ${styles.textMuted}`}>{srcCount}</div>\n\n        {/* Date */}\n        <div className={`col-span-1 text-[10px] ${styles.textMuted}`}>\n          {finding.event_date ? new Date(finding.event_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '—'}\n        </div>\n      </button>\n\n      {/* Expanded content */}\n      <AnimatePresence>\n        {isExpanded && (\n          <motion.div\n            initial={{ height: 0, opacity: 0 }}\n            animate={{ height: 'auto', opacity: 1 }}\n            exit={{ height: 0, opacity: 0 }}\n            className={`px-3 pb-3 ${isRadar ? 'bg-slate-900/50' : 'bg-stone-50'}`}\n          >\n            <div className=\"pl-3 border-l-2 border-cyan-500/30 space-y-2\">\n              <p className={`text-xs leading-relaxed ${styles.text}`}>{finding.content}</p>\n\n              {finding.extracted_data && Object.keys(finding.extracted_data).length > 0 && (\n                <div className=\"flex flex-wrap gap-2\">\n                  {Object.entries(finding.extracted_data).slice(0, 4).map(([k, v]) => (\n                    <span key={k} className={`text-[10px] px-2 py-1 rounded ${isRadar ? 'bg-indigo-500/10 text-indigo-300' : 'bg-indigo-50 text-indigo-700'}`}>\n                      {k}: {String(v)}\n                    </span>\n                  ))}\n                </div>\n              )}\n\n              {srcCount > 0 && (\n                <div className=\"flex flex-wrap gap-1\">\n                  {finding.supporting_sources?.slice(0, 3).map(id => {\n                    const src = sourceMap.get(id);\n                    return src ? (\n                      <button\n                        key={id}\n                        onClick={(e) => handleSourceClick(id, e)}\n                        className={`text-[10px] ${isRadar ? 'text-cyan-400 hover:text-cyan-300' : 'text-blue-600 hover:underline'} flex items-center gap-1`}\n                        title=\"View source details\"\n                      >\n                        <span className=\"underline\">{src.domain}</span>\n                        <svg className=\"w-3 h-3 opacity-50\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                          <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14\" />\n                        </svg>\n                      </button>\n                    ) : null;\n                  })}\n                </div>\n              )}\n            </div>\n          </motion.div>\n        )}\n      </AnimatePresence>\n    </div>\n  );\n}\n","numLines":265,"startLine":1,"totalLines":265}}}
