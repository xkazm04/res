[2026-01-30T13:52:40.929Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013EAfpzPhGeAkmXFM4Rifau","type":"tool_result","content":"     1→'use client';\n     2→\n     3→import { useMemo, useState, useEffect } from 'react';\n     4→import { motion, AnimatePresence } from 'framer-motion';\n     5→import type { ResearchSource } from '@/src/types/research';\n     6→import { useReportTheme, useThemeStyles } from '../core/ThemeContext';\n     7→import { ThemedBadge } from '../ThemedCards';\n     8→import { AnimatedNumber, AnimatedProgressRing } from '../core/AnimatedNumber';\n     9→import { SourceNetwork } from '../visualizations/SourceNetwork';\n    10→import { TrustRadar } from '../visualizations/TrustRadar';\n    11→import { ViewHeader } from '../shared/ViewHeader';\n    12→import { ViewModeToggle, type ViewModeOption } from '../shared/ViewModeToggle';\n    13→import { EmptyState } from '../shared/EmptyState';\n    14→\n    15→interface SourcesViewProps {\n    16→  sources: ResearchSource[];\n    17→  searchQuery: string;\n    18→  filterConfidence: string;\n    19→  initialSelectedId?: string | null;\n    20→}\n    21→\n    22→type ViewMode = 'cards' | 'network' | 'radar';\n    23→\n    24→const viewModeOptions: ViewModeOption<ViewMode>[] = [\n    25→  { value: 'cards', label: 'Cards' },\n    26→  { value: 'network', label: 'Network' },\n    27→  { value: 'radar', label: 'Radar' },\n    28→];\n    29→\n    30→// Stagger animation variants - calculated once at parent level\n    31→const containerVariants = {\n    32→  hidden: { opacity: 0 },\n    33→  visible: {\n    34→    opacity: 1,\n    35→    transition: {\n    36→      staggerChildren: 0.03,\n    37→    },\n    38→  },\n    39→};\n    40→\n    41→const itemVariants = {\n    42→  hidden: { opacity: 0, y: 10 },\n    43→  visible: { opacity: 1, y: 0 },\n    44→  exit: { opacity: 0, scale: 0.95 },\n    45→};\n    46→\n    47→export function SourcesView({ sources, searchQuery, filterConfidence, initialSelectedId }: SourcesViewProps) {\n    48→  const { theme } = useReportTheme();\n    49→  const styles = useThemeStyles();\n    50→  const isRadar = theme === 'radar';\n    51→  const [viewMode, setViewMode] = useState<ViewMode>('cards');\n    52→  const [selectedSource, setSelectedSource] = useState<string | null>(initialSelectedId || null);\n    53→\n    54→  // Sync selection when navigating from another view\n    55→  useEffect(() => {\n    56→    if (initialSelectedId) {\n    57→      setSelectedSource(initialSelectedId);\n    58→    }\n    59→  }, [initialSelectedId]);\n    60→\n    61→  const filtered = useMemo(() => {\n    62→    return sources.filter((s) => {\n    63→      if (searchQuery) {\n    64→        const q = searchQuery.toLowerCase();\n    65→        if (!s.title?.toLowerCase().includes(q) && !s.domain?.toLowerCase().includes(q)) return false;\n    66→      }\n    67→      const cred = s.credibility_score || 0;\n    68→      if (filterConfidence === 'high' && cred < 0.8) return false;\n    69→      if (filterConfidence === 'medium' && (cred < 0.5 || cred >= 0.8)) return false;\n    70→      if (filterConfidence === 'low' && cred >= 0.5) return false;\n    71→      return true;\n    72→    });\n    73→  }, [sources, searchQuery, filterConfidence]);\n    74→\n    75→  const stats = useMemo(() => {\n    76→    const high = filtered.filter(s => (s.credibility_score || 0) >= 0.8).length;\n    77→    const med = filtered.filter(s => { const c = s.credibility_score || 0; return c >= 0.5 && c < 0.8; }).length;\n    78→    return { high, med, low: filtered.length - high - med };\n    79→  }, [filtered]);\n    80→\n    81→  if (filtered.length === 0) {\n    82→    return (\n    83→      <EmptyState\n    84→        type=\"search\"\n    85→        title=\"No sources match your filters\"\n    86→        description=\"Try adjusting your search or confidence filters to see more results.\"\n    87→      />\n    88→    );\n    89→  }\n    90→\n    91→  return (\n    92→    <div className=\"space-y-4\">\n    93→      <ViewHeader\n    94→        title=\"Sources\"\n    95→        count={filtered.length}\n    96→        actions={<ViewModeToggle options={viewModeOptions} value={viewMode} onChange={setViewMode} />}\n    97→      />\n    98→      {/* Credibility summary bar */}\n    99→      <CredibilityBar stats={stats} total={filtered.length} />\n   100→\n   101→      {/* Network View */}\n   102→      {viewMode === 'network' && (\n   103→        <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }}>\n   104→          <SourceNetwork sources={filtered} selectedSource={selectedSource || undefined} onSourceSelect={setSelectedSource} />\n   105→        </motion.div>\n   106→      )}\n   107→\n   108→      {/* Radar View */}\n   109→      {viewMode === 'radar' && (\n   110→        <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }}>\n   111→          <TrustRadar sources={filtered} />\n   112→        </motion.div>\n   113→      )}\n   114→\n   115→      {/* Cards View */}\n   116→      {viewMode === 'cards' && (\n   117→        <motion.div\n   118→          layout\n   119→          className=\"grid grid-cols-1 md:grid-cols-2 gap-3\"\n   120→          variants={containerVariants}\n   121→          initial=\"hidden\"\n   122→          animate=\"visible\"\n   123→        >\n   124→          <AnimatePresence>\n   125→            {filtered.map((source) => (\n   126→              <SourceCard key={source.id} source={source} isSelected={selectedSource === source.id} onSelect={setSelectedSource} />\n   127→            ))}\n   128→          </AnimatePresence>\n   129→        </motion.div>\n   130→      )}\n   131→    </div>\n   132→  );\n   133→}\n   134→\n   135→function CredibilityBar({ stats, total }: { stats: { high: number; med: number; low: number }; total: number }) {\n   136→  const { theme } = useReportTheme();\n   137→  const styles = useThemeStyles();\n   138→  const isRadar = theme === 'radar';\n