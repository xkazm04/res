onfidence</option>\n          <option value=\"high\">High (80%+)</option>\n          <option value=\"medium\">Medium (50-79%)</option>\n          <option value=\"low\">Low (&lt;50%)</option>\n        </select>\n      )}\n    </div>\n  );\n}\n","structuredPatch":[{"oldStart":143,"oldLines":21,"newStart":143,"newLines":6,"lines":["             </motion.h1>","           </header>"," ","-          {/* Toolbar */}","-          {activeTab !== 'overview' && (","-            <Toolbar","-              searchQuery={searchQuery}","-              onSearchChange={setSearchQuery}","-              filterType={filterType}","-              onFilterTypeChange={setFilterType}","-              filterConfidence={filterConfidence}","-              onFilterConfidenceChange={setFilterConfidence}","-              findingTypes={findingTypes}","-              showTypeFilter={activeTab === 'findings'}","-              showConfidenceFilter={activeTab === 'findings' || activeTab === 'sources'}","-            />","-          )}","-","           {/* Content */}","           <div className=\"flex-1 overflow-y-auto p-6\">","             <div className=\"max-w-5xl mx-auto\">"]}],"userModified":false,"replaceAll":false}}
