[2026-01-30T13:57:39.508Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Jvk42mYznaQzqkxME1teUt","type":"tool_result","content":"     1→'use client';\n     2→\n     3→import { useState, useEffect, useCallback, useRef, useMemo } from 'react';\n     4→import { motion, AnimatePresence } from 'framer-motion';\n     5→import { useReportTheme, useThemeStyles } from '../core/ThemeContext';\n     6→\n     7→interface SpeedReaderProps {\n     8→  text: string;\n     9→  isActive: boolean;\n    10→  onClose: () => void;\n    11→  wordsPerMinute?: number;\n    12→}\n    13→\n    14→export function SpeedReader({ text, isActive, onClose, wordsPerMinute = 300 }: SpeedReaderProps) {\n    15→  const { theme } = useReportTheme();\n    16→  const styles = useThemeStyles();\n    17→  const isRadar = theme === 'radar';\n    18→\n    19→  // Pre-calculate all word splits and focal points once when text changes\n    20→  const wordData = useMemo(() => {\n    21→    const words = text.split(/\\s+/).filter(w => w.length > 0);\n    22→    return words.map(word => {\n    23→      // Find the optimal focal point (slightly left of center for English)\n    24→      const focalIndex = Math.floor(word.length * 0.35);\n    25→      return {\n    26→        word,\n    27→        beforeFocal: word.slice(0, focalIndex),\n    28→        focal: word[focalIndex] || '',\n    29→        afterFocal: word.slice(focalIndex + 1),\n    30→      };\n    31→    });\n    32→  }, [text]);\n    33→\n    34→  const [currentIndex, setCurrentIndex] = useState(0);\n    35→  const [isPlaying, setIsPlaying] = useState(false);\n    36→  const [wpm, setWpm] = useState(wordsPerMinute);\n    37→  const intervalRef = useRef<NodeJS.Timeout | null>(null);\n    38→\n    39→  const currentWordData = wordData[currentIndex] || { word: '', beforeFocal: '', focal: '', afterFocal: '' };\n    40→  const progress = wordData.length > 0 ? (currentIndex / wordData.length) * 100 : 0;\n    41→\n    42→  const play = useCallback(() => {\n    43→    setIsPlaying(true);\n    44→  }, []);\n    45→\n    46→  const pause = useCallback(() => {\n    47→    setIsPlaying(false);\n    48→    if (intervalRef.current) {\n    49→      clearInterval(intervalRef.current);\n    50→      intervalRef.current = null;\n    51→    }\n    52→  }, []);\n    53→\n    54→  const reset = useCallback(() => {\n    55→    pause();\n    56→    setCurrentIndex(0);\n    57→  }, [pause]);\n    58→\n    59→  useEffect(() => {\n    60→    if (isPlaying && currentIndex < wordData.length - 1) {\n    61→      const msPerWord = 60000 / wpm;\n    62→      intervalRef.current = setInterval(() => {\n    63→        setCurrentIndex(i => Math.min(i + 1, wordData.length - 1));\n    64→      }, msPerWord);\n    65→      return () => {\n    66→        if (intervalRef.current) clearInterval(intervalRef.current);\n    67→      };\n    68→    } else if (currentIndex >= wordData.length - 1) {\n    69→      pause();\n    70→    }\n    71→  }, [isPlaying, wpm, wordData.length, currentIndex, pause]);\n    72→\n    73→  useEffect(() => {\n    74→    if (!isActive) {\n    75→      reset();\n    76→    }\n    77→  }, [isActive, reset]);\n    78→\n    79→  useEffect(() => {\n    80→    const handleKeyDown = (e: KeyboardEvent) => {\n    81→      if (!isActive) return;\n    82→      if (e.key === ' ') { e.preventDefault(); isPlaying ? pause() : play(); }\n    83→      if (e.key === 'ArrowLeft') setCurrentIndex(i => Math.max(0, i - 5));\n    84→      if (e.key === 'ArrowRight') setCurrentIndex(i => Math.min(wordData.length - 1, i + 5));\n    85→      if (e.key === 'Escape') onClose();\n    86→    };\n    87→    window.addEventListener('keydown', handleKeyDown);\n    88→    return () => window.removeEventListener('keydown', handleKeyDown);\n    89→  }, [isActive, isPlaying, play, pause, onClose, wordData.length]);\n    90→\n    91→  return (\n    92→    <AnimatePresence>\n    93→      {isActive && (\n    94→        <motion.div\n    95→          initial={{ opacity: 0 }}\n    96→          animate={{ opacity: 1 }}\n    97→          exit={{ opacity: 0 }}\n    98→          className={`fixed inset-0 z-50 flex flex-col items-center justify-center ${isRadar ? 'bg-slate-950' : 'bg-stone-100'}`}\n    99→        >\n   100→          {/* Word display */}\n   101→          <div className=\"flex-1 flex items-center justify-center\">\n   102→            <div className={`relative px-16 py-8 rounded-2xl ${isRadar ? 'bg-slate-900/80' : 'bg-white shadow-xl'}`}>\n   103→              {/* Focal point marker */}\n   104→              <div className={`absolute top-0 left-1/2 w-0.5 h-3 -translate-x-1/2 ${isRadar ? 'bg-cyan-400' : 'bg-stone-800'}`} />\n   105→              <div className={`absolute bottom-0 left-1/2 w-0.5 h-3 -translate-x-1/2 ${isRadar ? 'bg-cyan-400' : 'bg-stone-800'}`} />\n   106→\n   107→              {/* Word */}\n   108→              <motion.div\n   109→                key={currentIndex}\n   110→                initial={{ opacity: 0, y: 10 }}\n   111→                animate={{ opacity: 1, y: 0 }}\n   112→                className=\"text-5xl font-mono tracking-wider flex justify-center\"\n   113→              >\n   114→                <span className={styles.textMuted}>{currentWordData.beforeFocal}</span>\n   115→                <span className={isRadar ? 'text-cyan-400' : 'text-rose-600'}>{currentWordData.focal}</span>\n   116→                <span className={styles.text}>{currentWordData.afterFocal}</span>\n   117→              </motion.div>\n   118→            </div>\n   119→          </div>\n   120→\n   121→          {/* Controls */}\n   122→          <div className={`w-full max-w-md p-6 ${isRadar ? 'border-t border-cyan-500/20' : 'border-t border-stone-200'}`}>\n   123→            {/* Progress bar */}\n   124→            <div className={`h-1 rounded-full mb-4 ${isRadar ? 'bg-slate-800' : 'bg-stone-200'}`}>\n   125→              <motion.div\n   126→                className={`h-full rounded-full ${isRadar ? 'bg-cyan-400' : 'bg-stone-800'}`}\n   127→                animate={{ width: `${progress}%` }}\n   128→              />\n   129→            </div>\n   130→\n   131→            {/* Button row */}\n   132→            <div className=\"flex items-center justify-between\">\n   133→              <button onClick={reset} className={`px-4 py-2 rounded-lg text-sm ${isRadar ? 'bg-slate-800 text-slate-300 hover:bg-slate-700' : 'bg-stone-200 text-stone-700 hover:bg-stone-300'}`}>\n   134→                Reset\n   135→              </button>\n   136→\n   137→              <button\n   138→                onClick={isPlaying ? pause : play}\n   139→                className={`px-8 py-3 rounded-xl font-semibold ${isRadar ? 'bg-cyan-500 text-slate-900 hover:bg-cyan-400' : 'bg-stone-800 text-white hover:bg-stone-700'}`}\n   140→              >\n   141→                {isPlaying ? 'Pause' : 'Play'}\n   142→              </button>\n   143→\n   144→              <div className=\"flex items-center gap-2\">\n   145→                <span className={`text-xs ${styles.textMuted}`}>WPM:</span>\n   146→                <input\n   147→                  type=\"range\"\n   148→                  min=\"100\"\n   149→                  max=\"600\"\n   150→                  step=\"50\"\n   151→                  value={wpm}\n   152→                  onChange={(e) => setWpm(Number(e.target.value))}\n   153→                  className=\"w-20\"\n   154→                />\n   155→                <span className={`text-xs font-mono ${styles.text}`}>{wpm}</span>\n   156→              </div>\n   157→            </div>\n   158→\n   159→            {/* Keyboard hints */}\n   160→            <div className={`mt-4 text-center text-[10px] ${styles.textMuted}`}>\n   161→              Space: Play/Pause • ← →: Skip • ESC: Close\n   162→            </div>\n   163→          </div>\n   164→        </motion.div>\n   165→      )}\n   166→    </AnimatePresence>\n   167→  );\n   168→}\n   169→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"bbdddf83-efc9-404e-b6a3-e0a9e67b2ab3","uuid":"2bfdb96e-aebb-4139-972f-e3e367ce7424","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\features\\SpeedReader.tsx","content":"'use client';\n\nimport { useState, useEffect, useCallback, useRef, useMemo } from 'react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport { useReportTheme, useThemeStyles } from '../core/ThemeContext';\n\ninterface SpeedReaderProps {\n  text: string;\n  isActive: boolean;\n  onClose: () => void;\n  wordsPerMinute?: number;\n}\n\nexport function SpeedReader({ text, isActive, onClose, wordsPerMinute = 300 }: SpeedReaderProps) {\n  const { theme } = useReportTheme();\n  const styles = useThemeStyles();\n  const isRadar = theme === 'radar';\n\n  // Pre-calculate all word splits and focal points once when text changes\n  const wordData = useMemo(() => {\n    const words = text.split(/\\s+/).filter(w => w.length > 0);\n    return words.map(word => {\n      // Find the optimal focal point (slightly left of center for English)\n      const focalIndex = Math.floor(word.length * 0.35);\n      return {\n        word,\n        beforeFocal: word.slice(0, focalIndex),\n        focal: word[focalIndex] || '',\n        afterFocal: word.slice(focalIndex + 1),\n      };\n    });\n  }, [text]);\n\n  const [currentIndex, setCurrentIndex] = useState(0);\n  const [isPlaying, setIsPlaying] = useState(false);\n  const [wpm, setWpm] = useState(wordsPerMinute);\n  const intervalRef = useRef<NodeJS.Timeout | null>(null);\n\n  const currentWordData = wordData[currentIndex] || { word: '', beforeFocal: '', focal: '', afterFocal: '' };\n  const progress = wordData.length > 0 ? (currentIndex / wordData.length) * 100 : 0;\n\n  const play = useCallback(() => {\n    setIsPlaying(true);\n  }, []);\n\n  const pause = useCallback(() => {\n    setIsPlaying(false);\n    if (intervalRef.current) {\n      clearInterval(intervalRef.current);\n      intervalRef.current = null;\n    }\n  }, []);\n\n  const reset = useCallback(() => {\n    pause();\n    setCurrentIndex(0);\n  }, [pause]);\n\n  useEffect(() => {\n    if (isPlaying && currentIndex < wordData.length - 1) {\n      const msPerWord = 60000 / wpm;\n      intervalRef.current = setInterval(() => {\n        setCurrentIndex(i => Math.min(i + 1, wordData.length - 1));\n      }, msPerWord);\n      return () => {\n        if (intervalRef.current) clearInterval(intervalRef.current);\n      };\n    } else if (currentIndex >= wordData.length - 1) {\n      pause();\n    }\n  }, [isPlaying, wpm, wordData.length, currentIndex, pause]);\n\n  useEffect(() => {\n    if (!isActive) {\n      reset();\n    }\n  }, [isActive, reset]);\n\n  useEffect(() => {\n    const handleKeyDown = (e: KeyboardEvent) => {\n      if (!isActive) return;\n      if (e.key === ' ') { e.preventDefault(); isPlaying ? pause() : play(); }\n      if (e.key === 'ArrowLeft') setCurrentIndex(i => Math.max(0, i - 5));\n      if (e.key === 'ArrowRight') setCurrentIndex(i => Math.min(wordData.length - 1, i + 5));\n      if (e.key === 'Escape') onClose();\n    };\n    window.addEventListener('keydown', handleKeyDown);\n    return () => window.removeEventListener('keydown', handleKeyDown);\n  }, [isActive, isPlaying, play, pause, onClose, wordData.length]);\n\n  return (\n    <AnimatePresence>\n      {isActive && (\n        <motion.div\n          initial={{ opacity: 0 }}\n          animate={{ opacity: 1 }}\n          exit={{ opacity: 0 }}\n          className={`fixed inset-0 z-50 flex flex-col items-center justify-center ${isRadar ? 'bg-slate-950' : 'bg-stone-100'}`}\n        >\n          {/* Word display */}\n          <div className=\"flex-1 flex items-center justify-center\">\n            <div className={`relative px-16 py-8 rounded-2xl ${isRadar ? 'bg-slate-900/80' : 'bg-white shadow-xl'}`}>\n              {/* Focal point marker */}\n              <div className={`absolute top-0 left-1/2 w-0.5 h-3 -translate-x-1/2 ${isRadar ? 'bg-cyan-400' : 'bg-stone-800'}`} />\n              <div className={`absolute bottom-0 left-1/2 w-0.5 h-3 -translate-x-1/2 ${isRadar ? 'bg-cyan-400' : 'bg-stone-800'}`} />\n\n              {/* Word */}\n              <motion.div\n                key={currentIndex}\n                initial={{ opacity: 0, y: 10 }}\n                animate={{ opacity: 1, y: 0 }}\n                className=\"text-5xl font-mono tracking-wider flex justify-center\"\n              >\n                <span className={styles.textMuted}>{currentWordData.beforeFocal}</span>\n                <span className={isRadar ? 'text-cyan-400' : 'text-rose-600'}>{currentWordData.focal}</span>\n                <span className={styles.text}>{currentWordData.afterFocal}</span>\n              </motion.div>\n            </div>\n          </div>\n\n          {/* Controls */}\n          <div className={`w-full max-w-md p-6 ${isRadar ? 'border-t border-cyan-500/20' : 'border-t border-stone-200'}`}>\n            {/* Progress bar */}\n            <div className={`h-1 rounded-full mb-4 ${isRadar ? 'bg-slate-800' : 'bg-stone-200'}`}>\n              <motion.div\n                className={`h-full rounded-full ${isRadar ? 'bg-cyan-400' : 'bg-stone-800'}`}\n                animate={{ width: `${progress}%` }}\n              />\n            </div>\n\n            {/* Button row */}\n            <div className=\"flex items-center justify-between\">\n              <button onClick={reset} className={`px-4 py-2 rounded-lg text-sm ${isRadar ? 'bg-slate-800 text-slate-300 hover:bg-slate-700' : 'bg-stone-200 text-stone-700 hover:bg-stone-300'}`}>\n                Reset\n              </button>\n\n              <button\n                onClick={isPlaying ? pause : play}\n                className={`px-8 py-3 rounded-xl font-semibold ${isRadar ? 'bg-cyan-500 text-slate-900 hover:bg-cyan-400' : 'bg-stone-800 text-white hover:bg-stone-700'}`}\n              >\n                {isPlaying ? 'Pause' : 'Play'}\n              </button>\n\n              <div className=\"flex items-center gap-2\">\n                <span className={`text-xs ${styles.textMuted}`}>WPM:</span>\n                <input\n                  type=\"range\"\n                  min=\"100\"\n                  max=\"600\"\n                  step=\"50\"\n                  value={wpm}\n                  onChange={(e) => setWpm(Number(e.target.value))}\n                  className=\"w-20\"\n                />\n                <span className={`text-xs font-mono ${styles.text}`}>{wpm}</span>\n              </div>\n            </div>\n\n            {/* Keyboard hints */}\n            <div className={`mt-4 text-center text-[10px] ${styles.textMuted}`}>\n              Space: Play/Pause • ← →: Skip • ESC: Close\n            </div>\n          </div>\n        </motion.div>\n      )}\n    </AnimatePresence>\n  );\n}\n","numLines":169,"startLine":1,"totalLines":169}}}
