bar' : 'Collapse sidebar'}\n    46→    >\n    47→      <motion.svg\n    48→        animate={{ rotate: collapsed ? 180 : 0 }}\n    49→        transition={{ type: 'spring', stiffness: 300, damping: 25 }}\n    50→        className=\"w-5 h-5\"\n    51→        viewBox=\"0 0 24 24\"\n    52→        fill=\"none\"\n    53→        stroke=\"currentColor\"\n    54→        strokeWidth=\"2\"\n    55→      >\n    56→        <path d=\"M11 19l-7-7 7-7M18 19l-7-7 7-7\" />\n    57→      </motion.svg>\n    58→    </button>\n    59→  );\n    60→}\n    61→\n    62→// Unified tab indicator with smooth sliding animation via layoutId\n    63→function TabIndicator({ theme }: { theme: 'radar' | 'swiss' }) {\n    64→  const isRadar = theme === 'radar';\n    65→  return (\n    66→    <motion.div\n    67→      layoutId=\"tab-indicator\"\n    68→      className={`absolute left-0 top-1 bottom-1 w-[3px] rounded-full ${\n    69→        isRadar ? 'bg-cyan-400' : 'bg-stone-900'\n    70→      }`}\n    71→      transition={{\n    72→        type: 'spring',\n    73→        stiffness: 500,\n    74→        damping: 35,\n    75→      }}\n    76→    />\n    77→  );\n    78→}\n    79→\n    80→interface ThemedSidebarProps {\n    81→  activeTab: TabId;\n    82→  onTabChange: (tab: TabId) => void;\n    83→  onTabHover?: (tab: TabId) => void;\n    84→  stats: {\n    85→    findings: number;\n    86→    sources: number;\n    87→    perspectives: number;\n    88→    contradictions: number;\n    89→    gaps: number;\n    90→    avgConfidence: number;\n    91→    redFlags: number;\n    92→    entities: number;\n    93→  };\n    94→  onClose: () => void;\n    95→}\n    96→\n    97→const tabs: { id: TabId; label: string; key: keyof ThemedSidebarProps['stats'] | null }[] = [\n    98→  { id: 'overview', label: 'Overview', key: null },\n    99→  { id: 'findings', label: 'Findings', key: 'findings' },\n   100→  { id: 'sources', label: 'Sources', key: 'sources' },\n   101→  { id: 'perspectives', label: 'Perspectives', key: 'perspectives' },\n   102→  { id: 'analysis', label: 'Analysis', key: null },\n   103→  { id: 'entities', label: 'Entities', key: 'entities' },\n   104→];\n   105→\n   106→export function ThemedSidebar({ activeTab, onTabChange, onTabHover, stats, onClose }: ThemedSidebarProps) {\n   107→  const { theme } = useReportTheme();\n   108→  const { collapsed, toggle } = useSidebarCollapsed();\n   109→\n   110→  return theme === 'radar' ? (\n   111→    <RadarSidebar activeTab={activeTab} onTabChange={onTabChange} onTabHover={onTabHover} stats={stats} onClose={onClose} collapsed={collapsed} onToggleCollapse={toggle} />\n   112→  ) : (\n   113→    <SwissSidebar activeTab={activeTab} onTabChange={onTabChange} onTabHover={onTabHover} stats={stats} onClose={onClose} collapsed={collapsed} onToggleCollapse={toggle} />\n   114→  );\n   115→}\n   116→\n   117→function RadarSidebar({ activeTab, onTabChange, onTabHover, stats, onClose, collapsed, onToggleCollapse }: ThemedSidebarProps & { collapsed: boolean; onToggleCollapse: () => void }) {\n   118→  return (\n   119→    <motion.aside\n   120→      initial={false}\n   121→      animate={{ width: collapsed ? 56 : 224 }}\n   122→      transition={{ type: 'spring', stiffness: 300, damping: 30 }}\n   123→      className=\"flex flex-col border-r border-cyan-500/20 bg-slate-950/50 overflow-hidden\"\n   124→    >\n   125→      {/* Header */}\n   126→      <div className=\"p-4 border-b border-cyan-500/20\">\n   127→        <div className=\"flex items-center gap-2\">\n   128→          <div className=\"w-8 h-8 rounded-lg bg-gradient-to-br from-cyan-400 to-blue-500 flex items-center justify-center flex-shrink-0\">\n   129→            <span className=\"text-white text-xs font-bold\">DR</span>\n   130→          </div>\n   131→          {!collapsed && (\n   132→            <motion.div\n   133→              initial={{ opacity: 0 }}\n   134→              animate={{ opacity: 1 }}\n   135→              exit={{ opacity: 0 }}\n   136→            >\n   