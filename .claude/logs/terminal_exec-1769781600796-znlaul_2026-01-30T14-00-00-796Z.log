  --purple-primary: #7950F2;\n  --purple-light: #F3F0FF;\n\n  /* Template Colors (D3 Map Encoding) */\n  --template-investigative: #E03131;\n  --template-financial: #228BE6;\n  --template-competitive: #7950F2;\n  --template-tech-market: #2F9E44;\n  --template-legal: #1864AB;\n  --template-due-diligence: #F59F00;\n  --template-contract: #862E9C;\n  --template-purchase: #E8590C;\n  --template-reputation: #C2255C;\n  --template-understanding: #0B7285;\n\n  /* Typography */\n  --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n  --font-mono: 'JetBrains Mono', 'SF Mono', 'Consolas', monospace;\n\n  /* Type Scale (1.25 ratio) */\n  --text-xs: 0.75rem;     /* 12px */\n  --text-sm: 0.875rem;    /* 14px */\n  --text-base: 1rem;      /* 16px */\n  --text-lg: 1.125rem;    /* 18px */\n  --text-xl: 1.25rem;     /* 20px */\n  --text-2xl: 1.5rem;     /* 24px */\n  --text-3xl: 1.875rem;   /* 30px */\n  --text-4xl: 2.25rem;    /* 36px */\n\n  /* Font Weights */\n  --font-regular: 400;\n  --font-medium: 500;\n  --font-semibold: 600;\n  --font-bold: 700;\n\n  /* Line Heights */\n  --leading-tight: 1.25;\n  --leading-normal: 1.5;\n  --leading-relaxed: 1.625;\n\n  /* Spacing (8px Grid) */\n  --space-1: 4px;\n  --space-2: 8px;\n  --space-3: 12px;\n  --space-4: 16px;\n  --space-5: 20px;\n  --space-6: 24px;\n  --space-8: 32px;\n  --space-10: 40px;\n  --space-12: 48px;\n  --space-16: 64px;\n\n  /* Borders */\n  --border-radius-sm: 4px;\n  --border-radius-md: 6px;\n  --border-radius-lg: 8px;\n  --border-radius-xl: 12px;\n  --border-width: 1px;\n  --border-color: var(--warm-gray-100);\n\n  /* Shadows (Subtle, Functional) */\n  --shadow-xs: 0 1px 2px rgba(0, 0, 0, 0.03);\n  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.04), 0 1px 2px rgba(0, 0, 0, 0.03);\n  --shadow-md: 0 4px 6px rgba(0, 0, 0, 0.04), 0 2px 4px rgba(0, 0, 0, 0.03);\n  --shadow-lg: 0 10px 15px rgba(0, 0, 0, 0.05), 0 4px 6px rgba(0, 0, 0, 0.03);\n  --shadow-xl: 0 20px 25px rgba(0, 0, 0, 0.06), 0 10px 10px rgba(0, 0, 0, 0.03);\n\n  /* Transitions */\n  --transition-fast: 100ms ease;\n  --transition-normal: 200ms ease;\n  --transition-slow: 300ms ease;\n  --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);\n}\n\n@theme {\n  --color-background: var(--white);\n  --color-foreground: var(--charcoal);\n  --font-sans: var(--font-sans);\n  --font-mono: var(--font-mono);\n}\n\n/* ============================================\n   BASE RESET & DEFAULTS\n   ============================================ */\n\n*, *::before, *::after {\n  box-sizing: border-box;\n}\n\nhtml {\n  scroll-behavior: smooth;\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n}\n\nbody {\n  background: var(--bg-primary);\n  color: var(--text-secondary);\n  font-family: var(--font-sans);\n  font-size: var(--text-base);\n  line-height: var(--leading-normal);\n  min-height: 100vh;\n}\n\n/* Selection */\n::selection {\n  background: rgba(34, 139, 230, 0.2);\n  color: var(--text-primary);\n}\n\n/* ============================================\n   SCROLLBAR (Minimal)\n   ============================================ */\n\n::-webkit-scrollbar {\n  width: 8px;\n  height: 8px;\n}\n\n::-webkit-scrollbar-track {\n  background: var(--scrollbar-track);\n}\n\n::-webkit-scrollbar-thumb {\n  background: var(--scrollbar-thumb);\n  border-radius: 4px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: var(--border-strong);\n}\n\n/* ============================================\n   FOCUS STATES\n   ============================================ */\n\n:focus-visible {\n  outline: 2px solid var(--border-focus);\n  outline-offset: 2px;\n}\n\n/* ============================================\n   TYPOGRAPHY UTILITIES\n   ============================================ */\n\n.text-headline {\n  color: var(--text-primary);\n  font-weight: var(--font-semibold);\n  line-height: var(--leading-tight);\n  letter-spacing: -0.02em;\n}\n\n.text-body {\n  color: var(--text-secondary);\n  font-weight: var(--font-regular);\n  line-height: var(--leading-normal);\n}\n\n.text-secondary {\n  color: var(--text-muted);\n  font-size: var(--text-sm);\n}\n\n.text-label {\n  color: var(--text-muted);\n  font-size: var(--text-xs);\n  font-weight: var(--font-medium);\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n}\n\n/* ============================================\n   CARD STYLES\n   ============================================ */\n\n.card {\n  background: var(--bg-elevated);\n  border: var(--border-width) solid var(--border-color);\n  border-radius: var(--border-radius-lg);\n}\n\n.card-elevated {\n  background: var(--bg-elevated);\n  border: var(--border-width) solid var(--border-color);\n  border-radius: var(--border-radius-lg);\n  box-shadow: var(--shadow-sm);\n}\n\n.card-interactive {\n  background: var(--bg-elevated);\n  border: var(--border-width) solid var(--border-color);\n  border-radius: var(--border-radius-lg);\n  transition: border-color var(--transition-fast), box-shadow var(--transition-fast);\n  cursor: pointer;\n}\n\n.card-interactive:hover {\n  border-color: var(--border-default);\n  box-shadow: var(--shadow-md);\n}\n\n/* ============================================\n   BADGE STYLES\n   ============================================ */\n\n.badge {\n  display: inline-flex;\n  align-items: center;\n  padding: 2px 8px;\n  font-size: var(--text-xs);\n  font-weight: var(--font-medium);\n  border-radius: var(--border-radius-sm);\n  text-transform: uppercase;\n  letter-spacing: 0.03em;\n}\n\n.badge-default {\n  background: var(--bg-hover);\n  color: var(--text-secondary);\n}\n\n.badge-blue {\n  background: var(--blue-light);\n  color: var(--blue-primary);\n}\n\n.badge-green {\n  background: var(--green-light);\n  color: var(--green-primary);\n}\n\n.badge-red {\n  background: var(--red-light);\n  color: var(--red-primary);\n}\n\n.badge-amber {\n  background: var(--amber-light);\n  color: var(--amber-primary);\n}\n\n.badge-purple {\n  background: var(--purple-light);\n  color: var(--purple-primary);\n}\n\n/* ============================================\n   BUTTON STYLES\n   ============================================ */\n\n.btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--space-2);\n  padding: var(--space-2) var(--space-4);\n  font-size: var(--text-sm);\n  font-weight: var(--font-medium);\n  border-radius: var(--border-radius-md);\n  transition: all var(--transition-fast);\n  cursor: pointer;\n  border: none;\n}\n\n.btn-primary {\n  background: var(--text-primary);\n  color: var(--text-inverse);\n}\n\n.btn-primary:hover {\n  background: var(--text-secondary);\n}\n\n.btn-secondary {\n  background: var(--bg-elevated);\n  color: var(--text-primary);\n  border: var(--border-width) solid var(--border-color);\n}\n\n.btn-secondary:hover {\n  background: var(--bg-hover);\n  border-color: var(--border-strong);\n}\n\n.btn-ghost {\n  background: transparent;\n  color: var(--text-secondary);\n}\n\n.btn-ghost:hover {\n  background: var(--bg-hover);\n}\n\n/* ============================================\n   PROGRESS BAR\n   ============================================ */\n\n.progress-bar {\n  height: 4px;\n  background: var(--bg-secondary);\n  border-radius: 2px;\n  overflow: hidden;\n}\n\n.progress-bar-fill {\n  height: 100%;\n  background: var(--blue-primary);\n  border-radius: 2px;\n  transition: width var(--transition-normal);\n}\n\n.progress-bar-green .progress-bar-fill {\n  background: var(--green-primary);\n}\n\n.progress-bar-amber .progress-bar-fill {\n  background: var(--amber-primary);\n}\n\n.progress-bar-red .progress-bar-fill {\n  background: var(--red-primary);\n}\n\n/* ============================================\n   TEMPLATE COLOR UTILITIES\n   ============================================ */\n\n.template-investigative { color: var(--template-investigative); }\n.template-financial { color: var(--template-financial); }\n.template-competitive { color: var(--template-competitive); }\n.template-tech-market { color: var(--template-tech-market); }\n.template-legal { color: var(--template-legal); }\n.template-due-diligence { color: var(--template-due-diligence); }\n.template-contract { color: var(--template-contract); }\n.template-purchase { color: var(--template-purchase); }\n.template-reputation { color: var(--template-reputation); }\n.template-understanding { color: var(--template-understanding); }\n\n.bg-template-investigative { background-color: var(--template-investigative); }\n.bg-template-financial { background-color: var(--template-financial); }\n.bg-template-competitive { background-color: var(--template-competitive); }\n.bg-template-tech-market { background-color: var(--template-tech-market); }\n.bg-template-legal { background-color: var(--template-legal); }\n.bg-template-due-diligence { background-color: var(--template-due-diligence); }\n.bg-template-contract { background-color: var(--template-contract); }\n.bg-template-purchase { background-color: var(--template-purchase); }\n.bg-template-reputation { background-color: var(--template-reputation); }\n.bg-template-understanding { background-color: var(--template-understanding); }\n\n/* ============================================\n   D3 TREEMAP STYLES\n   ============================================ */\n\n.treemap-node {\n  cursor: pointer;\n  transition: opacity var(--transition-fast);\n}\n\n.treemap-node:hover {\n  opacity: 0.9;\n}\n\n.treemap-node-label {\n  font-size: var(--text-xs);\n  font-weight: var(--font-medium);\n  fill: var(--white);\n  pointer-events: none;\n  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);\n}\n\n.treemap-node-value {\n  font-size: 10px;\n  fill: rgba(255, 255, 255, 0.8);\n  pointer-events: none;\n}\n\n.treemap-group-label {\n  font-size: var(--text-sm);\n  font-weight: var(--font-semibold);\n  fill: var(--charcoal);\n}\n\n/* ============================================\n   MODAL STYLES\n   ============================================ */\n\n.modal-overlay {\n  position: fixed;\n  inset: 0;\n  background: var(--bg-overlay);\n  backdrop-filter: blur(4px);\n  z-index: 50;\n}\n\n.modal-content {\n  position: fixed;\n  top: 0;\n  right: 0;\n  bottom: 0;\n  width: 100%;\n  max-width: 800px;\n  background: var(--bg-elevated);\n  box-shadow: var(--shadow-xl);\n  overflow-y: auto;\n  z-index: 51;\n}\n\n@media (min-width: 1024px) {\n  .modal-content {\n    max-width: 900px;\n  }\n}\n\n@media (min-width: 1280px) {\n  .modal-content {\n    max-width: 1000px;\n  }\n}\n\n/* ============================================\n   COLLAPSIBLE SECTION\n   ============================================ */\n\n.collapsible-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: var(--space-3) var(--space-4);\n  cursor: pointer;\n  user-select: none;\n  border-bottom: var(--border-width) solid transparent;\n  transition: background var(--transition-fast);\n}\n\n.collapsible-header:hover {\n  background: var(--bg-hover);\n}\n\n.collapsible-content {\n  overflow: hidden;\n  transition: max-height var(--transition-normal) var(--ease-out-expo);\n}\n\n.collapsible-content[data-state=\"closed\"] {\n  max-height: 0;\n}\n\n.collapsible-content[data-state=\"open\"] {\n  max-height: 2000px;\n}\n\n/* ============================================\n   FINDING TYPE COLORS\n   ============================================ */\n\n.finding-fact { color: var(--blue-primary); }\n.finding-event { color: var(--green-primary); }\n.finding-actor { color: var(--red-primary); }\n.finding-relationship { color: var(--purple-primary); }\n.finding-pattern { color: var(--amber-primary); }\n.finding-evidence { color: #059669; }\n.finding-claim { color: #0891B2; }\n.finding-gap { color: var(--warm-gray-500); }\n.finding-risk { color: var(--red-primary); }\n.finding-red_flag { color: var(--red-primary); }\n\n.bg-finding-fact { background: var(--blue-light); }\n.bg-finding-event { background: var(--green-light); }\n.bg-finding-actor { background: var(--red-light); }\n.bg-finding-relationship { background: var(--purple-light); }\n.bg-finding-pattern { background: var(--amber-light); }\n.bg-finding-evidence { background: #ECFDF5; }\n.bg-finding-claim { background: #ECFEFF; }\n.bg-finding-gap { background: var(--warm-gray-50); }\n.bg-finding-risk { background: var(--red-light); }\n.bg-finding-red_flag { background: var(--red-light); }\n\n/* ============================================\n   ANIMATIONS\n   ============================================ */\n\n@keyframes fade-in {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n@keyframes slide-in-right {\n  from { transform: translateX(100%); }\n  to { transform: translateX(0); }\n}\n\n@keyframes slide-out-right {\n  from { transform: translateX(0); }\n  to { transform: translateX(100%); }\n}\n\n.animate-fade-in {\n  animation: fade-in var(--transition-normal) var(--ease-out-expo);\n}\n\n.animate-slide-in-right {\n  animation: slide-in-right var(--transition-slow) var(--ease-out-expo);\n}\n\n.animate-slide-out-right {\n  animation: slide-out-right var(--transition-slow) var(--ease-out-expo);\n}\n\n/* ============================================\n   CONFIDENCE INDICATOR\n   ============================================ */\n\n.confidence-high {\n  color: var(--green-primary);\n}\n\n.confidence-medium {\n  color: var(--amber-primary);\n}\n\n.confidence-low {\n  color: var(--red-primary);\n}\n\n/* ============================================\n   GRID & LAYOUT UTILITIES\n   ============================================ */\n\n.grid-pattern {\n  background-image:\n    linear-gradient(rgba(0, 0, 0, 0.02) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(0, 0, 0, 0.02) 1px, transparent 1px);\n  background-size: 24px 24px;\n}\n\n.section-divider {\n  height: 1px;\n  background: var(--border-color);\n  margin: var(--space-6) 0;\n}\n\n/* ============================================\n   RECHARTS CUSTOMIZATION (Light Theme)\n   ============================================ */\n\n.recharts-cartesian-grid-horizontal line,\n.recharts-cartesian-grid-vertical line {\n  stroke: var(--warm-gray-100);\n}\n\n.recharts-tooltip-wrapper {\n  filter: drop-shadow(var(--shadow-md));\n}\n\n/* ============================================\n   UTILITY CLASSES\n   ============================================ */\n\n.truncate-2 {\n  display: -webkit-box;\n  -webkit-line-clamp: 2;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n}\n\n.truncate-3 {\n  display: -webkit-box;\n  -webkit-line-clamp: 3;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n}\n\n.no-scrollbar {\n  -ms-overflow-style: none;\n  scrollbar-width: none;\n}\n\n.no-scrollbar::-webkit-scrollbar {\n  display: none;\n}\n\n/* ============================================\n   SEMANTIC THEME VARIABLES\n   Theme-agnostic variables for component styling\n   ============================================ */\n\n:root {\n  /* Backgrounds (8) */\n  --bg-primary: #FFFFFF;\n  --bg-secondary: #FAFAFA;\n  --bg-elevated: #FFFFFF;\n  --bg-overlay: rgba(0, 0, 0, 0.5);\n  --bg-tooltip: #1A1918;\n  --bg-input: #FFFFFF;\n  --bg-hover: #F5F3F0;\n  --bg-active: #E8E7E5;\n\n  /* Text (5) */\n  --text-primary: #1A1918;\n  --text-secondary: #4A4947;\n  --text-muted: #8A8987;\n  --text-inverse: #FFFFFF;\n  --text-link: #2563EB;\n\n  /* Borders (4) */\n  --border-default: #E8E7E5;\n  --border-subtle: #F0EFED;\n  --border-strong: #D0CFCD;\n  --border-focus: #2563EB;\n\n  /* Accents (5) */\n  --accent-primary: #2563EB;\n  --accent-info: #228BE6;\n  --accent-success: #2F9E44;\n  --accent-warning: #F59F00;\n  --accent-danger: #E03131;\n\n  /* Map Visualization (4) */\n  --node-fill: #2563EB;\n  --node-stroke: #1D4ED8;\n  --node-glow: none;\n  --connection-line: #D0CFCD;\n\n  /* Effects (4) */\n  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.04), 0 1px 2px rgba(0, 0, 0, 0.03);\n  --shadow-md: 0 4px 6px rgba(0, 0, 0, 0.04), 0 2px 4px rgba(0, 0, 0, 0.03);\n  --shadow-lg: 0 10px 15px rgba(0, 0, 0, 0.05), 0 4px 6px rgba(0, 0, 0, 0.03);\n  --glow-primary: none;\n\n  /* Scrollbar (2) */\n  --scrollbar-track: #F8F7F5;\n  --scrollbar-thumb: #D0CFCD;\n}\n\n/* ============================================\n   SWISS THEME - Clean, minimal, high contrast\n   Default theme (light mode)\n   ============================================ */\n\n:root,\n[data-theme=\"swiss\"] {\n  /* Backgrounds */\n  --bg-primary: #FFFFFF;\n  --bg-secondary: #FAFAFA;\n  --bg-elevated: #FFFFFF;\n  --bg-overlay: rgba(0, 0, 0, 0.5);\n  --bg-tooltip: #1A1918;\n  --bg-input: #FFFFFF;\n  --bg-hover: #F5F3F0;\n  --bg-active: #E8E7E5;\n\n  /* Text */\n  --text-primary: #1A1918;\n  --text-secondary: #4A4947;\n  --text-muted: #8A8987;\n  --text-inverse: #FFFFFF;\n  --text-link: #2563EB;\n\n  /* Borders */\n  --border-default: #E8E7E5;\n  --border-subtle: #F0EFED;\n  --border-strong: #D0CFCD;\n  --border-focus: #2563EB;\n\n  /* Accents */\n  --accent-primary: #2563EB;\n  --accent-info: #228BE6;\n  --accent-success: #2F9E44;\n  --accent-warning: #F59F00;\n  --accent-danger: #E03131;\n\n  /* Map Visualization */\n  --node-fill: #2563EB;\n  --node-stroke: #1D4ED8;\n  --node-glow: none;\n  --connection-line: #D0CFCD;\n\n  /* Effects - Minimal shadows, no glows */\n  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.04), 0 1px 2px rgba(0, 0, 0, 0.03);\n  --shadow-md: 0 4px 6px rgba(0, 0, 0, 0.04), 0 2px 4px rgba(0, 0, 0, 0.03);\n  --shadow-lg: 0 10px 15px rgba(0, 0, 0, 0.05), 0 4px 6px rgba(0, 0, 0, 0.03);\n  --glow-primary: none;\n\n  /* Scrollbar */\n  --scrollbar-track: #F8F7F5;\n  --scrollbar-thumb: #D0CFCD;\n\n  /* Alias for backward compatibility */\n  --border-color: var(--border-default);\n}\n\n/* ============================================\n   RADAR THEME - Dark, glowing, command center\n   Cyan accent with glow effects\n   ============================================ */\n\n[data-theme=\"radar\"] {\n  /* Backgrounds - Dark palette */\n  --bg-primary: #0A0A0B;\n  --bg-secondary: #111113;\n  --bg-elevated: #18181B;\n  --bg-overlay: rgba(0, 0, 0, 0.8);\n  --bg-tooltip: #27272A;\n  --bg-input: #18181B;\n  --bg-hover: #1F1F23;\n  --bg-active: #27272A;\n\n  /* Text - Light on dark */\n  --text-primary: #FAFAFA;\n  --text-secondary: #A1A1AA;\n  --text-muted: #71717A;\n  --text-inverse: #0A0A0B;\n  --text-link: #22D3EE;\n\n  /* Borders - Subtle dark borders */\n  --border-default: #27272A;\n  --border-subtle: #1F1F23;\n  --border-strong: #3F3F46;\n  --border-focus: #22D3EE;\n\n  /* Accents - Cyan primary */\n  --accent-primary: #22D3EE;\n  --accent-info: #38BDF8;\n  --accent-success: #4ADE80;\n  --accent-warning: #FBBF24;\n  --accent-danger: #F87171;\n\n  /* Map Visualization - Glowing nodes */\n  --node-fill: #22D3EE;\n  --node-stroke: #06B6D4;\n  --node-glow: 0 0 12px rgba(34, 211, 238, 0.4);\n  --connection-line: #3F3F46;\n\n  /* Effects - Dark shadows with cyan glow */\n  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.4), 0 1px 2px rgba(0, 0, 0, 0.3);\n  --shadow-md: 0 4px 6px rgba(0, 0, 0, 0.4), 0 2px 4px rgba(0, 0, 0, 0.3);\n  --shadow-lg: 0 10px 15px rgba(0, 0, 0, 0.5), 0 4px 6px rgba(0, 0, 0, 0.3);\n  --glow-primary: 0 0 20px rgba(34, 211, 238, 0.3);\n\n  /* Scrollbar - Dark track */\n  --scrollbar-track: #18181B;\n  --scrollbar-thumb: #3F3F46;\n\n  /* Alias for backward compatibility */\n  --border-color: var(--border-default);\n}\n\n","structuredPatch":[{"oldStart":522,"oldLines":10,"newStart":522,"newLines":21,"lines":["   to { transform: translateX(100%); }"," }"," ","+@keyframes slide-in-left {","+  from { opacity: 0; transform: translateX(-20px); }","+  to { opacity: 1; transform: translateX(0); }","+}","+"," .animate-fade-in {","   animation: fade-in var(--transition-normal) var(--ease-out-expo);","+  animation-fill-mode: both;"," }"," ","+.animate-slide-in-left {","+  animation: slide-in-left var(--transition-normal) var(--ease-out-expo);","+  animation-fill-mode: both;","+}","+"," .animate-slide-in-right {","   animation: slide-in-right var(--transition-slow) var(--ease-out-expo);"," }"]}],"userModified":false,