{colors[level]}`}>\n      {label ?? `${pct}%`}\n    </span>\n  );\n}\n\n// Backward-compatible aliases\nexport function ConfidenceBadge({ score }: { score: number }) {\n  return <ScoreBadge score={score} variant=\"confidence\" />;\n}\n\nexport function CredibilityBadge({ score }: { score: number }) {\n  return <ScoreBadge score={score} variant=\"credibility\" />;\n}\n\nexport function PriorityBadge({ priority }: { priority: string }) {\n  const { theme } = useReportTheme();\n  const isRadar = theme === 'radar';\n\n  const lightColors: Record<string, string> = {\n    high: 'bg-red-100 text-red-700',\n    medium: 'bg-amber-100 text-amber-700',\n    low: 'bg-slate-100 text-slate-600',\n  };\n\n  const darkColors: Record<string, string> = {\n    high: 'bg-red-500/20 text-red-400',\n    medium: 'bg-amber-500/20 text-amber-400',\n    low: 'bg-slate-500/20 text-slate-400',\n  };\n\n  const colors = isRadar ? darkColors : lightColors;\n  const fallback = isRadar ? 'bg-slate-500/20 text-slate-400' : 'bg-slate-100 text-slate-600';\n\n  return (\n    <span className={`inline-block px-2 py-0.5 rounded text-[10px] font-semibold uppercase ${colors[priority] || fallback}`}>\n      {priority}\n    </span>\n  );\n}\n\nexport function StatusBadge({ status }: { status: string }) {\n  const colors: Record<string, string> = {\n    completed: 'bg-emerald-100 text-emerald-700',\n    active: 'bg-blue-100 text-blue-700',\n    searching: 'bg-amber-100 text-amber-700',\n    analyzing: 'bg-purple-100 text-purple-700',\n    paused: 'bg-slate-100 text-slate-600',\n    failed: 'bg-red-100 text-red-700',\n  };\n\n  return (\n    <span className={`inline-block px-2 py-0.5 rounded text-[10px] font-semibold uppercase ${colors[status] || 'bg-slate-100 text-slate-600'}`}>\n      {status}\n    </span>\n  );\n}\n","structuredPatch":[{"oldStart":142,"oldLines":7,"newStart":142,"newLines":10,"lines":[" }"," "," export function StatusBadge({ status }: { status: string }) {","-  const colors: Record<string, 