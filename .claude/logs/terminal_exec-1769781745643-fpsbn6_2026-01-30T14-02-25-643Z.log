{colorClass[getColor()]}`}\n    52→          style={{ width: `${percent}%` }}\n    53→        />\n    54→      </div>\n    55→      {showLabel && (\n    56→        <span className=\"text-[10px] font-medium text-slate-600 w-8 text-right\" aria-hidden=\"true\">\n    57→          {Math.round(percent)}%\n    58→        </span>\n    59→      )}\n    60→    </div>\n    61→  );\n    62→}\n    63→\n    64→interface MiniChartProps {\n    65→  data: number[];\n    66→  color?: 'blue' | 'emerald' | 'amber' | 'auto';\n    67→  height?: number;\n    68→}\n    69→\n    70→export function MiniChart({ data, color = 'blue', height = 20 }: MiniChartProps) {\n    71→  const max = Math.max(...data, 1);\n    72→\n    73→  const staticColors: Record<'blue' | 'emerald' | 'amber', string> = {\n    74→    blue: 'bg-blue-500',\n    75→    emerald: 'bg-emerald-500',\n    76→    amber: 'bg-amber-500',\n    77→  };\n    78→\n    79→  const getBarColor = (value: number) => {\n    80→    if (color !== 'auto') {\n    81→      return staticColors[color];\n    82→    }\n    83→    const percent = (value / max) * 100;\n    84→    return confidenceBarColors[getConfidenceColorName(percent)];\n    85→  };\n    86→\n    87→  return (\n    88→    <div className=\"flex gap-0.5 items-end\" style={{ height }}>\n    89→      {data.map((value, i) => (\n    90→        <div\n    91→          key={i}\n    92→          className={`flex-1 rounded-t-sm transition-all ${getBarColor(value)}`}\n    93→          style={{ height: `${(value / max) * 100}%`, minWidth: 3 }}\n    94→        />\n    95→      ))}\n    96→    </div>\n    97→  );\n    98→}\n    99→\n   100→interface ConfidenceDistributionProps {\n   101→  high: number;\n   102→  medium: number;\n   103→  low: number;\n   104→}\n   105→\n   106→export function ConfidenceDistribution({ high, medium, low }: ConfidenceDistributionProps) {\n   107→  const total = high + medium + low || 1;\n   108→\n   109→  return (\n   110→    <div className=\"flex h-1.5 rounded-full overflow-hidden bg-slate-200\">\n   111→      <div\n   112→        className=\"bg-emerald-500 transition-all\"\n   113→        style={{ width: `${(high / total) * 100}%` }}\n   114→      />\n   115→      <div\n   116→        className=\"bg-amber-500 transition-all\"\n   117→        style={{ width: `${(medium / total) * 100}%` }}\n   118→      />\n   119→      <div\n   120→        className=\"bg-red-500 transition-all\"\n   121→        style={{ width: `${(low / total) * 100}%` }}\n   122→      />\n   123→    </div>\n   124→  );\n   125→}\n   126→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"bbdddf83-efc9-404e-b6a3-e0a9e67b2ab3","uuid":"2c421923-aa5f-4090-88c2-60e3633f55a1","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\shared\\ProgressBar.tsx","content":"'use client';\n\nimport { getConfidenceColorName, confidenceGradientColors, confidenceBarColors, type ConfidenceColorName } from './typeConfig';\n\ninterface ProgressBarProps {\n  value: number;\n  max?: number;\n  color?: 'blue' | 'emerald' | 'amber' | 'red' | 'auto';\n  size?: 'sm' | 'md';\n  showLabel?: boolean;\n  /** Accessible label describing what this progress bar represents */\n  'aria-label'?: string;\n}\n\nexport function ProgressBar({\n  value,\n  max = 100,\n  color = 'auto',\n  size = 'md',\n  showLabel = false,\n  'aria-label': ariaLabel,\n}: ProgressBarProps) {\n  const percent = Math.min(100, Math.max(0, (value / max) * 100));\n\n  const getColor = (): ConfidenceColorName | 'blue' => {\n    if (color !== 'auto') return color;\n    return getConfidenceColorName(percent);\n  };\n\n  const colorClass: Record<ConfidenceColorName | 'blue', string> = {\n    blue: 'bg-gradient-to-r from-blue-500 to-blue-600',\n    ...confidenceGradientColors,\n  };\n\n  const sizeClass = {\n    sm: 'h-1',\n    md: 'h-1.5',\n  };\n\n  return (\n    <div className=\"flex items-center gap-2\">\n      <div\n        className={`flex-1 bg-slate-200 rounded-full overflow-hidden ${sizeClass[size]}`}\n        role=\"progressbar\"\n        aria-valuenow={Math.round(percent)}\n        aria-valuemin={0}\n        aria-valuemax={100}\n        aria-label={ariaLabel || 'Progress'}\n      >\n        <div\n          className={`h-full rounded-full transition-all duration-500 ${colorClass[getColor()]}`}\n          style={{ width: `${percent}%` }}\n        />\n      </div>\n      {showLabel && (\n        <span className=\"text-[10px] font-medium text-slate-600 w-8 text-right\" aria-hidden=\"true\">\n          {Math.round(percent)}%\n        </span>\n      )}\n    </div>\n  );\n}\n\ninterface MiniChartProps {\n  data: number[];\n  color?: 'blue' | 'emerald' | 'amber' | 'auto';\n  height?: number;\n}\n\nexport function MiniChart({ data, color = 'blue', height = 20 }: MiniChartProps) {\n  const max = Math.max(...data, 1);\n\n  const staticColors: Record<'blue' | 'emerald' | 'amber', string> = {\n    blue: 'bg-blue-500',\n    emerald: 'bg-emerald-500',\n    amber: 'bg-amber-500',\n  };\n\n  const getBarColor = (value: number) => {\n    if (color !== 'auto') {\n      return staticColors[color];\n    }\n    const percent = (value / max) * 100;\n    return confidenceBarColors[getConfidenceColorName(percent)];\n  };\n\n  return (\n    <div className=\"flex gap-0.5 items-end\" style={{ height }}>\n      {data.map((value, i) => (\n        <div\n          key={i}\n          className={`flex-1 rounded-t-sm transition-all ${getBarColor(value)}`}\n          style={{ height: `${(value / max) * 100}%`, minWidth: 3 }}\n        />\n      ))}\n    </div>\n  );\n}\n\ninterface ConfidenceDistributionProps {\n  high: number;\n  medium: number;\n  low: number;\n}\n\nexport function ConfidenceDistribution({ high, medium, low }: ConfidenceDistributionProps) {\n  const total = high + medium + low || 1;\n\n  return (\n    <div className=\"flex h-1.5 rounded-full overflow-hidden bg-slate-200\">\n      <div\n        className=\"bg-emerald-500 transition-all\"\n        style={{ width: `${(high / total) * 100}%` }}\n      />\n      <div\n        className=\"bg-amber-500 transition-all\"\n        style={{ width: `${(medium / total) * 100}%` }}\n      />\n      <div\n        className=\"bg-red-500 transition-all\"\n        style={{ width: `${(low / total) * 100}%` }}\n      />\n    </div>\n  );\n}\n","numLines":126,"startLine":1,"totalLines":126}}}
