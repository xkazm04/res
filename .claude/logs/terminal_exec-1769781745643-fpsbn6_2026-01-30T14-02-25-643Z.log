lse });\n     \n     export function useThemeStylesSafe() {\n       const ctx = useContext(ThemeContext);\n       return useMemo(() => themeStyles[ctx.theme], [ctx.theme]);\n     }\n     \n     export function useReportThemeSafe() {\n       const ctx = useContext(ThemeContext);\n       return ctx;\n     }\n     ```\n\n   - `src/components/report/shared/Cards.tsx`\n     - Updated QuickStatCard to be theme-aware with dual color schemes\n     - Updated AlertBanner to be theme-aware with dual color schemes\n     ```tsx\n     import { useReportTheme } from '../core/ThemeContext';\n     \n     export function QuickStatCard({ label, value, subtext, progress, icon, color, children }) {\n       const { theme } = useReportTheme();\n       const isRadar = theme === 'radar';\n       \n       const lightColors = {\n         blue: 'bg-blue-50 border-blue-200 text-blue-600',\n         // ... other colors\n       };\n       \n       const darkColors = {\n         blue: 'bg-blue-500/10 border-blue-500/30 text-blue-400',\n         // ... other colors\n       };\n       \n       const colorClasses = isRadar ? darkColors : lightColors;\n       // ... rest of component\n     }\n     ```\n\n   - `src/components/report/shared/ProgressBar.tsx`\n     - Contains ProgressBar, MiniChart, ConfidenceDistribution components\n     - Uses hardcoded light theme colors (bg-slate-200, text-slate-600)\n     - NEEDS to be updated to be theme-aware\n\n   - `src/components/report/shared/Badges.tsx`\n     - Contains ScoreBadge (unified), ConfidenceBadge, CredibilityBadge (aliases)\n     - Already uses getConfidenceLevel from typeConfig\n     - May need theme-aware updates\n\n   - `src/components/report/ThemedCards.tsx`\n     - Contains ThemedStatCard, ThemedSection, ThemedBadge\n     - Already theme-aware, provides reference for radar/swiss styling patterns\n\n   - Previous requirement completions in this session:\n     - NavigationContext.tsx created for cross-view linking\n     - ReportView.tsx simplifie