mber;\n  subtext?: string;\n  progress?: number;\n  icon: ReactNode;\n  color: 'blue' | 'emerald' | 'amber' | 'red' | 'slate';\n  children?: ReactNode;\n}) {\n  const { theme } = useReportTheme();\n  const isRadar = theme === 'radar';\n\n  // Light theme (swiss) colors\n  const lightColors = {\n    blue: 'bg-blue-50 border-blue-200 text-blue-600',\n    emerald: 'bg-emerald-50 border-emerald-200 text-emerald-600',\n    amber: 'bg-amber-50 border-amber-200 text-amber-600',\n    red: 'bg-red-50 border-red-200 text-red-600',\n    slate: 'bg-slate-50 border-slate-200 text-slate-600',\n  };\n\n  // Dark theme (radar) colors\n  const darkColors = {\n    blue: 'bg-blue-500/10 border-blue-500/30 text-blue-400',\n    emerald: 'bg-emerald-500/10 border-emerald-500/30 text-emerald-400',\n    amber: 'bg-amber-500/10 border-amber-500/30 text-amber-400',\n    red: 'bg-red-500/10 border-red-500/30 text-red-400',\n    slate: 'bg-slate-800 border-slate-700 text-slate-300',\n  };\n\n  const colorClasses = isRadar ? darkColors : lightColors;\n\n  const progressColors = {\n    blue: 'bg-blue-500',\n    emerald: 'bg-emerald-500',\n    amber: 'bg-amber-500',\n    red: 'bg-red-500',\n    slate: 'bg-slate-500',\n  };\n\n  const progressBg = isRadar ? 'bg-white/10' : 'bg-white/50';\n\n  return (\n    <div className={`rounded-lg border p-3 ${colorClasses[color]}`}>\n      <div className=\"flex items-center justify-between mb-1\">\n        <span className=\"w-4 h-4 opacity-60\">{icon}</span>\n        <span className=\"text-[9px] uppercase tracking-wider opacity-60\">{label}</span>\n      </div>\n      <div className=\"text-xl font-bold\">{value}</div>\n      {subtext && <div className=\"text-[10px] opacity-70 mt-0.5\">{subtext}</div>}\n      {progress !== undefined && (\n        <div className={`h-1 ${progressBg} rounded-full mt-2 overflow-hidden`}>\n          <div\n            className={`h-full rounded-full ${progressColors[color]}`}\n            style={{ width: `${progress}%` }}\n          />\n        </div>\n      )}\n      {children && <div className=\"mt-2\">{children}</div>}\n    </div>\n  );\n}\n\n// Alert banner - theme-aware with light theme fallback\nexport function AlertBanner({\n  title,\n  description,\n  variant,\n  icon,\n}: {\n  title: string;\n  description: string;\n  variant: 'warning' | 'error' | 'info' | 'success';\n  icon?: ReactNode;\n}) {\n  const { theme } = useReportTheme();\n  const isRadar = theme === 'radar';\n\n  const lightVariants = {\n    warning: 'bg-gradient-to-br from-orange-50 to-amber-50 border-orange-200 text-orange-700',\n    error: 'bg-gradient-to-br from-red-50 to-rose-50 border-red-200 text-red-700',\n    info: 'bg-gradient-to-br from-violet-50 to-purple-50 border-violet-200 text-violet-700',\n    success: 'bg-gradient-to-br from-emerald-50 to-green-50 border-emerald-200 text-emerald-700',\n  };\n\n  const darkVariants = {\n    warning: 'bg-gradient-to-br from-orange-500/10 to-amber-500/10 border-orange-500/30 text-orange-400',\n    error: 'bg-gradient-to-br from-red-500/10 to-rose-500/10 border-red-500/30 text-red-400',\n    info: 'bg-gradient-to-br from-violet-500/10 to-purple-500/10 border-violet-500/30 text-violet-400',\n    success: 'bg-gradient-to-br from-emerald-500/10 to-green-500/10 border-emerald-500/30 text-emerald-400',\n  };\n\n  const variants = isRadar ? darkVariants : lightVariants;\n\n  return (\n    <div className={`border rounded-lg p-3 ${variants[variant]}`}>\n      <div className=\"flex items-center gap-2 font-semibold text-xs mb-1\">\n        {icon && <span className=\"w-3.5 h-3.5\">{icon}</span>}\n        {title}\n      </div>\n      <p className=\"text-[10px] opacity-80\">{description}</p>\n    </div>\n  );\n}\n\n","numLines":120,"startLine":1,"totalLines":120}}}
