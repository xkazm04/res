ore || 0) >= 0.8).length,\n      redFlags: findings.filter(f => f.finding_type === 'gap' || f.content.toLowerCase().includes('risk')).length,\n      entities: entities.length,\n    };\n  }, [\n    session.id,\n    findings.length,\n    sources.length,\n    perspectives.length,\n    contradictions.length,\n    gaps.length,\n    entities.length,\n    // Include findings array reference only for the content-dependent calculations\n    // This is still more stable than depending on the entire session object\n    findings,\n  ]);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":554,"cache_read_input_tokens":45848,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":554},"output_tokens":25,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"bbdddf83-efc9-404e-b6a3-e0a9e67b2ab3","uuid":"396d8efa-0066-4b58-a943-765844179af3"}
