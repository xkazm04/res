[2026-01-30T14:08:48.730Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012hAGyJ6PHBB9jHFGqEekqH","type":"tool_result","content":"     1→'use client';\n     2→\n     3→import { useState, useMemo, useRef, useCallback } from 'react';\n     4→import { motion, AnimatePresence } from 'framer-motion';\n     5→import { useVirtualizer } from '@tanstack/react-virtual';\n     6→import type { ResearchFinding, ResearchSource } from '@/src/types/research';\n     7→import { useReportTheme, useThemeStyles } from '../core/ThemeContext';\n     8→import { useNavigation } from '../core/NavigationContext';\n     9→import { AnimatedNumber } from '../core/AnimatedNumber';\n    10→import { ViewHeader } from '../shared/ViewHeader';\n    11→import { EmptyState } from '../shared/EmptyState';\n    12→import { useDebouncedValue } from '@/src/hooks/useDebouncedValue';\n    13→import { matchesConfidenceFilter, type ConfidenceFilterOption } from '../shared/typeConfig';\n    14→\n    15→interface FindingsViewProps {\n    16→  findings: ResearchFinding[];\n    17→  sources: ResearchSource[];\n    18→}\n    19→\n    20→type SortKey = 'confidence' | 'type' | 'date' | 'sources';\n    21→type SortDir = 'asc' | 'desc';\n    22→\n    23→export function FindingsView({ findings, sources }: FindingsViewProps) {\n    24→  const { theme } = useReportTheme();\n    25→  const styles = useThemeStyles();\n    26→  const isRadar = theme === 'radar';\n    27→\n    28→  // Local filter state - no prop drilling from ReportView\n    29→  const [searchQuery, setSearchQuery] = useState('');\n    30→  const [filterType, setFilterType] = useState('all');\n    31→  const [filterConfidence, setFilterConfidence] = useState('all');\n    32→  const debouncedSearchQuery = useDebouncedValue(searchQuery, 150);\n    33→\n    34→  const [sortKey, setSortKey] = useState<SortKey>('confidence');\n    35→  const [sortDir, setSortDir] = useState<SortDir>('desc');\n    36→  const [expandedId, setExpandedId] = useState<string | null>(null);\n    37→\n    38→  const sourceMap = useMemo(() => new Map(sources.map(s => [s.id, s])), [sources]);\n    39→\n    40→  const findingTypes = useMemo(() =>\n    41→    Array.from(new Set(findings.map(f => f.finding_type).filter(Boolean))),\n    42→    [findings]\n    43→  );\n    44→\n    45→  const filtered = useMemo(() => {\n    46→    return findings.filter((f) => {\n    47→      if (debouncedSearchQuery && !f.content.toLowerCase().includes(debouncedSearchQuery.toLowerCase())) return false;\n    48→      if (filterType !== 'all' && f.finding_type !== filterType) return false;\n    49→      if (!matchesConfidenceFilter(f.confidence_score || 0, filterConfidence as ConfidenceFilterOption)) return false;\n    50→      return true;\n    51→    });\n    52→  }, [findings, debouncedSearchQuery, filterType, filterConfidence]);\n    53→\n    54→  const sorted = useMemo(() => {\n    55→    return [...filtered].sort((a, b) => {\n    56→      let cmp = 0;\n    57→      switch (sortKey) {\n    58→        case 'confidence': cmp = (a.confidence_score || 0) - (b.confidence_score || 0); break;\n    59→        case 'type': cmp = (a.finding_type || '').localeCompare(b.finding_type || ''); break;\n    60→        case 'date': cmp = new Date(a.event_date || 0).getTime() - new Date(b.event_date || 0).getTime(); break;\n    61→        case 'sources': cmp = (a.supporting_sources?.length || 0) - (b.supporting_sources?.length || 0); break;\n    62→      }\n    63→      return sortDir === 'desc' ? -cmp : cmp;\n    64→    });\n    65→  }, [filtered, sortKey, sortDir]);\n    66→\n    67→  const toggleSort = (key: SortKey) => {\n    68→    if (sortKey === key) setSortDir(d => d === 'asc' ? 'desc' : 'asc');\n    69→    else { setSortKey(key); setSortDir('desc'); }\n    70→  };\n    71→\n    72→  // Virtualization setup\n    73→  const parentRef = useRef<HTMLDivElement>(null);\n    74→  const rowVirtualizer = useVirtualizer({\n    75→    count: sorted.length,\n    76→    getScrollElement: () => parentRef.current,\n    77→    estimateSize: useCallback((index: number) => {\n    78→      // Estimate larger size for expanded rows\n    79→      return expandedId === sorted[index]?.id ? 180 : 44;\n    80→    }, [expandedId, sorted]),\n    81→    overscan: 5,\n    82→  });\n    83→\n    84→  if (filtered.length === 0) {\n    85→    return (\n    86→      <EmptyState\n    87→        type=\"search\"\n    88→        title=\"No findings match your filters\"\n    89→        description=\"Try adjusting your search terms or filter criteria to see more results.\"\n    90→      />\n    91→    );\n    92→  }\n    93→\n    94→  return (\n    95→    <div className=\"space-y-4\">\n    96→      <ViewHeader title=\"Findings\" count={filtered.length} />\n    97→\n    98→      {/* Inline Toolbar */}\n    99→      <div className={`flex flex-wrap gap-3 p-3 rounded-lg ${isRadar ? 'bg-slate-900/50 border border-cyan-500/10' : 'bg-stone-50 border border-stone-200'}`}>\n   100→        <input\n   101→          type=\"text\"\n   102→          placeholder=\"Search findings...\"\n   103→          value={searchQuery}\n   104→          onChange={(e) => setSearchQuery(e.target.value)}\n   105→          className={`flex-1 min-w-[180px] px-3 py-1.5 text-sm rounded-lg ${isRadar ? 'bg-slate-800 border-cyan-500/20 text-white placeholder:text-slate-500' : 'bg-white border-stone-300 text-stone-900 placeholder:text-stone-400'} border focus:outline-none`}\n   106→        />\n   107→        <select\n   108→          value={filterType}\n   109→          onChange={(e) => setFilterType(e.target.value)}\n   110→          className={`px-3 py-1.5 text-sm rounded-lg ${isRadar ? 'bg-slate-800 border-cyan-500/20 text-white' : 'bg-white border-stone-300 text-stone-900'} border`}\n   111→        >\n   112→          <option value=\"all\">All Types</option>\n   113→          {findingTypes.map(t => <option key={t} value={t}>{t}</option>)}\n   114→        </select>\n   115→        <select\n   116→          value={filterConfidence}\n   117→          onChange={(e) => setFilterConfidence(e.target.value)}\n   118→          className={`px-3 py-1.5 text-sm rounded-lg ${isRadar ? 'bg-slate-800 border-cyan-500/20 text-white' : 'bg-white border-stone-300 text-stone-900'} border`}\n   119→        >\n   120→          <option value=\"all\">All Confidence</option>\n   121→          <option value=\"high\">High (80%+)</option>\n   122→          <option value=\"medium\">Medium (50-79%)</option>\n   123→          <option value=\"low\">Low (&lt;50%)</option>\n   124→        </select>\n   125→      </div>\n   126→\n   127→      {/* Table */}\n   128→      <div className={`rounded-xl overflow-hidden border ${isRadar ? 'border-cyan-500/10' : 'border-stone-200'}`}>\n   129→        {/* Header */}\n   130→        <div className={`grid grid-cols-12 gap-2 px-3 py-2 text-[10px] uppercase tracking-wider font-semibold ${isRadar ? 'bg-slate-900/80 text-slate-400' : 'bg-stone-100 text-stone-500'}`}>\n   131→          <SortHeader label=\"Conf\" col={1} sortKey=\"confidence\" current={sortKey} dir={sortDir} onSort={toggleSort} />\n   132→          <SortHeader label=\"Type\" col={2} sortKey=\"type\" current={sortKey} dir={sortDir} onSort={toggleSort} />\n   133→          <div className=\"col-span-7\">Finding</div>\n   134→          <SortHeader label=\"Src\" col={1} sortKey=\"sources\" current={sortKey} dir={sortDir} onSort={toggleSort} />\n   135→          <SortHeader label=\"Date\" col={1} sortKey=\"date\" current={sortKey} dir={sortDir} onSort={toggleSort} />\n   136→        </div>\n   137→\n   138→        {/* Virtualized Rows */}\n   139→        <div\n   140→          ref={parentRef}\n   141→          className={`max-h-[600px] overflow-auto ${isRadar ? 'divide-cyan-500/5' : 'divide-stone-100'}`}\n   142→        >\n   143→          <div\n   144→            style={{\n   145→              height: `${rowVirtualizer.getTotalSize()}px`,\n   146→              width: '100%',\n   147→              position: 'relative',\n   148→            }}\n   149→          >\n   150→            {rowVirtualizer.getVirtualItems().map((virtualRow) => {\n   151→              const f = sorted[virtualRow.index];\n   152→              return (\n   153→                <div\n   154→                  key={f.id}\n   155→                  data-index={virtualRow.index}\n   156→                  ref={rowVirtualizer.measureElement}\n   157→                  style={{\n   158→                    position: 'absolute',\n   159→                    top: 0,\n   160→                    left: 0,\n   161→                    width: '100%',\n   162→                    transform: `translateY(${virtualRow.start}px)`,\n   163→                  }}\n   164→                  className={`border-b ${isRadar ? 'border-cyan-500/5' : 'border-stone-100'}`}\n   165→                >\n   166→                  <FindingRow\n   167→                    finding={f}\n   168→                    sourceMap={sourceMap}\n   169→                    isExpanded={expandedId === f.id}\n   170→                    onToggle={() => setExpandedId(expandedId === f.id ? null : f.id)}\n   171→                  />\n   172→                </div>\n   173→              );\n   174→            })}\n   175→          </div>\n   176→        </div>\n   177→      </div>\n   178→    </div>\n   179→  );\n   180→}\n   181→\n   182→function SortHeader({ label, col, sortKey, current, dir, onSort }: {\n   183→  label: string; col: number; sortKey: SortKey; current: SortKey; dir: SortDir;\n   184→  onSort: (k: SortKey) => void;\n   185→}) {\n   186→  const { theme } = useReportTheme();\n   187→  const isRadar = theme === 'radar';\n   188→  const isActive = current === sortKey;\n   189→\n   190→  return (\n   191→    <button\n   192→      onClick={() => onSort(sortKey)}\n   193→      className={`col-span-${col} flex items-center gap-1 hover:text-white transition-colors ${isActive ? (isRadar ? 'text-cyan-400' : 'text-stone-900') : ''}`}\n   194→    >\n   195→      {label}\n   196→      {isActive && <span className=\"text-[8px]\">{dir === 'desc' ? '▼' : '▲'}</span>}\n   197→    </button>\n   198→  );\n   199→}\n   200→\n   201→function FindingRow({ finding, sourceMap, isExpanded, onToggle }: {\n   202→  finding: ResearchFinding;\n   203→  sourceMap: Map<string, ResearchSource>;\n   204→  isExpanded: boolean;\n   205→  onToggle: () => void;\n   206→}) {\n   207→  const { theme } = useReportTheme();\n   208→  const styles = useThemeStyles();\n   209→  const { navigateTo } = useNavigation();\n   210→  const isRadar = theme === 'radar';\n   211→  const conf = finding.confidence_score || 0;\n   212→  const srcCount = finding.supporting_sources?.length || 0;\n   213→\n   214→  const confColor = conf >= 0.8 ? 'text-emerald-500' : conf >= 0.5 ? 'text-amber-500' : 'text-rose-500';\n   215→  const confBg = conf >= 0.8 ? 'bg-emerald-500' : conf >= 0.5 ? 'bg-amber-500' : 'bg-rose-500';\n   216→\n   217→  const handleSourceClick = (sourceId: string, e: React.MouseEvent) => {\n   218→    e.preventDefault();\n   219→    e.stopPropagation();\n   220→    navigateTo({ tab: 'sources', sourceId });\n   221→  };\n   222→\n   223→  return (\n   224→    <div className={`${isRadar ? 'hover:bg-slate-800/50' : 'hover:bg-stone-50'} transition-colors`}>\n   225→      <button onClick={onToggle} className=\"w-full grid grid-cols-12 gap-2 px-3 py-2 text-left items-center\">\n   226→        {/* Confidence */}\n   227→        <div className=\"col-span-1 flex items-center gap-1\">\n   228→          <div className={`w-1.5 h-1.5 rounded-full ${confBg}`} />\n   229→          <span className={`text-xs font-mono ${confColor}`}>{Math.round(conf * 100)}</span>\n   230→        </div>\n   231→\n   232→        {/* Type */}\n   233→        <div className=\"col-span-2\">\n   234→          <span className={`text-[10px] px-1.5 py-0.5 rounded ${isRadar ? 'bg-slate-800 text-slate-300' : 'bg-stone-200 text-stone-600'}`}>\n   235→            {finding.finding_type}\n   236→          </span>\n   237→        </div>\n   238→\n   239→        {/* Content */}\n   240→        <div className={`col-span-7 text-xs ${styles.text} ${!isExpanded ? 'truncate' : ''}`}>\n   241→          {finding.content.split('.')[0]}.\n   242→        </div>\n   243→\n   244→        {/* Sources */}\n   245→        <div className={`col-span-1 text-xs text-center ${styles.textMuted}`}>{srcCount}</div>\n   246→\n   247→        {/* Date */}\n   248→        <div className={`col-span-1 text-[10px] ${styles.textMuted}`}>\n   249→          {finding.event_date ? new Date(finding.event_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '—'}\n   250→        </div>\n   251→      </button>\n   252→\n   253→      {/* Expanded content */}\n   254→      <AnimatePresence>\n   255→        {isExpanded && (\n   256→          <motion.div\n   257→            initial={{ height: 0, opacity: 0 }}\n   258→            animate={{ height: 'auto', opacity: 1 }}\n   259→            exit={{ height: 0, opacity: 0 }}\n   260→            className={`px-3 pb-3 ${isRadar ? 'bg-slate-900/50' : 'bg-stone-50'}`}\n   261→          >\n   262→            <div className=\"pl-3 border-l-2 border-cyan-500/30 space-y-2\">\n   263→              <p className={`text-xs leading-relaxed ${styles.text}`}>{finding.content}</p>\n   264→\n   265→              {finding.extracted_data && Object.keys(finding.extracted_data).length > 0 && (\n   266→                <div className=\"flex flex-wrap gap-2\">\n   267→                  {Object.entries(finding.extracted_data).slice(0, 4).map(([k, v]) => (\n   268→                    <span key={k} className={`text-[10px] px-2 py-1 rounded ${isRadar ? 'bg-indigo-500/10 text-indigo-300' : 'bg-indigo-50 text-indigo-700'}`}>\n   269→                      {k}: {String(v)}\n   270→                    </span>\n   271→                  ))}\n   272→                </div>\n   273→              )}\n   274→\n   275→              {srcCount > 0 && (\n   276→                <div className=\"flex flex-wrap gap-1\">\n   277→                  {finding.supporting_sources?.slice(0, 3).map(id => {\n   278→                    const src = sourceMap.get(id);\n   279→                    return src ? (\n   280→                      <button\n   281→                        key={id}\n   282→                        onClick={(e) => handleSourceClick(id, e)}\n   283→                        className={`text-[10px] ${isRadar ? 'text-cyan-400 hover:text-cyan-300' : 'text-blue-600 hover:underline'} flex items-center gap-1`}\n   284→                        title=\"View source details\"\n   285→                      >\n   286→                        <span className=\"underline\">{src.domain}</span>\n   287→                        <svg className=\"w-3 h-3 opacity-50\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n   288→                          <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14\" />\n   289→                        </svg>\n   290→                      </button>\n   291→                    ) : null;\n   292→                  })}\n   293→                </div>\n   294→              )}\n   295→            </div>\n   296→          </motion.div>\n   297→        )}\n   298→      </AnimatePresence>\n   299→    </div>\n   300→  );\n   301→}\n   302→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"bbdddf83-efc9-404e-b6a3-e0a9e67b2ab3","uuid":"5c94fca6-fa23-4d07-b79e-5da82ac48c1a","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\views\\FindingsView.tsx","content":"'use client';\n\nimport { useState, useMemo, useRef, useCallback } from 'react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport { useVirtualizer } from '@tanstack/react-virtual';\nimport type { ResearchFinding, ResearchSource } from '@/src/types/research';\nimport { useReportTheme, useThemeStyles } from '../core/ThemeContext';\nimport { useNavigation } from '../core/NavigationContext';\nimport { AnimatedNumber } from '../core/AnimatedNumber';\nimport { ViewHeader } from '../shared/ViewHeader';\nimport { EmptyState } from '../shared/EmptyState';\nimport { useDebouncedValue } from '@/src/hooks/useDebouncedValue';\nimport { matchesConfidenceFilter, type ConfidenceFilterOption } from '../shared/typeConfig';\n\ninterface FindingsViewProps {\n  findings: ResearchFinding[];\n  sources: ResearchSource[];\n}\n\ntype SortKey = 'confidence' | 'type' | 'date' | 'sources';\ntype SortDir = 'asc' | 'desc';\n\nexport function FindingsView({ findings, sources }: FindingsViewProps) {\n  const { theme } = useReportTheme();\n  const styles = useThemeStyles();\n  const isRadar = theme === 'radar';\n\n  // Local filter state - no prop drilling from ReportView\n  const [searchQuery, setSearchQuery] = useState('');\n  const [filterType, setFilterType] = useState('all');\n  const [filterConfidence, setFilterConfidence] = useState('all');\n  const debouncedSearchQuery = useDebouncedValue(searchQuery, 150);\n\n  const [sortKey, setSortKey] = useState<SortKey>('confidence');\n  const [sortDir, setSortDir] = useState<SortDir>('desc');\n  const [expandedId, setExpandedId] = useState<string | null>(null);\n\n  const sourceMap = useMemo(() => new Map(sources.map(s => [s.id, s])), [sources]);\n\n  const findingTypes = useMemo(() =>\n    Array.from(new Set(findings.map(f => f.finding_type).filter(Boolean))),\n    [findings]\n  );\n\n  const filtered = useMemo(() => {\n    return findings.filter((f) => {\n      if (debouncedSearchQuery && !f.content.toLowerCase().includes(debouncedSearchQuery.toLowerCase())) return false;\n      if (filterType !== 'all' && f.finding_type !== filterType) return false;\n      if (!matchesConfidenceFilter(f.confidence_score || 0, filterConfidence as ConfidenceFilterOption)) return false;\n      return true;\n    });\n  }, [findings, debouncedSearchQuery, filterType, filterConfidence]);\n\n  const sorted = useMemo(() => {\n    return [...filtered].sort((a, b) => {\n      let cmp = 0;\n      switch (sortKey) {\n        case 'confidence': cmp = (a.confidence_score || 0) - (b.confidence_score || 0); break;\n        case 'type': cmp = (a.finding_type || '').localeCompare(b.finding_type || ''); break;\n        case 'date': cmp = new Date(a.event_date || 0).getTime() - new Date(b.event_date || 0).getTime(); break;\n        case 'sources': cmp = (a.supporting_sources?.length || 0) - (b.supporting_sources?.length || 0); break;\n      }\n      return sortDir === 'desc' ? -cmp : cmp;\n    });\n  }, [filtered, sortKey, sortDir]);\n\n  const toggleSort = (key: SortKey) => {\n    if (sortKey === key) setSortDir(d => d === 'asc' ? 'desc' : 'asc');\n    else { setSortKey(key); setSortDir('desc'); }\n  };\n\n  // Virtualization setup\n  const parentRef = useRef<HTMLDivElement>(null);\n  const rowVirtualizer = useVirtualizer({\n    count: sorted.length,\n    getScrollElement: () => parentRef.current,\n    estimateSize: useCallback((index: number) => {\n      // Estimate larger size for expanded rows\n      return expandedId === sorted[index]?.id ? 180 : 44;\n    }, [expandedId, sorted]),\n    overscan: 5,\n  });\n\n  if (filtered.length === 0) {\n    return (\n      <EmptyState\n        type=\"search\"\n        title=\"No findings match your filters\"\n        description=\"Try adjusting your search terms or filter criteria to see more results.\"\n      />\n    );\n  }\n\n  return (\n    <div className=\"space-y-4\">\n      <ViewHeader title=\"Findings\" count={filtered.length} />\n\n      {/* Inline Toolbar */}\n      <div className={`flex flex-wrap gap-3 p-3 rounded-lg ${isRadar ? 'bg-slate-900/50 border border-cyan-500/10' : 'bg-stone-50 border border-stone-200'}`}>\n        <input\n          type=\"text\"\n          placeholder=\"Search findings...\"\n          value={searchQuery}\n          onChange={(e) => setSearchQuery(e.target.value)}\n          className={`flex-1 min-w-[180px] px-3 py-1.5 text-sm rounded-lg ${isRadar ? 'bg-slate-800 border-cyan-500/20 text-white placeholder:text-slate-500' : 'bg-white border-stone-300 text-stone-900 placeholder:text-stone-400'} border focus:outline-none`}\n        />\n        <select\n          value={filterType}\n          onChange={(e) => setFilterType(e.target.value)}\n          className={`px-3 py-1.5 text-sm rounded-lg ${isRadar ? 'bg-slate-800 border-cyan-500/20 text-white' : 'bg-white border-stone-300 text-stone-900'} border`}\n        >\n          <option value=\"all\">All Types</option>\n          {findingTypes.map(t => <option key={t} value={t}>{t}</option>)}\n        </select>\n        <select\n          value={filterConfidence}\n          onChange={(e) => setFilterConfidence(e.target.value)}\n          className={`px-3 py-1.5 text-sm rounded-lg ${isRadar ? 'bg-slate-800 border-cyan-500/20 text-white' : 'bg-white border-stone-300 text-stone-900'} border`}\n        >\n          <option value=\"all\">All Confidence</option>\n          <option value=\"high\">High (80%+)</option>\n          <option value=\"medium\">Medium (50-79%)</option>\n          <option value=\"low\">Low (&lt;50%)</option>\n        </select>\n      </div>\n\n      {/* Table */}\n      <div className={`rounded-xl overflow-hidden border ${isRadar ? 'border-cyan-500/10' : 'border-stone-200'}`}>\n        {/* Header */}\n        <div className={`grid grid-cols-12 gap-2 px-3 py-2 text-[10px] uppercase tracking-wider font-semibold ${isRadar ? 'bg-slate-900/80 text-slate-400' : 'bg-stone-100 text-stone-500'}`}>\n          <SortHeader label=\"Conf\" col={1} sortKey=\"confidence\" current={sortKey} dir={sortDir} onSort={toggleSort} />\n          <SortHeader label=\"Type\" col={2} sortKey=\"type\" current={sortKey} dir={sortDir} onSort={toggleSort} />\n          <div className=\"col-span-7\">Finding</div>\n          <SortHeader label=\"Src\" col={1} sortKey=\"sources\" current={sortKey} dir={sortDir} onSort={toggleSort} />\n          <SortHeader label=\"Date\" col={1} sortKey=\"date\" current={sortKey} dir={sortDir} onSort={toggleSort} />\n        </div>\n\n        {/* Virtualized Rows */}\n        <div\n          ref={parentRef}\n          className={`max-h-[600px] overflow-auto ${isRadar ? 'divide-cyan-500/5' : 'divide-stone-100'}`}\n        >\n          <div\n            style={{\n              height: `${rowVirtualizer.getTotalSize()}px`,\n              width: '100%',\n              position: 'relative',\n            }}\n          >\n            {rowVirtualizer.getVirtualItems().map((virtualRow) => {\n              const f = sorted[virtualRow.index];\n              return (\n                <div\n                  key={f.id}\n                  data-index={virtualRow.index}\n                  ref={rowVirtualizer.measureElement}\n                  style={{\n                    position: 'absolute',\n                    top: 0,\n                    left: 0,\n                    width: '100%',\n                    transform: `translateY(${virtualRow.start}px)`,\n                  }}\n                  className={`border-b ${isRadar ? 'border-cyan-500/5' : 'border-stone-100'}`}\n                >\n                  <FindingRow\n                    finding={f}\n                    sourceMap={sourceMap}\n                    isExpanded={expandedId === f.id}\n                    onToggle={() => setExpandedId(expandedId === f.id ? null : f.id)}\n                  />\n                </div>\n              );\n            })}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n\nfunction SortHeader({ label, col, sortKey, current, dir, onSort }: {\n  label: string; col: number; sortKey: SortKey; current: SortKey; dir: SortDir;\n  onSort: (k: SortKey) => void;\n}) {\n  const { theme } = useReportTheme();\n  const isRadar = theme === 'radar';\n  const isActive = current === sortKey;\n\n  return (\n    <button\n      onClick={() => onSort(sortKey)}\n      className={`col-span-${col} flex items-center gap-1 hover:text-white transition-colors ${isActive ? (isRadar ? 'text-cyan-400' : 'text-stone-900') : ''}`}\n    >\n      {label}\n      {isActive && <span className=\"text-[8px]\">{dir === 'desc' ? '▼' : '▲'}</span>}\n    </button>\n  );\n}\n\nfunction FindingRow({ finding, sourceMap, isExpanded, onToggle }: {\n  finding: ResearchFinding;\n  sourceMap: Map<string, ResearchSource>;\n  isExpanded: boolean;\n  onToggle: () => void;\n}) {\n  const { theme } = useReportTheme();\n  const styles = useThemeStyles();\n  const { navigateTo } = useNavigation();\n  const isRadar = theme === 'radar';\n  const conf = finding.confidence_score || 0;\n  const srcCount = finding.supporting_sources?.length || 0;\n\n  const confColor = conf >= 0.8 ? 'text-emerald-500' : conf >= 0.5 ? 'text-amber-500' : 'text-rose-500';\n  const confBg = conf >= 0.8 ? 'bg-emerald-500' : conf >= 0.5 ? 'bg-amber-500' : 'bg-rose-500';\n\n  const handleSourceClick = (sourceId: string, e: React.MouseEvent) => {\n    e.preventDefault();\n    e.stopPropagation();\n    navigateTo({ tab: 'sources', sourceId });\n  };\n\n  return (\n    <div className={`${isRadar ? 'hover:bg-slate-800/50' : 'hover:bg-stone-50'} transition-colors`}>\n      <button onClick={onToggle} className=\"w-full grid grid-cols-12 gap-2 px-3 py-2 text-left items-center\">\n        {/* Confidence */}\n        <div className=\"col-span-1 flex items-center gap-1\">\n          <div className={`w-1.5 h-1.5 rounded-full ${confBg}`} />\n          <span className={`text-xs font-mono ${confColor}`}>{Math.round(conf * 100)}</span>\n        </div>\n\n        {/* Type */}\n        <div className=\"col-span-2\">\n          <span className={`text-[10px] px-1.5 py-0.5 rounded ${isRadar ? 'bg-slate-800 text-slate-300' : 'bg-stone-200 text-stone-600'}`}>\n            {finding.finding_type}\n          </span>\n        </div>\n\n        {/* Content */}\n        <div className={`col-span-7 text-xs ${styles.text} ${!isExpanded ? 'truncate' : ''}`}>\n          {finding.content.split('.')[0]}.\n        </div>\n\n        {/* Sources */}\n        <div className={`col-span-1 text-xs text-center ${styles.textMuted}`}>{srcCount}</div>\n\n        {/* Date */}\n        <div className={`col-span-1 text-[10px] ${styles.textMuted}`}>\n          {finding.event_date ? new Date(finding.event_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '—'}\n        </div>\n      </button>\n\n      {/* Expanded content */}\n      <AnimatePresence>\n        {isExpanded && (\n          <motion.div\n            initial={{ height: 0, opacity: 0 }}\n            animate={{ height: 'auto', opacity: 1 }}\n            exit={{ height: 0, opacity: 0 }}\n            className={`px-3 pb-3 ${isRadar ? 'bg-slate-900/50' : 'bg-stone-50'}`}\n          >\n            <div className=\"pl-3 border-l-2 border-cyan-500/30 space-y-2\">\n              <p className={`text-xs leading-relaxed ${styles.text}`}>{finding.content}</p>\n\n              {finding.extracted_data && Object.keys(finding.extracted_data).length > 0 && (\n                <div className=\"flex flex-wrap gap-2\">\n                  {Object.entries(finding.extracted_data).slice(0, 4).map(([k, v]) => (\n                    <span key={k} className={`text-[10px] px-2 py-1 rounded ${isRadar ? 'bg-indigo-500/10 text-indigo-300' : 'bg-indigo-50 text-indigo-700'}`}>\n                      {k}: {String(v)}\n                    </span>\n                  ))}\n                </div>\n              )}\n\n              {srcCount > 0 && (\n                <div className=\"flex flex-wrap gap-1\">\n                  {finding.supporting_sources?.slice(0, 3).map(id => {\n                    const src = sourceMap.get(id);\n                    return src ? (\n                      <button\n                        key={id}\n                        onClick={(e) => handleSourceClick(id, e)}\n                        className={`text-[10px] ${isRadar ? 'text-cyan-400 hover:text-cyan-300' : 'text-blue-600 hover:underline'} flex items-center gap-1`}\n                        title=\"View source details\"\n                      >\n                        <span className=\"underline\">{src.domain}</span>\n                        <svg className=\"w-3 h-3 opacity-50\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                          <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14\" />\n                        </svg>\n                      </button>\n                    ) : null;\n                  })}\n                </div>\n              )}\n            </div>\n          </motion.div>\n        )}\n      </AnimatePresence>\n    </div>\n  );\n}\n","numLines":302,"startLine":1,"totalLines":302}}}
