tance by type.\"\"\"\n    template_class = TEMPLATES.get(template_type, InvestigativeTemplate)\n    return template_class()\n\n\n__all__ = [\n    \"BaseTemplate\",\n    \"InvestigativeTemplate\",\n    \"FinancialTemplate\",\n    \"CompetitiveTemplate\",\n    \"LegalTemplate\",\n    \"TechMarketTemplate\",\n    \"ContractTemplate\",\n    \"UnderstandingTemplate\",\n    \"DueDiligenceTemplate\",\n    \"PurchaseDecisionTemplate\",\n    \"ReputationTemplate\",\n    \"get_template\",\n    \"TEMPLATES\",\n]\n","numLines":53,"startLine":1,"totalLines":53}}}
