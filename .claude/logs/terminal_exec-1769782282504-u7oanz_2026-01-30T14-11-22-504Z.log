[2026-01-30T14:11:52.374Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Rfqgq53P5xEsvs7y6sFT86","type":"tool_result","content":"     1→\"\"\"Tech market research template for 2025 developments and 2026 predictions.\"\"\"\n     2→\n     3→from typing import List, Dict, Any, Optional\n     4→from datetime import datetime\n     5→\n     6→from .base import BaseTemplate, TemplateConfig, FindingTypeConfig\n     7→from ..services.report_components import (\n     8→    ComponentType, ReportHints\n     9→)\n    10→\n    11→\n    12→# ========== TEMPLATE CONFIGURATION ==========\n    13→\n    14→TECH_MARKET_CONFIG = TemplateConfig(\n    15→    search_intro=\"You are a technology market analyst planning comprehensive research on developer tools, infrastructure, and enterprise technology trends.\",\n    16→    search_angles=[\n    17→        {\n    18→            \"name\": \"SOFTWARE DEVELOPMENT ECOSYSTEM\",\n    19→            \"items\": [\n    20→                \"Programming languages: adoption trends, new releases, performance comparisons\",\n    21→                \"Frameworks: frontend (React, Vue, Svelte, Next.js), backend (Node, Go, Rust, Python)\",\n    22→                \"IDEs and development tools: VS Code extensions, JetBrains, AI coding assistants\",\n    23→                \"Testing: test frameworks, quality engineering, shift-left practices\",\n    24→                \"Developer productivity: pair programming, code review tools, documentation\",\n    25→            ]\n    26→        },\n    27→        {\n    28→            \"name\": \"AI/ML AND FULL STACK INFRASTRUCTURE\",\n    29→            \"items\": [\n    30→                \"LLM platforms: OpenAI, Anthropic, Google, open-source models (Llama, Mistral)\",\n    31→                \"AI coding assistants: GitHub Copilot, Cursor, Codeium, Tabnine adoption\",\n    32→                \"MLOps tools: model training, deployment, monitoring, vector databases\",\n    33→                \"Cloud platforms: AWS, Azure, GCP innovations, multi-cloud strategies\",\n    34→                \"Edge AI and on-device inference trends\",\n    35→            ]\n    36→        },\n    37→        {\n    38→            \"name\": \"DEVOPS AND PLATFORM ENGINEERING\",\n    39→            \"items\": [\n    40→                \"Platform engineering: internal developer platforms, golden paths\",\n    41→                \"GitOps and infrastructure as code: Terraform, Pulumi, Crossplane\",\n    42→                \"Containers and orchestration: Kubernetes ecosystem, service mesh\",\n    43→                \"CI/CD innovations: GitHub Actions, GitLab CI, Dagger\",\n    44→                \"Observability: OpenTelemetry, distributed tracing, AIOps\",\n    45→            ]\n    46→        },\n    47→        {\n    48→            \"name\": \"ENTERPRISE TECH STACK\",\n    49→            \"items\": [\n    50→                \"Security: DevSecOps, zero-trust, SAST/DAST, supply chain security\",\n    51→                \"Databases: NewSQL, time-series, graph databases, serverless databases\",\n    52→                \"APIs: GraphQL adoption, API gateways, API-first development\",\n    53→                \"Data engineering: data mesh, lakehouse, real-time analytics\",\n    54→                \"Microservices: event-driven architecture, distributed systems\",\n    55→            ]\n    56→        },\n    57→        {\n    58→            \"name\": \"MARKET DYNAMICS\",\n    59→            \"items\": [\n    60→                \"Funding rounds and valuations for developer tools companies\",\n    61→                \"M&A activity and consolidation trends\",\n    62→                \"Developer survey results (Stack Overflow, JetBrains, GitHub)\",\n    63→                \"Enterprise adoption case studies and ROI analysis\",\n    64→                \"Open source project health and governance\",\n    65→            ]\n    66→        },\n    67→        {\n    68→            \"name\": \"TEMPORAL FOCUS\",\n    69→            \"items\": [\n    70→                \"Include '2025' in searches for current developments\",\n    71→                \"Include '2026 predictions' or 'roadmap 2026' for future trends\",\n    72→                \"Search for 'State of X 2025' reports where relevant\",\n    73→                \"Include analyst predictions and market forecasts\",\n    74→            ]\n    75→        },\n    76→    ],\n    77→    search_depth_guidance={\n    78→        \"quick\": \"4-5 searches on key emerging tech and major trends\",\n    79→        \"standard\": \"8-10 searches covering all domains with market dynamics\",\n    80→        \"deep\": \"12+ searches with comprehensive coverage including funding, predictions, and niche areas\",\n    81→    },\n    82→\n    83→    extraction_intro=\"You are a technology market analyst extracting key findings for developer tools research. CRITICAL: Use EXACT finding_type values specified below - they map to UI components (Tech Radar).\",\n    84→    finding_types=[\n    85→        FindingTypeConfig(\n    86→            name=\"tech_trend\",\n    87→            display_name=\"Tech Trend\",\n    88→            description=\"New technologies gaining adoption (for Tech Radar visualization). Emerging patterns in developer tools, frameworks, languages. Technical architecture shifts, new paradigms.\",\n    89→            extracted_data_schema='{\"technology\": \"...\", \"maturity\": \"adopt|trial|assess|hold\", \"adoption_rate\": 40, \"momentum\": \"growing|stable|declining\"}',\n    90→            analysis_fallback=\"This technology trend reflects evolving developer preferences and may indicate future adoption patterns.\",\n    91→        ),\n    92→        FindingTypeConfig(\n    93→            name=\"market_trend\",\n    94→            display_name=\"Market Trend\",\n    95→            description=\"Market size, growth rates, TAM/SAM estimates. Competitive landscape changes, consolidation. Industry-wide shifts and inflection points.\",\n    96→            extracted_data_schema='{\"market_size\": \"...\", \"growth_rate\": \"...\", \"segment\": \"...\", \"trend_direction\": \"growing|stable|declining\"}',\n    97→            analysis_fallback=\"This market trend provides context for understanding the broader technology landscape.\",\n    98→        ),\n    99→        FindingTypeConfig(\n   100→            name=\"adoption_pattern\",\n   101→            display_name=\"Adoption Pattern\",\n   102→            description=\"Developer adoption rates with specific percentages. Enterprise vs startup adoption differences. Geographic or segment adoption variations.\",\n   103→            extracted_data_schema='{\"tool\": \"...\", \"adoption_rate\": 40, \"segment\": \"enterprise|startup|all\", \"growth_yoy\": \"...\"}',\n   104→            analysis_fallback=\"This adoption pattern helps understand real-world technology uptake and usage trends.\",\n   105→        ),\n   106→        FindingTypeConfig(\n   107→            name=\"financial_metric\",\n   108→            display_name=\"Financial Metric\",\n   109→            description=\"Funding rounds, valuations, revenue figures. M&A activity and deal values. Pricing changes, business model shifts.\",\n   110→            extracted_data_schema='{\"company\": \"...\", \"metric\": \"funding|revenue|valuation\", \"value\": \"...\", \"round\": \"...\", \"investors\": [...]}',\n   111→            analysis_fallback=\"This financial metric provides insight into market investment and company valuations.\",\n   112→        ),\n   113→        FindingTypeConfig(\n   114→            name=\"prediction\",\n   115→            display_name=\"Prediction\",\n   116→            description=\"2026 forecasts and roadmaps. Analyst predictions with timelines. Technology evolution predictions.\",\n   117→            extracted_data_schema='{\"prediction\": \"...\", \"timeline\": \"2026\", \"confidence\": 0.8, \"source\": \"...\", \"prediction_basis\": [...]}',\n   118→            analysis_fallback=\"This prediction offers a forward-looking perspective on technology evolution.\",\n   119→        ),\n   120→        FindingTypeConfig(\n   121→            name=\"red_flag\",\n   122→            display_name=\"Red Flag\",\n   123→            description=\"Declining adoption, negative developer sentiment. Project stagnation, maintainer burnout. Security issues, funding problems.\",\n   124→            extracted_data_schema='{\"issue\": \"...\", \"severity\": \"high|medium|low\", \"affected_projects\": [...], \"evidence\": \"...\"}',\n   125→            analysis_fallback=\"This red flag indicates potential concerns that warrant monitoring.\",\n   126→        ),\n   127→    ],\n   128→    analysis_instruction=\"\"\"YOUR EXPERT ANALYTICAL COMMENTARY (REQUIRED - 2-4 sentences) explaining:\n   129→  * Why this trend/finding matters for the technology landscape\n   130→  * What it implies for developers, enterprises, or the market\n   131→  * Any caveats, counter-trends, or nuances to consider\"\"\",\n   132→    extraction_guidelines=\"\"\"CRITICAL: The \"analysis\" field must provide substantive reasoning, not just describe the finding.\n   133→Good example: \"This adoption rate represents a major inflection point. The 40% threshold typically signals mainstream adoption in developer tools. However, the 'adoption' definition varies - active daily use vs occasional use shows different patterns. Enterprise adoption lags individual developers by 12-18 months.\"\n   134→\n   135→IMPORTANT:\n   136→- Be skeptical of vendor-provided adoption statistics\n   137→- Note methodology differences between surveys\n   138→- Distinguish between hype and verified adoption\"\"\",\n   139→\n   140→    priority_finding_types=[\"prediction\", \"tech_trend\", \"adoption_pattern\", \"financial_metric\", \"market_trend\", \"red_flag\"],\n   141→    grouping_order=[\"prediction\", \"tech_trend\", \"adoption_pattern\", \"financial_metric\", \"market_trend\", \"red_flag\"],\n   142→)\n   143→\n   144→\n   145→class TechMarketTemplate(BaseTemplate):\n   146→    \"\"\"Template for technology market analysis and trend research.\"\"\"\n   147→\n   148→    template_id = \"tech_market\"\n   149→    template_name = \"Tech Market Analysis\"\n   150→    description = \"Technology market trends, 2025 developments, and 2026 predictions\"\n   151→\n   152→    # Data-driven configuration\n   153→    config = TECH_MARKET_CONFIG\n   154→\n   155→    # Report hints for component-based rendering\n   156→    report_hints = ReportHints(\n   157→        template_type=\"tech_market\",\n   158→        structure=\"quantitative_first\",\n   159→        findings_grouping=\"category\",\n   160→        tone=\"analytical\",\n   161→        decision_format=\"recommendation\",\n   162→        emphasis=[\"adoption_metrics\", \"market_trends\", \"technology_comparison\"],\n   163→        required_components=[\n   164→            ComponentType.TECH_RADAR,\n   165→            ComponentType.METRIC_CARDS,\n   166→            ComponentType.FINDINGS_TABLE,\n   167→        ],\n   168→        optional_components=[\n   169→            ComponentType.TIMELINE,\n   170→            ComponentType.COMPARISON_TABLE,\n   171→            ComponentType.PREDICTION_CARDS,\n   172→            ComponentType.KEY_INSIGHTS,\n   173→        ],\n   174→        visualization_preference=[\"tech_radar\", \"adoption_chart\", \"comparison_matrix\"],\n   175→        custom_sections={\n   176→            \"primary_metric\": \"adoption_rate\",\n   177→            \"show_funding_rounds\": True,\n   178→            \"prediction_focus\": \"2026\",\n   179→        }\n   180→    )\n   181→\n   182→    # Expert perspectives: 4 VC/Startup + 4 Developer Community\n   183→    default_perspectives = [\n   184→        # VC & Startup focused\n   185→        \"venture_capitalist\",\n   186→        \"startup_founder\",\n   187→        \"product_manager\",\n   188→        \"developer_advocate\",\n   189→        # Developer Community\n   190→        \"open_source_maintainer\",\n   191→        \"devrel_engineer\",\n   192→        \"senior_engineer\",\n   193→        \"platform_engineer\",\n   194→    ]\n   195→\n   196→    default_max_searches = 12\n   197→\n   198→    # Tech market is MOST prone to hype, vendor marketing, and inflated claims\n   199→    # Adoption rates vary wildly by definition, predictions are often wrong\n   200→    # Needs maximum verification to separate signal from noise\n   201→    verification_config = {\n   202→        \"cross_reference\": \"thorough\",      # Adoption numbers vary wildly\n   203→        \"bias_detection\": \"thorough\",       # Vendor marketing everywhere\n   204→        \"expert_sanity_check\": \"thorough\",  # Flag hype and unrealistic claims\n   205→        \"source_quality\": \"thorough\",       # Distinguish surveys from blogs\n   206→    }\n   207→\n   208→    def get_supported_report_variants(self) -> List[str]:\n   209→        \"\"\"Tech market template supports trend_forecast and vc_briefing variants.\"\"\"\n   210→        return [\"full_report\", \"executive_summary\", \"trend_forecast\", \"vc_briefing\"]\n   211→\n   212→    def generate_trend_forecast(\n   213→        self,\n   214→        result: Dict[str, Any],\n   215→        title: Optional[str] = None,\n   216→    ) -> str:\n   217→        \"\"\"Generate trend forecast report - tech market-specific variant.\"\"\"\n   218→        query = result.get(\"query\", \"Unknown\")\n   219→        report_title = title or f\"Tech Trend Forecast: {query[:40]}\"\n   220→\n   221→        sections = []\n   222→        sections.append(f\"# {report_title}\")\n   223→        sections.append(\"\")\n   224→        sections.append(f\"**Subject:** {query}\")\n   225→        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n   226→        sections.append(\"\")\n   227→        sections.append(\"---\")\n   228→        sections.append(\"\")\n   229→\n   230→        findings = result.get(\"findings\", [])\n   231→        perspectives = result.get(\"perspectives\", [])\n   232→\n   233→        # 2026 Predictions (most important)\n   234→        predictions = [f for f in findings if f.get(\"finding_type\") == \"prediction\"\n   235→                       or f.get(\"temporal_context\") == \"predicted\"]\n   236→        if predictions:\n   237→            sections.append(\"## 2026 Predictions\")\n   238→            sections.append(\"\")\n   239→            for pred in predictions:\n   240→                extracted = pred.get(\"extracted_data\", {})\n   241→                if extracted and isinstance(extracted, dict):\n   242→                    prediction_text = extracted.get(\"prediction\", \"\")\n   243→                    timeframe = extracted.get(\"timeframe\", \"2026\")\n   244→                    confidence = extracted.get(\"confidence\", 0.5)\n   245→                    if isinstance(confidence, (int, float)):\n   246→                        conf_label = \"High\" if confidence >= 0.7 else \"Medium\" if confidence >= 0.4 else \"Low\"\n   247→                    else:\n   248→                        conf_label = str(confidence).title()\n   249→                    if prediction_text:\n   250→                        sections.append(f\"### {prediction_text[:80]}\")\n   251→                        sections.append(\"\")\n   252→                        sections.append(f\"**Timeframe:** {timeframe} | **Confidence:** {conf_label}\")\n   253→                        basis = extracted.get(\"prediction_basis\", [])\n   254→                        if basis:\n   255→                            sections.append(\"\")\n   256→                            sections.append(\"**Supporting Evidence:**\")\n   257→                            for b in basis[:3]:\n   258→                                sections.append(f\"- {b}\")\n   259→                        sections.append(\"\")\n   260→                else:\n   261→                    sections.append(f\"- {pred.get('summary') or pred.get('content', '')[:150]}\")\n   262→            sections.append(\"\")\n   263→\n   264→        # Perspective Predictions\n   265→        all_predictions = []\n   266→        for p in perspectives:\n   267→            preds = p.get(\"predictions\", [])\n   268→            for pred in preds:\n   269→                if isinstance(pred, dict):\n   270→                    pred[\"source_perspective\"] = p.get(\"perspective_type\", \"\")\n   271→                    all_predictions.append(pred)\n   272→        if all_predictions:\n   273→            sections.append(\"## Expert Predictions\")\n   274→            sections.append(\"\")\n   275→            for pred in all_predictions[:8]:\n   276→                prediction_text = pred.get(\"prediction\", \"\")\n   277→                timeline = pred.get(\"timeline\", \"2026\")\n   278→                confidence = pred.get(\"confidence\", \"medium\")\n   279→                source = pred.get(\"source_perspective\", \"\").replace(\"_\", \" \").title()\n   280→                if prediction_text:\n   281→                    sections.append(f\"- **{source}**: {prediction_text} (Timeline: {timeline}, Confidence: {confidence})\")\n   282→            sections.append(\"\")\n   283→\n   284→        # Tech Trends\n   285→        tech_trends = [f for f in findings if f.get(\"finding_type\") == \"tech_trend\"]\n   286→        if tech_trends:\n   287→            sections.append(\"## Current Tech Trends\")\n   288→            sections.append(\"\")\n   289→            for t in tech_trends[:6]:\n   290→                extracted = t.get(\"extracted_data\", {})\n   291→                if extracted and isinstance(extracted, dict):\n   292→                    tech = extracted.get(\"technology\", \"\")\n   293→                    maturity = extracted.get(\"maturity\", \"\")\n   294→                    if tech:\n   295→                        sections.append(f\"- **{tech}**: {maturity} stage\")\n   296→                else:\n   297→                    sections.append(f\"- {t.get('summary') or t.get('content', '')[:100]}\")\n   298→            sections.append(\"\")\n   299→\n   300→        # Adoption Patterns\n   301→        adoption = [f for f in findings if f.get(\"finding_type\") == \"adoption_pattern\"]\n   302→        if adoption:\n   303→            sections.append(\"## Adoption Patterns\")\n   304→            sections.append(\"\")\n   305→            for a in adoption[:6]:\n   306→                extracted = a.get(\"extracted_data\", {})\n   307→                if extracted and isinstance(extracted, dict):\n   308→                    tool = extracted.get(\"tool\", \"\")\n   309→                    rate = extracted.get(\"adoption_rate\", \"\")\n   310→                    if tool:\n   311→                        sections.append(f\"- **{tool}**: {rate}% adoption\")\n   312→                else:\n   313→                    sections.append(f\"- {a.get('summary') or a.get('content', '')[:100]}\")\n   314→            sections.append(\"\")\n   315→\n   316→        return \"\\n\".join(sections)\n   317→\n   318→    def generate_vc_briefing(\n   319→        self,\n   320→        result: Dict[str, Any],\n   321→        title: Optional[str] = None,\n   322→    ) -> str:\n   323→        \"\"\"Generate VC briefing report - tech market-specific variant.\"\"\"\n   324→        query = result.get(\"query\", \"Unknown\")\n   325→        report_title = title or f\"VC Briefing: {query[:40]}\"\n   326→\n   327→        sections = []\n   328→        sections.append(f\"# {report_title}\")\n   329→        sections.append(\"\")\n   330→        sections.append(f\"**Subject:** {query}\")\n   331→        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n   332→        sections.append(\"\")\n   333→        sections.append(\"---\")\n   334→        sections.append(\"\")\n   335→\n   336→        findings = result.get(\"findings\", [])\n   337→        perspectives = result.get(\"perspectives\", [])\n   338→\n   339→        # Investment Thesis from VC Perspective\n   340→        vc_perspective = next((p for p in perspectives if \"venture\" in p.get(\"perspective_type\", \"\").lower()\n   341→                               or \"vc\" in p.get(\"perspective_type\", \"\").lower()), None)\n   342→        if vc_perspective:\n   343→            sections.append(\"## Investment Thesis\")\n   344→            sections.append(\"\")\n   345→            sections.append(vc_perspective.get(\"analysis_text\", \"\")[:600])\n   346→            sections.append(\"\")\n   347→            insights = vc_perspective.get(\"key_insights\", [])\n   348→            if insights:\n   349→                sections.append(\"**Key Investment Insights:**\")\n   350→                for i in insights[:4]:\n   351→                    sections.append(f\"- {i}\")\n   352→            sections.append(\"\")\n   353→\n   354→        # Financial Metrics (Funding)\n   355→        financial = [f for f in findings if f.get(\"finding_type\") == \"financial_metric\"]\n   356→        if financial:\n   357→            sections.append(\"## Recent Funding Activity\")\n   358→            sections.append(\"\")\n   359→            for fr in financial[:8]:\n   360→                extracted = fr.get(\"extracted_data\", {})\n   361→                if extracted and isinstance(extracted, dict):\n   362→                    company = extracted.get(\"company\", \"Unknown\")\n   363→                    metric = extracted.get(\"metric\", \"\")\n   364→                    value = extracted.get(\"value\", \"\")\n   365→                    sections.append(f\"- **{company}**: {metric} - {value}\")\n   366→                else:\n   367→                    sections.append(f\"- {fr.get('summary') or fr.get('content', '')[:100]}\")\n   368→            sections.append(\"\")\n   369→\n   370→        # Market Trends\n   371→        market_trends = [f for f in findings if f.get(\"finding_type\") == \"market_trend\"]\n   372→        if market_trends:\n   373→            sections.append(\"## Market Dynamics\")\n   374→            sections.append(\"\")\n   375→            for m in market_trends[:5]:\n   376→                sections.append(f\"- {m.get('summary') or m.get('content', '')[:100]}\")\n   377→            sections.append(\"\")\n   378→\n   379→        # Red Flags\n   380→        red_flags = [f for f in findings if f.get(\"finding_type\") == \"red_flag\"]\n   381→        if red_flags:\n   382→            sections.append(\"## Investment Risks\")\n   383→            sections.append(\"\")\n   384→            for rf in red_flags[:5]:\n   385→                sections.append(f\"- {rf.get('summary') or rf.get('content', '')[:100]}\")\n   386→            sections.append(\"\")\n   387→\n   388→        # Warnings from perspectives\n   389→        all_warnings = []\n   390→        for p in perspectives:\n   391→            all_warnings.extend(p.get(\"warnings\", []))\n   392→        if all_warnings:\n   393→            sections.append(\"## Risk Warnings\")\n   394→            sections.append(\"\")\n   395→            for w in all_warnings[:5]:\n   396→                sections.append(f\"- {w}\")\n   397→            sections.append(\"\")\n   398→\n   399→        return \"\\n\".join(sections)\n   400→\n   401→    def _generate_key_sections(self, result: Dict[str, Any]) -> str:\n   402→        \"\"\"Generate tech market-specific key sections: Predictions, Funding Highlights.\"\"\"\n   403→        findings = result.get(\"findings\", [])\n   404→        sections = []\n   405→\n   406→        # 2026 Predictions Highlight\n   407→        predictions = [f for f in findings if f.get(\"finding_type\") == \"prediction\"\n   408→                       or f.get(\"temporal_context\") == \"predicted\"]\n   409→        if predictions:\n   410→            sections.append(\"## 2026 Outlook Highlights\")\n   411→            sections.append(\"\")\n   412→            for p in predictions[:4]:\n   413→                sections.append(f\"- {p.get('summary') or p.get('content', '')[:100]}\")\n   414→            sections.append(\"\")\n   415→\n   416→        # Recent Funding\n   417→        funding = [f for f in findings if f.get(\"finding_type\") == \"financial_metric\"]\n   418→        if funding:\n   419→            sections.append(\"## Notable Funding Rounds\")\n   420→            sections.append(\"\")\n   421→            for fr in funding[:4]:\n   422→                sections.append(f\"- {fr.get('summary') or fr.get('content', '')[:100]}\")\n   423→            sections.append(\"\")\n   424→\n   425→        return \"\\n\".join(sections)\n   426→\n   427→    def _generate_executive_highlights(self, result: Dict[str, Any]) -> str:\n   428→        \"\"\"Generate tech market-specific executive highlights.\"\"\"\n   429→        findings = result.get(\"findings\", [])\n   430→        sections = []\n   431→\n   432→        # Key trends\n   433→        tech_trends = [f for f in findings if f.get(\"finding_type\") == \"tech_trend\"]\n   434→        if tech_trends:\n   435→            sections.append(\"## Key Tech Trends\")\n   436→            sections.append(\"\")\n   437→            for t in tech_trends[:3]:\n   438→                sections.append(f\"- {t.get('summary') or t.get('content', '')[:80]}\")\n   439→            sections.append(\"\")\n   440→\n   441→        return \"\\n\".join(sections)\n   442→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"1f794eae-4516-40cc-88e2-7a8e0f0f09e3","uuid":"3197bfda-00f8-4ab9-802c-df3e6a2f4708","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\actor\\src\\templates\\tech_market.py","content":"\"\"\"Tech market research template for 2025 developments and 2026 predictions.\"\"\"\n\nfrom typing import List, Dict, Any, Optional\nfrom datetime import datetime\n\nfrom .base import BaseTemplate, TemplateConfig, FindingTypeConfig\nfrom ..services.report_components import (\n    ComponentType, ReportHints\n)\n\n\n# ========== TEMPLATE CONFIGURATION ==========\n\nTECH_MARKET_CONFIG = TemplateConfig(\n    search_intro=\"You are a technology market analyst planning comprehensive research on developer tools, infrastructure, and enterprise technology trends.\",\n    search_angles=[\n        {\n            \"name\": \"SOFTWARE DEVELOPMENT ECOSYSTEM\",\n            \"items\": [\n                \"Programming languages: adoption trends, new releases, performance comparisons\",\n                \"Frameworks: frontend (React, Vue, Svelte, Next.js), backend (Node, Go, Rust, Python)\",\n                \"IDEs and development tools: VS Code extensions, JetBrains, AI coding assistants\",\n                \"Testing: test frameworks, quality engineering, shift-left practices\",\n                \"Developer productivity: pair programming, code review tools, documentation\",\n            ]\n        },\n        {\n            \"name\": \"AI/ML AND FULL STACK INFRASTRUCTURE\",\n            \"items\": [\n                \"LLM platforms: OpenAI, Anthropic, Google, open-source models (Llama, Mistral)\",\n                \"AI coding assistants: GitHub Copilot, Cursor, Codeium, Tabnine adoption\",\n                \"MLOps tools: model training, deployment, monitoring, vector databases\",\n                \"Cloud platforms: AWS, Azure, GCP innovations, multi-cloud strategies\",\n                \"Edge AI and on-device inference trends\",\n            ]\n        },\n        {\n            \"name\": \"DEVOPS AND PLATFORM ENGINEERING\",\n            \"items\": [\n                \"Platform engineering: internal developer platforms, golden paths\",\n                \"GitOps and infrastructure as code: Terraform, Pulumi, Crossplane\",\n                \"Containers and orchestration: Kubernetes ecosystem, service mesh\",\n                \"CI/CD innovations: GitHub Actions, GitLab CI, Dagger\",\n                \"Observability: OpenTelemetry, distributed tracing, AIOps\",\n            ]\n        },\n        {\n            \"name\": \"ENTERPRISE TECH STACK\",\n            \"items\": [\n                \"Security: DevSecOps, zero-trust, SAST/DAST, supply chain security\",\n                \"Databases: NewSQL, time-series, graph databases, serverless databases\",\n                \"APIs: GraphQL adoption, API gateways, API-first development\",\n                \"Data engineering: data mesh, lakehouse, real-time analytics\",\n                \"Microservices: event-driven architecture, distributed systems\",\n            ]\n        },\n        {\n            \"name\": \"MARKET DYNAMICS\",\n            \"items\": [\n                \"Funding rounds and valuations for developer tools companies\",\n                \"M&A activity and consolidation trends\",\n                \"Developer survey results (Stack Overflow, JetBrains, GitHub)\",\n                \"Enterprise adoption case studies and ROI analysis\",\n                \"Open source project health and governance\",\n            ]\n        },\n        {\n            \"name\": \"TEMPORAL FOCUS\",\n            \"items\": [\n                \"Include '2025' in searches for current developments\",\n                \"Include '2026 predictions' or 'roadmap 2026' for future trends\",\n                \"Search for 'State of X 2025' reports where relevant\",\n                \"Include analyst predictions and market forecasts\",\n            ]\n        },\n    ],\n    search_depth_guidance={\n        \"quick\": \"4-5 searches on key emerging tech and major trends\",\n        \"standard\": \"8-10 searches covering all domains with market dynamics\",\n        \"deep\": \"12+ searches with comprehensive coverage including funding, predictions, and niche areas\",\n    },\n\n    extraction_intro=\"You are a technology market analyst extracting key findings for developer tools research. CRITICAL: Use EXACT finding_type values specified below - they map to UI components (Tech Radar).\",\n    finding_types=[\n        FindingTypeConfig(\n            name=\"tech_trend\",\n            display_name=\"Tech Trend\",\n            description=\"New technologies gaining adoption (for Tech Radar visualization). Emerging patterns in developer tools, frameworks, languages. Technical architecture shifts, new paradigms.\",\n            extracted_data_schema='{\"technology\": \"...\", \"maturity\": \"adopt|trial|assess|hold\", \"adoption_rate\": 40, \"momentum\": \"growing|stable|declining\"}',\n            analysis_fallback=\"This technology trend reflects evolving developer preferences and may indicate future adoption patterns.\",\n        ),\n        FindingTypeConfig(\n            name=\"market_trend\",\n            display_name=\"Market Trend\",\n            description=\"Market size, growth rates, TAM/SAM estimates. Competitive landscape changes, consolidation. Industry-wide shifts and inflection points.\",\n            extracted_data_schema='{\"market_size\": \"...\", \"growth_rate\": \"...\", \"segment\": \"...\", \"trend_direction\": \"growing|stable|declining\"}',\n            analysis_fallback=\"This market trend provides context for understanding the broader technology landscape.\",\n        ),\n        FindingTypeConfig(\n            name=\"adoption_pattern\",\n            display_name=\"Adoption Pattern\",\n            description=\"Developer adoption rates with specific percentages. Enterprise vs startup adoption differences. Geographic or segment adoption variations.\",\n            extracted_data_schema='{\"tool\": \"...\", \"adoption_rate\": 40, \"segment\": \"enterprise|startup|all\", \"growth_yoy\": \"...\"}',\n            analysis_fallback=\"This adoption pattern helps understand real-world technology uptake and usage trends.\",\n        ),\n        FindingTypeConfig(\n            name=\"financial_metric\",\n            display_name=\"Financial Metric\",\n            description=\"Funding rounds, valuations, revenue figures. M&A activity and deal values. Pricing changes, business model shifts.\",\n            extracted_data_schema='{\"company\": \"...\", \"metric\": \"funding|revenue|valuation\", \"value\": \"...\", \"round\": \"...\", \"investors\": [...]}',\n            analysis_fallback=\"This financial metric provides insight into market investment and company valuations.\",\n        ),\n        FindingTypeConfig(\n            name=\"prediction\",\n            display_name=\"Prediction\",\n            description=\"2026 forecasts and roadmaps. Analyst predictions with timelines. Technology evolution predictions.\",\n            extracted_data_schema='{\"prediction\": \"...\", \"timeline\": \"2026\", \"confidence\": 0.8, \"source\": \"...\", \"prediction_basis\": [...]}',\n            analysis_fallback=\"This prediction offers a forward-looking perspective on technology evolution.\",\n        ),\n        FindingTypeConfig(\n            name=\"red_flag\",\n            display_name=\"Red Flag\",\n            description=\"Declining adoption, negative developer sentiment. Project stagnation, maintainer burnout. Security issues, funding problems.\",\n            extracted_data_schema='{\"issue\": \"...\", \"severity\": \"high|medium|low\", \"affected_projects\": [...], \"evidence\": \"...\"}',\n            analysis_fallback=\"This red flag indicates potential concerns that warrant monitoring.\",\n        ),\n    ],\n    analysis_instruction=\"\"\"YOUR EXPERT ANALYTICAL COMMENTARY (REQUIRED - 2-4 sentences) explaining:\n  * Why this trend/finding matters for the technology landscape\n  * What it implies for developers, enterprises, or the market\n  * Any caveats, counter-trends, or nuances to consider\"\"\",\n    extraction_guidelines=\"\"\"CRITICAL: The \"analysis\" field must provide substantive reasoning, not just describe the finding.\nGood example: \"This adoption rate represents a major inflection point. The 40% threshold typically signals mainstream adoption in developer tools. However, the 'adoption' definition varies - active daily use vs occasional use shows different patterns. Enterprise adoption lags individual developers by 12-18 months.\"\n\nIMPORTANT:\n- Be skeptical of vendor-provided adoption statistics\n- Note methodology differences between surveys\n- Distinguish between hype and verified adoption\"\"\",\n\n    priority_finding_types=[\"prediction\", \"tech_trend\", \"adoption_pattern\", \"financial_metric\", \"market_trend\", \"red_flag\"],\n    grouping_order=[\"prediction\", \"tech_trend\", \"adoption_pattern\", \"financial_metric\", \"market_trend\", \"red_flag\"],\n)\n\n\nclass TechMarketTemplate(BaseTemplate):\n    \"\"\"Template for technology market analysis and trend research.\"\"\"\n\n    template_id = \"tech_market\"\n    template_name = \"Tech Market Analysis\"\n    description = \"Technology market trends, 2025 developments, and 2026 predictions\"\n\n    # Data-driven configuration\n    config = TECH_MARKET_CONFIG\n\n    # Report hints for component-based rendering\n    report_hints = ReportHints(\n        template_type=\"tech_market\",\n        structure=\"quantitative_first\",\n        findings_grouping=\"category\",\n        tone=\"analytical\",\n        decision_format=\"recommendation\",\n        emphasis=[\"adoption_metrics\", \"market_trends\", \"technology_comparison\"],\n        required_components=[\n            ComponentType.TECH_RADAR,\n            ComponentType.METRIC_CARDS,\n            ComponentType.FINDINGS_TABLE,\n        ],\n        optional_components=[\n            ComponentType.TIMELINE,\n            ComponentType.COMPARISON_TABLE,\n            ComponentType.PREDICTION_CARDS,\n            ComponentType.KEY_INSIGHTS,\n        ],\n        visualization_preference=[\"tech_radar\", \"adoption_chart\", \"comparison_matrix\"],\n        custom_sections={\n            \"primary_metric\": \"adoption_rate\",\n            \"show_funding_rounds\": True,\n            \"prediction_focus\": \"2026\",\n        }\n    )\n\n    # Expert perspectives: 4 VC/Startup + 4 Developer Community\n    default_perspectives = [\n        # VC & Startup focused\n        \"venture_capitalist\",\n        \"startup_founder\",\n        \"product_manager\",\n        \"developer_advocate\",\n        # Developer Community\n        \"open_source_maintainer\",\n        \"devrel_engineer\",\n        \"senior_engineer\",\n        \"platform_engineer\",\n    ]\n\n    default_max_searches = 12\n\n    # Tech market is MOST prone to hype, vendor marketing, and inflated claims\n    # Adoption rates vary wildly by definition, predictions are often wrong\n    # Needs maximum verification to separate signal from noise\n    verification_config = {\n        \"cross_reference\": \"thorough\",      # Adoption numbers vary wildly\n        \"bias_detection\": \"thorough\",       # Vendor marketing everywhere\n        \"expert_sanity_check\": \"thorough\",  # Flag hype and unrealistic claims\n        \"source_quality\": \"thorough\",       # Distinguish surveys from blogs\n    }\n\n    def get_supported_report_variants(self) -> List[str]:\n        \"\"\"Tech market template supports trend_forecast and vc_briefing variants.\"\"\"\n        return [\"full_report\", \"executive_summary\", \"trend_forecast\", \"vc_briefing\"]\n\n    def generate_trend_forecast(\n        self,\n        result: Dict[str, Any],\n        title: Optional[str] = None,\n    ) -> str:\n        \"\"\"Generate trend forecast report - tech market-specific variant.\"\"\"\n        query = result.get(\"query\", \"Unknown\")\n        report_title = title or f\"Tech Trend Forecast: {query[:40]}\"\n\n        sections = []\n        sections.append(f\"# {report_title}\")\n        sections.append(\"\")\n        sections.append(f\"**Subject:** {query}\")\n        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n        sections.append(\"\")\n        sections.append(\"---\")\n        sections.append(\"\")\n\n        findings = result.get(\"findings\", [])\n        perspectives = result.get(\"perspectives\", [])\n\n        # 2026 Predictions (most important)\n        predictions = [f for f in findings if f.get(\"finding_type\") == \"prediction\"\n                       or f.get(\"temporal_context\") == \"predicted\"]\n        if predictions:\n            sections.append(\"## 2026 Predictions\")\n            sections.append(\"\")\n            for pred in predictions:\n                extracted = pred.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    prediction_text = extracted.get(\"prediction\", \"\")\n                    timeframe = extracted.get(\"timeframe\", \"2026\")\n                    confidence = extracted.get(\"confidence\", 0.5)\n                    if isinstance(confidence, (int, float)):\n                        conf_label = \"High\" if confidence >= 0.7 else \"Medium\" if confidence >= 0.4 else \"Low\"\n                    else:\n                        conf_label = str(confidence).title()\n                    if prediction_text:\n                        sections.append(f\"### {prediction_text[:80]}\")\n                        sections.append(\"\")\n                        sections.append(f\"**Timeframe:** {timeframe} | **Confidence:** {conf_label}\")\n                        basis = extracted.get(\"prediction_basis\", [])\n                        if basis:\n                            sections.append(\"\")\n                            sections.append(\"**Supporting Evidence:**\")\n                            for b in basis[:3]:\n                                sections.append(f\"- {b}\")\n                        sections.append(\"\")\n                else:\n                    sections.append(f\"- {pred.get('summary') or pred.get('content', '')[:150]}\")\n            sections.append(\"\")\n\n        # Perspective Predictions\n        all_predictions = []\n        for p in perspectives:\n            preds = p.get(\"predictions\", [])\n            for pred in preds:\n                if isinstance(pred, dict):\n                    pred[\"source_perspective\"] = p.get(\"perspective_type\", \"\")\n                    all_predictions.append(pred)\n        if all_predictions:\n            sections.append(\"## Expert Predictions\")\n            sections.append(\"\")\n            for pred in all_predictions[:8]:\n                prediction_text = pred.get(\"prediction\", \"\")\n                timeline = pred.get(\"timeline\", \"2026\")\n                confidence = pred.get(\"confidence\", \"medium\")\n                source = pred.get(\"source_perspective\", \"\").replace(\"_\", \" \").title()\n                if prediction_text:\n                    sections.append(f\"- **{source}**: {prediction_text} (Timeline: {timeline}, Confidence: {confidence})\")\n            sections.append(\"\")\n\n        # Tech Trends\n        tech_trends = [f for f in findings if f.get(\"finding_type\") == \"tech_trend\"]\n        if tech_trends:\n            sections.append(\"## Current Tech Trends\")\n            sections.append(\"\")\n            for t in tech_trends[:6]:\n                extracted = t.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    tech = extracted.get(\"technology\", \"\")\n                    maturity = extracted.get(\"maturity\", \"\")\n                    if tech:\n                        sections.append(f\"- **{tech}**: {maturity} stage\")\n                else:\n                    sections.append(f\"- {t.get('summary') or t.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Adoption Patterns\n        adoption = [f for f in findings if f.get(\"finding_type\") == \"adoption_pattern\"]\n        if adoption:\n            sections.append(\"## Adoption Patterns\")\n            sections.append(\"\")\n            for a in adoption[:6]:\n                extracted = a.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    tool = extracted.get(\"tool\", \"\")\n                    rate = extracted.get(\"adoption_rate\", \"\")\n                    if tool:\n                        sections.append(f\"- **{tool}**: {rate}% adoption\")\n                else:\n                    sections.append(f\"- {a.get('summary') or a.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        return \"\\n\".join(sections)\n\n    def generate_vc_briefing(\n        self,\n        result: Dict[str, Any],\n        title: Optional[str] = None,\n    ) -> str:\n        \"\"\"Generate VC briefing report - tech market-specific variant.\"\"\"\n        query = result.get(\"query\", \"Unknown\")\n        report_title = title or f\"VC Briefing: {query[:40]}\"\n\n        sections = []\n        sections.append(f\"# {report_title}\")\n        sections.append(\"\")\n        sections.append(f\"**Subject:** {query}\")\n        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n        sections.append(\"\")\n        sections.append(\"---\")\n        sections.append(\"\")\n\n        findings = result.get(\"findings\", [])\n        perspectives = result.get(\"perspectives\", [])\n\n        # Investment Thesis from VC Perspective\n        vc_perspective = next((p for p in perspectives if \"venture\" in p.get(\"perspective_type\", \"\").lower()\n                               or \"vc\" in p.get(\"perspective_type\", \"\").lower()), None)\n        if vc_perspective:\n            sections.append(\"## Investment Thesis\")\n            sections.append(\"\")\n            sections.append(vc_perspective.get(\"analysis_text\", \"\")[:600])\n            sections.append(\"\")\n            insights = vc_perspective.get(\"key_insights\", [])\n            if insights:\n                sections.append(\"**Key Investment Insights:**\")\n                for i in insights[:4]:\n                    sections.append(f\"- {i}\")\n            sections.append(\"\")\n\n        # Financial Metrics (Funding)\n        financial = [f for f in findings if f.get(\"finding_type\") == \"financial_metric\"]\n        if financial:\n            sections.append(\"## Recent Funding Activity\")\n            sections.append(\"\")\n            for fr in financial[:8]:\n                extracted = fr.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    company = extracted.get(\"company\", \"Unknown\")\n                    metric = extracted.get(\"metric\", \"\")\n                    value = extracted.get(\"value\", \"\")\n                    sections.append(f\"- **{company}**: {metric} - {value}\")\n                else:\n                    sections.append(f\"- {fr.get('summary') or fr.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Market Trends\n        market_trends = [f for f in findings if f.get(\"finding_type\") == \"market_trend\"]\n        if market_trends:\n            sections.append(\"## Market Dynamics\")\n            sections.append(\"\")\n            for m in market_trends[:5]:\n                sections.append(f\"- {m.get('summary') or m.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Red Flags\n        red_flags = [f for f in findings if f.get(\"finding_type\") == \"red_flag\"]\n        if red_flags:\n            sections.append(\"## Investment Risks\")\n            sections.append(\"\")\n            for rf in red_flags[:5]:\n                sections.append(f\"- {rf.get('summary') or rf.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Warnings from perspectives\n        all_warnings = []\n        for p in perspectives:\n            all_warnings.extend(p.get(\"warnings\", []))\n        if all_warnings:\n            sections.append(\"## Risk Warnings\")\n            sections.append(\"\")\n            for w in all_warnings[:5]:\n                sections.append(f\"- {w}\")\n            sections.append(\"\")\n\n        return \"\\n\".join(sections)\n\n    def _generate_key_sections(self, result: Dict[str, Any]) -> str:\n        \"\"\"Generate tech market-specific key sections: Predictions, Funding Highlights.\"\"\"\n        findings = result.get(\"findings\", [])\n        sections = []\n\n        # 2026 Predictions Highlight\n        predictions = [f for f in findings if f.get(\"finding_type\") == \"prediction\"\n                       or f.get(\"temporal_context\") == \"predicted\"]\n        if predictions:\n            sections.append(\"## 2026 Outlook Highlights\")\n            sections.append(\"\")\n            for p in predictions[:4]:\n                sections.append(f\"- {p.get('summary') or p.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Recent Funding\n        funding = [f for f in findings if f.get(\"finding_type\") == \"financial_metric\"]\n        if funding:\n            sections.append(\"## Notable Funding Rounds\")\n            sections.append(\"\")\n            for fr in funding[:4]:\n                sections.append(f\"- {fr.get('summary') or fr.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        return \"\\n\".join(sections)\n\n    def _generate_executive_highlights(self, result: Dict[str, Any]) -> str:\n        \"\"\"Generate tech market-specific executive highlights.\"\"\"\n        findings = result.get(\"findings\", [])\n        sections = []\n\n        # Key trends\n        tech_trends = [f for f in findings if f.get(\"finding_type\") == \"tech_trend\"]\n        if tech_trends:\n            sections.append(\"## Key Tech Trends\")\n            sections.append(\"\")\n            for t in tech_trends[:3]:\n                sections.append(f\"- {t.get('summary') or t.get('content', '')[:80]}\")\n            sections.append(\"\")\n\n        return \"\\n\".join(sections)\n","numLines":442,"startLine":1,"totalLines":442}}}
