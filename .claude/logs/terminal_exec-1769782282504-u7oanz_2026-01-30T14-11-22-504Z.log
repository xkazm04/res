         \"items\": [\n    45→                \"Revenue, growth rates, margins\",\n    46→                \"Market share estimates\",\n    47→                \"Investment and R&D spending\",\n    48→                \"Profitability and unit economics\",\n    49→            ]\n    50→        },\n    51→        {\n    52→            \"name\": \"STRATEGIC POSITIONING\",\n    53→            \"items\": [\n    54→                \"Value propositions and target customers\",\n    55→                \"Pricing strategies and models\",\n    56→                \"Distribution and go-to-market approaches\",\n    57→                \"Partnerships and ecosystem plays\",\n    58→            ]\n    59→        },\n    60→        {\n    61→            \"name\": \"COMPETITIVE ADVANTAGES\",\n    62→            \"items\": [\n    63→                \"Technology and IP advantages\",\n    64→                \"Network effects and switching costs\",\n    65→                \"Scale and cost advantages\",\n    66→                \"Brand and reputation\",\n    67→            ]\n    68→        },\n    69→        {\n    70→            \"name\": \"CUSTOMER INTELLIGENCE\",\n    71→            \"items\": [\n    72→                \"Customer reviews and satisfaction\",\n    73→                \"Win/loss analysis patterns\",\n    74→                \"Customer concentration\",\n    75→                \"Churn and retention data\",\n    76→            ]\n    77→        },\n    78→        {\n    79→            \"name\": \"TALENT AND CULTURE\",\n    80→            \"items\": [\n    81→                \"Leadership team background\",\n    82→                \"Key hires and departures\",\n    83→                \"Glassdoor/Indeed reviews\",\n    84→                \"Engineering talent and culture\",\n    85→            ]\n    86→        },\n    87→        {\n    88→            \"name\": \"WEAKNESSES AND THREATS\",\n    89→            \"items\": [\n    90→                \"Known vulnerabilities\",\n    91→                \"Customer complaints\",\n    92→                \"Regulatory challenges\",\n    93→                \"Strategic missteps\",\n    94→            ]\n    95→        },\n    96→        {\n    97→            \"name\": \"FUTURE OUTLOOK\",\n    98→            \"items\": [\n    99→                \"Stated strategies and roadmaps\",\n   100→                \"M&A activity and rumors\",\n   101→                \"Industry trend positioning\",\n   102→            ]\n   103→        },\n   104→    ],\n   105→    search_depth_guidance={\n   106→        \"quick\": \"Focus on top 3 competitors with key metrics only\",\n   107→        \"standard\": \"Cover 5-7 competitors with balanced analysis\",\n   108→        \"deep\": \"Comprehensive coverage of 10+ competitors with detailed profiles\",\n   109→    },\n   110→\n   111→    extraction_intro=\"You are a competitive intelligence analyst extracting key findings for strategic decision-making.\",\n   112→    finding_types=[\n   113→        FindingTypeConfig(\n   114→            name=\"fact\",\n   115→            display_name=\"Market Data\",\n   116→            description=\"Market size, growth rates, segments. Include: metric, value, source, date. Note methodology if available.\",\n   117→            extracted_data_schema='{\"metric\": \"...\", \"value\": \"...\", \"period\": \"...\", \"growth\": \"...\", \"source\": \"...\"}',\n   118→            analysis_fallback=\"This market data provides context for understanding the competitive landscape.\",\n   119→        ),\n   120→        FindingTypeConfig(\n   121→            name=\"actor\",\n   122→            display_name=\"Competitor Profile\",\n   123→            description=\"Company overview, positioning, strategy. Include: company name, segment, key metrics. Note strengths and weaknesses.\",\n   124→            extracted_data_schema='{\"company\": \"...\", \"segment\": \"...\", \"revenue\": \"...\", \"market_share\": \"...\", \"strengths\": [...], \"weaknesses\": [...]}',\n   125→            analysis_fallback=\"This competitor profile helps understand their market position and strategic focus.\",\n   126→        ),\n   127→        FindingTypeConfig(\n   128→            name=\"event\",\n   129→            display_name=\"Market Event\",\n   130→            description=\"Product launches, M&A, leadership changes. Include: date, companies involved, impact. Note strategic implications.\",\n   131→            extracted_data_schema='{\"date\": \"...\", \"companies\": [...], \"event_type\": \"...\", \"impact\": \"...\"}',\n   132→            analysis_fallback=\"This market event may signal strategic shifts or competitive dynamics changes.\",\n   133→        ),\n   134→        FindingTypeConfig(\n   135→            name=\"relationship\",\n   136→            display_name=\"Competitive Dynamics\",\n   137→            description=\"Head-to-head competition, partnerships, ecosystems. Include: companies, nature of relationship. Note competitive intensity.\",\n   138→            extracted_data_schema='{\"company_a\": \"...\", \"company_b\": \"...\", \"relationship_type\": \"...\", \"competitive_intensity\": \"high/medium/low\"}',\n   139→            analysis_fallback=\"This competitive relationship reveals market dynamics and potential strategic implications.\",\n   140→        ),\n   141→        FindingTypeConfig(\n   142→            name=\"evidence\",\n   143→            display_name=\"Market Share Data\",\n   144→            description=\"Market share percentages, rankings. Include: source, methodology, time period. Note trends and changes.\",\n   145→            extracted_data_schema='{\"company\": \"...\", \"market_share\": \"...\", \"ranking\": \"...\", \"source\": \"...\", \"period\": \"...\", \"trend\": \"...\"}',\n   146→            analysis_fallback=\"This market share data helps quantify competitive positions.\",\n   147→        ),\n   148→        FindingTypeConfig(\n   149→            name=\"pattern\",\n   150→            display_name=\"Strategic Move\",\n   151→            description=\"Pricing changes, go-to-market shifts, pivots. Include: company, action, timing. Note competitive response.\",\n   152→            extracted_data_schema='{\"company\": \"...\", \"action\": \"...\", \"timing\": \"...\", \"competitive_response\": \"...\"}',\n   153→            analysis_fallback=\"This strategic move may indicate shifts in competitive strategy.\",\n   154→        ),\n   155→        FindingTypeConfig(\n   156→            name=\"claim\",\n   157→            display_name=\"Customer Intelligence\",\n   158→            description=\"Customer feedback, satisfaction, preferences. Include: sentiment, specifics, volume. Note credibility of source.\",\n   159→            extracted_data_schema='{\"source\": \"...\", \"sentiment\": \"positive/negative/mixed\", \"volume\": \"...\", \"key_themes\": [...]}',\n   160→            analysis_fallback=\"This customer intelligence provides insight into market perceptions and preferences.\",\n   161→        ),\n   162→        FindingTypeConfig(\n   163→            name=\"prediction\",\n   164→            display_name=\"Threats and Opportunities\",\n   165→            description=\"Emerging threats, market opportunities. Include: threat/opportunity, likelihood, timeline. Note strategic implications.\",\n   166→            extracted_data_schema='{\"type\": \"threat/opportunity\", \"description\": \"...\", \"likelihood\": \"high/medium/low\", \"timeline\": \"...\", \"implications\": \"...\"}',\n   167→            analysis_fallback=\"This forward-looking assessment identifies potential strategic considerations.\",\n   168→        ),\n   169→        FindingTypeConfig(\n   170→            name=\"gap\",\n   171→            display_name=\"Gap\",\n   172→            description=\"Missing competitive data. Information needed for complete analysis. Suggested intelligence gathering.\",\n   173→            extracted_data_schema='{\"information_needed\": \"...\", \"importance\": \"high/medium/low\", \"suggested_sources\": [...]}',\n   174→            analysis_fallback=\"This gap in competitive intelligence should be addressed for a complete analysis.\",\n   175→        ),\n   176→    ],\n   177→    analysis_instruction=\"\"\"YOUR EXPERT ANALYTICAL COMMENTARY (REQUIRED - 2-4 sentences) explaining:\n   178→  * WHY this finding matters for competitive positioning\n   179→  * What STRATEGIC IMPLICATIONS it has for market players\n   180→  * How this COMPARES to historical patterns or industry norms\n   181→  * What ACTIONS or responses this might trigger from competitors\"\"\",\n   182→    extraction_guidelines=\"\"\"CRITICAL: The \"analysis\" field must provide substantive strategic reasoning, not just restate the finding.\n   183→Good example: \"This market share gain is significant because it crosses the 30% threshold typically required for pricing power. Historically, companies reaching this level have been able to raise prices 5-10% without significant churn. Competitors will likely respond with aggressive bundling or price cuts within 6 months.\"\n   184→\n   185→IMPORTANT:\n   186→- Be skeptical of vendor-provided market share data\n   187→- Note methodology differences between market research sources\n   188→- Distinguish between market leadership claims and verified data\"\"\",\n   189→\n   190→    priority_finding_types=[\"actor\", \"evidence\", \"fact\", \"relationship\", \"pattern\"],\n   191→    grouping_order=[\"actor\", \"evidence\", \"fact\", \"relationship\", \"pattern\", \"event\", \"claim\", \"prediction\", \"gap\"],\n   192→)\n   193→\n   194→\n   195→class CompetitiveTemplate(BaseTemplate):\n   196→    \"\"\"Template for competitive intelligence and market analysis.\"\"\"\n   197→\n   198→    template_id = \"competitive\"\n   199→    template_name = \"Competitive Analysis\"\n   200→    description = \"Deep competitive intelligence, market positioning, and strategic analysis\"\n   201→\n   202→    # Data-driven configuration\n   203→    config = COMPETITIVE_CONFIG\n   204→\n   205→    # Report hints for component-based rendering\n   206→    report_hints = ReportHints(\n   207→        template_type=\"competitive\",\n   208→        structure=\"balanced\",\n   209→        findings_grouping=\"category\",\n   210→        tone=\"analytical\",\n   211→        decision_format=\"matrix\",\n   212→        emphasis=[\"market_position\", \"competitive_advantages\", \"strategic_gaps\"],\n   213→        required_components=[\n   214→            ComponentType.COMPETITOR_MATRIX,\n   215→            ComponentType.COMPARISON_TABLE,\n   216→            ComponentType.METRIC_CARDS,\n   217→        ],\n   218→        optional_components=[\n   219→            ComponentType.FINDINGS_TABLE,\n   220→            ComponentType.PROS_CONS,\n   221→            ComponentType.KEY_INSIGHTS,\n   222→            ComponentType.ACTION_ITEMS,\n   223→        ],\n   224→        visualization_preference=[\"competitor_matrix\", \"market_share_chart\", \"swot_grid\"],\n   225→        custom_sections={\n   226→            \"show_market_share\": True,\n   227→            \"highlight_leader\": True,\n   228→            \"show_strategic_gaps\": True,\n   229→        }\n   230→    )\n   231→\n   232→    # Expert perspectives for competitive intelligence\n   233→    default_perspectives = [\n   234→        \"strategy_consultant\",      # Porter's forces, competitive positioning\n   235→        \"industry_insider\",         # Operational realities, customer dynamics\n   236→        \"institutional_investor\",   # Long-term value, moat durability\n   237→        \"short_seller\",             # Skeptical view, hidden weaknesses\n   238→    ]\n   239→\n   240→    default_max_searches = 10\n   241→\n   242→    # Competitive analysis is rife with vendor marketing and inflated claims\n   243→    # Market share numbers vary wildly, need to detect promotional content\n   244→    verification_config = {\n   245→        \"cross_reference\": \"standard\",      # Market data varies by methodology\n   246→        \"bias_detection\": \"thorough\",       # Vendors inflate their position\n   247→        \"expert_sanity_check\": \"standard\",  # Flag unrealistic market claims\n   248→        \"source_quality\": \"standard\",       # Mix of analyst and vendor sources\n   249→    }\n   250→\n   251→    def get_supported_report_variants(self) -> List[str]:\n   252→        \"\"\"Competitive template supports competitor_matrix variant.\"\"\"\n   253→        return [\"full_report\", \"executive_summary\", \"competitor_matrix\"]\n   254→\n   255→    def generate_competitor_matrix(\n   256→        self,\n   257→        result: Dict[str, Any],\n   258→        title: Optional[str] = None,\n   259→    ) -> str:\n   260→        \"\"\"Generate competitor matrix report - competitive-specific variant.\"\"\"\n   261→        query = result.get(\"query\", \"Unknown\")\n   262→        report_title = title or f\"Competitive Matrix: {query[:40]}\"\n   263→\n   264→        sections = []\n   265→        sections.append(f\"# {report_title}\")\n   266→        sections.append(\"\")\n   267→        sections.append(f\"**Market/Subject:** {query}\")\n   268→        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n   269→        sections.append(\"\")\n   270→        sections.append(\"---\")\n   271→        sections.append(\"\")\n   272→\n   273→        findings = result.get(\"findings\", [])\n   274→\n   275→        # Market Overview\n   276→        market_data = [f for f in findings if f.get(\"finding_type\") == \"fact\"]\n   277→        if market_data:\n   278→            sections.append(\"## Market Overview\")\n   279→            sections.append(\"\")\n   280→            for m in market_data[:4]:\n   281→                sections.append(f\"- {m.get('summary') or m.get('content', '')[:100]}\")\n   282→            sections.append(\"\")\n   283→\n   284→        # Competitor Profiles\n   285→        competitors = [f for f in findings if f.get(\"finding_type\") == \"actor\"]\n   286→        if competitors:\n   287→            sections.append(\"## Competitor Profiles\")\n   288→            sections.append(\"\")\n   289→            for comp in competitors:\n   290→                extracted = comp.get(\"extracted_data\", {})\n   291→                if extracted and isinstance(extracted, dict):\n   292→                    company = extracted.get(\"company\", \"Unknown\")\n   293→                    segment = extracted.get(\"segment\", \"\")\n   294→                    revenue = extracted.get(\"revenue\", \"\")\n   295→                    market_share = extracted.get(\"market_share\", \"\")\n   296→                    sections.append(f\"### {company}\")\n   297→                    sections.append(\"\")\n   298→                    if segment:\n   299→                        sections.append(f\"- **Segment:** {segment}\")\n   300→                    if revenue:\n   301→                        sections.append(f\"- **Revenue:** {revenue}\")\n   302→                    if market_share:\n   303→                        sections.append(f\"- **Market Share:** {market_share}\")\n   304→                    sections.append(f\"- {comp.get('content', '')[:200]}\")\n   305→                    sections.append(\"\")\n   306→                else:\n   307→                    sections.append(f\"- {comp.get('summary') or comp.get('content', '')[:100]}\")\n   308→            sections.append(\"\")\n   309→\n   310→        # Competitive Dynamics\n   311→        relationships = [f for f in findings if f.get(\"finding_type\") == \"relationship\"]\n   312→        if relationships:\n   313→            sections.append(\"## Competitive Dynamics\")\n   314→            sections.append(\"\")\n   315→            for rel in relationships[:6]:\n   316→                sections.append(f\"- {rel.get('summary') or rel.get('content', '')[:100]}\")\n   317→            sections.append(\"\")\n   318→\n   319→        # Market Share Data\n   320→        evidence = [f for f in findings if f.get(\"finding_type\") == \"evidence\"]\n   321→        if evidence:\n   322→            sections.append(\"## Market Share & Metrics\")\n   323→            sections.append(\"\")\n   324→            for e in evidence[:6]:\n   325→                sections.append(f\"- {e.get('summary') or e.get('content', '')[:100]}\")\n   326→            sections.append(\"\")\n   327→\n   328→        # Strategic Moves\n   329→        patterns = [f for f in findings if f.get(\"finding_type\") == \"pattern\"]\n   330→        if patterns:\n   331→            sections.append(\"## Recent Strategic Moves\")\n   332→            sections.append(\"\")\n   333→            for p in patterns[:5]:\n   334→                sections.append(f\"- {p.get('summary') or p.get('content', '')[:100]}\")\n   335→            sections.append(\"\")\n   336→\n   337→        # Threats and Opportunities\n   338→        predictions = [f for f in findings if f.get(\"finding_type\") == \"prediction\"]\n   339→        if predictions:\n   340→            sections.append(\"## Threats & Opportunities\")\n   341→            sections.append(\"\")\n   342→            for pred in predictions[:5]:\n   343→                sections.append(f\"- {pred.get('summary') or pred.get('content', '')[:100]}\")\n   344→            sections.append(\"\")\n   345→\n   346→        return \"\\n\".join(sections)\n   347→\n   348→    def _generate_key_sections(self, result: Dict[str, Any]) -> str:\n   349→        \"\"\"Generate competitive-specific key sections: Market Position, Key Competitors.\"\"\"\n   350→        findings = result.get(\"findings\", [])\n   351→        sections = []\n   352→\n   353→        # Market Position Summary\n   354→        evidence = [f for f in findings if f.get(\"finding_type\") == \"evidence\"]\n   355→        if evidence:\n   356→            sections.append(\"## Market Position Summary\")\n   357→            sections.append(\"\")\n   358→            for e in evidence[:4]:\n   359→                sections.append(f\"- {e.get('summary') or e.get('content', '')[:100]}\")\n   360→            sections.append(\"\")\n   361→\n   362→        # Key Competitors\n   363→        competitors = [f for f in findings if f.get(\"finding_type\") == \"actor\"]\n   364→        if competitors:\n   365→            sections.append(\"## Key Competitors\")\n   366→            sections.append(\"\")\n   367→            for comp in competitors[:5]:\n   368→                sections.append(f\"- {comp.get('summary') or comp.get('content', '')[:100]}\")\n   369→            sections.append(\"\")\n   370→\n   371→        return \"\\n\".join(sections)\n   372→\n   373→    def _generate_executive_highlights(self, result: Dict[str, Any]) -> str:\n   374→        \"\"\"Generate competitive-specific executive highlights.\"\"\"\n   375→        findings = result.get(\"findings\", [])\n   376→        sections = []\n   377→\n   378→        # Top competitors highlight\n   379→        competitors = [f for f in findings if f.get(\"finding_type\") == \"actor\"]\n   380→        if competitors:\n   381→            sections.append(\"## Top Competitors\")\n   382→            sections.append(\"\")\n   383→            for comp in competitors[:3]:\n   384→                sections.append(f\"- {comp.get('summary') or comp.get('content', '')[:80]}\")\n   385→            sections.append(\"\")\n   386→\n   387→        return \"\\n\".join(sections)\n   388→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"1f794eae-4516-40cc-88e2-7a8e0f0f09e3","uuid":"da826245-6c2b-443d-a761-e23d04101589","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\