[2026-01-30T14:11:44.528Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Pq7zjZ7m3HxexD5HuuJWXz","type":"tool_result","content":"     1→\"\"\"Contract analysis template for government contracts, pricing, and corruption detection.\"\"\"\n     2→\n     3→from typing import List, Dict, Any, Optional\n     4→from datetime import datetime\n     5→\n     6→from .base import BaseTemplate, TemplateConfig, FindingTypeConfig\n     7→from ..services.report_components import (\n     8→    ComponentType, ReportHints\n     9→)\n    10→\n    11→\n    12→# ========== TEMPLATE CONFIGURATION ==========\n    13→\n    14→CONTRACT_CONFIG = TemplateConfig(\n    15→    search_intro=\"You are a government contract analyst and fraud investigator planning research queries to analyze contracts for overpricing, corruption risks, and suspicious elements.\",\n    16→    search_angles=[\n    17→        {\n    18→            \"name\": \"VENDOR/CONTRACTOR BACKGROUND\",\n    19→            \"items\": [\n    20→                \"Company registration, incorporation date, ownership history\",\n    21→                \"Key executives and beneficial owners\",\n    22→                \"Prior government contracts with this vendor\",\n    23→                \"Complaints, lawsuits, debarment history\",\n    24→                \"Related companies, subsidiaries, DBAs\",\n    25→                \"Political donations by company or executives\",\n    26→            ]\n    27→        },\n    28→        {\n    29→            \"name\": \"PRICING BENCHMARK RESEARCH\",\n    30→            \"items\": [\n    31→                \"Industry standard rates for similar work/services\",\n    32→                \"Government rate schedules (GSA schedules for federal)\",\n    33→                \"Comparable contracts in same sector/region\",\n    34→                \"Unit pricing for common line items\",\n    35→                \"Labor rate comparisons (prevailing wage data)\",\n    36→                \"Material cost benchmarks\",\n    37→            ]\n    38→        },\n    39→        {\n    40→            \"name\": \"BID PROCESS AND COMPETITION\",\n    41→            \"items\": [\n    42→                \"Other bidders on this contract (if public)\",\n    43→                \"Similar recent solicitations for comparison\",\n    44→                \"Sole-source justification patterns\",\n    45→                \"Bid protest history\",\n    46→                \"Procurement officer history and patterns\",\n    47→            ]\n    48→        },\n    49→        {\n    50→            \"name\": \"CONTRACT MODIFICATIONS AND OVERRUNS\",\n    51→            \"items\": [\n    52→                \"Change order patterns on similar contracts\",\n    53→                \"Amendment and modification history\",\n    54→                \"Cost overrun statistics in sector\",\n    55→                \"Schedule extension patterns\",\n    56→                \"Scope creep indicators\",\n    57→            ]\n    58→        },\n    59→        {\n    60→            \"name\": \"VENDOR PERFORMANCE HISTORY\",\n    61→            \"items\": [\n    62→                \"Past performance evaluations (PPIRS for federal)\",\n    63→                \"Completed projects: on-time, on-budget?\",\n    64→                \"Quality issues, defects, rework\",\n    65→                \"Customer complaints and disputes\",\n    66→                \"Warranty claims and callbacks\",\n    67→            ]\n    68→        },\n    69→        {\n    70→            \"name\": \"CONNECTED ENTITIES AND CONFLICTS\",\n    71→            \"items\": [\n    72→                \"Subcontractor relationships\",\n    73→                \"Joint venture partners\",\n    74→                \"Related party transactions\",\n    75→                \"Revolving door: former officials now at vendor\",\n    76→                \"Family connections to agency staff\",\n    77→                \"Shell company indicators\",\n    78→            ]\n    79→        },\n    80→        {\n    81→            \"name\": \"REGULATORY AND COMPLIANCE\",\n    82→            \"items\": [\n    83→                \"Required certifications/licenses\",\n    84→                \"Small business set-aside compliance\",\n    85→                \"DBE/MBE/WBE certification verification\",\n    86→                \"Insurance and bonding requirements\",\n    87→                \"DCAA audit findings (federal)\",\n    88→            ]\n    89→        },\n    90→        {\n    91→            \"name\": \"NEWS AND INVESTIGATIONS\",\n    92→            \"items\": [\n    93→                \"Media coverage of vendor or contract\",\n    94→                \"Inspector General reports\",\n    95→                \"GAO/state auditor findings\",\n    96→                \"Whistleblower complaints\",\n    97→                \"FBI/DOJ investigations in sector\",\n    98→            ]\n    99→        },\n   100→    ],\n   101→    search_depth_guidance={\n   102→        \"quick\": \"Focus on vendor background + pricing benchmark + news/issues\",\n   103→        \"standard\": \"Add bid process + performance + connected entities\",\n   104→        \"deep\": \"All angles with multiple queries per angle, deep ownership research\",\n   105→    },\n   106→\n   107→    extraction_intro=\"You are a government contract auditor and fraud investigator extracting findings from research on a contract or contractor. Your goal is to identify red flags, pricing anomalies, and corruption indicators.\",\n   108→    finding_types=[\n   109→        FindingTypeConfig(\n   110→            name=\"contract_entity\",\n   111→            display_name=\"Contract Entity\",\n   112→            description=\"Key parties: vendor, agency, contracting officer, subcontractors. Note: ownership structure, key personnel.\",\n   113→            extracted_data_schema='{\"entity_name\": \"...\", \"entity_type\": \"...\", \"role\": \"...\", \"registration_info\": \"...\"}',\n   114→            analysis_fallback=\"This entity information provides context for understanding the contract relationships.\",\n   115→        ),\n   116→        FindingTypeConfig(\n   117→            name=\"contract_terms\",\n   118→            display_name=\"Contract Terms\",\n   119→            description=\"Value, duration, payment schedule, key rates. Note: unusual terms, milestone payments.\",\n   120→            extracted_data_schema='{\"total_value\": \"...\", \"duration\": \"...\", \"payment_terms\": \"...\", \"key_rates\": \"...\", \"type\": \"fixed/cost-plus\"}',\n   121→            analysis_fallback=\"These contract terms should be evaluated against industry standards and benchmarks.\",\n   122→        ),\n   123→        FindingTypeConfig(\n   124→            name=\"pricing_analysis\",\n   125→            display_name=\"Pricing Analysis\",\n   126→            description=\"Cost breakdown, unit rates, comparison to market. Note: overhead, profit margins, labor vs. materials.\",\n   127→            extracted_data_schema='{\"item\": \"...\", \"proposed_rate\": \"...\", \"market_rate\": \"...\", \"variance_percent\": \"...\", \"benchmark_source\": \"...\"}',\n   128→            analysis_fallback=\"This pricing analysis helps assess whether contract rates are reasonable and competitive.\",\n   129→        ),\n   130→        FindingTypeConfig(\n   131→            name=\"bid_process\",\n   132→            display_name=\"Bid Process Finding\",\n   133→            description=\"Competition level, bidders, evaluation criteria. Note: sole-source justifications, bid rotation patterns.\",\n   134→            extracted_data_schema='{\"bid_count\": \"...\", \"bidder_names\": [...], \"award_basis\": \"...\", \"competition_type\": \"...\"}',\n   135→            analysis_fallback=\"The bid process findings reveal the level of competition and potential procurement concerns.\",\n   136→        ),\n   137→        FindingTypeConfig(\n   138→            name=\"suspicious_element\",\n   139→            display_name=\"Suspicious Element\",\n   140→            description=\"Unusual terms, sweetheart deals, conflict indicators. Examples: related party transactions, revolving door, bid steering.\",\n   141→            extracted_data_schema='{\"element_type\": \"...\", \"description\": \"...\", \"severity\": \"high/medium/low\", \"related_parties\": [...], \"evidence\": \"...\"}',\n   142→            analysis_fallback=\"This suspicious element warrants further investigation to assess potential impropriety.\",\n   143→        ),\n   144→        FindingTypeConfig(\n   145→            name=\"connected_entity\",\n   146→            display_name=\"Connected Entity\",\n   147→            description=\"Related parties, shell companies, family businesses. Note: ownership overlaps, shared addresses, common executives.\",\n   148→            extracted_data_schema='{\"primary_entity\": \"...\", \"connected_entity\": \"...\", \"relationship_type\": \"...\", \"evidence\": \"...\"}',\n   149→            analysis_fallback=\"This connection between entities may indicate conflicts of interest or coordinated activity.\",\n   150→        ),\n   151→        FindingTypeConfig(\n   152→            name=\"compliance_issue\",\n   153→            display_name=\"Compliance Issue\",\n   154→            description=\"Regulatory violations, missing documentation. Note: licensing, certifications, insurance, bonding.\",\n   155→            extracted_data_schema='{\"requirement\": \"...\", \"status\": \"...\", \"violation_type\": \"...\", \"consequence\": \"...\"}',\n   156→            analysis_fallback=\"This compliance issue may affect contract validity or create legal exposure.\",\n   157→        ),\n   158→        FindingTypeConfig(\n   159→            name=\"performance_issue\",\n   160→            display_name=\"Performance Issue\",\n   161→            description=\"Delays, cost overruns, quality problems. Note: pattern across multiple contracts.\",\n   162→            extracted_data_schema='{\"issue_type\": \"...\", \"original_value\": \"...\", \"actual_value\": \"...\", \"variance\": \"...\", \"cause\": \"...\"}',\n   163→            analysis_fallback=\"This performance issue indicates potential problems with contractor capability or management.\",\n   164→        ),\n   165→        FindingTypeConfig(\n   166→            name=\"comparable_contract\",\n   167→            display_name=\"Comparable Contract\",\n   168→            description=\"Similar contracts for benchmarking. Note: price per unit/sq ft/hour comparisons.\",\n   169→            extracted_data_schema='{\"contract_id\": \"...\", \"agency\": \"...\", \"vendor\": \"...\", \"value\": \"...\", \"scope\": \"...\", \"outcome\": \"...\"}',\n   170→            analysis_fallback=\"This comparable contract provides a benchmark for evaluating pricing and terms.\",\n   171→        ),\n   172→        FindingTypeConfig(\n   173→            name=\"red_flag\",\n   174→            display_name=\"Red Flag\",\n   175→            description=\"Strong corruption or fraud indicators. Examples: phantom vendors, kickbacks, bid rigging, overbilling.\",\n   176→            extracted_data_schema='{\"flag_type\": \"...\", \"description\": \"...\", \"risk_level\": \"high/critical\", \"supporting_evidence\": [...], \"recommended_investigation\": \"...\"}',\n   177→            analysis_fallback=\"This red flag indicates potential fraud or corruption that requires immediate attention.\",\n   178→        ),\n   179→        FindingTypeConfig(\n   180→            name=\"gap\",\n   181→            display_name=\"Gap\",\n   182→            description=\"Missing critical information needed. Note: what documents/data would help investigation.\",\n   183→            extracted_data_schema='{\"information_needed\": \"...\", \"importance\": \"high/medium/low\", \"impact_on_analysis\": \"...\"}',\n   184→            analysis_fallback=\"This information gap limits the completeness of the analysis and should be addressed.\",\n   185→        ),\n   186→        FindingTypeConfig(\n   187→            name=\"date_timeline\",\n   188→            display_name=\"Date/Timeline\",\n   189→            description=\"Important dates and timeline inconsistencies. Note: contract award before bid deadline, rushed timelines.\",\n   190→            extracted_data_schema='{\"event\": \"...\", \"date\": \"...\", \"significance\": \"...\", \"related_events\": [...]}',\n   191→            analysis_fallback=\"This timeline information helps understand the sequence of events and identify anomalies.\",\n   192→        ),\n   193→    ],\n   194→    analysis_instruction=\"\"\"YOUR EXPERT INVESTIGATIVE ANALYSIS (REQUIRED - 2-4 sentences) explaining:\n   195→  * WHY this finding is significant for contract oversight or fraud detection\n   196→  * What PATTERN or RED FLAG this represents in government contracting\n   197→  * How this COMPARES to normal contracting practices or known fraud schemes\n   198→  * What FURTHER INVESTIGATION or action this finding warrants\"\"\",\n   199→    extraction_guidelines=\"\"\"CRITICAL: The \"analysis\" field must provide substantive investigative reasoning, not just describe the finding.\n   200→Good example: \"This 40% price premium over market rate is a significant red flag in competitive bid environments. In similar cases, inflated pricing of this magnitude has been associated with kickback schemes where the excess margin funds illicit payments. The fact that this vendor has previously worked with the contracting officer warrants examination of their relationship and any campaign contributions or post-employment arrangements.\"\n   201→\n   202→CRITICAL: Prioritize RED_FLAG and SUSPICIOUS_ELEMENT findings. If you identify\n   203→potential fraud indicators, ensure they are captured even if confidence is moderate.\n   204→False negatives (missing fraud) are worse than false positives (flagging non-issues).\"\"\",\n   205→\n   206→    priority_finding_types=[\"red_flag\", \"suspicious_element\", \"compliance_issue\", \"pricing_analysis\", \"connected_entity\"],\n   207→    grouping_order=[\"red_flag\", \"suspicious_element\", \"connected_entity\", \"compliance_issue\", \"pricing_analysis\", \"bid_process\", \"contract_terms\", \"performance_issue\", \"comparable_contract\", \"contract_entity\", \"date_timeline\", \"gap\"],\n   208→)\n   209→\n   210→\n   211→class ContractTemplate(BaseTemplate):\n   212→    \"\"\"Template for government contract evaluation and corruption detection.\"\"\"\n   213→\n   214→    template_id = \"contract\"\n   215→    template_name = \"Government Contract Analysis\"\n   216→    description = \"Analyze state/government contracts for overpricing, corruption, and suspicious elements\"\n   217→\n   218→    # Data-driven configuration\n   219→    config = CONTRACT_CONFIG\n   220→\n   221→    # Report hints for component-based rendering\n   222→    report_hints = ReportHints(\n   223→        template_type=\"contract\",\n   224→        structure=\"balanced\",\n   225→        findings_grouping=\"category\",\n   226→        tone=\"professional\",\n   227→        decision_format=\"checklist\",\n   228→        emphasis=[\"key_terms\", \"obligations\", \"risks\", \"opportunities\"],\n   229→        required_components=[\n   230→            ComponentType.CONTRACT_ANALYSIS,\n   231→            ComponentType.CHECKLIST,\n   232→            ComponentType.RISK_MATRIX,\n   233→        ],\n   234→        optional_components=[\n   235→            ComponentType.FINDINGS_TABLE,\n   236→            ComponentType.ACTION_ITEMS,\n   237→            ComponentType.COMPARISON_TABLE,\n   238→            ComponentType.KEY_INSIGHTS,\n   239→        ],\n   240→        visualization_preference=[\"contract_structure\", \"obligation_timeline\", \"risk_assessment\"],\n   241→        custom_sections={\n   242→            \"show_pricing_comparison\": True,\n   243→            \"red_flag_priority\": True,\n   244→            \"vendor_history\": True,\n   245→        }\n   246→    )\n   247→\n   248→    # Expert perspectives for contract analysis\n   249→    default_perspectives = [\n   250→        \"contract_auditor\",           # Pricing and cost analysis\n   251→        \"procurement_investigator\",   # Bid process, competition issues\n   252→        \"forensic_accountant\",        # Financial red flags\n   253→        \"regulatory_compliance\",      # Legal requirements\n   254→        \"industry_benchmarker\",       # Market rate comparison\n   255→    ]\n   256→\n   257→    default_max_searches = 12\n   258→\n   259→    # Thorough verification for fraud detection\n   260→    verification_config = {\n   261→        \"cross_reference\": \"thorough\",\n   262→        \"bias_detection\": \"thorough\",\n   263→        \"expert_sanity_check\": \"thorough\",\n   264→        \"source_quality\": \"thorough\",\n   265→    }\n   266→\n   267→    def get_supported_report_variants(self) -> List[str]:\n   268→        \"\"\"Contract template supports red_flags_summary and pricing_analysis variants.\"\"\"\n   269→        return [\"full_report\", \"executive_summary\", \"red_flags_summary\", \"pricing_analysis\"]\n   270→\n   271→    def generate_red_flags_summary(\n   272→        self,\n   273→        result: Dict[str, Any],\n   274→        title: Optional[str] = None,\n   275→    ) -> str:\n   276→        \"\"\"Generate red flags summary report - contract-specific variant.\"\"\"\n   277→        query = result.get(\"query\", \"Unknown\")\n   278→        report_title = title or f\"Red Flags Summary: {query[:40]}\"\n   279→\n   280→        sections = []\n   281→        sections.append(f\"# {report_title}\")\n   282→        sections.append(\"\")\n   283→        sections.append(f\"**Contract/Subject:** {query}\")\n   284→        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n   285→        sections.append(\"\")\n   286→        sections.append(\"---\")\n   287→        sections.append(\"\")\n   288→\n   289→        findings = result.get(\"findings\", [])\n   290→\n   291→        # Critical Red Flags\n   292→        red_flags = [f for f in findings if f.get(\"finding_type\") == \"red_flag\"]\n   293→        sections.append(\"## Critical Red Flags\")\n   294→        sections.append(\"\")\n   295→        if red_flags:\n   296→            for rf in red_flags:\n   297→                extracted = rf.get(\"extracted_data\", {})\n   298→                if extracted and isinstance(extracted, dict):\n   299→                    flag_type = extracted.get(\"flag_type\", \"Unknown\")\n   300→                    risk_level = extracted.get(\"risk_level\", \"high\")\n   301→                    sections.append(f\"### {flag_type.replace('_', ' ').title()} ({risk_level.upper()} RISK)\")\n   302→                    sections.append(\"\")\n   303→                    sections.append(rf.get(\"content\", \"\"))\n   304→                    sections.append(\"\")\n   305→                    evidence = extracted.get(\"supporting_evidence\", [])\n   306→                    if evidence:\n   307→                        sections.append(\"**Supporting Evidence:**\")\n   308→                        for e in evidence[:3]:\n   309→                            sections.append(f\"- {e}\")\n   310→                        sections.append(\"\")\n   311→                    recommendation = extracted.get(\"recommended_investigation\", \"\")\n   312→                    if recommendation:\n   313→                        sections.append(f\"**Recommended Investigation:** {recommendation}\")\n   314→                        sections.append(\"\")\n   315→                else:\n   316→                    sections.append(f\"- **RED FLAG**: {rf.get('summary') or rf.get('content', '')[:150]}\")\n   317→        else:\n   318→            sections.append(\"No critical red flags identified.\")\n   319→        sections.append(\"\")\n   320→\n   321→        # Suspicious Elements\n   322→        suspicious = [f for f in findings if f.get(\"finding_type\") == \"suspicious_element\"]\n   323→        if suspicious:\n   324→            sections.append(\"## Suspicious Elements\")\n   325→            sections.append(\"\")\n   326→            for se in suspicious:\n   327→                extracted = se.get(\"extracted_data\", {})\n   328→                if extracted and isinstance(extracted, dict):\n   329→                    element_type = extracted.get(\"element_type\", \"Unknown\")\n   330→                    severity = extracted.get(\"severity\", \"medium\")\n   331→                    sections.append(f\"- **{element_type.replace('_', ' ').title()}** ({severity}): {se.get('summary', '')}\")\n   332→                else:\n   333→                    sections.append(f\"- {se.get('summary') or se.get('content', '')[:100]}\")\n   334→            sections.append(\"\")\n   335→\n   336→        # Connected Entities (potential conflicts)\n   337→        connected = [f for f in findings if f.get(\"finding_type\") == \"connected_entity\"]\n   338→        if connected:\n   339→            sections.append(\"## Connected Entities (Potential Conflicts)\")\n   340→            sections.append(\"\")\n   341→            for ce in connected:\n   342→                extracted = ce.get(\"extracted_data\", {})\n   343→                if extracted and isinstance(extracted, dict):\n   344→                    primary = extracted.get(\"primary_entity\", \"Unknown\")\n   345→                    related = extracted.get(\"connected_entity\", \"Unknown\")\n   346→                    rel_type = extracted.get(\"relationship_type\", \"related to\")\n   347→                    sections.append(f\"- **{primary}** {rel_type} **{related}**\")\n   348→                else:\n   349→                    sections.append(f\"- {ce.get('summary') or ce.get('content', '')[:100]}\")\n   350→            sections.append(\"\")\n   351→\n   352→        # Compliance Issues\n   353→        compliance = [f for f in findings if f.get(\"finding_type\") == \"compliance_issue\"]\n   354→        if compliance:\n   355→            sections.append(\"## Compliance Issues\")\n   356→            sections.append(\"\")\n   357→            for ci in compliance:\n   358→                sections.append(f\"- {ci.get('summary') or ci.get('content', '')[:100]}\")\n   359→            sections.append(\"\")\n   360→\n   361→        # Bid Process Concerns\n   362→        bid_issues = [f for f in findings if f.get(\"finding_type\") == \"bid_process\"]\n   363→        if bid_issues:\n   364→            sections.append(\"## Bid Process Concerns\")\n   365→            sections.append(\"\")\n   366→            for bi in bid_issues:\n   367→                extracted = bi.get(\"extracted_data\", {})\n   368→                if extracted and isinstance(extracted, dict):\n   369→                    bid_count = extracted.get(\"bid_count\", \"Unknown\")\n   370→                    competition_type = extracted.get(\"competition_type\", \"Unknown\")\n   371→                    sections.append(f\"- **Bids:** {bid_count} | **Competition:** {competition_type}\")\n   372→                    sections.append(f\"  {bi.get('content', '')[:200]}\")\n   373→                else:\n   374→                    sections.append(f\"- {bi.get('summary') or bi.get('content', '')[:100]}\")\n   375→            sections.append(\"\")\n   376→\n   377→        # Risk Assessment from Perspectives\n   378→        perspectives = result.get(\"perspectives\", [])\n   379→        all_warnings = []\n   380→        for p in perspectives:\n   381→            all_warnings.extend(p.get(\"warnings\", []))\n   382→        if all_warnings:\n   383→            sections.append(\"## Expert Risk Assessment\")\n   384→            sections.append(\"\")\n   385→            for warning in all_warnings[:8]:\n   386→                sections.append(f\"- {warning}\")\n   387→            sections.append(\"\")\n   388→\n   389→        # Recommended Investigations\n   390→        sections.append(\"## Recommended Actions\")\n   391→        sections.append(\"\")\n   392→        for p in perspectives:\n   393→            recs = p.get(\"recommendations\", [])\n   394→            for rec in recs[:2]:\n   395→                sections.append(f\"- {rec}\")\n   396→        sections.append(\"\")\n   397→\n   398→        return \"\\n\".join(sections)\n   399→\n   400→    def generate_pricing_analysis(\n   401→        self,\n   402→        result: Dict[str, Any],\n   403→        title: Optional[str] = None,\n   404→    ) -> str:\n   405→        \"\"\"Generate pricing analysis report - contract-specific variant.\"\"\"\n   406→        query = result.get(\"query\", \"Unknown\")\n   407→        report_title = title or f\"Pricing Analysis: {query[:40]}\"\n   408→\n   409→        sections = []\n   410→        sections.append(f\"# {report_title}\")\n   411→        sections.append(\"\")\n   412→        sections.append(f\"**Contract/Subject:** {query}\")\n   413→        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n   414→        sections.append(\"\")\n   415→        sections.append(\"---\")\n   416→        sections.append(\"\")\n   417→\n   418→        findings = result.get(\"findings\", [])\n   419→\n   420→        # Contract Terms Summary\n   421→        terms = [f for f in findings if f.get(\"finding_type\") == \"contract_terms\"]\n   422→        if terms:\n   423→            sections.append(\"## Contract Terms\")\n   424→            sections.append(\"\")\n   425→            for t in terms:\n   426→                extracted = t.get(\"extracted_data\", {})\n   427→                if extracted and isinstance(extracted, dict):\n   428→                    value = extracted.get(\"total_value\", \"Unknown\")\n   429→                    duration = extracted.get(\"duration\", \"Unknown\")\n   430→                    contract_type = extracted.get(\"type\", \"Unknown\")\n   431→                    sections.append(f\"- **Total Value:** ${value:,}\" if isinstance(value, (int, float)) else f\"- **Total Value:** {value}\")\n   432→                    sections.append(f\"- **Duration:** {duration}\")\n   433→                    sections.append(f\"- **Contract Type:** {contract_type}\")\n   434→                else:\n   435→                    sections.append(f\"- {t.get('content', '')[:200]}\")\n   436→            sections.append(\"\")\n   437→\n   438→        # Pricing Analysis Details\n   439→        pricing = [f for f in findings if f.get(\"finding_type\") == \"pricing_analysis\"]\n   440→        if pricing:\n   441→            sections.append(\"## Pricing Comparison\")\n   442→            sections.append(\"\")\n   443→            sections.append(\"| Item | Proposed Rate | Market Rate | Variance |\")\n   444→            sections.append(\"|------|--------------|-------------|----------|\")\n   445→            for p in pricing:\n   446→                extracted = p.get(\"extracted_data\", {})\n   447→                if extracted and isinstance(extracted, dict):\n   448→                    item = extracted.get(\"item\", \"Unknown\")\n   449→                    proposed = extracted.get(\"proposed_rate\", \"N/A\")\n   450→                    market = extracted.get(\"market_rate\", \"N/A\")\n   451→                    variance = extracted.get(\"variance_percent\", \"N/A\")\n   452→                    sections.append(f\"| {item} | {proposed} | {market} | {variance}% |\")\n   453→                else:\n   454→                    sections.append(f\"- {p.get('summary') or p.get('content', '')[:100]}\")\n   455→            sections.append(\"\")\n   456→\n   457→        # Comparable Contracts\n   458→        comparables = [f for f in findings if f.get(\"finding_type\") == \"comparable_contract\"]\n   459→        if comparables:\n   460→            sections.append(\"## Comparable Contracts\")\n   461→            sections.append(\"\")\n   462→            for c in comparables:\n   463→                extracted = c.get(\"extracted_data\", {})\n   464→                if extracted and isinstance(extracted, dict):\n   465→                    agency = extracted.get(\"agency\", \"Unknown\")\n   466→                    vendor = extracted.get(\"vendor\", \"Unknown\")\n   467→                    value = extracted.get(\"value\", \"Unknown\")\n   468→                    sections.append(f\"- **{agency}** with {vendor}: ${value:,}\" if isinstance(value, (int, float)) else f\"- **{agency}** with {vendor}: {value}\")\n   469→                else:\n   470→                    sections.append(f\"- {c.get('summary') or c.get('content', '')[:100]}\")\n   471→            sections.append(\"\")\n   472→\n   473→        # Performance Issues (cost overruns)\n   474→        performance = [f for f in findings if f.get(\"finding_type\") == \"performance_issue\"]\n   475→        if performance:\n   476→            sections.append(\"## Historical Performance Issues\")\n   477→            sections.append(\"\")\n   478→            for perf in performance:\n   479→                extracted = perf.get(\"extracted_data\", {})\n   480→                if extracted and isinstance(extracted, dict):\n   481→                    issue_type = extracted.get(\"issue_type\", \"Unknown\")\n   482→                    variance = extracted.get(\"variance\", \"Unknown\")\n   483→                    sections.append(f\"- **{issue_type.replace('_', ' ').title()}**: {variance} variance\")\n   484→                else:\n   485→                    sections.append(f\"- {perf.get('summary') or perf.get('content', '')[:100]}\")\n   486→            sections.append(\"\")\n   487→\n   488→        # Industry Benchmarking Perspective\n   489→        perspectives = result.get(\"perspectives\", [])\n   490→        benchmarker = next((p for p in perspectives if \"benchmark\" in p.get(\"perspective_type\", \"\").lower()), None)\n   491→        if benchmarker:\n   492→            sections.append(\"## Industry Benchmarking Analysis\")\n   493→            sections.append(\"\")\n   494→            sections.append(benchmarker.get(\"analysis_text\", \"\")[:500])\n   495→            sections.append(\"\")\n   496→\n   497→        # Value Assessment\n   498→        sections.append(\"## Value Assessment\")\n   499→        sections.append(\"\")\n   500→        auditor = next((p for p in perspectives if \"auditor\" in p.get(\"perspective_type\", \"\").lower()), None)\n   501→        if auditor:\n   502→            insights = auditor.get(\"key_insights\", [])\n   503→            for insight in insights[:4]:\n   504→                sections.append(f\"- {insight}\")\n   505→        sections.append(\"\")\n   506→\n   507→        return \"\\n\".join(sections)\n   508→\n   509→    def _generate_report_header(self, result: Dict[str, Any]) -> str:\n   510→        \"\"\"Generate contract-specific header with risk summary.\"\"\"\n   511→        findings = result.get(\"findings\", [])\n   512→\n   513→        red_flags = len([f for f in findings if f.get(\"finding_type\") == \"red_flag\"])\n   514→        suspicious = len([f for f in findings if f.get(\"finding_type\") == \"suspicious_element\"])\n   515→        compliance = len([f for f in findings if f.get(\"finding_type\") == \"compliance_issue\"])\n   516→\n   517→        if red_flags > 0 or suspicious > 0:\n   518→            risk_level = \"HIGH\" if red_flags >= 2 else \"MEDIUM\" if red_flags >= 1 or suspicious >= 2 else \"LOW\"\n   519→            return f\"\"\"## Risk Summary\n   520→\n   521→**Overall Risk Level:** {risk_level}\n   522→\n   523→- **Critical Red Flags:** {red_flags}\n   524→- **Suspicious Elements:** {suspicious}\n   525→- **Compliance Issues:** {compliance}\"\"\"\n   526→        return \"\"\n   527→\n   528→    def _generate_key_sections(self, result: Dict[str, Any]) -> str:\n   529→        \"\"\"Generate contract-specific key sections: Red Flags Summary, Pricing Overview.\"\"\"\n   530→        findings = result.get(\"findings\", [])\n   531→        sections = []\n   532→\n   533→        # Red Flags Summary\n   534→        red_flags = [f for f in findings if f.get(\"finding_type\") == \"red_flag\"]\n   535→        if red_flags:\n   536→            sections.append(\"## Red Flags Summary\")\n   537→            sections.append(\"\")\n   538→            for rf in red_flags[:5]:\n   539→                extracted = rf.get(\"extracted_data\", {})\n   540→                if extracted and isinstance(extracted, dict):\n   541→                    flag_type = extracted.get(\"flag_type\", \"Unknown\")\n   542→                    risk_level = extracted.get(\"risk_level\", \"high\")\n   543→                    sections.append(f\"- **[{risk_level.upper()}]** {flag_type.replace('_', ' ').title()}: {rf.get('summary', '')}\")\n   544→                else:\n   545→                    sections.append(f\"- {rf.get('summary') or rf.get('content', '')[:100]}\")\n   546→            sections.append(\"\")\n   547→\n   548→        # Pricing Overview\n   549→        pricing = [f for f in findings if f.get(\"finding_type\") == \"pricing_analysis\"]\n   550→        if pricing:\n   551→            sections.append(\"## Pricing Overview\")\n   552→            sections.append(\"\")\n   553→            for p in pricing[:4]:\n   554→                sections.append(f\"- {p.get('summary') or p.get('content', '')[:100]}\")\n   555→            sections.append(\"\")\n   556→\n   557→        return \"\\n\".join(sections)\n   558→\n   559→    def _generate_executive_highlights(self, result: Dict[str, Any]) -> str:\n   560→        \"\"\"Generate contract-specific executive highlights focusing on risk.\"\"\"\n   561→        findings = result.get(\"findings\", [])\n   562→        sections = []\n   563→\n   564→        # Risk indicators\n   565→        red_flags = [f for f in findings if f.get(\"finding_type\") == \"red_flag\"]\n   566→        suspicious = [f for f in findings if f.get(\"finding_type\") == \"suspicious_element\"]\n   567→\n   568→        if red_flags or suspicious:\n   569→            sections.append(\"## Risk Indicators\")\n   570→            sections.append(\"\")\n   571→            for rf in red_flags[:3]:\n   572→                sections.append(f\"- **RED FLAG**: {rf.get('summary') or rf.get('content', '')[:80]}\")\n   573→            for se in suspicious[:2]:\n   574→                sections.append(f\"- **SUSPICIOUS**: {se.get('summary') or se.get('content', '')[:80]}\")\n   575→            sections.append(\"\")\n   576→\n   577→        return \"\\n\".join(sections)\n   578→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"1f794eae-4516-40cc-88e2-7a8e0f0f09e3","uuid":"14f39f01-cbfa-4f7b-b692-35ee50e98bb3","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\actor\\src\\templates\\contract.py","content":"\"\"\"Contract analysis template for government contracts, pricing, and corruption detection.\"\"\"\n\nfrom typing import List, Dict, Any, Optional\nfrom datetime import datetime\n\nfrom .base import BaseTemplate, TemplateConfig, FindingTypeConfig\nfrom ..services.report_components import (\n    ComponentType, ReportHints\n)\n\n\n# ========== TEMPLATE CONFIGURATION ==========\n\nCONTRACT_CONFIG = TemplateConfig(\n    search_intro=\"You are a government contract analyst and fraud investigator planning research queries to analyze contracts for overpricing, corruption risks, and suspicious elements.\",\n    search_angles=[\n        {\n            \"name\": \"VENDOR/CONTRACTOR BACKGROUND\",\n            \"items\": [\n                \"Company registration, incorporation date, ownership history\",\n                \"Key executives and beneficial owners\",\n                \"Prior government contracts with this vendor\",\n                \"Complaints, lawsuits, debarment history\",\n                \"Related companies, subsidiaries, DBAs\",\n                \"Political donations by company or executives\",\n            ]\n        },\n        {\n            \"name\": \"PRICING BENCHMARK RESEARCH\",\n            \"items\": [\n                \"Industry standard rates for similar work/services\",\n                \"Government rate schedules (GSA schedules for federal)\",\n                \"Comparable contracts in same sector/region\",\n                \"Unit pricing for common line items\",\n                \"Labor rate comparisons (prevailing wage data)\",\n                \"Material cost benchmarks\",\n            ]\n        },\n        {\n            \"name\": \"BID PROCESS AND COMPETITION\",\n            \"items\": [\n                \"Other bidders on this contract (if public)\",\n                \"Similar recent solicitations for comparison\",\n                \"Sole-source justification patterns\",\n                \"Bid protest history\",\n                \"Procurement officer history and patterns\",\n            ]\n        },\n        {\n            \"name\": \"CONTRACT MODIFICATIONS AND OVERRUNS\",\n            \"items\": [\n                \"Change order patterns on similar contracts\",\n                \"Amendment and modification history\",\n                \"Cost overrun statistics in sector\",\n                \"Schedule extension patterns\",\n                \"Scope creep indicators\",\n            ]\n        },\n        {\n            \"name\": \"VENDOR PERFORMANCE HISTORY\",\n            \"items\": [\n                \"Past performance evaluations (PPIRS for federal)\",\n                \"Completed projects: on-time, on-budget?\",\n                \"Quality issues, defects, rework\",\n                \"Customer complaints and disputes\",\n                \"Warranty claims and callbacks\",\n            ]\n        },\n        {\n            \"name\": \"CONNECTED ENTITIES AND CONFLICTS\",\n            \"items\": [\n                \"Subcontractor relationships\",\n                \"Joint venture partners\",\n                \"Related party transactions\",\n                \"Revolving door: former officials now at vendor\",\n                \"Family connections to agency staff\",\n                \"Shell company indicators\",\n            ]\n        },\n        {\n            \"name\": \"REGULATORY AND COMPLIANCE\",\n            \"items\": [\n                \"Required certifications/licenses\",\n                \"Small business set-aside compliance\",\n                \"DBE/MBE/WBE certification verification\",\n                \"Insurance and bonding requirements\",\n                \"DCAA audit findings (federal)\",\n            ]\n        },\n        {\n            \"name\": \"NEWS AND INVESTIGATIONS\",\n            \"items\": [\n                \"Media coverage of vendor or contract\",\n                \"Inspector General reports\",\n                \"GAO/state auditor findings\",\n                \"Whistleblower complaints\",\n                \"FBI/DOJ investigations in sector\",\n            ]\n        },\n    ],\n    search_depth_guidance={\n        \"quick\": \"Focus on vendor background + pricing benchmark + news/issues\",\n        \"standard\": \"Add bid process + performance + connected entities\",\n        \"deep\": \"All angles with multiple queries per angle, deep ownership research\",\n    },\n\n    extraction_intro=\"You are a government contract auditor and fraud investigator extracting findings from research on a contract or contractor. Your goal is to identify red flags, pricing anomalies, and corruption indicators.\",\n    finding_types=[\n        FindingTypeConfig(\n            name=\"contract_entity\",\n            display_name=\"Contract Entity\",\n            description=\"Key parties: vendor, agency, contracting officer, subcontractors. Note: ownership structure, key personnel.\",\n            extracted_data_schema='{\"entity_name\": \"...\", \"entity_type\": \"...\", \"role\": \"...\", \"registration_info\": \"...\"}',\n            analysis_fallback=\"This entity information provides context for understanding the contract relationships.\",\n        ),\n        FindingTypeConfig(\n            name=\"contract_terms\",\n            display_name=\"Contract Terms\",\n            description=\"Value, duration, payment schedule, key rates. Note: unusual terms, milestone payments.\",\n            extracted_data_schema='{\"total_value\": \"...\", \"duration\": \"...\", \"payment_terms\": \"...\", \"key_rates\": \"...\", \"type\": \"fixed/cost-plus\"}',\n            analysis_fallback=\"These contract terms should be evaluated against industry standards and benchmarks.\",\n        ),\n        FindingTypeConfig(\n            name=\"pricing_analysis\",\n            display_name=\"Pricing Analysis\",\n            description=\"Cost breakdown, unit rates, comparison to market. Note: overhead, profit margins, labor vs. materials.\",\n            extracted_data_schema='{\"item\": \"...\", \"proposed_rate\": \"...\", \"market_rate\": \"...\", \"variance_percent\": \"...\", \"benchmark_source\": \"...\"}',\n            analysis_fallback=\"This pricing analysis helps assess whether contract rates are reasonable and competitive.\",\n        ),\n        FindingTypeConfig(\n            name=\"bid_process\",\n            display_name=\"Bid Process Finding\",\n            description=\"Competition level, bidders, evaluation criteria. Note: sole-source justifications, bid rotation patterns.\",\n            extracted_data_schema='{\"bid_count\": \"...\", \"bidder_names\": [...], \"award_basis\": \"...\", \"competition_type\": \"...\"}',\n            analysis_fallback=\"The bid process findings reveal the level of competition and potential procurement concerns.\",\n        ),\n        FindingTypeConfig(\n            name=\"suspicious_element\",\n            display_name=\"Suspicious Element\",\n            description=\"Unusual terms, sweetheart deals, conflict indicators. Examples: related party transactions, revolving door, bid steering.\",\n            extracted_data_schema='{\"element_type\": \"...\", \"description\": \"...\", \"severity\": \"high/medium/low\", \"related_parties\": [...], \"evidence\": \"...\"}',\n            analysis_fallback=\"This suspicious element warrants further investigation to assess potential impropriety.\",\n        ),\n        FindingTypeConfig(\n            name=\"connected_entity\",\n            display_name=\"Connected Entity\",\n            description=\"Related parties, shell companies, family businesses. Note: ownership overlaps, shared addresses, common executives.\",\n            extracted_data_schema='{\"primary_entity\": \"...\", \"connected_entity\": \"...\", \"relationship_type\": \"...\", \"evidence\": \"...\"}',\n            analysis_fallback=\"This connection between entities may indicate conflicts of interest or coordinated activity.\",\n        ),\n        FindingTypeConfig(\n            name=\"compliance_issue\",\n            display_name=\"Compliance Issue\",\n            description=\"Regulatory violations, missing documentation. Note: licensing, certifications, insurance, bonding.\",\n            extracted_data_schema='{\"requirement\": \"...\", \"status\": \"...\", \"violation_type\": \"...\", \"consequence\": \"...\"}',\n            analysis_fallback=\"This compliance issue may affect contract validity or create legal exposure.\",\n        ),\n        FindingTypeConfig(\n            name=\"performance_issue\",\n            display_name=\"Performance Issue\",\n            description=\"Delays, cost overruns, quality problems. Note: pattern across multiple contracts.\",\n            extracted_data_schema='{\"issue_type\": \"...\", \"original_value\": \"...\", \"actual_value\": \"...\", \"variance\": \"...\", \"cause\": \"...\"}',\n            analysis_fallback=\"This performance issue indicates potential problems with contractor capability or management.\",\n        ),\n        FindingTypeConfig(\n            name=\"comparable_contract\",\n            display_name=\"Comparable Contract\",\n            description=\"Similar contracts for benchmarking. Note: price per unit/sq ft/hour comparisons.\",\n            extracted_data_schema='{\"contract_id\": \"...\", \"agency\": \"...\", \"vendor\": \"...\", \"value\": \"...\", \"scope\": \"...\", \"outcome\": \"...\"}',\n            analysis_fallback=\"This comparable contract provides a benchmark for evaluating pricing and terms.\",\n        ),\n        FindingTypeConfig(\n            name=\"red_flag\",\n            display_name=\"Red Flag\",\n            description=\"Strong corruption or fraud indicators. Examples: phantom vendors, kickbacks, bid rigging, overbilling.\",\n            extracted_data_schema='{\"flag_type\": \"...\", \"description\": \"...\", \"risk_level\": \"high/critical\", \"supporting_evidence\": [...], \"recommended_investigation\": \"...\"}',\n            analysis_fallback=\"This red flag indicates potential fraud or corruption that requires immediate attention.\",\n        ),\n        FindingTypeConfig(\n            name=\"gap\",\n            display_name=\"Gap\",\n            description=\"Missing critical information needed. Note: what documents/data would help investigation.\",\n            extracted_data_schema='{\"information_needed\": \"...\", \"importance\": \"high/medium/low\", \"impact_on_analysis\": \"...\"}',\n            analysis_fallback=\"This information gap limits the completeness of the analysis and should be addressed.\",\n        ),\n        FindingTypeConfig(\n            name=\"date_timeline\",\n            display_name=\"Date/Timeline\",\n            description=\"Important dates and timeline inconsistencies. Note: contract award before bid deadline, rushed timelines.\",\n            extracted_data_schema='{\"event\": \"...\", \"date\": \"...\", \"significance\": \"...\", \"related_events\": [...]}',\n            analysis_fallback=\"This timeline information helps understand the sequence of events and identify anomalies.\",\n        ),\n    ],\n    analysis_instruction=\"\"\"YOUR EXPERT INVESTIGATIVE ANALYSIS (REQUIRED - 2-4 sentences) explaining:\n  * WHY this finding is significant for contract oversight or fraud detection\n  * What PATTERN or RED FLAG this represents in government contracting\n  * How this COMPARES to normal contracting practices or known fraud schemes\n  * What FURTHER INVESTIGATION or action this finding warrants\"\"\",\n    extraction_guidelines=\"\"\"CRITICAL: The \"analysis\" field must provide substantive investigative reasoning, not just describe the finding.\nGood example: \"This 40% price premium over market rate is a significant red flag in competitive bid environments. In similar cases, inflated pricing of this magnitude has been associated with kickback schemes where the excess margin funds illicit payments. The fact that this vendor has previously worked with the contracting officer warrants examination of their relationship and any campaign contributions or post-employment arrangements.\"\n\nCRITICAL: Prioritize RED_FLAG and SUSPICIOUS_ELEMENT findings. If you identify\npotential fraud indicators, ensure they are captured even if confidence is moderate.\nFalse negatives (missing fraud) are worse than false positives (flagging non-issues).\"\"\",\n\n    priority_finding_types=[\"red_flag\", \"suspicious_element\", \"compliance_issue\", \"pricing_analysis\", \"connected_entity\"],\n    grouping_order=[\"red_flag\", \"suspicious_element\", \"connected_entity\", \"compliance_issue\", \"pricing_analysis\", \"bid_process\", \"contract_terms\", \"performance_issue\", \"comparable_contract\", \"contract_entity\", \"date_timeline\", \"gap\"],\n)\n\n\nclass ContractTemplate(BaseTemplate):\n    \"\"\"Template for government contract evaluation and corruption detection.\"\"\"\n\n    template_id = \"contract\"\n    template_name = \"Government Contract Analysis\"\n    description = \"Analyze state/government contracts for overpricing, corruption, and suspicious elements\"\n\n    # Data-driven configuration\n    config = CONTRACT_CONFIG\n\n    # Report hints for component-based rendering\n    report_hints = ReportHints(\n        template_type=\"contract\",\n        structure=\"balanced\",\n        findings_grouping=\"category\",\n        tone=\"professional\",\n        decision_format=\"checklist\",\n        emphasis=[\"key_terms\", \"obligations\", \"risks\", \"opportunities\"],\n        required_components=[\n            ComponentType.CONTRACT_ANALYSIS,\n            ComponentType.CHECKLIST,\n            ComponentType.RISK_MATRIX,\n        ],\n        optional_components=[\n            ComponentType.FINDINGS_TABLE,\n            ComponentType.ACTION_ITEMS,\n            ComponentType.COMPARISON_TABLE,\n            ComponentType.KEY_INSIGHTS,\n        ],\n        visualization_preference=[\"contract_structure\", \"obligation_timeline\", \"risk_assessment\"],\n        custom_sections={\n            \"show_pricing_comparison\": True,\n            \"red_flag_priority\": True,\n            \"vendor_history\": True,\n        }\n    )\n\n    # Expert perspectives for contract analysis\n    default_perspectives = [\n        \"contract_auditor\",           # Pricing and cost analysis\n        \"procurement_investigator\",   # Bid process, competition issues\n        \"forensic_accountant\",        # Financial red flags\n        \"regulatory_compliance\",      # Legal requirements\n        \"industry_benchmarker\",       # Market rate comparison\n    ]\n\n    default_max_searches = 12\n\n    # Thorough verification for fraud detection\n    verification_config = {\n        \"cross_reference\": \"thorough\",\n        \"bias_detection\": \"thorough\",\n        \"expert_sanity_check\": \"thorough\",\n        \"source_quality\": \"thorough\",\n    }\n\n    def get_supported_report_variants(self) -> List[str]:\n        \"\"\"Contract template supports red_flags_summary and pricing_analysis variants.\"\"\"\n        return [\"full_report\", \"executive_summary\", \"red_flags_summary\", \"pricing_analysis\"]\n\n    def generate_red_flags_summary(\n        self,\n        result: Dict[str, Any],\n        title: Optional[str] = None,\n    ) -> str:\n        \"\"\"Generate red flags summary report - contract-specific variant.\"\"\"\n        query = result.get(\"query\", \"Unknown\")\n        report_title = title or f\"Red Flags Summary: {query[:40]}\"\n\n        sections = []\n        sections.append(f\"# {report_title}\")\n        sections.append(\"\")\n        sections.append(f\"**Contract/Subject:** {query}\")\n        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n        sections.append(\"\")\n        sections.append(\"---\")\n        sections.append(\"\")\n\n        findings = result.get(\"findings\", [])\n\n        # Critical Red Flags\n        red_flags = [f for f in findings if f.get(\"finding_type\") == \"red_flag\"]\n        sections.append(\"## Critical Red Flags\")\n        sections.append(\"\")\n        if red_flags:\n            for rf in red_flags:\n                extracted = rf.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    flag_type = extracted.get(\"flag_type\", \"Unknown\")\n                    risk_level = extracted.get(\"risk_level\", \"high\")\n                    sections.append(f\"### {flag_type.replace('_', ' ').title()} ({risk_level.upper()} RISK)\")\n                    sections.append(\"\")\n                    sections.append(rf.get(\"content\", \"\"))\n                    sections.append(\"\")\n                    evidence = extracted.get(\"supporting_evidence\", [])\n                    if evidence:\n                        sections.append(\"**Supporting Evidence:**\")\n                        for e in evidence[:3]:\n                            sections.append(f\"- {e}\")\n                        sections.append(\"\")\n                    recommendation = extracted.get(\"recommended_investigation\", \"\")\n                    if recommendation:\n                        sections.append(f\"**Recommended Investigation:** {recommendation}\")\n                        sections.append(\"\")\n                else:\n                    sections.append(f\"- **RED FLAG**: {rf.get('summary') or rf.get('content', '')[:150]}\")\n        else:\n            sections.append(\"No critical red flags identified.\")\n        sections.append(\"\")\n\n        # Suspicious Elements\n        suspicious = [f for f in findings if f.get(\"finding_type\") == \"suspicious_element\"]\n        if suspicious:\n            sections.append(\"## Suspicious Elements\")\n            sections.append(\"\")\n            for se in suspicious:\n                extracted = se.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    element_type = extracted.get(\"element_type\", \"Unknown\")\n                    severity = extracted.get(\"severity\", \"medium\")\n                    sections.append(f\"- **{element_type.replace('_', ' ').title()}** ({severity}): {se.get('summary', '')}\")\n                else:\n                    sections.append(f\"- {se.get('summary') or se.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Connected Entities (potential conflicts)\n        connected = [f for f in findings if f.get(\"finding_type\") == \"connected_entity\"]\n        if connected:\n            sections.append(\"## Connected Entities (Potential Conflicts)\")\n            sections.append(\"\")\n            for ce in connected:\n                extracted = ce.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    primary = extracted.get(\"primary_entity\", \"Unknown\")\n                    related = extracted.get(\"connected_entity\", \"Unknown\")\n                    rel_type = extracted.get(\"relationship_type\", \"related to\")\n                    sections.append(f\"- **{primary}** {rel_type} **{related}**\")\n                else:\n                    sections.append(f\"- {ce.get('summary') or ce.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Compliance Issues\n        compliance = [f for f in findings if f.get(\"finding_type\") == \"compliance_issue\"]\n        if compliance:\n            sections.append(\"## Compliance Issues\")\n            sections.append(\"\")\n            for ci in compliance:\n                sections.append(f\"- {ci.get('summary') or ci.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Bid Process Concerns\n        bid_issues = [f for f in findings if f.get(\"finding_type\") == \"bid_process\"]\n        if bid_issues:\n            sections.append(\"## Bid Process Concerns\")\n            sections.append(\"\")\n            for bi in bid_issues:\n                extracted = bi.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    bid_count = extracted.get(\"bid_count\", \"Unknown\")\n                    competition_type = extracted.get(\"competition_type\", \"Unknown\")\n                    sections.append(f\"- **Bids:** {bid_count} | **Competition:** {competition_type}\")\n                    sections.append(f\"  {bi.get('content', '')[:200]}\")\n                else:\n                    sections.append(f\"- {bi.get('summary') or bi.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Risk Assessment from Perspectives\n        perspectives = result.get(\"perspectives\", [])\n        all_warnings = []\n        for p in perspectives:\n            all_warnings.extend(p.get(\"warnings\", []))\n        if all_warnings:\n            sections.append(\"## Expert Risk Assessment\")\n            sections.append(\"\")\n            for warning in all_warnings[:8]:\n                sections.append(f\"- {warning}\")\n            sections.append(\"\")\n\n        # Recommended Investigations\n        sections.append(\"## Recommended Actions\")\n        sections.append(\"\")\n        for p in perspectives:\n            recs = p.get(\"recommendations\", [])\n            for rec in recs[:2]:\n                sections.append(f\"- {rec}\")\n        sections.append(\"\")\n\n        return \"\\n\".join(sections)\n\n    def generate_pricing_analysis(\n        self,\n        result: Dict[str, Any],\n        title: Optional[str] = None,\n    ) -> str:\n        \"\"\"Generate pricing analysis report - contract-specific variant.\"\"\"\n        query = result.get(\"query\", \"Unknown\")\n        report_title = title or f\"Pricing Analysis: {query[:40]}\"\n\n        sections = []\n        sections.append(f\"# {report_title}\")\n        sections.append(\"\")\n        sections.append(f\"**Contract/Subject:** {query}\")\n        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n        sections.append(\"\")\n        sections.append(\"---\")\n        sections.append(\"\")\n\n        findings = result.get(\"findings\", [])\n\n        # Contract Terms Summary\n        terms = [f for f in findings if f.get(\"finding_type\") == \"contract_terms\"]\n        if terms:\n            sections.append(\"## Contract Terms\")\n            sections.append(\"\")\n            for t in terms:\n                extracted = t.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    value = extracted.get(\"total_value\", \"Unknown\")\n                    duration = extracted.get(\"duration\", \"Unknown\")\n                    contract_type = extracted.get(\"type\", \"Unknown\")\n                    sections.append(f\"- **Total Value:** ${value:,}\" if isinstance(value, (int, float)) else f\"- **Total Value:** {value}\")\n                    sections.append(f\"- **Duration:** {duration}\")\n                    sections.append(f\"- **Contract Type:** {contract_type}\")\n                else:\n                    sections.append(f\"- {t.get('content', '')[:200]}\")\n            sections.append(\"\")\n\n        # Pricing Analysis Details\n        pricing = [f for f in findings if f.get(\"finding_type\") == \"pricing_analysis\"]\n        if pricing:\n            sections.append(\"## Pricing Comparison\")\n            sections.append(\"\")\n            sections.append(\"| Item | Proposed Rate | Market Rate | Variance |\")\n            sections.append(\"|------|--------------|-------------|----------|\")\n            for p in pricing:\n                extracted = p.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    item = extracted.get(\"item\", \"Unknown\")\n                    proposed = extracted.get(\"proposed_rate\", \"N/A\")\n                    market = extracted.get(\"market_rate\", \"N/A\")\n                    variance = extracted.get(\"variance_percent\", \"N/A\")\n                    sections.append(f\"| {item} | {proposed} | {market} | {variance}% |\")\n                else:\n                    sections.append(f\"- {p.get('summary') or p.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Comparable Contracts\n        comparables = [f for f in findings if f.get(\"finding_type\") == \"comparable_contract\"]\n        if comparables:\n            sections.append(\"## Comparable Contracts\")\n            sections.append(\"\")\n            for c in comparables:\n                extracted = c.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    agency = extracted.get(\"agency\", \"Unknown\")\n                    vendor = extracted.get(\"vendor\", \"Unknown\")\n                    value = extracted.get(\"value\", \"Unknown\")\n                    sections.append(f\"- **{agency}** with {vendor}: ${value:,}\" if isinstance(value, (int, float)) else f\"- **{agency}** with {vendor}: {value}\")\n                else:\n                    sections.append(f\"- {c.get('summary') or c.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Performance Issues (cost overruns)\n        performance = [f for f in findings if f.get(\"finding_type\") == \"performance_issue\"]\n        if performance:\n            sections.append(\"## Historical Performance Issues\")\n            sections.append(\"\")\n            for perf in performance:\n                extracted = perf.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    issue_type = extracted.get(\"issue_type\", \"Unknown\")\n                    variance = extracted.get(\"variance\", \"Unknown\")\n                    sections.append(f\"- **{issue_type.replace('_', ' ').title()}**: {variance} variance\")\n                else:\n                    sections.append(f\"- {perf.get('summary') or perf.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Industry Benchmarking Perspective\n        perspectives = result.get(\"perspectives\", [])\n        benchmarker = next((p for p in perspectives if \"benchmark\" in p.get(\"perspective_type\", \"\").lower()), None)\n        if benchmarker:\n            sections.append(\"## Industry Benchmarking Analysis\")\n            sections.append(\"\")\n            sections.append(benchmarker.get(\"analysis_text\", \"\")[:500])\n            sections.append(\"\")\n\n        # Value Assessment\n        sections.append(\"## Value Assessment\")\n        sections.append(\"\")\n        auditor = next((p for p in perspectives if \"auditor\" in p.get(\"perspective_type\", \"\").lower()), None)\n        if auditor:\n            insights = auditor.get(\"key_insights\", [])\n            for insight in insights[:4]:\n                sections.append(f\"- {insight}\")\n        sections.append(\"\")\n\n        return \"\\n\".join(sections)\n\n    def _generate_report_header(self, result: Dict[str, Any]) -> str:\n        \"\"\"Generate contract-specific header with risk summary.\"\"\"\n        findings = result.get(\"findings\", [])\n\n        red_flags = len([f for f in findings if f.get(\"finding_type\") == \"red_flag\"])\n        suspicious = len([f for f in findings if f.get(\"finding_type\") == \"suspicious_element\"])\n        compliance = len([f for f in findings if f.get(\"finding_type\") == \"compliance_issue\"])\n\n        if red_flags > 0 or suspicious > 0:\n            risk_level = \"HIGH\" if red_flags >= 2 else \"MEDIUM\" if red_flags >= 1 or suspicious >= 2 else \"LOW\"\n            return f\"\"\"## Risk Summary\n\n**Overall Risk Level:** {risk_level}\n\n- **Critical Red Flags:** {red_flags}\n- **Suspicious Elements:** {suspicious}\n- **Compliance Issues:** {compliance}\"\"\"\n        return \"\"\n\n    def _generate_key_sections(self, result: Dict[str, Any]) -> str:\n        \"\"\"Generate contract-specific key sections: Red Flags Summary, Pricing Overview.\"\"\"\n        findings = result.get(\"findings\", [])\n        sections = []\n\n        # Red Flags Summary\n        red_flags = [f for f in findings if f.get(\"finding_type\") == \"red_flag\"]\n        if red_flags:\n            sections.append(\"## Red Flags Summary\")\n            sections.append(\"\")\n            for rf in red_flags[:5]:\n                extracted = rf.get(\"extracted_data\", {})\n                if extracted and isinstance(extracted, dict):\n                    flag_type = extracted.get(\"flag_type\", \"Unknown\")\n                    risk_level = extracted.get(\"risk_level\", \"high\")\n                    sections.append(f\"- **[{risk_level.upper()}]** {flag_type.replace('_', ' ').title()}: {rf.get('summary', '')}\")\n                else:\n                    sections.append(f\"- {rf.get('summary') or rf.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        # Pricing Overview\n        pricing = [f for f in findings if f.get(\"finding_type\") == \"pricing_analysis\"]\n        if pricing:\n            sections.append(\"## Pricing Overview\")\n            sections.append(\"\")\n            for p in pricing[:4]:\n                sections.append(f\
[2026-01-30T14:11:44.528Z] [STDOUT] "- {p.get('summary') or p.get('content', '')[:100]}\")\n            sections.append(\"\")\n\n        return \"\\n\".join(sections)\n\n    def _generate_executive_highlights(self, result: Dict[str, Any]) -> str:\n        \"\"\"Generate contract-specific executive highlights focusing on risk.\"\"\"\n        findings = result.get(\"findings\", [])\n        sections = []\n\n        # Risk indicators\n        red_flags = [f for f in findings if f.get(\"finding_type\") == \"red_flag\"]\n        suspicious = [f for f in findings if f.get(\"finding_type\") == \"suspicious_element\"]\n\n        if red_flags or suspicious:\n            sections.append(\"## Risk Indicators\")\n            sections.append(\"\")\n            for rf in red_flags[:3]:\n                sections.append(f\"- **RED FLAG**: {rf.get('summary') or rf.get('content', '')[:80]}\")\n            for se in suspicious[:2]:\n                sections.append(f\"- **SUSPICIOUS**: {se.get('summary') or se.get('content', '')[:80]}\")\n            sections.append(\"\")\n\n        return \"\\n\".join(sections)\n","numLines":578,"startLine":1,"totalLines":578}}}
