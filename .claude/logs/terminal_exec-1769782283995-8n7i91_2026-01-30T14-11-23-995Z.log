 - 40, pos.x));\n    93→        pos.y = Math.max(40, Math.min(height - 40, pos.y));\n    94→      });\n    95→    }\n    96→\n    97→    setPositions(newPositions);\n    98→  }, [nodes, edges]);\n    99→\n   100→  return (\n   101→    <div\n   102→      ref={containerRef}\n   103→      className={`relative w-full h-64 rounded-xl overflow-hidden ${surfaceClasses}`}\n   104→    >\n   105→      {/* Grid pattern */}\n   106→      <svg className=\"absolute inset-0 w-full h-full opacity-10\">\n   107→        <defs>\n   108→          <pattern id=\"grid\" width=\"20\" height=\"20\" patternUnits=\"userSpaceOnUse\">\n   109→            <path d=\"M 20 0 L 0 0 0 20\" fill=\"none\" stroke={colors.primary} strokeWidth=\"0.5\" />\n   110→          </pattern>\n   111→        </defs>\n   112→        <rect width=\"100%\" height=\"100%\" fill=\"url(#grid)\" />\n   113→      </svg>\n   114→\n   115→      {/* Edges */}\n   116→      <svg className=\"absolute inset-0 w-full h-full\">\n   117→        {edges.map((edge, i) => {\n   118→          const from = positions.get(edge.source);\n   119→          const to = positions.get(edge.target);\n   120→          if (!from || !to) return null;\n   121→          const isHighlighted = hoveredNode === edge.source || hoveredNode === edge.target;\n   122→          return (\n   123→            <motion.line\n   124→              key={i}\n   125→              initial={{ pathLength: 0, opacity: 0 }}\n   126→              animate={{ pathLength: 1, opacity: isHighlighted ? 0.8 : 0.3 }}\n   127→              transition={{ duration: 0.5, delay: i * 0.02 }}\n   128→              x1={from.x}\n   129→              y1={from.y}\n   130→              x2={to.x}\n   131→              y2={to.y}\n   132→              stroke={edge.type === 'contradicts' ? colors.contradictionLine : colors.connectionLine}\n   133→              strokeWidth={isHighlighted ? 2 : 1}\n   134→              strokeDasharray={edge.type === 'contradicts' ? '4,4' : undefined}\n   135→            />\n   136→          );\n   137→        })}\n   138→      </svg>\n   139→\n   140→      {/* Nodes */}\n   141→      {nodes.map((node, i) => {\n   142→        const pos = positions.get(node.id);\n   143→        if (!pos) return null;\n   144→        const color = getEntityColor(node.type);\n   145→        const size = 12 + node.value * 20;\n   146→        const isHovered = hoveredNode === node.id;\n   147→        const isHighlightedNode = highlightedNode === node.id;\n   148→\n   149→        return (\n   150→          <motion.div\n   151→            key={node.id}\n   152→            initial={{ scale: 0, opacity: 0 }}\n   153→            animate={{\n   154→              scale: isHovered || isHighlightedNode ? 1.3 : 1,\n   155→              opacity: 1,\n   156→              x: pos.x - size / 2,\n   157→              y: pos.y - size / 2,\n   158→            }}\n   159→            transition={{ type: 'spring', damping: 20, delay: i * 0.03 }}\n   160→            className=\"absolute cursor-pointer\"\n   161→            style={{ width: size, height: size }}\n   162→            onMouseEnter={() => setHoveredNode(node.id)}\n   163→            onMouseLeave={() => setHoveredNode(null)}\n   164→            onClick={() => onNodeClick?.(node.id)}\n   165→          >\n   166→            <div\n   167→              className=\"w-full h-full rounded-full flex items-center justify-center transition-shadow\"\n   168→              style={{\n   169→                backgroundColor: color,\n   170→                boxShadow: isHovered || isHighlightedNode ? `0 0 20px ${color}` : `0 0 8px ${color}50`,\n   171→              }}\n   172→            >\n   173→              {isHovered && (\n   174→                <motion.div\n   175→                  initial={{ opacity: 0, y: 10 }}\n   176→                  animate={{ opacity: 1, y: 0 }}\n   177→                  className={`absolute -bottom-8 left-1/2 -translate-x-1/2 whitespace-nowrap px-2 py-1 rounded text-[10px] font-medium ${tooltipClasses}`}\n   178→                >\n   179→                  {node.label}\n   180→                </motion.div>\n   181→              )}\n   182→            </div>\n   183→          </motion.div>\n   184→        );\n   185→      })}\n   186→    </div>\n   187→  );\n   188→}\n   189→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"86fbfc1a-4772-433d-bdd8-8a7ad125f24a","uuid":"9d3ddd08-852c-4202-8767-900ecca3e317","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\visualizations\\NetworkGraph.tsx","content":"'use client';\n\nimport { useEffect, useRef, useState } from 'react';\nimport { motion } from 'framer-motion';\nimport { useVisualizationTheme } from './useVisualizationTheme';\n\ninterface Node {\n  id: string;\n  label: string;\n  type: 'finding' | 'source' | 'entity' | 'perspective';\n  value: number; // 0-1 for sizing\n  x?: number;\n  y?: number;\n}\n\ninterface Edge {\n  source: string;\n  target: string;\n  strength: number; // 0-1\n  type?: 'supports' | 'contradicts' | 'references';\n}\n\ninterface NetworkGraphProps {\n  nodes: Node[];\n  edges: Edge[];\n  onNodeClick?: (nodeId: string) => void;\n  highlightedNode?: string;\n}\n\nexport function NetworkGraph({ nodes, edges, onNodeClick, highlightedNode }: NetworkGraphProps) {\n  const { colors, isRadar, entityColors, getEntityColor, surfaceClasses, tooltipClasses } = useVisualizationTheme();\n  const containerRef = useRef<HTMLDivElement>(null);\n  const [positions, setPositions] = useState<Map<string, { x: number; y: number }>>(new Map());\n  const [hoveredNode, setHoveredNode] = useState<string | null>(null);\n\n  // Force-directed layout simulation\n  useEffect(() => {\n    if (!containerRef.current || nodes.length === 0) return;\n\n    const width = containerRef.current.offsetWidth;\n    const height = containerRef.current.offsetHeight;\n    const centerX = width / 2;\n    const centerY = height / 2;\n\n    // Initialize positions in a circle\n    const newPositions = new Map<string, { x: number; y: number }>();\n    nodes.forEach((node, i) => {\n      const angle = (i / nodes.length) * Math.PI * 2;\n      const radius = Math.min(width, height) * 0.35;\n      newPositions.set(node.id, {\n        x: centerX + Math.cos(angle) * radius,\n        y: centerY + Math.sin(angle) * radius,\n      });\n    });\n\n    // Simple force simulation\n    const iterations = 50;\n    for (let iter = 0; iter < iterations; iter++) {\n      // Repulsion between all nodes\n      nodes.forEach((nodeA) => {\n        nodes.forEach((nodeB) => {\n          if (nodeA.id === nodeB.id) return;\n          const posA = newPositions.get(nodeA.id)!;\n          const posB = newPositions.get(nodeB.id)!;\n          const dx = posA.x - posB.x;\n          const dy = posA.y - posB.y;\n          const dist = Math.sqrt(dx * dx + dy * dy) || 1;\n          const force = 1000 / (dist * dist);\n          posA.x += (dx / dist) * force * 0.1;\n          posA.y += (dy / dist) * force * 0.1;\n        });\n      });\n\n      // Attraction along edges\n      edges.forEach((edge) => {\n        const posA = newPositions.get(edge.source);\n        const posB = newPositions.get(edge.target);\n        if (!posA || !posB) return;\n        const dx = posB.x - posA.x;\n        const dy = posB.y - posA.y;\n        const dist = Math.sqrt(dx * dx + dy * dy) || 1;\n        const force = dist * 0.01 * edge.strength;\n        posA.x += (dx / dist) * force;\n        posA.y += (dy / dist) * force;\n        posB.x -= (dx / dist) * force;\n        posB.y -= (dy / dist) * force;\n      });\n\n      // Keep in bounds\n      nodes.forEach((node) => {\n        const pos = newPositions.get(node.id)!;\n        pos.x = Math.max(40, Math.min(width - 40, pos.x));\n        pos.y = Math.max(40, Math.min(height - 40, pos.y));\n      });\n    }\n\n    setPositions(newPositions);\n  }, [nodes, edges]);\n\n  return (\n    <div\n      ref={containerRef}\n      className={`relative w-full h-64 rounded-xl overflow-hidden ${surfaceClasses}`}\n    >\n      {/* Grid pattern */}\n      <svg className=\"absolute inset-0 w-full h-full opacity-10\">\n        <defs>\n          <pattern id=\"grid\" width=\"20\" height=\"20\" patternUnits=\"userSpaceOnUse\">\n            <path d=\"M 20 0 L 0 0 0 20\" fill=\"none\" stroke={colors.primary} strokeWidth=\"0.5\" />\n          </pattern>\n        </defs>\n        <rect width=\"100%\" height=\"100%\" fill=\"url(#grid)\" />\n      </svg>\n\n      {/* Edges */}\n      <svg className=\"absolute inset-0 w-full h-full\">\n        {edges.map((edge, i) => {\n          const from = positions.get(edge.source);\n          const to = positions.get(edge.target);\n          if (!from || !to) return null;\n          const isHighlighted = hoveredNode === edge.source || hoveredNode === edge.target;\n          return (\n            <motion.line\n              key={i}\n              initial={{ pathLength: 0, opacity: 0 }}\n              animate={{ pathLength: 1, opacity: isHighlighted ? 0.8 : 0.3 }}\n              transition={{ duration: 0.5, delay: i * 0.02 }}\n              x1={from.x}\n              y1={from.y}\n              x2={to.x}\n              y2={to.y}\n              stroke={edge.type === 'contradicts' ? colors.contradictionLine : colors.connectionLine}\n              strokeWidth={isHighlighted ? 2 : 1}\n              strokeDasharray={edge.type === 'contradicts' ? '4,4' : undefined}\n            />\n          );\n        })}\n      </svg>\n\n      {/* Nodes */}\n      {nodes.map((node, i) => {\n        const pos = positions.get(node.id);\n        if (!pos) return null;\n        const color = getEntityColor(node.type);\n        const size = 12 + node.value * 20;\n        const isHovered = hoveredNode === node.id;\n        const isHighlightedNode = highlightedNode === node.id;\n\n        return (\n          <motion.div\n            key={node.id}\n            initial={{ scale: 0, opacity: 0 }}\n            animate={{\n              scale: isHovered || isHighlightedNode ? 1.3 : 1,\n              opacity: 1,\n              x: pos.x - size / 2,\n              y: pos.y - size / 2,\n            }}\n            transition={{ type: 'spring', damping: 20, delay: i * 0.03 }}\n            className=\"absolute cursor-pointer\"\n            style={{ width: size, height: size }}\n            onMouseEnter={() => setHoveredNode(node.id)}\n            onMouseLeave={() => setHoveredNode(null)}\n            onClick={() => onNodeClick?.(node.id)}\n          >\n            <div\n              className=\"w-full h-full rounded-full flex items-center justify-center transition-shadow\"\n              style={{\n                backgroundColor: color,\n                boxShadow: isHovered || isHighlightedNode ? `0 0 20px ${color}` : `0 0 8px ${color}50`,\n              }}\n            >\n              {isHovered && (\n                <motion.div\n                  initial={{ opacity: 0, y: 10 }}\n                  animate={{ opacity: 1, y: 0 }}\n                  className={`absolute -bottom-8 left-1/2 -translate-x-1/2 whitespace-nowrap px-2 py-1 rounded text-[10px] font-medium ${tooltipClasses}`}\n                >\n                  {node.label}\n                </motion.div>\n              )}\n            </div>\n          </motion.div>\n        );\n      })}\n    </div>\n  );\n}\n","numLines":189,"startLine":1,"totalLines":189}}}
