{(1 - progress) * -distance}px)`,\n    45→  };\n    46→\n    47→  return (\n    48→    <div style={{ opacity: progress, transform: transforms[direction] }}>\n    49→      {children}\n    50→    </div>\n    51→  );\n    52→}\n    53→\n    54→// Scale with fade - for emphasis\n    55→interface ScaleProps {\n    56→  frame: number;\n    57→  fps: number;\n    58→  delay?: number;\n    59→  durationFrames?: number;\n    60→  from?: number;\n    61→  children: React.ReactNode;\n    62→}\n    63→\n    64→export function Scale({ frame, fps, delay = 0, durationFrames = 20, from = 0.85, children }: ScaleProps) {\n    65→  const progress = spring({ frame, fps, delay, durationFrames, easing: easeOutCubic });\n    66→\n    67→  return (\n    68→    <div style={{ opacity: progress, transform: `scale(${from + (1 - from) * progress})` }}>\n    69→      {children}\n    70→    </div>\n    71→  );\n    72→}\n    73→\n    74→// Staggered list items\n    75→interface StaggerProps {\n    76→  frame: number;\n    77→  fps: number;\n    78→  delay?: number;\n    79→  stagger?: number;\n    80→  durationFrames?: number;\n    81→  index: number;\n    82→  direction?: 'left' | 'right' | 'up';\n    83→  children: React.ReactNode;\n    84→}\n    85→\n    86→export function Stagger({ frame, fps, delay = 0, stagger = 5, durationFrames = 18, index, direction = 'right', children }: StaggerProps) {\n    87→  const progress = spring({ frame, fps, delay: delay + index * stagger, durationFrames, easing: easeOutCubic });\n    88→\n    89→  const transforms = {\n    90→    left: `translateX(${(1 - progress) * -20}px)`,\n    91→    right: `translateX(${(1 - progress) * 20}px)`,\n    92→    up: `translateY(${(1 - progress) * 15}px)`,\n    93→  };\n    94→\n    95→  return (\n    96→    <div style={{ opacity: progress, transform: transforms[direction] }}>\n    97→      {children}\n    98→    </div>\n    99→  );\n   100→}\n   101→\n   102→// Counter animation\n   103→interface CountUpProps {\n   104→  value