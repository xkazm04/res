l analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"86fbfc1a-4772-433d-bdd8-8a7ad125f24a","uuid":"9dcb9733-19ef-404c-a4c2-46f6befe6845","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\visualizations\\SourceNetwork.tsx","content":"'use client';\n\nimport { useState, useEffect, useRef } from 'react';\nimport { motion } from 'framer-motion';\nimport { useVisualizationTheme } from './useVisualizationTheme';\nimport type { ResearchSource } from '@/src/types/research';\n\ninterface SourceNetworkProps {\n  sources: ResearchSource[];\n  onSourceSelect?: (id: string) => void;\n  selectedSource?: string;\n}\n\ninterface SourceNode {\n  id: string;\n  x: number;\n  y: number;\n  radius: number;\n  credibility: number;\n  domain: string;\n  type: string;\n}\n\nexport function SourceNetwork({ sources, onSourceSelect, selectedSource }: SourceNetworkProps) {\n  const { colors, isRadar, surfaceClasses, getCredibilityColor } = useVisualizationTheme();\n  const containerRef = useRef<HTMLDivElement>(null);\n  const [nodes, setNodes] = useState<SourceNode[]>([]);\n  const [hoveredNode, setHoveredNode] = useState<string | null>(null);\n  const [dimensions, setDimensions] = useState({ width: 400, height: 300 });\n\n  // Group sources by domain and calculate positions\n  useEffect(() => {\n    if (!containerRef.current) return;\n    const rect = containerRef.current.getBoundingClientRect();\n    setDimensions({ width: rect.width, height: 300 });\n  }, []);\n\n  useEffect(() => {\n    const { width, height } = dimensions;\n    const centerX = width / 2;\n    const centerY = height / 2;\n    const maxRadius = Math.min(width, height) * 0.4;\n\n    // Position nodes in concentric circles by credibility\n    const positioned: SourceNode[] = sources.map((s, i) => {\n      const cred = s.credibility_score || 0.5;\n      const radius = maxRadius * (1 - cred * 0.8); // Higher cred = closer to center\n      const angle = (i / sources.length) * Math.PI * 2 + Math.random() * 0.3;\n\n      return {\n        id: s.id,\n        x: centerX + Math.cos(angle) * radius,\n        y: centerY + Math.sin(angle) * radius,\n        radius: 6 + cred * 14,\n        credibility: cred,\n        domain: s.domain || 'unknown',\n        type: s.source_type || 'web',\n      };\n    });\n\n    setNodes(positioned);\n  }, [sources, dimensions]);\n\n  return (\n    <div ref={containerRef} className={`relative rounded-xl overflow-hidden ${surfaceClasses}`} style={{ height: 300 }}>\n      {/* Trust rings */}\n      <svg className=\"absolute inset-0\" width={dimensions.width} height={dimensions.height}>\n        {[0.8, 0.5, 0.2].map((level) => (\n          <circle\n            key={level}\n            cx={dimensions.width / 2}\n            cy={dimensions.height / 2}\n            r={Math.min(dimensions.width, dimensions.height) * 0.4 * (1 - level * 0.8)}\n            fill=\"none\"\n            stroke={colors.gridLine}\n            strokeDasharray=\"4 4\"\n          />\n        ))}\n\n        {/* Nodes */}\n        {nodes.map((node) => (\n          <g key={node.id}>\n            <motion.circle\n              initial={{ scale: 0 }}\n              animate={{\n                scale: hoveredNode === node.id || selectedSource === node.id ? 1.5 : 1,\n                opacity: hoveredNode && hoveredNode !== node.id ? 0.4 : 1\n              }}\n              cx={node.x}\n              cy={node.y}\n              r={node.radius}\n              fill={getCredibilityColor(node.credibility)}\n              stroke={selectedSource === node.id ? (isRadar ? '#fff' : '#000') : 'transparent'}\n              strokeWidth={2}\n              className=\"cursor-pointer\"\n              onMouseEnter={() => setHoveredNode(node.id)}\n              onMouseLeave={() => setHoveredNode(null)}\n              onClick={() => onSourceSelect?.(node.id)}\n            />\n          </g>\n        ))}\n      </svg>\n\n      {/* Labels */}\n      <div className=\"absolute bottom-3 left-3 flex items-center gap-4 text-[10px]\" style={{ color: colors.textSecondary }}>\n        <span className=\"flex items-center gap-1\">\n          <span className=\"w-2 h-2 rounded-full\" style={{ backgroundColor: colors.success }} /> High\n        </span>\n        <span className=\"flex items-center gap-1\">\n          <span className=\"w-2 h-2 rounded-full\" style={{ backgroundColor: colors.warning }} /> Medium\n        </span>\n        <span className=\"flex items-center gap-1\">\n          <span className=\"w-2 h-2 rounded-full\" style={{ backgroundColor: colors.danger }} /> Low\n        </span>\n      </div>\n\n      {/* Center label */}\n      <div\n        className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-center pointer-events-none\"\n        style={{ color: isRadar ? colors.primaryMuted : colors.textMuted }}\n      >\n        <div className=\"text-[10px] uppercase tracking-wider\">Trust Core</div>\n      </div>\n    </div>\n  );\n}\n","numLines":127,"startLine":1,"totalLines":127}}}
