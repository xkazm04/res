[2026-01-30T14:12:14.025Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018wUE8KVk9DxU2X76Uakxiz","type":"tool_result","content":"     1→'use client';\n     2→\n     3→import { useMemo } from 'react';\n     4→import { spring, easeOutCubic, easeOutQuart } from './useVideoPlayback';\n     5→\n     6→interface BarChartProps {\n     7→  data: Array<{ label: string; value: number; color?: string }>;\n     8→  frame: number;\n     9→  fps: number;\n    10→  width?: number;\n    11→  height?: number;\n    12→  isRadar?: boolean;\n    13→}\n    14→\n    15→export function AnimatedBarChart({ data, frame, fps, width = 240, height = 140, isRadar = true }: BarChartProps) {\n    16→  const max = Math.max(...data.map(d => d.value), 1);\n    17→  const barWidth = Math.floor((width - (data.length - 1) * 10) / data.length);\n    18→\n    19→  // Pre-calculate all bar heights to avoid recalculation\n    20→  const bars = useMemo(() => {\n    21→    return data.map((item, i) => {\n    22→      const baseHeight = (item.value / max) * (height - 28);\n    23→      return {\n    24→        ...item,\n    25→        baseHeight,\n    26→        x: i * (barWidth + 10),\n    27→      };\n    28→    });\n    29→  }, [data, max, height, barWidth]);\n    30→\n    31→  // Define gradient\n    32→  const gradientId = useMemo(() => `barGrad-${Math.random().toString(36).substr(2, 9)}`, []);\n    33→\n    34→  return (\n    35→    <svg width={width} height={height} style={{ overflow: 'visible' }}>\n    36→      <defs>\n    37→        <linearGradient id={gradientId} x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n    38→          <stop offset=\"0%\" stopColor={isRadar ? '#22d3ee' : '#3b82f6'} stopOpacity=\"1\" />\n    39→          <stop offset=\"100%\" stopColor={isRadar ? '#0891b2' : '#1d4ed8'} stopOpacity=\"0.8\" />\n    40→        </linearGradient>\n    41→        <filter id=\"barGlow\" x=\"-50%\" y=\"-50%\" width=\"200%\" height=\"200%\">\n    42→          <feGaussianBlur stdDeviation=\"3\" result=\"blur\" />\n    43→          <feMerge>\n    44→            <feMergeNode in=\"blur\" />\n    45→            <feMergeNode in=\"SourceGraphic\" />\n    46→          </feMerge>\n    47→        </filter>\n    48→      </defs>\n    49→      {bars.map((bar, i) => {\n    50→        const progress = spring({ frame, fps, delay: i * 4, durationFrames: 28, easing: easeOutQuart });\n    51→        const barHeight = bar.baseHeight * progress;\n    52→\n    53→        return (\n    54→          <g key={i}>\n    55→            {/* Glow effect */}\n    56→            <rect\n    57→              x={bar.x + 2}\n    58→              y={height - 22 - barHeight}\n    59→              width={barWidth - 4}\n    60→              height={Math.max(0, barHeight)}\n    61→              fill={isRadar ? '#22d3ee' : '#3b82f6'}\n    62→              rx={4}\n    63→              opacity={0.2}\n    64→              filter=\"url(#barGlow)\"\n    65→            />\n    66→            {/* Bar */}\n    67→            <rect\n    68→              x={bar.x}\n    69→              y={height - 22 - barHeight}\n    70→              width={barWidth}\n    71→              height={Math.max(0, barHeight)}\n    72→              fill={`url(#${gradientId})`}\n    73→              rx={4}\n    74→            />\n    75→            {/* Top highlight */}\n    76→            {barHeight > 4 && (\n    77→              <rect\n    78→                x={bar.x + 2}\n    79→                y={height - 22 - barHeight + 2}\n    80→                width={barWidth - 4}\n    81→                height={3}\n    82→                fill=\"white\"\n    83→                rx={2}\n    84→                opacity={0.3}\n    85→              />\n    86→            )}\n    87→            {/* Label */}\n    88→            <text\n    89→              x={bar.x + barWidth / 2}\n    90→              y={height - 6}\n    91→              textAnchor=\"middle\"\n    92→              className={`text-[9px] font-medium ${isRadar ? 'fill-slate-400' : 'fill-stone-500'}`}\n    93→            >\n    94→              {bar.label}\n    95→            </text>\n    96→          </g>\n    97→        );\n    98→      })}\n    99→    </svg>\n   100→  );\n   101→}\n   102→\n   103→interface LineChartProps {\n   104→  data: number[];\n   105→  frame: number;\n   106→  fps: number;\n   107→  width?: number;\n   108→  height?: number;\n   109→  isRadar?: boolean;\n   110→}\n   111→\n   112→export function AnimatedLineChart({ data, frame, fps, width = 240, height = 140, isRadar = true }: LineChartProps) {\n   113→  const max = Math.max(...data, 1);\n   114→  const min = Math.min(...data, 0);\n   115→  const range = max - min || 1;\n   116→  const padding = 12;\n   117→  const chartWidth = width - padding * 2;\n   118→  const chartHeight = height - padding * 2;\n   119→\n   120→  // Pre-calculate all points\n   121→  const points = useMemo(() => {\n   122→    return data.map((v, i) => ({\n   123→      x: padding + (i / Math.max(1, data.length - 1)) * chartWidth,\n   124→      y: padding + chartHeight - ((v - min) / range) * chartHeight,\n   125→    }));\n   126→  }, [data, min, range, chartWidth, chartHeight, padding]);\n   127→\n   128→  const progress = spring({ frame, fps, delay: 0, durationFrames: 45, easing: easeOutCubic });\n   129→  const visibleCount = Math.ceil(points.length * progress);\n   130→  const visiblePoints = points.slice(0, visibleCount);\n   131→\n   132→  // Build path string\n   133→  const pathD = visiblePoints.length > 0\n   134→    ? visiblePoints.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' ')\n   135→    : '';\n   136→\n   137→  const areaD = pathD && visiblePoints.length > 1\n   138→    ? `${pathD} L ${visiblePoints[visiblePoints.length - 1].x.toFixed(1)} ${height - padding} L ${padding} ${height - padding} Z`\n   139→    : '';\n   140→\n   141→  // Gradient IDs\n   142→  const areaGradientId = useMemo(() => `areaGrad-${Math.random().toString(36).substr(2, 9)}`, []);\n   143→  const lineGradientId = useMemo(() => `lineGrad-${Math.random().toString(36).substr(2, 9)}`, []);\n   144→\n   145→  return (\n   146→    <svg width={width} height={height}>\n   147→      <defs>\n   148→        <linearGradient id={areaGradientId} x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n   149→          <stop offset=\"0%\" stopColor={isRadar ? '#22d3ee' : '#3b82f6'} stopOpacity=\"0.3\" />\n   150→          <stop offset=\"100%\" stopColor={isRadar ? '#22d3ee' : '#3b82f6'} stopOpacity=\"0.02\" />\n   151→        </linearGradient>\n   152→        <linearGradient id={lineGradientId} x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n   153→          <stop offset=\"0%\" stopColor={isRadar ? '#22d3ee' : '#3b82f6'} />\n   154→          <stop offset=\"100%\" stopColor={isRadar ? '#06b6d4' : '#2563eb'} />\n   155→        </linearGradient>\n   156→        <filter id=\"lineGlow\">\n   157→          <feGaussianBlur stdDeviation=\"2\" result=\"blur\" />\n   158→          <feMerge>\n   159→            <feMergeNode in=\"blur\" />\n   160→            <feMergeNode in=\"SourceGraphic\" />\n   161→          </feMerge>\n   162→        </filter>\n   163→      </defs>\n   164→\n   165→      {/* Grid lines with fade */}\n   166→      {[0.25, 0.5, 0.75].map((p, i) => (\n   167→        <line\n   168→          key={p}\n   169→          x1={padding}\n   170→          y1={padding + chartHeight * p}\n   171→          x2={width - padding}\n   172→          y2={padding + chartHeight * p}\n   173→          stroke={isRadar ? 'rgba(34,211,238,0.08)' : 'rgba(0,0,0,0.04)'}\n   174→          strokeDasharray=\"4 4\"\n   175→        />\n   176→      ))}\n   177→\n   178→      {/* Area fill with gradient */}\n   179→      {areaD && (\n   180→        <path d={areaD} fill={`url(#${areaGradientId})`} />\n   181→      )}\n   182→\n   183→      {/* Glow line */}\n   184→      {pathD && (\n   185→        <path\n   186→          d={pathD}\n   187→          fill=\"none\"\n   188→          stroke={isRadar ? '#22d3ee' : '#3b82f6'}\n   189→          strokeWidth={4}\n   190→          strokeLinecap=\"round\"\n   191→          strokeLinejoin=\"round\"\n   192→          opacity={0.3}\n   193→          filter=\"url(#lineGlow)\"\n   194→        />\n   195→      )}\n   196→\n   197→      {/* Main line */}\n   198→      {pathD && (\n   199→        <path\n   200→          d={pathD}\n   201→          fill=\"none\"\n   202→          stroke={`url(#${lineGradientId})`}\n   203→          strokeWidth={2.5}\n   204→          strokeLinecap=\"round\"\n   205→          strokeLinejoin=\"round\"\n   206→        />\n   207→      )}\n   208→\n   209→      {/* End point with glow */}\n   210→      {visiblePoints.length > 0 && (\n   211→        <>\n   212→          <circle\n   213→            cx={visiblePoints[visiblePoints.length - 1].x}\n   214→            cy={visiblePoints[visiblePoints.length - 1].y}\n   215→            r={8}\n   216→            fill={isRadar ? '#22d3ee' : '#3b82f6'}\n   217→            opacity={0.2}\n   218→          />\n   219→          <circle\n   220→            cx={visiblePoints[visiblePoints.length - 1].x}\n   221→            cy={visiblePoints[visiblePoints.length - 1].y}\n   222→            r={5}\n   223→            fill={isRadar ? '#0f172a' : '#fff'}\n   224→            stroke={isRadar ? '#22d3ee' : '#3b82f6'}\n   225→            strokeWidth={2.5}\n   226→          />\n   227→        </>\n   228→      )}\n   229→    </svg>\n   230→  );\n   231→}\n   232→\n   233→interface PieChartProps {\n   234→  data: Array<{ label: string; value: number; color: string }>;\n   235→  frame: number;\n   236→  fps: number;\n   237→  size?: number;\n   238→  isRadar?: boolean;\n   239→}\n   240→\n   241→export function AnimatedPieChart({ data, frame, fps, size = 120, isRadar = true }: PieChartProps) {\n   242→  const total = data.reduce((sum, d) => sum + d.value, 0) || 1;\n   243→  const progress = spring({ frame, fps, delay: 0, durationFrames: 40, easing: easeOutQuart });\n   244→\n   245→  const radius = size / 2 - 10;\n   246→  const innerRadius = radius * 0.55; // Donut style\n   247→  const cx = size / 2;\n   248→  const cy = size / 2;\n   249→\n   250→  // Pre-calculate segments\n   251→  const segments = useMemo(() => {\n   252→    let cumulative = 0;\n   253→    return data.map((item) => {\n   254→      const startAngle = cumulative;\n   255→      const angle = (item.value / total) * Math.PI * 2;\n   256→      cumulative += angle;\n   257→      return { ...item, startAngle, angle };\n   258→    });\n   259→  }, [data, total]);\n   260→\n   261→  // Create donut arc path\n   262→  const createArc = (startAngle: number, endAngle: number, outerR: number, innerR: number) => {\n   263→    const x1 = cx + Math.cos(startAngle) * outerR;\n   264→    const y1 = cy + Math.sin(startAngle) * outerR;\n   265→    const x2 = cx + Math.cos(endAngle) * outerR;\n   266→    const y2 = cy + Math.sin(endAngle) * outerR;\n   267→    const x3 = cx + Math.cos(endAngle) * innerR;\n   268→    const y3 = cy + Math.sin(endAngle) * innerR;\n   269→    const x4 = cx + Math.cos(startAngle) * innerR;\n   270→    const y4 = cy + Math.sin(startAngle) * innerR;\n   271→\n   272→    const largeArc = endAngle - startAngle > Math.PI ? 1 : 0;\n   273→\n   274→    return `M ${x1.toFixed(1)} ${y1.toFixed(1)}\n   275→            A ${outerR} ${outerR} 0 ${largeArc} 1 ${x2.toFixed(1)} ${y2.toFixed(1)}\n   276→            L ${x3.toFixed(1)} ${y3.toFixed(1)}\n   277→            A ${innerR} ${innerR} 0 ${largeArc} 0 ${x4.toFixed(1)} ${y4.toFixed(1)} Z`;\n   278→  };\n   279→\n   280→  return (\n   281→    <svg width={size} height={size}>\n   282→      <defs>\n   283→        <filter id=\"pieGlow\">\n   284→          <feGaussianBlur stdDeviation=\"2\" result=\"blur\" />\n   285→          <feMerge>\n   286→            <feMergeNode in=\"blur\" />\n   287→            <feMergeNode in=\"SourceGraphic\" />\n   288→          </feMerge>\n   289→        </filter>\n   290→      </defs>\n   291→\n   292→      {/* Background circle */}\n   293→      <circle\n   294→        cx={cx}\n   295→        cy={cy}\n   296→        r={radius + 2}\n   297→        fill=\"none\"\n   298→        stroke={isRadar ? 'rgba(34,211,238,0.1)' : 'rgba(0,0,0,0.05)'}\n   299→        strokeWidth={1}\n   300→      />\n   301→\n   302→      {segments.map((seg, i) => {\n   303→        const segProgress = spring({ frame, fps, delay: i * 3, durationFrames: 35, easing: easeOutQuart });\n   304→        const animatedAngle = seg.angle * progress * segProgress;\n   305→        const startAngle = seg.startAngle * progress - Math.PI / 2;\n   306→        const endAngle = startAngle + animatedAngle;\n   307→\n   308→        if (animatedAngle < 0.02) return null;\n   309→\n   310→        const d = createArc(startAngle, endAngle, radius, innerRadius);\n   311→\n   312→        return (\n   313→          <g key={i}>\n   314→            {/* Glow */}\n   315→            <path\n   316→              d={d}\n   317→              fill={seg.color}\n   318→              opacity={0.3}\n   319→              filter=\"url(#pieGlow)\"\n   320→            />\n   321→            {/* Segment */}\n   322→            <path\n   323→              d={d}\n   324→              fill={seg.color}\n   325→              stroke={isRadar ? '#0f172a' : '#fff'}\n   326→              strokeWidth={2}\n   327→            />\n   328→          </g>\n   329→        );\n   330→      })}\n   331→\n   332→      {/* Center text */}\n   333→      <text\n   334→        x={cx}\n   335→        y={cy - 4}\n   336→        textAnchor=\"middle\"\n   337→        className={`text-lg font-bold ${isRadar ? 'fill-white' : 'fill-stone-800'}`}\n   338→      >\n   339→        {data.length}\n   340→      </text>\n   341→      <text\n   342→        x={cx}\n   343→        y={cy + 12}\n   344→        textAnchor=\"middle\"\n   345→        className={`text-[8px] ${isRadar ? 'fill-slate-400' : 'fill-stone-500'}`}\n   346→      >\n   347→        Types\n   348→      </text>\n   349→    </svg>\n   350→  );\n   351→}\n   352→\n   353→interface CounterProps {\n   354→  value: number;\n   355→  frame: number;\n   356→  fps: number;\n   357→  delay?: number;\n   358→  suffix?: string;\n   359→  prefix?: string;\n   360→  decimals?: number;\n   361→}\n   362→\n   363→export function AnimatedCounter({ value, frame, fps, delay = 0, suffix = '', prefix = '', decimals = 0 }: CounterProps) {\n   364→  const progress = spring({ frame, fps, delay, durationFrames: 30, easing: easeOutCubic });\n   365→  const current = value * progress;\n   366→\n   367→  return (\n   368→    <span>{prefix}{current.toFixed(decimals)}{suffix}</span>\n   369→  );\n   370→}\n   371→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"86fbfc1a-4772-433d-bdd8-8a7ad125f24a","uuid":"3d4fc4fe-7257-4acb-b206-569cb50a3674","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\video\\AnimatedCharts.tsx","content":"'use client';\n\nimport { useMemo } from 'react';\nimport { spring, easeOutCubic, easeOutQuart } from './useVideoPlayback';\n\ninterface BarChartProps {\n  data: Array<{ label: string; value: number; color?: string }>;\n  frame: number;\n  fps: number;\n  width?: number;\n  height?: number;\n  isRadar?: boolean;\n}\n\nexport function AnimatedBarChart({ data, frame, fps, width = 240, height = 140, isRadar = true }: BarChartProps) {\n  const max = Math.max(...data.map(d => d.value), 1);\n  const barWidth = Math.floor((width - (data.length - 1) * 10) / data.length);\n\n  // Pre-calculate all bar heights to avoid recalculation\n  const bars = useMemo(() => {\n    return data.map((item, i) => {\n      const baseHeight = (item.value / max) * (height - 28);\n      return {\n        ...item,\n        baseHeight,\n        x: i * (barWidth + 10),\n      };\n    });\n  }, [data, max, height, barWidth]);\n\n  // Define gradient\n  const gradientId = useMemo(() => `barGrad-${Math.random().toString(36).substr(2, 9)}`, []);\n\n  return (\n    <svg width={width} height={height} style={{ overflow: 'visible' }}>\n      <defs>\n        <linearGradient id={gradientId} x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n          <stop offset=\"0%\" stopColor={isRadar ? '#22d3ee' : '#3b82f6'} stopOpacity=\"1\" />\n          <stop offset=\"100%\" stopColor={isRadar ? '#0891b2' : '#1d4ed8'} stopOpacity=\"0.8\" />\n        </linearGradient>\n        <filter id=\"barGlow\" x=\"-50%\" y=\"-50%\" width=\"200%\" height=\"200%\">\n          <feGaussianBlur stdDeviation=\"3\" result=\"blur\" />\n          <feMerge>\n            <feMergeNode in=\"blur\" />\n            <feMergeNode in=\"SourceGraphic\" />\n          </feMerge>\n        </filter>\n      </defs>\n      {bars.map((bar, i) => {\n        const progress = spring({ frame, fps, delay: i * 4, durationFrames: 28, easing: easeOutQuart });\n        const barHeight = bar.baseHeight * progress;\n\n        return (\n          <g key={i}>\n            {/* Glow effect */}\n            <rect\n              x={bar.x + 2}\n              y={height - 22 - barHeight}\n              width={barWidth - 4}\n              height={Math.max(0, barHeight)}\n              fill={isRadar ? '#22d3ee' : '#3b82f6'}\n              rx={4}\n              opacity={0.2}\n              filter=\"url(#barGlow)\"\n            />\n            {/* Bar */}\n            <rect\n              x={bar.x}\n              y={height - 22 - barHeight}\n              width={barWidth}\n              height={Math.max(0, barHeight)}\n              fill={`url(#${gradientId})`}\n              rx={4}\n            />\n            {/* Top highlight */}\n            {barHeight > 4 && (\n              <rect\n                x={bar.x + 2}\n                y={height - 22 - barHeight + 2}\n                width={barWidth - 4}\n                height={3}\n                fill=\"white\"\n                rx={2}\n                opacity={0.3}\n              />\n            )}\n            {/* Label */}\n            <text\n              x={bar.x + barWidth / 2}\n              y={height - 6}\n              textAnchor=\"middle\"\n              className={`text-[9px] font-medium ${isRadar ? 'fill-slate-400' : 'fill-stone-500'}`}\n            >\n              {bar.label}\n            </text>\n          </g>\n        );\n      })}\n    </svg>\n  );\n}\n\ninterface LineChartProps {\n  data: number[];\n  frame: number;\n  fps: number;\n  width?: number;\n  height?: number;\n  isRadar?: boolean;\n}\n\nexport function AnimatedLineChart({ data, frame, fps, width = 240, height = 140, isRadar = true }: LineChartProps) {\n  const max = Math.max(...data, 1);\n  const min = Math.min(...data, 0);\n  const range = max - min || 1;\n  const padding = 12;\n  const chartWidth = width - padding * 2;\n  const chartHeight = height - padding * 2;\n\n  // Pre-calculate all points\n  const points = useMemo(() => {\n    return data.map((v, i) => ({\n      x: padding + (i / Math.max(1, data.length - 1)) * chartWidth,\n      y: padding + chartHeight - ((v - min) / range) * chartHeight,\n    }));\n  }, [data, min, range, chartWidth, chartHeight, padding]);\n\n  const progress = spring({ frame, fps, delay: 0, durationFrames: 45, easing: easeOutCubic });\n  const visibleCount = Math.ceil(points.length * progress);\n  const visiblePoints = points.slice(0, visibleCount);\n\n  // Build path string\n  const pathD = visiblePoints.length > 0\n    ? visiblePoints.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' ')\n    : '';\n\n  const areaD = pathD && visiblePoints.length > 1\n    ? `${pathD} L ${visiblePoints[visiblePoints.length - 1].x.toFixed(1)} ${height - padding} L ${padding} ${height - padding} Z`\n    : '';\n\n  // Gradient IDs\n  const areaGradientId = useMemo(() => `areaGrad-${Math.random().toString(36).substr(2, 9)}`, []);\n  const lineGradientId = useMemo(() => `lineGrad-${Math.random().toString(36).substr(2, 9)}`, []);\n\n  return (\n    <svg width={width} height={height}>\n      <defs>\n        <linearGradient id={areaGradientId} x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n          <stop offset=\"0%\" stopColor={isRadar ? '#22d3ee' : '#3b82f6'} stopOpacity=\"0.3\" />\n          <stop offset=\"100%\" stopColor={isRadar ? '#22d3ee' : '#3b82f6'} stopOpacity=\"0.02\" />\n        </linearGradient>\n        <linearGradient id={lineGradientId} x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n          <stop offset=\"0%\" stopColor={isRadar ? '#22d3ee' : '#3b82f6'} />\n          <stop offset=\"100%\" stopColor={isRadar ? '#06b6d4' : '#2563eb'} />\n        </linearGradient>\n        <filter id=\"lineGlow\">\n          <feGaussianBlur stdDeviation=\"2\" result=\"blur\" />\n          <feMerge>\n            <feMergeNode in=\"blur\" />\n            <feMergeNode in=\"SourceGraphic\" />\n          </feMerge>\n        </filter>\n      </defs>\n\n      {/* Grid lines with fade */}\n      {[0.25, 0.5, 0.75].map((p, i) => (\n        <line\n          key={p}\n          x1={padding}\n          y1={padding + chartHeight * p}\n          x2={width - padding}\n          y2={padding + chartHeight * p}\n          stroke={isRadar ? 'rgba(34,211,238,0.08)' : 'rgba(0,0,0,0.04)'}\n          strokeDasharray=\"4 4\"\n        />\n      ))}\n\n      {/* Area fill with gradient */}\n      {areaD && (\n        <path d={areaD} fill={`url(#${areaGradientId})`} />\n      )}\n\n      {/* Glow line */}\n      {pathD && (\n        <path\n          d={pathD}\n          fill=\"none\"\n          stroke={isRadar ? '#22d3ee' : '#3b82f6'}\n          strokeWidth={4}\n          strokeLinecap=\"round\"\n          strokeLinejoin=\"round\"\n          opacity={0.3}\n          filter=\"url(#lineGlow)\"\n        />\n      )}\n\n      {/* Main line */}\n      {pathD && (\n        <path\n          d={pathD}\n          fill=\"none\"\n          stroke={`url(#${lineGradientId})`}\n          strokeWidth={2.5}\n          strokeLinecap=\"round\"\n          strokeLinejoin=\"round\"\n        />\n      )}\n\n      {/* End point with glow */}\n      {visiblePoints.length > 0 && (\n        <>\n          <circle\n            cx={visiblePoints[visiblePoints.length - 1].x}\n            cy={visiblePoints[visiblePoints.length - 1].y}\n            r={8}\n            fill={isRadar ? '#22d3ee' : '#3b82f6'}\n            opacity={0.2}\n          />\n          <circle\n            cx={visiblePoints[visiblePoints.length - 1].x}\n            cy={visiblePoints[visiblePoints.length - 1].y}\n            r={5}\n            fill={isRadar ? '#0f172a' : '#fff'}\n            stroke={isRadar ? '#22d3ee' : '#3b82f6'}\n            strokeWidth={2.5}\n          />\n        </>\n      )}\n    </svg>\n  );\n}\n\ninterface PieChartProps {\n  data: Array<{ label: string; value: number; color: string }>;\n  frame: number;\n  fps: number;\n  size?: number;\n  isRadar?: boolean;\n}\n\nexport function AnimatedPieChart({ data, frame, fps, size = 120, isRadar = true }: PieChartProps) {\n  const total = data.reduce((sum, d) => sum + d.value, 0) || 1;\n  const progress = spring({ frame, fps, delay: 0, durationFrames: 40, easing: easeOutQuart });\n\n  const radius = size / 2 - 10;\n  const innerRadius = radius * 0.55; // Donut style\n  const cx = size / 2;\n  const cy = size / 2;\n\n  // Pre-calculate segments\n  const segments = useMemo(() => {\n    let cumulative = 0;\n    return data.map((item) => {\n      const startAngle = cumulative;\n      const angle = (item.value / total) * Math.PI * 2;\n      cumulative += angle;\n      return { ...item, startAngle, angle };\n    });\n  }, [data, total]);\n\n  // Create donut arc path\n  const createArc = (startAngle: number, endAngle: number, outerR: number, innerR: number) => {\n    const x1 = cx + Math.cos(startAngle) * outerR;\n    const y1 = cy + Math.sin(startAngle) * outerR;\n    const x2 = cx + Math.cos(endAngle) * outerR;\n    const y2 = cy + Math.sin(endAngle) * outerR;\n    const x3 = cx + Math.cos(endAngle) * innerR;\n    const y3 = cy + Math.sin(endAngle) * innerR;\n    const x4 = cx + Math.cos(startAngle) * innerR;\n    const y4 = cy + Math.sin(startAngle) * innerR;\n\n    const largeArc = endAngle - startAngle > Math.PI ? 1 : 0;\n\n    return `M ${x1.toFixed(1)} ${y1.toFixed(1)}\n            A ${outerR} ${outerR} 0 ${largeArc} 1 ${x2.toFixed(1)} ${y2.toFixed(1)}\n            L ${x3.toFixed(1)} ${y3.toFixed(1)}\n            A ${innerR} ${innerR} 0 ${largeArc} 0 ${x4.toFixed(1)} ${y4.toFixed(1)} Z`;\n  };\n\n  return (\n    <svg width={size} height={size}>\n      <defs>\n        <filter id=\"pieGlow\">\n          <feGaussianBlur stdDeviation=\"2\" result=\"blur\" />\n          <feMerge>\n            <feMergeNode in=\"blur\" />\n            <feMergeNode in=\"SourceGraphic\" />\n          </feMerge>\n        </filter>\n      </defs>\n\n      {/* Background circle */}\n      <circle\n        cx={cx}\n        cy={cy}\n        r={radius + 2}\n        fill=\"none\"\n        stroke={isRadar ? 'rgba(34,211,238,0.1)' : 'rgba(0,0,0,0.05)'}\n        strokeWidth={1}\n      />\n\n      {segments.map((seg, i) => {\n        const segProgress = spring({ frame, fps, delay: i * 3, durationFrames: 35, easing: easeOutQuart });\n        const animatedAngle = seg.angle * progress * segProgress;\n        const startAngle = seg.startAngle * progress - Math.PI / 2;\n        const endAngle = startAngle + animatedAngle;\n\n        if (animatedAngle < 0.02) return null;\n\n        const d = createArc(startAngle, endAngle, radius, innerRadius);\n\n        return (\n          <g key={i}>\n            {/* Glow */}\n            <path\n              d={d}\n              fill={seg.color}\n              opacity={0.3}\n              filter=\"url(#pieGlow)\"\n            />\n            {/* Segment */}\n            <path\n              d={d}\n              fill={seg.color}\n              stroke={isRadar ? '#0f172a' : '#fff'}\n              strokeWidth={2}\n            />\n          </g>\n        );\n      })}\n\n      {/* Center text */}\n      <text\n        x={cx}\n        y={cy - 4}\n        textAnchor=\"middle\"\n        className={`text-lg font-bold ${isRadar ? 'fill-white' : 'fill-stone-800'}`}\n      >\n        {data.length}\n      </text>\n      <text\n        x={cx}\n        y={cy + 12}\n        textAnchor=\"middle\"\n        className={`text-[8px] ${isRadar ? 'fill-slate-400' : 'fill-stone-500'}`}\n      >\n        Types\n      </text>\n    </svg>\n  );\n}\n\ninterface CounterProps {\n  value: number;\n  frame: number;\n  fps: number;\n  delay?: number;\n  suffix?: string;\n  prefix?: string;\n  decimals?: number;\n}\n\nexport function AnimatedCounter({ value, frame, fps, delay = 0, suffix = '', prefix = '', decimals = 0 }: CounterProps) {\n  const progress = spring({ frame, fps, delay, durationFrames: 30, easing: easeOutCubic });\n  const current = value * progress;\n\n  return (\n    <span>{prefix}{current.toFixed(decimals)}{suffix}</span>\n  );\n}\n","numLines":371,"startLine":1,"totalLines":371}}}
