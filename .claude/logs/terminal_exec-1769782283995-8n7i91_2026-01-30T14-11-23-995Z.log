[2026-01-30T14:11:40.771Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YWHgD14WwERjTCfKLCG5X9","type":"tool_result","content":"     1→'use client';\n     2→\n     3→import { useRef, useEffect, useState, useCallback } from 'react';\n     4→import type { ResearchSession } from '@/src/types/research';\n     5→import {\n     6→  useAppStore,\n     7→  getTemplateColor,\n     8→  getTemplateDisplayName,\n     9→  groupSessionsByTemplate,\n    10→  getTopicsForTemplate,\n    11→  type TopicWithSessions,\n    12→} from '@/src/stores/appStore';\n    13→\n    14→interface RadarViewProps {\n    15→  sessions: ResearchSession[];\n    16→  onSessionSelect?: (session: ResearchSession) => void;\n    17→}\n    18→\n    19→interface Node {\n    20→  id: string;\n    21→  x: number;\n    22→  y: number;\n    23→  radius: number;\n    24→  color: string;\n    25→  label: string;\n    26→  sessions: ResearchSession[];\n    27→  template: string;\n    28→  pulsePhase: number;\n    29→  type: 'template' | 'topic';\n    30→  parentTemplate?: string;\n    31→  topic?: TopicWithSessions;\n    32→  orbitRadius?: number;\n    33→  orbitAngle?: number;\n    34→}\n    35→\n    36→interface ViewState {\n    37→  offsetX: number;\n    38→  offsetY: number;\n    39→  scale: number;\n    40→}\n    41→\n    42→export function RadarView({ sessions, onSessionSelect }: RadarViewProps) {\n    43→  const canvasRef = useRef<HTMLCanvasElement>(null);\n    44→  const containerRef = useRef<HTMLDivElement>(null);\n    45→  const animationRef = useRef<number | null>(null);\n    46→  const nodesRef = useRef<Node[]>([]);\n    47→  const [hoveredNode, setHoveredNode] = useState<Node | null>(null);\n    48→  const [mousePos, setMousePos] = useState({ x: 0, y: 0 });\n    49→  const [focusedTemplate, setFocusedTemplate] = useState<string | null>(null);\n    50→  const [focusedTopic, setFocusedTopic] = useState<TopicWithSessions | null>(null);\n    51→  const { topics, fetchTopics } = useAppStore();\n    52→\n    53→  // Fetch topics on mount\n    54→  useEffect(() => {\n    55→    fetchTopics();\n    56→  }, [fetchTopics]);\n    57→\n    58→  const [view, setView] = useState<ViewState>({\n    59→    offsetX: 0,\n    60→    offsetY: 0,\n    61→    scale: 1,\n    62→  });\n    63→\n    64→  const isDragging = useRef(false);\n    65→  const lastMouse = useRef({ x: 0, y: 0 });\n    66→\n    67→  // Generate nodes from sessions grouped by template, with topic subnodes\n    68→  useEffect(() => {\n    69→    const grouped = groupSessionsByTemplate(sessions);\n    70→    const templates = Object.keys(grouped);\n    71→    const nodes: Node[] = [];\n    72→\n    73→    // Arrange template clusters in a circle\n    74→    const clusterRadius = focusedTemplate ? 100 : 300;\n    75→    templates.forEach((template, i) => {\n    76→      const isFocused = focusedTemplate === template;\n    77→      const angle = (i / templates.length) * Math.PI * 2 - Math.PI / 2;\n    78→      const cx = isFocused ? 0 : Math.cos(angle) * clusterRadius;\n    79→      const cy = isFocused ? 0 : Math.sin(angle) * clusterRadius;\n    80→\n    81→      const templateSessions = grouped[template];\n    82→      const radius = isFocused ? 60 : Math.max(40, Math.min(80, 20 + templateSessions.length * 8));\n    83→\n    84→      nodes.push({\n    85→        id: template,\n    86→        x: cx,\n    87→        y: cy,\n    88→        radius,\n    89→        color: getTemplateColor(template),\n    90→        label: getTemplateDisplayName(template),\n    91→        sessions: templateSessions,\n    92→        template,\n    93→        pulsePhase: Math.random() * Math.PI * 2,\n    94→        type: 'template',\n    95→      });\n    96→\n    97→      // Add topic nodes if this template is focused\n    98→      if (isFocused) {\n    99→        const templateTopics = getTopicsForTemplate(template, topics);\n   100→        const orbitRadius = 180;\n   101→\n   102→        templateTopics.forEach((topic, tidx) => {\n   103→          const topicAngle = (tidx / templateTopics.length) * Math.PI * 2 - Math.PI / 2;\n   104→          const topicSessions = topic.sessions?.filter(s => s.template_type === template) || [];\n   105→          const topicRadius = Math.max(20, Math.min(40, 15 + topicSessions.length * 4));\n   106→\n   107→          nodes.push({\n   108→            id: `topic-${topic.id}`,\n   109→            x: cx + Math.cos(topicAngle) * orbitRadius,\n   110→            y: cy + Math.sin(topicAngle) * orbitRadius,\n   111→            radius: topicRadius,\n   112→            color: getTemplateColor(template),\n   113→            label: topic.name,\n   114→            sessions: sessions.filter(s => topicSessions.some(ts => ts.id === s.id)),\n   115→            template,\n   116→            pulsePhase: Math.random() * Math.PI * 2,\n   117→            type: 'topic',\n   118→            parentTemplate: template,\n   119→            topic,\n   120→            orbitRadius,\n   121→            orbitAngle: topicAngle,\n   122→          });\n   123→        });\n   124→      }\n   125→    });\n   126→\n   127→    nodesRef.current = nodes;\n   128→  }, [sessions, topics, focusedTemplate]);\n   129→\n   130→  // Canvas rendering with animation\n   131→  useEffect(() => {\n   132→    const canvas = canvasRef.current;\n   133→    const container = containerRef.current;\n   134→    if (!canvas || !container) return;\n   135→\n   136→    const ctx = canvas.getContext('2d');\n   137→    if (!ctx) return;\n   138→\n   139→    let time = 0;\n   140→\n   141→    const render = () => {\n   142→      const rect = container.getBoundingClientRect();\n   143→      canvas.width = rect.width * window.devicePixelRatio;\n   144→      canvas.height = rect.height * window.devicePixelRatio;\n   145→      ctx.scale(window.devicePixelRatio, window.devicePixelRatio);\n   146→\n   147→      const width = rect.width;\n   148→      const height = rect.height;\n   149→\n   150→      // Clear with dark background\n   151→      ctx.fillStyle = '#0A0A0B';\n   152→      ctx.fillRect(0, 0, width, height);\n   153→\n   154→      // Draw radar sweep effect\n   155→      const sweepAngle = (time * 0.5) % (Math.PI * 2);\n   156→      const centerX = width / 2 + view.offsetX;\n   157→      const centerY = height / 2 + view.offsetY;\n   158→\n   159→      // Subtle grid\n   160→      ctx.strokeStyle = 'rgba(34, 211, 238, 0.03)';\n   161→      ctx.lineWidth = 1;\n   162→      const gridSize = 100 * view.scale;\n   163→      const startX = (view.offsetX % gridSize) - gridSize;\n   164→      const startY = (view.offsetY % gridSize) - gridSize;\n   165→\n   166→      for (let x = startX; x < width + gridSize; x += gridSize) {\n   167→        ctx.beginPath();\n   168→        ctx.moveTo(x, 0);\n   169→        ctx.lineTo(x, height);\n   170→        ctx.stroke();\n   171→      }\n   172→      for (let y = startY; y < height + gridSize; y += gridSize) {\n   173→        ctx.beginPath();\n   174→        ctx.moveTo(0, y);\n   175→        ctx.lineTo(width, y);\n   176→        ctx.stroke();\n   177→      }\n   178→\n   179→      // Draw radar circles\n   180→      ctx.strokeStyle = 'rgba(34, 211, 238, 0.08)';\n   181→      for (let r = 100; r < 800; r += 150) {\n   182→        ctx.beginPath();\n   183→        ctx.arc(centerX, centerY, r * view.scale, 0, Math.PI * 2);\n   184→        ctx.stroke();\n   185→      }\n   186→\n   187→      // Draw sweep (using radial gradient as fallback since conic gradient has limited support)\n   188→      const sweepX = centerX + Math.cos(sweepAngle) * 300 * view.scale;\n   189→      const sweepY = centerY + Math.sin(sweepAngle) * 300 * view.scale;\n   190→      const sweepGradient = ctx.createRadialGradient(\n   191→        sweepX, sweepY, 0,\n   192→        sweepX, sweepY, 400 * view.scale\n   193→      );\n   194→      sweepGradient.addColorStop(0, 'rgba(34, 211, 238, 0.2)');\n   195→      sweepGradient.addColorStop(0.5, 'rgba(34, 211, 238, 0.05)');\n   196→      sweepGradient.addColorStop(1, 'rgba(34, 211, 238, 0)');\n   197→\n   198→      ctx.fillStyle = sweepGradient;\n   199→      ctx.beginPath();\n   200→      ctx.arc(centerX, centerY, 600 * view.scale, 0, Math.PI * 2);\n   201→      ctx.fill();\n   202→\n   203→      // Draw connections between template nodes only\n   204→      const nodes = nodesRef.current;\n   205→      const templateNodes = nodes.filter(n => n.type === 'template');\n   206→      const topicNodes = nodes.filter(n => n.type === 'topic');\n   207→\n   208→      ctx.strokeStyle = 'rgba(34, 211, 238, 0.1)';\n   209→      ctx.lineWidth = 1;\n   210→\n   211→      for (let i = 0; i < templateNodes.length; i++) {\n   212→        for (let j = i + 1; j < templateNodes.length; j++) {\n   213→          const n1 = templateNodes[i];\n   214→          const n2 = templateNodes[j];\n   215→          // Dim connections when focused\n   216→          const opacity = focusedTemplate ? 0.03 : 0.1;\n   217→          ctx.strokeStyle = `rgba(34, 211, 238, ${opacity})`;\n   218→\n   219→          const x1 = centerX + n1.x * view.scale;\n   220→          const y1 = centerY + n1.y * view.scale;\n   221→          const x2 = centerX + n2.x * view.scale;\n   222→          const y2 = centerY + n2.y * view.scale;\n   223→\n   224→          ctx.beginPath();\n   225→          ctx.moveTo(x1, y1);\n   226→          ctx.lineTo(x2, y2);\n   227→          ctx.stroke();\n   228→        }\n   229→      }\n   230→\n   231→      // Draw orbit ring for focused template\n   232→      if (focusedTemplate) {\n   233→        const focusedNode = templateNodes.find(n => n.template === focusedTemplate);\n   234→        if (focusedNode) {\n   235→          const fx = centerX + focusedNode.x * view.scale;\n   236→          const fy = centerY + focusedNode.y * view.scale;\n   237→          const orbitR = 180 * view.scale;\n   238→\n   239→          // Draw orbit ring\n   240→          ctx.strokeStyle = focusedNode.color + '30';\n   241→          ctx.lineWidth = 2;\n   242→          ctx.setLineDash([5, 10]);\n   243→          ctx.beginPath();\n   244→          ctx.arc(fx, fy, orbitR, 0, Math.PI * 2);\n   245→          ctx.stroke();\n   246→          ctx.setLineDash([]);\n   247→\n   248→          // Draw connections from center to topics\n   249→          topicNodes.forEach(topic => {\n   250→            const tx = centerX + topic.x * view.scale;\n   251→            const ty = centerY + topic.y * view.scale;\n   252→\n   253→            ctx.strokeStyle = topic.color + '40';\n   254→            ctx.lineWidth = 1;\n   255→            ctx.beginPath();\n   256→            ctx.moveTo(fx, fy);\n   257→            ctx.lineTo(tx, ty);\n   258→            ctx.stroke();\n   259→          });\n   260→        }\n   261→      }\n   262→\n   263→      // Draw nodes (templates first, then topics on top)\n   264→      [...templateNodes, ...topicNodes].forEach((node) => {\n   265→        const x = centerX + node.x * view.scale;\n   266→        const y = centerY + node.y * view.scale;\n   267→        const pulse = Math.sin(time * 2 + node.pulsePhase) * 0.15 + 1;\n   268→        const r = node.radius * view.scale * pulse;\n   269→\n   270→        // Determine opacity based on focus state\n   271→        const isFocused = !focusedTemplate || node.template === focusedTemplate;\n   272→        const opacity = isFocused ? 1 : 0.2;\n   273→\n   274→        // Outer glow\n   275→        const glowGradient = ctx.createRadialGradient(x, y, r * 0.5, x, y, r * 2);\n   276→        glowGradient.addColorStop(0, node.color + (isFocused ? '40' : '10'));\n   277→        glowGradient.addColorStop(0.5, node.color + (isFocused ? '15' : '05'));\n   278→        glowGradient.addColorStop(1, 'transparent');\n   279→\n   280→        ctx.fillStyle = glowGradient;\n   281→        ctx.beginPath();\n   282→        ctx.arc(x, y, r * 2, 0, Math.PI * 2);\n   283→        ctx.fill();\n   284→\n   285→        // Inner circle\n   286→        const innerGradient = ctx.createRadialGradient(x, y, 0, x, y, r);\n   287→        innerGradient.addColorStop(0, node.color + (isFocused ? 'CC' : '44'));\n   288→        innerGradient.addColorStop(0.7, node.color + (isFocused ? '88' : '22'));\n   289→        innerGradient.addColorStop(1, node.color + (isFocused ? '44' : '11'));\n   290→\n   291→        ctx.fillStyle = innerGradient;\n   292→        ctx.beginPath();\n   293→        ctx.arc(x, y, r, 0, Math.PI * 2);\n   294→        ctx.fill();\n   295→\n   296→        // Border\n   297→        ctx.strokeStyle = node.color + (isFocused ? 'FF' : '44');\n   298→        ctx.lineWidth = node.type === 'topic' ? 1.5 : 2;\n   299→        ctx.beginPath();\n   300→        ctx.arc(x, y, r, 0, Math.PI * 2);\n   301→        ctx.stroke();\n   302→\n   303→        // Label (only if focused or no focus)\n   304→        if (isFocused) {\n   305→          ctx.fillStyle = '#E8E8E8';\n   306→          ctx.font = `${Math.max(10, (node.type === 'topic' ? 12 : 14) * view.scale)}px Inter, system-ui, sans-serif`;\n   307→          ctx.textAlign = 'center';\n   308→          ctx.textBaseline = 'middle';\n   309→          ctx.fillText(node.label, x, y - r - 15 * view.scale);\n   310→\n   311→          // Count\n   312→          ctx.fillStyle = '#A1A1AA';\n   313→          ctx.font = `${Math.max(9, (node.type === 'topic' ? 10 : 12) * view.scale)}px Inter, system-ui, sans-serif`;\n   314→          ctx.fillText(`${node.sessions.length}`, x, y + r + 12 * view.scale);\n   315→        }\n   316→      });\n   317→\n   318→      time += 0.016;\n   319→      animationRef.current = requestAnimationFrame(render);\n   320→    };\n   321→\n   322→    render();\n   323→\n   324→    return () => {\n   325→      if (animationRef.current) {\n   326→        cancelAnimationFrame(animationRef.current);\n   327→      }\n   328→    };\n   329→  }, [view, sessions, focusedTemplate, topics]);\n   330→\n   331→  // Mouse handlers for pan/zoom\n   332→  const handleMouseDown = useCallback((e: React.MouseEvent) => {\n   333→    isDragging.current = true;\n   334→    lastMouse.current = { x: e.clientX, y: e.clientY };\n   335→  }, []);\n   336→\n   337→  const handleMouseMove = useCallback((e: React.MouseEvent) => {\n   338→    const rect = containerRef.current?.getBoundingClientRect();\n   339→    if (!rect) return;\n   340→\n   341→    setMousePos({ x: e.clientX - rect.left, y: e.clientY - rect.top });\n   342→\n   343→    if (isDragging.current) {\n   344→      const dx = e.clientX - lastMouse.current.x;\n   345→      const dy = e.clientY - lastMouse.current.y;\n   346→      setView(v => ({\n   347→        ...v,\n   348→        offsetX: v.offsetX + dx,\n   349→        offsetY: v.offsetY + dy,\n   350→      }));\n   351→      lastMouse.current = { x: e.clientX, y: e.clientY };\n   352→    }\n   353→\n   354→    // Check hover\n   355→    const nodes = nodesRef.current;\n   356→    const centerX = rect.width / 2 + view.offsetX;\n   357→    const centerY = rect.height / 2 + view.offsetY;\n   358→    const mx = e.clientX - rect.left;\n   359→    const my = e.clientY - rect.top;\n   360→\n   361→    let found: Node | null = null;\n   362→    for (const node of nodes) {\n   363→      const x = centerX + node.x * view.scale;\n   364→      const y = centerY + node.y * view.scale;\n   365→      const dist = Math.sqrt((mx - x) ** 2 + (my - y) ** 2);\n   366→      if (dist < node.radius * view.scale * 1.5) {\n   367→        found = node;\n   368→        break;\n   369→      }\n   370→    }\n   371→    setHoveredNode(found);\n   372→  }, [view]);\n   373→\n   374→  const handleMouseUp = useCallback(() => {\n   375→    isDragging.current = false;\n   376→  }, []);\n   377→\n   378→  const handleWheel = useCallback((e: React.WheelEvent) => {\n   379→    e.preventDefault();\n   380→    const delta = e.deltaY > 0 ? 0.9 : 1.1;\n   381→    setView(v => ({\n   382→      ...v,\n   383→      scale: Math.max(0.3, Math.min(3, v.scale * delta)),\n   384→    }));\n   385→  }, []);\n   386→\n   387→  const handleClick = useCallback(() => {\n   388→    if (!hoveredNode) {\n   389→      // Click on empty space - unfocus\n   390→      if (focusedTemplate) {\n   391→        setFocusedTemplate(null);\n   392→        setFocusedTopic(null);\n   393→      }\n   394→      return;\n   395→    }\n   396→\n   397→    if (hoveredNode.type === 'template') {\n   398→      if (focusedTemplate === hoveredNode.template) {\n   399→        // Already focused, unfocus\n   400→        setFocusedTemplate(null);\n   401→        setFocusedTopic(null);\n   402→      } else {\n   403→        // Focus on this template\n   404→        setFocusedTemplate(hoveredNode.template);\n   405→        setFocusedTopic(null);\n   406→      }\n   407→    } else if (hoveredNode.type === 'topic') {\n   408→      if (hoveredNode.sessions.length === 1 && onSessionSelect) {\n   409→        // Single session - select it directly\n   410→        onSessionSelect(hoveredNode.sessions[0]);\n   411→      } else if (hoveredNode.topic) {\n   412→        // Show topic sessions in panel\n   413→        setFocusedTopic(hoveredNode.topic);\n   414→      }\n   415→    }\n   416→  }, [hoveredNode, onSessionSelect, focusedTemplate]);\n   417→\n   418→  return (\n   419→    <div\n   420→      ref={containerRef}\n   421→      className=\"relative w-full h-full overflow-hidden cursor-grab active:cursor-grabbing\"\n   422→      onMouseDown={handleMouseDown}\n   423→      onMouseMove={handleMouseMove}\n   424→      onMouseUp={handleMouseUp}\n   425→      onMouseLeave={handleMouseUp}\n   426→      onWheel={handleWheel}\n   427→      onClick={handleClick}\n   428→    >\n   429→      <canvas ref={canvasRef} className=\"w-full h-full\" />\n   430→\n   431→      {/* Tooltip */}\n   432→      {hoveredNode && (\n   433→        <div\n   434→          className=\"absolute pointer-events-none z-10 bg-[#1A1A1E] border border-[#22D3EE]/30 rounded-lg p-3 shadow-lg shadow-[#22D3EE]/10\"\n   435→          style={{\n   436→            left: mousePos.x + 15,\n   437→            top: mousePos.y + 15,\n   438→            maxWidth: 280,\n   439→          }}\n   440→        >\n   441→          <div className=\"flex items-center gap-2 mb-2\">\n   442→            <div\n   443→              className=\"w-3 h-3 rounded-full\"\n   444→              style={{ backgroundColor: hoveredNode.color, boxShadow: `0 0 8px ${hoveredNode.color}` }}\n   445→            />\n   446→            <span className=\"text-[#E8E8E8] font-medium\">{hoveredNode.label}</span>\n   447→            <span className=\"text-[#71717A] text-xs uppercase\">\n   448→              {hoveredNode.type}\n   449→            </span>\n   450→          </div>\n   451→          <div className=\"text-[#A1A1AA] text-sm\">\n   452→            {hoveredNode.sessions.length} research sessions\n   453→          </div>\n   454→          <div className=\"mt-2 text-xs text-[#71717A]\">\n   455→            {hoveredNode.sessions.slice(0, 3).map(s => (\n   456→              <div key={s.id} className=\"truncate\">{s.title}</div>\n   457→            ))}\n   458→            {hoveredNode.sessions.length > 3 && (\n   459→              <div>+{hoveredNode.sessions.length - 3} more...</div>\n   460→            )}\n   461→          </div>\n   462→          <div className=\"mt-2 text-xs text-[#22D3EE]\">\n   463→            {hoveredNode.type === 'template'\n   464→              ? focusedTemplate === hoveredNode.template\n   465→                ? 'Click to unfocus'\n   466→                : 'Click to see topics'\n   467→              : hoveredNode.sessions.length === 1\n   468→                ? 'Click to open report'\n   469→                : 'Click to see sessions'}\n   470→          </div>\n   471→        </div>\n   472→      )}\n   473→\n   474→      {/* Focused topic sessions panel */}\n   475→      {focusedTopic && (\n   476→        <div className=\"absolute top-4 left-4 bg-[#1A1A1E]/95 backdrop-blur-sm border border-[#22D3EE]/30 rounded-lg p-4 max-w-xs shadow-lg\">\n   477→          <div className=\"flex items-center justify-between mb-3\">\n   478→            <h3 className=\"text-[#E8E8E8] font-medium\">{focusedTopic.name}</h3>\n   479→            <button\n   480→              onClick={(e) => {\n   481→                e.stopPropagation();\n   482→                setFocusedTopic(null);\n   483→              }}\n   484→              className=\"text-[#71717A] hover:text-[#22D3EE] text-xs\"\n   485→            >\n   486→              Close\n   487→            </button>\n   488→          </div>\n   489→          {focusedTopic.description && (\n   490→            <p className=\"text-xs text-[#A1A1AA] mb-3\">{focusedTopic.description}</p>\n   491→          )}\n   492→          <div className=\"space-y-1 max-h-48 overflow-auto\">\n   493→            {sessions\n   494→              .filter(s => focusedTopic.sessions?.some(ts => ts.id === s.id))\n   495→              .map(s => (\n   496→                <button\n   497→                  key={s.id}\n   498→                  onClick={(e) => {\n   499→                    e.stopPropagation();\n   500→                    onSessionSelect?.(s);\n   501→                  }}\n   502→                  className=\"w-full text-left text-sm text-[#A1A1AA] hover:text-[#22D3EE] truncate transition-colors\"\n   503→                >\n   504→                  {s.title}\n   505→                </button>\n   506→              ))}\n   507→          </div>\n   508→        </div>\n   509→      )}\n   510→\n   511→      {/* Controls hint */}\n   512→      <div className=\"absolute bottom-4 left-4 text-[#71717A] text-xs\">\n   513→        Drag to pan • Scroll to zoom • Click nodes to {focusedTemplate ? 'drill down' : 'focus'}\n   514→      </div>\n   515→\n   516→      {/* Zoom indicator */}\n   517→      <div className=\"absolute bottom-4 right-4 text-[#71717A] text-xs font-mono\">\n   518→        {Math.round(view.scale * 100)}%\n   519→      </div>\n   520→    </div>\n   521→  );\n   522→}\n   523→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"86fbfc1a-4772-433d-bdd8-8a7ad125f24a","uuid":"ed936e7e-98c2-4df6-8f04-c9e7950a1448","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\visualizations\\RadarView.tsx","content":"'use client';\n\nimport { useRef, useEffect, useState, useCallback } from 'react';\nimport type { ResearchSession } from '@/src/types/research';\nimport {\n  useAppStore,\n  getTemplateColor,\n  getTemplateDisplayName,\n  groupSessionsByTemplate,\n  getTopicsForTemplate,\n  type TopicWithSessions,\n} from '@/src/stores/appStore';\n\ninterface RadarViewProps {\n  sessions: ResearchSession[];\n  onSessionSelect?: (session: ResearchSession) => void;\n}\n\ninterface Node {\n  id: string;\n  x: number;\n  y: number;\n  radius: number;\n  color: string;\n  label: string;\n  sessions: ResearchSession[];\n  template: string;\n  pulsePhase: number;\n  type: 'template' | 'topic';\n  parentTemplate?: string;\n  topic?: TopicWithSessions;\n  orbitRadius?: number;\n  orbitAngle?: number;\n}\n\ninterface ViewState {\n  offsetX: number;\n  offsetY: number;\n  scale: number;\n}\n\nexport function RadarView({ sessions, onSessionSelect }: RadarViewProps) {\n  const canvasRef = useRef<HTMLCanvasElement>(null);\n  const containerRef = useRef<HTMLDivElement>(null);\n  const animationRef = useRef<number | null>(null);\n  const nodesRef = useRef<Node[]>([]);\n  const [hoveredNode, setHoveredNode] = useState<Node | null>(null);\n  const [mousePos, setMousePos] = useState({ x: 0, y: 0 });\n  const [focusedTemplate, setFocusedTemplate] = useState<string | null>(null);\n  const [focusedTopic, setFocusedTopic] = useState<TopicWithSessions | null>(null);\n  const { topics, fetchTopics } = useAppStore();\n\n  // Fetch topics on mount\n  useEffect(() => {\n    fetchTopics();\n  }, [fetchTopics]);\n\n  const [view, setView] = useState<ViewState>({\n    offsetX: 0,\n    offsetY: 0,\n    scale: 1,\n  });\n\n  const isDragging = useRef(false);\n  const lastMouse = useRef({ x: 0, y: 0 });\n\n  // Generate nodes from sessions grouped by template, with topic subnodes\n  useEffect(() => {\n    const grouped = groupSessionsByTemplate(sessions);\n    const templates = Object.keys(grouped);\n    const nodes: Node[] = [];\n\n    // Arrange template clusters in a circle\n    const clusterRadius = focusedTemplate ? 100 : 300;\n    templates.forEach((template, i) => {\n      const isFocused = focusedTemplate === template;\n      const angle = (i / templates.length) * Math.PI * 2 - Math.PI / 2;\n      const cx = isFocused ? 0 : Math.cos(angle) * clusterRadius;\n      const cy = isFocused ? 0 : Math.sin(angle) * clusterRadius;\n\n      const templateSessions = grouped[template];\n      const radius = isFocused ? 60 : Math.max(40, Math.min(80, 20 + templateSessions.length * 8));\n\n      nodes.push({\n        id: template,\n        x: cx,\n        y: cy,\n        radius,\n        color: getTemplateColor(template),\n        label: getTemplateDisplayName(template),\n        sessions: templateSessions,\n        template,\n        pulsePhase: Math.random() * Math.PI * 2,\n        type: 'template',\n      });\n\n      // Add topic nodes if this template is focused\n      if (isFocused) {\n        const templateTopics = getTopicsForTemplate(template, topics);\n        const orbitRadius = 180;\n\n        templateTopics.forEach((topic, tidx) => {\n          const topicAngle = (tidx / templateTopics.length) * Math.PI * 2 - Math.PI / 2;\n          const topicSessions = topic.sessions?.filter(s => s.template_type === template) || [];\n          const topicRadius = Math.max(20, Math.min(40, 15 + topicSessions.length * 4));\n\n          nodes.push({\n            id: `topic-${topic.id}`,\n            x: cx + Math.cos(topicAngle) * orbitRadius,\n            y: cy + Math.sin(topicAngle) * orbitRadius,\n            radius: topicRadius,\n            color: getTemplateColor(template),\n            label: topic.name,\n            sessions: sessions.filter(s => topicSessions.some(ts => ts.id === s.id)),\n            template,\n            pulsePhase: Math.random() * Math.PI * 2,\n            type: 'topic',\n            parentTemplate: template,\n            topic,\n            orbitRadius,\n            orbitAngle: topicAngle,\n          });\n        });\n      }\n    });\n\n    nodesRef.current = nodes;\n  }, [sessions, topics, focusedTemplate]);\n\n  // Canvas rendering with animation\n  useEffect(() => {\n    const canvas = canvasRef.current;\n    const container = containerRef.current;\n    if (!canvas || !container) return;\n\n    const ctx = canvas.getContext('2d');\n    if (!ctx) return;\n\n    let time = 0;\n\n    const render = () => {\n      const rect = container.getBoundingClientRect();\n      canvas.width = rect.width * window.devicePixelRatio;\n      canvas.height = rect.height * window.devicePixelRatio;\n      ctx.scale(window.devicePixelRatio, window.devicePixelRatio);\n\n      const width = rect.width;\n      const height = rect.height;\n\n      // Clear with dark background\n      ctx.fillStyle = '#0A0A0B';\n      ctx.fillRect(0, 0, width, height);\n\n      // Draw radar sweep effect\n      const sweepAngle = (time * 0.5) % (Math.PI * 2);\n      const centerX = width / 2 + view.offsetX;\n      const centerY = height / 2 + view.offsetY;\n\n      // Subtle grid\n      ctx.strokeStyle = 'rgba(34, 211, 238, 0.03)';\n      ctx.lineWidth = 1;\n      const gridSize = 100 * view.scale;\n      const startX = (view.offsetX % gridSize) - gridSize;\n      const startY = (view.offsetY % gridSize) - gridSize;\n\n      for (let x = startX; x < width + gridSize; x += gridSize) {\n        ctx.beginPath();\n        ctx.moveTo(x, 0);\n        ctx.lineTo(x, height);\n        ctx.stroke();\n      }\n      for (let y = startY; y < height + gridSize; y += gridSize) {\n        ctx.beginPath();\n        ctx.moveTo(0, y);\n        ctx.lineTo(width, y);\n        ctx.stroke();\n      }\n\n      // Draw radar circles\n      ctx.strokeStyle = 'rgba(34, 211, 238, 0.08)';\n      for (let r = 100; r < 800; r += 150) {\n        ctx.beginPath();\n        ctx.arc(centerX, centerY, r * view.scale, 0, Math.PI * 2);\n        ctx.stroke();\n      }\n\n      // Draw sweep (using radial gradient as fallback since conic gradient has limited support)\n      const sweepX = centerX + Math.cos(sweepAngle) * 300 * view.scale;\n      const sweepY = centerY + Math.sin(sweepAngle) * 300 * view.scale;\n      const sweepGradient = ctx.createRadialGradient(\n        sweepX, sweepY, 0,\n        sweepX, sweepY, 400 * view.scale\n      );\n      sweepGradient.addColorStop(0, 'rgba(34, 211, 238, 0.2)');\n      sweepGradient.addColorStop(0.5, 'rgba(34, 211, 238, 0.05)');\n      sweepGradient.addColorStop(1, 'rgba(34, 211, 238, 0)');\n\n      ctx.fillStyle = sweepGradient;\n      ctx.beginPath();\n      ctx.arc(centerX, centerY, 600 * view.scale, 0, Math.PI * 2);\n      ctx.fill();\n\n      // Draw connections between template nodes only\n      const nodes = nodesRef.current;\n      const templateNodes = nodes.filter(n => n.type === 'template');\n      const topicNodes = nodes.filter(n => n.type === 'topic');\n\n      ctx.strokeStyle = 'rgba(34, 211, 238, 0.1)';\n      ctx.lineWidth = 1;\n\n      for (let i = 0; i < templateNodes.length; i++) {\n        for (let j = i + 1; j < templateNodes.length; j++) {\n          const n1 = templateNodes[i];\n          const n2 = templateNodes[j];\n          // Dim connections when focused\n          const opacity = focusedTemplate ? 0.03 : 0.1;\n          ctx.strokeStyle = `rgba(34, 211, 238, ${opacity})`;\n\n          const x1 = centerX + n1.x * view.scale;\n          const y1 = centerY + n1.y * view.scale;\n          const x2 = centerX + n2.x * view.scale;\n          const y2 = centerY + n2.y * view.scale;\n\n          ctx.beginPath();\n          ctx.moveTo(x1, y1);\n          ctx.lineTo(x2, y2);\n          ctx.stroke();\n        }\n      }\n\n      // Draw orbit ring for focused template\n      if (focusedTemplate) {\n        const focusedNode = templateNodes.find(n => n.template === focusedTemplate);\n        if (focusedNode) {\n          const fx = centerX + focusedNode.x * view.scale;\n          const fy = centerY + focusedNode.y * view.scale;\n          const orbitR = 180 * view.scale;\n\n          // Draw orbit ring\n          ctx.strokeStyle = focusedNode.color + '30';\n          ctx.lineWidth = 2;\n          ctx.setLineDash([5, 10]);\n          ctx.beginPath();\n          ctx.arc(fx, fy, orbitR, 0, Math.PI * 2);\n          ctx.stroke();\n          ctx.setLineDash([]);\n\n          // Draw connections from center to topics\n          topicNodes.forEach(topic => {\n            const tx = centerX + topic.x * view.scale;\n            const ty = centerY + topic.y * view.scale;\n\n            ctx.strokeStyle = topic.color + '40';\n            ctx.lineWidth = 1;\n            ctx.beginPath();\n            ctx.moveTo(fx, fy);\n            ctx.lineTo(tx, ty);\n            ctx.stroke();\n          });\n        }\n      }\n\n      // Draw nodes (templates first, then topics on top)\n      [...templateNodes, ...topicNodes].forEach((node) => {\n        const x = centerX + node.x * view.scale;\n        const y = centerY + node.y * view.scale;\n        const pulse = Math.sin(time * 2 + node.pulsePhase) * 0.15 + 1;\n        const r = node.radius * view.scale * pulse;\n\n        // Determine opacity based on focus state\n        const isFocused = !focusedTemplate || node.template === focusedTemplate;\n        const opacity = isFocused ? 1 : 0.2;\n\n        // Outer glow\n        const glowGradient = ctx.createRadialGradient(x, y, r * 0.5, x, y, r * 2);\n        glowGradient.addColorStop(0, node.color + (isFocused ? '40' : '10'));\n        glowGradient.addColorStop(0.5, node.color + (isFocused ? '15' : '05'));\n        glowGradient.addColorStop(1, 'transparent');\n\n        ctx.fillStyle = glowGradient;\n        ctx.beginPath();\n        ctx.arc(x, y, r * 2, 0, Math.PI * 2);\n        ctx.fill();\n\n        // Inner circle\n        const innerGradient = ctx.createRadialGradient(x, y, 0, x, y, r);\n        innerGradient.addColorStop(0, node.color + (isFocused ? 'CC' : '44'));\n        innerGradient.addColorStop(0.7, node.color + (isFocused ? '88' : '22'));\n        innerGradient.addColorStop(1, node.color + (isFocused ? '44' : '11'));\n\n        ctx.fillStyle = innerGradient;\n        ctx.beginPath();\n        ctx.arc(x, y, r, 0, Math.PI * 2);\n        ctx.fill();\n\n        // Border\n        ctx.strokeStyle = node.color + (isFocused ? 'FF' : '44');\n        ctx.lineWidth = node.type === 'topic' ? 1.5 : 2;\n        ctx.beginPath();\n        ctx.arc(x, y, r, 0, Math.PI * 2);\n        ctx.stroke();\n\n        // Label (only if focused or no focus)\n        if (isFocused) {\n          ctx.fillStyle = '#E8E8E8';\n          ctx.font = `${Math.max(10, (node.type === 'topic' ? 12 : 14) * view.scale)}px Inter, system-ui, sans-serif`;\n          ctx.textAlign = 'center';\n          ctx.textBaseline = 'middle';\n          ctx.fillText(node.label, x, y - r - 15 * view.scale);\n\n          // Count\n          ctx.fillStyle = '#A1A1AA';\n          ctx.font = `${Math.max(9, (node.type === 'topic' ? 10 : 12) * view.scale)}px Inter, system-ui, sans-serif`;\n          ctx.fillText(`${node.sessions.length}`, x, y + r + 12 * view.scale);\n        }\n      });\n\n      time += 0.016;\n      animationRef.current = requestAnimationFrame(render);\n    };\n\n    render();\n\n    return () => {\n      if (animationRef.current) {\n        cancelAnimationFrame(animationRef.current);\n      }\n    };\n  }, [view, sessions, focusedTemplate, topics]);\n\n  // Mouse handlers for pan/zoom\n  const handleMouseDown = useCallback((e: React.MouseEvent) => {\n    isDragging.current = true;\n    lastMouse.current = { x: e.clientX, y: e.clientY };\n  }, []);\n\n  const handleMouseMove = useCallback((e: React.MouseEvent) => {\n    const rect = containerRef.current?.getBoundingClientRect();\n    if (!rect) return;\n\n    setMousePos({ x: e.clientX - rect.left, y: e.clientY - rect.top });\n\n    if (isDragging.current) {\n      const dx = e.clientX - lastMouse.current.x;\n      const dy = e.clientY - lastMouse.current.y;\n      setView(v => ({\n        ...v,\n        offsetX: v.offsetX + dx,\n        offsetY: v.offsetY + dy,\n      }));\n      lastMouse.current = { x: e.clientX, y: e.clientY };\n    }\n\n    // Check hover\n    const nodes = nodesRef.current;\n    const centerX = rect.width / 2 + view.offsetX;\n    const centerY = rect.height / 2 + view.offsetY;\n    const mx = e.clientX - rect.left;\n    const my = e.clientY - rect.top;\n\n    let found: Node | null = null;\n    for (const node of nodes) {\n      const x = centerX + node.x * view.scale;\n      const y = centerY + node.y * view.scale;\n      const dist = Math.sqrt((mx - x) ** 2 + (my - y) ** 2);\n      if (dist < node.radius * view.scale * 1.5) {\n        found = node;\n        break;\n      }\n    }\n    setHoveredNode(found);\n  }, [view]);\n\n  const handleMouseUp = useCallback(() => {\n    isDragging.current = false;\n  }, []);\n\n  const handleWheel = useCallback((e: React.WheelEvent) => {\n    e.preventDefault();\n    const delta = e.deltaY > 0 ? 0.9 : 1.1;\n    setView(v => ({\n      ...v,\n      scale: Math.max(0.3, Math.min(3, v.scale * delta)),\n    }));\n  }, []);\n\n  const handleClick = useCallback(() => {\n    if (!hoveredNode) {\n      // Click on empty space - unfocus\n      if (focusedTemplate) {\n        setFocusedTemplate(null);\n        setFocusedTopic(null);\n      }\n      return;\n    }\n\n    if (hoveredNode.type === 'template') {\n      if (focusedTemplate === hoveredNode.template) {\n        // Already focused, unfocus\n        setFocusedTemplate(null);\n        setFocusedTopic(null);\n      } else {\n        // Focus on this template\n        setFocusedTemplate(hoveredNode.template);\n        setFocusedTopic(null);\n      }\n    } else if (hoveredNode.type === 'topic') {\n      if (hoveredNode.sessions.length === 1 && onSessionSelect) {\n        // Single session - select it directly\n        onSessionSelect(hoveredNode.sessions[0]);\n      } else if (hoveredNode.topic) {\n        // Show topic sessions in panel\n        setFocusedTopic(hoveredNode.topic);\n      }\n    }\n  }, [hoveredNode, onSessionSelect, focusedTemplate]);\n\n  return (\n    <div\n      ref={containerRef}\n      className=\"relative w-full h-full overflow-hidden cursor-grab active:cursor-grabbing\"\n      onMouseDown={handleMouseDown}\n      onMouseMove={handleMouseMove}\n      onMouseUp={handleMouseUp}\n      onMouseLeave={handleMouseUp}\n      onWheel={handleWheel}\n      onClick={handleClick}\n    >\n      <canvas ref={canvasRef} className=\"w-full h-full\" />\n\n      {/* Tooltip */}\n      {hoveredNode && (\n        <div\n          className=\"absolute pointer-events-none z-10 bg-[#1A1A1E] border border-[#22D3EE]/30 rounded-lg p-3 shadow-lg shadow-[#22D3EE]/10\"\n          style={{\n            left: mousePos.x + 15,\n            top: mousePos.y + 15,\n            maxWidth: 280,\n          }}\n        >\n          <div className=\"flex items-center gap-2 mb-2\">\n            <div\n              className=\"w-3 h-3 rounded-full\"\n              style={{ backgroundColor: hoveredNode.color, boxShadow: `0 0 8px ${hoveredNode.color}` }}\n            />\n            <span className=\"text-[#E8E8E8] font-medium\">{hoveredNode.label}</span>\n            <span className=\"text-[#71717A] text-xs uppercase\">\n              {hoveredNode.type}\n            </span>\n          </div>\n          <div className=\"text-[#A1A1AA] text-sm\">\n            {hoveredNode.sessions.length} research sessions\n          </div>\n          <div className=\"mt-2 text-xs text-[#71717A]\">\n            {hoveredNode.sessions.slice(0, 3).map(s => (\n              <div key={s.id} className=\"truncate\">{s.title}</div>\n            ))}\n            {hoveredNode.sessions.length > 3 && (\n              <div>+{hoveredNode.sessions.length - 3} more...</div>\n            )}\n          </div>\n          <div className=\"mt-2 text-xs text-[#22D3EE]\">\n            {hoveredNode.type === 'template'\n              ? focusedTemplate === hoveredNode.template\n                ? 'Click to unfocus'\n                : 'Click to see topics'\n              : hoveredNode.sessions.length === 1\n                ? 'Click to open report'\n                : 'Click to see sessions'}\n          </div>\n        </div>\n      )}\n\n      {/* Focused topic sessions panel */}\n      {focusedTopic && (\n        <div className=\"absolute top-4 left-4 bg-[#1A1A1E]/95 backdrop-blur-sm border border-[#22D3EE]/30 rounded-lg p-4 max-w-xs shadow-lg\">\n          <div className=\"flex items-center justify-between mb-3\">\n            <h3 className=\"text-[#E8E8E8] font-medium\">{focusedTopic.name}</h3>\n            <button\n              onClick={(e) => {\n                e.stopPropagation();\n                setFocusedTopic(null);\n              }}\n              className=\"text-[#71717A] hover:text-[#22D3EE] text-xs\"\n            >\n              Close\n            </button>\n          </div>\n          {focusedTopic.description && (\n            <p className=\"text-xs text-[#A1A1AA] mb-3\">{focusedTopic.description}</p>\n          )}\n          <div className=\"space-y-1 max-h-48 overflow-auto\">\n            {sessions\n              .filter(s => focusedTopic.sessions?.some(ts => ts.id === s.id))\n              .map(s => (\n                <button\n                  key={s.id}\n                  onClick={(e) => {\n                    e.stopPropagation();\n                    onSessionSelect?.(s);\n                  }}\n                  className=\"w-full text-left text-sm text-[#A1A1AA] hover:text-[#22D3EE] truncate transition-colors\"\n                >\n                  {s.title}\n                </button>\n              ))}\n          </div>\n        </div>\n      )}\n\n      {/* Controls hint */}\n      <div className=\"absolute bottom-4 left-4 text-[#71717A] text-xs\">\n        Drag to pan • Scroll to zoom • Click nodes to {focusedTemplate ? 'drill down' : 'focus'}\n      </div>\n\n      {/* Zoom indicator */}\n      <div className=\"absolute bottom-4 right-4 text-[#71717A] text-xs font-mono\">\n        {Math.round(view.scale * 100)}%\n      </div>\n    </div>\n  );\n}\n","numLines":523,"startLine":1,"totalLines":523}}}
