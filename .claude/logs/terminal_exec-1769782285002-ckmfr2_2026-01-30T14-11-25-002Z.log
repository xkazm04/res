dedId] = useState<string | null>(null);\n    37→\n    38→  const sourceMap = useMemo(() => new Map(sources.map(s => [s.id, s])), [sources]);\n    39→\n    40→  const findingTypes = useMemo(() =>\n    41→    Array.from(new Set(findings.map(f => f.finding_type).filter(Boolean))),\n    42→    [findings]\n    43→  );\n    44→\n    45→  const filtered = useMemo(() => {\n    46→    return findings.filter((f) => {\n    47→      if (debouncedSearchQuery && !f.content.toLowerCase().includes(debouncedSearchQuery.toLowerCase())) return false;\n    48→      if (filterType !== 'all' && f.finding_type !== filterType) return false;\n    49→      if (!matchesConfidenceFilter(f.confidence_score || 0, filterConfidence as ConfidenceFilterOption)) return false;\n    50→      return true;\n    51→    });\n    52→  }, [findings, debouncedSearchQuery, filterType, filterConfidence]);\n    53→\n    54→  const sorted = useMemo(() => {\n    55→    return [...filtered].sort((a, b) => {\n    56→      let cmp = 0;\n    57→      switch (sortKey) {\n    58→        case 'confidence': cmp = (a.confidence_score || 0) - (b.confidence_score || 0); break;\n    59→        case 'type': cmp = (a.finding_type || '').localeCompare(b.finding_type || ''); break;\n    60→        case 'date': cmp = new Date(a.event_date || 0).getTime() - new Date(b.event_date || 0).getTime(); break;\n    61→        case 'sources': cmp = (a.supporting_sources?.length || 0) - (b.supporting_sources?.length || 0); break;\n    62→      }\n    63→      return sortDir === 'desc' ? -cmp : cmp;\n    64→    });\n    65→  }, [filtered, sortKey, sortDir]);\n    66→\n    67→  const toggleSort = (key: SortKey) => {\n    68→    if (sortKey === key) setSortDir(d => d === 'asc' ? 'desc' : 'asc');\n    69→    else { setSortKey(key); setSortDir('desc'); }\n    70→  };\n    71→\n    72→  // Virtualization setup\n    73→  const parentRef = useRef<HTMLDivElement>(null);\n    74→  const rowVirtualizer = useVirtualizer({\n    75→    count: sorted.length,\n    76→    getScrollElement: () => parentRef.current,\n    77→    estimateSize: useCallback((index: number) => {\n    78→      // Estimate larger size for expanded rows\n    79→      return expandedId === sorted[index]?.id ? 180 : 44;\n    80→    }, [expandedId, sorted]),\n    81→    overscan: 5,\n    82→  });\n    83→\n    84→  if (filtered.length === 0) {\n    85→    return (\n    86→      <EmptyState\n    87→        type=\"search\"\n    88→        title=\"No findings match your filters\"\n    89→        description=\"Try adjusting your search terms or filter criteria to see more results.\"\n    90→      />\n    91→    );\n    92→  }\n    93→\n    94→  return (\n    95→    <div className=\"space-y-4\">\n    96→      <ViewHeader title=\"Findings\" count={filtered.length} />\n    97→\n    98→      {/* Inline Toolbar */}\n    99→      <div className={`flex flex-wrap gap-3 p-3 rounded-lg ${isRadar ? 'bg-slate-900/50 border border-cyan-500/10' : 'bg-stone-50 border border-stone-200'}`}>\n   100→        <input\n   101→          type=\"text\"\n   102→          placeholder=\"Search findings...\"\n   103→          value={searchQuery}\n   104→          onChange={(e) => setSearchQuery(e.target.value)}\n   105→          className={`flex-1 min-w-[180px] px-3 py-1.5 text-sm rounded-lg ${isRadar ? 'bg-slate-800 border-cyan-500/20 text-white placeholder:text-slate-500' : 'bg-white border-stone-300 text-stone-900 placeholder:text-stone-400'} border focus:outline-none`}\n   106→        />\n   107→        <select\n   108→          value={filterType}\n   109→          onChange={(e) => setFilterType(e.target.value)}\n   110→          className={`px-3 py-1.5 text-sm rounded-lg ${isRadar ? 'bg-slate-800 border-cyan-500/20 text-white' : 'bg-white border-stone-300 text-stone-900'} border`}\n   111→        >\n   112→          <option value=\"all\">All Types</option>\n   113→          {findingTypes.map(t => <option key={t} value={t}>{t}</option>)}\n   114→        </select>\n   115→     