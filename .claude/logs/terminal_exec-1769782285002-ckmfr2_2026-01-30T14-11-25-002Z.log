ent = null;\n    57→\n    58→    const animate = (timestamp: number) => {\n    59→      if (startTimeRef.current === null) {\n    60→        startTimeRef.current = timestamp;\n    61→      }\n    62→\n    63→      const elapsed = timestamp - startTimeRef.current;\n    64→      const progress = Math.min(elapsed / durationMs, 1);\n    65→      const easedProgress = easeOutCubic(progress);\n    66→\n    67→      const currentValue = startValue + (targetValue - startValue) * easedProgress;\n    68→      setDisplayValue(currentValue);\n    69→\n    70→      if (progress < 1) {\n    71→        animationRef.current = requestAnimationFrame(animate);\n    72→      } else {\n    73→        // Animation complete, update start value for next animation\n    74→        startValueRef.current = targetValue;\n    75→        animationRef.current = null;\n    76→      }\n    77→    };\n    78→\n    79→    animationRef.current = requestAnimationFrame(animate);\n    80→\n    81→    return () => {\n    82→      if (animationRef.current !== null) {\n    83→        cancelAnimationFrame(animationRef.current);\n    84→      }\n    85→    };\n    86→  }, [value, duration, reducedMotion]);\n    87→\n    88→  // Update startValueRef when animation completes or is interrupted\n    89→  useEffect(() => {\n    90→    return () => {\n    91→      startValueRef.current = displayValue;\n    92→    };\n    93→  }, [displayValue]);\n    94→\n    95→  return (\n    96→    <span className={className}>\n    97→      {prefix}{displayValue.toFixed(decimals)}{suffix}\n    98→    </span>\n    99→  );\n   100→}\n   101→\n   102→interface AnimatedProgressRingProps {\n   103→  value: number;\n   104→  size?: number;\n   105→  strokeWidth?: number;\n   106→  color?: string;\n   107→  bgColor?: string;\n   108→  showValue?: boolean;\n   109→  className?: string;\n   110→  /** Accessible label describing what this progress ring represents */\n   111→  'aria-label'?: string;\n   112→}\n   113→\n   114→export functio