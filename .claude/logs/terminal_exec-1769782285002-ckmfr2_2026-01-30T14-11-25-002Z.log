[2026-01-30T14:13:08.015Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019DxMB61Yzk6UXx3TvqkDEM","type":"tool_result","content":"     1→'use client';\n     2→\n     3→import { useState, useEffect } from 'react';\n     4→import { motion } from 'framer-motion';\n     5→import { useReportTheme } from './core/ThemeContext';\n     6→import { AnimatedNumber, AnimatedProgressRing, PulsingDot } from './core/AnimatedNumber';\n     7→\n     8→type TabId = 'overview' | 'findings' | 'sources' | 'perspectives' | 'analysis' | 'entities';\n     9→\n    10→const SIDEBAR_COLLAPSED_KEY = 'report-sidebar-collapsed';\n    11→\n    12→// Hook to persist sidebar collapsed state\n    13→function useSidebarCollapsed() {\n    14→  const [collapsed, setCollapsed] = useState(false);\n    15→\n    16→  useEffect(() => {\n    17→    const stored = localStorage.getItem(SIDEBAR_COLLAPSED_KEY);\n    18→    if (stored !== null) {\n    19→      setCollapsed(stored === 'true');\n    20→    }\n    21→  }, []);\n    22→\n    23→  const toggle = () => {\n    24→    setCollapsed(prev => {\n    25→      const next = !prev;\n    26→      localStorage.setItem(SIDEBAR_COLLAPSED_KEY, String(next));\n    27→      return next;\n    28→    });\n    29→  };\n    30→\n    31→  return { collapsed, toggle };\n    32→}\n    33→\n    34→// Collapse toggle button with rotating chevron - uses CSS transition instead of Framer Motion\n    35→function CollapseToggle({ collapsed, onToggle, theme }: { collapsed: boolean; onToggle: () => void; theme: 'radar' | 'swiss' }) {\n    36→  const isRadar = theme === 'radar';\n    37→  return (\n    38→    <button\n    39→      onClick={onToggle}\n    40→      className={`w-full flex items-center justify-center py-2 transition-colors ${\n    41→        isRadar\n    42→          ? 'text-slate-400 hover:text-cyan-400 border-t border-cyan-500/10'\n    43→          : 'text-stone-400 hover:text-stone-900 border-t border-stone-100'\n    44→      }`}\n    45→      aria-label={collapsed ? 'Expand sidebar' : 'Collapse sidebar'}\n    46→    >\n    47→      <svg\n    48→        className=\"w-5 h-5 transition-transform duration-200 ease-out\"\n    49→        style={{ transform: collapsed ? 'rotate(180deg)' : 'rotate(0deg)' }}\n    50→        viewBox=\"0 0 24 24\"\n    51→        fill=\"none\"\n    52→        stroke=\"currentColor\"\n    53→        strokeWidth=\"2\"\n    54→      >\n    55→        <path d=\"M11 19l-7-7 7-7M18 19l-7-7 7-7\" />\n    56→      </svg>\n    57→    </button>\n    58→  );\n    59→}\n    60→\n    61→// Unified tab indicator with smooth sliding animation via layoutId\n    62→function TabIndicator({ theme }: { theme: 'radar' | 'swiss' }) {\n    63→  const isRadar = theme === 'radar';\n    64→  return (\n    65→    <motion.div\n    66→      layoutId=\"tab-indicator\"\n    67→      className={`absolute left-0 top-1 bottom-1 w-[3px] rounded-full ${\n    68→        isRadar ? 'bg-cyan-400' : 'bg-stone-900'\n    69→      }`}\n    70→      transition={{\n    71→        type: 'spring',\n    72→        stiffness: 500,\n    73→        damping: 35,\n    74→      }}\n    75→    />\n    76→  );\n    77→}\n    78→\n    79→interface ThemedSidebarProps {\n    80→  activeTab: TabId;\n    81→  onTabChange: (tab: TabId) => void;\n    82→  onTabHover?: (tab: TabId) => void;\n    83→  stats: {\n    84→    findings: number;\n    85→    sources: number;\n    86→    perspectives: number;\n    87→    contradictions: number;\n    88→    gaps: number;\n    89→    avgConfidence: number;\n    90→    redFlags: number;\n    91→    entities: number;\n    92→  };\n    93→  onClose: () => void;\n    94→}\n    95→\n    96→const tabs: { id: TabId; label: string; key: keyof ThemedSidebarProps['stats'] | null }[] = [\n    97→  { id: 'overview', label: 'Overview', key: null },\n    98→  { id: 'findings', label: 'Findings', key: 'findings' },\n    99→  { id: 'sources', label: 'Sources', key: 'sources' },\n   100→  { id: 'perspectives', label: 'Perspectives', key: 'perspectives' },\n   101→  { id: 'analysis', label: 'Analysis', key: null },\n   102→  { id: 'entities', label: 'Entities', key: 'entities' },\n   103→];\n   104→\n   105→export function ThemedSidebar({ activeTab, onTabChange, onTabHover, stats, onClose }: ThemedSidebarProps) {\n   106→  const { theme } = useReportTheme();\n   107→  const { collapsed, toggle } = useSidebarCollapsed();\n   108→\n   109→  return theme === 'radar' ? (\n   110→    <RadarSidebar activeTab={activeTab} onTabChange={onTabChange} onTabHover={onTabHover} stats={stats} onClose={onClose} collapsed={collapsed} onToggleCollapse={toggle} />\n   111→  ) : (\n   112→    <SwissSidebar activeTab={activeTab} onTabChange={onTabChange} onTabHover={onTabHover} stats={stats} onClose={onClose} collapsed={collapsed} onToggleCollapse={toggle} />\n   113→  );\n   114→}\n   115→\n   116→function RadarSidebar({ activeTab, onTabChange, onTabHover, stats, onClose, collapsed, onToggleCollapse }: ThemedSidebarProps & { collapsed: boolean; onToggleCollapse: () => void }) {\n   117→  return (\n   118→    <motion.aside\n   119→      initial={false}\n   120→      animate={{ width: collapsed ? 56 : 224 }}\n   121→      transition={{ type: 'spring', stiffness: 300, damping: 30 }}\n   122→      className=\"flex flex-col border-r border-cyan-500/20 bg-slate-950/50 overflow-hidden\"\n   123→    >\n   124→      {/* Header */}\n   125→      <div className=\"p-4 border-b border-cyan-500/20\">\n   126→        <div className=\"flex items-center gap-2\">\n   127→          <div className=\"w-8 h-8 rounded-lg bg-gradient-to-br from-cyan-400 to-blue-500 flex items-center justify-center flex-shrink-0\">\n   128→            <span className=\"text-white text-xs font-bold\">DR</span>\n   129→          </div>\n   130→          {!collapsed && (\n   131→            <motion.div\n   132→              initial={{ opacity: 0 }}\n   133→              animate={{ opacity: 1 }}\n   134→              exit={{ opacity: 0 }}\n   135→            >\n   136→              <div className=\"text-sm font-semibold text-white whitespace-nowrap\">Deep Research</div>\n   137→              <div className=\"text-[10px] text-cyan-400/60 whitespace-nowrap\">Intelligence Report</div>\n   138→            </motion.div>\n   139→          )}\n   140→        </div>\n   141→      </div>\n   142→\n   143→      {/* Confidence Ring */}\n   144→      <div className={`flex justify-center border-b border-cyan-500/10 ${collapsed ? 'p-2' : 'p-4'}`}>\n   145→        <AnimatedProgressRing\n   146→          value={stats.avgConfidence}\n   147→          size={collapsed ? 40 : 80}\n   148→          strokeWidth={collapsed ? 4 : 6}\n   149→          color=\"#22d3ee\"\n   150→          bgColor=\"rgba(34,211,238,0.1)\"\n   151→          showValue={!collapsed}\n   152→        />\n   153→      </div>\n   154→\n   155→      {/* Navigation */}\n   156→      <nav className=\"flex-1 p-2 space-y-1\">\n   157→        {tabs.map((tab, i) => {\n   158→          const count = tab.key ? stats[tab.key] : tab.id === 'analysis' ? stats.contradictions + stats.gaps : null;\n   159→          const isActive = activeTab === tab.id;\n   160→          return (\n   161→            <button\n   162→              key={tab.id}\n   163→              onClick={() => onTabChange(tab.id)}\n   164→              onMouseEnter={() => onTabHover?.(tab.id)}\n   165→              title={collapsed ? tab.label : undefined}\n   166→              className={`relative w-full px-3 py-2 rounded-lg text-left text-sm transition-all flex items-center gap-2 animate-slide-in-left ${\n   167→                isActive\n   168→                  ? 'bg-cyan-500/10 text-cyan-300'\n   169→                  : 'text-slate-400 hover:text-white hover:bg-white/5'\n   170→              } ${collapsed ? 'justify-center' : ''}`}\n   171→              style={{ animationDelay: `${i * 50}ms` }}\n   172→            >\n   173→              {isActive && <TabIndicator theme=\"radar\" />}\n   174→              {collapsed ? (\n   175→                <span className=\"text-xs font-bold\">{tab.label.charAt(0)}</span>\n   176→              ) : (\n   177→                <>\n   178→                  <span className=\"flex-1 whitespace-nowrap\">{tab.label}</span>\n   179→                  {count !== null && (\n   180→                    <span className=\"text-[10px] px-1.5 py-0.5 rounded bg-white/10\">\n   181→                      <AnimatedNumber value={count} />\n   182→                    </span>\n   183→                  )}\n   184→                </>\n   185→              )}\n   186→            </button>\n   187→          );\n   188→        })}\n   189→      </nav>\n   190→\n   191→      {/* Stats */}\n   192→      {!collapsed && stats.redFlags > 0 && (\n   193→        <div className=\"p-3 border-t border-cyan-500/10 space-y-2\">\n   194→          <div className=\"flex items-center gap-2 px-2 py-1.5 rounded bg-rose-500/10 border border-rose-500/20\">\n   195→            <PulsingDot color=\"bg-rose-500\" />\n   196→            <span className=\"text-xs text-rose-400 whitespace-nowrap\">{stats.redFlags} Red Flags</span>\n   197→          </div>\n   198→        </div>\n   199→      )}\n   200→\n   201→      {/* Collapse indicator for red flags when collapsed */}\n   202→      {collapsed && stats.redFlags > 0 && (\n   203→        <div className=\"px-2 py-2 border-t border-cyan-500/10 flex justify-center\">\n   204→          <PulsingDot color=\"bg-rose-500\" />\n   205→        </div>\n   206→      )}\n   207→\n   208→      {/* Close */}\n   209→      {!collapsed && (\n   210→        <div className=\"p-3\">\n   211→          <button onClick={onClose} className=\"w-full px-3 py-2 text-xs text-slate-400 hover:text-white border border-cyan-500/20 hover:border-cyan-500/40 rounded-lg transition-all whitespace-nowrap\">\n   212→            Close Report\n   213→          </button>\n   214→        </div>\n   215→      )}\n   216→\n   217→      {/* Collapse Toggle */}\n   218→      <CollapseToggle collapsed={collapsed} onToggle={onToggleCollapse} theme=\"radar\" />\n   219→    </motion.aside>\n   220→  );\n   221→}\n   222→\n   223→function SwissSidebar({ activeTab, onTabChange, onTabHover, stats, onClose, collapsed, onToggleCollapse }: ThemedSidebarProps & { collapsed: boolean; onToggleCollapse: () => void }) {\n   224→  return (\n   225→    <motion.aside\n   226→      initial={false}\n   227→      animate={{ width: collapsed ? 56 : 208 }}\n   228→      transition={{ type: 'spring', stiffness: 300, damping: 30 }}\n   229→      className=\"flex flex-col border-r border-stone-200 bg-white overflow-hidden\"\n   230→    >\n   231→      {/* Header */}\n   232→      <div className=\"p-4 border-b border-stone-200\">\n   233→        {collapsed ? (\n   234→          <div className=\"w-8 h-8 rounded bg-stone-900 flex items-center justify-center\">\n   235→            <span className=\"text-white text-xs font-bold\">R</span>\n   236→          </div>\n   237→        ) : (\n   238→          <>\n   239→            <div className=\"text-lg font-bold text-stone-900 tracking-tight whitespace-nowrap\">Research</div>\n   240→            <div className=\"text-[10px] uppercase tracking-[0.2em] text-stone-400 mt-0.5 whitespace-nowrap\">Intelligence Report</div>\n   241→          </>\n   242→        )}\n   243→      </div>\n   244→\n   245→      {/* Big number */}\n   246→      <div className={`border-b border-stone-100 ${collapsed ? 'p-2' : 'p-4'}`}>\n   247→        <div className={`font-bold text-stone-900 tabular-nums ${collapsed ? 'text-lg text-center' : 'text-4xl'}`}>\n   248→          <AnimatedNumber value={stats.avgConfidence} suffix=\"%\" />\n   249→        </div>\n   250→        {!collapsed && (\n   251→          <div className=\"text-[10px] uppercase tracking-wider text-stone-400 mt-1 whitespace-nowrap\">Confidence Score</div>\n   252→        )}\n   253→      </div>\n   254→\n   255→      {/* Navigation */}\n   256→      <nav className=\"flex-1 py-2\">\n   257→        {tabs.map((tab, i) => {\n   258→          const count = tab.key ? stats[tab.key] : tab.id === 'analysis' ? stats.contradictions + stats.gaps : null;\n   259→          const isActive = activeTab === tab.id;\n   260→          return (\n   261→            <button\n   262→              key={tab.id}\n   263→              onClick={() => onTabChange(tab.id)}\n   264→              onMouseEnter={() => onTabHover?.(tab.id)}\n   265→              title={collapsed ? tab.label : undefined}\n   266→              className={`relative w-full px-4 py-2.5 text-left text-sm flex items-center transition-all animate-fade-in ${\n   267→                isActive\n   268→                  ? 'bg-stone-50 text-stone-900 font-medium'\n   269→                  : 'text-stone-500 hover:text-stone-900 hover:bg-stone-50'\n   270→              } ${collapsed ? 'justify-center px-2' : ''}`}\n   271→              style={{ animationDelay: `${i * 30}ms` }}\n   272→            >\n   273→              {isActive && <TabIndicator theme=\"swiss\" />}\n   274→              {collapsed ? (\n   275→                <span className=\"text-xs font-bold\">{tab.label.charAt(0)}</span>\n   276→              ) : (\n   277→                <>\n   278→                  <span className=\"flex-1 whitespace-nowrap\">{tab.label}</span>\n   279→                  {count !== null && (\n   280→                    <span className=\"text-xs tabular-nums text-stone-400\">{count}</span>\n   281→                  )}\n   282→                </>\n   283→              )}\n   284→            </button>\n   285→          );\n   286→        })}\n   287→      </nav>\n   288→\n   289→      {/* Stats */}\n   290→      {!collapsed && stats.redFlags > 0 && (\n   291→        <div className=\"mx-4 mb-3 px-3 py-2 border-l-2 border-rose-600 bg-rose-50\">\n   292→          <div className=\"text-xs font-medium text-rose-700 whitespace-nowrap\">{stats.redFlags} Issues Found</div>\n   293→        </div>\n   294→      )}\n   295→\n   296→      {/* Red flag indicator when collapsed */}\n   297→      {collapsed && stats.redFlags > 0 && (\n   298→        <div className=\"px-2 py-2 flex justify-center\">\n   299→          <div className=\"w-2 h-2 rounded-full bg-rose-500\" />\n   300→        </div>\n   301→      )}\n   302→\n   303→      {/* Close */}\n   304→      {!collapsed && (\n   305→        <div className=\"p-3 border-t border-stone-100\">\n   306→          <button onClick={onClose} className=\"w-full px-3 py-2 text-xs text-stone-500 hover:text-stone-900 border border-stone-200 hover:border-stone-900 rounded transition-all whitespace-nowrap\">\n   307→            Close\n   308→          </button>\n   309→        </div>\n   310→      )}\n   311→\n   312→      {/* Collapse Toggle */}\n   313→      <CollapseToggle collapsed={collapsed} onToggle={onToggleCollapse} theme=\"swiss\" />\n   314→    </motion.aside>\n   315→  );\n   316→}\n   317→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"7b50487e-569d-4a38-aca7-0add610c3dda","uuid":"3f6fd32d-9686-4868-b84f-e377ae4867ef","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\ThemedSidebar.tsx","content":"'use client';\n\nimport { useState, useEffect } from 'react';\nimport { motion } from 'framer-motion';\nimport { useReportTheme } from './core/ThemeContext';\nimport { AnimatedNumber, AnimatedProgressRing, PulsingDot } from './core/AnimatedNumber';\n\ntype TabId = 'overview' | 'findings' | 'sources' | 'perspectives' | 'analysis' | 'entities';\n\nconst SIDEBAR_COLLAPSED_KEY = 'report-sidebar-collapsed';\n\n// Hook to persist sidebar collapsed state\nfunction useSidebarCollapsed() {\n  const [collapsed, setCollapsed] = useState(false);\n\n  useEffect(() => {\n    const stored = localStorage.getItem(SIDEBAR_COLLAPSED_KEY);\n    if (stored !== null) {\n      setCollapsed(stored === 'true');\n    }\n  }, []);\n\n  const toggle = () => {\n    setCollapsed(prev => {\n      const next = !prev;\n      localStorage.setItem(SIDEBAR_COLLAPSED_KEY, String(next));\n      return next;\n    });\n  };\n\n  return { collapsed, toggle };\n}\n\n// Collapse toggle button with rotating chevron - uses CSS transition instead of Framer Motion\nfunction CollapseToggle({ collapsed, onToggle, theme }: { collapsed: boolean; onToggle: () => void; theme: 'radar' | 'swiss' }) {\n  const isRadar = theme === 'radar';\n  return (\n    <button\n      onClick={onToggle}\n      className={`w-full flex items-center justify-center py-2 transition-colors ${\n        isRadar\n          ? 'text-slate-400 hover:text-cyan-400 border-t border-cyan-500/10'\n          : 'text-stone-400 hover:text-stone-900 border-t border-stone-100'\n      }`}\n      aria-label={collapsed ? 'Expand sidebar' : 'Collapse sidebar'}\n    >\n      <svg\n        className=\"w-5 h-5 transition-transform duration-200 ease-out\"\n        style={{ transform: collapsed ? 'rotate(180deg)' : 'rotate(0deg)' }}\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        strokeWidth=\"2\"\n      >\n        <path d=\"M11 19l-7-7 7-7M18 19l-7-7 7-7\" />\n      </svg>\n    </button>\n  );\n}\n\n// Unified tab indicator with smooth sliding animation via layoutId\nfunction TabIndicator({ theme }: { theme: 'radar' | 'swiss' }) {\n  const isRadar = theme === 'radar';\n  return (\n    <motion.div\n      layoutId=\"tab-indicator\"\n      className={`absolute left-0 top-1 bottom-1 w-[3px] rounded-full ${\n        isRadar ? 'bg-cyan-400' : 'bg-stone-900'\n      }`}\n      transition={{\n        type: 'spring',\n        stiffness: 500,\n        damping: 35,\n      }}\n    />\n  );\n}\n\ninterface ThemedSidebarProps {\n  activeTab: TabId;\n  onTabChange: (tab: TabId) => void;\n  onTabHover?: (tab: TabId) => void;\n  stats: {\n    findings: number;\n    sources: number;\n    perspectives: number;\n    contradictions: number;\n    gaps: number;\n    avgConfidence: number;\n    redFlags: number;\n    entities: number;\n  };\n  onClose: () => void;\n}\n\nconst tabs: { id: TabId; label: string; key: keyof ThemedSidebarProps['stats'] | null }[] = [\n  { id: 'overview', label: 'Overview', key: null },\n  { id: 'findings', label: 'Findings', key: 'findings' },\n  { id: 'sources', label: 'Sources', key: 'sources' },\n  { id: 'perspectives', label: 'Perspectives', key: 'perspectives' },\n  { id: 'analysis', label: 'Analysis', key: null },\n  { id: 'entities', label: 'Entities', key: 'entities' },\n];\n\nexport function ThemedSidebar({ activeTab, onTabChange, onTabHover, stats, onClose }: ThemedSidebarProps) {\n  const { theme } = useReportTheme();\n  const { collapsed, toggle } = useSidebarCollapsed();\n\n  return theme === 'radar' ? (\n    <RadarSidebar activeTab={activeTab} onTabChange={onTabChange} onTabHover={onTabHover} stats={stats} onClose={onClose} collapsed={collapsed} onToggleCollapse={toggle} />\n  ) : (\n    <SwissSidebar activeTab={activeTab} onTabChange={onTabChange} onTabHover={onTabHover} stats={stats} onClose={onClose} collapsed={collapsed} onToggleCollapse={toggle} />\n  );\n}\n\nfunction RadarSidebar({ activeTab, onTabChange, onTabHover, stats, onClose, collapsed, onToggleCollapse }: ThemedSidebarProps & { collapsed: boolean; onToggleCollapse: () => void }) {\n  return (\n    <motion.aside\n      initial={false}\n      animate={{ width: collapsed ? 56 : 224 }}\n      transition={{ type: 'spring', stiffness: 300, damping: 30 }}\n      className=\"flex flex-col border-r border-cyan-500/20 bg-slate-950/50 overflow-hidden\"\n    >\n      {/* Header */}\n      <div className=\"p-4 border-b border-cyan-500/20\">\n        <div className=\"flex items-center gap-2\">\n          <div className=\"w-8 h-8 rounded-lg bg-gradient-to-br from-cyan-400 to-blue-500 flex items-center justify-center flex-shrink-0\">\n            <span className=\"text-white text-xs font-bold\">DR</span>\n          </div>\n          {!collapsed && (\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n            >\n              <div className=\"text-sm font-semibold text-white whitespace-nowrap\">Deep Research</div>\n              <div className=\"text-[10px] text-cyan-400/60 whitespace-nowrap\">Intelligence Report</div>\n            </motion.div>\n          )}\n        </div>\n      </div>\n\n      {/* Confidence Ring */}\n      <div className={`flex justify-center border-b border-cyan-500/10 ${collapsed ? 'p-2' : 'p-4'}`}>\n        <AnimatedProgressRing\n          value={stats.avgConfidence}\n          size={collapsed ? 40 : 80}\n          strokeWidth={collapsed ? 4 : 6}\n          color=\"#22d3ee\"\n          bgColor=\"rgba(34,211,238,0.1)\"\n          showValue={!collapsed}\n        />\n      </div>\n\n      {/* Navigation */}\n      <nav className=\"flex-1 p-2 space-y-1\">\n        {tabs.map((tab, i) => {\n          const count = tab.key ? stats[tab.key] : tab.id === 'analysis' ? stats.contradictions + stats.gaps : null;\n          const isActive = activeTab === tab.id;\n          return (\n            <button\n              key={tab.id}\n              onClick={() => onTabChange(tab.id)}\n              onMouseEnter={() => onTabHover?.(tab.id)}\n              title={collapsed ? tab.label : undefined}\n              className={`relative w-full px-3 py-2 rounded-lg text-left text-sm transition-all flex items-center gap-2 animate-slide-in-left ${\n                isActive\n                  ? 'bg-cyan-500/10 text-cyan-300'\n                  : 'text-slate-400 hover:text-white hover:bg-white/5'\n              } ${collapsed ? 'justify-center' : ''}`}\n              style={{ animationDelay: `${i * 50}ms` }}\n            >\n              {isActive && <TabIndicator theme=\"radar\" />}\n              {collapsed ? (\n                <span className=\"text-xs font-bold\">{tab.label.charAt(0)}</span>\n              ) : (\n                <>\n                  <span className=\"flex-1 whitespace-nowrap\">{tab.label}</span>\n                  {count !== null && (\n                    <span className=\"text-[10px] px-1.5 py-0.5 rounded bg-white/10\">\n                      <AnimatedNumber value={count} />\n                    </span>\n                  )}\n                </>\n              )}\n            </button>\n          );\n        })}\n      </nav>\n\n      {/* Stats */}\n      {!collapsed && stats.redFlags > 0 && (\n        <div className=\"p-3 border-t border-cyan-500/10 space-y-2\">\n          <div className=\"flex items-center gap-2 px-2 py-1.5 rounded bg-rose-500/10 border border-rose-500/20\">\n            <PulsingDot color=\"bg-rose-500\" />\n            <span className=\"text-xs text-rose-400 whitespace-nowrap\">{stats.redFlags} Red Flags</span>\n          </div>\n        </div>\n      )}\n\n      {/* Collapse indicator for red flags when collapsed */}\n      {collapsed && stats.redFlags > 0 && (\n        <div className=\"px-2 py-2 border-t border-cyan-500/10 flex justify-center\">\n          <PulsingDot color=\"bg-rose-500\" />\n        </div>\n      )}\n\n      {/* Close */}\n      {!collapsed && (\n        <div className=\"p-3\">\n          <button onClick={onClose} className=\"w-full px-3 py-2 text-xs text-slate-400 hover:text-white border border-cyan-500/20 hover:border-cyan-500/40 rounded-lg transition-all whitespace-nowrap\">\n            Close Report\n          </button>\n        </div>\n      )}\n\n      {/* Collapse Toggle */}\n      <CollapseToggle collapsed={collapsed} onToggle={onToggleCollapse} theme=\"radar\" />\n    </motion.aside>\n  );\n}\n\nfunction SwissSidebar({ activeTab, onTabChange, onTabHover, stats, onClose, collapsed, onToggleCollapse }: ThemedSidebarProps & { collapsed: boolean; onToggleCollapse: () => void }) {\n  return (\n    <motion.aside\n      initial={false}\n      animate={{ width: collapsed ? 56 : 208 }}\n      transition={{ type: 'spring', stiffness: 300, damping: 30 }}\n      className=\"flex flex-col border-r border-stone-200 bg-white overflow-hidden\"\n    >\n      {/* Header */}\n      <div className=\"p-4 border-b border-stone-200\">\n        {collapsed ? (\n          <div className=\"w-8 h-8 rounded bg-stone-900 flex items-center justify-center\">\n            <span className=\"text-white text-xs font-bold\">R</span>\n          </div>\n        ) : (\n          <>\n            <div className=\"text-lg font-bold text-stone-900 tracking-tight whitespace-nowrap\">Research</div>\n            <div className=\"text-[10px] uppercase tracking-[0.2em] text-stone-400 mt-0.5 whitespace-nowrap\">Intelligence Report</div>\n          </>\n        )}\n      </div>\n\n      {/* Big number */}\n      <div className={`border-b border-stone-100 ${collapsed ? 'p-2' : 'p-4'}`}>\n        <div className={`font-bold text-stone-900 tabular-nums ${collapsed ? 'text-lg text-center' : 'text-4xl'}`}>\n          <AnimatedNumber value={stats.avgConfidence} suffix=\"%\" />\n        </div>\n        {!collapsed && (\n          <div className=\"text-[10px] uppercase tracking-wider text-stone-400 mt-1 whitespace-nowrap\">Confidence Score</div>\n        )}\n      </div>\n\n      {/* Navigation */}\n      <nav className=\"flex-1 py-2\">\n        {tabs.map((tab, i) => {\n          const count = tab.key ? stats[tab.key] : tab.id === 'analysis' ? stats.contradictions + stats.gaps : null;\n          const isActive = activeTab === tab.id;\n          return (\n            <button\n              key={tab.id}\n              onClick={() => onTabChange(tab.id)}\n              onMouseEnter={() => onTabHover?.(tab.id)}\n              title={collapsed ? tab.label : undefined}\n              className={`relative w-full px-4 py-2.5 text-left text-sm flex items-center transition-all animate-fade-in ${\n                isActive\n                  ? 'bg-stone-50 text-stone-900 font-medium'\n                  : 'text-stone-500 hover:text-stone-900 hover:bg-stone-50'\n              } ${collapsed ? 'justify-center px-2' : ''}`}\n              style={{ animationDelay: `${i * 30}ms` }}\n            >\n              {isActive && <TabIndicator theme=\"swiss\" />}\n              {collapsed ? (\n                <span className=\"text-xs font-bold\">{tab.label.charAt(0)}</span>\n              ) : (\n                <>\n                  <span className=\"flex-1 whitespace-nowrap\">{tab.label}</span>\n                  {count !== null && (\n                    <span className=\"text-xs tabular-nums text-stone-400\">{count}</span>\n                  )}\n                </>\n              )}\n            </button>\n          );\n        })}\n      </nav>\n\n      {/* Stats */}\n      {!collapsed && stats.redFlags > 0 && (\n        <div className=\"mx-4 mb-3 px-3 py-2 border-l-2 border-rose-600 bg-rose-50\">\n          <div className=\"text-xs font-medium text-rose-700 whitespace-nowrap\">{stats.redFlags} Issues Found</div>\n        </div>\n      )}\n\n      {/* Red flag indicator when collapsed */}\n      {collapsed && stats.redFlags > 0 && (\n        <div className=\"px-2 py-2 flex justify-center\">\n          <div className=\"w-2 h-2 rounded-full bg-rose-500\" />\n        </div>\n      )}\n\n      {/* Close */}\n      {!collapsed && (\n        <div className=\"p-3 border-t border-stone-100\">\n          <button onClick={onClose} className=\"w-full px-3 py-2 text-xs text-stone-500 hover:text-stone-900 border border-stone-200 hover:border-stone-900 rounded transition-all whitespace-nowrap\">\n            Close\n          </button>\n        </div>\n      )}\n\n      {/* Collapse Toggle */}\n      <CollapseToggle collapsed={collapsed} onToggle={onToggleCollapse} theme=\"swiss\" />\n    </motion.aside>\n  );\n}\n","numLines":317,"startLine":1,"totalLines":317}}}
