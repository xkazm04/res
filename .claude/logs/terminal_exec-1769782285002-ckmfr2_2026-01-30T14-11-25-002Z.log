   30→}\n    31→\n    32→interface OverviewViewProps {\n    33→  session: SessionWithDetails;\n    34→  stats: {\n    35→    findings: number;\n    36→    sources: number;\n    37→    perspectives: number;\n    38→    avgConfidence: number;\n    39→    highConfidence: number;\n    40→    redFlags: number;\n    41→    gaps: number;\n    42→  };\n    43→}\n    44→\n    45→type ViewMode = 'video' | 'static';\n    46→\n    47→const viewModeOptions: ViewModeOption<ViewMode>[] = [\n    48→  {\n    49→    value: 'video',\n    50→    label: 'Video',\n    51→    icon: <svg className=\"w-3 h-3\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M8 5v14l11-7z\" /></svg>,\n    52→  },\n    53→  {\n    54→    value: 'static',\n    55→    label: 'Static',\n    56→    icon: <svg className=\"w-3 h-3\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M4 6h16M4 12h16M4 18h16\" /></svg>,\n    57→  },\n    58→];\n    59→\n    60→export function OverviewView({ session, stats }: OverviewViewProps) {\n    61→  const { theme } = useReportTheme();\n    62→  const styles = useThemeStyles();\n    63→  const findings = session.findings || [];\n    64→  const isRadar = theme === 'radar';\n    65→  const [viewMode, setViewMode] = useState<ViewMode>('video');\n    66→\n    67→  // Calculate metrics for dashboard\n    68→  const coverage = Math.min(100, Math.round((stats.sources / Math.max(10, stats.findings * 2)) * 100));\n    69→  const reliability = Math.round((findings.filter(f => (f.confidence_score || 0) >= 0.7).length / Math.max(1, findings.length)) * 100);\n    70→  const completeness = Math.min(100, 100 - (stats.gaps * 10));\n    71→\n    72→  const allWarnings = session.perspectives?.flatMap(p => p.warnings || []) || [];\n    73→\n    74→  return (\n    75→    <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} className=\"space-y-6\">\n    76→      <ViewHeader\n    77→        title=\"Over