al: '', focal: '', afterFocal: '' };\n    42→  const progress = wordData.length > 0 ? (currentIndex / wordData.length) * 100 : 0;\n    43→\n    44→  const play = useCallback(() => {\n    45→    setIsPlaying(true);\n    46→  }, []);\n    47→\n    48→  const pause = useCallback(() => {\n    49→    setIsPlaying(false);\n    50→    if (intervalRef.current) {\n    51→      clearInterval(intervalRef.current);\n    52→      intervalRef.current = null;\n    53→    }\n    54→  }, []);\n    55→\n    56→  const reset = useCallback(() => {\n    57→    pause();\n    58→    setCurrentIndex(0);\n    59→  }, [pause]);\n    60→\n    61→  useEffect(() => {\n    62→    if (isPlaying && currentIndex < wordData.length - 1) {\n    63→      const msPerWord = 60000 / wpm;\n    64→      intervalRef.current = setInterval(() => {\n    65→        setCurrentIndex(i => Math.min(i + 1, wordData.length - 1));\n    66→      }, msPerWord);\n    67→      return () => {\n    68→        if (intervalRef.current) clearInterval(intervalRef.current);\n    69→      };\n    70→    } else if (currentIndex >= wordData.length - 1) {\n    71→      pause();\n    72→    }\n    73→  }, [isPlaying, wpm, wordData.length, currentIndex, pause]);\n    74→\n    75→  useEffect(() => {\n    76→    if (!isActive) {\n    77→      reset();\n    78→    }\n    79→  }, [isActive, reset]);\n    80→\n    81→  useEffect(() => {\n    82→    const handleKeyDown = (e: KeyboardEvent) => {\n    83→      if (!isActive) return;\n    84→      if (e.key === ' ') { e.preventDefault(); isPlaying ? pause() : play(); }\n    85→      if (e.key === 'ArrowLeft') setCurrentIndex(i => Math.max(0, i - 5));\n    86→      if (e.key === 'ArrowRight') setCurrentIndex(i => Math.min(wordData.length - 1, i + 5));\n    87→      if (e.key === 'Escape') onClose();\n    88→    };\n    89→    window.addEventListener('keydown', handleKeyDown);\n    90→    return () => window.removeEventListener('keydown', handleKeyDown);\n    91→  }, [isActive, isPlaying, play, p