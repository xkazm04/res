ector line segment between nodes (visual flow indicator) */}\n   168→              {i < descriptions.length - 1 && (\n   169→                <div className=\"flex items-center\">\n   170→                  <div className=\"w-6 h-0.5 bg-blue-300\" />\n   171→                  <div className=\"w-0 h-0 border-t-[4px] border-t-transparent border-b-[4px] border-b-transparent border-l-[6px] border-l-blue-400\" />\n   172→                </div>\n   173→              )}\n   174→            </div>\n   175→          ))}\n   176→        </div>\n   177→      </div>\n   178→    </div>\n   179→  );\n   180→}\n   181→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"7b50487e-569d-4a38-aca7-0add610c3dda","uuid":"c4d41c7e-1ae2-44ac-9b19-ad051b128e52","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\tabs\\AnalysisTab.tsx","content":"'use client';\n\nimport type { ResearchContradiction, ResearchGap, CausalChain } from '@/src/types/research';\nimport { ThemedSection } from '../ThemedCards';\nimport { EmptyState } from '../shared/EmptyState';\nimport { PriorityBadge } from '../shared/Badges';\nimport { AlertIcon, TargetIcon, ArrowRightIcon } from '../shared/Icons';\n\ninterface AnalysisTabProps {\n  contradictions: ResearchContradiction[];\n  gaps: ResearchGap[];\n  causalChains: CausalChain[];\n}\n\nexport function AnalysisTab({ contradictions, gaps, causalChains }: AnalysisTabProps) {\n  const hasContent = contradictions.length > 0 || gaps.length > 0 || causalChains.length > 0;\n\n  if (!hasContent) {\n    return <EmptyState type=\"chain\" title=\"No analysis data available\" />;\n  }\n\n  return (\n    <div className=\"space-y-4\">\n      {/* Contradictions */}\n      {contradictions.length > 0 && (\n        <ThemedSection title=\"Contradictions\" count={contradictions.length} collapsible defaultExpanded>\n          <div className=\"space-y-3\">\n            {contradictions.map((c) => (\n              <ContradictionCard key={c.id} contradiction={c} />\n            ))}\n          </div>\n        </ThemedSection>\n      )}\n\n      {/* Research Gaps */}\n      {gaps.length > 0 && (\n        <ThemedSection title=\"Research Gaps\" count={gaps.length} collapsible defaultExpanded>\n          <div className=\"space-y-3\">\n            {gaps.map((g) => (\n              <GapCard key={g.id} gap={g} />\n            ))}\n          </div>\n        </ThemedSection>\n      )}\n\n      {/* Causal Chains */}\n      {causalChains.length > 0 && (\n        <ThemedSection title=\"Causal Chains\" count={causalChains.length} collapsible defaultExpanded>\n          <div className=\"space-y-3\">\n            {causalChains.map((chain) => (\n              <CausalChainCard key={chain.id} chain={chain} />\n            ))}\n          </div>\n        </ThemedSection>\n      )}\n    </div>\n  );\n}\n\nfunction ContradictionCard({ contradiction }: { contradiction: ResearchContradiction }) {\n  return (\n    <div className=\"p-4 bg-red-50 border border-red-200 rounded-lg\">\n      <div className=\"flex items-center gap-2 mb-2\">\n        <span className=\"w-4 h-4 text-red-600\"><AlertIcon /></span>\n        <span className=\"text-xs font-semibold text-red-700 uppercase\">Contradiction</span>\n        {contradiction.significance && (\n          <span className=\"text-[10px] px-1.5 py-0.5 bg-red-100 text-red-700 rounded\">\n            {contradiction.significance}\n          </span>\n        )}\n      </div>\n\n      {/* Conflicting claims */}\n      <div className=\"space-y-2 mb-3\">\n        <div className=\"p-2 bg-white rounded border border-red-100\">\n          <div className=\"text-[10px] text-red-500 mb-1\">Claim A</div>\n          <p className=\"text-sm text-slate-700\">{contradiction.claim_1}</p>\n          {contradiction.source_1 && (\n            <p className=\"text-[10px] text-slate-500 mt-1\">Source: {contradiction.source_1}</p>\n          )}\n        </div>\n        <div className=\"flex justify-center\">\n          <span className=\"text-xs text-red-400\">VS</span>\n        </div>\n        <div className=\"p-2 bg-white rounded border border-red-100\">\n          <div className=\"text-[10px] text-red-500 mb-1\">Claim B</div>\n          <p className=\"text-sm text-slate-700\">{contradiction.claim_2}</p>\n          {contradiction.source_2 && (\n            <p className=\"text-[10px] text-slate-500 mt-1\">Source: {contradiction.source_2}</p>\n          )}\n        </div>\n      </div>\n\n      {/* Resolution hint */}\n      {contradiction.resolution_hint && (\n        <div className=\"text-xs text-slate-600 bg-white p-2 rounded border border-slate-100\">\n          <span className=\"font-medium\">Resolution hint:</span> {contradiction.resolution_hint}\n        </div>\n      )}\n    </div>\n  );\n}\n\nfunction GapCard({ gap }: { gap: ResearchGap }) {\n  const suggestedQueries = gap.suggested_queries || [];\n\n  return (\n    <div className=\"p-4 bg-violet-50 border border-violet-200 rounded-lg\">\n      <div className=\"flex items-center justify-between mb-2\">\n        <div className=\"flex items-center gap-2\">\n          <span className=\"w-4 h-4 text-violet-600\"><TargetIcon /></span>\n          <span className=\"text-xs font-semibold text-violet-700 uppercase\">{gap.gap_type} Gap</span>\n        </div>\n        <PriorityBadge priority={gap.priority} />\n      </div>\n\n      <p className=\"text-sm text-slate-700 mb-3\">{gap.description}</p>\n\n      {suggestedQueries.length > 0 && (\n        <div className=\"bg-white p-2 rounded border border-violet-100\">\n          <div className=\"text-[10px] text-violet-600 font-medium mb-1\">Suggested Queries</div>\n          <ul className=\"space-y-1\">\n            {suggestedQueries.slice(0, 3).map((query, i) => (\n              <li key={i} className=\"text-xs text-slate-600 flex items-center gap-1\">\n                <span className=\"w-3 h-3 text-violet-400\"><ArrowRightIcon /></span>\n                {query}\n              </li>\n            ))}\n          </ul>\n        </div>\n      )}\n    </div>\n  );\n}\n\nfunction CausalChainCard({ chain }: { chain: CausalChain }) {\n  const descriptions = chain.descriptions || [];\n\n  return (\n    <div className=\"p-4 bg-blue-50 border border-blue-200 rounded-lg\">\n      <div className=\"flex items-center gap-2 mb-3\">\n        <span className=\"text-xs font-semibold text-blue-700 uppercase\">Causal Chain</span>\n        <span className=\"text-[10px] text-blue-500\">\n          {descriptions.length} step{descriptions.length !== 1 ? 's' : ''}\n        </span>\n      </div>\n\n      {/* Chain visualization with continuous connector line */}\n      <div className=\"relative\">\n        {/* Continuous connecting line */}\n        {descriptions.length > 1 && (\n          <div className=\"absolute top-1/2 left-0 right-0 h-0.5 bg-blue-300 -translate-y-1/2\" />\n        )}\n\n        {/* Steps floating above the line */}\n        <div className=\"relative z-10 flex flex-wrap items-center gap-4\">\n          {descriptions.map((desc, i) => (\n            <div key={i} className=\"flex items-center gap-4\">\n              {/* Node circle */}\n              <div className=\"flex flex-col items-center gap-1\">\n                <div className=\"w-2 h-2 rounded-full bg-blue-500 ring-2 ring-blue-100\" />\n                <div className=\"px-2 py-1 bg-white rounded border border-blue-200 text-xs text-slate-700 shadow-sm\">\n                  {desc}\n                </div>\n              </div>\n\n              {/* Connector line segment between nodes (visual flow indicator) */}\n              {i < descriptions.length - 1 && (\n                <div className=\"flex items-center\">\n                  <div className=\"w-6 h-0.5 bg-blue-300\" />\n                  <div className=\"w-0 h-0 border-t-[4px] border-t-transparent border-b-[4px] border-b-transparent border-l-[6px] border-l-blue-400\" />\n                </div>\n              )}\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n}\n","numLines":181,"startLine":1,"totalLines":181}}}
