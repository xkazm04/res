[2026-01-30T14:28:01.643Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y8ga9Liyz4ANZD3b6zX25W","type":"tool_result","content":"     1→\"\"\"Intelligence analysis service for enhanced insights.\n     2→\n     3→Provides:\n     4→- Contradiction detection across findings\n     5→- Knowledge gaps analysis (\"What We Don't Know\")\n     6→- Role-specific executive summaries (CTO, CFO, CEO views)\n     7→\"\"\"\n     8→\n     9→import logging\n    10→from typing import List, Dict, Any, Optional, Tuple\n    11→from dataclasses import dataclass, asdict\n    12→\n    13→logger = logging.getLogger(__name__)\n    14→\n    15→\n    16→@dataclass\n    17→class Contradiction:\n    18→    \"\"\"A detected contradiction between findings.\"\"\"\n    19→    finding_a_id: str\n    20→    finding_a_summary: str\n    21→    finding_b_id: str\n    22→    finding_b_summary: str\n    23→    contradiction_type: str  # factual, temporal, quantitative, interpretive\n    24→    description: str\n    25→    severity: str  # high, medium, low\n    26→    resolution_hint: str\n    27→\n    28→\n    29→@dataclass\n    30→class KnowledgeGap:\n    31→    \"\"\"A gap in the research that affects conclusions.\"\"\"\n    32→    gap_id: str\n    33→    topic: str\n    34→    description: str\n    35→    importance: str  # critical, important, nice_to_have\n    36→    impact_on_conclusions: str\n    37→    suggested_query: str\n    38→    related_findings: List[str]\n    39→\n    40→\n    41→@dataclass\n    42→class RoleSummary:\n    43→    \"\"\"Role-specific summary for a stakeholder type.\"\"\"\n    44→    role: str  # cto, cfo, ceo, legal, product\n    45→    role_title: str\n    46→    headline: str\n    47→    key_points: List[str]\n    48→    action_items: List[str]\n    49→    risks_to_watch: List[str]\n    50→    metrics_of_interest: List[Dict[str, Any]]\n    51→    confidence_level: str  # high, medium, low\n    52→\n    53→\n    54→class IntelligenceAnalyzer:\n    55→    \"\"\"Analyzes findings for deeper insights.\"\"\"\n    56→\n    57→    def __init__(self, gemini_client=None):\n    58→        self.gemini_client = gemini_client\n    59→\n    60→    async def analyze(\n    61→        self,\n    62→        findings: List[Dict[str, Any]],\n    63→        perspectives: List[Dict[str, Any]],\n    64→        sources: List[Dict[str, Any]],\n    65→        query: str,\n    66→        template: str,\n    67→    ) -> Dict[str, Any]:\n    68→        \"\"\"\n    69→        Run full intelligence analysis on research results.\n    70→\n    71→        Returns:\n    72→            Dict with 'contradictions', 'knowledge_gaps', 'role_summaries'\n    73→        \"\"\"\n    74→        results = {\n    75→            \"contradictions\": [],\n    76→            \"knowledge_gaps\": [],\n    77→            \"role_summaries\": {},\n    78→        }\n    79→\n    80→        # Run analyses\n    81→        try:\n    82→            contradictions = await self.detect_contradictions(findings)\n    83→            results[\"contradictions\"] = [asdict(c) for c in contradictions]\n    84→        except Exception as e:\n    85→            logger.warning(f\"Contradiction detection failed: {e}\")\n    86→\n    87→        try:\n    88→            gaps = await self.identify_knowledge_gaps(findings, perspectives, query, template)\n    89→            results[\"knowledge_gaps\"] = [asdict(g) for g in gaps]\n    90→        except Exception as e:\n    91→            logger.warning(f\"Knowledge gap analysis failed: {e}\")\n    92→\n    93→        try:\n    94→            summaries = await self.generate_role_summaries(findings, perspectives, query, template)\n    95→            results[\"role_summaries\"] = {s.role: asdict(s) for s in summaries}\n    96→        except Exception as e:\n    97→            logger.warning(f\"Role summary generation failed: {e}\")\n    98→\n    99→        return results\n   100→\n   101→    async def detect_contradictions(\n   102→        self,\n   103→        findings: List[Dict[str, Any]],\n   104→    ) -> List[Contradiction]:\n   105→        \"\"\"\n   106→        Detect contradictions between findings.\n   107→\n   108→        Looks for:\n   109→        - Conflicting facts (A says X, B says not-X)\n   110→        - Quantitative disagreements (A says 40%, B says 77%)\n   111→        - Temporal inconsistencies (A says happened in 2024, B says 2023)\n   112→        - Interpretive conflicts (A says bullish, B says bearish on same data)\n   113→        \"\"\"\n   114→        if len(findings) < 2:\n   115→            return []\n   116→\n   117→        contradictions = []\n   118→\n   119→        # Group findings by topic for efficient comparison\n   120→        # Compare findings pairwise for contradictions\n   121→        for i, finding_a in enumerate(findings):\n   122→            for j, finding_b in enumerate(findings[i + 1:], i + 1):\n   123→                contradiction = self._check_contradiction(finding_a, finding_b)\n   124→                if contradiction:\n   125→                    contradictions.append(contradiction)\n   126→\n   127→        return contradictions\n   128→\n   129→    def _check_contradiction(\n   130→        self,\n   131→        finding_a: Dict[str, Any],\n   132→        finding_b: Dict[str, Any],\n   133→    ) -> Optional[Contradiction]:\n   134→        \"\"\"Check if two findings contradict each other.\"\"\"\n   135→        # Extract content and data\n   136→        content_a = finding_a.get(\"content\", \"\").lower()\n   137→        content_b = finding_b.get(\"content\", \"\").lower()\n   138→        data_a = finding_a.get(\"extracted_data\", {}) or {}\n   139→        data_b = finding_b.get(\"extracted_data\", {}) or {}\n   140→\n   141→        id_a = finding_a.get(\"finding_id\", \"f?\")\n   142→        id_b = finding_b.get(\"finding_id\", \"f?\")\n   143→        summary_a = finding_a.get(\"summary\", content_a[:100])\n   144→        summary_b = finding_b.get(\"summary\", content_b[:100])\n   145→\n   146→        # Check for quantitative contradictions\n   147→        quant_contradiction = self._check_quantitative_contradiction(data_a, data_b, finding_a, finding_b)\n   148→        if quant_contradiction:\n   149→            return Contradiction(\n   150→                finding_a_id=id_a,\n   151→                finding_a_summary=summary_a,\n   152→                finding_b_id=id_b,\n   153→                finding_b_summary=summary_b,\n   154→                contradiction_type=\"quantitative\",\n   155→                description=quant_contradiction[0],\n   156→                severity=quant_contradiction[1],\n   157→                resolution_hint=quant_contradiction[2],\n   158→            )\n   159→\n   160→        # Check for temporal contradictions\n   161→        temporal_contradiction = self._check_temporal_contradiction(finding_a, finding_b)\n   162→        if temporal_contradiction:\n   163→            return Contradiction(\n   164→                finding_a_id=id_a,\n   165→                finding_a_summary=summary_a,\n   166→                finding_b_id=id_b,\n   167→                finding_b_summary=summary_b,\n   168→                contradiction_type=\"temporal\",\n   169→                description=temporal_contradiction[0],\n   170→                severity=temporal_contradiction[1],\n   171→                resolution_hint=temporal_contradiction[2],\n   172→            )\n   173→\n   174→        # Check for semantic contradictions (opposing sentiment on same topic)\n   175→        semantic_contradiction = self._check_semantic_contradiction(content_a, content_b, data_a, data_b)\n   176→        if semantic_contradiction:\n   177→            return Contradiction(\n   178→                finding_a_id=id_a,\n   179→                finding_a_summary=summary_a,\n   180→                finding_b_id=id_b,\n   181→                finding_b_summary=summary_b,\n   182→                contradiction_type=\"interpretive\",\n   183→                description=semantic_contradiction[0],\n   184→                severity=semantic_contradiction[1],\n   185→                resolution_hint=semantic_contradiction[2],\n   186→            )\n   187→\n   188→        return None\n   189→\n   190→    def _check_quantitative_contradiction(\n   191→        self,\n   192→        data_a: Dict,\n   193→        data_b: Dict,\n   194→        finding_a: Dict,\n   195→        finding_b: Dict,\n   196→    ) -> Optional[Tuple[str, str, str]]:\n   197→        \"\"\"Check for conflicting numbers about the same metric.\"\"\"\n   198→        # Common metrics to check\n   199→        metric_keys = [\n   200→            \"adoption_rate\", \"growth_percentage\", \"market_share\",\n   201→            \"revenue\", \"subscribers\", \"users\", \"amount\", \"value\",\n   202→            \"growth\", \"rate\", \"percentage\"\n   203→        ]\n   204→\n   205→        for key in metric_keys:\n   206→            val_a = data_a.get(key)\n   207→            val_b = data_b.get(key)\n   208→\n   209→            if val_a and val_b:\n   210→                # Extract numeric values\n   211→                num_a = self._extract_number(str(val_a))\n   212→                num_b = self._extract_number(str(val_b))\n   213→\n   214→                if num_a is not None and num_b is not None:\n   215→                    # Check if they're about the same entity\n   216→                    entity_a = data_a.get(\"technology\") or data_a.get(\"company\") or data_a.get(\"product\")\n   217→                    entity_b = data_b.get(\"technology\") or data_b.get(\"company\") or data_b.get(\"product\")\n   218→\n   219→                    if entity_a and entity_b and entity_a.lower() == entity_b.lower():\n   220→                        # Calculate difference\n   221→                        diff = abs(num_a - num_b)\n   222→                        avg = (num_a + num_b) / 2 if (num_a + num_b) > 0 else 1\n   223→                        pct_diff = (diff / avg) * 100\n   224→\n   225→                        if pct_diff > 30:  # Significant difference\n   226→                            severity = \"high\" if pct_diff > 50 else \"medium\"\n   227→                            return (\n   228→                                f\"Conflicting {key} for {entity_a}: {val_a} vs {val_b} ({pct_diff:.0f}% difference)\",\n   229→                                severity,\n   230→                                f\"Check source dates and methodologies. The difference may be due to different time periods or measurement criteria.\"\n   231→                            )\n   232→\n   233→        return None\n   234→\n   235→    def _check_temporal_contradiction(\n   236→        self,\n   237→        finding_a: Dict,\n   238→        finding_b: Dict,\n   239→    ) -> Optional[Tuple[str, str, str]]:\n   240→        \"\"\"Check for conflicting dates about the same event.\"\"\"\n   241→        date_a = finding_a.get(\"date_referenced\") or finding_a.get(\"event_date\")\n   242→        date_b = finding_b.get(\"date_referenced\") or finding_b.get(\"event_date\")\n   243→\n   244→        if not date_a or not date_b:\n   245→            return None\n   246→\n   247→        # Check if findings are about the same event/topic\n   248→        type_a = finding_a.get(\"finding_type\", \"\")\n   249→        type_b = finding_b.get(\"finding_type\", \"\")\n   250→\n   251→        data_a = finding_a.get(\"extracted_data\", {}) or {}\n   252→        data_b = finding_b.get(\"extracted_data\", {}) or {}\n   253→\n   254→        # Same type and same entity suggests same topic\n   255→        if type_a == type_b:\n   256→            entity_a = data_a.get(\"company\") or data_a.get(\"technology\") or data_a.get(\"product\")\n   257→            entity_b = data_b.get(\"company\") or data_b.get(\"technology\") or data_b.get(\"product\")\n   258→\n   259→            if entity_a and entity_b and entity_a.lower() == entity_b.lower():\n   260→                if date_a != date_b:\n   261→                    return (\n   262→                        f\"Conflicting dates for {entity_a}: {date_a} vs {date_b}\",\n   263→                        \"medium\",\n   264→                        f\"The sources may be referring to different events or updates. Check context.\"\n   265→                    )\n   266→\n   267→        return None\n   268→\n   269→    def _check_semantic_contradiction(\n   270→        self,\n   271→        content_a: str,\n   272→        content_b: str,\n   273→        data_a: Dict,\n   274→        data_b: Dict,\n   275→    ) -> Optional[Tuple[str, str, str]]:\n   276→        \"\"\"Check for opposing interpretations of the same topic.\"\"\"\n   277→        # Look for opposing sentiment indicators\n   278→        bullish_terms = [\"growth\", \"surge\", \"boom\", \"accelerat\", \"outperform\", \"strong\", \"positive\", \"bullish\"]\n   279→        bearish_terms = [\"decline\", \"drop\", \"fall\", \"slow\", \"underperform\", \"weak\", \"negative\", \"bearish\"]\n   280→\n   281→        # Check if about same topic\n   282→        entity_a = data_a.get(\"technology\") or data_a.get(\"company\") or \"\"\n   283→        entity_b = data_b.get(\"technology\") or data_b.get(\"company\") or \"\"\n   284→\n   285→        if entity_a and entity_b and entity_a.lower() == entity_b.lower():\n   286→            has_bullish_a = any(term in content_a for term in bullish_terms)\n   287→            has_bearish_a = any(term in content_a for term in bearish_terms)\n   288→            has_bullish_b = any(term in content_b for term in bullish_terms)\n   289→            has_bearish_b = any(term in content_b for term in bearish_terms)\n   290→\n   291→            # Check for opposing sentiment\n   292→            if (has_bullish_a and has_bearish_b) or (has_bearish_a and has_bullish_b):\n   293→                return (\n   294→                    f\"Conflicting assessments of {entity_a}: one source is optimistic, another pessimistic\",\n   295→                    \"medium\",\n   296→                    f\"Consider both perspectives. The truth may depend on timeframe, market segment, or use case.\"\n   297→                )\n   298→\n   299→        return None\n   300→\n   301→    def _extract_number(self, text: str) -> Optional[float]:\n   302→        \"\"\"Extract a number from text like '77%' or '$1.8M' or '1,000'.\"\"\"\n   303→        import re\n   304→\n   305→        # Remove common formatting\n   306→        text = text.replace(\",\", \"\").replace(\"$\", \"\").replace(\"%\", \"\")\n   307→\n   308→        # Handle M/B/K suffixes\n   309→        multipliers = {\"m\": 1_000_000, \"b\": 1_000_000_000, \"k\": 1_000}\n   310→        for suffix, mult in multipliers.items():\n   311→            if text.lower().endswith(suffix):\n   312→                text = text[:-1]\n   313→                try:\n   314→                    return float(text) * mult\n   315→                except ValueError:\n   316→                    pass\n   317→\n   318→        # Try direct parse\n   319→        match = re.search(r'[\\d.]+', text)\n   320→        if match:\n   321→            try:\n   322→                return float(match.group())\n   323→            except ValueError:\n   324→                pass\n   325→\n   326→        return None\n   327→\n   328→    async def identify_knowledge_gaps(\n   329→        self,\n   330→        findings: List[Dict[str, Any]],\n   331→        perspectives: List[Dict[str, Any]],\n   332→        query: str,\n   333→        template: str,\n   334→    ) -> List[KnowledgeGap]:\n   335→        \"\"\"\n   336→        Identify what we don't know that would affect conclusions.\n   337→\n   338→        Analyzes:\n   339→        - Low-confidence findings that need more data\n   340→        - Topics mentioned but not fully explored\n   341→        - Missing data for key decisions\n   342→        - Unanswered questions from perspectives\n   343→        \"\"\"\n   344→        gaps = []\n   345→        gap_id = 1\n   346→\n   347→        # 1. Find low-confidence findings with high importance\n   348→        for finding in findings:\n   349→            confidence = finding.get(\"adjusted_confidence\") or finding.get(\"confidence_score\", 0.5)\n   350→            finding_type = finding.get(\"finding_type\", \"\")\n   351→\n   352→            # Important types that need high confidence\n   353→            critical_types = [\"prediction\", \"risk_factor\", \"red_flag\", \"earnings_metric\", \"valuation_signal\"]\n   354→\n   355→            if confidence < 0.6 and finding_type in critical_types:\n   356→                summary = finding.get(\"summary\", \"\")[:100]\n   357→                gaps.append(KnowledgeGap(\n   358→                    gap_id=f\"g{gap_id}\",\n   359→                    topic=f\"Uncertain: {finding_type.replace('_', ' ').title()}\",\n   360→                    description=f\"Low confidence ({confidence:.0%}) on critical finding: {summary}\",\n   361→                    importance=\"important\" if finding_type in [\"prediction\", \"earnings_metric\"] else \"critical\",\n   362→                    impact_on_conclusions=\"This uncertainty directly affects key conclusions and recommendations\",\n   363→                    suggested_query=f\"Additional sources for: {summary}\",\n   364→                    related_findings=[finding.get(\"finding_id\", \"\")],\n   365→                ))\n   366→                gap_id += 1\n   367→\n   368→        # 2. Identify gaps from perspective warnings\n   369→        for perspective in perspectives:\n   370→            warnings = perspective.get(\"warnings\", [])\n   371→            perspective_type = perspective.get(\"perspective_type\", \"\")\n   372→\n   373→            for warning in warnings:\n   374→                if any(term in warning.lower() for term in [\"unknown\", \"unclear\", \"missing\", \"need more\", \"no data\"]):\n   375→                    gaps.append(KnowledgeGap(\n   376→                        gap_id=f\"g{gap_id}\",\n   377→                        topic=f\"Expert Concern: {perspective_type.replace('_', ' ').title()}\",\n   378→                        description=warning,\n   379→                        importance=\"important\",\n   380→                        impact_on_conclusions=f\"The {perspective_type.replace('_', ' ')} perspective flagged this uncertainty\",\n   381→                        suggested_query=f\"Research to address: {warning[:80]}\",\n   382→                        related_findings=[],\n   383→                    ))\n   384→                    gap_id += 1\n   385→\n   386→        # 3. Template-specific gap detection\n   387→        template_gaps = self._get_template_specific_gaps(findings, template, query)\n   388→        for gap_info in template_gaps:\n   389→            gaps.append(KnowledgeGap(\n   390→                gap_id=f\"g{gap_id}\",\n   391→                **gap_info\n   392→            ))\n   393→            gap_id += 1\n   394→\n   395→        # 4. Check for missing finding types\n   396→        if template == \"financial\":\n   397→            expected_types = {\"earnings_metric\", \"valuation_signal\", \"risk_factor\", \"guidance\"}\n   398→            found_types = {f.get(\"finding_type\") for f in findings}\n   399→            missing = expected_types - found_types\n   400→\n   401→            if missing:\n   402→                gaps.append(KnowledgeGap(\n   403→                    gap_id=f\"g{gap_id}\",\n   404→                    topic=\"Missing Financial Data\",\n   405→                    description=f\"No findings for: {', '.join(t.replace('_', ' ') for t in missing)}\",\n   406→                    importance=\"critical\",\n   407→                    impact_on_conclusions=\"Investment analysis requires these data points for completeness\",\n   408→                    suggested_query=f\"{query} {' '.join(missing)}\",\n   409→                    related_findings=[],\n   410→                ))\n   411→                gap_id += 1\n   412→\n   413→        elif template == \"tech_market\":\n   414→            expected_types = {\"adoption_trend\", \"prediction\", \"market_metric\"}\n   415→            found_types = {f.get(\"finding_type\") for f in findings}\n   416→            missing = expected_types - found_types\n   417→\n   418→            if missing:\n   419→                gaps.append(KnowledgeGap(\n   420→                    gap_id=f\"g{gap_id}\",\n   421→                    topic=\"Missing Market Data\",\n   422→                    description=f\"No findings for: {', '.join(t.replace('_', ' ') for t in missing)}\",\n   423→                    importance=\"important\",\n   424→                    impact_on_conclusions=\"Market analysis benefits from trend and adoption data\",\n   425→                    suggested_query=f\"{query} market data statistics trends\",\n   426→                    related_findings=[],\n   427→                ))\n   428→                gap_id += 1\n   429→\n   430→        return gaps[:10]  # Limit to top 10 gaps\n   431→\n   432→    def _get_template_specific_gaps(\n   433→        self,\n   434→        findings: List[Dict[str, Any]],\n   435→        template: str,\n   436→        query: str,\n   437→    ) -> List[Dict[str, Any]]:\n   438→        \"\"\"Get template-specific knowledge gaps.\"\"\"\n   439→        gaps = []\n   440→\n   441→        # Check for common gaps based on template\n   442→        if template == \"investigative\":\n   443→            # Check for missing actor relationships\n   444→            has_relationships = any(f.get(\"finding_type\") == \"relationship\" for f in findings)\n   445→            if not has_relationships:\n   446→                gaps.append({\n   447→                    \"topic\": \"Missing Relationship Mapping\",\n   448→                    \"description\": \"No relationship network data found between key actors\",\n   449→                    \"importance\": \"critical\",\n   450→                    \"impact_on_conclusions\": \"Understanding connections is crucial for investigative analysis\",\n   451→                    \"suggested_query\": f\"{query} relationships connections network\",\n   452→                    \"related_findings\": [],\n   453→                })\n   454→\n   455→        elif template == \"competitive\":\n   456→            # Check for pricing data\n   457→            has_pricing = any(\"pricing\" in str(f.get(\"extracted_data\", {})).lower() for f in findings)\n   458→            if not has_pricing:\n   459→                gaps.append({\n   460→                    \"topic\": \"Missing Pricing Comparison\",\n   461→                    \"description\": \"No competitive pricing data available\",\n   462→                    \"importance\": \"important\",\n   463→                    \"impact_on_conclusions\": \"Pricing is key for competitive positioning analysis\",\n   464→                    \"suggested_query\": f\"{query} pricing plans cost comparison\",\n   465→                    \"related_findings\": [],\n   466→                })\n   467→\n   468→        return gaps\n   469→\n   470→    async def generate_role_summaries(\n   471→        self,\n   472→        findings: List[Dict[str, Any]],\n   473→        perspectives: List[Dict[str, Any]],\n   474→        query: str,\n   475→        template: str,\n   476→    ) -> List[RoleSummary]:\n   477→        \"\"\"\n   478→        Generate role-specific summaries for different stakeholders.\n   479→\n   480→        Roles:\n   481→        - CTO: Technical depth, integration effort, team readiness\n   482→        - CFO: Cost analysis, ROI, budget impact\n   483→        - CEO: Strategic fit, competitive position, market timing\n   484→        \"\"\"\n   485→        summaries = []\n   486→\n   487→        # Gather relevant data\n   488→        all_insights = []\n   489→        all_warnings = []\n   490→        all_recommendations = []\n   491→\n   492→        for p in perspectives:\n   493→            all_insights.extend(p.get(\"key_insights\", []))\n   494→            all_warnings.extend(p.get(\"warnings\", []))\n   495→            all_recommendations.extend(p.get(\"recommendations\", []))\n   496→\n   497→        # Calculate overall confidence\n   498→        confidences = [f.get(\"adjusted_confidence\") or f.get(\"confidence_score\", 0.5) for f in findings]\n   499→        avg_confidence = sum(confidences) / len(confidences) if confidences else 0.5\n   500→        confidence_level = \"high\" if avg_confidence >= 0.75 else \"medium\" if avg_confidence >= 0.5 else \"low\"\n   501→\n   502→        # Generate CTO Summary\n   503→        cto_summary = self._generate_cto_summary(findings, all_insights, all_warnings, all_recommendations, template, confidence_level)\n   504→        summaries.append(cto_summary)\n   505→\n   506→        # Generate CFO Summary\n   507→        cfo_summary = self._generate_cfo_summary(findings, all_insights, all_warnings, all_recommendations, template, confidence_level)\n   508→        summaries.append(cfo_summary)\n   509→\n   510→        # Generate CEO Summary\n   511→        ceo_summary = self._generate_ceo_summary(findings, all_insights, all_warnings, all_recommendations, template, confidence_level)\n   512→        summaries.append(ceo_summary)\n   513→\n   514→        return summaries\n   515→\n   516→    def _generate_cto_summary(\n   517→        self,\n   518→        findings: List[Dict],\n   519→        insights: List[str],\n   520→        warnings: List[str],\n   521→        recommendations: List[str],\n   522→        template: str,\n   523→        confidence_level: str,\n   524→    ) -> RoleSummary:\n   525→        \"\"\"Generate CTO-focused summary.\"\"\"\n   526→        # Filter for technical insights\n   527→        tech_keywords = [\"architecture\", \"integration\", \"api\", \"sdk\", \"developer\", \"engineering\", \"technical\",\n   528→                         \"performance\", \"scalability\", \"security\", \"infrastructure\", \"code\", \"implementation\"]\n   529→\n   530→        tech_insights = [i for i in insights if any(kw in i.lower() for kw in tech_keywords)]\n   531→        tech_warnings = [w for w in warnings if any(kw in w.lower() for kw in tech_keywords)]\n   532→        tech_recs = [r for r in recommendations if any(kw in r.lower() for kw in tech_keywords)]\n   533→\n   534→        # Extract technical metrics\n   535→        tech_metrics = []\n   536→        for f in findings:\n   537→            data = f.get(\"extracted_data\", {}) or {}\n   538→            finding_type = f.get(\"finding_type\", \"\")\n   539→\n   540→            if finding_type in [\"product_launch\", \"adoption_trend\", \"enterprise_adoption\"]:\n   541→                if data.get(\"technology\") or data.get(\"product\"):\n   542→                    tech_metrics.append({\n   543→                        \"metric\": data.get(\"technology\") or data.get(\"product\"),\n   544→                        \"value\": data.get(\"adoption_rate\") or data.get(\"growth_percentage\") or \"N/A\",\n   545→                        \"context\": f.get(\"analysis\") or f.get(\"summary\", \"\"),\n   546→                    })\n   547→\n   548→        # Generate headline\n   549→        headline = self._generate_headline(findings, \"technical\", template)\n   550→\n   551→        return RoleSummary(\n   552→            role=\"cto\",\n   553→            role_title=\"Chief Technology Officer\",\n   554→            headline=headline,\n   555→            key_points=tech_insights[:5] if tech_insights else [\"No specific technical insights extracted\"],\n   556→            action_items=[\n   557→                \"Evaluate technical integration requirements\",\n   558→                \"Assess team readiness and skill gaps\",\n   559→                \"Review security and compliance implications\",\n   560→            ] + tech_recs[:2],\n   561→            risks_to_watch=tech_warnings[:3] if tech_warnings else [\"Monitor for breaking changes\"],\n   562→            metrics_of_interest=tech_metrics[:5],\n   563→            confidence_level=confidence_level,\n   564→        )\n   565→\n   566→    def _generate_cfo_summary(\n   567→        self,\n   568→        findings: List[Dict],\n   569→        insights: List[str],\n   570→        warnings: List[str],\n   571→        recommendations: List[str],\n   572→        template: str,\n   573→        confidence_level: str,\n   574→    ) -> RoleSummary:\n   575→        \"\"\"Generate CFO-focused summary.\"\"\"\n   576→        # Filter for financial insights\n   577→        fin_keywords = [\"cost\", \"price\", \"revenue\", \"profit\", \"margin\", \"budget\", \"roi\", \"investment\",\n   578→                        \"valuation\", \"earnings\", \"growth\", \"market\", \"funding\", \"capital\"]\n   579→\n   580→        fin_insights = [i for i in insights if any(kw in i.lower() for kw in fin_keywords)]\n   581→        fin_warnings = [w for w in warnings if any(kw in w.lower() for kw in fin_keywords)]\n   582→        fin_recs = [r for r in recommendations if any(kw in r.lower() for kw in fin_keywords)]\n   583→\n   584→        # Extract financial metrics\n   585→        fin_metrics = []\n   586→        for f in findings:\n   587→            data = f.get(\"extracted_data\", {}) or {}\n   588→            finding_type = f.get(\"finding_type\", \"\")\n   589→\n   590→            if finding_type in [\"funding_round\", \"earnings_metric\", \"market_metric\", \"valuation_signal\"]:\n   591→                metric_name = data.get(\"company\") or data.get(\"metric_name\") or finding_type\n   592→                metric_value = data.get(\"amount\") or data.get(\"revenue\") or data.get(\"value\")\n   593→                if metric_value:\n   594→                    fin_metrics.append({\n   595→                        \"metric\": metric_name,\n   596→                        \"value\": str(metric_value),\n   597→                        \"context\": f.get(\"analysis\") or f.get(\"summary\", \"\"),\n   598→                    })\n   599→\n   600→        # Generate headline\n   601→        headline = self._generate_headline(findings, \"financial\", template)\n   602→\n   603→        return RoleSummary(\n   604→            role=\"cfo\",\n   605→            role_title=\"Chief Financial Officer\",\n   606→            headline=headline,\n   607→            key_points=fin_insights[:5] if fin_insights else [\"No specific financial insights extracted\"],\n   608→            action_items=[\n   609→                \"Evaluate budget implications\",\n   610→                \"Assess ROI and payback period\",\n   611→                \"Review vendor pricing and contracts\",\n   612→            ] + fin_recs[:2],\n   613→            risks_to_watch=fin_warnings[:3] if fin_warnings else [\"Monitor market pricing trends\"],\n   614→            metrics_of_interest=fin_metrics[:5],\n   615→            confidence_level=confidence_level,\n   616→        )\n   617→\n   618→    def _generate_ceo_summary(\n   619→        self,\n   620→        findings: List[Dict],\n   621→        insights: List[str],\n   622→        warnings: List[str],\n   623→        recommendations: List[str],\n   624→        template: str,\n   625→        confidence_level: str,\n   626→    ) -> RoleSummary:\n   627→        \"\"\"Generate CEO-focused summary.\"\"\"\n   628→        # Filter for strategic insights\n   629→        strat_keywords = [\"strategy\", \"competitive\", \"market\", \"position\", \"opportunity\", \"threat\",\n   630→                          \"acquisition\", \"partnership\", \"leadership\", \"trend\", \"industry\", \"future\"]\n   631→\n   632→        strat_insights = [i for i in insights if any(kw in i.lower() for kw in strat_keywords)]\n   633→        strat_warnings = [w for w in warnings if any(kw in w.lower() for kw in strat_keywords)]\n   634→        strat_recs = [r for r in recommendations if any(kw in r.lower() for kw in strat_keywords)]\n   635→\n   636→        # Extract strategic metrics\n   637→        strat_metrics = []\n   638→        for f in findings:\n   639→            data = f.get(\"extracted_data\", {}) or {}\n   640→            finding_type = f.get(\"finding_type\", \"\")\n   641→\n   642→            if finding_type in [\"acquisition\", \"prediction\", \"market_metric\", \"adoption_trend\"]:\n   643→                metric_name = data.get(\"company\") or data.get(\"technology\") or finding_type\n   644→                metric_value = data.get(\"market_share\") or data.get(\"adoption_rate\") or data.get(\"growth_percentage\")\n   645→                if metric_value:\n   646→                    strat_metrics.append({\n   647→                        \"metric\": metric_name,\n   648→                        \"value\": str(metric_value),\n   649→                        \"context\": f.get(\"analysis\") or f.get(\"summary\", \"\"),\n   650→                    })\n   651→\n   652→        # Generate headline\n   653→        headline = self._generate_headline(findings, \"strategic\", template)\n   654→\n   655→        return RoleSummary(\n   656→            role=\"ceo\",\n   657→            role_title=\"Chief Executive Officer\",\n   658→            headline=headline,\n   659→            key_points=strat_insights[:5] if strat_insights else [\"No specific strategic insights extracted\"],\n   660→            action_items=[\n   661→                \"Evaluate strategic fit with company direction\",\n   662→                \"Assess competitive implications\",\n   663→                \"Consider market timing for action\",\n   664→            ] + strat_recs[:2],\n   665→            risks_to_watch=strat_warnings[:3] if strat_warnings else [\"Monitor competitive landscape changes\"],\n   666→            metrics_of_interest=strat_metrics[:5],\n   667→            confidence_level=confidence_level,\n   668→        )\n   669→\n   670→    def _generate_headline(\n   671→        self,\n   672→        findings: List[Dict],\n   673→        focus: str,\n   674→        template: str,\n   675→    ) -> str:\n   676→        \"\"\"Generate a headline for the role summary.\"\"\"\n   677→        # Count finding types\n   678→        prediction_count = sum(1 for f in findings if f.get(\"finding_type\") == \"prediction\")\n   679→        high_conf_count = sum(1 for f in findings if (f.get(\"adjusted_confidence\") or f.get(\"confidence_score\", 0)) >= 0.8)\n   680→\n   681→        if focus == \"technical\":\n   682→            if template == \"tech_market\":\n   683→                return f\"Technology landscape analysis with {len(findings)} key findings, {high_conf_count} high-confidence\"\n   684→            return f\"Technical assessment across {len(findings)} findings\"\n   685→\n   686→        elif focus == \"financial\":\n   687→            if template == \"financial\":\n   688→                return f\"Financial analysis: {len(findings)} data points, {high_conf_count} verified\"\n   689→            return f\"Budget and ROI considerations from {len(findings)} findings\"\n   690→\n   691→        else:  # strategic\n   692→            if prediction_count > 0:\n   693→                return f\"Strategic outlook with {prediction_count} predictions across {len(findings)} findings\"\n   694→            return f\"Strategic assessment: {len(findings)} findings, {high_conf_count} high-confidence\"\n   695→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"063d9692-0974-4418-8890-3933b0ef315a","uuid":"5c556a74-6075-4fe4-91c2-6cbda43fe2fb","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\actor\\src\\services\\intelligence.py","content":"\"\"\"Intelligence analysis service for enhanced insights.\n\nProvides:\n- Contradiction detection across findings\n- Knowledge gaps analysis (\"What We Don't Know\")\n- Role-specific executive summaries (CTO, CFO, CEO views)\n\"\"\"\n\nimport logging\nfrom typing import List, Dict, Any, Optional, Tuple\nfrom dataclasses import dataclass, asdict\n\nlogger = logging.getLogger(__name__)\n\n\n@dataclass\nclass Contradiction:\n    \"\"\"A detected contradiction between findings.\"\"\"\n    finding_a_id: str\n    finding_a_summary: str\n    finding_b_id: str\n    finding_b_summary: str\n    contradiction_type: str  # factual, temporal, quantitative, interpretive\n    description: str\n    severity: str  # high, medium, low\n    resolution_hint: str\n\n\n@dataclass\nclass KnowledgeGap:\n    \"\"\"A gap in the research that affects conclusions.\"\"\"\n    gap_id: str\n    topic: str\n    description: str\n    importance: str  # critical, important, nice_to_have\n    impact_on_conclusions: str\n    suggested_query: str\n    related_findings: List[str]\n\n\n@dataclass\nclass RoleSummary:\n    \"\"\"Role-specific summary for a stakeholder type.\"\"\"\n    role: str  # cto, cfo, ceo, legal, product\n    role_title: str\n    headline: str\n    key_points: List[str]\n    action_items: List[str]\n    risks_to_watch: List[str]\n    metrics_of_interest: List[Dict[str, Any]]\n    confidence_level: str  # high, medium, low\n\n\nclass IntelligenceAnalyzer:\n    \"\"\"Analyzes findings for deeper insights.\"\"\"\n\n    def __init__(self, gemini_client=None):\n        self.gemini_client = gemini_client\n\n    async def analyze(\n        self,\n        findings: List[Dict[str, Any]],\n        perspectives: List[Dict[str, Any]],\n        sources: List[Dict[str, Any]],\n        query: str,\n        template: str,\n    ) -> Dict[str, Any]:\n        \"\"\"\n        Run full intelligence analysis on research results.\n\n        Returns:\n            Dict with 'contradictions', 'knowledge_gaps', 'role_summaries'\n        \"\"\"\n        results = {\n            \"contradictions\": [],\n            \"knowledge_gaps\": [],\n            \"role_summaries\": {},\n        }\n\n        # Run analyses\n        try:\n            contradictions = await self.detect_contradictions(findings)\n            results[\"contradictions\"] = [asdict(c) for c in contradictions]\n        except Exception as e:\n            logger.warning(f\"Contradiction detection failed: {e}\")\n\n        try:\n            gaps = await self.identify_knowledge_gaps(findings, perspectives, query, template)\n            results[\"knowledge_gaps\"] = [asdict(g) for g in gaps]\n        except Exception as e:\n            logger.warning(f\"Knowledge gap analysis failed: {e}\")\n\n        try:\n            summaries = await self.generate_role_summaries(findings, perspectives, query, template)\n            results[\"role_summaries\"] = {s.role: asdict(s) for s in summaries}\n        except Exception as e:\n            logger.warning(f\"Role summary generation failed: {e}\")\n\n        return results\n\n    async def detect_contradictions(\n        self,\n        findings: List[Dict[str, Any]],\n    ) -> List[Contradiction]:\n        \"\"\"\n        Detect contradictions between findings.\n\n        Looks for:\n        - Conflicting facts (A says X, B says not-X)\n        - Quantitative disagreements (A says 40%, B says 77%)\n        - Temporal inconsistencies (A says happened in 2024, B says 2023)\n        - Interpretive conflicts (A says bullish, B says bearish on same data)\n        \"\"\"\n        if len(findings) < 2:\n            return []\n\n        contradictions = []\n\n        # Group findings by topic for efficient comparison\n        # Compare findings pairwise for contradictions\n        for i, finding_a in enumerate(findings):\n            for j, finding_b in enumerate(findings[i + 1:], i + 1):\n                contradiction = self._check_contradiction(finding_a, finding_b)\n                if contradiction:\n                    contradictions.append(contradiction)\n\n        return contradictions\n\n    def _check_contradiction(\n        self,\n        finding_a: Dict[str, Any],\n        finding_b: Dict[str, Any],\n    ) -> Optional[Contradiction]:\n        \"\"\"Check if two findings contradict each other.\"\"\"\n        # Extract content and data\n        content_a = finding_a.get(\"content\", \"\").lower()\n        content_b = finding_b.get(\"content\", \"\").lower()\n        data_a = finding_a.get(\"extracted_data\", {}) or {}\n        data_b = finding_b.get(\"extracted_data\", {}) or {}\n\n        id_a = finding_a.get(\"finding_id\", \"f?\")\n        id_b = finding_b.get(\"finding_id\", \"f?\")\n        summary_a = finding_a.get(\"summary\", content_a[:100])\n        summary_b = finding_b.get(\"summary\", content_b[:100])\n\n        # Check for quantitative contradictions\n        quant_contradiction = self._check_quantitative_contradiction(data_a, data_b, finding_a, finding_b)\n        if quant_contradiction:\n            return Contradiction(\n                finding_a_id=id_a,\n                finding_a_summary=summary_a,\n                finding_b_id=id_b,\n                finding_b_summary=summary_b,\n                contradiction_type=\"quantitative\",\n                description=quant_contradiction[0],\n                severity=quant_contradiction[1],\n                resolution_hint=quant_contradiction[2],\n            )\n\n        # Check for temporal contradictions\n        temporal_contradiction = self._check_temporal_contradiction(finding_a, finding_b)\n        if temporal_contradiction:\n            return Contradiction(\n                finding_a_id=id_a,\n                finding_a_summary=summary_a,\n                finding_b_id=id_b,\n                finding_b_summary=summary_b,\n                contradiction_type=\"temporal\",\n                description=temporal_contradiction[0],\n                severity=temporal_contradiction[1],\n                resolution_hint=temporal_contradiction[2],\n            )\n\n        # Check for semantic contradictions (opposing sentiment on same topic)\n        semantic_contradiction = self._check_semantic_contradiction(content_a, content_b, data_a, data_b)\n        if semantic_contradiction:\n            return Contradiction(\n                finding_a_id=id_a,\n                finding_a_summary=summary_a,\n                finding_b_id=id_b,\n                finding_b_summary=summary_b,\n                contradiction_type=\"interpretive\",\n                description=semantic_contradiction[0],\n                severity=semantic_contradiction[1],\n                resolution_hint=semantic_contradiction[2],\n            )\n\n        return None\n\n    def _check_quantitative_contradiction(\n        self,\n        data_a: Dict,\n        data_b: Dict,\n        finding_a: Dict,\n        finding_b: Dict,\n    ) -> Optional[Tuple[str, str, str]]:\n        \"\"\"Check for conflicting numbers about the same metric.\"\"\"\n        # Common metrics to check\n        metric_keys = [\n            \"adoption_rate\", \"growth_percentage\", \"market_share\",\n            \"revenue\", \"subscribers\", \"users\", \"amount\", \"value\",\n            \"growth\", \"rate\", \"percentage\"\n        ]\n\n        for key in metric_keys:\n            val_a = data_a.get(key)\n            val_b = data_b.get(key)\n\n            if val_a and val_b:\n                # Extract numeric values\n                num_a = self._extract_number(str(val_a))\n                num_b = self._extract_number(str(val_b))\n\n                if num_a is not None and num_b is not None:\n                    # Check if they're about the same entity\n                    entity_a = data_a.get(\"technology\") or data_a.get(\"company\") or data_a.get(\"product\")\n                    entity_b = data_b.get(\"technology\") or data_b.get(\"company\") or data_b.get(\"product\")\n\n                    if entity_a and entity_b and entity_a.lower() == entity_b.lower():\n                        # Calculate difference\n                        diff = abs(num_a - num_b)\n                        avg = (num_a + num_b) / 2 if (num_a + num_b) > 0 else 1\n                        pct_diff = (diff / avg) * 100\n\n                        if pct_diff > 30:  # Significant difference\n                            severity = \"high\" if pct_diff > 50 else \"medium\"\n                            return (\n                                f\"Conflicting {key} for {entity_a}: {val_a} vs {val_b} ({pct_diff:.0f}% difference)\",\n                                severity,\n                                f\"Check source dates and methodologies. The difference may be due to different time periods or measurement criteria.\"\n                            )\n\n        return None\n\n    def _check_temporal_contradiction(\n        self,\n        finding_a: Dict,\n        finding_b: Dict,\n    ) -> Optional[Tuple[str, str, str]]:\n        \"\"\"Check for conflicting dates about the same event.\"\"\"\n        date_a = finding_a.get(\"date_referenced\") or finding_a.get(\"event_date\")\n        date_b = finding_b.get(\"date_referenced\") or finding_b.get(\"event_date\")\n\n        if not date_a or not date_b:\n            return None\n\n        # Check if findings are about the same event/topic\n        type_a = finding_a.get(\"finding_type\", \"\")\n        type_b = finding_b.get(\"finding_type\", \"\")\n\n        data_a = finding_a.get(\"extracted_data\", {}) or {}\n        data_b = finding_b.get(\"extracted_data\", {}) or {}\n\n        # Same type and same entity suggests same topic\n        if type_a == type_b:\n            entity_a = data_a.get(\"company\") or data_a.get(\"technology\") or data_a.get(\"product\")\n            entity_b = data_b.get(\"company\") or data_b.get(\"technology\") or data_b.get(\"product\")\n\n            if entity_a and entity_b and entity_a.lower() == entity_b.lower():\n                if date_a != date_b:\n                    return (\n                        f\"Conflicting dates for {entity_a}: {date_a} vs {date_b}\",\n                        \"medium\",\n                        f\"The sources may be referring to different events or updates. Check context.\"\n                    )\n\n        return None\n\n    def _check_semantic_contradiction(\n        self,\n        content_a: str,\n        content_b: str,\n        data_a: Dict,\n        data_b: Dict,\n    ) -> Optional[Tuple[str, str, str]]:\n        \"\"\"Check for opposing interpretations of the same topic.\"\"\"\n        # Look for opposing sentiment indicators\n        bullish_terms = [\"growth\", \"surge\", \"boom\", \"accelerat\", \"outperform\", \"strong\", \"positive\", \"bullish\"]\n        bearish_terms = [\"decline\", \"drop\", \"fall\", \"slow\", \"underperform\", \"weak\", \"negative\", \"bearish\"]\n\n        # Check if about same topic\n        entity_a = data_a.get(\"technology\") or data_a.get(\"company\") or \"\"\n        entity_b = data_b.get(\"technology\") or data_b.get(\"company\") or \"\"\n\n        if entity_a and entity_b and entity_a.lower() == entity_b.lower():\n            has_bullish_a = any(term in content_a for term in bullish_terms)\n            has_bearish_a = any(term in content_a for term in bearish_terms)\n            has_bullish_b = any(term in content_b for term in bullish_terms)\n            has_bearish_b = any(term in content_b for term in bearish_terms)\n\n            # Check for opposing sentiment\n            if (has_bullish_a and has_bearish_b) or (has_bearish_a and has_bullish_b):\n                return (\n                    f\"Conflicting assessments of {entity_a}: one source is optimistic, another pessimistic\",\n                    \"medium\",\n                    f\"Consider both perspectives. The truth may depend on timeframe, market segment, or use case.\"\n                )\n\n        return None\n\n    def _extract_number(self, text: str) -> Optional[float]:\n        \"\"\"Extract a number from text like '77%' or '$1.8M' or '1,000'.\"\"\"\n        import re\n\n        # Remove common formatting\n        text = text.replace(\",\", \"\").replace(\"$\", \"\").replace(\"%\", \"\")\n\n        # Handle M/B/K suffixes\n        multipliers = {\"m\": 1_000_000, \"b\": 1_000_000_000, \"k\": 1_000}\n        for suffix, mult in multipliers.items():\n            if text.lower().endswith(suffix):\n                text = text[:-1]\n                try:\n                    return float(text) * mult\n                except ValueError:\n                    pass\n\n        # Try direct parse\n        match = re.search(r'[\\d.]+', text)\n        if match:\n            try:\n                return float(match.group())\n            except ValueError:\n                pass\n\n        return None\n\n    async def identify_knowledge_gaps(\n        self,\n        findings: List[Dict[str, Any]],\n        perspectives: List[Dict[str, Any]],\n        query: str,\n        template: str,\n    ) -> List[KnowledgeGap]:\n        \"\"\"\n        Identify what we don't know that would affect conclusions.\n\n        Analyzes:\n        - Low-confidence findings that need more data\n        - Topics mentioned but not fully explored\n        - Missing data for key decisions\n        - Unanswered questions from perspectives\n        \"\"\"\n        gaps = []\n        gap_id = 1\n\n        # 1. Find low-confidence findings with high importance\n        for finding in findings:\n            confidence = finding.get(\"adjusted_confidence\") or finding.get(\"confidence_score\", 0.5)\n            finding_type = finding.get(\"finding_type\", \"\")\n\n            # Important types that need high confidence\n            critical_types = [\"prediction\", \"risk_factor\", \"red_flag\", \"earnings_metric\", \"valuation_signal\"]\n\n            if confidence < 0.6 and finding_type in critical_types:\n                summary = finding.get(\"summary\", \"\")[:100]\n                gaps.append(KnowledgeGap(\n                    gap_id=f\"g{gap_id}\",\n                    topic=f\"Uncertain: {finding_type.replace('_', ' ').title()}\",\n                    description=f\"Low confidence ({confidence:.0%}) on critical finding: {summary}\",\n                    importance=\"important\" if finding_type in [\"prediction\", \"earnings_metric\"] else \"critical\",\n                    impact_on_conclusions=\"This uncertainty directly affects key conclusions and recommendations\",\n                    suggested_query=f\"Additional sources for: {summary}\",\n                    related_findings=[finding.get(\"finding_id\", \"\")],\n                ))\n                gap_id += 1\n\n        # 2. Identify gaps from perspective warnings\n        for perspective in perspectives:\n            warnings = perspective.get(\"warnings\", [])\n            perspective_type = perspective.get(\"perspective_type\", \"\")\n\n            for warning in warnings:\n                if any(term in warning.lower() for term in [\"unknown\", \"unclear\", \"missing\", \"need more\", \"no data\"]):\n                    gaps.append(KnowledgeGap(\n                        gap_id=f\"g{gap_id}\",\n                        topic=f\"Expert Concern: {perspective_type.replace('_', ' ').title()}\",\n                        description=warning,\n                        importance=\"important\",\n                        impact_on_conclusions=f\"The {perspective_type.replace('_', ' ')} perspective flagged this uncertainty\",\n                        suggested_query=f\"Research to address: {warning[:80]}\",\n                        related_findings=[],\n                    ))\n                    gap_id += 1\n\n        # 3. Template-specific gap detection\n        template_gaps = self._get_template_specific_gaps(findings, template, query)\n        for gap_info in template_gaps:\n            gaps.append(KnowledgeGap(\n                gap_id=f\"g{gap_id}\",\n                **gap_info\n            ))\n            gap_id += 1\n\n        # 4. Check for missing finding types\n        if template == \"financial\":\n            expected_types = {\"earnings_metric\", \"valuation_signal\", \"risk_factor\", \"guidance\"}\n            found_types = {f.get(\"finding_type\") for f in findings}\n            missing = expected_types - found_types\n\n            if missing:\n                gaps.append(KnowledgeGap(\n                    gap_id=f\"g{gap_id}\",\n                    topic=\"Missing Financial Data\",\n                    description=f\"No findings for: {', '.join(t.replace('_', ' ') for t in missing)}\",\n                    importance=\"critical\",\n                    impact_on_conclusions=\"Investment analysis requires these data points for completeness\",\n                    suggested_query=f\"{query} {' '.join(missing)}\",\n                    related_findings=[],\n                ))\n                gap_id += 1\n\n        elif template == \"tech_market\":\n            expected_types = {\"adoption_trend\", \"prediction\", \"market_metric\"}\n            found_types = {f.get(\"finding_type\") for f in findings}\n            missing = expected_types - found_types\n\n            if missing:\n                gaps.append(KnowledgeGap(\n                    gap_id=f\"g{gap_id}\",\n                    topic=\"Missing Market Data\",\n                    description=f\"No findings for: {', '.join(t.replace('_', ' ') for t in missing)}\",\n                    importance=\"important\",\n                    impact_on_conclusions=\"Market analysis benefits from trend and adoption data\",\n                    suggested_query=f\"{query} market data statistics trends\",\n                    related_findings=[],\n                ))\n                gap_id += 1\n\n        return gaps[:10]  # Limit to top 10 gaps\n\n    def _get_template_specific_gaps(\n        self,\n        findings: List[Dict[str, Any]],\n        template: str,\n        query: str,\n    ) -> List[Dict[str, Any]]:\n        \"\"\"Get template-specific knowledge gaps.\"\"\"\n        gaps = []\n\n        # Check for common gaps based on template\n        if template == \"investigative\":\n            # Check for missing actor relationships\n            has_relationships = any(f.get(\"finding_type\") == \"relationship\" for f in findings)\n            if not has_relationships:\n                gaps.append({\n                    \"topic\": \"Missing Relationship Mapping\",\n                    \"description\": \"No relationship network data found between key actors\",\n                    \"importance\": \"critical\",\n                    \"impact_on_conclusions\": \"Understanding connections is crucial for investigative analysis\",\n                    \"suggested_query\": f\"{query} relationships connections network\",\n                    \"related_findings\": [],\n                })\n\n        elif template == \"competitive\":\n            # Check for pricing data\n            has_pricing = any(\"pricing\" in str(f.get(\"extracted_data\", {})).lower() for f in findings)\n            if not has_pricing:\n                gaps.append({\n                    \"topic\": \"Missing Pricing Comparison\",\n                    \"description\": \"No competitive pricing data available\",\n                    \"importance\": \"important\",\n                    \"impact_on_conclusions\": \"Pricing is key for competitive positioning analysis\",\n                    \"suggested_query\": f\"{query} pricing plans cost comparison\",\n                    \"related_findings\": [],\n                })\n\n        return gaps\n\n    async def generate_role_summaries(\n        self,\n        findings: List[Dict[str, Any]],\n        perspectives: List[Dict[str, Any]],\n        query: str,\n        template: str,\n    ) -> List[RoleSummary]:\n        \"\"\"\n        Generate role-specific summaries for different stakeholders.\n\n        Roles:\n        - CTO: Technical depth, integration effort, team readiness\n        - CFO: Cost analysis, ROI, budget impact\n        - CEO: Strategic fit, competitive position, market timing\n        \"\"\"\n        summaries = []\n\n        # Gather relevant data\n        all_insights = []\n        all_warnings = []\n        all_recommendations = []\n\n        for p in perspectives:\n            all_insights.extend(p.get(\"key_insights\", []))\n            all_warnings.extend(p.get(\"warnings\", []))\n            all_recommendations.extend(p.get(\"recommendations\", []))\n\n        # Calculate overall confidence\n        confidences = [f.get(\"adjusted_confidence\") or f.get(\"confidence_score\", 0.5) for f in findings]\n        avg_confidence = sum(confidences) / len(confidences) if confidences else 0.5\n        confidence_level = \"high\" if avg_confidence >= 0.75 else \"medium\" if avg_confidence >= 0.5 else \"low\"\n\n        # Generate CTO Summary\n        cto_summary = self._generate_cto_summary(findings, all_insights, all_warnings, all_recommendations, template, confidence_level)\n        summaries.append(cto_summary)\n\n        # Generate CFO Summary\n        cfo_summary = self._generate_cfo_summary(findings, all_insights, all_warnings, all_recommendations, template, confidence_level)\n        summaries.append(cfo_summary)\n\n        # Generate CEO Summary\n        ceo_summary = self._generate_ceo_summary(findings, all_insights, all_warnings, all_recommendations, template, confidence_level)\n        summaries.append(ceo_summary)\n\n        return summaries\n\n    def _generate_cto_summary(\n        self,\n        findings: List[Dict],\n        insights: List[str],\n        warnings: List[str],\n        recommendations: List[str],\n        template: str,\n        confidence_level: str,\n    ) -> RoleSummary:\n        \"\"\"Generate CTO-focused summary.\"\"\"\n        # Filter for technical insights\n        tech_keywords = [\"architecture\", \"integration\", \"api\", \"sdk\", \"developer\", \"engineering\", \"technical\",\n                         \"performance\", \"scalability\", \"security\", \"infrastructure\", \"code\", \"implementation\"]\n\n        tech_insights = [i for i in insights if any(kw in i.lower() for kw in tech_keywords)]\n        tech_warnings = [w for w in warnings if any(kw in w.lower() for kw in tech_keywords)]\n        tech_recs = [r for r in recommendations if any(kw in r.lower() for kw in tech_keywords)]\n\n        # Extract technical metrics\n        tech_metrics = []\n        for f in findings:\n            data = f.get(\"extracted_data\", {}) or {}\n            finding_type = f.get(\"finding_type\", \"\")\n\n            if finding_type in [\"product_launch\", \"adoption_trend\", \"enterprise_adoption\"]:\n                if data.get(\"technology\") or data.get(\"product\"):\n                    tech_metrics.append({\n                        \"metric\": data.get(\"technology\") or data.get(\"product\"),\n                        \"value\": data.get(\"adoption_rate\") or data.get(\"growth_percentage\") or \"N/A\",\n                        \"context\": f.get(\"analysis\") or f.get(\"summary\", \"\"),\n                    })\n\n        # Generate headline\n        headline = self._generate_headline(findings, \"technical\", template)\n\n        return RoleSummary(\n            role=\"cto\",\n            role_title=\"Chief Technology Officer\",\n            headline=headline,\n            key_points=tech_insights[:5] if tech_insights else [\"No specific technical insights extracted\"],\n            action_items=[\n                \"Evaluate technical integration requirements\",\n                \"Assess team readiness and skill gaps\",\n                \"Review security and compliance implications\",\n            ] + tech_recs[:2],\n            risks_to_watch=tech_warnings[:3] if tech_warnings else [\"Monitor for breaking changes\"],\n            metrics_of_interest=tech_metrics[:5],\n            confidence_level=confidence_level,\n        )\n\n    def _generate_cfo_summary(\n        self,\n        findings: List[Dict],\n        insights: List[str],\n        warnings: List[str],\n        recommendations: List[str],\n        template: str,\n        confidence_level: str,\n    ) -> RoleSummary:\n        \"\"\"Generate CFO-focused summary.\"\"\"\n        # Filter for financial insights\n        fin_keywords = [\"cost\", \"price\", \"revenue\", \"profit\", \"margin\", \"budget\", \"roi\", \"investment\",\n                        \"valuation\", \"earnings\", \"growth\", \"market\", \"funding\", \"capital\"]\n\n        fin_insights = [i for i in insights if any(kw in i.lower() for kw in fin_keywords)]\n        fin_warnings = [w for w in warnings if any(kw in w.lower() for kw in fin_keywords)]\n        fin_recs = [r for r in recommendations if any(kw in r.lower() for kw in fin_keywords)]\n\n        # Extract financial metrics\n        fin_metrics = []\n        for f in findings:\n            data = f.get(\"extracted_data\", {}) or {}\n            finding_type = f.get(\"finding_type\", \"\")\n\n            if finding_type in [\"funding_round\", \"earnings_metric\", \"market_metric\", \"valuation_signal\"]:\n                metric_name = data.get(\"company\") or data.get(\"metric_name\") or finding_type\n                metric_value = data.get(\"amount\") or data.get(\"revenue\") or data.get(\"value\")\n                if metric_value:\n                    fin_metrics.append({\n                        \"metric\": metric_name,\n                        \"value\": str(metric_value),\n                        \"context\": f.get(\"analysis\") or f.get(\"summary\", \"\"),\n                    })\n\n        # Generate headline\n        headline = self._generate_headline(findings, \"financial\", template)\n\n        return RoleSummary(\n            role=\"cfo\",\n            role_title=\"Chief Financial Officer\",\n            headline=headline,\n            key_points=fin_insights[:5] if fin_insights else [\"No specific financial insights extracted\"],\n            action_items=[\n                \"Evaluate budget implications\",\n                \"Assess ROI and payback period\",\n                \"Review vendor pricing and contracts\",\n            ] + fin_recs[:2],\n            risks_to_watch=fin_warnings[:3] if fin_warnings else [\"Monitor market pricing trends\"],\n            metrics_of_interest=fin_metrics[:5],\n            confidence_level=confidence_level,\n        )\n\n    def _generate_ceo_summary(\n        self,\n        findings: List[Dict],\n        insights: List[str],\n        warnings: List[str],\n        recommendations: List[str],\n        template: str,\n        confidence_level: str,\n    ) -> RoleSummary:\n        \"\"\"Generate CEO-focused summary.\"\"\"\n        # Filter for strategic insights\n        strat_keywords = [\"strategy\", \"competitive\", \"market\", \"position\", \"opportunity\", \"threat\",\n                          \"acquisition\", \"partnership\", \"leadership\", \"trend\", \"industry\", \"future\"]\n\n        strat_insights = [i for i in insights if any(kw in i.lower() for kw in strat_keywords)]\n        strat_warnings = [w for w in warnings if any(kw in w.lower() for kw in strat_keywords)]\n        strat_recs = [r for r in recommendations if any(kw in r.lower() for kw in strat_keywords)]\n\n        # Extract strategic metrics\n        strat_metrics = []\n        for f in findings:\n            data = f.get(\"extracted_data\", {}) or {}\n            finding_type = f.get(\"finding_type\", \"\")\n\n            if finding_type in [\"acquisition\", \"prediction\", \"market_metric\", \"adoption_trend\"]:\n                metric_name = data.get(\"company\") or data.get(\"technology\") or finding_type\n                metric_value = data.get(\"market_share\") or data.get(\"adoption_rate\") or data.get(\"growth_percentage\")\n                if metric_value:\n                    strat_metrics.append({\n                        \"metric\": metric_name,\n                        \"value\": str(metric_value),\n                        \"context\": f.get(\"analysis\") or f.get(\"summary\", \"\"),\n
[2026-01-30T14:28:01.644Z] [STDOUT] })\n\n        # Generate headline\n        headline = self._generate_headline(findings, \"strategic\", template)\n\n        return RoleSummary(\n            role=\"ceo\",\n            role_title=\"Chief Executive Officer\",\n            headline=headline,\n            key_points=strat_insights[:5] if strat_insights else [\"No specific strategic insights extracted\"],\n            action_items=[\n                \"Evaluate strategic fit with company direction\",\n                \"Assess competitive implications\",\n                \"Consider market timing for action\",\n            ] + strat_recs[:2],\n            risks_to_watch=strat_warnings[:3] if strat_warnings else [\"Monitor competitive landscape changes\"],\n            metrics_of_interest=strat_metrics[:5],\n            confidence_level=confidence_level,\n        )\n\n    def _generate_headline(\n        self,\n        findings: List[Dict],\n        focus: str,\n        template: str,\n    ) -> str:\n        \"\"\"Generate a headline for the role summary.\"\"\"\n        # Count finding types\n        prediction_count = sum(1 for f in findings if f.get(\"finding_type\") == \"prediction\")\n        high_conf_count = sum(1 for f in findings if (f.get(\"adjusted_confidence\") or f.get(\"confidence_score\", 0)) >= 0.8)\n\n        if focus == \"technical\":\n            if template == \"tech_market\":\n                return f\"Technology landscape analysis with {len(findings)} key findings, {high_conf_count} high-confidence\"\n            return f\"Technical assessment across {len(findings)} findings\"\n\n        elif focus == \"financial\":\n            if template == \"financial\":\n                return f\"Financial analysis: {len(findings)} data points, {high_conf_count} verified\"\n            return f\"Budget and ROI considerations from {len(findings)} findings\"\n\n        else:  # strategic\n            if prediction_count > 0:\n                return f\"Strategic outlook with {prediction_count} predictions across {len(findings)} findings\"\n            return f\"Strategic assessment: {len(findings)} findings, {high_conf_count} high-confidence\"\n","numLines":695,"startLine":1,"totalLines":695}}}
