[2026-01-30T14:25:08.490Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Dk7RX3ZEMCc2VtwHTKSvAF","type":"tool_result","content":"     1→\"\"\"Transform pipeline for typed data transformations.\n     2→\n     3→This module provides a declarative pipeline architecture for converting raw dicts\n     4→to typed Pydantic models with validation and enrichment stages.\n     5→\"\"\"\n     6→\n     7→from typing import Any, Callable, Dict, Generic, List, Optional, Type, TypeVar, Union\n     8→from dataclasses import dataclass, field\n     9→from pydantic import BaseModel\n    10→import logging\n    11→\n    12→from ..schemas import Finding, Source, Perspective, Prediction, CostSummary\n    13→\n    14→logger = logging.getLogger(__name__)\n    15→\n    16→T = TypeVar(\"T\", bound=BaseModel)\n    17→InputType = Dict[str, Any]\n    18→\n    19→\n    20→@dataclass\n    21→class TransformError:\n    22→    \"\"\"Represents an error during transformation.\"\"\"\n    23→\n    24→    stage: str  # converter, validator, enricher\n    25→    field: Optional[str] = None\n    26→    message: str = \"\"\n    27→    original_value: Any = None\n    28→\n    29→\n    30→@dataclass\n    31→class TransformResult(Generic[T]):\n    32→    \"\"\"Result of a transformation pipeline.\"\"\"\n    33→\n    34→    value: Optional[T] = None\n    35→    errors: List[TransformError] = field(default_factory=list)\n    36→\n    37→    @property\n    38→    def success(self) -> bool:\n    39→        return self.value is not None and not self.errors\n    40→\n    41→    @property\n    42→    def has_warnings(self) -> bool:\n    43→        return len(self.errors) > 0 and self.value is not None\n    44→\n    45→\n    46→# Type aliases for pipeline stages\n    47→Converter = Callable[[InputType], Dict[str, Any]]\n    48→Validator = Callable[[Dict[str, Any]], List[TransformError]]\n    49→Enricher = Callable[[Dict[str, Any], Optional[Any]], Dict[str, Any]]\n    50→\n    51→\n    52→class TransformPipeline(Generic[T]):\n    53→    \"\"\"\n    54→    A composable transformation pipeline that converts raw dicts to typed models.\n    55→\n    56→    The pipeline processes data through three stages:\n    57→    1. Converters: Map raw field names/values to model-compatible format\n    58→    2. Validators: Check data integrity and business rules\n    59→    3. Enrichers: Add computed fields or defaults\n    60→\n    61→    Example:\n    62→        pipeline = TransformPipeline(Finding)\n    63→        pipeline.add_converter(finding_converter)\n    64→        pipeline.add_validator(confidence_validator)\n    65→        pipeline.add_enricher(add_finding_id)\n    66→\n    67→        result = pipeline.transform(raw_dict, context={\"index\": 0})\n    68→    \"\"\"\n    69→\n    70→    def __init__(self, model_class: Type[T]):\n    71→        self.model_class = model_class\n    72→        self._converters: List[Converter] = []\n    73→        self._validators: List[Validator] = []\n    74→        self._enrichers: List[Enricher] = []\n    75→\n    76→    def add_converter(self, converter: Converter) -> \"TransformPipeline[T]\":\n    77→        \"\"\"Add a converter stage. Converters are applied in order.\"\"\"\n    78→        self._converters.append(converter)\n    79→        return self\n    80→\n    81→    def add_validator(self, validator: Validator) -> \"TransformPipeline[T]\":\n    82→        \"\"\"Add a validator stage. All validators are run, errors collected.\"\"\"\n    83→        self._validators.append(validator)\n    84→        return self\n    85→\n    86→    def add_enricher(self, enricher: Enricher) -> \"TransformPipeline[T]\":\n    87→        \"\"\"Add an enricher stage. Enrichers are applied in order.\"\"\"\n    88→        self._enrichers.append(enricher)\n    89→        return self\n    90→\n    91→    def transform(self, data: InputType, context: Optional[Any] = None) -> TransformResult[T]:\n    92→        \"\"\"\n    93→        Transform a raw dict through the pipeline.\n    94→\n    95→        Args:\n    96→            data: Raw dictionary to transform\n    97→            context: Optional context passed to enrichers (e.g., index, sources list)\n    98→\n    99→        Returns:\n   100→            TransformResult with the typed model or errors\n   101→        \"\"\"\n   102→        errors: List[TransformError] = []\n   103→        current_data = dict(data)  # Copy to avoid mutation\n   104→\n   105→        # Stage 1: Apply converters\n   106→        for converter in self._converters:\n   107→            try:\n   108→                current_data = converter(current_data)\n   109→            except Exception as e:\n   110→                errors.append(TransformError(\n   111→                    stage=\"converter\",\n   112→                    message=str(e),\n   113→                    original_value=data,\n   114→                ))\n   115→                return TransformResult(value=None, errors=errors)\n   116→\n   117→        # Stage 2: Run validators\n   118→        for validator in self._validators:\n   119→            try:\n   120→                validation_errors = validator(current_data)\n   121→                errors.extend(validation_errors)\n   122→            except Exception as e:\n   123→                errors.append(TransformError(\n   124→                    stage=\"validator\",\n   125→                    message=str(e),\n   126→                ))\n   127→\n   128→        # If validation errors are critical, stop here\n   129→        critical_errors = [e for e in errors if e.stage == \"validator\"]\n   130→        if critical_errors:\n   131→            return TransformResult(value=None, errors=errors)\n   132→\n   133→        # Stage 3: Apply enrichers\n   134→        for enricher in self._enrichers:\n   135→            try:\n   136→                current_data = enricher(current_data, context)\n   137→            except Exception as e:\n   138→                errors.append(TransformError(\n   139→                    stage=\"enricher\",\n   140→                    message=str(e),\n   141→                ))\n   142→\n   143→        # Stage 4: Create model instance\n   144→        try:\n   145→            model_instance = self.model_class(**current_data)\n   146→            return TransformResult(value=model_instance, errors=errors)\n   147→        except Exception as e:\n   148→            errors.append(TransformError(\n   149→                stage=\"model_creation\",\n   150→                message=str(e),\n   151→                original_value=current_data,\n   152→            ))\n   153→            return TransformResult(value=None, errors=errors)\n   154→\n   155→    def transform_many(\n   156→        self,\n   157→        items: List[InputType],\n   158→        context_factory: Optional[Callable[[int, InputType], Any]] = None,\n   159→    ) -> List[T]:\n   160→        \"\"\"\n   161→        Transform a list of items, returning only successful transformations.\n   162→\n   163→        Args:\n   164→            items: List of raw dictionaries\n   165→            context_factory: Optional function to create context for each item (index, item) -> context\n   166→\n   167→        Returns:\n   168→            List of successfully transformed models\n   169→        \"\"\"\n   170→        results = []\n   171→        for i, item in enumerate(items):\n   172→            context = context_factory(i, item) if context_factory else {\"index\": i}\n   173→            result = self.transform(item, context)\n   174→            if result.success:\n   175→                results.append(result.value)\n   176→            elif result.has_warnings:\n   177→                results.append(result.value)\n   178→                for error in result.errors:\n   179→                    logger.warning(f\"Transform warning for item {i}: {error.message}\")\n   180→            else:\n   181→                for error in result.errors:\n   182→                    logger.error(f\"Transform error for item {i}: {error.message}\")\n   183→        return results\n   184→\n   185→\n   186→# ============================================================================\n   187→# Pre-built converters for common transformations\n   188→# ============================================================================\n   189→\n   190→def finding_converter(data: InputType) -> Dict[str, Any]:\n   191→    \"\"\"Convert raw finding dict to Finding-compatible format.\"\"\"\n   192→    return {\n   193→        \"finding_id\": data.get(\"finding_id\", f\"f{data.get('_index', 0)}\"),\n   194→        \"finding_type\": data.get(\"finding_type\", \"fact\"),\n   195→        \"content\": data.get(\"content\", \"\"),\n   196→        \"summary\": data.get(\"summary\"),\n   197→        \"confidence_score\": data.get(\"confidence_score\", 0.5),\n   198→        \"temporal_context\": data.get(\"temporal_context\", \"present\"),\n   199→        \"extracted_data\": data.get(\"extracted_data\"),\n   200→        \"supporting_sources\": data.get(\"supporting_sources\", []),\n   201→        \"date_referenced\": data.get(\"date_referenced\"),\n   202→        \"date_range\": data.get(\"date_range\"),\n   203→    }\n   204→\n   205→\n   206→def source_converter(data: InputType) -> Dict[str, Any]:\n   207→    \"\"\"Convert raw source dict to Source-compatible format.\"\"\"\n   208→    return {\n   209→        \"url\": data.get(\"url\", \"\"),\n   210→        \"title\": data.get(\"title\", \"\"),\n   211→        \"domain\": data.get(\"domain\", \"\"),\n   212→        \"snippet\": data.get(\"snippet\", \"\"),\n   213→        \"source_type\": data.get(\"source_type\", \"web\"),\n   214→        \"credibility_score\": data.get(\"credibility_score\"),\n   215→        \"credibility_label\": data.get(\"credibility_label\"),\n   216→    }\n   217→\n   218→\n   219→def prediction_converter(data: InputType) -> Dict[str, Any]:\n   220→    \"\"\"Convert raw prediction dict or string to Prediction-compatible format.\"\"\"\n   221→    if isinstance(data, str):\n   222→        # Handle old-style string predictions\n   223→        return {\n   224→            \"prediction\": data,\n   225→            \"rationale\": \"Based on research findings\",\n   226→            \"confidence\": \"medium\",\n   227→            \"timeline\": \"2025-2026\",\n   228→            \"supporting_sources\": [],\n   229→        }\n   230→    return {\n   231→        \"prediction\": data.get(\"prediction\", \"\"),\n   232→        \"rationale\": data.get(\"rationale\", \"\"),\n   233→        \"confidence\": data.get(\"confidence\", \"medium\"),\n   234→        \"timeline\": data.get(\"timeline\", \"\"),\n   235→        \"supporting_sources\": data.get(\"supporting_sources\", []),\n   236→    }\n   237→\n   238→\n   239→def perspective_converter(data: InputType) -> Dict[str, Any]:\n   240→    \"\"\"Convert raw perspective dict to Perspective-compatible format (without predictions).\"\"\"\n   241→    return {\n   242→        \"perspective_type\": data.get(\"perspective_type\", \"unknown\"),\n   243→        \"analysis_text\": data.get(\"analysis_text\", \"\"),\n   244→        \"key_insights\": data.get(\"key_insights\", []),\n   245→        \"recommendations\": data.get(\"recommendations\", []),\n   246→        \"warnings\": data.get(\"warnings\", []),\n   247→        \"confidence\": data.get(\"confidence\", 0.5),\n   248→        # predictions handled separately by enricher\n   249→    }\n   250→\n   251→\n   252→def cost_summary_converter(data: InputType) -> Dict[str, Any]:\n   253→    \"\"\"Convert raw cost dict to CostSummary-compatible format.\"\"\"\n   254→    return {\n   255→        \"total_tokens\": data.get(\"total_tokens\", 0),\n   256→        \"input_tokens\": data.get(\"input_tokens\", 0),\n   257→        \"output_tokens\": data.get(\"output_tokens\", 0),\n   258→        \"gemini_cost_usd\": data.get(\"gemini_cost_usd\", 0),\n   259→        \"openrouter_cost_usd\": data.get(\"openrouter_cost_usd\", 0),\n   260→        \"total_cost_usd\": data.get(\"total_cost_usd\", 0),\n   261→    }\n   262→\n   263→\n   264→# ============================================================================\n   265→# Pre-built enrichers\n   266→# ============================================================================\n   267→\n   268→def add_finding_id_enricher(data: Dict[str, Any], context: Optional[Any]) -> Dict[str, Any]:\n   269→    \"\"\"Add finding ID based on index from context.\"\"\"\n   270→    if context and isinstance(context, dict) and \"index\" in context:\n   271→        if not data.get(\"finding_id\") or data[\"finding_id\"].startswith(\"f0\"):\n   272→            data[\"finding_id\"] = f\"f{context['index']}\"\n   273→    return data\n   274→\n   275→\n   276→def add_supporting_sources_enricher(data: Dict[str, Any], context: Optional[Any]) -> Dict[str, Any]:\n   277→    \"\"\"Add supporting sources from context.\"\"\"\n   278→    if context and isinstance(context, dict) and \"sources\" in context:\n   279→        sources = context[\"sources\"]\n   280→        if not data.get(\"supporting_sources\") and sources:\n   281→            data[\"supporting_sources\"] = [\n   282→                {\"url\": s.get(\"url\", s.url if hasattr(s, \"url\") else \"\"),\n   283→                 \"title\": s.get(\"title\", s.title if hasattr(s, \"title\") else \"\")}\n   284→                for s in sources[:3]\n   285→            ]\n   286→    return data\n   287→\n   288→\n   289→def convert_predictions_enricher(data: Dict[str, Any], context: Optional[Any]) -> Dict[str, Any]:\n   290→    \"\"\"Convert raw predictions list to Prediction objects.\"\"\"\n   291→    raw_predictions = data.get(\"_raw_predictions\", data.get(\"predictions\", []))\n   292→\n   293→    if not raw_predictions:\n   294→        data[\"predictions\"] = []\n   295→        return data\n   296→\n   297→    prediction_pipeline = create_prediction_pipeline()\n   298→    converted = []\n   299→\n   300→    for pred in raw_predictions:\n   301→        if isinstance(pred, Prediction):\n   302→            converted.append(pred)\n   303→        elif isinstance(pred, dict):\n   304→            result = prediction_pipeline.transform(pred)\n   305→            if result.success:\n   306→                converted.append(result.value)\n   307→        elif isinstance(pred, str):\n   308→            result = prediction_pipeline.transform(pred)\n   309→            if result.success:\n   310→                converted.append(result.value)\n   311→\n   312→    data[\"predictions\"] = converted\n   313→    # Remove temporary key\n   314→    data.pop(\"_raw_predictions\", None)\n   315→    return data\n   316→\n   317→\n   318→# ============================================================================\n   319→# Pre-built pipelines\n   320→# ============================================================================\n   321→\n   322→def create_finding_pipeline() -> TransformPipeline[Finding]:\n   323→    \"\"\"Create a pipeline for Finding transformations.\"\"\"\n   324→    return (\n   325→        TransformPipeline(Finding)\n   326→        .add_converter(finding_converter)\n   327→        .add_enricher(add_finding_id_enricher)\n   328→    )\n   329→\n   330→\n   331→def create_source_pipeline() -> TransformPipeline[Source]:\n   332→    \"\"\"Create a pipeline for Source transformations.\"\"\"\n   333→    return (\n   334→        TransformPipeline(Source)\n   335→        .add_converter(source_converter)\n   336→    )\n   337→\n   338→\n   339→def create_prediction_pipeline() -> TransformPipeline[Prediction]:\n   340→    \"\"\"Create a pipeline for Prediction transformations.\"\"\"\n   341→    return (\n   342→        TransformPipeline(Prediction)\n   343→        .add_converter(prediction_converter)\n   344→    )\n   345→\n   346→\n   347→def create_perspective_pipeline() -> TransformPipeline[Perspective]:\n   348→    \"\"\"Create a pipeline for Perspective transformations (including predictions).\"\"\"\n   349→\n   350→    def perspective_with_raw_predictions(data: InputType) -> Dict[str, Any]:\n   351→        \"\"\"Converter that preserves raw predictions for enricher.\"\"\"\n   352→        result = perspective_converter(data)\n   353→        result[\"_raw_predictions\"] = data.get(\"predictions\", [])\n   354→        return result\n   355→\n   356→    return (\n   357→        TransformPipeline(Perspective)\n   358→        .add_converter(perspective_with_raw_predictions)\n   359→        .add_enricher(convert_predictions_enricher)\n   360→    )\n   361→\n   362→\n   363→def create_cost_summary_pipeline() -> TransformPipeline[CostSummary]:\n   364→    \"\"\"Create a pipeline for CostSummary transformations.\"\"\"\n   365→    return (\n   366→        TransformPipeline(CostSummary)\n   367→        .add_converter(cost_summary_converter)\n   368→    )\n   369→\n   370→\n   371→# ============================================================================\n   372→# High-level transformation functions\n   373→# ============================================================================\n   374→\n   375→def transform_findings(\n   376→    raw_findings: List[Dict[str, Any]],\n   377→    sources: Optional[List[Dict[str, Any]]] = None,\n   378→) -> List[Finding]:\n   379→    \"\"\"\n   380→    Transform a list of raw finding dicts to Finding objects.\n   381→\n   382→    Args:\n   383→        raw_findings: List of raw finding dictionaries\n   384→        sources: Optional list of sources to attach as supporting sources\n   385→\n   386→    Returns:\n   387→        List of Finding objects\n   388→    \"\"\"\n   389→    pipeline = create_finding_pipeline()\n   390→    if sources:\n   391→        pipeline.add_enricher(add_supporting_sources_enricher)\n   392→\n   393→    def context_factory(index: int, item: Dict[str, Any]) -> Dict[str, Any]:\n   394→        ctx = {\"index\": index}\n   395→        if sources:\n   396→            ctx[\"sources\"] = sources\n   397→        return ctx\n   398→\n   399→    return pipeline.transform_many(raw_findings, context_factory)\n   400→\n   401→\n   402→def transform_sources(raw_sources: List[Dict[str, Any]]) -> List[Source]:\n   403→    \"\"\"Transform a list of raw source dicts to Source objects.\"\"\"\n   404→    pipeline = create_source_pipeline()\n   405→    return pipeline.transform_many(raw_sources)\n   406→\n   407→\n   408→def transform_perspectives(raw_perspectives: List[Dict[str, Any]]) -> List[Perspective]:\n   409→    \"\"\"Transform a list of raw perspective dicts to Perspective objects.\"\"\"\n   410→    pipeline = create_perspective_pipeline()\n   411→    return pipeline.transform_many(raw_perspectives)\n   412→\n   413→\n   414→def transform_cost_summary(raw_cost: Dict[str, Any]) -> CostSummary:\n   415→    \"\"\"Transform a raw cost dict to CostSummary object.\"\"\"\n   416→    pipeline = create_cost_summary_pipeline()\n   417→    result = pipeline.transform(raw_cost)\n   418→    if result.success:\n   419→        return result.value\n   420→    # Return default on failure\n   421→    return CostSummary()\n   422→\n   423→\n   424→# ============================================================================\n   425→# Source extraction and credibility assessment\n   426→# ============================================================================\n   427→\n   428→def extract_source_dict(gemini_source: Any) -> Dict[str, Any]:\n   429→    \"\"\"\n   430→    Extract a dict from a GeminiSource or similar source object.\n   431→\n   432→    Args:\n   433→        gemini_source: A source object with url, title, domain, snippet, source_type attributes\n   434→\n   435→    Returns:\n   436→        Dictionary representation of the source\n   437→    \"\"\"\n   438→    return {\n   439→        \"url\": getattr(gemini_source, \"url\", \"\"),\n   440→        \"title\": getattr(gemini_source, \"title\", \"\"),\n   441→        \"domain\": getattr(gemini_source, \"domain\", \"\"),\n   442→        \"snippet\": getattr(gemini_source, \"snippet\", \"\"),\n   443→        \"source_type\": getattr(gemini_source, \"source_type\", \"web\"),\n   444→    }\n   445→\n   446→\n   447→def assess_credibility(source: Dict[str, Any]) -> float:\n   448→    \"\"\"\n   449→    Assess source credibility using Bayesian probability inference.\n   450→\n   451→    This uses a proper probabilistic model where:\n   452→    - P(source is credible) depends on P(domain is authoritative)\n   453→    - Domain authority is based on known authoritative sources\n   454→    - Content signals can adjust the probability\n   455→\n   456→    Returns:\n   457→        Credibility score between 0 and 1 (probability of credibility)\n   458→    \"\"\"\n   459→    from .bayesian_confidence import calculate_source_credibility\n   460→\n   461→    score, _ = calculate_source_credibility(source)\n   462→    return score\n   463→\n   464→\n   465→def credibility_label(score: float) -> str:\n   466→    \"\"\"Get credibility label from score.\"\"\"\n   467→    if score >= 0.8:\n   468→        return \"high\"\n   469→    elif score >= 0.6:\n   470→        return \"medium\"\n   471→    else:\n   472→        return \"low\"\n   473→\n   474→\n   475→def enrich_source_credibility(source: Dict[str, Any]) -> Dict[str, Any]:\n   476→    \"\"\"Add credibility score and label to a source dict.\"\"\"\n   477→    source[\"credibility_score\"] = assess_credibility(source)\n   478→    source[\"credibility_label\"] = credibility_label(source[\"credibility_score\"])\n   479→    return source\n   480→\n   481→\n   482→def extract_and_deduplicate_sources(\n   483→    gemini_sources: List[Any],\n   484→    enrich_credibility: bool = True,\n   485→) -> List[Dict[str, Any]]:\n   486→    \"\"\"\n   487→    Extract sources from Gemini results, deduplicate, and optionally assess credibility.\n   488→\n   489→    Args:\n   490→        gemini_sources: List of GeminiSource objects\n   491→        enrich_credibility: Whether to add credibility scores\n   492→\n   493→    Returns:\n   494→        List of deduplicated source dicts\n   495→    \"\"\"\n   496→    seen_urls = set()\n   497→    unique_sources = []\n   498→\n   499→    for gs in gemini_sources:\n   500→        source_dict = extract_source_dict(gs)\n   501→        if source_dict[\"url\"] not in seen_urls:\n   502→            seen_urls.add(source_dict[\"url\"])\n   503→            if enrich_credibility:\n   504→                source_dict = enrich_source_credibility(source_dict)\n   505→            unique_sources.append(source_dict)\n   506→\n   507→    return unique_sources\n   508→\n   509→\n   510→def enrich_findings_with_ids_and_sources(\n   511→    findings: List[Dict[str, Any]],\n   512→    sources: List[Dict[str, Any]],\n   513→    max_sources_per_finding: int = 3,\n   514→) -> List[Dict[str, Any]]:\n   515→    \"\"\"\n   516→    Enrich findings with IDs and supporting sources.\n   517→\n   518→    Args:\n   519→        findings: List of raw finding dicts\n   520→        sources: List of source dicts to attach\n   521→        max_sources_per_finding: Maximum sources to attach per finding\n   522→\n   523→    Returns:\n   524→        Enriched findings list\n   525→    \"\"\"\n   526→    for i, finding in enumerate(findings):\n   527→        finding[\"finding_id\"] = f\"f{i+1}\"\n   528→        finding[\"supporting_sources\"] = [\n   529→            {\"url\": s[\"url\"], \"title\": s[\"title\"]}\n   530→            for s in sources[:max_sources_per_finding]\n   531→        ]\n   532→    return findings\n   533→\n   534→\n   535→# ============================================================================\n   536→# Batch transformation for complete research results\n   537→# ============================================================================\n   538→\n   539→@dataclass\n   540→class TransformedResult:\n   541→    \"\"\"Container for all transformed research result components.\"\"\"\n   542→\n   543→    findings: List[Finding]\n   544→    sources: List[Source]\n   545→    perspectives: List[Perspective]\n   546→    cost_summary: CostSummary\n   547→\n   548→\n   549→def transform_research_result(result: Dict[str, Any]) -> TransformedResult:\n   550→    \"\"\"\n   551→    Transform a complete research result dict into typed components.\n   552→\n   553→    This is the main entry point for converting Cloud Run / research service\n   554→    results into typed Pydantic models.\n   555→\n   556→    Args:\n   557→        result: Raw research result dictionary\n   558→\n   559→    Returns:\n   560→        TransformedResult with all typed components\n   561→    \"\"\"\n   562→    sources = transform_sources(result.get(\"sources\", []))\n   563→\n   564→    # Transform findings with sources context\n   565→    findings = transform_findings(\n   566→        result.get(\"findings\", []),\n   567→        sources=[{\"url\": s.url, \"title\": s.title} for s in sources],\n   568→    )\n   569→\n   570→    perspectives = transform_perspectives(result.get(\"perspectives\", []))\n   571→    cost_summary = transform_cost_summary(result.get(\"cost_summary\", {}))\n   572→\n   573→    return TransformedResult(\n   574→        findings=findings,\n   575→        sources=sources,\n   576→        perspectives=perspectives,\n   577→        cost_summary=cost_summary,\n   578→    )\n   579→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"063d9692-0974-4418-8890-3933b0ef315a","uuid":"e0771e2f-154e-40c2-8f92-8bdee107c2ec","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\actor\\src\\services\\transform.py","content":"\"\"\"Transform pipeline for typed data transformations.\n\nThis module provides a declarative pipeline architecture for converting raw dicts\nto typed Pydantic models with validation and enrichment stages.\n\"\"\"\n\nfrom typing import Any, Callable, Dict, Generic, List, Optional, Type, TypeVar, Union\nfrom dataclasses import dataclass, field\nfrom pydantic import BaseModel\nimport logging\n\nfrom ..schemas import Finding, Source, Perspective, Prediction, CostSummary\n\nlogger = logging.getLogger(__name__)\n\nT = TypeVar(\"T\", bound=BaseModel)\nInputType = Dict[str, Any]\n\n\n@dataclass\nclass TransformError:\n    \"\"\"Represents an error during transformation.\"\"\"\n\n    stage: str  # converter, validator, enricher\n    field: Optional[str] = None\n    message: str = \"\"\n    original_value: Any = None\n\n\n@dataclass\nclass TransformResult(Generic[T]):\n    \"\"\"Result of a transformation pipeline.\"\"\"\n\n    value: Optional[T] = None\n    errors: List[TransformError] = field(default_factory=list)\n\n    @property\n    def success(self) -> bool:\n        return self.value is not None and not self.errors\n\n    @property\n    def has_warnings(self) -> bool:\n        return len(self.errors) > 0 and self.value is not None\n\n\n# Type aliases for pipeline stages\nConverter = Callable[[InputType], Dict[str, Any]]\nValidator = Callable[[Dict[str, Any]], List[TransformError]]\nEnricher = Callable[[Dict[str, Any], Optional[Any]], Dict[str, Any]]\n\n\nclass TransformPipeline(Generic[T]):\n    \"\"\"\n    A composable transformation pipeline that converts raw dicts to typed models.\n\n    The pipeline processes data through three stages:\n    1. Converters: Map raw field names/values to model-compatible format\n    2. Validators: Check data integrity and business rules\n    3. Enrichers: Add computed fields or defaults\n\n    Example:\n        pipeline = TransformPipeline(Finding)\n        pipeline.add_converter(finding_converter)\n        pipeline.add_validator(confidence_validator)\n        pipeline.add_enricher(add_finding_id)\n\n        result = pipeline.transform(raw_dict, context={\"index\": 0})\n    \"\"\"\n\n    def __init__(self, model_class: Type[T]):\n        self.model_class = model_class\n        self._converters: List[Converter] = []\n        self._validators: List[Validator] = []\n        self._enrichers: List[Enricher] = []\n\n    def add_converter(self, converter: Converter) -> \"TransformPipeline[T]\":\n        \"\"\"Add a converter stage. Converters are applied in order.\"\"\"\n        self._converters.append(converter)\n        return self\n\n    def add_validator(self, validator: Validator) -> \"TransformPipeline[T]\":\n        \"\"\"Add a validator stage. All validators are run, errors collected.\"\"\"\n        self._validators.append(validator)\n        return self\n\n    def add_enricher(self, enricher: Enricher) -> \"TransformPipeline[T]\":\n        \"\"\"Add an enricher stage. Enrichers are applied in order.\"\"\"\n        self._enrichers.append(enricher)\n        return self\n\n    def transform(self, data: InputType, context: Optional[Any] = None) -> TransformResult[T]:\n        \"\"\"\n        Transform a raw dict through the pipeline.\n\n        Args:\n            data: Raw dictionary to transform\n            context: Optional context passed to enrichers (e.g., index, sources list)\n\n        Returns:\n            TransformResult with the typed model or errors\n        \"\"\"\n        errors: List[TransformError] = []\n        current_data = dict(data)  # Copy to avoid mutation\n\n        # Stage 1: Apply converters\n        for converter in self._converters:\n            try:\n                current_data = converter(current_data)\n            except Exception as e:\n                errors.append(TransformError(\n                    stage=\"converter\",\n                    message=str(e),\n                    original_value=data,\n                ))\n                return TransformResult(value=None, errors=errors)\n\n        # Stage 2: Run validators\n        for validator in self._validators:\n            try:\n                validation_errors = validator(current_data)\n                errors.extend(validation_errors)\n            except Exception as e:\n                errors.append(TransformError(\n                    stage=\"validator\",\n                    message=str(e),\n                ))\n\n        # If validation errors are critical, stop here\n        critical_errors = [e for e in errors if e.stage == \"validator\"]\n        if critical_errors:\n            return TransformResult(value=None, errors=errors)\n\n        # Stage 3: Apply enrichers\n        for enricher in self._enrichers:\n            try:\n                current_data = enricher(current_data, context)\n            except Exception as e:\n                errors.append(TransformError(\n                    stage=\"enricher\",\n                    message=str(e),\n                ))\n\n        # Stage 4: Create model instance\n        try:\n            model_instance = self.model_class(**current_data)\n            return TransformResult(value=model_instance, errors=errors)\n        except Exception as e:\n            errors.append(TransformError(\n                stage=\"model_creation\",\n                message=str(e),\n                original_value=current_data,\n            ))\n            return TransformResult(value=None, errors=errors)\n\n    def transform_many(\n        self,\n        items: List[InputType],\n        context_factory: Optional[Callable[[int, InputType], Any]] = None,\n    ) -> List[T]:\n        \"\"\"\n        Transform a list of items, returning only successful transformations.\n\n        Args:\n            items: List of raw dictionaries\n            context_factory: Optional function to create context for each item (index, item) -> context\n\n        Returns:\n            List of successfully transformed models\n        \"\"\"\n        results = []\n        for i, item in enumerate(items):\n            context = context_factory(i, item) if context_factory else {\"index\": i}\n            result = self.transform(item, context)\n            if result.success:\n                results.append(result.value)\n            elif result.has_warnings:\n                results.append(result.value)\n                for error in result.errors:\n                    logger.warning(f\"Transform warning for item {i}: {error.message}\")\n            else:\n                for error in result.errors:\n                    logger.error(f\"Transform error for item {i}: {error.message}\")\n        return results\n\n\n# ============================================================================\n# Pre-built converters for common transformations\n# ============================================================================\n\ndef finding_converter(data: InputType) -> Dict[str, Any]:\n    \"\"\"Convert raw finding dict to Finding-compatible format.\"\"\"\n    return {\n        \"finding_id\": data.get(\"finding_id\", f\"f{data.get('_index', 0)}\"),\n        \"finding_type\": data.get(\"finding_type\", \"fact\"),\n        \"content\": data.get(\"content\", \"\"),\n        \"summary\": data.get(\"summary\"),\n        \"confidence_score\": data.get(\"confidence_score\", 0.5),\n        \"temporal_context\": data.get(\"temporal_context\", \"present\"),\n        \"extracted_data\": data.get(\"extracted_data\"),\n        \"supporting_sources\": data.get(\"supporting_sources\", []),\n        \"date_referenced\": data.get(\"date_referenced\"),\n        \"date_range\": data.get(\"date_range\"),\n    }\n\n\ndef source_converter(data: InputType) -> Dict[str, Any]:\n    \"\"\"Convert raw source dict to Source-compatible format.\"\"\"\n    return {\n        \"url\": data.get(\"url\", \"\"),\n        \"title\": data.get(\"title\", \"\"),\n        \"domain\": data.get(\"domain\", \"\"),\n        \"snippet\": data.get(\"snippet\", \"\"),\n        \"source_type\": data.get(\"source_type\", \"web\"),\n        \"credibility_score\": data.get(\"credibility_score\"),\n        \"credibility_label\": data.get(\"credibility_label\"),\n    }\n\n\ndef prediction_converter(data: InputType) -> Dict[str, Any]:\n    \"\"\"Convert raw prediction dict or string to Prediction-compatible format.\"\"\"\n    if isinstance(data, str):\n        # Handle old-style string predictions\n        return {\n            \"prediction\": data,\n            \"rationale\": \"Based on research findings\",\n            \"confidence\": \"medium\",\n            \"timeline\": \"2025-2026\",\n            \"supporting_sources\": [],\n        }\n    return {\n        \"prediction\": data.get(\"prediction\", \"\"),\n        \"rationale\": data.get(\"rationale\", \"\"),\n        \"confidence\": data.get(\"confidence\", \"medium\"),\n        \"timeline\": data.get(\"timeline\", \"\"),\n        \"supporting_sources\": data.get(\"supporting_sources\", []),\n    }\n\n\ndef perspective_converter(data: InputType) -> Dict[str, Any]:\n    \"\"\"Convert raw perspective dict to Perspective-compatible format (without predictions).\"\"\"\n    return {\n        \"perspective_type\": data.get(\"perspective_type\", \"unknown\"),\n        \"analysis_text\": data.get(\"analysis_text\", \"\"),\n        \"key_insights\": data.get(\"key_insights\", []),\n        \"recommendations\": data.get(\"recommendations\", []),\n        \"warnings\": data.get(\"warnings\", []),\n        \"confidence\": data.get(\"confidence\", 0.5),\n        # predictions handled separately by enricher\n    }\n\n\ndef cost_summary_converter(data: InputType) -> Dict[str, Any]:\n    \"\"\"Convert raw cost dict to CostSummary-compatible format.\"\"\"\n    return {\n        \"total_tokens\": data.get(\"total_tokens\", 0),\n        \"input_tokens\": data.get(\"input_tokens\", 0),\n        \"output_tokens\": data.get(\"output_tokens\", 0),\n        \"gemini_cost_usd\": data.get(\"gemini_cost_usd\", 0),\n        \"openrouter_cost_usd\": data.get(\"openrouter_cost_usd\", 0),\n        \"total_cost_usd\": data.get(\"total_cost_usd\", 0),\n    }\n\n\n# ============================================================================\n# Pre-built enrichers\n# ============================================================================\n\ndef add_finding_id_enricher(data: Dict[str, Any], context: Optional[Any]) -> Dict[str, Any]:\n    \"\"\"Add finding ID based on index from context.\"\"\"\n    if context and isinstance(context, dict) and \"index\" in context:\n        if not data.get(\"finding_id\") or data[\"finding_id\"].startswith(\"f0\"):\n            data[\"finding_id\"] = f\"f{context['index']}\"\n    return data\n\n\ndef add_supporting_sources_enricher(data: Dict[str, Any], context: Optional[Any]) -> Dict[str, Any]:\n    \"\"\"Add supporting sources from context.\"\"\"\n    if context and isinstance(context, dict) and \"sources\" in context:\n        sources = context[\"sources\"]\n        if not data.get(\"supporting_sources\") and sources:\n            data[\"supporting_sources\"] = [\n                {\"url\": s.get(\"url\", s.url if hasattr(s, \"url\") else \"\"),\n                 \"title\": s.get(\"title\", s.title if hasattr(s, \"title\") else \"\")}\n                for s in sources[:3]\n            ]\n    return data\n\n\ndef convert_predictions_enricher(data: Dict[str, Any], context: Optional[Any]) -> Dict[str, Any]:\n    \"\"\"Convert raw predictions list to Prediction objects.\"\"\"\n    raw_predictions = data.get(\"_raw_predictions\", data.get(\"predictions\", []))\n\n    if not raw_predictions:\n        data[\"predictions\"] = []\n        return data\n\n    prediction_pipeline = create_prediction_pipeline()\n    converted = []\n\n    for pred in raw_predictions:\n        if isinstance(pred, Prediction):\n            converted.append(pred)\n        elif isinstance(pred, dict):\n            result = prediction_pipeline.transform(pred)\n            if result.success:\n                converted.append(result.value)\n        elif isinstance(pred, str):\n            result = prediction_pipeline.transform(pred)\n            if result.success:\n                converted.append(result.value)\n\n    data[\"predictions\"] = converted\n    # Remove temporary key\n    data.pop(\"_raw_predictions\", None)\n    return data\n\n\n# ============================================================================\n# Pre-built pipelines\n# ============================================================================\n\ndef create_finding_pipeline() -> TransformPipeline[Finding]:\n    \"\"\"Create a pipeline for Finding transformations.\"\"\"\n    return (\n        TransformPipeline(Finding)\n        .add_converter(finding_converter)\n        .add_enricher(add_finding_id_enricher)\n    )\n\n\ndef create_source_pipeline() -> TransformPipeline[Source]:\n    \"\"\"Create a pipeline for Source transformations.\"\"\"\n    return (\n        TransformPipeline(Source)\n        .add_converter(source_converter)\n    )\n\n\ndef create_prediction_pipeline() -> TransformPipeline[Prediction]:\n    \"\"\"Create a pipeline for Prediction transformations.\"\"\"\n    return (\n        TransformPipeline(Prediction)\n        .add_converter(prediction_converter)\n    )\n\n\ndef create_perspective_pipeline() -> TransformPipeline[Perspective]:\n    \"\"\"Create a pipeline for Perspective transformations (including predictions).\"\"\"\n\n    def perspective_with_raw_predictions(data: InputType) -> Dict[str, Any]:\n        \"\"\"Converter that preserves raw predictions for enricher.\"\"\"\n        result = perspective_converter(data)\n        result[\"_raw_predictions\"] = data.get(\"predictions\", [])\n        return result\n\n    return (\n        TransformPipeline(Perspective)\n        .add_converter(perspective_with_raw_predictions)\n        .add_enricher(convert_predictions_enricher)\n    )\n\n\ndef create_cost_summary_pipeline() -> TransformPipeline[CostSummary]:\n    \"\"\"Create a pipeline for CostSummary transformations.\"\"\"\n    return (\n        TransformPipeline(CostSummary)\n        .add_converter(cost_summary_converter)\n    )\n\n\n# ============================================================================\n# High-level transformation functions\n# ============================================================================\n\ndef transform_findings(\n    raw_findings: List[Dict[str, Any]],\n    sources: Optional[List[Dict[str, Any]]] = None,\n) -> List[Finding]:\n    \"\"\"\n    Transform a list of raw finding dicts to Finding objects.\n\n    Args:\n        raw_findings: List of raw finding dictionaries\n        sources: Optional list of sources to attach as supporting sources\n\n    Returns:\n        List of Finding objects\n    \"\"\"\n    pipeline = create_finding_pipeline()\n    if sources:\n        pipeline.add_enricher(add_supporting_sources_enricher)\n\n    def context_factory(index: int, item: Dict[str, Any]) -> Dict[str, Any]:\n        ctx = {\"index\": index}\n        if sources:\n            ctx[\"sources\"] = sources\n        return ctx\n\n    return pipeline.transform_many(raw_findings, context_factory)\n\n\ndef transform_sources(raw_sources: List[Dict[str, Any]]) -> List[Source]:\n    \"\"\"Transform a list of raw source dicts to Source objects.\"\"\"\n    pipeline = create_source_pipeline()\n    return pipeline.transform_many(raw_sources)\n\n\ndef transform_perspectives(raw_perspectives: List[Dict[str, Any]]) -> List[Perspective]:\n    \"\"\"Transform a list of raw perspective dicts to Perspective objects.\"\"\"\n    pipeline = create_perspective_pipeline()\n    return pipeline.transform_many(raw_perspectives)\n\n\ndef transform_cost_summary(raw_cost: Dict[str, Any]) -> CostSummary:\n    \"\"\"Transform a raw cost dict to CostSummary object.\"\"\"\n    pipeline = create_cost_summary_pipeline()\n    result = pipeline.transform(raw_cost)\n    if result.success:\n        return result.value\n    # Return default on failure\n    return CostSummary()\n\n\n# ============================================================================\n# Source extraction and credibility assessment\n# ============================================================================\n\ndef extract_source_dict(gemini_source: Any) -> Dict[str, Any]:\n    \"\"\"\n    Extract a dict from a GeminiSource or similar source object.\n\n    Args:\n        gemini_source: A source object with url, title, domain, snippet, source_type attributes\n\n    Returns:\n        Dictionary representation of the source\n    \"\"\"\n    return {\n        \"url\": getattr(gemini_source, \"url\", \"\"),\n        \"title\": getattr(gemini_source, \"title\", \"\"),\n        \"domain\": getattr(gemini_source, \"domain\", \"\"),\n        \"snippet\": getattr(gemini_source, \"snippet\", \"\"),\n        \"source_type\": getattr(gemini_source, \"source_type\", \"web\"),\n    }\n\n\ndef assess_credibility(source: Dict[str, Any]) -> float:\n    \"\"\"\n    Assess source credibility using Bayesian probability inference.\n\n    This uses a proper probabilistic model where:\n    - P(source is credible) depends on P(domain is authoritative)\n    - Domain authority is based on known authoritative sources\n    - Content signals can adjust the probability\n\n    Returns:\n        Credibility score between 0 and 1 (probability of credibility)\n    \"\"\"\n    from .bayesian_confidence import calculate_source_credibility\n\n    score, _ = calculate_source_credibility(source)\n    return score\n\n\ndef credibility_label(score: float) -> str:\n    \"\"\"Get credibility label from score.\"\"\"\n    if score >= 0.8:\n        return \"high\"\n    elif score >= 0.6:\n        return \"medium\"\n    else:\n        return \"low\"\n\n\ndef enrich_source_credibility(source: Dict[str, Any]) -> Dict[str, Any]:\n    \"\"\"Add credibility score and label to a source dict.\"\"\"\n    source[\"credibility_score\"] = assess_credibility(source)\n    source[\"credibility_label\"] = credibility_label(source[\"credibility_score\"])\n    return source\n\n\ndef extract_and_deduplicate_sources(\n    gemini_sources: List[Any],\n    enrich_credibility: bool = True,\n) -> List[Dict[str, Any]]:\n    \"\"\"\n    Extract sources from Gemini results, deduplicate, and optionally assess credibility.\n\n    Args:\n        gemini_sources: List of GeminiSource objects\n        enrich_credibility: Whether to add credibility scores\n\n    Returns:\n        List of deduplicated source dicts\n    \"\"\"\n    seen_urls = set()\n    unique_sources = []\n\n    for gs in gemini_sources:\n        source_dict = extract_source_dict(gs)\n        if source_dict[\"url\"] not in seen_urls:\n            seen_urls.add(source_dict[\"url\"])\n            if enrich_credibility:\n                source_dict = enrich_source_credibility(source_dict)\n            unique_sources.append(source_dict)\n\n    return unique_sources\n\n\ndef enrich_findings_with_ids_and_sources(\n    findings: List[Dict[str, Any]],\n    sources: List[Dict[str, Any]],\n    max_sources_per_finding: int = 3,\n) -> List[Dict[str, Any]]:\n    \"\"\"\n    Enrich findings with IDs and supporting sources.\n\n    Args:\n        findings: List of raw finding dicts\n        sources: List of source dicts to attach\n        max_sources_per_finding: Maximum sources to attach per finding\n\n    Returns:\n        Enriched findings list\n    \"\"\"\n    for i, finding in enumerate(findings):\n        finding[\"finding_id\"] = f\"f{i+1}\"\n        finding[\"supporting_sources\"] = [\n            {\"url\": s[\"url\"], \"title\": s[\"title\"]}\n            for s in sources[:max_sources_per_finding]\n        ]\n    return findings\n\n\n# ============================================================================\n# Batch transformation for complete research results\n# ============================================================================\n\n@dataclass\nclass TransformedResult:\n    \"\"\"Container for all transformed research result components.\"\"\"\n\n    findings: List[Finding]\n    sources: List[Source]\n    perspectives: List[Perspective]\n    cost_summary: CostSummary\n\n\ndef transform_research_result(result: Dict[str, Any]) -> TransformedResult:\n    \"\"\"\n    Transform a complete research result dict into typed components.\n\n    This is the main entry point for converting Cloud Run / research service\n    results into typed Pydantic models.\n\n    Args:\n        result: Raw research result dictionary\n\n    Returns:\n        TransformedResult with all typed components\n    \"\"\"\n    sources = transform_sources(result.get(\"sources\", []))\n\n    # Transform findings with sources context\n    findings = transform_findings(\n        result.get(\"findings\", []),\n        sources=[{\"url\": s.url, \"title\": s.title} for s in sources],\n    )\n\n    perspectives = transform_perspectives(result.get(\"perspectives\", []))\n    cost_summary = transform_cost_summary(result.get(\"cost_summary\", {}))\n\n    return TransformedResult(\n        findings=findings,\n        sources=sources,\n        perspectives=perspectives,\n        cost_summary=cost_summary,\n    )\n","numLines":579,"startLine":1,"totalLines":579}}}
