[2026-01-30T14:24:43.323Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VWHsLzQjF6JGDCTw7NN5rv","type":"tool_result","content":"     1→\"\"\"Research orchestration service.\"\"\"\n     2→\n     3→import time\n     4→import logging\n     5→from typing import List, Dict, Any, Optional, TYPE_CHECKING\n     6→from uuid import uuid4\n     7→\n     8→from ..clients.gemini import GeminiClient, Source as GeminiSource\n     9→from ..clients.supabase import SupabaseClient\n    10→from ..templates import get_template, BaseTemplate\n    11→from .cost_tracker import CostTracker\n    12→from .ocr import OCRService\n    13→from .cache import CacheService\n    14→from .transform import (\n    15→    extract_source_dict,\n    16→    enrich_source_credibility,\n    17→    enrich_findings_with_ids_and_sources,\n    18→)\n    19→\n    20→if TYPE_CHECKING:\n    21→    from .progress import ProgressEmitter\n    22→\n    23→logger = logging.getLogger(__name__)\n    24→\n    25→\n    26→class ResearchService:\n    27→    \"\"\"Orchestrates the research process.\"\"\"\n    28→\n    29→    def __init__(\n    30→        self,\n    31→        gemini_client: GeminiClient,\n    32→        supabase_client: Optional[SupabaseClient] = None,\n    33→        ocr_service: Optional[OCRService] = None,\n    34→        progress_emitter: Optional[\"ProgressEmitter\"] = None,\n    35→    ):\n    36→        self.gemini = gemini_client\n    37→        self.supabase = supabase_client\n    38→        self.ocr = ocr_service\n    39→        self.cost_tracker = CostTracker()\n    40→        self.progress = progress_emitter\n    41→\n    42→    async def execute_research(\n    43→        self,\n    44→        query: str,\n    45→        template_type: str = \"investigative\",\n    46→        granularity: str = \"standard\",\n    47→        max_searches: int = 5,\n    48→        perspectives: Optional[List[str]] = None,\n    49→        input_file_url: Optional[str] = None,\n    50→        input_text: Optional[str] = None,\n    51→        save_to_db: bool = True,\n    52→        workspace_id: str = \"apify\",\n    53→        use_cache: bool = True,\n    54→        extend_cache: bool = True,\n    55→        intent: Optional[str] = None,\n    56→        intent_config: Optional[Dict[str, Any]] = None,\n    57→    ) -> Dict[str, Any]:\n    58→        \"\"\"\n    59→        Execute a complete research session.\n    60→\n    61→        Args:\n    62→            use_cache: Check for and return cached results for identical queries\n    63→            extend_cache: If cache hit, extend with new research in background\n    64→            intent: Requestor's decision intent (investment_sizing, risk_assessment, etc.)\n    65→            intent_config: Configuration dict from ActorInput.get_intent_config()\n    66→\n    67→        Returns:\n    68→            Dict with session_id, findings, perspectives, sources, etc.\n    69→        \"\"\"\n    70→        start_time = time.time()\n    71→        session_id = str(uuid4())\n    72→        errors = []\n    73→        warnings = []\n    74→\n    75→        # Initialize cache service\n    76→        cache_service = CacheService()\n    77→        cache_key = cache_service.get_cache_key(query, template_type, granularity)\n    78→        cache_hit = False\n    79→        original_cached_at = None\n    80→\n    81→        # Check cache if enabled\n    82→        if use_cache and cache_service.is_available():\n    83→            cached = await cache_service.get_cached(cache_key)\n    84→            if cached:\n    85→                logger.info(f\"Cache hit for query: {query[:50]}...\")\n    86→                cache_hit = True\n    87→                original_cached_at = cached.get(\"cached_at\")\n    88→\n    89→                # Update access count\n    90→                await cache_service.update_access(cache_key)\n    91→\n    92→                # Return cached result with cache metadata\n    93→                cached_result = cached.get(\"result\", {})\n    94→                cached_result[\"cache_hit\"] = True\n    95→                cached_result[\"cache_extended\"] = False\n    96→                cached_result[\"original_cached_at\"] = original_cached_at\n    97→                cached_result[\"execution_time_seconds\"] = round(time.time() - start_time, 2)\n    98→\n    99→                # Log cache hit (event emitter doesn't have cache_hit method)\n   100→                logger.info(f\"Cache hit for query: {query[:50]}...\")\n   101→\n   102→                return cached_result\n   103→\n   104→        # Initialize template\n   105→        template = get_template(template_type)\n   106→        template.set_client(self.gemini)\n   107→\n   108→        # Emit initialization\n   109→        if self.progress:\n   110→            await self.progress.initialized(query, template_type, granularity, max_searches)\n   111→\n   112→        # Build context from input file/text\n   113→        context_text = \"\"\n   114→        if input_file_url and self.ocr:\n   115→            try:\n   116→                logger.info(f\"Processing input file: {input_file_url}\")\n   117→                ocr_result = await self.ocr.process_file_url(input_file_url)\n   118→                context_text = ocr_result.get(\"text\", \"\")\n   119→                self.cost_tracker.add_openrouter_usage(ocr_result.get(\"tokens\", 0))\n   120→            except Exception as e:\n   121→                warnings.append(f\"Failed to process input file: {str(e)}\")\n   122→                logger.warning(f\"OCR failed: {e}\")\n   123→\n   124→        if input_text:\n   125→            context_text = f\"{context_text}\\n\\n{input_text}\" if context_text else input_text\n   126→\n   127→        # Create session in database\n   128→        db_session = None\n   129→        if save_to_db and self.supabase:\n   130→            try:\n   131→                db_session = await self.supabase.create_session(\n   132→                    title=f\"Research: {query[:50]}...\",\n   133→                    query=query,\n   134→                    template_type=template_type,\n   135→                    parameters={\n   136→                        \"granularity\": granularity,\n   137→                        \"max_searches\": max_searches,\n   138→                        \"perspectives\": perspectives,\n   139→                    },\n   140→                )\n   141→                session_id = db_session.get(\"id\", session_id)\n   142→            except Exception as e:\n   143→                warnings.append(f\"Failed to create database session: {str(e)}\")\n   144→                logger.warning(f\"DB session creation failed: {e}\")\n   145→\n   146→        # Phase 1: Generate search queries\n   147→        logger.info(\"Generating search queries...\")\n   148→        search_queries = await template.generate_search_queries(\n   149→            query=query,\n   150→            max_searches=max_searches,\n   151→            granularity=granularity,\n   152→        )\n   153→\n   154→        if not search_queries:\n   155→            errors.append(\"Failed to generate search queries\")\n   156→            if self.progress:\n   157→                await self.progress.failed(\"Failed to generate search queries\", \"QUERY_GENERATION_FAILED\", \"query_generation\")\n   158→            return self._build_error_result(session_id, query, template_type, errors, start_time)\n   159→\n   160→        # Emit query generation\n   161→        if self.progress:\n   162→            await self.progress.queries_generated(len(search_queries), search_queries)\n   163→\n   164→        # Phase 2: Execute searches\n   165→        logger.info(f\"Executing {len(search_queries)} searches...\")\n   166→        all_sources: List[Dict[str, Any]] = []\n   167→        all_content: List[str] = []\n   168→\n   169→        # Add context if available\n   170→        if context_text:\n   171→            all_content.append(f\"## Input Context\\n\\n{context_text}\")\n   172→\n   173→        for i, search_query in enumerate(search_queries):\n   174→            try:\n   175→                # Emit search started\n   176→                if self.progress:\n   177→                    await self.progress.search_started(i, search_query, len(search_queries))\n   178→\n   179→                logger.debug(f\"Search {i+1}/{len(search_queries)}: {search_query[:50]}...\")\n   180→                result = await self.gemini.research(search_query)\n   181→\n   182→                # Track tokens and cost\n   183→                tokens_used = 0\n   184→                cost_usd = 0.0\n   185→                if result.token_usage:\n   186→                    tokens_used = result.token_usage.input_tokens + result.token_usage.output_tokens\n   187→                    self.cost_tracker.add_gemini_usage(\n   188→                        result.token_usage.input_tokens,\n   189→                        result.token_usage.output_tokens,\n   190→                    )\n   191→                    cost_usd = self.cost_tracker.get_summary().get(\"total_cost_usd\", 0.0) - (\n   192→                        self.cost_tracker.get_summary().get(\"total_cost_usd\", 0.0) if i == 0 else 0\n   193→                    )\n   194→\n   195→                # Collect sources using transform pipeline\n   196→                sources_this_search = [extract_source_dict(s) for s in result.sources]\n   197→                all_sources.extend(sources_this_search)\n   198→\n   199→                # Collect synthesized content\n   200→                if result.text:\n   201→                    all_content.append(f\"## Search: {search_query}\\n\\n{result.text}\")\n   202→\n   203→                # Emit search completed\n   204→                if self.progress:\n   205→                    await self.progress.search_completed(\n   206→                        i, len(sources_this_search), 0,  # Findings counted later\n   207→                        total=len(search_queries),\n   208→                        tokens_used=tokens_used, cost_usd=cost_usd\n   209→                    )\n   210→\n   211→                # Save query to database\n   212→                if save_to_db and self.supabase:\n   213→                    try:\n   214→                        await self.supabase.save_query(\n   215→                            session_id=session_id,\n   216→                            query_text=search_query,\n   217→                            query_purpose=f\"Search query {i+1}\",\n   218→                            query_round=1,\n   219→                            result_count=len(result.sources),\n   220→                        )\n   221→                    except Exception as e:\n   222→                        logger.warning(f\"Failed to save query: {e}\")\n   223→\n   224→            except Exception as e:\n   225→                warnings.append(f\"Search failed for '{search_query[:30]}...': {str(e)}\")\n   226→                logger.warning(f\"Search failed: {e}\")\n   227→\n   228→        # Deduplicate sources\n   229→        seen_urls = set()\n   230→        unique_sources = []\n   231→        for source in all_sources:\n   232→            if source[\"url\"] not in seen_urls:\n   233→                seen_urls.add(source[\"url\"])\n   234→                unique_sources.append(source)\n   235→\n   236→        # Phase 3: Assess credibility using transform pipeline\n   237→        for source in unique_sources:\n   238→            enrich_source_credibility(source)\n   239→\n   240→        # Save sources\n   241→        if save_to_db and self.supabase:\n   242→            try:\n   243→                await self.supabase.save_sources(session_id, unique_sources)\n   244→            except Exception as e:\n   245→                logger.warning(f\"Failed to save sources: {e}\")\n   246→\n   247→        # Phase 4: Extract findings\n   248→        logger.info(\"Extracting findings...\")\n   249→        synthesized_content = \"\\n\\n---\\n\\n\".join(all_content)\n   250→        findings = await template.extract_findings(\n   251→            query=query,\n   252→            sources=unique_sources,\n   253→            synthesized_content=synthesized_content,\n   254→            granularity=granularity,\n   255→        )\n   256→\n   257→        # Enrich findings with IDs and supporting sources using transform pipeline\n   258→        findings = enrich_findings_with_ids_and_sources(findings, unique_sources)\n   259→\n   260→        # Phase 4.5: Verify findings (bias detection, sanity check, cross-reference)\n   261→        logger.info(\"Verifying findings...\")\n   262→        if self.progress:\n   263→            await self.progress.verification_started()\n   264→        try:\n   265→            findings = await template.verify_findings(\n   266→                findings=findings,\n   267→                sources=unique_sources,\n   268→                original_query=query,\n   269→            )\n   270→            logger.info(f\"Verified {len(findings)} findings\")\n   271→            if self.progress:\n   272→                await self.progress.verification_completed(len(findings))\n   273→        except Exception as e:\n   274→            warnings.append(f\"Finding verification failed: {str(e)}\")\n   275→            logger.warning(f\"Verification failed: {e}\")\n   276→\n   277→        # Save findings\n   278→        if save_to_db and self.supabase:\n   279→            try:\n   280→                await self.supabase.save_findings(session_id, findings)\n   281→            except Exception as e:\n   282→                logger.warning(f\"Failed to save findings: {e}\")\n   283→\n   284→        # Phase 5: Multi-perspective analysis\n   285→        logger.info(\"Running perspective analysis...\")\n   286→        perspectives_to_run = perspectives or template.default_perspectives\n   287→\n   288→        # Emit perspectives started\n   289→        if self.progress:\n   290→            await self.progress.perspectives_started(perspectives_to_run)\n   291→\n   292→        perspective_results = []\n   293→        total_insights = 0\n   294→\n   295→        for perspective_type in perspectives_to_run:\n   296→            try:\n   297→                analysis = await template.analyze_perspective(\n   298→                    perspective_type=perspective_type,\n   299→                    findings=findings,\n   300→                    sources=unique_sources,\n   301→                    original_query=query,\n   302→                )\n   303→                perspective_results.append(analysis)\n   304→                # Count insights from this perspective\n   305→                total_insights += len(analysis.get(\"key_insights\", []))\n   306→\n   307→            except Exception as e:\n   308→                warnings.append(f\"Perspective analysis failed for '{perspective_type}': {str(e)}\")\n   309→                logger.warning(f\"Perspective failed: {e}\")\n   310→\n   311→        # Emit perspectives completed\n   312→        if self.progress:\n   313→            await self.progress.perspectives_completed(len(perspective_results), total_insights)\n   314→\n   315→        # Save perspectives\n   316→        if save_to_db and self.supabase:\n   317→            try:\n   318→                await self.supabase.save_perspectives(session_id, perspective_results)\n   319→            except Exception as e:\n   320→                logger.warning(f\"Failed to save perspectives: {e}\")\n   321→\n   322→        # Phase 6: Intelligence analysis (contradictions, gaps, role summaries)\n   323→        logger.info(\"Running intelligence analysis...\")\n   324→        intelligence_results = {}\n   325→        try:\n   326→            from .intelligence import IntelligenceAnalyzer\n   327→            analyzer = IntelligenceAnalyzer(gemini_client=self.gemini)\n   328→            intelligence_results = await analyzer.analyze(\n   329→                findings=findings,\n   330→                perspectives=perspective_results,\n   331→                sources=unique_sources,\n   332→                query=query,\n   333→                template=template_type,\n   334→            )\n   335→            logger.info(\n   336→                f\"Intelligence analysis complete: \"\n   337→                f\"{len(intelligence_results.get('contradictions', []))} contradictions, \"\n   338→                f\"{len(intelligence_results.get('knowledge_gaps', []))} gaps, \"\n   339→                f\"{len(intelligence_results.get('role_summaries', {}))} role summaries\"\n   340→            )\n   341→        except Exception as e:\n   342→            warnings.append(f\"Intelligence analysis failed: {str(e)}\")\n   343→            logger.warning(f\"Intelligence analysis failed: {e}\")\n   344→\n   345→        # Complete session\n   346→        if save_to_db and self.supabase:\n   347→            try:\n   348→                await self.supabase.complete_session(\n   349→                    session_id,\n   350→                    cost_summary=self.cost_tracker.get_summary(),\n   351→                )\n   352→            except Exception as e:\n   353→                logger.warning(f\"Failed to complete session: {e}\")\n   354→\n   355→        execution_time = time.time() - start_time\n   356→\n   357→        # Build result\n   358→        result = {\n   359→            \"session_id\": session_id,\n   360→            \"query\": query,\n   361→            \"template\": template_type,\n   362→            \"status\": \"completed\" if not errors else \"partial\",\n   363→            \"findings\": findings,\n   364→            \"perspectives\": perspective_results,\n   365→            \"sources\": unique_sources,\n   366→            \"search_queries_executed\": search_queries,\n   367→            \"cost_summary\": self.cost_tracker.get_summary(),\n   368→            \"execution_time_seconds\": round(execution_time, 2),\n   369→            \"supabase_session_id\": session_id if save_to_db and self.supabase else None,\n   370→            \"errors\": errors,\n   371→            \"warnings\": warnings,\n   372→            \"cache_hit\": False,\n   373→            \"cache_extended\": False,\n   374→            \"original_cached_at\": None,\n   375→            # Intelligence analysis results\n   376→            \"contradictions\": intelligence_results.get(\"contradictions\", []),\n   377→            \"knowledge_gaps\": intelligence_results.get(\"knowledge_gaps\", []),\n   378→            \"role_summaries\": intelligence_results.get(\"role_summaries\", {}),\n   379→            # Intent configuration for report generation\n   380→            \"intent\": intent,\n   381→            \"intent_config\": intent_config or {},\n   382→        }\n   383→\n   384→        # Cache the result if caching is enabled\n   385→        if use_cache and cache_service.is_available() and not errors:\n   386→            try:\n   387→                await cache_service.set_cached(\n   388→                    cache_key=cache_key,\n   389→                    result=result,\n   390→                    findings_count=len(findings),\n   391→                    sources_count=len(unique_sources),\n   392→                )\n   393→                logger.info(f\"Cached research result: {cache_key}\")\n   394→            except Exception as e:\n   395→                logger.warning(f\"Failed to cache result: {e}\")\n   396→\n   397→        return result\n   398→\n   399→    def _build_error_result(\n   400→        self,\n   401→        session_id: str,\n   402→        query: str,\n   403→        template: str,\n   404→        errors: List[str],\n   405→        start_time: float,\n   406→    ) -> Dict[str, Any]:\n   407→        \"\"\"Build error result when research fails.\"\"\"\n   408→        return {\n   409→            \"session_id\": session_id,\n   410→            \"query\": query,\n   411→            \"template\": template,\n   412→            \"status\": \"failed\",\n   413→            \"findings\": [],\n   414→            \"perspectives\": [],\n   415→            \"sources\": [],\n   416→            \"search_queries_executed\": [],\n   417→            \"cost_summary\": self.cost_tracker.get_summary(),\n   418→            \"execution_time_seconds\": round(time.time() - start_time, 2),\n   419→            \"supabase_session_id\": None,\n   420→            \"errors\": errors,\n   421→            \"warnings\": [],\n   422→        }\n   423→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"063d9692-0974-4418-8890-3933b0ef315a","uuid":"cd815465-0677-4d6e-a685-cacb012858b4","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\actor\\src\\services\\research.py","content":"\"\"\"Research orchestration service.\"\"\"\n\nimport time\nimport logging\nfrom typing import List, Dict, Any, Optional, TYPE_CHECKING\nfrom uuid import uuid4\n\nfrom ..clients.gemini import GeminiClient, Source as GeminiSource\nfrom ..clients.supabase import SupabaseClient\nfrom ..templates import get_template, BaseTemplate\nfrom .cost_tracker import CostTracker\nfrom .ocr import OCRService\nfrom .cache import CacheService\nfrom .transform import (\n    extract_source_dict,\n    enrich_source_credibility,\n    enrich_findings_with_ids_and_sources,\n)\n\nif TYPE_CHECKING:\n    from .progress import ProgressEmitter\n\nlogger = logging.getLogger(__name__)\n\n\nclass ResearchService:\n    \"\"\"Orchestrates the research process.\"\"\"\n\n    def __init__(\n        self,\n        gemini_client: GeminiClient,\n        supabase_client: Optional[SupabaseClient] = None,\n        ocr_service: Optional[OCRService] = None,\n        progress_emitter: Optional[\"ProgressEmitter\"] = None,\n    ):\n        self.gemini = gemini_client\n        self.supabase = supabase_client\n        self.ocr = ocr_service\n        self.cost_tracker = CostTracker()\n        self.progress = progress_emitter\n\n    async def execute_research(\n        self,\n        query: str,\n        template_type: str = \"investigative\",\n        granularity: str = \"standard\",\n        max_searches: int = 5,\n        perspectives: Optional[List[str]] = None,\n        input_file_url: Optional[str] = None,\n        input_text: Optional[str] = None,\n        save_to_db: bool = True,\n        workspace_id: str = \"apify\",\n        use_cache: bool = True,\n        extend_cache: bool = True,\n        intent: Optional[str] = None,\n        intent_config: Optional[Dict[str, Any]] = None,\n    ) -> Dict[str, Any]:\n        \"\"\"\n        Execute a complete research session.\n\n        Args:\n            use_cache: Check for and return cached results for identical queries\n            extend_cache: If cache hit, extend with new research in background\n            intent: Requestor's decision intent (investment_sizing, risk_assessment, etc.)\n            intent_config: Configuration dict from ActorInput.get_intent_config()\n\n        Returns:\n            Dict with session_id, findings, perspectives, sources, etc.\n        \"\"\"\n        start_time = time.time()\n        session_id = str(uuid4())\n        errors = []\n        warnings = []\n\n        # Initialize cache service\n        cache_service = CacheService()\n        cache_key = cache_service.get_cache_key(query, template_type, granularity)\n        cache_hit = False\n        original_cached_at = None\n\n        # Check cache if enabled\n        if use_cache and cache_service.is_available():\n            cached = await cache_service.get_cached(cache_key)\n            if cached:\n                logger.info(f\"Cache hit for query: {query[:50]}...\")\n                cache_hit = True\n                original_cached_at = cached.get(\"cached_at\")\n\n                # Update access count\n                await cache_service.update_access(cache_key)\n\n                # Return cached result with cache metadata\n                cached_result = cached.get(\"result\", {})\n                cached_result[\"cache_hit\"] = True\n                cached_result[\"cache_extended\"] = False\n                cached_result[\"original_cached_at\"] = original_cached_at\n                cached_result[\"execution_time_seconds\"] = round(time.time() - start_time, 2)\n\n                # Log cache hit (event emitter doesn't have cache_hit method)\n                logger.info(f\"Cache hit for query: {query[:50]}...\")\n\n                return cached_result\n\n        # Initialize template\n        template = get_template(template_type)\n        template.set_client(self.gemini)\n\n        # Emit initialization\n        if self.progress:\n            await self.progress.initialized(query, template_type, granularity, max_searches)\n\n        # Build context from input file/text\n        context_text = \"\"\n        if input_file_url and self.ocr:\n            try:\n                logger.info(f\"Processing input file: {input_file_url}\")\n                ocr_result = await self.ocr.process_file_url(input_file_url)\n                context_text = ocr_result.get(\"text\", \"\")\n                self.cost_tracker.add_openrouter_usage(ocr_result.get(\"tokens\", 0))\n            except Exception as e:\n                warnings.append(f\"Failed to process input file: {str(e)}\")\n                logger.warning(f\"OCR failed: {e}\")\n\n        if input_text:\n            context_text = f\"{context_text}\\n\\n{input_text}\" if context_text else input_text\n\n        # Create session in database\n        db_session = None\n        if save_to_db and self.supabase:\n            try:\n                db_session = await self.supabase.create_session(\n                    title=f\"Research: {query[:50]}...\",\n                    query=query,\n                    template_type=template_type,\n                    parameters={\n                        \"granularity\": granularity,\n                        \"max_searches\": max_searches,\n                        \"perspectives\": perspectives,\n                    },\n                )\n                session_id = db_session.get(\"id\", session_id)\n            except Exception as e:\n                warnings.append(f\"Failed to create database session: {str(e)}\")\n                logger.warning(f\"DB session creation failed: {e}\")\n\n        # Phase 1: Generate search queries\n        logger.info(\"Generating search queries...\")\n        search_queries = await template.generate_search_queries(\n            query=query,\n            max_searches=max_searches,\n            granularity=granularity,\n        )\n\n        if not search_queries:\n            errors.append(\"Failed to generate search queries\")\n            if self.progress:\n                await self.progress.failed(\"Failed to generate search queries\", \"QUERY_GENERATION_FAILED\", \"query_generation\")\n            return self._build_error_result(session_id, query, template_type, errors, start_time)\n\n        # Emit query generation\n        if self.progress:\n            await self.progress.queries_generated(len(search_queries), search_queries)\n\n        # Phase 2: Execute searches\n        logger.info(f\"Executing {len(search_queries)} searches...\")\n        all_sources: List[Dict[str, Any]] = []\n        all_content: List[str] = []\n\n        # Add context if available\n        if context_text:\n            all_content.append(f\"## Input Context\\n\\n{context_text}\")\n\n        for i, search_query in enumerate(search_queries):\n            try:\n                # Emit search started\n                if self.progress:\n                    await self.progress.search_started(i, search_query, len(search_queries))\n\n                logger.debug(f\"Search {i+1}/{len(search_queries)}: {search_query[:50]}...\")\n                result = await self.gemini.research(search_query)\n\n                # Track tokens and cost\n                tokens_used = 0\n                cost_usd = 0.0\n                if result.token_usage:\n                    tokens_used = result.token_usage.input_tokens + result.token_usage.output_tokens\n                    self.cost_tracker.add_gemini_usage(\n                        result.token_usage.input_tokens,\n                        result.token_usage.output_tokens,\n                    )\n                    cost_usd = self.cost_tracker.get_summary().get(\"total_cost_usd\", 0.0) - (\n                        self.cost_tracker.get_summary().get(\"total_cost_usd\", 0.0) if i == 0 else 0\n                    )\n\n                # Collect sources using transform pipeline\n                sources_this_search = [extract_source_dict(s) for s in result.sources]\n                all_sources.extend(sources_this_search)\n\n                # Collect synthesized content\n                if result.text:\n                    all_content.append(f\"## Search: {search_query}\\n\\n{result.text}\")\n\n                # Emit search completed\n                if self.progress:\n                    await self.progress.search_completed(\n                        i, len(sources_this_search), 0,  # Findings counted later\n                        total=len(search_queries),\n                        tokens_used=tokens_used, cost_usd=cost_usd\n                    )\n\n                # Save query to database\n                if save_to_db and self.supabase:\n                    try:\n                        await self.supabase.save_query(\n                            session_id=session_id,\n                            query_text=search_query,\n                            query_purpose=f\"Search query {i+1}\",\n                            query_round=1,\n                            result_count=len(result.sources),\n                        )\n                    except Exception as e:\n                        logger.warning(f\"Failed to save query: {e}\")\n\n            except Exception as e:\n                warnings.append(f\"Search failed for '{search_query[:30]}...': {str(e)}\")\n                logger.warning(f\"Search failed: {e}\")\n\n        # Deduplicate sources\n        seen_urls = set()\n        unique_sources = []\n        for source in all_sources:\n            if source[\"url\"] not in seen_urls:\n                seen_urls.add(source[\"url\"])\n                unique_sources.append(source)\n\n        # Phase 3: Assess credibility using transform pipeline\n        for source in unique_sources:\n            enrich_source_credibility(source)\n\n        # Save sources\n        if save_to_db and self.supabase:\n            try:\n                await self.supabase.save_sources(session_id, unique_sources)\n            except Exception as e:\n                logger.warning(f\"Failed to save sources: {e}\")\n\n        # Phase 4: Extract findings\n        logger.info(\"Extracting findings...\")\n        synthesized_content = \"\\n\\n---\\n\\n\".join(all_content)\n        findings = await template.extract_findings(\n            query=query,\n            sources=unique_sources,\n            synthesized_content=synthesized_content,\n            granularity=granularity,\n        )\n\n        # Enrich findings with IDs and supporting sources using transform pipeline\n        findings = enrich_findings_with_ids_and_sources(findings, unique_sources)\n\n        # Phase 4.5: Verify findings (bias detection, sanity check, cross-reference)\n        logger.info(\"Verifying findings...\")\n        if self.progress:\n            await self.progress.verification_started()\n        try:\n            findings = await template.verify_findings(\n                findings=findings,\n                sources=unique_sources,\n                original_query=query,\n            )\n            logger.info(f\"Verified {len(findings)} findings\")\n            if self.progress:\n                await self.progress.verification_completed(len(findings))\n        except Exception as e:\n            warnings.append(f\"Finding verification failed: {str(e)}\")\n            logger.warning(f\"Verification failed: {e}\")\n\n        # Save findings\n        if save_to_db and self.supabase:\n            try:\n                await self.supabase.save_findings(session_id, findings)\n            except Exception as e:\n                logger.warning(f\"Failed to save findings: {e}\")\n\n        # Phase 5: Multi-perspective analysis\n        logger.info(\"Running perspective analysis...\")\n        perspectives_to_run = perspectives or template.default_perspectives\n\n        # Emit perspectives started\n        if self.progress:\n            await self.progress.perspectives_started(perspectives_to_run)\n\n        perspective_results = []\n        total_insights = 0\n\n        for perspective_type in perspectives_to_run:\n            try:\n                analysis = await template.analyze_perspective(\n                    perspective_type=perspective_type,\n                    findings=findings,\n                    sources=unique_sources,\n                    original_query=query,\n                )\n                perspective_results.append(analysis)\n                # Count insights from this perspective\n                total_insights += len(analysis.get(\"key_insights\", []))\n\n            except Exception as e:\n                warnings.append(f\"Perspective analysis failed for '{perspective_type}': {str(e)}\")\n                logger.warning(f\"Perspective failed: {e}\")\n\n        # Emit perspectives completed\n        if self.progress:\n            await self.progress.perspectives_completed(len(perspective_results), total_insights)\n\n        # Save perspectives\n        if save_to_db and self.supabase:\n            try:\n                await self.supabase.save_perspectives(session_id, perspective_results)\n            except Exception as e:\n                logger.warning(f\"Failed to save perspectives: {e}\")\n\n        # Phase 6: Intelligence analysis (contradictions, gaps, role summaries)\n        logger.info(\"Running intelligence analysis...\")\n        intelligence_results = {}\n        try:\n            from .intelligence import IntelligenceAnalyzer\n            analyzer = IntelligenceAnalyzer(gemini_client=self.gemini)\n            intelligence_results = await analyzer.analyze(\n                findings=findings,\n                perspectives=perspective_results,\n                sources=unique_sources,\n                query=query,\n                template=template_type,\n            )\n            logger.info(\n                f\"Intelligence analysis complete: \"\n                f\"{len(intelligence_results.get('contradictions', []))} contradictions, \"\n                f\"{len(intelligence_results.get('knowledge_gaps', []))} gaps, \"\n                f\"{len(intelligence_results.get('role_summaries', {}))} role summaries\"\n            )\n        except Exception as e:\n            warnings.append(f\"Intelligence analysis failed: {str(e)}\")\n            logger.warning(f\"Intelligence analysis failed: {e}\")\n\n        # Complete session\n        if save_to_db and self.supabase:\n            try:\n                await self.supabase.complete_session(\n                    session_id,\n                    cost_summary=self.cost_tracker.get_summary(),\n                )\n            except Exception as e:\n                logger.warning(f\"Failed to complete session: {e}\")\n\n        execution_time = time.time() - start_time\n\n        # Build result\n        result = {\n            \"session_id\": session_id,\n            \"query\": query,\n            \"template\": template_type,\n            \"status\": \"completed\" if not errors else \"partial\",\n            \"findings\": findings,\n            \"perspectives\": perspective_results,\n            \"sources\": unique_sources,\n            \"search_queries_executed\": search_queries,\n            \"cost_summary\": self.cost_tracker.get_summary(),\n            \"execution_time_seconds\": round(execution_time, 2),\n            \"supabase_session_id\": session_id if save_to_db and self.supabase else None,\n            \"errors\": errors,\n            \"warnings\": warnings,\n            \"cache_hit\": False,\n            \"cache_extended\": False,\n            \"original_cached_at\": None,\n            # Intelligence analysis results\n            \"contradictions\": intelligence_results.get(\"contradictions\", []),\n            \"knowledge_gaps\": intelligence_results.get(\"knowledge_gaps\", []),\n            \"role_summaries\": intelligence_results.get(\"role_summaries\", {}),\n            # Intent configuration for report generation\n            \"intent\": intent,\n            \"intent_config\": intent_config or {},\n        }\n\n        # Cache the result if caching is enabled\n        if use_cache and cache_service.is_available() and not errors:\n            try:\n                await cache_service.set_cached(\n                    cache_key=cache_key,\n                    result=result,\n                    findings_count=len(findings),\n                    sources_count=len(unique_sources),\n                )\n                logger.info(f\"Cached research result: {cache_key}\")\n            except Exception as e:\n                logger.warning(f\"Failed to cache result: {e}\")\n\n        return result\n\n    def _build_error_result(\n        self,\n        session_id: str,\n        query: str,\n        template: str,\n        errors: List[str],\n        start_time: float,\n    ) -> Dict[str, Any]:\n        \"\"\"Build error result when research fails.\"\"\"\n        return {\n            \"session_id\": session_id,\n            \"query\": query,\n            \"template\": template,\n            \"status\": \"failed\",\n            \"findings\": [],\n            \"perspectives\": [],\n            \"sources\": [],\n            \"search_queries_executed\": [],\n            \"cost_summary\": self.cost_tracker.get_summary(),\n            \"execution_time_seconds\": round(time.time() - start_time, 2),\n            \"supabase_session_id\": None,\n            \"errors\": errors,\n            \"warnings\": [],\n        }\n","numLines":423,"startLine":1,"totalLines":423}}}
[2026-01-30T14:24:43.648Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DNHTC6gFnNBe7Tj45wsPLK","type":"tool_result","content":"     1→\"\"\"Research orchestration service.\"\"\"\n     2→\n     3→import time\n     4→import logging\n     5→from typing import List, Dict, Any, Optional, TYPE_CHECKING\n     6→from uuid import uuid4\n     7→\n     8→from ..clients.gemini import GeminiClient, Source as GeminiSource\n     9→from ..clients.supabase import SupabaseClient\n    10→from ..templates import get_template, BaseTemplate\n    11→from .cost_tracker import CostTracker\n    12→from .ocr import OCRService\n    13→from .cache import CacheService\n    14→\n    15→if TYPE_CHECKING:\n    16→    from .status import StatusReporter\n    17→    from .events import EventEmitter\n    18→\n    19→logger = logging.getLogger(__name__)\n    20→\n    21→\n    22→class ResearchService:\n    23→    \"\"\"Orchestrates the research process.\"\"\"\n    24→\n    25→    def __init__(\n    26→        self,\n    27→        gemini_client: GeminiClient,\n    28→        supabase_client: Optional[SupabaseClient] = None,\n    29→        ocr_service: Optional[OCRService] = None,\n    30→        status_reporter: Optional[\"StatusReporter\"] = None,\n    31→        event_emitter: Optional[\"EventEmitter\"] = None,\n    32→    ):\n    33→        self.gemini = gemini_client\n    34→        self.supabase = supabase_client\n    35→        self.ocr = ocr_service\n    36→        self.cost_tracker = CostTracker()\n    37→        self.status = status_reporter\n    38→        self.events = event_emitter\n    39→\n    40→    async def execute_research(\n    41→        self,\n    42→        query: str,\n    43→        template_type: str = \"investigative\",\n    44→        granularity: str = \"standard\",\n    45→        max_searches: int = 5,\n    46→        perspectives: Optional[List[str]] = None,\n    47→        input_file_url: Optional[str] = None,\n    48→        input_text: Optional[str] = None,\n    49→        save_to_db: bool = True,\n    50→        workspace_id: str = \"apify\",\n    51→        use_cache: bool = True,\n    52→        extend_cache: bool = True,\n    53→    ) -> Dict[str, Any]:\n    54→        \"\"\"\n    55→        Execute a complete research session.\n    56→\n    57→        Args:\n    58→            use_cache: Check for and return cached results for identical queries\n    59→            extend_cache: If cache hit, extend with new research in background\n    60→\n    61→        Returns:\n    62→            Dict with session_id, findings, perspectives, sources, etc.\n    63→        \"\"\"\n    64→        start_time = time.time()\n    65→        session_id = str(uuid4())\n    66→        errors = []\n    67→        warnings = []\n    68→\n    69→        # Initialize cache service\n    70→        cache_service = CacheService()\n    71→        cache_key = cache_service.get_cache_key(query, template_type, granularity)\n    72→        cache_hit = False\n    73→        original_cached_at = None\n    74→\n    75→        # Check cache if enabled\n    76→        if use_cache and cache_service.is_available():\n    77→            cached = await cache_service.get_cached(cache_key)\n    78→            if cached:\n    79→                logger.info(f\"Cache hit for query: {query[:50]}...\")\n    80→                cache_hit = True\n    81→                original_cached_at = cached.get(\"cached_at\")\n    82→\n    83→                # Update access count\n    84→                await cache_service.update_access(cache_key)\n    85→\n    86→                # Return cached result with cache metadata\n    87→                cached_result = cached.get(\"result\", {})\n    88→                cached_result[\"cache_hit\"] = True\n    89→                cached_result[\"cache_extended\"] = False\n    90→                cached_result[\"original_cached_at\"] = original_cached_at\n    91→                cached_result[\"execution_time_seconds\"] = round(time.time() - start_time, 2)\n    92→\n    93→                # Log cache hit (event emitter doesn't have cache_hit method)\n    94→                logger.info(f\"Cache hit for query: {query[:50]}...\")\n    95→\n    96→                return cached_result\n    97→\n    98→        # Initialize template\n    99→        template = get_template(template_type)\n   100→        template.set_client(self.gemini)\n   101→\n   102→        # Emit initialization status/event\n   103→        if self.status:\n   104→            await self.status.initialized(query, template_type, granularity, max_searches)\n   105→        if self.events:\n   106→            await self.events.initialized(query, template_type, granularity)\n   107→\n   108→        # Build context from input file/text\n   109→        context_text = \"\"\n   110→        if input_file_url and self.ocr:\n   111→            try:\n   112→                logger.info(f\"Processing input file: {input_file_url}\")\n   113→                ocr_result = await self.ocr.process_file_url(input_file_url)\n   114→                context_text = ocr_result.get(\"text\", \"\")\n   115→                self.cost_tracker.add_openrouter_usage(ocr_result.get(\"tokens\", 0))\n   116→            except Exception as e:\n   117→                warnings.append(f\"Failed to process input file: {str(e)}\")\n   118→                logger.warning(f\"OCR failed: {e}\")\n   119→\n   120→        if input_text:\n   121→            context_text = f\"{context_text}\\n\\n{input_text}\" if context_text else input_text\n   122→\n   123→        # Create session in database\n   124→        db_session = None\n   125→        if save_to_db and self.supabase:\n   126→            try:\n   127→                db_session = await self.supabase.create_session(\n   128→                    title=f\"Research: {query[:50]}...\",\n   129→                    query=query,\n   130→                    template_type=template_type,\n   131→                    parameters={\n   132→                        \"granularity\": granularity,\n   133→                        \"max_searches\": max_searches,\n   134→                        \"perspectives\": perspectives,\n   135→                    },\n   136→                )\n   137→                session_id = db_session.get(\"id\", session_id)\n   138→            except Exception as e:\n   139→                warnings.append(f\"Failed to create database session: {str(e)}\")\n   140→                logger.warning(f\"DB session creation failed: {e}\")\n   141→\n   142→        # Phase 0.5: Topic detection and linking\n   143→        primary_topic_id = None\n   144→        if save_to_db and self.supabase:\n   145→            try:\n   146→                # Extract topic from query\n   147→                topic_info = await self._extract_topic(query, template_type)\n   148→                if topic_info:\n   149→                    topic = await self.supabase.find_or_create_topic(\n   150→                        name=topic_info.get(\"name\", query[:50]),\n   151→                        topic_type=topic_info.get(\"type\", \"concept\"),\n   152→                        description=topic_info.get(\"description\"),\n   153→                    )\n   154→                    primary_topic_id = topic.get(\"id\")\n   155→                    await self.supabase.link_session_to_topic(\n   156→                        session_id=session_id,\n   157→                        topic_id=primary_topic_id,\n   158→                        is_primary=True,\n   159→                    )\n   160→                    logger.info(f\"Linked session to topic: {topic.get('name')}\")\n   161→            except Exception as e:\n   162→                logger.warning(f\"Topic detection failed: {e}\")\n   163→\n   164→        # Phase 1: Generate search queries\n   165→        logger.info(\"Generating search queries...\")\n   166→        search_queries = await template.generate_search_queries(\n   167→            query=query,\n   168→            max_searches=max_searches,\n   169→            granularity=granularity,\n   170→        )\n   171→\n   172→        if not search_queries:\n   173→            errors.append(\"Failed to generate search queries\")\n   174→            if self.status:\n   175→                await self.status.failed(\"Failed to generate search queries\", \"query_generation\")\n   176→            if self.events:\n   177→                await self.events.failed(\"Failed to generate search queries\", \"QUERY_GENERATION_FAILED\", \"query_generation\")\n   178→            return self._build_error_result(session_id, query, template_type, errors, start_time)\n   179→\n   180→        # Emit query generation status/event\n   181→        if self.status:\n   182→            await self.status.queries_generated(len(search_queries), search_queries)\n   183→        if self.events:\n   184→            await self.events.queries_generated(search_queries)\n   185→\n   186→        # Phase 2: Execute searches\n   187→        logger.info(f\"Executing {len(search_queries)} searches...\")\n   188→        all_sources: List[Dict[str, Any]] = []\n   189→        all_content: List[str] = []\n   190→\n   191→        # Add context if available\n   192→        if context_text:\n   193→            all_content.append(f\"## Input Context\\n\\n{context_text}\")\n   194→\n   195→        for i, search_query in enumerate(search_queries):\n   196→            try:\n   197→                # Emit search started\n   198→                if self.status:\n   199→                    await self.status.search_started(i, search_query)\n   200→                if self.events:\n   201→                    await self.events.search_started(i, search_query, len(search_queries))\n   202→\n   203→                logger.debug(f\"Search {i+1}/{len(search_queries)}: {search_query[:50]}...\")\n   204→                result = await self.gemini.research(search_query)\n   205→\n   206→                # Track tokens and cost\n   207→                tokens_used = 0\n   208→                cost_usd = 0.0\n   209→                if result.token_usage:\n   210→                    tokens_used = result.token_usage.input_tokens + result.token_usage.output_tokens\n   211→                    self.cost_tracker.add_gemini_usage(\n   212→                        result.token_usage.input_tokens,\n   213→                        result.token_usage.output_tokens,\n   214→                    )\n   215→                    cost_usd = self.cost_tracker.get_summary().get(\"total_cost_usd\", 0.0) - (\n   216→                        self.cost_tracker.get_summary().get(\"total_cost_usd\", 0.0) if i == 0 else 0\n   217→                    )\n   218→\n   219→                # Collect sources\n   220→                sources_this_search = []\n   221→                for source in result.sources:\n   222→                    source_dict = {\n   223→                        \"url\": source.url,\n   224→                        \"title\": source.title,\n   225→                        \"domain\": source.domain,\n   226→                        \"snippet\": source.snippet,\n   227→                        \"source_type\": source.source_type,\n   228→                    }\n   229→                    all_sources.append(source_dict)\n   230→                    sources_this_search.append(source_dict)\n   231→\n   232→                # Collect synthesized content\n   233→                if result.text:\n   234→                    all_content.append(f\"## Search: {search_query}\\n\\n{result.text}\")\n   235→\n   236→                # Emit search completed\n   237→                if self.status:\n   238→                    await self.status.search_completed(i, len(sources_this_search), 0)  # Findings counted later\n   239→                if self.events:\n   240→                    await self.events.search_completed(\n   241→                        i, len(search_queries), len(sources_this_search), 0,\n   242→                        tokens_used=tokens_used, cost_usd=cost_usd\n   243→                    )\n   244→\n   245→                # Save query to database\n   246→                if save_to_db and self.supabase:\n   247→                    try:\n   248→                        await self.supabase.save_query(\n   249→                            session_id=session_id,\n   250→                            query_text=search_query,\n   251→                            query_purpose=f\"Search query {i+1}\",\n   252→                            query_round=1,\n   253→                            result_count=len(result.sources),\n   254→                        )\n   255→                    except Exception as e:\n   256→                        logger.warning(f\"Failed to save query: {e}\")\n   257→\n   258→            except Exception as e:\n   259→                warnings.append(f\"Search failed for '{search_query[:30]}...': {str(e)}\")\n   260→                logger.warning(f\"Search failed: {e}\")\n   261→\n   262→        # Deduplicate sources\n   263→        seen_urls = set()\n   264→        unique_sources = []\n   265→        for source in all_sources:\n   266→            if source[\"url\"] not in seen_urls:\n   267→                seen_urls.add(source[\"url\"])\n   268→                unique_sources.append(source)\n   269→\n   270→        # Phase 3: Assess credibility (simple heuristic)\n   271→        for source in unique_sources:\n   272→            source[\"credibility_score\"] = self._assess_credibility(source)\n   273→            source[\"credibility_label\"] = self._credibility_label(source[\"credibility_score\"])\n   274→\n   275→        # Save sources and get URL->UUID mapping for linking\n   276→        source_id_map: dict = {}\n   277→        if save_to_db and self.supabase:\n   278→            try:\n   279→                _, source_id_map = await self.supabase.save_sources_and_get_mapping(session_id, unique_sources)\n   280→                logger.info(f\"Saved {len(source_id_map)} sources with UUID mapping\")\n   281→            except Exception as e:\n   282→                logger.warning(f\"Failed to save sources: {e}\")\n   283→\n   284→        # Phase 4: Extract findings\n   285→        logger.info(\"Extracting findings...\")\n   286→        synthesized_content = \"\\n\\n---\\n\\n\".join(all_content)\n   287→        findings = await template.extract_findings(\n   288→            query=query,\n   289→            sources=unique_sources,\n   290→            synthesized_content=synthesized_content,\n   291→            granularity=granularity,\n   292→        )\n   293→\n   294→        # Add IDs to findings\n   295→        for i, finding in enumerate(findings):\n   296→            finding[\"finding_id\"] = f\"f{i+1}\"\n   297→            finding[\"supporting_sources\"] = [\n   298→                {\"url\": s[\"url\"], \"title\": s[\"title\"]}\n   299→                for s in unique_sources[:3]\n   300→            ]\n   301→\n   302→        # Phase 4.5: Verify findings (bias detection, sanity check, cross-reference)\n   303→        logger.info(\"Verifying findings...\")\n   304→        if self.status:\n   305→            await self.status.verification_started()\n   306→        try:\n   307→            findings = await template.verify_findings(\n   308→                findings=findings,\n   309→                sources=unique_sources,\n   310→                original_query=query,\n   311→            )\n   312→            logger.info(f\"Verified {len(findings)} findings\")\n   313→            if self.status:\n   314→                await self.status.verification_completed(len(findings))\n   315→            if self.events:\n   316→                await self.events.verification_completed(len(findings))\n   317→        except Exception as e:\n   318→            warnings.append(f\"Finding verification failed: {str(e)}\")\n   319→            logger.warning(f\"Verification failed: {e}\")\n   320→\n   321→        # Save findings with proper source linking\n   322→        saved_findings = []\n   323→        if save_to_db and self.supabase:\n   324→            try:\n   325→                saved_findings = await self.supabase.save_findings_with_sources(\n   326→                    session_id, findings, source_id_map\n   327→                )\n   328→                logger.info(f\"Saved {len(saved_findings)} findings with source links\")\n   329→            except Exception as e:\n   330→                logger.warning(f\"Failed to save findings: {e}\")\n   331→\n   332→        # Phase 4.25: Entity extraction and knowledge claim creation\n   333→        if save_to_db and self.supabase and findings:\n   334→            try:\n   335→                entities_data = await self._extract_entities(findings, query)\n   336→                if entities_data:\n   337→                    saved_entities = await self.supabase.save_entities_batch(entities_data)\n   338→                    logger.info(f\"Extracted and saved {len(saved_entities)} entities\")\n   339→\n   340→                    # Create knowledge claims from high-confidence findings\n   341→                    for i, finding in enumerate(findings):\n   342→                        if finding.get(\"confidence_score\", 0) >= 0.6:\n   343→                            try:\n   344→                                claim = await self.supabase.create_knowledge_claim(\n   345→                                    content=finding.get(\"content\", \"\"),\n   346→                                    claim_type=self._map_finding_to_claim_type(finding.get(\"finding_type\", \"fact\")),\n   347→                                    topic_id=primary_topic_id,\n   348→                                    session_id=session_id,\n   349→                                    confidence_score=finding.get(\"confidence_score\", 0.5),\n   350→                                    summary=finding.get(\"summary\"),\n   351→                                    temporal_context=finding.get(\"temporal_context\"),\n   352→                                    extracted_data=finding.get(\"extracted_data\"),\n   353→                                )\n   354→\n   355→                                # Link finding to claim\n   356→                                if saved_findings and i < len(saved_findings):\n   357→                                    await self.supabase.client.table(\"research_findings\").update({\n   358→                                        \"knowledge_claim_id\": claim.get(\"id\"),\n   359→                                        \"is_promoted\": True,\n   360→                                        \"promotion_type\": \"created\",\n   361→                                    }).eq(\"id\", saved_findings[i].get(\"id\")).execute()\n   362→\n   363→                                # Link entities to claim\n   364→                                for entity in saved_entities:\n   365→                                    entity_name = entity.get(\"canonical_name\", \"\").lower()\n   366→                                    if entity_name in finding.get(\"content\", \"\").lower():\n   367→                                        await self.supabase.link_claim_to_entity(\n   368→                                            claim_id=claim.get(\"id\"),\n   369→                                            entity_id=entity.get(\"id\"),\n   370→                                            role=\"mentioned\",\n   371→                                        )\n   372→                            except Exception as e:\n   373→                                logger.debug(f\"Failed to create claim from finding: {e}\")\n   374→            except Exception as e:\n   375→                logger.warning(f\"Entity extraction failed: {e}\")\n   376→\n   377→        # Phase 5: Multi-perspective analysis\n   378→        logger.info(\"Running perspective analysis...\")\n   379→        perspectives_to_run = perspectives or template.default_perspectives\n   380→\n   381→        # Emit perspectives started\n   382→        if self.status:\n   383→            await self.status.perspectives_started(perspectives_to_run)\n   384→        if self.events:\n   385→            await self.events.perspectives_started(perspectives_to_run)\n   386→\n   387→        perspective_results = []\n   388→        total_insights = 0\n   389→\n   390→        for perspective_type in perspectives_to_run:\n   391→            try:\n   392→                analysis = await template.analyze_perspective(\n   393→                    perspective_type=perspective_type,\n   394→                    findings=findings,\n   395→                    sources=unique_sources,\n   396→                    original_query=query,\n   397→                )\n   398→                perspective_results.append(analysis)\n   399→                # Count insights from this perspective\n   400→                total_insights += len(analysis.get(\"key_insights\", []))\n   401→\n   402→            except Exception as e:\n   403→                warnings.append(f\"Perspective analysis failed for '{perspective_type}': {str(e)}\")\n   404→                logger.warning(f\"Perspective failed: {e}\")\n   405→\n   406→        # Emit perspectives completed\n   407→        if self.status:\n   408→            await self.status.perspectives_completed(len(perspective_results), total_insights)\n   409→        if self.events:\n   410→            await self.events.perspectives_completed(len(perspective_results), total_insights)\n   411→\n   412→        # Save perspectives\n   413→        if save_to_db and self.supabase:\n   414→            try:\n   415→                await self.supabase.save_perspectives(session_id, perspective_results)\n   416→            except Exception as e:\n   417→                logger.warning(f\"Failed to save perspectives: {e}\")\n   418→\n   419→        # Phase 5.5: Detect gaps and contradictions\n   420→        gaps_detected = []\n   421→        contradictions_detected = []\n   422→        if save_to_db and self.supabase and findings:\n   423→            try:\n   424→                analysis = await self._analyze_gaps_and_contradictions(findings, query)\n   425→\n   426→                # Save gaps\n   427→                for gap in analysis.get(\"gaps\", []):\n   428→                    saved_gap = await self.supabase.save_gap(\n   429→                        session_id=session_id,\n   430→                        description=gap.get(\"description\", \"\"),\n   431→                        gap_type=gap.get(\"type\", \"information\"),\n   432→                        priority=gap.get(\"priority\", 2),\n   433→                        suggested_queries=gap.get(\"suggested_queries\", []),\n   434→                    )\n   435→                    gaps_detected.append(saved_gap)\n   436→\n   437→                # Save contradictions (would need finding IDs)\n   438→                for contradiction in analysis.get(\"contradictions\", []):\n   439→                    contradictions_detected.append(contradiction)\n   440→                    # Note: Full contradiction linking requires finding IDs\n   441→\n   442→                logger.info(f\"Detected {len(gaps_detected)} gaps and {len(contradictions_detected)} contradictions\")\n   443→            except Exception as e:\n   444→                logger.warning(f\"Gap/contradiction analysis failed: {e}\")\n   445→\n   446→        # Complete session\n   447→        if save_to_db and self.supabase:\n   448→            try:\n   449→                await self.supabase.complete_session(\n   450→                    session_id,\n   451→                    cost_summary=self.cost_tracker.get_summary(),\n   452→                    findings_count=len(findings),\n   453→                    sources_count=len(unique_sources),\n   454→                )\n   455→            except Exception as e:\n   456→                logger.warning(f\"Failed to complete session: {e}\")\n   457→\n   458→        execution_time = time.time() - start_time\n   459→\n   460→        # Build result\n   461→        result = {\n   462→            \"session_id\": session_id,\n   463→            \"query\": query,\n   464→            \"template\": template_type,\n   465→            \"status\": \"completed\" if not errors else \"partial\",\n   466→            \"findings\": findings,\n   467→            \"perspectives\": perspective_results,\n   468→            \"sources\": unique_sources,\n   469→            \"search_queries_executed\": search_queries,\n   470→            \"cost_summary\": self.cost_tracker.get_summary(),\n   471→            \"execution_time_seconds\": round(execution_time, 2),\n   472→            \"supabase_session_id\": session_id if save_to_db and self.supabase else None,\n   473→            \"primary_topic_id\": primary_topic_id,\n   474→            \"gaps\": gaps_detected,\n   475→            \"contradictions\": contradictions_detected,\n   476→            \"errors\": errors,\n   477→            \"warnings\": warnings,\n   478→            \"cache_hit\": False,\n   479→            \"cache_extended\": False,\n   480→            \"original_cached_at\": None,\n   481→        }\n   482→\n   483→        # Cache the result if caching is enabled\n   484→        if use_cache and cache_service.is_available() and not errors:\n   485→            try:\n   486→                await cache_service.set_cached(\n   487→                    cache_key=cache_key,\n   488→                    result=result,\n   489→                    findings_count=len(findings),\n   490→                    sources_count=len(unique_sources),\n   491→                )\n   492→                logger.info(f\"Cached research result: {cache_key}\")\n   493→            except Exception as e:\n   494→                logger.warning(f\"Failed to cache result: {e}\")\n   495→\n   496→        return result\n   497→\n   498→    def _assess_credibility(self, source: Dict[str, Any]) -> float:\n   499→        \"\"\"Simple credibility assessment based on domain.\"\"\"\n   500→        domain = source.get(\"domain\", \"\").lower()\n   501→\n   502→        # High credibility domains\n   503→        if any(d in domain for d in [\n   504→            \"gov\", \"edu\", \"reuters\", \"ap\", \"bbc\", \"nytimes\",\n   505→            \"wsj\", \"ft.com\", \"bloomberg\", \"sec.gov\"\n   506→        ]):\n   507→            return 0.85\n   508→\n   509→        # Medium-high credibility\n   510→        if any(d in domain for d in [\n   511→            \"forbes\", \"businessinsider\", \"cnbc\", \"marketwatch\",\n   512→            \"yahoo\", \"cnn\", \"washingtonpost\"\n   513→        ]):\n   514→            return 0.70\n   515→\n   516→        # Default medium credibility\n   517→        return 0.55\n   518→\n   519→    def _credibility_label(self, score: float) -> str:\n   520→        \"\"\"Get credibility label from score.\"\"\"\n   521→        if score >= 0.8:\n   522→            return \"high\"\n   523→        elif score >= 0.6:\n   524→            return \"medium\"\n   525→        else:\n   526→            return \"low\"\n   527→\n   528→    def _build_error_result(\n   529→        self,\n   530→        session_id: str,\n   531→        query: str,\n   532→        template: str,\n   533→        errors: List[str],\n   534→        start_time: float,\n   535→    ) -> Dict[str, Any]:\n   536→        \"\"\"Build error result when research fails.\"\"\"\n   537→        return {\n   538→            \"session_id\": session_id,\n   539→            \"query\": query,\n   540→            \"template\": template,\n   541→            \"status\": \"failed\",\n   542→            \"findings\": [],\n   543→            \"perspectives\": [],\n   544→            \"sources\": [],\n   545→            \"search_queries_executed\": [],\n   546→            \"cost_summary\": self.cost_tracker.get_summary(),\n   547→            \"execution_time_seconds\": round(time.time() - start_time, 2),\n   548→            \"supabase_session_id\": None,\n   549→            \"errors\": errors,\n   550→            \"warnings\": [],\n   551→        }\n   552→\n   553→    async def _extract_topic(\n   554→        self,\n   555→        query: str,\n   556→        template_type: str,\n   557→    ) -> Optional[Dict[str, Any]]:\n   558→        \"\"\"Extract topic information from query using LLM.\"\"\"\n   559→        prompt = f\"\"\"Analyze this research query and extract the main topic.\n   560→\n   561→QUERY: {query}\n   562→TEMPLATE TYPE: {template_type}\n   563→\n   564→Return JSON with:\n   565→- name: Short topic name (2-5 words, like \"Tesla Financial Health\" or \"AI Code Assistants\")\n   566→- type: One of: domain, event, entity, concept, region, timeperiod\n   567→- description: One sentence describing the topic\n   568→\n   569→Example output:\n   570→{{\"name\": \"OpenAI Corporate Strategy\", \"type\": \"entity\", \"description\": \"Analysis of OpenAI's business decisions and strategic direction\"}}\n   571→\"\"\"\n   572→        try:\n   573→            result, _ = await self.gemini.generate_json(prompt, temperature=0.2)\n   574→            if isinstance(result, dict) and result.get(\"name\"):\n   575→                return result\n   576→        except Exception as e:\n   577→            logger.warning(f\"Topic extraction failed: {e}\")\n   578→        return None\n   579→\n   580→    async def _extract_entities(\n   581→        self,\n   582→        findings: List[Dict[str, Any]],\n   583→        query: str,\n   584→    ) -> List[Dict[str, Any]]:\n   585→        \"\"\"Extract named entities from findings.\"\"\"\n   586→        # Combine findings content\n   587→        findings_text = \"\\n\".join([\n   588→            f\"- {f.get('content', '')[:300]}\"\n   589→            for f in findings[:15]\n   590→        ])\n   591→\n   592→        prompt = f\"\"\"Extract key named entities from these research findings.\n   593→\n   594→RESEARCH QUERY: {query}\n   595→\n   596→FINDINGS:\n   597→{findings_text}\n   598→\n   599→Extract people, organizations, locations, products, and key concepts.\n   600→Return JSON array of entities:\n   601→[\n   602→  {{\"name\": \"Entity Name\", \"type\": \"person|organization|location|product|concept|event\", \"description\": \"Brief description\"}},\n   603→  ...\n   604→]\n   605→\n   606→Only include clearly identifiable entities. Limit to 15 most important entities.\n   607→\"\"\"\n   608→        try:\n   609→            result, _ = await self.gemini.generate_json(prompt, temperature=0.2)\n   610→            if isinstance(result, list):\n   611→                return result\n   612→        except Exception as e:\n   613→            logger.warning(f\"Entity extraction failed: {e}\")\n   614→        return []\n   615→\n   616→    def _map_finding_to_claim_type(self, finding_type: str) -> str:\n   617→        \"\"\"Map finding type to knowledge claim type.\"\"\"\n   618→        mapping = {\n   619→            \"fact\": \"fact\",\n   620→            \"claim\": \"fact\",\n   621→            \"event\": \"event\",\n   622→            \"actor\": \"actor\",\n   623→            \"relationship\": \"relationship\",\n   624→            \"pattern\": \"pattern\",\n   625→            \"gap\": \"gap\",\n   626→            \"evidence\": \"evidence\",\n   627→        }\n   628→        return mapping.get(finding_type, \"fact\")\n   629→\n   630→    async def _analyze_gaps_and_contradictions(\n   631→        self,\n   632→        findings: List[Dict[str, Any]],\n   633→        query: str,\n   634→    ) -> Dict[str, Any]:\n   635→        \"\"\"Analyze findings for gaps and contradictions.\"\"\"\n   636→        findings_text = \"\\n\".join([\n   637→            f\"{i+1}. [{f.get('finding_type', 'fact')}] {f.get('summary', f.get('content', '')[:200])}\"\n   638→            for i, f in enumerate(findings[:20])\n   639→        ])\n   640→\n   641→        prompt = f\"\"\"Analyze these research findings for gaps and contradictions.\n   642→\n   643→RESEARCH QUERY: {query}\n   644→\n   645→FINDINGS:\n   646→{findings_text}\n   647→\n   648→Identify:\n   649→1. GAPS: What important questions remain unanswered? What information is missing?\n   650→2. CONTRADICTIONS: Do any findings conflict with each other?\n   651→\n   652→Return JSON:\n   653→{{\n   654→  \"gaps\": [\n   655→    {{\n   656→      \"description\": \"What's missing\",\n   657→      \"type\": \"information|verification|perspective|temporal\",\n   658→      \"priority\": 1-3 (1=high),\n   659→      \"suggested_queries\": [\"search query to fill gap\"]\n   660→    }}\n   661→  ],\n   662→  \"contradictions\": [\n   663→    {{\n   664→      \"finding_indices\": [1, 5],\n   665→      \"description\": \"How they contradict\",\n   666→      \"severity\": \"high|medium|low\"\n   667→    }}\n   668→  ]\n   669→}}\n   670→\n   671→Limit to 5 most important gaps and 3 most significant contradictions.\n   672→\"\"\"\n   673→        try:\n   674→            result, _ = await self.gemini.generate_json(prompt, temperature=0.3)\n   675→            if isinstance(result, dict):\n   676→                return result\n   677→        except Exception as e:\n   678→            logger.warning(f\"Gap/contradiction analysis failed: {e}\")\n   679→        return {\"gaps\": [], \"contradictions\": []}\n   680→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"063d9692-0974-4418-8890-3933b0ef315a","uuid":"42a63374-6932-41cc-a846-b1786069520e","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\serverless\\src\\services\\research.py","content":"\"\"\"Research orchestration service.\"\"\"\n\nimport time\nimport logging\nfrom typing import List, Dict, Any, Optional, TYPE_CHECKING\nfrom uuid import uuid4\n\nfrom ..clients.gemini import GeminiClient, Source as GeminiSource\nfrom ..clients.supabase import SupabaseClient\nfrom ..templates import get_template, BaseTemplate\nfrom .cost_tracker import CostTracker\nfrom .ocr import OCRService\nfrom .cache import CacheService\n\nif TYPE_CHECKING:\n    from .status import StatusReporter\n    from .events import EventEmitter\n\nlogger = logging.getLogger(__name__)\n\n\nclass ResearchService:\n    \"\"\"Orchestrates the research process.\"\"\"\n\n    def __init__(\n        self,\n        gemini_client: GeminiClient,\n        supabase_client: Optional[SupabaseClient] = None,\n        ocr_service: Optional[OCRService] = None,\n        status_reporter: Optional[\"StatusReporter\"] = None,\n        event_emitter: Optional[\"EventEmitter\"] = None,\n    ):\n        self.gemini = gemini_client\n        self.supabase = supabase_client\n        self.ocr = ocr_service\n        self.cost_tracker = CostTracker()\n        self.status = status_reporter\n        self.events = event_emitter\n\n    async def execute_research(\n        self,\n        query: str,\n        template_type: str = \"investigative\",\n        granularity: str = \"standard\",\n        max_searches: int = 5,\n        perspectives: Optional[List[str]] = None,\n        input_file_url: Optional[str] = None,\n        input_text: Optional[str] = None,\n        save_to_db: bool = True,\n        workspace_id: str = \"apify\",\n        use_cache: bool = True,\n        extend_cache: bool = True,\n    ) -> Dict[str, Any]:\n        \"\"\"\n        Execute a complete research session.\n\n        Args:\n            use_cache: Check for and return cached results for identical queries\n            extend_cache: If cache hit, extend with new research in background\n\n        Returns:\n            Dict with session_id, findings, perspectives, sources, etc.\n        \"\"\"\n        start_time = time.time()\n        session_id = str(uuid4())\n        errors = []\n        warnings = []\n\n        # Initialize cache service\n        cache_service = CacheService()\n        cache_key = cache_service.get_cache_key(query, template_type, granularity)\n        cache_hit = False\n        original_cached_at = None\n\n        # Check cache if enabled\n        if use_cache and cache_service.is_available():\n            cached = await cache_service.get_cached(cache_key)\n            if cached:\n                logger.info(f\"Cache hit for query: {query[:50]}...\")\n                cache_hit = True\n                original_cached_at = cached.get(\"cached_at\")\n\n                # Update access count\n                await cache_service.update_access(cache_key)\n\n                # Return cached result with cache metadata\n                cached_result = cached.get(\"result\", {})\n                cached_result[\"cache_hit\"] = True\n                cached_result[\"cache_extended\"] = False\n                cached_result[\"original_cached_at\"] = original_cached_at\n                cached_result[\"execution_time_seconds\"] = round(time.time() - start_time, 2)\n\n                # Log cache hit (event emitter doesn't have cache_hit method)\n                logger.info(f\"Cache hit for query: {query[:50]}...\")\n\n                return cached_result\n\n        # Initialize template\n        template = get_template(template_type)\n        template.set_client(self.gemini)\n\n        # Emit initialization status/event\n        if self.status:\n            await self.status.initialized(query, template_type, granularity, max_searches)\n        if self.events:\n            await self.events.initialized(query, template_type, granularity)\n\n        # Build context from input file/text\n        context_text = \"\"\n        if input_file_url and self.ocr:\n            try:\n                logger.info(f\"Processing input file: {input_file_url}\")\n                ocr_result = await self.ocr.process_file_url(input_file_url)\n                context_text = ocr_result.get(\"text\", \"\")\n                self.cost_tracker.add_openrouter_usage(ocr_result.get(\"tokens\", 0))\n            except Exception as e:\n                warnings.append(f\"Failed to process input file: {str(e)}\")\n                logger.warning(f\"OCR failed: {e}\")\n\n        if input_text:\n            context_text = f\"{context_text}\\n\\n{input_text}\" if context_text else input_text\n\n        # Create session in database\n        db_session = None\n        if save_to_db and self.supabase:\n            try:\n                db_session = await self.supabase.create_session(\n                    title=f\"Research: {query[:50]}...\",\n                    query=query,\n                    template_type=template_type,\n                    parameters={\n                        \"granularity\": granularity,\n                        \"max_searches\": max_searches,\n                        \"perspectives\": perspectives,\n                    },\n                )\n                session_id = db_session.get(\"id\", session_id)\n            except Exception as e:\n                warnings.append(f\"Failed to create database session: {str(e)}\")\n                logger.warning(f\"DB session creation failed: {e}\")\n\n        # Phase 0.5: Topic detection and linking\n        primary_topic_id = None\n        if save_to_db and self.supabase:\n            try:\n                # Extract topic from query\n                topic_info = await self._extract_topic(query, template_type)\n                if topic_info:\n                    topic = await self.supabase.find_or_create_topic(\n                        name=topic_info.get(\"name\", query[:50]),\n                        topic_type=topic_info.get(\"type\", \"concept\"),\n                        description=topic_info.get(\"description\"),\n                    )\n                    primary_topic_id = topic.get(\"id\")\n                    await self.supabase.link_session_to_topic(\n                        session_id=session_id,\n                        topic_id=primary_topic_id,\n                        is_primary=True,\n                    )\n                    logger.info(f\"Linked session to topic: {topic.get('name')}\")\n            except Exception as e:\n                logger.warning(f\"Topic detection failed: {e}\")\n\n        # Phase 1: Generate search queries\n        logger.info(\"Generating search queries...\")\n        search_queries = await template.generate_search_queries(\n            query=query,\n            max_searches=max_searches,\n            granularity=granularity,\n        )\n\n        if not search_queries:\n            errors.append(\"Failed to generate search queries\")\n            if self.status:\n                await self.status.failed(\"Failed to generate search queries\", \"query_generation\")\n            if self.events:\n                await self.events.failed(\"Failed to generate search queries\", \"QUERY_GENERATION_FAILED\", \"query_generation\")\n            return self._build_error_result(session_id, query, template_type, errors, start_time)\n\n        # Emit query generation status/event\n        if self.status:\n            await self.status.queries_generated(len(search_queries), search_queries)\n        if self.events:\n            await self.events.queries_generated(search_queries)\n\n        # Phase 2: Execute searches\n        logger.info(f\"Executing {len(search_queries)} searches...\")\n        all_sources: List[Dict[str, Any]] = []\n        all_content: List[str] = []\n\n        # Add context if available\n        if context_text:\n            all_content.append(f\"## Input Context\\n\\n{context_text}\")\n\n        for i, search_query in enumerate(search_queries):\n            try:\n                # Emit search started\n                if self.status:\n                    await self.status.search_started(i, search_query)\n                if self.events:\n                    await self.events.search_started(i, search_query, len(search_queries))\n\n                logger.debug(f\"Search {i+1}/{len(search_queries)}: {search_query[:50]}...\")\n                result = await self.gemini.research(search_query)\n\n                # Track tokens and cost\n                tokens_used = 0\n                cost_usd = 0.0\n                if result.token_usage:\n                    tokens_used = result.token_usage.input_tokens + result.token_usage.output_tokens\n                    self.cost_tracker.add_gemini_usage(\n                        result.token_usage.input_tokens,\n                        result.token_usage.output_tokens,\n                    )\n                    cost_usd = self.cost_tracker.get_summary().get(\"total_cost_usd\", 0.0) - (\n                        self.cost_tracker.get_summary().get(\"total_cost_usd\", 0.0) if i == 0 else 0\n                    )\n\n                # Collect sources\n                sources_this_search = []\n                for source in result.sources:\n                    source_dict = {\n                        \"url\": source.url,\n                        \"title\": source.title,\n                        \"domain\": source.domain,\n                        \"snippet\": source.snippet,\n                        \"source_type\": source.source_type,\n                    }\n                    all_sources.append(source_dict)\n                    sources_this_search.append(source_dict)\n\n                # Collect synthesized content\n                if result.text:\n                    all_content.append(f\"## Search: {search_query}\\n\\n{result.text}\")\n\n                # Emit search completed\n                if self.status:\n                    await self.status.search_completed(i, len(sources_this_search), 0)  # Findings counted later\n                if self.events:\n                    await self.events.search_completed(\n                        i, len(search_queries), len(sources_this_search), 0,\n                        tokens_used=tokens_used, cost_usd=cost_usd\n                    )\n\n                # Save query to database\n                if save_to_db and self.supabase:\n                    try:\n                        await self.supabase.save_query(\n                            session_id=session_id,\n                            query_text=search_query,\n                            query_purpose=f\"Search query {i+1}\",\n                            query_round=1,\n                            result_count=len(result.sources),\n                        )\n                    except Exception as e:\n                        logger.warning(f\"Failed to save query: {e}\")\n\n            except Exception as e:\n                warnings.append(f\"Search failed for '{search_query[:30]}...': {str(e)}\")\n                logger.warning(f\"Search failed: {e}\")\n\n        # Deduplicate sources\n        seen_urls = set()\n        unique_sources = []\n        for source in all_sources:\n            if source[\"url\"] not in seen_urls:\n                seen_urls.add(source[\"url\"])\n                unique_sources.append(source)\n\n        # Phase 3: Assess credibility (simple heuristic)\n        for source in unique_sources:\n            source[\"credibility_score\"] = self._assess_credibility(source)\n            source[\"credibility_label\"] = self._credibility_label(source[\"credibility_score\"])\n\n        # Save sources and get URL->UUID mapping for linking\n        source_id_map: dict = {}\n        if save_to_db and self.supabase:\n            try:\n                _, source_id_map = await self.supabase.save_sources_and_get_mapping(session_id, unique_sources)\n                logger.info(f\"Saved {len(source_id_map)} sources with UUID mapping\")\n            except Exception as e:\n                logger.warning(f\"Failed to save sources: {e}\")\n\n        # Phase 4: Extract findings\n        logger.info(\"Extracting findings...\")\n        synthesized_content = \"\\n\\n---\\n\\n\".join(all_content)\n        findings = await template.extract_findings(\n            query=query,\n            sources=unique_sources,\n            synthesized_content=synthesized_content,\n            granularity=granularity,\n        )\n\n        # Add IDs to findings\n        for i, finding in enumerate(findings):\n            finding[\"finding_id\"] = f\"f{i+1}\"\n            finding[\"supporting_sources\"] = [\n                {\"url\": s[\"url\"], \"title\": s[\"title\"]}\n                for s in unique_sources[:3]\n            ]\n\n        # Phase 4.5: Verify findings (bias detection, sanity check, cross-reference)\n        logger.info(\"Verifying findings...\")\n        if self.status:\n            await self.status.verification_started()\n        try:\n            findings = await template.verify_findings(\n                findings=findings,\n                sources=unique_sources,\n                original_query=query,\n            )\n            logger.info(f\"Verified {len(findings)} findings\")\n            if self.status:\n                await self.status.verification_completed(len(findings))\n            if self.events:\n                await self.events.verification_completed(len(findings))\n        except Exception as e:\n            warnings.append(f\"Finding verification failed: {str(e)}\")\n            logger.warning(f\"Verification failed: {e}\")\n\n        # Save findings with proper source linking\n        saved_findings = []\n        if save_to_db and self.supabase:\n            try:\n                saved_findings = await self.supabase.save_findings_with_sources(\n                    session_id, findings, source_id_map\n                )\n                logger.info(f\"Saved {len(saved_findings)} findings with source links\")\n            except Exception as e:\n                logger.warning(f\"Failed to save findings: {e}\")\n\n        # Phase 4.25: Entity extraction and knowledge claim creation\n        if save_to_db and self.supabase and findings:\n            try:\n                entities_data = await self._extract_entities(findings, query)\n                if entities_data:\n                    saved_entities = await self.supabase.save_entities_batch(entities_data)\n                    logger.info(f\"Extracted and saved {len(saved_entities)} entities\")\n\n                    # Create knowledge claims from high-confidence findings\n                    for i, finding in enumerate(findings):\n                        if finding.get(\"confidence_score\", 0) >= 0.6:\n                            try:\n                                claim = await self.supabase.create_knowledge_claim(\n                                    content=finding.get(\"content\", \"\"),\n                                    claim_type=self._map_finding_to_claim_type(finding.get(\"finding_type\", \"fact\")),\n                                    topic_id=primary_topic_id,\n                                    session_id=session_id,\n                                    confidence_score=finding.get(\"confidence_score\", 0.5),\n                                    summary=finding.get(\"summary\"),\n                                    temporal_context=finding.get(\"temporal_context\"),\n                                    extracted_data=finding.get(\"extracted_data\"),\n                                )\n\n                                # Link finding to claim\n                                if saved_findings and i < len(saved_findings):\n                                    await self.supabase.client.table(\"research_findings\").update({\n                                        \"knowledge_claim_id\": claim.get(\"id\"),\n                                        \"is_promoted\": True,\n                                        \"promotion_type\": \"created\",\n                                    }).eq(\"id\", saved_findings[i].get(\"id\")).execute()\n\n                                # Link entities to claim\n                                for entity in saved_entities:\n                                    entity_name = entity.get(\"canonical_name\", \"\").lower()\n                                    if entity_name in finding.get(\"content\", \"\").lower():\n                                        await self.supabase.link_claim_to_entity(\n                                            claim_id=claim.get(\"id\"),\n                                            entity_id=entity.get(\"id\"),\n                                            role=\"mentioned\",\n                                        )\n                            except Exception as e:\n                                logger.debug(f\"Failed to create claim from finding: {e}\")\n            except Exception as e:\n                logger.warning(f\"Entity extraction failed: {e}\")\n\n        # Phase 5: Multi-perspective analysis\n        logger.info(\"Running perspective analysis...\")\n        perspectives_to_run = perspectives or template.default_perspectives\n\n        # Emit perspectives started\n        if self.status:\n            await self.status.perspectives_started(perspectives_to_run)\n        if self.events:\n            await self.events.perspectives_started(perspectives_to_run)\n\n        perspective_results = []\n        total_insights = 0\n\n        for perspective_type in perspectives_to_run:\n            try:\n                analysis = await template.analyze_perspective(\n                    perspective_type=perspective_type,\n                    findings=findings,\n                    sources=unique_sources,\n                    original_query=query,\n                )\n                perspective_results.append(analysis)\n                # Count insights from this perspective\n                total_insights += len(analysis.get(\"key_insights\", []))\n\n            except Exception as e:\n                warnings.append(f\"Perspective analysis failed for '{perspective_type}': {str(e)}\")\n                logger.warning(f\"Perspective failed: {e}\")\n\n        # Emit perspectives completed\n        if self.status:\n            await self.status.perspectives_completed(len(perspective_results), total_insights)\n        if self.events:\n            await self.events.perspectives_completed(len(perspective_results), total_insights)\n\n        # Save perspectives\n        if save_to_db and self.supabase:\n            try:\n                await self.supabase.save_perspectives(session_id, perspective_results)\n            except Exception as e:\n                logger.warning(f\"Failed to save perspectives: {e}\")\n\n        # Phase 5.5: Detect gaps and contradictions\n        gaps_detected = []\n        contradictions_detected = []\n        if save_to_db and self.supabase and findings:\n            try:\n                analysis = await self._analyze_gaps_and_contradictions(findings, query)\n\n                # Save gaps\n                for gap in analysis.get(\"gaps\", []):\n                    saved_gap = await self.supabase.save_gap(\n                        session_id=session_id,\n                        description=gap.get(\"description\", \"\"),\n                        gap_type=gap.get(\"type\", \"information\"),\n                        priority=gap.get(\"priority\", 2),\n                        suggested_queries=gap.get(\"suggested_queries\", []),\n                    )\n                    gaps_detected.append(saved_gap)\n\n                # Save contradictions (would need finding IDs)\n                for contradiction in analysis.get(\"contradictions\", []):\n                    contradictions_detected.append(contradiction)\n                    # Note: Full contradiction linking requires finding IDs\n\n                logger.info(f\"Detected {len(gaps_detected)} gaps and {len(contradictions_detected)} contradictions\")\n            except Exception as e:\n                logger.warning(f\"Gap/contradiction analysis failed: {e}\")\n\n        # Complete session\n        if save_to_db and self.supabase:\n            try:\n                await self.supabase.complete_session(\n                    session_id,\n                    cost_summary=self.cost_tracker.get_summary(),\n                    findings_count=len(findings),\n                    sources_count=len(unique_sources),\n                )\n            except Exception as e:\n                logger.warning(f\"Failed to complete session: {e}\")\n\n        execution_time = time.time() - start_time\n\n        # Build result\n        result = {\n            \"session_id\": session_id,\n            \"query\": query,\n            \"template\": template_type,\n            \"status\": \"completed\" if not errors else \"partial\",\n            \"findings\": findings,\n            \"perspectives\": perspective_results,\n            \"sources\": unique_sources,\n            \"search_queries_executed\": search_queries,\n            \"cost_summary\": self.cost_tracker.get_summary(),\n            \"execution_time_seconds\": round(execution_time, 2),\n            \"supabase_session_id\": session_id if save_to_db and self.supabase else None,\n            \"primary_topic_id\": primary_topic_id,\n            \"gaps\": gaps_detected,\n            \"contradictions\": contradictions_detected,\n            \"errors\": errors,\n            \"warnings\": warnings,\n            \"cache_hit\": False,\n            \"cache_extended\": False,\n            \"original_cached_at\": None,\n        }\n\n        # Cache the result if caching is enabled\n        if use_cache and cache_service.is_available() and not errors:\n            try:\n                await cache_service.set_cached(\n                    cache_key=cache_key,\n                    result=result,\n                    findings_count=len(findings),\n                    sources_count=len(unique_sources),\n                )\n                logger.info(f\"Cached research result: {cache_key}\")\n            except Exception as e:\n                logger.warning(f\"Failed to cache result: {e}\")\n\n        return result\n\n    def _assess_credibility(self, source: Dict[str, Any]) -> float:\n        \"\"\"Simple credibility assessment based on domain.\"\"\"\n        domain = source.get(\"domain\", \"\").lower()\n\n        # High credibility domains\n        if any(d in domain for d in [\n            \"gov\", \"edu\", \"reuters\", \"ap\", \"bbc\", \"nytimes\",\n            \"wsj\", \"ft.com\", \"bloomberg\", \"sec.gov\"\n        ]):\n            return 0.85\n\n        # Medium-high credibility\n        if any(d in domain for d in [\n            \"forbes\", \"businessinsider\", \"cnbc\", \"marketwatch\",\n            \"yahoo\", \"cnn\", \"washingtonpost\"\n        ]):\n            return 0.70\n\n        # Default medium credibility\n        return 0.55\n\n    def _credibility_label(self, score: float) -> str:\n        \"\"\"Get credibility label from score.\"\"\"\n        if score >= 0.8:\n            return \"high\"\n        elif score >= 0.6:\n            return \"medium\"\n        else:\n            return \"low\"\n\n    def _build_error_result(\n        self,\n        session_id: str,\n        query: str,\n        template: str,\n        errors: List[str],\n        start_time: float,\n    ) -> Dict[str, Any]:\n        \"\"\"Build error result when research fails.\"\"\"\n        return {\n            \"session_id\": session_id,\n            \"query\": query,\n            \"template\": template,\n            \"status\": \"failed\",\n            \"findings\": [],\n            \"perspectives\": [],\n            \"sources\": [],\n            \"search_queries_executed\": [],\n            \"cost_summary\": self.cost_tracker.get_summary(),\n            \"execution_time_seconds\": round(time.time() - start_time, 2),\n            \"supabase_session_id\": None,\n            \"errors\": errors,\n            \"warnings\": [],\n        }\n\n    async def _extract_topic(\n        self,\n        query: str,\n        template_type: str,\n    ) -> Optional[Dict[str, Any]]:\n        \"\"\"Extract topic information from query using LLM.\"\"\"\n        prompt = f\"\"\"Analyze this research query and extract the main topic.\n\nQUERY: {query}\nTEMPLATE TYPE: {template_type}\n\nReturn JSON with:\n- name: Short topic name (2-5 words, like \"Tesla Financial Health\" or \"AI Code Assistants\")\n- type: One of: domain, event, entity, concept, region, timeperiod\n- description: One sentence describing the topic\n\nExample output:\n{{\"name\": \"OpenAI Corporate Strategy\", \"type\": \"entity\", \"description\": \"Analysis of OpenAI's business decisions and strategic direction\"}}\n\"\"\"\n        try:\n            result, _ = await self.gemini.generate_json(prompt, temperature=0.2)\n            if isinstance(result, dict) and result.get(\"name\"):\n                return result\n        except Exception as e:\n            logger.warning(f\"Topic extraction failed: {e}\")\n        return None\n\n    async def _extract_entities(\n        self,\n        findings: List[Dict[str, Any]],\n        query: str,\n    ) -> List[Dict[str, Any]]:\n        \"\"\"Extract named entities from findings.\"\"\"\n        # Combine findings content\n        findings_text = \"\\n\".join([\n            f\"- {f.get('content', '')[:300]}\"\n            for f in findings[:15]\n        ])\n\n        prompt = f\"\"\"Extract key named entities from these research findings.\n\nRESEARCH QUERY: {query}\n\nFINDINGS:\n{findings_text}\n\nExtract people, organizations, locations, products, and key concepts.\nReturn JSON array of entities:\n[\n  {{\"name\": \"Entity Name\", \"type\": \"person|organization|location|product|concept|event\", \"description\": \"Brief description\"}},\n  ...\n]\n\nOnly include clearly identifiable entities. Limit to 15 most important entities.\n\"\"\"\n        try:\n            result, _ = await self.gemini.generate_json(prompt, temperature=0.2)\n            if isinstance(result, list):\n                return result\n        except Exception as e:\n            logger.warning(f\"Entity extraction failed: {e}\")\n        return []\n\n    def _map_finding_to_claim_type(self, finding_type: str) -> str:\n        \"\"\"Map finding type to knowledge claim type.\"\"\"\n        mapping = {\n            \"fact\": \"fact\",\n            \"claim\": \"fact\",\n            \"event\": \"event\",\n            \"actor\": \"actor\",\n            \"relationship\": \"relationship\",\n            \"pattern\": \"pattern\",\n            \"gap\": \"gap\",\n            \"evidence\": \"evidence\",\n        }\n        return mapping.get(finding_type, \"fact\")\n\n    async def _analyze_gaps_and_contradictions(\n        self,\n        findings: List[Dict[str, Any]],\n        query: str,\n    ) -> Dict[str, Any]:\n        \"\"\"Analyze findings for gaps and contradictions.\"\"\"\n        findings_text = \"\\n\".join([\n            f\"{i+1}. [{f.get('finding_type', 'fact')}] {f.get('summary', f.get('content', '')[:200])}\"\n            for i, f in enumerate(findings[:20])\n        ])\n\n        prompt = f\"\"\"Analyze these research findings for gaps and contradictions.\n\nRESEARCH QUERY: {query}\n\nFINDINGS:\n{findings_text}\n\nIdentify:\n1. GAPS: What important questions remain unanswered? What information is missing?\n2. CONTRADICTIONS: Do any findings conflict with each other?\n\nReturn JSON:\n{{\n  \"gaps\": [\n    {{\n      \"description\": \"What's missing\",\n      \"type\": \"information|verification|perspective|temporal\",\n      \"priority\": 1-3 (1=high),\n      \"suggested_queries\": [\"search query to fill gap\"]\n    }}\n  ],\n  \"contradictions\": [\n    {{\n      \"finding_indices\": [1, 5],\n      \"description\": \"How they contradict\",\n      \"severity\": \"high|medium|low\"\n    }}\n  ]\n}}\n\nLimit to 5 most important gaps and 3 most significant contradictions.\n\"\"\"\n        try:\n            result, _ = await self.gemini.generate_json(prompt, temperature=0.3)\n            if isinstance(result, dict):\n                return result\n        except Exception as e:\n            logger.warning(f\"Gap/contradiction analysis failed: {e}\")\n        return {\"gaps\": [], \"contradictions\": []}\n","numLines":680,"startLine":1,"totalLines":680}}}
