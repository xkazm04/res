tput_tokens / 1_000_000) * self.gemini_output_rate\n    53→        return input_cost + output_cost\n    54→\n    55→    @property\n    56→    def openrouter_cost_usd(self) -> float:\n    57→        \"\"\"Calculate OpenRouter cost in USD.\"\"\"\n    58→        return (self.openrouter_tokens / 1_000_000) * self.openrouter_rate\n    59→\n    60→    @property\n    61→    def total_cost_usd(self) -> float:\n    62→        \"\"\"Calculate total cost in USD.\"\"\"\n    63→        return self.gemini_cost_usd + self.openrouter_cost_usd\n    64→\n    65→    def get_summary(self) -> Dict[str, Any]:\n    66→        \"\"\"Get cost summary as dictionary.\"\"\"\n    67→        return {\n    68→            \"total_tokens\": self.total_tokens,\n    69→            \"input_tokens\": self.gemini_input_tokens,\n    70→            \"output_tokens\": self.gemini_output_tokens,\n    71→            \"gemini_cost_usd\": round(self.gemini_cost_usd, 6),\n    72→            \"openrouter_cost_usd\": round(self.openrouter_cost_usd, 6),\n    73→            \"total_cost_usd\": round(self.total_cost_usd, 6),\n    74→        }\n    75→\n    76→    def reset(self) -> None:\n    77→        \"\"\"Reset all counters.\"\"\"\n    78→        self.gemini_input_tokens = 0\n    79→        self.gemini_output_tokens = 0\n    80→        self.openrouter_tokens = 0\n    81→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"063d9692-0974-4418-8890-3933b0ef315a","uuid":"5e639924-c06b-4688-83b2-75ec5da77549","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\actor\\src\\services\\cost_tracker.py","content":"\"\"\"Cost and token tracking service.\"\"\"\n\nfrom typing import Dict, Any, Optional\nfrom dataclasses import dataclass, field\n\n\n@dataclass\nclass CostTracker:\n    \"\"\"Tracks token usage and costs across API calls.\"\"\"\n\n    # Gemini usage\n    gemini_input_tokens: int = 0\n    gemini_output_tokens: int = 0\n\n    # OpenRouter usage (OCR)\n    openrouter_tokens: int = 0\n\n    # Cost rates per 1M tokens\n    gemini_input_rate: float = 0.075\n    gemini_output_rate: float = 0.30\n    openrouter_rate: float = 0.50\n\n    def add_gemini_usage(\n        self,\n        input_tokens: int = 0,\n        output_tokens: int = 0,\n    ) -> None:\n        \"\"\"Add Gemini API usage.\"\"\"\n        self.gemini_input_tokens += input_tokens\n        self.gemini_output_tokens += output_tokens\n\n    def add_openrouter_usage(\n        self,\n        tokens: int = 0,\n    ) -> None:\n        \"\"\"Add OpenRouter API usage.\"\"\"\n        self.openrouter_tokens += tokens\n\n    @property\n    def total_tokens(self) -> int:\n        \"\"\"Get total tokens across all services.\"\"\"\n        return (\n            self.gemini_input_tokens +\n            self.gemini_output_tokens +\n            self.openrouter_tokens\n        )\n\n    @property\n    def gemini_cost_usd(self) -> float:\n        \"\"\"Calculate Gemini cost in USD.\"\"\"\n        input_cost = (self.gemini_input_tokens / 1_000_000) * self.gemini_input_rate\n        output_cost = (self.gemini_output_tokens / 1_000_000) * self.gemini_output_rate\n        return input_cost + output_cost\n\n    @property\n    def openrouter_cost_usd(self) -> float:\n        \"\"\"Calculate OpenRouter cost in USD.\"\"\"\n        return (self.openrouter_tokens / 1_000_000) * self.openrouter_rate\n\n    @property\n    def total_cost_usd(self) -> float:\n        \"\"\"Calculate total cost in USD.\"\"\"\n        return self.gemini_cost_usd + self.openrouter_cost_usd\n\n    def get_summary(self) -> Dict[str, Any]:\n        \"\"\"Get cost summary as dictionary.\"\"\"\n        return {\n            \"total_tokens\": self.total_tokens,\n            \"input_tokens\": self.gemini_input_tokens,\n            \"output_tokens\": self.gemini_output_tokens,\n            \"gemini_cost_usd\": round(self.gemini_cost_usd, 6),\n            \"openrouter_cost_usd\": round(self.openrouter_cost_usd, 6),\n            \"total_cost_usd\": round(self.total_cost_usd, 6),\n        }\n\n    def reset(self) -> None:\n        \"\"\"Reset all counters.\"\"\"\n        self.gemini_input_tokens = 0\n        self.gemini_output_tokens = 0\n        self.openrouter_tokens = 0\n","numLines":81,"startLine":1,"totalLines":81}}}
