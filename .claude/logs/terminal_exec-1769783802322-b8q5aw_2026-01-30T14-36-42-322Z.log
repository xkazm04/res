nt?: 'confidence' | 'credibility';\n    91→  label?: string;\n    92→}) {\n    93→  const { theme } = useReportTheme();\n    94→  const isRadar = theme === 'radar';\n    95→  const pct = Math.round(score * 100);\n    96→  const level = getConfidenceLevel(score);\n    97→\n    98→  const colors = variant === 'credibility'\n    99→    ? (isRadar ? credibilityBadgeColorsDark : credibilityBadgeColors)\n   100→    : (isRadar ? confidenceBadgeColorsDark : confidenceBadgeColors);\n   101→\n   102→  return (\n   103→    <span className={`inline-block px-2 py-0.5 rounded-full text-[10px] font-semibold ${colors[level]}`}>\n   104→      {label ?? `${pct}%`}\n   105→    </span>\n   106→  );\n   107→}\n   108→\n   109→// Backward-compatible aliases\n   110→export function ConfidenceBadge({ score }: { score: number }) {\n   111→  return <ScoreBadge score={score} variant=\"confidence\" />;\n   112→}\n   113→\n   114→export function CredibilityBadge({ score }: { score: number }) {\n   115→  return <ScoreBadge score={score} variant=\"credibility\" />;\n   116→}\n   117→\n   118→export function PriorityBadge({ priority }: { priority: string }) {\n   119→  const { theme } = useReportTheme();\n   120→  const isRadar = theme === 'radar';\n   121→\n   122→  const lightColors: Record<string, string> = {\n   123→    high: 'bg-red-100 text-red-700',\n   124→    medium: 'bg-amber-100 text-amber-700',\n   125→    low: 'bg-slate-100 text-slate-600',\n   126→  };\n   127→\n   128→  const darkColors: Record<string, string> = {\n   129→    high: 'bg-red-500/20 text-red-400',\n   130→    medium: 'bg-amber-500/20 text-amber-400',\n   131→    low: 'bg-slate-500/20 text-slate-400',\n   132→  };\n   133→\n   134→  const colors = isRadar ? darkColors : lightColors;\n   135→  const fallback = isRadar ? 'bg-slate-500/20 text-slate-400' : 'bg-slate-100 text-slate-600';\n   136→\n   137→  return (\n   138→    <span className={`inline-block px-2 py-0.5 rounded text-[10px] font-semibold uppercase ${colors[priority] || fallback}`}>\n   139→      {priority}\n   140→    </span>\n   141→  );\n   142→}\n   143→\n   144→export function StatusBadge({ status }: { status: string }) {\n   145→  const { theme } = useReportTheme();\n   146→  const isRadar = theme === 'radar';\n   147→\n   148→  const lightColors: Record<string, string> = {\n   149→    completed: 'bg-emerald-100 text-emerald-700',\n   150→    active: 'bg-blue-100 text-blue-700',\n   151→    searching: 'bg-amber-100 text-amber-700',\n   152→    analyzing: 'bg-purple-100 text-purple-700',\n   153→    paused: 'bg-slate-100 text-slate-600',\n   154→    failed: 'bg-red-100 text-red-700',\n   155→  };\n   156→\n   157→  const darkColors: Record<string, string> = {\n   158→    completed: 'bg-emerald-500/20 text-emerald-400',\n   159→    active: 'bg-blue-500/20 text-blue-400',\n   160→    searching: 'bg-amber-500/20 text-amber-400',\n   161→    analyzing: 'bg-purple-500/20 text-purple-400',\n   162→    paused: 'bg-slate-500/20 text-slate-400',\n   163→    failed: 'bg-red-500/20 text-red-400',\n   164→  };\n   165→\n   166→  const colors = isRadar ? darkColors : lightColors;\n   167→  const fallback = isRadar ? 'bg-slate-500/20 text-slate-400' : 'bg-slate-100 text-slate-600';\n   168→\n   169→  return (\n   170→    <span className={`inline-block px-2 py-0.5 rounded text-[10px] font-semibold uppercase ${colors[status] || fallback}`}>\n   171→      {status}\n   172→    </span>\n   173→  );\n   174→}\n   175→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"063d9692-0974-4418-8890-3933b0ef315a","uuid":"b131f76f-88f5-4d7e-bb29-472f1d131dc3","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\shared\\Badges.tsx","content":"'use client';\n\n// Badge Components for Report Display\n\nimport { useReportTheme } from '../core/ThemeContext';\nimport { getConfidenceLevel, confidenceBadgeColors, confidenceBadgeColorsDark, credibilityBadgeColors, credibilityBadgeColorsDark } from './typeConfig';\n\nexport function TypeBadge({ type }: { type: string }) {\n  const { theme } = useReportTheme();\n  const isRadar = theme === 'radar';\n\n  const lightColors: Record<string, string> = {\n    fact: 'bg-indigo-100 text-indigo-700',\n    claim: 'bg-slate-100 text-slate-700',\n    event: 'bg-emerald-100 text-emerald-700',\n    actor: 'bg-rose-100 text-rose-700',\n    relationship: 'bg-amber-100 text-amber-700',\n    pattern: 'bg-cyan-100 text-cyan-700',\n    gap: 'bg-violet-100 text-violet-700',\n    evidence: 'bg-green-100 text-green-700',\n  };\n\n  const darkColors: Record<string, string> = {\n    fact: 'bg-indigo-500/20 text-indigo-400',\n    claim: 'bg-slate-500/20 text-slate-400',\n    event: 'bg-emerald-500/20 text-emerald-400',\n    actor: 'bg-rose-500/20 text-rose-400',\n    relationship: 'bg-amber-500/20 text-amber-400',\n    pattern: 'bg-cyan-500/20 text-cyan-400',\n    gap: 'bg-violet-500/20 text-violet-400',\n    evidence: 'bg-green-500/20 text-green-400',\n  };\n\n  const colors = isRadar ? darkColors : lightColors;\n  const fallback = isRadar ? 'bg-slate-500/20 text-slate-400' : 'bg-slate-100 text-slate-600';\n\n  return (\n    <span className={`inline-block px-2 py-0.5 rounded text-[10px] font-semibold uppercase ${colors[type] || fallback}`}>\n      {type.replace('_', ' ')}\n    </span>\n  );\n}\n\nexport function SourceTypeBadge({ type }: { type: string }) {\n  const { theme } = useReportTheme();\n  const isRadar = theme === 'radar';\n\n  const lightColors: Record<string, string> = {\n    news: 'bg-blue-100 text-blue-700',\n    academic: 'bg-purple-100 text-purple-700',\n    government: 'bg-green-100 text-green-700',\n    corporate: 'bg-slate-100 text-slate-700',\n    blog: 'bg-orange-100 text-orange-700',\n    social: 'bg-pink-100 text-pink-700',\n    wiki: 'bg-cyan-100 text-cyan-700',\n  };\n\n  const darkColors: Record<string, string> = {\n    news: 'bg-blue-500/20 text-blue-400',\n    academic: 'bg-purple-500/20 text-purple-400',\n    government: 'bg-green-500/20 text-green-400',\n    corporate: 'bg-slate-500/20 text-slate-400',\n    blog: 'bg-orange-500/20 text-orange-400',\n    social: 'bg-pink-500/20 text-pink-400',\n    wiki: 'bg-cyan-500/20 text-cyan-400',\n  };\n\n  const colors = isRadar ? darkColors : lightColors;\n  const fallback = isRadar ? 'bg-slate-500/20 text-slate-400' : 'bg-slate-100 text-slate-600';\n\n  return (\n    <span className={`inline-block px-2 py-0.5 rounded text-[10px] font-semibold uppercase ${colors[type] || fallback}`}>\n      {type}\n    </span>\n  );\n}\n\n/**\n * Unified score badge component for confidence and credibility scores.\n * @param score - Score as 0-1 decimal\n * @param variant - 'confidence' uses slate for low, 'credibility' uses red for low\n * @param label - Optional label to display instead of percentage\n */\nexport function ScoreBadge({\n  score,\n  variant = 'confidence',\n  label,\n}: {\n  score: number;\n  variant?: 'confidence' | 'credibility';\n  label?: string;\n}) {\n  const { theme } = useReportTheme();\n  const isRadar = theme === 'radar';\n  const pct = Math.round(score * 100);\n  const level = getConfidenceLevel(score);\n\n  const colors = variant === 'credibility'\n    ? (isRadar ? credibilityBadgeColorsDark : credibilityBadgeColors)\n    : (isRadar ? confidenceBadgeColorsDark : confidenceBadgeColors);\n\n  return (\n    <span className={`inline-block px-2 py-0.5 rounded-full text-[10px] font-semibold ${colors[level]}`}>\n      {label ?? `${pct}%`}\n    </span>\n  );\n}\n\n// Backward-compatible aliases\nexport function ConfidenceBadge({ score }: { score: number }) {\n  return <ScoreBadge score={score} variant=\"confidence\" />;\n}\n\nexport function CredibilityBadge({ score }: { score: number }) {\n  return <ScoreBadge score={score} variant=\"credibility\" />;\n}\n\nexport function PriorityBadge({ priority }: { priority: string }) {\n  const { theme } = useReportTheme();\n  const isRadar = theme === 'radar';\n\n  const lightColors: Record<string, string> = {\n    high: 'bg-red-100 text-red-700',\n    medium: 'bg-amber-100 text-amber-700',\n    low: 'bg-slate-100 text-slate-600',\n  };\n\n  const darkColors: Record<string, string> = {\n    high: 'bg-red-500/20 text-red-400',\n    medium: 'bg-amber-500/20 text-amber-400',\n    low: 'bg-slate-500/20 text-slate-400',\n  };\n\n  const colors = isRadar ? darkColors : lightColors;\n  const fallback = isRadar ? 'bg-slate-500/20 text-slate-400' : 'bg-slate-100 text-slate-600';\n\n  return (\n    <span className={`inline-block px-2 py-0.5 rounded text-[10px] font-semibold uppercase ${colors[priority] || fallback}`}>\n      {priority}\n    </span>\n  );\n}\n\nexport function StatusBadge({ status }: { status: string }) {\n  const { theme } = useReportTheme();\n  const isRadar = theme === 'radar';\n\n  const lightColors: Record<string, string> = {\n    completed: 'bg-emerald-100 text-emerald-700',\n    active: 'bg-blue-100 text-blue-700',\n    searching: 'bg-amber-100 text-amber-700',\n    analyzing: 'bg-purple-100 text-purple-700',\n    paused: 'bg-slate-100 text-slate-600',\n    failed: 'bg-red-100 text-red-700',\n  };\n\n  const darkColors: Record<string, string> = {\n    completed: 'bg-emerald-500/20 text-emerald-400',\n    active: 'bg-blue-500/20 text-blue-400',\n    searching: 'bg-amber-500/20 text-amber-400',\n    analyzing: 'bg-purple-500/20 text-purple-400',\n    paused: 'bg-slate-500/20 text-slate-400',\n    failed: 'bg-red-500/20 text-red-400',\n  };\n\n  const colors = isRadar ? darkColors : lightColors;\n  const fallback = isRadar ? 'bg-slate-500/20 text-slate-400' : 'bg-slate-100 text-slate-600';\n\n  return (