\n    51→    red: 'bg-red-500',\n    52→    slate: 'bg-slate-500',\n    53→  };\n    54→\n    55→  const progressBg = isRadar ? 'bg-white/10' : 'bg-white/50';\n    56→\n    57→  return (\n    58→    <div className={`rounded-lg border p-3 ${colorClasses[color]}`}>\n    59→      <div className=\"flex items-center justify-between mb-1\">\n    60→        <span className=\"w-4 h-4 opacity-60\">{icon}</span>\n    61→        <span className=\"text-[9px] uppercase tracking-wider opacity-60\">{label}</span>\n    62→      </div>\n    63→      <div className=\"text-xl font-bold\">{value}</div>\n    64→      {subtext && <div className=\"text-[10px] opacity-70 mt-0.5\">{subtext}</div>}\n    65→      {progress !== undefined && (\n    66→        <div className={`h-1 ${progressBg} rounded-full mt-2 overflow-hidden`}>\n    67→          <div\n    68→            className={`h-full rounded-full ${progressColors[color]}`}\n    69→            style={{ width: `${progress}%` }}\n    70→          />\n    71→        </div>\n    72→      )}\n    73→      {children && <div className=\"mt-2\">{children}</div>}\n    74→    </div>\n    75→  );\n    76→}\n    77→\n    78→// Alert banner - theme-aware with light theme fallback\n    79→export function AlertBanner({\n    80→  title,\n    81→  description,\n    82→  variant,\n    83→  icon,\n    84→}: {\n    85→  title: string;\n    86→  description: string;\n    87→  variant: 'warning' | 'error' | 'info' | 'success';\n    88→  icon?: ReactNode;\n    89→}) {\n    90→  const { theme } = useReportTheme();\n    91→  const isRadar = theme === 'radar';\n    92→\n    93→  const lightVariants = {\n    94→    warning: 'bg-gradient-to-br from-orange-50 to-amber-50 border-orange-200 text-orange-700',\n    95→    error: 'bg-gradient-to-br from-red-50 to-rose-50 border-red-200 text-red-700',\n    96→    info: 'bg-gradient-to-br from-violet-50 to-purple-50 border-violet-200 text-violet-700',\n    97→    success: 'bg-gradient-to-br from-emerald-50 to-green-50 borde