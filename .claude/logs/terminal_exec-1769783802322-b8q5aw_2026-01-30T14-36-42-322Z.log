from 'react';\r\nimport { useReportTheme } from '../core/ThemeContext';\r\n\r\n// Quick stat card - theme-aware with light theme fallback\r\nexport function QuickStatCard({\r\n  label,\r\n  value,\r\n  subtext,\r\n  progress,\r\n  icon,\r\n  color,\r\n  children,\r\n}: {\r\n  label: string;\r\n  value: string | number;\r\n  subtext?: string;\r\n  progress?: number;\r\n  icon: ReactNode;\r\n  color: 'blue' | 'emerald' | 'amber' | 'red' | 'slate';\r\n  children?: ReactNode;\r\n}) {\r\n  const { theme } = useReportTheme();\r\n  const isRadar = theme === 'radar';\r\n\r\n  // Light theme (swiss) colors\r\n  const lightColors = {\r\n    blue: 'bg-blue-50 border-blue-200 text-blue-600',\r\n    emerald: 'bg-emerald-50 border-emerald-200 text-emerald-600',\r\n    amber: 'bg-amber-50 border-amber-200 text-amber-600',\r\n    red: 'bg-red-50 border-red-200 text-red-600',\r\n    slate: 'bg-slate-50 border-slate-200 text-slate-600',\r\n  };\r\n\r\n  // Dark theme (radar) colors\r\n  const darkColors = {\r\n    blue: 'bg-blue-500/10 border-blue-500/30 text-blue-400',\r\n    emerald: 'bg-emerald-500/10 border-emerald-500/30 text-emerald-400',\r\n    amber: 'bg-amber-500/10 border-amber-500/30 text-amber-400',\r\n    red: 'bg-red-500/10 border-red-500/30 text-red-400',\r\n    slate: 'bg-slate-800 border-slate-700 text-slate-300',\r\n  };\r\n\r\n  const colorClasses = isRadar ? darkColors : lightColors;\r\n\r\n  const progressColors = {\r\n    blue: 'bg-blue-500',\r\n    emerald: 'bg-emerald-500',\r\n    amber: 'bg-amber-500',\r\n    red: 'bg-red-500',\r\n    slate: 'bg-slate-500',\r\n  };\r\n\r\n  const progressBg = isRadar ? 'bg-white/10' : 'bg-white/50';\r\n\r\n  return (\r\n    <div className={`rounded-lg border p-3 ${colorClasses[color]}`}>\r\n      <div className=\"flex items-center justify-between mb-1\">\r\n        <span className=\"w-4 h-4 opacity-60\">{icon}</span>\r\n        <span className=\"text-[9px] uppercase tracking-wider opacity-60\">{label}</span>\r\n      </div>\r\n      <div className=\"text-xl font-bold\">{value}</div>\r\n      {subtext && <div className=\"text-[10px] opacity-70 mt-0.5\">{subtext}</div>}\r\n      {progress !== undefined && (\r\n        <div className={`h-1 ${progressBg} rounded-full mt-2 overflow-hidden`}>\r\n          <div\r\n            className={`h-full rounded-full ${progressColors[color]}`}\r\n            style={{ width: `${progress}%` }}\r\n          />\r\n        </div>\r\n      )}\r\n      {children && <div className=\"mt-2\">{children}</div>}\r\n    </div>\r\n  );\r\n}\r\n\r\n// Alert banner - theme-aware with light theme fallback\r\nexport function AlertBanner({\r\n  title,\r\n  description,\r\n  variant,\r\n  icon,\r\n}: {\r\n  title: string;\r\n  description: string;\r\n  variant: 'warning' | 'error' | 'info' | 'success';\r\n  icon?: ReactNode;\r\n}) {\r\n  const { theme } = useReportTheme();\r\n  const isRadar = theme === 'radar';\r\n\r\n  const lightVariants = {\r\n    warning: 'bg-gradient-to-br from-orange-50 to-amber-50 border-orange-200 text-orange-700',\r\n    error: 'bg-gradient-to-br from-red-50 to-rose-50 border-red-200 text-red-700',\r\n    info: 'bg-gradient-to-br from-violet-50 to-purple-50 border-violet-200 text-violet-700',\r\n    success: 'bg-gradient-to-br from-emerald-50 to-green-50 border-emerald-200 text-emerald-700',\r\n  };\r\n\r\n  const darkVariants = {\r\n    warning: 'bg-gradient-to-br from-orange-500/10 to-amber-500/10 border-orange-500/30 text-orange-400',\r\n    error: 'bg-gradient-to-br from-red-500/10 to-rose-500/10 border-red-500/30 text-red-400',\r\n    info: 'bg-gradient-to-br from-violet-500/10 to-purple-500/10 border-violet-500/30 text-violet-400',\r\n    success: 'bg-gradient-to-br from-emerald-500/10 to-green-500/10 border-emerald-500/30 text-emerald-400',\r\n  };\r\n\r\n  const variants = isRadar ? darkVariants : lightVariants;\r\n\r\n  return (\r\n    <div className={`border rounded-lg p-3 ${variants[variant]}`}>\r\n      <div className=\"flex items-center gap-2 font-semibold text-xs mb-1\">\r\n        {icon && <span className=\"w-3.5 h-3.5\">{icon}</span>}\r\n        {title}\r\n      </div>\r\n      <p className=\"text-[10px] opacity-80\">{description}</p>\r\n    </div>\r\n  );\r\n}\r\n\r\n"}}
