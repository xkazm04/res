[2026-01-30T14:38:51.630Z] [STDOUT] {"type":"assistant","message":{"model":"claude-opus-4-5-20251101","id":"msg_01EQixrh5TdkXNVA9qQDkzvj","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Qce9NxuZB8gVTpHCsvrgzm","name":"Write","input":{"file_path":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\shared\\Badges.tsx","content":"'use client';\n\n// Badge Components for Report Display\n// Uses centralized theme colors from themeColors.ts\n\nimport { useThemedColors } from './themeColors';\nimport { getConfidenceLevel, confidenceBadgeColors, confidenceBadgeColorsDark, credibilityBadgeColors, credibilityBadgeColorsDark } from './typeConfig';\n\nexport function TypeBadge({ type }: { type: string }) {\n  const { getFindingType } = useThemedColors();\n\n  return (\n    <span className={`inline-block px-2 py-0.5 rounded text-[10px] font-semibold uppercase ${getFindingType(type)}`}>\n      {type.replace('_', ' ')}\n    </span>\n  );\n}\n\nexport function SourceTypeBadge({ type }: { type: string }) {\n  const { getSourceType } = useThemedColors();\n\n  return (\n    <span className={`inline-block px-2 py-0.5 rounded text-[10px] font-semibold uppercase ${getSourceType(type)}`}>\n      {type}\n    </span>\n  );\n}\n\n/**\n * Unified score badge component for confidence and credibility scores.\n * @param score - Score as 0-1 decimal\n * @param variant - 'confidence' uses slate for low, 'credibility' uses red for low\n * @param label - Optional label to display instead of percentage\n */\nexport function ScoreBadge({\n  score,\n  variant = 'confidence',\n  label,\n}: {\n  score: number;\n  variant?: 'confidence' | 'credibility';\n  label?: string;\n}) {\n  const { isRadar } = useThemedColors();\n  const pct = Math.round(score * 100);\n  const level = getConfidenceLevel(score);\n\n  const colors = variant === 'credibility'\n    ? (isRadar ? credibilityBadgeColorsDark : credibilityBadgeColors)\n    : (isRadar ? confidenceBadgeColorsDark : confidenceBadgeColors);\n\n  return (\n    <span className={`inline-block px-2 py-0.5 rounded-full text-[10px] font-semibold ${colors[level]}`}>\n      {label ?? `${pct}%`}\n    </span>\n  );\n}\n\n// Backward-compatible aliases\nexport function ConfidenceBadge({ score }: { score: number }) {\n  return <ScoreBadge score={score} variant=\"confidence\" />;\n}\n\nexport function CredibilityBadge({ score }: { score: number }) {\n  return <ScoreBadge score={score} variant=\"credibility\" />;\n}\n\nexport function PriorityBadge({ priority }: { priority: string }) {\n  const { getPriority } = useThemedColors();\n\n  return (\n    <span className={`inline-block px-2 py-0.5 rounded text-[10px] font-semibold uppercase ${getPriority(priority)}`}>\n      {priority}\n    </span>\n  );\n}\n\nexport function StatusBadge({ status }: { status: string }) {\n  const { getStatus } = useThemedColors();\n\n  return (\n    <span className={`inline-block px-2 py-0.5 rounded text-[10px] font-semibold uppercase ${getStatus(status)}`}>\n      {status}\n    </span>\n  );\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"cache_creation_input_tokens":354,"cache_read_input_tokens":145727,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":354},"output_tokens":4,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"063d9692-0974-4418-8890-3933b0ef315a","uuid":"452a5b42-4766-4772-81c4-80468f68b540"}
