 y: cy + Math.sin(topicAngle) * orbitRadius,\r","-            radius: topicRadius,\r","-            color: getTemplateColor(template),\r","-            label: topic.name,\r","-            sessions: sessions.filter(s => topicSessions.some(ts => ts.id === s.id)),\r","-            template,\r","-            pulsePhase: Math.random() * Math.PI * 2,\r","-            type: 'topic',\r","-            parentTemplate: template,\r","-            topic,\r","-            orbitRadius,\r","-            orbitAngle: topicAngle,\r","-          });\r","-        });\r","-      }\r","-    });\r","-\r","-    nodesRef.current = nodes;\r","-  }, [sessions, topics, focusedTemplate]);\r","-\r","-  // Canvas rendering with animation\r","-  useEffect(() => {\r","-    const canvas = canvasRef.current;\r","-    const container = containerRef.current;\r","-    if (!canvas || !container) return;\r","-\r","-    const ctx = canvas.getContext('2d');\r","-    if (!ctx) return;\r","-\r","-    let time = 0;\r","-\r","-    const render = () => {\r","-      const rect = container.getBoundingClientRect();\r","-      canvas.width = rect.width * window.devicePixelRatio;\r","-      canvas.height = rect.height * window.devicePixelRatio;\r","-      ctx.scale(window.devicePixelRatio, window.devicePixelRatio);\r","-\r","-      const width = rect.width;\r","-      const height = rect.height;\r","-\r","-      // Clear with dark background\r","-      ctx.fillStyle = '#0A0A0B';\r","-      ctx.fillRect(0, 0, width, height);\r","-\r","-      // Draw radar sweep effect\r","-      const sweepAngle = (time * 0.5) % (Math.PI * 2);\r","-      const centerX = width / 2 + view.offsetX;\r","-      const centerY = height / 2 + view.offsetY;\r","-\r","-      // Subtle grid\r","-      ctx.strokeStyle = 'rgba(34, 211, 238, 0.03)';\r","-      ctx.lineWidth = 1;\r","-      const gridSize = 100 * view.scale;\r","-      const startX = (view.offsetX % gridSize) - gridSize;\r","-      const startY = (view.offsetY % gridSize) - gridSize;