       const x = centerX + node.x * view.scale;\r","-        const y = centerY + node.y * view.scale;\r","-        const pulse = Math.sin(time * 2 + node.pulsePhase) * 0.15 + 1;\r","-        const r = node.radius * view.scale * pulse;\r","-\r","-        // Determine opacity based on focus state\r","-        const isFocused = !focusedTemplate || node.template === focusedTemplate;\r","-        const opacity = isFocused ? 1 : 0.2;\r","-\r","-        // Outer glow\r","-        const glowGradient = ctx.createRadialGradient(x, y, r * 0.5, x, y, r * 2);\r","-        glowGradient.addColorStop(0, node.color + (isFocused ? '40' : '10'));\r","-        glowGradient.addColorStop(0.5, node.color + (isFocused ? '15' : '05'));\r","-        glowGradient.addColorStop(1, 'transparent');\r","-\r","-        ctx.fillStyle = glowGradient;\r","-        ctx.beginPath();\r","-        ctx.arc(x, y, r * 2, 0, Math.PI * 2);\r","-        ctx.fill();\r","-\r","-        // Inner circle\r","-        const innerGradient = ctx.createRadialGradient(x, y, 0, x, y, r);\r","-        innerGradient.addColorStop(0, node.color + (isFocused ? 'CC' : '44'));\r","-        innerGradient.addColorStop(0.7, node.color + (isFocused ? '88' : '22'));\r","-        innerGradient.addColorStop(1, node.color + (isFocused ? '44' : '11'));\r","-\r","-        ctx.fillStyle = innerGradient;\r","-        ctx.beginPath();\r","-        ctx.arc(x, y, r, 0, Math.PI * 2);\r","-        ctx.fill();\r","-\r","-        // Border\r","-        ctx.strokeStyle = node.color + (isFocused ? 'FF' : '44');\r","-        ctx.lineWidth = node.type === 'topic' ? 1.5 : 2;\r","-        ctx.beginPath();\r","-        ctx.arc(x, y, r, 0, Math.PI * 2);\r","-        ctx.stroke();\r","-\r","-        // Label (only if focused or no focus)\r","-        if (isFocused) {\r","-          ctx.fillStyle = '#E8E8E8';\r","-          ctx.font = `${Math.max(10, (node.type === 'topic' ? 12 : 14) * view.scale)}px Inter, system-ui, sans-serif`;\r","-          ctx.textAli