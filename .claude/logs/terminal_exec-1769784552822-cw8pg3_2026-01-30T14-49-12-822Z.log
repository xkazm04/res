[2026-01-30T14:49:35.619Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015ndjwJTmeSnqGivLmQrY5o","type":"tool_result","content":"     1→'use client';\n     2→\n     3→import { useState, useEffect, useCallback, useRef } from 'react';\n     4→\n     5→interface VideoConfig {\n     6→  fps: number;\n     7→  durationInFrames: number;\n     8→}\n     9→\n    10→interface PlaybackState {\n    11→  frame: number;\n    12→  playing: boolean;\n    13→  progress: number;\n    14→}\n    15→\n    16→export function useVideoPlayback(config: VideoConfig) {\n    17→  const { fps, durationInFrames } = config;\n    18→  const [state, setState] = useState<PlaybackState>({ frame: 0, playing: false, progress: 0 });\n    19→  const frameRef = useRef(0);\n    20→  const lastTimeRef = useRef(0);\n    21→\n    22→  const play = useCallback(() => setState(s => ({ ...s, playing: true })), []);\n    23→  const pause = useCallback(() => setState(s => ({ ...s, playing: false })), []);\n    24→  const toggle = useCallback(() => setState(s => ({ ...s, playing: !s.playing })), []);\n    25→  const reset = useCallback(() => {\n    26→    frameRef.current = 0;\n    27→    setState({ frame: 0, playing: false, progress: 0 });\n    28→  }, []);\n    29→  const seekTo = useCallback((frame: number) => {\n    30→    const clamped = Math.max(0, Math.min(durationInFrames - 1, frame));\n    31→    frameRef.current = clamped;\n    32→    setState(s => ({ ...s, frame: clamped, progress: clamped / (durationInFrames - 1) }));\n    33→  }, [durationInFrames]);\n    34→\n    35→  useEffect(() => {\n    36→    if (!state.playing) return;\n    37→\n    38→    const frameDuration = 1000 / fps;\n    39→    let animationId: number;\n    40→\n    41→    const tick = (time: number) => {\n    42→      if (!lastTimeRef.current) lastTimeRef.current = time;\n    43→      const delta = time - lastTimeRef.current;\n    44→\n    45→      if (delta >= frameDuration) {\n    46→        const framesToAdd = Math.floor(delta / frameDuration);\n    47→        frameRef.current = Math.min(frameRef.current + framesToAdd, durationInFrames - 1);\n    48→        lastTimeRef.current = time - (delta % frameDuration);\n    49→\n    50→        setState(s => ({\n    51→          ...s,\n    52→          frame: frameRef.current,\n    53→          progress: frameRef.current / (durationInFrames - 1),\n    54→        }));\n    55→\n    56→        if (frameRef.current >= durationInFrames - 1) {\n    57→          setState(s => ({ ...s, playing: false }));\n    58→          return;\n    59→        }\n    60→      }\n    61→\n    62→      animationId = requestAnimationFrame(tick);\n    63→    };\n    64→\n    65→    lastTimeRef.current = 0;\n    66→    animationId = requestAnimationFrame(tick);\n    67→\n    68→    return () => cancelAnimationFrame(animationId);\n    69→  }, [state.playing, fps, durationInFrames]);\n    70→\n    71→  return { ...state, play, pause, toggle, reset, seekTo, config };\n    72→}\n    73→\n    74→// Smooth easing functions\n    75→export function easeOutCubic(t: number): number {\n    76→  return 1 - Math.pow(1 - t, 3);\n    77→}\n    78→\n    79→export function easeOutQuart(t: number): number {\n    80→  return 1 - Math.pow(1 - t, 4);\n    81→}\n    82→\n    83→export function easeInOutCubic(t: number): number {\n    84→  return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;\n    85→}\n    86→\n    87→export function easeOutExpo(t: number): number {\n    88→  return t === 1 ? 1 : 1 - Math.pow(2, -10 * t);\n    89→}\n    90→\n    91→// Interpolation with smooth easing\n    92→export function interpolate(\n    93→  input: number,\n    94→  inputRange: [number, number],\n    95→  outputRange: [number, number],\n    96→  options?: {\n    97→    extrapolateLeft?: 'clamp' | 'extend';\n    98→    extrapolateRight?: 'clamp' | 'extend';\n    99→    easing?: (t: number) => number;\n   100→  }\n   101→): number {\n   102→  const [inMin, inMax] = inputRange;\n   103→  const [outMin, outMax] = outputRange;\n   104→  const { extrapolateLeft = 'extend', extrapolateRight = 'extend', easing } = options || {};\n   105→\n   106→  // Clamp input if needed\n   107→  let clampedInput = input;\n   108→  if (extrapolateLeft === 'clamp' && input < inMin) clampedInput = inMin;\n   109→  if (extrapolateRight === 'clamp' && input > inMax) clampedInput = inMax;\n   110→\n   111→  // Calculate normalized progress (0 to 1)\n   112→  let t = (clampedInput - inMin) / (inMax - inMin);\n   113→  t = Math.max(0, Math.min(1, t));\n   114→\n   115→  // Apply easing if provided\n   116→  if (easing) t = easing(t);\n   117→\n   118→  return outMin + t * (outMax - outMin);\n   119→}\n   120→\n   121→// Smooth spring with critically damped behavior (no overshoot, no jitter)\n   122→export function spring(params: {\n   123→  frame: number;\n   124→  fps: number;\n   125→  delay?: number;\n   126→  durationFrames?: number;\n   127→  easing?: (t: number) => number;\n   128→}): number {\n   129→  const { frame, fps, delay = 0, durationFrames = 20, easing = easeOutCubic } = params;\n   130→\n   131→  const adjustedFrame = frame - delay;\n   132→  if (adjustedFrame <= 0) return 0;\n   133→  if (adjustedFrame >= durationFrames) return 1;\n   134→\n   135→  const t = adjustedFrame / durationFrames;\n   136→  return easing(t);\n   137→}\n   138→\n   139→// Linear animation (for continuous motion like tickers)\n   140→export function linear(frame: number, durationFrames: number): number {\n   141→  return Math.min(1, frame / durationFrames);\n   142→}\n   143→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"063d9692-0974-4418-8890-3933b0ef315a","uuid":"c51ebf73-9a3b-4010-9c0e-8fd7ae7414ad","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\video\\useVideoPlayback.ts","content":"'use client';\n\nimport { useState, useEffect, useCallback, useRef } from 'react';\n\ninterface VideoConfig {\n  fps: number;\n  durationInFrames: number;\n}\n\ninterface PlaybackState {\n  frame: number;\n  playing: boolean;\n  progress: number;\n}\n\nexport function useVideoPlayback(config: VideoConfig) {\n  const { fps, durationInFrames } = config;\n  const [state, setState] = useState<PlaybackState>({ frame: 0, playing: false, progress: 0 });\n  const frameRef = useRef(0);\n  const lastTimeRef = useRef(0);\n\n  const play = useCallback(() => setState(s => ({ ...s, playing: true })), []);\n  const pause = useCallback(() => setState(s => ({ ...s, playing: false })), []);\n  const toggle = useCallback(() => setState(s => ({ ...s, playing: !s.playing })), []);\n  const reset = useCallback(() => {\n    frameRef.current = 0;\n    setState({ frame: 0, playing: false, progress: 0 });\n  }, []);\n  const seekTo = useCallback((frame: number) => {\n    const clamped = Math.max(0, Math.min(durationInFrames - 1, frame));\n    frameRef.current = clamped;\n    setState(s => ({ ...s, frame: clamped, progress: clamped / (durationInFrames - 1) }));\n  }, [durationInFrames]);\n\n  useEffect(() => {\n    if (!state.playing) return;\n\n    const frameDuration = 1000 / fps;\n    let animationId: number;\n\n    const tick = (time: number) => {\n      if (!lastTimeRef.current) lastTimeRef.current = time;\n      const delta = time - lastTimeRef.current;\n\n      if (delta >= frameDuration) {\n        const framesToAdd = Math.floor(delta / frameDuration);\n        frameRef.current = Math.min(frameRef.current + framesToAdd, durationInFrames - 1);\n        lastTimeRef.current = time - (delta % frameDuration);\n\n        setState(s => ({\n          ...s,\n          frame: frameRef.current,\n          progress: frameRef.current / (durationInFrames - 1),\n        }));\n\n        if (frameRef.current >= durationInFrames - 1) {\n          setState(s => ({ ...s, playing: false }));\n          return;\n        }\n      }\n\n      animationId = requestAnimationFrame(tick);\n    };\n\n    lastTimeRef.current = 0;\n    animationId = requestAnimationFrame(tick);\n\n    return () => cancelAnimationFrame(animationId);\n  }, [state.playing, fps, durationInFrames]);\n\n  return { ...state, play, pause, toggle, reset, seekTo, config };\n}\n\n// Smooth easing functions\nexport function easeOutCubic(t: number): number {\n  return 1 - Math.pow(1 - t, 3);\n}\n\nexport function easeOutQuart(t: number): number {\n  return 1 - Math.pow(1 - t, 4);\n}\n\nexport function easeInOutCubic(t: number): number {\n  return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;\n}\n\nexport function easeOutExpo(t: number): number {\n  return t === 1 ? 1 : 1 - Math.pow(2, -10 * t);\n}\n\n// Interpolation with smooth easing\nexport function interpolate(\n  input: number,\n  inputRange: [number, number],\n  outputRange: [number, number],\n  options?: {\n    extrapolateLeft?: 'clamp' | 'extend';\n    extrapolateRight?: 'clamp' | 'extend';\n    easing?: (t: number) => number;\n  }\n): number {\n  const [inMin, inMax] = inputRange;\n  const [outMin, outMax] = outputRange;\n  const { extrapolateLeft = 'extend', extrapolateRight = 'extend', easing } = options || {};\n\n  // Clamp input if needed\n  let clampedInput = input;\n  if (extrapolateLeft === 'clamp' && input < inMin) clampedInput = inMin;\n  if (extrapolateRight === 'clamp' && input > inMax) clampedInput = inMax;\n\n  // Calculate normalized progress (0 to 1)\n  let t = (clampedInput - inMin) / (inMax - inMin);\n  t = Math.max(0, Math.min(1, t));\n\n  // Apply easing if provided\n  if (easing) t = easing(t);\n\n  return outMin + t * (outMax - outMin);\n}\n\n// Smooth spring with critically damped behavior (no overshoot, no jitter)\nexport function spring(params: {\n  frame: number;\n  fps: number;\n  delay?: number;\n  durationFrames?: number;\n  easing?: (t: number) => number;\n}): number {\n  const { frame, fps, delay = 0, durationFrames = 20, easing = easeOutCubic } = params;\n\n  const adjustedFrame = frame - delay;\n  if (adjustedFrame <= 0) return 0;\n  if (adjustedFrame >= durationFrames) return 1;\n\n  const t = adjustedFrame / durationFrames;\n  return easing(t);\n}\n\n// Linear animation (for continuous motion like tickers)\nexport function linear(frame: number, durationFrames: number): number {\n  return Math.min(1, frame / durationFrames);\n}\n","numLines":143,"startLine":1,"totalLines":143}}}
