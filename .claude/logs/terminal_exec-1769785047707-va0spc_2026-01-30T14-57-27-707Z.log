[2026-01-30T15:02:37.559Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RBfMXR1zFGhGGonfQcuXhH","type":"tool_result","content":"     1→\"\"\"Legal research template.\"\"\"\n     2→\n     3→from typing import List, Dict, Any, Optional\n     4→from datetime import datetime\n     5→\n     6→from .base import BaseTemplate, TemplateConfig, FindingTypeConfig\n     7→from ..services.report_components import (\n     8→    ComponentType, ReportHints\n     9→)\n    10→\n    11→\n    12→# ========== TEMPLATE CONFIGURATION ==========\n    13→\n    14→LEGAL_CONFIG = TemplateConfig(\n    15→    search_intro=\"You are a legal researcher planning comprehensive legal research for a law firm or legal department.\",\n    16→    search_angles=[\n    17→        {\n    18→            \"name\": \"CASE LAW\",\n    19→            \"items\": [\n    20→                \"Relevant federal and state court decisions\",\n    21→                \"Appellate decisions and precedents\",\n    22→                \"Recent rulings in this area\",\n    23→                \"Landmark cases that shaped the law\",\n    24→            ]\n    25→        },\n    26→        {\n    27→            \"name\": \"STATUTES AND REGULATIONS\",\n    28→            \"items\": [\n    29→                \"Applicable federal statutes (U.S. Code)\",\n    30→                \"State statutes and laws\",\n    31→                \"Federal regulations (CFR, Federal Register)\",\n    32→                \"State and local regulations\",\n    33→            ]\n    34→        },\n    35→        {\n    36→            \"name\": \"REGULATORY GUIDANCE\",\n    37→            \"items\": [\n    38→                \"Agency interpretive guidance\",\n    39→                \"No-action letters, advisory opinions\",\n    40→                \"Enforcement policy statements\",\n    41→                \"FAQ and compliance bulletins\",\n    42→            ]\n    43→        },\n    44→        {\n    45→            \"name\": \"ENFORCEMENT ACTIONS\",\n    46→            \"items\": [\n    47→                \"SEC, DOJ, FTC enforcement actions\",\n    48→                \"State AG actions\",\n    49→                \"Consent decrees and settlements\",\n    50→                \"Criminal prosecutions\",\n    51→            ]\n    52→        },\n    53→        {\n    54→            \"name\": \"LITIGATION HISTORY\",\n    55→            \"items\": [\n    56→                \"Active lawsuits and proceedings\",\n    57→                \"Class action filings\",\n    58→                \"Qui tam and whistleblower cases\",\n    59→                \"Arbitration and alternative dispute resolution\",\n    60→            ]\n    61→        },\n    62→        {\n    63→            \"name\": \"LEGAL COMMENTARY\",\n    64→            \"items\": [\n    65→                \"Law review articles and legal scholarship\",\n    66→                \"Bar association publications\",\n    67→                \"Legal blog analysis\",\n    68→                \"Expert commentary\",\n    69→            ]\n    70→        },\n    71→        {\n    72→            \"name\": \"REGULATORY FILINGS\",\n    73→            \"items\": [\n    74→                \"SEC filings (8-K, 10-K risk factors)\",\n    75→                \"Lobbying disclosures\",\n    76→                \"Comment letters on proposed rules\",\n    77→                \"Patent and trademark filings\",\n    78→            ]\n    79→        },\n    80→        {\n    81→            \"name\": \"CONTRACTUAL ANALYSIS\",\n    82→            \"items\": [\n    83→                \"Standard contract terms in this area\",\n    84→                \"Key contractual provisions\",\n    85→                \"Industry standard agreements\",\n    86→                \"Licensing and IP arrangements\",\n    87→            ]\n    88→        },\n    89→        {\n    90→            \"name\": \"COMPLIANCE REQUIREMENTS\",\n    91→            \"items\": [\n    92→                \"Regulatory compliance checklists\",\n    93→                \"Industry standards and best practices\",\n    94→                \"Self-regulatory organization rules\",\n    95→                \"International compliance requirements\",\n    96→            ]\n    97→        },\n    98→        {\n    99→            \"name\": \"LEGAL TRENDS\",\n   100→            \"items\": [\n   101→                \"Proposed legislation\",\n   102→                \"Regulatory reform initiatives\",\n   103→                \"Emerging legal theories\",\n   104→                \"Judicial appointment impacts\",\n   105→            ]\n   106→        },\n   107→    ],\n   108→    search_depth_guidance={\n   109→        \"quick\": \"Focus on most relevant cases and current regulations\",\n   110→        \"standard\": \"Balanced coverage of cases, regulations, and enforcement\",\n   111→        \"deep\": \"Comprehensive legal research including commentary and trends\",\n   112→    },\n   113→\n   114→    extraction_intro=\"You are a legal research analyst extracting key findings for legal analysis.\",\n   115→    finding_types=[\n   116→        FindingTypeConfig(\n   117→            name=\"evidence\",\n   118→            display_name=\"Case Law\",\n   119→            description=\"Court decisions and holdings. Include: case name, court, date, holding. Note precedential value and applicability.\",\n   120→            extracted_data_schema='{\"case_name\": \"...\", \"court\": \"...\", \"date\": \"...\", \"citation\": \"...\", \"holding\": \"...\", \"precedential_value\": \"binding/persuasive\"}',\n   121→            analysis_fallback=\"This case law finding is relevant for establishing legal precedent in the matter at hand.\",\n   122→        ),\n   123→        FindingTypeConfig(\n   124→            name=\"fact\",\n   125→            display_name=\"Statutes and Regulations\",\n   126→            description=\"Applicable laws and regulations. Include: statute/regulation name, citation, key provisions. Note effective date and amendments.\",\n   127→            extracted_data_schema='{\"name\": \"...\", \"citation\": \"...\", \"key_provisions\": [...], \"effective_date\": \"...\"}',\n   128→            analysis_fallback=\"This statutory or regulatory finding establishes the legal framework applicable to the matter.\",\n   129→        ),\n   130→        FindingTypeConfig(\n   131→            name=\"event\",\n   132→            display_name=\"Enforcement/Litigation\",\n   133→            description=\"Regulatory enforcement, prosecutions, and active lawsuits. Include: agency/parties, date, allegations, outcome. Note penalties, injunctions, and remedies.\",\n   134→            extracted_data_schema='{\"case_type\": \"enforcement/litigation\", \"parties\": \"...\", \"date\": \"...\", \"allegations\": [...], \"outcome\": \"...\", \"penalty\": \"...\"}',\n   135→            analysis_fallback=\"This enforcement or litigation event provides context for understanding regulatory risk and legal exposure.\",\n   136→        ),\n   137→        FindingTypeConfig(\n   138→            name=\"claim\",\n   139→            display_name=\"Regulatory Guidance\",\n   140→            description=\"Agency interpretations and guidance. Include: agency, date, topic, key points. Note legal weight and binding nature.\",\n   141→            extracted_data_schema='{\"agency\": \"...\", \"document_type\": \"...\", \"date\": \"...\", \"topic\": \"...\", \"key_points\": [...]}',\n   142→            analysis_fallback=\"This regulatory guidance helps interpret how agencies apply the law in practice.\",\n   143→        ),\n   144→        FindingTypeConfig(\n   145→            name=\"pattern\",\n   146→            display_name=\"Legal Risk\",\n   147→            description=\"Identified legal exposure patterns. Include: risk type, likelihood, severity. Note mitigation strategies if mentioned.\",\n   148→            extracted_data_schema='{\"risk_type\": \"...\", \"likelihood\": \"high/medium/low\", \"severity\": \"high/medium/low\", \"mitigation\": [...]}',\n   149→            analysis_fallback=\"This legal risk pattern should be considered in risk assessment and mitigation planning.\",\n   150→        ),\n   151→        FindingTypeConfig(\n   152→            name=\"relationship\",\n   153→            display_name=\"Legal Precedent\",\n   154→            description=\"How cases relate to each other. Include: cases involved, relationship type. Note whether overruled or distinguished.\",\n   155→            extracted_data_schema='{\"citing_case\": \"...\", \"cited_case\": \"...\", \"relationship\": \"follows/distinguishes/overrules/questions\"}',\n   156→            analysis_fallback=\"This precedent relationship helps understand the evolution and current state of the law.\",\n   157→        ),\n   158→        FindingTypeConfig(\n   159→            name=\"gap\",\n   160→            display_name=\"Knowledge Gap\",\n   161→            description=\"Missing legal research. What additional research is needed. Suggested follow-up sources.\",\n   162→            extracted_data_schema='{\"information_needed\": \"...\", \"importance\": \"high/medium/low\", \"suggested_sources\": [...]}',\n   163→            analysis_fallback=\"This gap in legal research should be addressed before reaching final conclusions.\",\n   164→        ),\n   165→    ],\n   166→    analysis_instruction=\"\"\"YOUR EXPERT LEGAL ANALYSIS (REQUIRED - 2-4 sentences) explaining:\n   167→  * The LEGAL SIGNIFICANCE of this finding and how it affects the matter at hand\n   168→  * How this PRECEDENT or REGULATION applies to the specific situation\n   169→  * What RISKS or OPPORTUNITIES this creates from a legal perspective\n   170→  * How this COMPARES to similar cases or regulatory interpretations\"\"\",\n   171→    extraction_guidelines=\"\"\"CRITICAL: The \"analysis\" field must provide substantive legal reasoning, not just describe the finding.\n   172→Good example: \"This Supreme Court holding is controlling precedent that directly applies to the current matter. The Court's reasoning suggests a broad interpretation that would likely cover the conduct at issue. However, the concurrence's narrower reading has been adopted by some circuit courts, creating potential for distinguishing arguments.\"\n   173→\n   174→IMPORTANT:\n   175→- Prioritize primary sources (court filings, statutes) over secondary commentary\n   176→- Include specific citations where available\n   177→- Distinguish between established law and emerging interpretations\n   178→- Note jurisdictional limitations of precedents\"\"\",\n   179→\n   180→    priority_finding_types=[\"evidence\", \"fact\", \"event\", \"pattern\", \"claim\"],\n   181→    grouping_order=[\"evidence\", \"fact\", \"event\", \"claim\", \"pattern\", \"relationship\", \"gap\"],\n   182→)\n   183→\n   184→\n   185→class LegalTemplate(BaseTemplate):\n   186→    \"\"\"Template for legal research, regulatory analysis, and compliance.\"\"\"\n   187→\n   188→    template_id = \"legal\"\n   189→    template_name = \"Legal Research\"\n   190→    description = \"Legal case research, regulatory analysis, and compliance assessment\"\n   191→\n   192→    # Data-driven configuration\n   193→    config = LEGAL_CONFIG\n   194→\n   195→    # Report hints for component-based rendering\n   196→    report_hints = ReportHints(\n   197→        template_type=\"legal\",\n   198→        structure=\"narrative_first\",\n   199→        findings_grouping=\"category\",\n   200→        tone=\"professional\",\n   201→        decision_format=\"recommendation\",\n   202→        emphasis=[\"legal_precedents\", \"regulatory_implications\", \"compliance_requirements\"],\n   203→        required_components=[\n   204→            ComponentType.LEGAL_CASE_TRACKER,\n   205→            ComponentType.FINDINGS_TABLE,\n   206→            ComponentType.TIMELINE,\n   207→        ],\n   208→        optional_components=[\n   209→            ComponentType.KEY_INSIGHTS,\n   210→            ComponentType.CHECKLIST,\n   211→            ComponentType.RISK_MATRIX,\n   212→            ComponentType.ACTION_ITEMS,\n   213→        ],\n   214→        visualization_preference=[\"case_timeline\", \"jurisdiction_map\", \"precedent_chain\"],\n   215→        custom_sections={\n   216→            \"show_case_citations\": True,\n   217→            \"compliance_checklist\": True,\n   218→            \"regulatory_timeline\": True,\n   219→        }\n   220→    )\n   221→\n   222→    # Expert perspectives for legal analysis\n   223→    default_perspectives = [\n   224→        \"litigation_strategist\",   # Case strength, discovery, outcomes\n   225→        \"regulatory_expert\",       # Compliance, enforcement, political factors\n   226→        \"legal_liability\",         # Liability exposure, evidence strength\n   227→        \"forensic_financial\",      # Financial crimes, fraud patterns\n   228→    ]\n   229→\n   230→    default_max_searches = 10\n   231→\n   232→    # Legal research is more factual - court citations are verifiable\n   233→    # Focus on source quality (primary legal sources) over bias detection\n   234→    verification_config = {\n   235→        \"cross_reference\": \"light\",         # Legal citations are specific\n   236→        \"bias_detection\": \"light\",          # Less bias in case law\n   237→        \"expert_sanity_check\": \"light\",     # Legal findings are factual\n   238→        \"source_quality\": \"thorough\",       # Primary sources (court filings) critical\n   239→    }\n   240→\n   241→    def get_supported_report_variants(self) -> List[str]:\n   242→        \"\"\"Legal template supports legal_brief and compliance_assessment variants.\"\"\"\n   243→        return [\"full_report\", \"executive_summary\", \"legal_brief\", \"compliance_assessment\"]\n   244→\n   245→    def generate_legal_brief(\n   246→        self,\n   247→        result: Dict[str, Any],\n   248→        title: Optional[str] = None,\n   249→    ) -> str:\n   250→        \"\"\"Generate legal brief report - legal-specific variant.\"\"\"\n   251→        query = result.get(\"query\", \"Unknown\")\n   252→        report_title = title or f\"Legal Brief: {query[:40]}\"\n   253→\n   254→        sections = []\n   255→        sections.append(f\"# {report_title}\")\n   256→        sections.append(\"\")\n   257→        sections.append(f\"**Subject:** {query}\")\n   258→        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n   259→        sections.append(\"\")\n   260→        sections.append(\"---\")\n   261→        sections.append(\"\")\n   262→\n   263→        findings = result.get(\"findings\", [])\n   264→\n   265→        # Applicable Law\n   266→        statutes = [f for f in findings if f.get(\"finding_type\") == \"fact\"\n   267→                    and (\"statute\" in f.get(\"content\", \"\").lower() or \"regulation\" in f.get(\"content\", \"\").lower())]\n   268→        if statutes:\n   269→            sections.append(\"## Applicable Law\")\n   270→            sections.append(\"\")\n   271→            for s in statutes[:5]:\n   272→                extracted = s.get(\"extracted_data\", {})\n   273→                if extracted and isinstance(extracted, dict):\n   274→                    name = extracted.get(\"name\", \"\")\n   275→                    citation = extracted.get(\"citation\", \"\")\n   276→                    if name and citation:\n   277→                        sections.append(f\"- **{name}** ({citation})\")\n   278→                else:\n   279→                    sections.append(f\"- {s.get('summary') or s.get('content', '')[:100]}\")\n   280→            sections.append(\"\")\n   281→\n   282→        # Relevant Case Law\n   283→        cases = [f for f in findings if f.get(\"finding_type\") == \"evidence\"]\n   284→        if cases:\n   285→            sections.append(\"## Relevant Case Law\")\n   286→            sections.append(\"\")\n   287→            for case in cases[:6]:\n   288→                extracted = case.get(\"extracted_data\", {})\n   289→                if extracted and isinstance(extracted, dict):\n   290→                    case_name = extracted.get(\"case_name\", \"\")\n   291→                    citation = extracted.get(\"citation\", \"\")\n   292→                    holding = extracted.get(\"holding\", \"\")\n   293→                    if case_name:\n   294→                        sections.append(f\"### {case_name}\")\n   295→                        if citation:\n   296→                            sections.append(f\"*{citation}*\")\n   297→                        sections.append(\"\")\n   298→                        if holding:\n   299→                            sections.append(f\"**Holding:** {holding}\")\n   300→                        sections.append(\"\")\n   301→                else:\n   302→                    sections.append(f\"- {case.get('summary') or case.get('content', '')[:150]}\")\n   303→            sections.append(\"\")\n   304→\n   305→        # Legal Analysis\n   306→        perspectives = result.get(\"perspectives\", [])\n   307→        litigation = next((p for p in perspectives if \"litigation\" in p.get(\"perspective_type\", \"\").lower()), None)\n   308→        if litigation:\n   309→            sections.append(\"## Legal Analysis\")\n   310→            sections.append(\"\")\n   311→            sections.append(litigation.get(\"analysis_text\", \"\")[:800])\n   312→            sections.append(\"\")\n   313→\n   314→        # Risk Assessment\n   315→        risks = [f for f in findings if f.get(\"finding_type\") == \"pattern\"]\n   316→        if risks:\n   317→            sections.append(\"## Legal Risk Assessment\")\n   318→            sections.append(\"\")\n   319→            for r in risks[:5]:\n   320→                sections.append(f\"- {r.get('summary') or r.get('content', '')[:100]}\")\n   321→            sections.append(\"\")\n   322→\n   323→        # Recommendations\n   324→        sections.