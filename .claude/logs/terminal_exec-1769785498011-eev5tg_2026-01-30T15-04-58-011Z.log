[2026-01-30T15:07:19.580Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ToqM8xPXHMhez1f9YKxKPt","type":"tool_result","content":"     1→\"\"\"Due Diligence template for vetting companies, vendors, and partners.\"\"\"\n     2→\n     3→from typing import List, Dict, Any, Optional\n     4→from datetime import datetime\n     5→\n     6→from .base import BaseTemplate, TemplateConfig, FindingTypeConfig, FindingType\n     7→from ..services.report_components import (\n     8→    ComponentType, ReportHints\n     9→)\n    10→\n    11→\n    12→# ========== FINDING TYPE ENUM ==========\n    13→\n    14→class DueDiligenceFindingType(FindingType):\n    15→    \"\"\"Valid finding types for due diligence research.\"\"\"\n    16→    COMPANY_PROFILE = \"company_profile\"\n    17→    FINANCIAL_HEALTH = \"financial_health\"\n    18→    LEGAL_HISTORY = \"legal_history\"\n    19→    RED_FLAG = \"red_flag\"\n    20→    REPUTATION_SIGNAL = \"reputation_signal\"\n    21→    KEY_PERSON = \"key_person\"\n    22→\n    23→\n    24→# ========== TEMPLATE CONFIGURATION ==========\n    25→\n    26→DUE_DILIGENCE_CONFIG = TemplateConfig(\n    27→    search_intro=\"You are a professional due diligence researcher helping someone vet a business entity.\",\n    28→    search_angles=[\n    29→        {\n    30→            \"name\": \"COMPANY BASICS\",\n    31→            \"items\": [\n    32→                \"Official registration, founding date, headquarters\",\n    33→                \"Business model, products/services, market position\",\n    34→                \"Company size, employee count, growth trajectory\",\n    35→            ]\n    36→        },\n    37→        {\n    38→            \"name\": \"LEADERSHIP & KEY PEOPLE\",\n    39→            \"items\": [\n    40→                \"Founders, executives, board members\",\n    41→                \"Their backgrounds, previous companies, track records\",\n    42→                \"Any controversies or notable achievements\",\n    43→            ]\n    44→        },\n    45→        {\n    46→            \"name\": \"FINANCIAL HEALTH\",\n    47→            \"items\": [\n    48→                \"Funding history, investors, revenue signals\",\n    49→                \"Profitability indicators, growth metrics\",\n    50→                \"Any signs of financial distress\",\n    51→            ]\n    52→        },\n    53→        {\n    54→            \"name\": \"LEGAL & REGULATORY\",\n    55→            \"items\": [\n    56→                \"Lawsuits (plaintiff and defendant)\",\n    57→                \"Regulatory actions, fines, settlements\",\n    58→                \"Compliance issues, license status\",\n    59→            ]\n    60→        },\n    61→        {\n    62→            \"name\": \"REPUTATION & REVIEWS\",\n    63→            \"items\": [\n    64→                \"Customer reviews and complaints (BBB, Trustpilot, G2, etc.)\",\n    65→                \"Employee reviews (Glassdoor, Indeed)\",\n    66→                \"Industry reputation, awards, recognition\",\n    67→            ]\n    68→        },\n    69→        {\n    70→            \"name\": \"RED FLAGS\",\n    71→            \"items\": [\n    72→                \"Scam reports, fraud allegations\",\n    73→                \"High-profile failures or scandals\",\n    74→                \"Pattern of complaints or issues\",\n    75→            ]\n    76→        },\n    77→    ],\n    78→    search_depth_guidance={\n    79→        \"quick\": \"Focus on 3-4 most critical angles (legal, reviews, red flags)\",\n    80→        \"standard\": \"Cover 5-6 angles with balanced depth\",\n    81→        \"deep\": \"Comprehensive coverage of all angles\",\n    82→    },\n    83→\n    84→    extraction_intro=\"You are a due diligence analyst extracting findings to help someone make a business decision.\",\n    85→    finding_types=[\n    86→        FindingTypeConfig(\n    87→            name=\"company_profile\",\n    88→            display_name=\"Company Profile\",\n    89→            description=\"Basic facts about the entity\",\n    90→            extracted_data_schema='{\"name\": \"\", \"founded\": \"\", \"headquarters\": \"\", \"size\": \"\", \"industry\": \"\", \"business_model\": \"\"}',\n    91→            analysis_fallback=\"This profile information provides essential context for evaluating the entity.\",\n    92→        ),\n    93→        FindingTypeConfig(\n    94→            name=\"financial_health\",\n    95→            display_name=\"Financial Health\",\n    96→            description=\"Financial stability indicators\",\n    97→            extracted_data_schema='{\"indicator\": \"\", \"status\": \"healthy/concerning/unknown\", \"evidence\": \"\", \"trend\": \"\"}',\n    98→            analysis_fallback=\"This financial indicator helps assess the entity's stability and viability.\",\n    99→        ),\n   100→        FindingTypeConfig(\n   101→            name=\"legal_history\",\n   102→            display_name=\"Legal History\",\n   103→            description=\"Lawsuits, regulatory actions, legal issues\",\n   104→            extracted_data_schema='{\"case_type\": \"\", \"status\": \"\", \"outcome\": \"\", \"amount\": \"\", \"date\": \"\", \"significance\": \"\"}',\n   105→            analysis_fallback=\"This legal matter is relevant for assessing potential risks and liabilities.\",\n   106→        ),\n   107→        FindingTypeConfig(\n   108→            name=\"red_flag\",\n   109→            display_name=\"Red Flag\",\n   110→            description=\"Warning signs that should concern the user. Be specific about WHY this is a red flag.\",\n   111→            extracted_data_schema='{\"flag_type\": \"\", \"severity\": \"high/medium/low\", \"evidence\": \"\", \"recommendation\": \"\"}',\n   112→            analysis_fallback=\"This red flag warrants careful attention and may indicate significant risk.\",\n   113→        ),\n   114→        FindingTypeConfig(\n   115→            name=\"reputation_signal\",\n   116→            display_name=\"Reputation Signal\",\n   117→            description=\"Reviews, testimonials, industry standing\",\n   118→            extracted_data_schema='{\"source\": \"\", \"sentiment\": \"positive/negative/mixed\", \"rating\": \"\", \"common_themes\": []}',\n   119→            analysis_fallback=\"This reputation indicator helps gauge how the entity is perceived by stakeholders.\",\n   120→        ),\n   121→        FindingTypeConfig(\n   122→            name=\"key_person\",\n   123→            display_name=\"Key Person\",\n   124→            description=\"Leadership background and track record\",\n   125→            extracted_data_schema='{\"name\": \"\", \"role\": \"\", \"background\": \"\", \"track_record\": \"\", \"concerns\": \"\"}',\n   126→            analysis_fallback=\"Understanding this person's background helps assess leadership quality and risk.\",\n   127→        ),\n   128→    ],\n   129→    analysis_instruction=\"\"\"YOUR EXPERT DUE DILIGENCE ANALYSIS (REQUIRED - 2-4 sentences) explaining:\n   130→  * WHY this finding matters for the business decision at hand\n   131→  * What RISK or OPPORTUNITY this represents and how significant it is\n   132→  * How this COMPARES to industry norms or similar entities\n   133→  * What ADDITIONAL INVESTIGATION or verification this warrants\"\"\",\n   134→    extraction_guidelines=\"\"\"CRITICAL: The \"analysis\" field must provide substantive reasoning, not just describe the finding.\n   135→Good example: \"This pattern of multiple lawsuits from former employees alleging wage theft is a significant red flag. In our experience, companies with 3+ wage-related lawsuits in a 2-year period have a 70% likelihood of ongoing compliance issues. This also suggests potential labor law violations that could expose acquirers to successor liability. Recommend thorough review of payroll practices and settlement terms.\"\n   136→\n   137→IMPORTANT:\n   138→- Prioritize RED FLAGS - users need to know risks first\n   139→- Be specific with dates, amounts, and names when available\n   140→- Distinguish between verified facts and allegations\n   141→- Note when information is outdated or unverifiable\"\"\",\n   142→\n   143→    priority_finding_types=[\"red_flag\", \"legal_history\", \"financial_health\", \"reputation_signal\", \"key_person\", \"company_profile\"],\n   144→    grouping_order=[\"red_flag\", \"legal_history\", \"financial_health\", \"reputation_signal\", \"key_person\", \"company_profile\"],\n   145→)\n   146→\n   147→\n   148→class DueDiligenceTemplate(BaseTemplate):\n   149→    \"\"\"Template for business due diligence research.\n   150→\n   151→    Helps users vet potential business partners, vendors, employers,\n   152→    or investment targets by surfacing risks and verifying claims.\n   153→    \"\"\"\n   154→\n   155→    template_id = \"due_diligence\"\n   156→    template_name = \"Due Diligence\"\n   157→    description = \"Vet companies, vendors, and partners before signing contracts or making commitments\"\n   158→\n   159→    # Data-driven configuration\n   160→    config = DUE_DILIGENCE_CONFIG\n   161→\n   162→    # Report hints for component-based rendering\n   163→    report_hints = ReportHints(\n   164→        template_type=\"due_diligence\",\n   165→        structure=\"verdict_first\",\n   166→        findings_grouping=\"category\",\n   167→        tone=\"professional\",\n   168→        decision_format=\"scorecard\",\n   169→        emphasis=[\"overall_assessment\", \"red_flags\", \"strengths\", \"category_scores\"],\n   170→        required_components=[\n   171→            ComponentType.DUE_DILIGENCE_SCORECARD,\n   172→            ComponentType.CHECKLIST,\n   173→            ComponentType.FINDINGS_TABLE,\n   174→        ],\n   175→        optional_components=[\n   176→            ComponentType.RISK_MATRIX,\n   177→            ComponentType.KEY_INSIGHTS,\n   178→            ComponentType.ACTION_ITEMS,\n   179→            ComponentType.TIMELINE,\n   180→        ],\n   181→        visualization_preference=[\"scorecard\", \"category_radar\", \"red_flag_matrix\"],\n   182→        custom_sections={\n   183→            \"show_risk_score\": True,\n   184→            \"category_breakdown\": True,\n   185→            \"recommendation_prominent\": True,\n   186→        }\n   187→    )\n   188→\n   189→    # Expert perspectives for due diligence\n   190→    default_perspectives = [\n   191→        \"due_diligence_analyst\",  # Professional vetting\n   192→        \"forensic_financial\",     # Follow the money\n   193→        \"legal_liability\",        # Legal exposure\n   194→        \"industry_insider\",       # Operational reality\n   195→    ]\n   196→\n   197→    default_max_searches = 8\n   198→\n   199→    # Due diligence requires thorough verification\n   200→    verification_config = {\n   201→        \"cross_reference\": \"thorough\",\n   202→        \"bias_detection\": \"standard\",\n   203→        \"expert_sanity_check\": \"thorough\",\n   204→        \"source_quality\": \"thorough\",\n   205→    }\n   206→\n   207→    def get_supported_report_variants(self) -> List[str]:\n   208→        \"\"\"Due diligence supports risk_summary variant.\"\"\"\n   209→        return [\"full_report\", \"executive_summary\", \"risk_summary\"]\n   210→\n   211→    def generate_risk_summary(\n   212→        self,\n   213→        result: Dict[str, Any],\n   214→        title: Optional[str] = None,\n   215→    ) -> str:\n   216→        \"\"\"Generate risk-focused summary for due diligence.\"\"\"\n   217→        query = result.get(\"query\", \"Unknown\")\n   218→        report_title = title or f\"Due Diligence: {query[:50]}\"\n   219→\n   220→        sections = []\n   221→        sections.append(f\"# {report_title}\")\n   222→        sections.append(\"\")\n   223→        sections.append(f\"**Subject:** {query}\")\n   224→        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n   225→        sections.append(\"\")\n   226→\n   227→        findings = result.get(\"findings\", [])\n   228→\n   229→        # Risk verdict\n   230→        red_flags = [f for f in findings if f.get(\"finding_type\") == \"red_flag\"]\n   231→        high_severity = [f for f in red_flags if f.get(\"extracted_data\", {}).get(\"severity\") == \"high\"]\n   232→\n   233→        sections.append(\"## Risk Assessment\")\n   234→        sections.append(\"\")\n   235→        if high_severity:\n   236→            sections.append(\"**RISK LEVEL: HIGH** - Significant concerns identified\")\n   237→        elif red_flags:\n   238→            sections.append(\"**RISK LEVEL: MEDIUM** - Some concerns warrant attention\")\n   239→        else:\n   240→            sections.append(\"**RISK LEVEL: LOW** - No major red flags detected\")\n   241→        sections.append(\"\")\n   242→\n   243→        # Red flags first\n   244→        if red_flags:\n   245→            sections.append(\"## Red Flags\")\n   246→            sections.append(\"\")\n   247→            for rf in red_flags[:6]:\n   248→                extracted = rf.get(\"extracted_data\", {})\n   249→                severity = extracted.get(\"severity\", \"medium\").upper() if extracted else \"MEDIUM\"\n   250→                sections.append(f\"- **[{severity}]** {rf.get('summary', rf.get('content', '')[:100])}\")\n   251→            sections.append(\"\")\n   252→\n   253→        # Legal issues\n   254→        legal = [f for f in findings if f.get(\"finding_type\") == \"legal_history\"]\n   255→        if legal:\n   256→            sections.append(\"## Legal History\")\n   257→            sections.append(\"\")\n   258→            for l in legal[:5]:\n   259→                sections.append(f\"- {l.get('summary', l.get('content', '')[:100])}\")\n   260→            sections.append(\"\")\n   261→\n   262→        # Reputation\n   263→        reputation = [f for f in findings if f.get(\"finding_type\") == \"reputation_signal\"]\n   264→        if reputation:\n   265→            sections.append(\"## Reputation Signals\")\n   266→            sections.append(\"\")\n   267→            for r in reputation[:4]:\n   268→                sections.append(f\"- {r.get('summary', r.get('content', '')[:100])}\")\n   269→            sections.append(\"\")\n   270→\n   271→        return \"\\n\".join(sections)\n   272→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"063d9692-0974-4418-8890-3933b0ef315a","uuid":"b968d035-4e7b-4041-bde8-bcbead9c0d9c","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\actor\\src\\templates\\due_diligence.py","content":"\"\"\"Due Diligence template for vetting companies, vendors, and partners.\"\"\"\n\nfrom typing import List, Dict, Any, Optional\nfrom datetime import datetime\n\nfrom .base import BaseTemplate, TemplateConfig, FindingTypeConfig, FindingType\nfrom ..services.report_components import (\n    ComponentType, ReportHints\n)\n\n\n# ========== FINDING TYPE ENUM ==========\n\nclass DueDiligenceFindingType(FindingType):\n    \"\"\"Valid finding types for due diligence research.\"\"\"\n    COMPANY_PROFILE = \"company_profile\"\n    FINANCIAL_HEALTH = \"financial_health\"\n    LEGAL_HISTORY = \"legal_history\"\n    RED_FLAG = \"red_flag\"\n    REPUTATION_SIGNAL = \"reputation_signal\"\n    KEY_PERSON = \"key_person\"\n\n\n# ========== TEMPLATE CONFIGURATION ==========\n\nDUE_DILIGENCE_CONFIG = TemplateConfig(\n    search_intro=\"You are a professional due diligence researcher helping someone vet a business entity.\",\n    search_angles=[\n        {\n            \"name\": \"COMPANY BASICS\",\n            \"items\": [\n                \"Official registration, founding date, headquarters\",\n                \"Business model, products/services, market position\",\n                \"Company size, employee count, growth trajectory\",\n            ]\n        },\n        {\n            \"name\": \"LEADERSHIP & KEY PEOPLE\",\n            \"items\": [\n                \"Founders, executives, board members\",\n                \"Their backgrounds, previous companies, track records\",\n                \"Any controversies or notable achievements\",\n            ]\n        },\n        {\n            \"name\": \"FINANCIAL HEALTH\",\n            \"items\": [\n                \"Funding history, investors, revenue signals\",\n                \"Profitability indicators, growth metrics\",\n                \"Any signs of financial distress\",\n            ]\n        },\n        {\n            \"name\": \"LEGAL & REGULATORY\",\n            \"items\": [\n                \"Lawsuits (plaintiff and defendant)\",\n                \"Regulatory actions, fines, settlements\",\n                \"Compliance issues, license status\",\n            ]\n        },\n        {\n            \"name\": \"REPUTATION & REVIEWS\",\n            \"items\": [\n                \"Customer reviews and complaints (BBB, Trustpilot, G2, etc.)\",\n                \"Employee reviews (Glassdoor, Indeed)\",\n                \"Industry reputation, awards, recognition\",\n            ]\n        },\n        {\n            \"name\": \"RED FLAGS\",\n            \"items\": [\n                \"Scam reports, fraud allegations\",\n                \"High-profile failures or scandals\",\n                \"Pattern of complaints or issues\",\n            ]\n        },\n    ],\n    search_depth_guidance={\n        \"quick\": \"Focus on 3-4 most critical angles (legal, reviews, red flags)\",\n        \"standard\": \"Cover 5-6 angles with balanced depth\",\n        \"deep\": \"Comprehensive coverage of all angles\",\n    },\n\n    extraction_intro=\"You are a due diligence analyst extracting findings to help someone make a business decision.\",\n    finding_types=[\n        FindingTypeConfig(\n            name=\"company_profile\",\n            display_name=\"Company Profile\",\n            description=\"Basic facts about the entity\",\n            extracted_data_schema='{\"name\": \"\", \"founded\": \"\", \"headquarters\": \"\", \"size\": \"\", \"industry\": \"\", \"business_model\": \"\"}',\n            analysis_fallback=\"This profile information provides essential context for evaluating the entity.\",\n        ),\n        FindingTypeConfig(\n            name=\"financial_health\",\n            display_name=\"Financial Health\",\n            description=\"Financial stability indicators\",\n            extracted_data_schema='{\"indicator\": \"\", \"status\": \"healthy/concerning/unknown\", \"evidence\": \"\", \"trend\": \"\"}',\n            analysis_fallback=\"This financial indicator helps assess the entity's stability and viability.\",\n        ),\n        FindingTypeConfig(\n            name=\"legal_history\",\n            display_name=\"Legal History\",\n            description=\"Lawsuits, regulatory actions, legal issues\",\n            extracted_data_schema='{\"case_type\": \"\", \"status\": \"\", \"outcome\": \"\", \"amount\": \"\", \"date\": \"\", \"significance\": \"\"}',\n            analysis_fallback=\"This legal matter is relevant for assessing potential risks and liabilities.\",\n        ),\n        FindingTypeConfig(\n            name=\"red_flag\",\n            display_name=\"Red Flag\",\n            description=\"Warning signs that should concern the user. Be specific about WHY this is a red flag.\",\n            extracted_data_schema='{\"flag_type\": \"\", \"severity\": \"high/medium/low\", \"evidence\": \"\", \"recommendation\": \"\"}',\n            analysis_fallback=\"This red flag warrants careful attention and may indicate significant risk.\",\n        ),\n        FindingTypeConfig(\n            name=\"reputation_signal\",\n            display_name=\"Reputation Signal\",\n            description=\"Reviews, testimonials, industry standing\",\n            extracted_data_schema='{\"source\": \"\", \"sentiment\": \"positive/negative/mixed\", \"rating\": \"\", \"common_themes\": []}',\n            analysis_fallback=\"This reputation indicator helps gauge how the entity is perceived by stakeholders.\",\n        ),\n        FindingTypeConfig(\n            name=\"key_person\",\n            display_name=\"Key Person\",\n            description=\"Leadership background and track record\",\n            extracted_data_schema='{\"name\": \"\", \"role\": \"\", \"background\": \"\", \"track_record\": \"\", \"concerns\": \"\"}',\n            analysis_fallback=\"Understanding this person's background helps assess leadership quality and risk.\",\n        ),\n    ],\n    analysis_instruction=\"\"\"YOUR EXPERT DUE DILIGENCE ANALYSIS (REQUIRED - 2-4 sentences) explaining:\n  * WHY this finding matters for the business decision at hand\n  * What RISK or OPPORTUNITY this represents and how significant it is\n  * How this COMPARES to industry norms or similar entities\n  * What ADDITIONAL INVESTIGATION or verification this warrants\"\"\",\n    extraction_guidelines=\"\"\"CRITICAL: The \"analysis\" field must provide substantive reasoning, not just describe the finding.\nGood example: \"This pattern of multiple lawsuits from former employees alleging wage theft is a significant red flag. In our experience, companies with 3+ wage-related lawsuits in a 2-year period have a 70% likelihood of ongoing compliance issues. This also suggests potential labor law violations that could expose acquirers to successor liability. Recommend thorough review of payroll practices and settlement terms.\"\n\nIMPORTANT:\n- Prioritize RED FLAGS - users need to know risks first\n- Be specific with dates, amounts, and names when available\n- Distinguish between verified facts and allegations\n- Note when information is outdated or unverifiable\"\"\",\n\n    priority_finding_types=[\"red_flag\", \"legal_history\", \"financial_health\", \"reputation_signal\", \"key_person\", \"company_profile\"],\n    grouping_order=[\"red_flag\", \"legal_history\", \"financial_health\", \"reputation_signal\", \"key_person\", \"company_profile\"],\n)\n\n\nclass DueDiligenceTemplate(BaseTemplate):\n    \"\"\"Template for business due diligence research.\n\n    Helps users vet potential business partners, vendors, employers,\n    or investment targets by surfacing risks and verifying claims.\n    \"\"\"\n\n    template_id = \"due_diligence\"\n    template_name = \"Due Diligence\"\n    description = \"Vet companies, vendors, and partners before signing contracts or making commitments\"\n\n    # Data-driven configuration\n    config = DUE_DILIGENCE_CONFIG\n\n    # Report hints for component-based rendering\n    report_hints = ReportHints(\n        template_type=\"due_diligence\",\n        structure=\"verdict_first\",\n        findings_grouping=\"category\",\n        tone=\"professional\",\n        decision_format=\"scorecard\",\n        emphasis=[\"overall_assessment\", \"red_flags\", \"strengths\", \"category_scores\"],\n        required_components=[\n            ComponentType.DUE_DILIGENCE_SCORECARD,\n            ComponentType.CHECKLIST,\n            ComponentType.FINDINGS_TABLE,\n        ],\n        optional_components=[\n            ComponentType.RISK_MATRIX,\n            ComponentType.KEY_INSIGHTS,\n            ComponentType.ACTION_ITEMS,\n            ComponentType.TIMELINE,\n        ],\n        visualization_preference=[\"scorecard\", \"category_radar\", \"red_flag_matrix\"],\n        custom_sections={\n            \"show_risk_score\": True,\n            \"category_breakdown\": True,\n            \"recommendation_prominent\": True,\n        }\n    )\n\n    # Expert perspectives for due diligence\n    default_perspectives = [\n        \"due_diligence_analyst\",  # Professional vetting\n        \"forensic_financial\",     # Follow the money\n        \"legal_liability\",        # Legal exposure\n        \"industry_insider\",       # Operational reality\n    ]\n\n    default_max_searches = 8\n\n    # Due diligence requires thorough verification\n    verification_config = {\n        \"cross_reference\": \"thorough\",\n        \"bias_detection\": \"standard\",\n        \"expert_sanity_check\": \"thorough\",\n        \"source_quality\": \"thorough\",\n    }\n\n    def get_supported_report_variants(self) -> List[str]:\n        \"\"\"Due diligence supports risk_summary variant.\"\"\"\n        return [\"full_report\", \"executive_summary\", \"risk_summary\"]\n\n    def generate_risk_summary(\n        self,\n        result: Dict[str, Any],\n        title: Optional[str] = None,\n    ) -> str:\n        \"\"\"Generate risk-focused summary for due diligence.\"\"\"\n        query = result.get(\"query\", \"Unknown\")\n        report_title = title or f\"Due Diligence: {query[:50]}\"\n\n        sections = []\n        sections.append(f\"# {report_title}\")\n        sections.append(\"\")\n        sections.append(f\"**Subject:** {query}\")\n        sections.append(f\"**Date:** {datetime.now().strftime('%B %d, %Y')}\")\n        sections.append(\"\")\n\n        findings = result.get(\"findings\", [])\n\n        # Risk verdict\n        red_flags = [f for f in findings if f.get(\"finding_type\") == \"red_flag\"]\n        high_severity = [f for f in red_flags if f.get(\"extracted_data\", {}).get(\"severity\") == \"high\"]\n\n        sections.append(\"## Risk Assessment\")\n        sections.append(\"\")\n        if high_severity:\n            sections.append(\"**RISK LEVEL: HIGH** - Significant concerns identified\")\n        elif red_flags:\n            sections.append(\"**RISK LEVEL: MEDIUM** - Some concerns warrant attention\")\n        else:\n            sections.append(\"**RISK LEVEL: LOW** - No major red flags detected\")\n        sections.append(\"\")\n\n        # Red flags first\n        if red_flags:\n            sections.append(\"## Red Flags\")\n            sections.append(\"\")\n            for rf in red_flags[:6]:\n                extracted = rf.get(\"extracted_data\", {})\n                severity = extracted.get(\"severity\", \"medium\").upper() if extracted else \"MEDIUM\"\n                sections.append(f\"- **[{severity}]** {rf.get('summary', rf.get('content', '')[:100])}\")\n            sections.append(\"\")\n\n        # Legal issues\n        legal = [f for f in findings if f.get(\"finding_type\") == \"legal_history\"]\n        if legal:\n            sections.append(\"## Legal History\")\n            sections.append(\"\")\n            for l in legal[:5]:\n                sections.append(f\"- {l.get('summary', l.get('content', '')[:100])}\")\n            sections.append(\"\")\n\n        # Reputation\n        reputation = [f for f in findings if f.get(\"finding_type\") == \"reputation_signal\"]\n        if reputation:\n            sections.append(\"## Reputation Signals\")\n            sections.append(\"\")\n            for r in reputation[:4]:\n                sections.append(f\"- {r.get('summary', r.get('content', '')[:100])}\")\n            sections.append(\"\")\n\n        return \"\\n\".join(sections)\n","numLines":272,"startLine":1,"totalLines":272}}}
