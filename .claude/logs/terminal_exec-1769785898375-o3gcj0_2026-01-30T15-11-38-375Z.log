[2026-01-30T15:12:04.223Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018uqkVZUFN3KzBE71Pfr7b8","type":"tool_result","content":"     1→'use client';\n     2→\n     3→import { useRef, useState } from 'react';\n     4→import { motion } from 'framer-motion';\n     5→import { useVisualizationTheme } from './useVisualizationTheme';\n     6→import { useForceLayout, useContainerDimensions, type LayoutEdge } from '@/src/lib/layout';\n     7→\n     8→interface Node {\n     9→  id: string;\n    10→  label: string;\n    11→  type: 'finding' | 'source' | 'entity' | 'perspective';\n    12→  value: number; // 0-1 for sizing\n    13→  x?: number;\n    14→  y?: number;\n    15→}\n    16→\n    17→interface Edge {\n    18→  source: string;\n    19→  target: string;\n    20→  strength: number; // 0-1\n    21→  type?: 'supports' | 'contradicts' | 'references';\n    22→}\n    23→\n    24→interface NetworkGraphProps {\n    25→  nodes: Node[];\n    26→  edges: Edge[];\n    27→  onNodeClick?: (nodeId: string) => void;\n    28→  highlightedNode?: string;\n    29→}\n    30→\n    31→export function NetworkGraph({ nodes, edges, onNodeClick, highlightedNode }: NetworkGraphProps) {\n    32→  const { colors, getEntityColor, surfaceClasses, tooltipClasses } = useVisualizationTheme();\n    33→  const [containerRef, dimensions] = useContainerDimensions();\n    34→  const [hoveredNode, setHoveredNode] = useState<string | null>(null);\n    35→\n    36→  // Convert nodes to layout format and use shared force layout\n    37→  const layoutNodes = nodes.map((n) => ({\n    38→    id: n.id,\n    39→    x: n.x ?? 0,\n    40→    y: n.y ?? 0,\n    41→    value: n.value,\n    42→  }));\n    43→\n    44→  const layoutEdges: LayoutEdge[] = edges.map((e) => ({\n    45→    source: e.source,\n    46→    target: e.target,\n    47→    strength: e.strength,\n    48→  }));\n    49→\n    50→  // Use the shared force-directed layout hook\n    51→  const positions = useForceLayout(layoutNodes, layoutEdges, dimensions, {\n    52→    iterations: 50,\n    53→    repulsion: 1000,\n    54→    attraction: 0.01,\n    55→    damping: 0.1,\n    56→    padding: 40,\n    57→  });\n    58→\n    59→  return (\n    60→    <div\n    61→      ref={containerRef}\n    62→      className={`relative w-full h-64 rounded-xl overflow-hidden ${surfaceClasses}`}\n    63→    >\n    64→      {/* Grid pattern */}\n    65→      <svg className=\"absolute inset-0 w-full h-full opacity-10\">\n    66→        <defs>\n    67→          <pattern id=\"grid\" width=\"20\" height=\"20\" patternUnits=\"userSpaceOnUse\">\n    68→            <path d=\"M 20 0 L 0 0 0 20\" fill=\"none\" stroke={colors.primary} strokeWidth=\"0.5\" />\n    69→          </pattern>\n    70→        </defs>\n    71→        <rect width=\"100%\" height=\"100%\" fill=\"url(#grid)\" />\n    72→      </svg>\n    73→\n    74→      {/* Edges */}\n    75→      <svg className=\"absolute inset-0 w-full h-full\">\n    76→        {edges.map((edge, i) => {\n    77→          const from = positions.get(edge.source);\n    78→          const to = positions.get(edge.target);\n    79→          if (!from || !to) return null;\n    80→          const isHighlighted = hoveredNode === edge.source || hoveredNode === edge.target;\n    81→          return (\n    82→            <motion.line\n    83→              key={i}\n    84→              initial={{ pathLength: 0, opacity: 0 }}\n    85→              animate={{ pathLength: 1, opacity: isHighlighted ? 0.8 : 0.3 }}\n    86→              transition={{ duration: 0.5, delay: i * 0.02 }}\n    87→              x1={from.x}\n    88→              y1={from.y}\n    89→              x2={to.x}\n    90→              y2={to.y}\n    91→              stroke={edge.type === 'contradicts' ? colors.contradictionLine : colors.connectionLine}\n    92→              strokeWidth={isHighlighted ? 2 : 1}\n    93→              strokeDasharray={edge.type === 'contradicts' ? '4,4' : undefined}\n    94→            />\n    95→          );\n    96→        })}\n    97→      </svg>\n    98→\n    99→      {/* Nodes */}\n   100→      {nodes.map((node, i) => {\n   101→        const pos = positions.get(node.id);\n   102→        if (!pos) return null;\n   103→        const color = getEntityColor(node.type);\n   104→        const size = 12 + node.value * 20;\n   105→        const isHovered = hoveredNode === node.id;\n   106→        const isHighlightedNode = highlightedNode === node.id;\n   107→\n   108→        return (\n   109→          <motion.div\n   110→            key={node.id}\n   111→            initial={{ scale: 0, opacity: 0 }}\n   112→            animate={{\n   113→              scale: isHovered || isHighlightedNode ? 1.3 : 1,\n   114→              opacity: 1,\n   115→              x: pos.x - size / 2,\n   116→              y: pos.y - size / 2,\n   117→            }}\n   118→            transition={{ type: 'spring', damping: 20, delay: i * 0.03 }}\n   119→            className=\"absolute cursor-pointer\"\n   120→            style={{ width: size, height: size }}\n   121→            onMouseEnter={() => setHoveredNode(node.id)}\n   122→            onMouseLeave={() => setHoveredNode(null)}\n   123→            onClick={() => onNodeClick?.(node.id)}\n   124→          >\n   125→            <div\n   126→              className=\"w-full h-full rounded-full flex items-center justify-center transition-shadow\"\n   127→              style={{\n   128→                backgroundColor: color,\n   129→                boxShadow: isHovered || isHighlightedNode ? `0 0 20px ${color}` : `0 0 8px ${color}50`,\n   130→              }}\n   131→            >\n   132→              {isHovered && (\n   133→                <motion.div\n   134→                  initial={{ opacity: 0, y: 10 }}\n   135→                  animate={{ opacity: 1, y: 0 }}\n   136→                  className={`absolute -bottom-8 left-1/2 -translate-x-1/2 whitespace-nowrap px-2 py-1 rounded text-[10px] font-medium ${tooltipClasses}`}\n   137→                >\n   138→                  {node.label}\n   139→                </motion.div>\n   140→              )}\n   141→            </div>\n   142→          </motion.div>\n   143→        );\n   144→      })}\n   145→    </div>\n   146→  );\n   147→}\n   148→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"063d9692-0974-4418-8890-3933b0ef315a","uuid":"0fa705a5-9300-4827-8707-208e75aff71d","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\visualizations\\NetworkGraph.tsx","content":"'use client';\n\nimport { useRef, useState } from 'react';\nimport { motion } from 'framer-motion';\nimport { useVisualizationTheme } from './useVisualizationTheme';\nimport { useForceLayout, useContainerDimensions, type LayoutEdge } from '@/src/lib/layout';\n\ninterface Node {\n  id: string;\n  label: string;\n  type: 'finding' | 'source' | 'entity' | 'perspective';\n  value: number; // 0-1 for sizing\n  x?: number;\n  y?: number;\n}\n\ninterface Edge {\n  source: string;\n  target: string;\n  strength: number; // 0-1\n  type?: 'supports' | 'contradicts' | 'references';\n}\n\ninterface NetworkGraphProps {\n  nodes: Node[];\n  edges: Edge[];\n  onNodeClick?: (nodeId: string) => void;\n  highlightedNode?: string;\n}\n\nexport function NetworkGraph({ nodes, edges, onNodeClick, highlightedNode }: NetworkGraphProps) {\n  const { colors, getEntityColor, surfaceClasses, tooltipClasses } = useVisualizationTheme();\n  const [containerRef, dimensions] = useContainerDimensions();\n  const [hoveredNode, setHoveredNode] = useState<string | null>(null);\n\n  // Convert nodes to layout format and use shared force layout\n  const layoutNodes = nodes.map((n) => ({\n    id: n.id,\n    x: n.x ?? 0,\n    y: n.y ?? 0,\n    value: n.value,\n  }));\n\n  const layoutEdges: LayoutEdge[] = edges.map((e) => ({\n    source: e.source,\n    target: e.target,\n    strength: e.strength,\n  }));\n\n  // Use the shared force-directed layout hook\n  const positions = useForceLayout(layoutNodes, layoutEdges, dimensions, {\n    iterations: 50,\n    repulsion: 1000,\n    attraction: 0.01,\n    damping: 0.1,\n    padding: 40,\n  });\n\n  return (\n    <div\n      ref={containerRef}\n      className={`relative w-full h-64 rounded-xl overflow-hidden ${surfaceClasses}`}\n    >\n      {/* Grid pattern */}\n      <svg className=\"absolute inset-0 w-full h-full opacity-10\">\n        <defs>\n          <pattern id=\"grid\" width=\"20\" height=\"20\" patternUnits=\"userSpaceOnUse\">\n            <path d=\"M 20 0 L 0 0 0 20\" fill=\"none\" stroke={colors.primary} strokeWidth=\"0.5\" />\n          </pattern>\n        </defs>\n        <rect width=\"100%\" height=\"100%\" fill=\"url(#grid)\" />\n      </svg>\n\n      {/* Edges */}\n      <svg className=\"absolute inset-0 w-full h-full\">\n        {edges.map((edge, i) => {\n          const from = positions.get(edge.source);\n          const to = positions.get(edge.target);\n          if (!from || !to) return null;\n          const isHighlighted = hoveredNode === edge.source || hoveredNode === edge.target;\n          return (\n            <motion.line\n              key={i}\n              initial={{ pathLength: 0, opacity: 0 }}\n              animate={{ pathLength: 1, opacity: isHighlighted ? 0.8 : 0.3 }}\n              transition={{ duration: 0.5, delay: i * 0.02 }}\n              x1={from.x}\n              y1={from.y}\n              x2={to.x}\n              y2={to.y}\n              stroke={edge.type === 'contradicts' ? colors.contradictionLine : colors.connectionLine}\n              strokeWidth={isHighlighted ? 2 : 1}\n              strokeDasharray={edge.type === 'contradicts' ? '4,4' : undefined}\n            />\n          );\n        })}\n      </svg>\n\n      {/* Nodes */}\n      {nodes.map((node, i) => {\n        const pos = positions.get(node.id);\n        if (!pos) return null;\n        const color = getEntityColor(node.type);\n        const size = 12 + node.value * 20;\n        const isHovered = hoveredNode === node.id;\n        const isHighlightedNode = highlightedNode === node.id;\n\n        return (\n          <motion.div\n            key={node.id}\n            initial={{ scale: 0, opacity: 0 }}\n            animate={{\n              scale: isHovered || isHighlightedNode ? 1.3 : 1,\n              opacity: 1,\n              x: pos.x - size / 2,\n              y: pos.y - size / 2,\n            }}\n            transition={{ type: 'spring', damping: 20, delay: i * 0.03 }}\n            className=\"absolute cursor-pointer\"\n            style={{ width: size, height: size }}\n            onMouseEnter={() => setHoveredNode(node.id)}\n            onMouseLeave={() => setHoveredNode(null)}\n            onClick={() => onNodeClick?.(node.id)}\n          >\n            <div\n              className=\"w-full h-full rounded-full flex items-center justify-center transition-shadow\"\n              style={{\n                backgroundColor: color,\n                boxShadow: isHovered || isHighlightedNode ? `0 0 20px ${color}` : `0 0 8px ${color}50`,\n              }}\n            >\n              {isHovered && (\n                <motion.div\n                  initial={{ opacity: 0, y: 10 }}\n                  animate={{ opacity: 1, y: 0 }}\n                  className={`absolute -bottom-8 left-1/2 -translate-x-1/2 whitespace-nowrap px-2 py-1 rounded text-[10px] font-medium ${tooltipClasses}`}\n                >\n                  {node.label}\n                </motion.div>\n              )}\n            </div>\n          </motion.div>\n        );\n      })}\n    </div>\n  );\n}\n","numLines":148,"startLine":1,"totalLines":148}}}
