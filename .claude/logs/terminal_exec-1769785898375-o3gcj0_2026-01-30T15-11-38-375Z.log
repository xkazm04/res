    48→    jitter: 0.3,\n    49→  });\n    50→\n    51→  // Calculate node radius from credibility\n    52→  const getNodeRadius = (credibility: number) => 6 + credibility * 14;\n    53→\n    54→  return (\n    55→    <div ref={containerRef} className={`relative rounded-xl overflow-hidden ${surfaceClasses}`} style={{ height: 300 }}>\n    56→      {/* Trust rings */}\n    57→      <svg className=\"absolute inset-0\" width={dimensions.width} height={300}>\n    58→        {[0.8, 0.5, 0.2].map((level) => (\n    59→          <circle\n    60→            key={level}\n    61→            cx={dimensions.width / 2}\n    62→            cy={150}\n    63→            r={Math.min(dimensions.width, 300) * 0.4 * (1 - level * 0.8)}\n    64→            fill=\"none\"\n    65→            stroke={colors.gridLine}\n    66→            strokeDasharray=\"4 4\"\n    67→          />\n    68→        ))}\n    69→\n    70→        {/* Nodes */}\n    71→        {nodes.map((node) => {\n    72→          const radius = getNodeRadius(node.credibility);\n    73→          return (\n    74→            <g key={node.id}>\n    75→              <motion.circle\n    76→                initial={{ scale: 0 }}\n    77→                animate={{\n    78→                  scale: hoveredNode === node.id || selectedSource === node.id ? 1.5 : 1,\n    79→                  opacity: hoveredNode && hoveredNode !== node.id ? 0.4 : 1\n    80→                }}\n    81→                cx={node.x}\n    82→                cy={node.y}\n    83→                r={radius}\n    84→                fill={getCredibilityColor(node.credibility)}\n    85→                stroke={selectedSource === node.id ? (isRadar ? '#fff' : '#000') : 'transparent'}\n    86→                strokeWidth={2}\n    87→                className=\"cursor-pointer\"\n    88→                onMouseEnter={() => setHoveredNode(node.id)}\n    89→                onMouseLeave={() => setHoveredNode(null)}\n    90→                onClick={() => onSourceSelect?.(node.id)}\n    91→              />\n    92→            </g>\n    93→          );\n    94→        })}\n    95→      </svg>\n    96→\n    97→      {/* Labels */}\n    98→      <div className=\"absolute bottom-3 left-3 flex items-center gap-4 text-[10px]\" style={{ color: colors.textSecondary }}>\n    99→        <span className=\"flex items-center gap-1\">\n   100→          <span className=\"w-2 h-2 rounded-full\" style={{ backgroundColor: colors.success }} /> High\n   101→        </span>\n   102→        <span className=\"flex items-center gap-1\">\n   103→          <span className=\"w-2 h-2 rounded-full\" style={{ backgroundColor: colors.warning }} /> Medium\n   104→        </span>\n   105→        <span className=\"flex items-center gap-1\">\n   106→          <span className=\"w-2 h-2 rounded-full\" style={{ backgroundColor: colors.danger }} /> Low\n   107→        </span>\n   108→      </div>\n   109→\n   110→      {/* Center label */}\n   111→      <div\n   112→        className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-center pointer-events-none\"\n   113→        style={{ color: isRadar ? colors.primaryMuted : colors.textMuted }}\n   114→      >\n   115→        <div className=\"text-[10px] uppercase tracking-wider\">Trust Core</div>\n   116→      </div>\n   117→    </div>\n   118→  );\n   119→}\n   120→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"063d9692-0974-4418-8890-3933b0ef315a","uuid":"43613cb9-82d5-42be-b354-08d59eecf20d","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\visualizations\\SourceNetwork.tsx","content":"'use client';\n\nimport { useState } from 'react';\nimport { motion } from 'framer-motion';\nimport { useVisualizationTheme } from './useVisualizationTheme';\nimport { useConcentricLayoutNodes, useContainerDimensions } from '@/src/lib/layout';\nimport type { ResearchSource } from '@/src/types/research';\n\ninterface SourceNetworkProps {\n  sources: ResearchSource[];\n  onSourceSelect?: (id: string) => void;\n  selectedSource?: string;\n}\n\ninterface SourceNode {\n  id: string;\n  x: number;\n  y: number;\n  radius: number;\n  credibility: number;\n  domain: string;\n  type: string;\n}\n\nexport function SourceNetwork({ sources, onSourceSelect, selectedSource }: SourceNetworkProps) {\n  const { colors, isRadar, surfaceClasses, getCredibilityColor } = useVisualizationTheme();\n  const [containerRef, dimensions] = useContainerDimensions();\n  const [hoveredNode, setHoveredNode] = useState<string | null>(null);\n\n  // Convert sources to layout nodes with credibility as the value property\n  const layoutNodes = sources.map((s) => ({\n    id: s.id,\n    x: 0,\n    y: 0,\n    value: s.credibility_score ?? 0.5,\n    credibility: s.credibility_score ?? 0.5,\n    domain: s.domain || 'unknown',\n    type: s.source_type || 'web',\n  }));\n\n  // Use the shared concentric layout hook\n  const nodes = useConcentricLayoutNodes(layoutNodes, {\n    width: dimensions.width,\n    height: 300,\n  }, {\n    radiusProperty: 'value',\n    invertRadius: true, // Higher credibility = closer to center\n    jitter: 0.3,\n  });\n\n  // Calculate node radius from credibility\n  const getNodeRadius = (credibility: number) => 6 + credibility * 14;\n\n  return (\n    <div ref={containerRef} className={`relative rounded-xl overflow-hidden ${surfaceClasses}`} style={{ height: 300 }}>\n      {/* Trust rings */}\n      <svg className=\"absolute inset-0\" width={dimensions.width} height={300}>\n        {[0.8, 0.5, 0.2].map((level) => (\n          <circle\n            key={level}\n            cx={dimensions.width / 2}\n            cy={150}\n            r={Math.min(dimensions.width, 300) * 0.4 * (1 - level * 0.8)}\n            fill=\"none\"\n            stroke={colors.gridLine}\n            strokeDasharray=\"4 4\"\n          />\n        ))}\n\n        {/* Nodes */}\n        {nodes.map((node) => {\n          const radius = getNodeRadius(node.credibility);\n          return (\n            <g key={node.id}>\n              <motion.circle\n                initial={{ scale: 0 }}\n                animate={{\n                  scale: hoveredNode === node.id || selectedSource === node.id ? 1.5 : 1,\n                  opacity: hoveredNode && hoveredNode !== node.id ? 0.4 : 1\n                }}\n                cx={node.x}\n                cy={node.y}\n                r={radius}\n                fill={getCredibilityColor(node.credibility)}\n                stroke={selectedSource === node.id ? (isRadar ? '#fff' : '#000') : 'transparent'}\n                strokeWidth={2}\n                className=\"cursor-pointer\"\n                onMouseEnter={() => setHoveredNode(node.id)}\n                onMouseLeave={() => setHoveredNode(null)}\n                onClick={() => onSourceSelect?.(node.id)}\n              />\n            </g>\n          );\n        })}\n      </svg>\n\n      {/* Labels */}\n      <div className=\"absolute bottom-3 left-3 flex items-center gap-4 text-[10px]\" style={{ color: colors.textSecondary }}>\n        <span className=\"flex items-center gap-1\">\n          <span className=\"w-2 h-2 rounded-full\" style={{ backgroundColor: colors.success }} /> High\n        </span>\n        <span className=\"flex items-center gap-1\">\n          <span className=\"w-2 h-2 rounded-full\" style={{ backgroundColor: colors.warning }} /> Medium\n        </span>\n        <span className=\"flex items-center gap-1\">\n          <span className=\"w-2 h-2 rounded-full\" style={{ backgroundColor: colors.danger }} /> Low\n        </span>\n      </div>\n\n      {/* Center label */}\n      <div\n        className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-center pointer-events-none\"\n        style={{ color: isRadar ? colors.primaryMuted : colors.textMuted }}\n      >\n        <div className=\"text-[10px] uppercase tracking-wider\">Trust Core</div>\n      </div>\n    </div>\n  );\n}\n","numLines":120,"startLine":1,"totalLines":120}}}
