  className={`px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${getButtonClasses(activeChain === chain.id)}`}\n    43→            >\n    44→              Chain {i + 1}\n    45→            </button>\n    46→          ))}\n    47→        </div>\n    48→      )}\n    49→\n    50→      {/* Flow visualization */}\n    51→      <div className=\"p-6\">\n    52→        <div className=\"relative\">\n    53→          {/* Connection line */}\n    54→          <div className={`absolute top-6 left-0 right-0 h-0.5 bg-gradient-to-r ${gradientColors}`} />\n    55→\n    56→          {/* Steps */}\n    57→          <div className=\"relative flex justify-between\">\n    58→            {steps.map((step, i) => {\n    59→              const isHovered = hoveredStep === i;\n    60→              const glowIntensity = isHovered ? '20' : '10';\n    61→              const glowOpacity = isHovered ? '0.5' : '0.3';\n    62→\n    63→              return (\n    64→                <motion.div\n    65→                  key={i}\n    66→                  initial={{ opacity: 0, y: 20 }}\n    67→                  animate={{ opacity: 1, y: 0 }}\n    68→                  transition={{ delay: i * 0.15 }}\n    69→                  className=\"flex flex-col items-center\"\n    70→                  style={{ width: `${100 / steps.length}%` }}\n    71→                  onMouseEnter={() => setHoveredStep(i)}\n    72→                  onMouseLeave={() => setHoveredStep(null)}\n    73→                >\n    74→                  {/* Node */}\n    75→                  <motion.div\n    76→                    animate={{ scale: isHovered ? 1.2 : 1 }}\n    77→                    className={`relative z-10 w-12 h-12 rounded-full flex items-center justify-center cursor-pointer transition-all bg-gradient-to-br ${nodeGradient}`}\n    78→                    style={{\n    79→                      boxShadow: isRadar\n    80→                        ? `0 0 ${glowIntensity}px rgba(34,211,238,${glowOpacity})`\n    81→     