ght */}\n    48→          <div\n    49→            className=\"absolute inset-0 pointer-events-none\"\n    50→            style={{\n    51→              background: isRadar\n    52→                ? 'radial-gradient(ellipse 60% 50% at center, transparent 0%, rgba(0,0,0,0.8) 100%)'\n    53→                : 'radial-gradient(ellipse 60% 50% at center, transparent 0%, rgba(0,0,0,0.9) 100%)',\n    54→            }}\n    55→          />\n    56→\n    57→          {/* Content */}\n    58→          <motion.div\n    59→            initial={{ scale: 0.9, opacity: 0 }}\n    60→            animate={{ scale: 1, opacity: 1 }}\n    61→            exit={{ scale: 0.9, opacity: 0 }}\n    62→            className={`relative z-10 max-w-3xl max-h-[80vh] overflow-y-auto p-8 rounded-2xl ${isRadar ? 'bg-slate-900/90 border border-cyan-500/30' : 'bg-white shadow-2xl'}`}\n    63→            onClick={(e) => e.stopPropagation()}\n    64→          >\n    65→            {/* Close hint */}\n    66→            <div className={`absolute top-4 right-4 text-xs ${isRadar ? 'text-cyan-400/60' : 'text-stone-400'}`}>\n    67→              Press ESC to exit\n    68→            </div>\n    69→\n    70→            {children}\n    71→          </motion.div>\n    72→\n    73→          {/* Ambient glow for radar theme with breathing animation */}\n    74→          {isRadar && (\n    75→            <div className=\"absolute inset-0 pointer-events-none\">\n    76→              <motion.div\n    77→                className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-cyan-500 blur-3xl rounded-full\"\n    78→                initial={{ scale: 1, opacity: 0.05 }}\n    79→                animate={\n    80→                  reducedMotion\n    81→                    ? { scale: 1, opacity: 0.05 }\n    82→                    : {\n    83→                        scale: [0.95, 1.05, 0.95],\n    84→                        opacity: [0.03, 0.07, 0.03],\n    85→                      }\n    86→                }\n    87→                transition={\n    88→                  reducedMotion\n    89→                    ? undefined\n    90→                    : {\n    91→                        duration: 4,\n    92→                        ease: 'easeInOut',\n    93→                        repeat: Infinity,\n    94→                      }\n    95→                }\n    96→              />\n    97→            </div>\n    98→          )}\n    99→        </motion.div>\n   100→      )}\n   101→    </AnimatePresence>\n   102→  );\n   103→}\n   104→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"063d9692-0974-4418-8890-3933b0ef315a","uuid":"bdb12418-fd8c-45ab-b4a2-2090810c2cf3","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\features\\FocusMode.tsx","content":"'use client';\n\nimport { useEffect, useState, type ReactNode } from 'react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport { useReportTheme } from '../core/ThemeContext';\n\n// Hook to detect reduced motion preference\nfunction useReducedMotion() {\n  const [reducedMotion, setReducedMotion] = useState(false);\n\n  useEffect(() => {\n    const mediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)');\n    setReducedMotion(mediaQuery.matches);\n\n    const handler = (e: MediaQueryListEvent) => setReducedMotion(e.matches);\n    mediaQuery.addEventListener('change', handler);\n    return () => mediaQuery.removeEventListener('change', handler);\n  }, []);\n\n  return reducedMotion;\n}\n\ninterface FocusModeProps {\n  children: ReactNode;\n  enabled: boolean;\n  onClose: () => void;\n}\n\nexport function FocusMode({ children, enabled, onClose }: FocusModeProps) {\n  const { theme } = useReportTheme();\n  const isRadar = theme === 'radar';\n  const reducedMotion = useReducedMotion();\n\n  return (\n    <AnimatePresence>\n      {enabled && (\n        <motion.div\n          initial={{ opacity: 0 }}\n          animate={{ opacity: 1 }}\n          exit={{ opacity: 0 }}\n          className=\"fixed inset-0 z-50 flex items-center justify-center\"\n          onClick={onClose}\n        >\n          {/* Spotlight background */}\n          <div className={`absolute inset-0 ${isRadar ? 'bg-slate-950/98' : 'bg-stone-950/95'}`} />\n\n          {/* Radial gradient spotlight */}\n          <div\n            className=\"absolute inset-0 pointer-events-none\"\n            style={{\n              background: isRadar\n                ? 'radial-gradient(ellipse 60% 50% at center, transparent 0%, rgba(0,0,0,0.8) 100%)'\n                : 'radial-gradient(ellipse 60% 50% at center, transparent 0%, rgba(0,0,0,0.9) 100%)',\n            }}\n          />\n\n          {/* Content */}\n          <motion.div\n            initial={{ scale: 0.9, opacity: 0 }}\n            animate={{ scale: 1, opacity: 1 }}\n            exit={{ scale: 0.9, opacity: 0 }}\n            className={`relative z-10 max-w-3xl max-h-[80vh] overflow-y-auto p-8 rounded-2xl ${isRadar ? 'bg-slate-900/90 border border-cyan-500/30' : 'bg-white shadow-2xl'}`}\n            onClick={(e) => e.stopPropagation()}\n          >\n            {/* Close hint */}\n            <div className={`absolute top-4 right-4 text-xs ${isRadar ? 'text-cyan-400/60' : 'text-stone-400'}`}>\n              Press ESC to exit\n            </div>\n\n            {children}\n          </motion.div>\n\n          {/* Ambient glow for radar theme with breathing animation */}\n          {isRadar && (\n            <div className=\"absolute inset-0 pointer-events-none\">\n              <motion.div\n                className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-cyan-500 blur-3xl rounded-full\"\n                initial={{ scale: 1, opacity: 0.05 }}\n                animate={\n                  reducedMotion\n                    ? { scale: 1, opacity: 0.05 }\n                    : {\n                        scale: [0.95, 1.05, 0.95],\n                        opacity: [0.03, 0.07, 0.03],\n                      }\n                }\n                transition={\n                  reducedMotion\n                    ? undefined\n                    : {\n                        duration: 4,\n                        ease: 'easeInOut',\n                        repeat: Infinity,\n                      }\n                }\n              />\n            </div>\n          )}\n        </motion.div>\n      )}\n    </AnimatePresence>\n  );\n}\n","numLines":104,"startLine":1,"totalLines":104}}}
