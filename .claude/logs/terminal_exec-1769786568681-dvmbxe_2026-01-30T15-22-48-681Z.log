   30→}\n    31→\n    32→interface OverviewViewProps {\n    33→  session: SessionWithDetails;\n    34→  stats: {\n    35→    findings: number;\n    36→    sources: number;\n    37→    perspectives: number;\n    38→    avgConfidence: number;\n    39→    highConfidence: number;\n    40→    redFlags: number;\n    41→    gaps: number;\n    42→  };\n    43→}\n    44→\n    45→type ViewMode = 'video' | 'static';\n    46→\n    47→const viewModeOptions: ViewModeOption<ViewMode>[] = [\n    48→  {\n    49→    value: 'video',\n    50→    label: 'Video',\n    51→    icon: <svg className=\"w-3 h-3\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M8 5v14l11-7z\" /></svg>,\n    52→  },\n    53→  {\n    54→    value: 'static',\n    55→    label: 'Static',\n    56→    icon: <svg className=\"w-3 h-3\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth={2} d=\"M4 6h16M4 12h16M4 18h16\" /></svg>,\n    57→  },\n    58→];\n    59→\n    60→export function OverviewView({ session, stats }: OverviewViewProps) {\n    61→  const { theme } = useReportTheme();\n    62→  const styles = useThemeStyles();\n    63→  const findings = session.findings || [];\n    64→  const isRadar = theme === 'radar';\n    65→  const [viewMode, setViewMode] = useState<ViewMode>('video');\n    66→\n    67→  // Calculate metrics for dashboard\n    68→  const coverage = Math.min(100, Math.round((stats.sources / Math.max(10, stats.findings * 2)) * 100));\n    69→  const reliability = Math.round((findings.filter(f => (f.confidence_score || 0) >= 0.7).length / Math.max(1, findings.length)) * 100);\n    70→  const completeness = Math.min(100, 100 - (stats.gaps * 10));\n    71→\n    72→  const allWarnings = session.perspectives?.flatMap(p => p.warnings || []) || [];\n    73→\n    74→  return (\n    75→    <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} className=\"space-y-6\">\n    76→      <ViewHeader\n    77→        title=\"Overview\"\n    78→        actions={<ViewModeToggle options={viewModeOptions} value={viewMode} onChange={setViewMode} />}\n    79→      />\n    80→\n    81→      {/* Video mode */}\n    82→      {viewMode === 'video' && (\n    83→        <Suspense fallback={<VisualizationSkeleton height=\"h-96\" />}>\n    84→          <VideoOverview session={session} stats={stats} />\n    85→        </Suspense>\n    86→      )}\n    87→\n    88→      {/* Static mode */}\n    89→      {viewMode === 'static' && <StaticOverview session={session} stats={stats} coverage={coverage} reliability={reliability} completeness={completeness} allWarnings={allWarnings} />}\n    90→    </motion.div>\n    91→  );\n    92→}\n    93→\n    94→function StaticOverview({ session, stats, coverage, reliability, completeness, allWarnings }: {\n    95→  session: SessionWithDetails;\n    96→  stats: OverviewViewProps['stats'];\n    97→  coverage: number;\n    98→  reliability: number;\n    99→  completeness: number;\n   100→  allWarnings: string[];\n   101→}) {\n   102→  const { theme } = useReportTheme();\n   103→  const styles = useThemeStyles();\n   104→  const isRadar = theme === 'radar';\n   105→  const findings = session.findings || [];\n   106→\n   107→  // Single memoized computation for all derived data, keyed by session.id for stability\n   108→  const { keyPoints, heatmapData, timelineEvents } = useMemo(() => {\n   109→    // Key points from perspectives and findings\n   110→    const points: Array<{ id: string; text: string; type: 'insight' | 'warning' | 'action' | 'fact'; confidence: number; sourceCount: number }> = [];\n   111→    session.perspectives?.forEach(p => {\n   112→      p.key_insights?.forEach((insight, i) => { points.push({ id: `insight-${p.id}-${i}`, text: insight, type: 'insight', confidence: p.confidence || 0.7, sourceCount: p.sources_cited?.length || 0 }); });\n   113→      p.warnings?.forEach((warning, i) => { points.push({ id: `warning-${p.id}-${i}`, text: warning, type: 'warning', confidence: 0.9, sourceCount: 1 }); });\n   114→      p.recommendations?.forEach((rec, i) => { points.push({ id: `action-${p.id}-${i}`, text: rec, type: 'action', confidence: 0.8, sourceCount: 1 }); });\n   115→    });\n   116→    findings.slice(0, 5).forEach(f => { points.push({ id: f.id, text: f.content.slice(0, 150), type: 'fact', confidence: f.confidence_score || 0.5, sourceCount: f.supporting_sources?.length || 0 }); });\n   117→\n   118→    // Heatmap data from findings confidence\n   119→    const heatmap = findings.slice(0, 25).map(f => ({ id: f.id, label: f.content.slice(0, 40) + '...', value: f.confidence_score || 0.5 }));\n   120→\n   121→    // Timeline events from dated findings\n   122→    const timeline = findings.filter(f => f.event_date).map(f => ({\n   123→      id: f.id,\n   124→      date: new Date(f.event_date!),\n   125→      label: f.content.slice(0, 50) + '...',\n   126→      type: (f.temporal_context === 'prediction' ? 'prediction' : f.finding_type === 'event' ? 'event' : 'finding') as 'finding' | 'event' | 'prediction',\n   127→      confidence: f.confidence_score,\n   128→    })).slice(0, 15);\n   129→\n   130→    return {\n   131→      keyPoints: points.slice(0, 12),\n   132→      heatmapData: heatmap,\n   133→      timelineEvents: timeline,\n   134→    };\n   135→  }, [session.id, session.perspectives, findings]);\n   136→\n   137→  return (\n   138→    <>\n   139→      <IntelDashboard\n   140→        confidence={stats.avgConfidence}\n   141→        findings={{ label: 'Findings', value: stats.findings, sublabel: `${stats.highConfidence} verified` }}\n   142→        sources={{ label: 'Sources', value: stats.sources, sublabel: 'analyzed' }}\n   143→        coverage={coverage}\n   144→        reliability={reliability}\n   145→        completeness={completeness}\n   146→        alerts={stats.redFlags + allWarnings.length}\n   147→      />\n   148→\n   149→      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n   150→        <KeyPoi