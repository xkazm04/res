s {\n  session: SessionWithDetails;\n  stats: {\n    findings: number;\n    sources: number;\n    perspectives: number;\n    contradictions: number;\n    gaps: number;\n    avgConfidence: number;\n    highConfidence: number;\n    redFlags: number;\n    highCredSources: number;\n    entities: number;\n  };\n}\n\nexport function OverviewTab({ session, stats }: OverviewTabProps) {\n  const findings = session.findings || [];\n  const allInsights = session.perspectives?.flatMap(p => p.key_insights || []) || [];\n  const allWarnings = session.perspectives?.flatMap(p => p.warnings || []) || [];\n  const allRecommendations = session.perspectives?.flatMap(p => p.recommendations || []) || [];\n\n  // Calculate confidence distribution\n  const highConf = findings.filter(f => (f.confidence_score || 0) >= 0.8).length;\n  const medConf = findings.filter(f => {\n    const c = f.confidence_score || 0;\n    return c >= 0.5 && c < 0.8;\n  }).length;\n  const lowConf = findings.filter(f => (f.confidence_score || 0) < 0.5).length;\n\n  return (\n    <div className=\"space-y-4\">\n      {/* Stats Grid */}\n      <div className=\"grid grid-cols-2 md:grid-cols-5 gap-3\">\n        <QuickStatCard\n          label=\"Findings\"\n          value={stats.findings}\n          subtext={`${stats.highConfidence} high confidence`}\n          icon={<DocumentIcon />}\n          color=\"blue\"\n        >\n          <ConfidenceDistribution high={highConf} medium={medConf} low={lowConf} />\n        </QuickStatCard>\n        <QuickStatCard\n          label=\"Avg Confidence\"\n          value={`${stats.avgConfidence}%`}\n          icon={<TargetIcon />}\n          color={stats.avgConfidence >= 80 ? 'emerald' : stats.avgConfidence >= 50 ? 'amber' : 'red'}\n        >\n          <ProgressBar value={stats.avgConfidence} color=\"auto\" size=\"sm\" />\n        </QuickStatCard>\n        <QuickStatCard\n          label=\"Sources\"\n          value={stats.sources}\n          subtext={`${stats.highCredSources} high credibility`}\n          icon={<LinkIcon />}\n          color=\"emerald\"\n        />\n        <QuickStatCard\n          label=\"Perspectives\"\n          value={stats.perspectives}\n          icon={<UsersIcon />}\n          color=\"slate\"\n        />\n        <QuickStatCard\n          label=\"Red Flags\"\n          value={stats.redFlags}\n          subtext={stats.redFlags > 0 ? 'Review needed' : 'Clear'}\n          icon={<AlertIcon />}\n          color={stats.redFlags > 0 ? 'red' : 'slate'}\n        />\n      </div>\n\n      {/* Warnings Banner */}\n      {allWarnings.length > 0 && (\n        <div className=\"bg-gradient-to-br from-amber-50 to-orange-50 border border-amber-200 rounded-lg p-4\">\n          <div className=\"flex items-center gap-2 text-amber-700 font-semibold text-sm mb-2\">\n            <span className=\"w-4 h-4\"><AlertIcon /></span>\n            Warnings ({allWarnings.length})\n          </div>\n          <ul className=\"space-y-1\">\n            {allWarnings.slice(0, 4).map((w, i) => (\n              <li key={i} className=\"text-sm text-amber-800 pl-6 relative before:content-['•'] before:absolute before:left-2 before:text-amber-400\">\n                {w}\n              </li>\n            ))}\n          </ul>\n        </div>\n      )}\n\n      {/* Key Insights */}\n      {allInsights.length > 0 && (\n        <ThemedSection title=\"Key Insights\" count={allInsights.length}>\n          <ul className=\"space-y-2\">\n            {allInsights.slice(0, 6).map((insight, i) => (\n              <li key={i} className=\"flex items-start gap-2 text-sm text-slate-700 pl-3 border-l-2 border-emerald-400 py-1\">\n                {insight}\n              </li>\n            ))}\n          </ul>\n        </ThemedSection>\n      )}\n\n      {/* Recommendations */}\n      {allRecommendations.length > 0 && (\n        <ThemedSection title=\"Recommended Actions\" count={allRecommendations.length}>\n          <div className=\"space-y-2\">\n            {allRecommendations.slice(0, 5).map((rec, i) => (\n              <div key={i} className=\"flex items-start gap-3 p-2 bg-blue-50 rounded-lg\">\n                <span className=\"w-5 h-5 bg-blue-500 text-white rounded-full flex items-center justify-center text-[10px] font-bold flex-shrink-0 mt-0.5\">\n                  {i + 1}\n                </span>\n                <span className=\"text-sm text-slate-700\">{rec}</span>\n              </div>\n            ))}\n          </div>\n        </ThemedSection>\n      )}\n\n      {/* Gaps */}\n      {stats.gaps > 0 && (\n        <ThemedSection title=\"Research Gaps\" count={stats.gaps}>\n          <div className=\"space-y-2\">\n            {session.gaps?.slice(0, 3).map((gap, i) => (\n              <div key={i} className=\"p-3 bg-violet-50 border-l-3 border-violet-500 rounded-r-lg\">\n                <div className=\"flex items-center gap-2 mb-1\">\n                  <span className=\"text-[10px] font-semibold text-violet-600 uppercase px-1.5 py-0.5 bg-violet-100 rounded\">\n                    {gap.gap_type}\n                  </span>\n                  <span className=\"text-[10px] text-violet-500\">{gap.priority} priority</span>\n                </div>\n                <p className=\"text-sm text-slate-700\">{gap.description}</p>\n              </div>\n            ))}\n          </div>\n        </ThemedSection>\n      )}\n    </div>\n  );\n}\n","numLines":149,"startLine":1,"totalLines":149}}}
