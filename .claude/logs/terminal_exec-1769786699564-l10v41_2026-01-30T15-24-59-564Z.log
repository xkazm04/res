acity: 0, scale: 0.95 },\n    45→};\n    46→\n    47→export function SourcesView({ sources, initialSelectedId }: SourcesViewProps) {\n    48→  const { theme } = useReportTheme();\n    49→  const styles = useThemeStyles();\n    50→  const isRadar = theme === 'radar';\n    51→\n    52→  // Local filter state - no prop drilling from ReportView\n    53→  const [searchQuery, setSearchQuery] = useState('');\n    54→  const [filterConfidence, setFilterConfidence] = useState('all');\n    55→  const debouncedSearchQuery = useDebouncedValue(searchQuery, 150);\n    56→\n    57→  const [viewMode, setViewMode] = useState<ViewMode>('cards');\n    58→  const [selectedSource, setSelectedSource] = useState<string | null>(initialSelectedId || null);\n    59→\n    60→  // Sync selection when navigating from another view\n    61→  useEffect(() => {\n    62→    if (initialSelectedId) {\n    63→      setSelectedSource(initialSelectedId);\n    64→    }\n    65→  }, [initialSelectedId]);\n    66→\n    67→  const filtered = useMemo(() => {\n    68→    return sources.filter((s) => {\n    69→      if (debouncedSearchQuery) {\n    70→        const q = debouncedSearchQuery.toLowerCase();\n    71→        if (!s.title?.toLowerCase().includes(q) && !s.domain?.toLowerCase().includes(q)) return false;\n    72→      }\n    73→      if (!matchesConfidenceFilter(s.credibility_score || 0, filterConfidence as ConfidenceFilterOption)) return false;\n    74→      return true;\n    75→    });\n    76→  }, [sources, debouncedSearchQuery, filterConfidence]);\n    77→\n    78→  const stats = useMemo(() => {\n    79→    const high = filtered.filter(s => (s.credibility_score || 0) >= 0.8).length;\n    80→    const med = filtered.filter(s => { const c = s.credibility_score || 0; return c >= 0.5 && c < 0.8; }).length;\n    81→    return { high, med, low: filtered.length - high - med };\n    82→  }, [filtered]);\n    83→\n    84→  if (filtered.length === 0) {\n    85→    return (\n    86→      <EmptyState\n    87→ 