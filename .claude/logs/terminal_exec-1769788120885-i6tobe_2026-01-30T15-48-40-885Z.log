cted' | 'past' | 'present' | 'prediction';\n    50→\n    51→export type DecompositionStrategy = 'temporal' | 'thematic' | 'actor' | 'hybrid' | 'none';\n    52→\n    53→export type CompositionRole = 'background' | 'primary' | 'synthesis' | 'equal';\n    54→\n    55→export type GapType = 'temporal' | 'actor' | 'topic' | 'evidence' | 'geographic';\n    56→\n    57→export type GapPriority = 'high' | 'medium' | 'low';\n    58→\n    59→export type TopicType = 'domain' | 'event' | 'entity' | 'concept' | 'region' | 'timeperiod';\n    60→\n    61→export type EntityRole = 'subject' | 'object' | 'actor' | 'target' | 'location' | 'mentioned' | 'source' | 'beneficiary';\n    62→\n    63→// ============================================\n    64→// CORE ENTITIES\n    65→// ============================================\n    66→\n    67→export interface ResearchSession {\n    68→  id: string;\n    69→  user_id?: string;\n    70→  workspace_id: string;\n    71→  title: string;\n    72→  query: string;\n    73→  template_type: string;\n    74→  status: SessionStatus;\n    75→  primary_topic_id?: string;\n    76→  topic_ids: string[];\n    77→  parameters: Record<string, unknown>;\n    78→  claim_count: number;\n    79→  source_count: number;\n    80→  created_at: string;\n    81→  updated_at: string;\n    82→  completed_at?: string;\n    83→}\n    84→\n    85→export interface ResearchFinding {\n    86→  id: string;\n    87→  session_id: string;\n    88→  finding_type: FindingType;\n    89→  content: string;\n    90→  summary?: string;\n    91→  perspective?: string;\n    92→  confidence_score?: number;\n    93→  supporting_sources: string[];\n    94→  temporal_context?: TemporalContext;\n    95→  event_date?: string;\n    96→  date_range_start?: string;\n    97→  date_range_end?: string;\n    98→  related_findings: string[];\n    99→  contradicts: string[];\n   100→  knowledge_claim_id?: string;\n   101→  is_promoted: boolean;\n   102→  promotion_type?: string;\n   103→  sub_query_id?: string;\n   104→  decomposition_context?: string;\n   105→  extracted_data?: Record<string, unknown>;\n   106→  created_at: string;\n   107→}\n   108→\n   109→export interface ResearchSource {\n   110→  id: string;\n   111→  query_id?: string;\n   112→  session_id?: string;\n   113→  is_global: boolean;\n   114→  url: string;\n   115→  url_hash: string;\n   116→  title?: string;\n   117→  domain?: string;\n   118→  snippet?: string;\n   119→  full_content?: string;\n   120→  credibility_score?: number;\n   121→  credibility_factors?: Record<string, unknown>;\n   122→  source_type?: SourceType;\n   123→  discovered_at: string;\n   124→  content_date?: string;\n   125→  last_verified_at?: string;\n   126→  citation_count: number;\n   127→}\n   128→\n   129→export interface ResearchPerspective {\n   130→  id: string;\n   131→  session_id: string;\n   132→  perspective_type: PerspectiveType;\n   133→  analysis_text: string;\n   134→  key_insights: string[];\n   135→  confidence?: number;\n   136→  findings_analyzed: string[];\n   137→  sources_cited: string[];\n   138→  recommendations: string[];\n   139→  warnings: string[];\n   140→  specialized_data?: PerspectiveSpecializedData;\n   141→  created_at: string;\n   142→}\n   143→\n   144→// ============================================\n   145→// KNOWLEDGE GRAPH\n   146→// ============================================\n   147→\n   148→export interface KnowledgeTopic {\n   149→  id: string;\n   150→  parent_id?: string;\n   151→  name: string;\n   152→  slug: string;\n   153→  description?: string;\n   154→  topic_type?: TopicType;\n   155→  icon?: string;\n   156→  color?: string;\n   157→  finding_count: number;\n   158→  entity_count: number;\n   159→  session_count: number;\n   160→  last_activity_at?: string;\n   161→  path: string[];\n   162→  depth: number;\n   163→  created_at: string;\n   164→  updated_at: string;\n   165→}\n   166→\n   167→export interface KnowledgeEntity {\n   168→  id: string;\n   169→  canonical_name: string;\n   170→  entity_type: EntityType;\n   171→  aliases: string[];\n   172→  name_hash: string;\n   173→  description?: string;\n   174→  profile_data: Record<string, unknown>;\n   175→  image_url?: string;\n   176→  external_ids: Record<string, string>;\n   177→  mention_count: number;\n   178→  claim_count: number;\n   179→  is_verified: boolean;\n   180→  verified_by_user_id?: string;\n   181→  verified_at?: string;\n   182→  created_at: string;\n   183→  updated_at: string;\n   184→}\n   185→\n   186→export interface KnowledgeClaim {\n   187→  id: string;\n   188→  claim_type: ClaimType;\n   189→  content: string;\n   190→  summary?: string;\n   191→  content_hash: string;\n   192→  topic_id?: string;\n   193→  tags: string[];\n   194→  confidence_score: number;\n   195→  verification_status: VerificationStatus;\n   196→  corroboration_count: number;\n   197→  temporal_context?: TemporalContext;\n   198→  event_date?: string;\n   199→  date_range_start?: string;\n   200→  date_range_end?: string;\n   201→  visibility: 'public' | 'workspace' | 'private';\n   202→  created_by_user_id?: string;\n   203→  workspace_id: string;\n   204→  version: number;\n   205→  superseded_by?: string;\n   206→  is_current: boolean;\n   207→  origin_session_id?: string;\n   208→  extracted_data?: Record<string, unknown>;\n   209→  created_at: string;\n   210→  updated_at: string;\n   211→}\n   212→\n   213→export interface ClaimRelationship {\n   214→  id: string;\n   215→  source_claim_id: string;\n   216→  target_claim_id: string;\n   217→  relationship_type: RelationshipType;\n   218→  strength: number;\n   219→  description?: string;\n   220→  bidirectional: boolean;\n   221→  created_by_session_id?: string;\n   222→  created_by_user_id?: string;\n   223→  created_at: string;\n   224→}\n   225→\n   226→export interface ClaimEntity {\n   227→  id: string;\n   228→  claim_id: string;\n   229→  entity_id: string;\n   230→  role?: EntityRole;\n   231→  context_snippet?