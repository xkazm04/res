[2026-01-30T15:49:13.236Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017eaHPZWY8s8MCr46zrHono","type":"tool_result","content":"     1→'use client';\n     2→\n     3→import { spring, easeOutCubic, easeOutQuart } from '../useVideoPlayback';\n     4→\n     5→export interface NetworkNode {\n     6→  id: string;\n     7→  label: string;\n     8→  type?: 'primary' | 'secondary' | 'highlight' | 'warning';\n     9→  x?: number;\n    10→  y?: number;\n    11→}\n    12→\n    13→export interface NetworkEdge {\n    14→  from: string;\n    15→  to: string;\n    16→  label?: string;\n    17→  type?: 'normal' | 'money' | 'suspicious' | 'hidden';\n    18→}\n    19→\n    20→interface NetworkDiagramProps {\n    21→  nodes: NetworkNode[];\n    22→  edges: NetworkEdge[];\n    23→  frame: number;\n    24→  fps: number;\n    25→  isRadar: boolean;\n    26→  width: number;\n    27→  height: number;\n    28→  /** Animation style: 'radial' reveals from center, 'sequential' reveals one by one */\n    29→  revealStyle?: 'radial' | 'sequential';\n    30→  /** Accent color for highlights */\n    31→  accentColor?: string;\n    32→}\n    33→\n    34→/**\n    35→ * Animated network diagram showing nodes and their connections.\n    36→ * Used for ActorNetwork and ShellCompanyWeb scenes.\n    37→ */\n    38→export function NetworkDiagram({\n    39→  nodes,\n    40→  edges,\n    41→  frame,\n    42→  fps,\n    43→  isRadar,\n    44→  width,\n    45→  height,\n    46→  revealStyle = 'radial',\n    47→  accentColor = '#06b6d4',\n    48→}: NetworkDiagramProps) {\n    49→  // Calculate node positions if not provided (circular layout)\n    50→  const positionedNodes = nodes.map((node, i) => {\n    51→    if (node.x !== undefined && node.y !== undefined) return node;\n    52→\n    53→    const angle = (i / nodes.length) * Math.PI * 2 - Math.PI / 2;\n    54→    const radius = Math.min(width, height) * 0.35;\n    55→    const centerX = width / 2;\n    56→    const centerY = height / 2;\n    57→\n    58→    return {\n    59→      ...node,\n    60→      x: centerX + Math.cos(angle) * radius,\n    61→      y: centerY + Math.sin(angle) * radius,\n    62→    };\n    63→  });\n    64→\n    65→  // Get node position by id\n    66→  const getNodePos = (id: string) => {\n    67→    const node = positionedNodes.find(n => n.id === id);\n    68→    return node ? { x: node.x!, y: node.y! } : { x: width / 2, y: height / 2 };\n    69→  };\n    70→\n    71→  // Node colors based on type\n    72→  const getNodeColors = (type: NetworkNode['type'] = 'secondary') => {\n    73→    const colors = {\n    74→      primary: {\n    75→        bg: isRadar ? 'fill-cyan-500' : 'fill-blue-500',\n    76→        border: isRadar ? 'stroke-cyan-400' : 'stroke-blue-400',\n    77→        text: isRadar ? 'fill-white' : 'fill-white',\n    78→      },\n    79→      secondary: {\n    80→        bg: isRadar ? 'fill-slate-700' : 'fill-stone-200',\n    81→        border: isRadar ? 'stroke-slate-600' : 'stroke-stone-300',\n    82→        text: isRadar ? 'fill-slate-200' : 'fill-stone-700',\n    83→      },\n    84→      highlight: {\n    85→        bg: isRadar ? 'fill-amber-500' : 'fill-amber-400',\n    86→        border: isRadar ? 'stroke-amber-400' : 'stroke-amber-500',\n    87→        text: isRadar ? 'fill-white' : 'fill-stone-900',\n    88→      },\n    89→      warning: {\n    90→        bg: isRadar ? 'fill-red-500' : 'fill-red-400',\n    91→        border: isRadar ? 'stroke-red-400' : 'stroke-red-500',\n    92→        text: isRadar ? 'fill-white' : 'fill-white',\n    93→      },\n    94→    };\n    95→    return colors[type];\n    96→  };\n    97→\n    98→  // Edge colors based on type\n    99→  const getEdgeColor = (type: NetworkEdge['type'] = 'normal') => {\n   100→    const colors = {\n   101→      normal: isRadar ? '#475569' : '#d6d3d1',\n   102→      money: '#22c55e',\n   103→      suspicious: '#f59e0b',\n   104→      hidden: isRadar ? '#334155' : '#e7e5e4',\n   105→    };\n   106→    return colors[type];\n   107→  };\n   108→\n   109→  return (\n   110→    <svg width={width} height={height} className=\"overflow-visible\">\n   111→      {/* Edges */}\n   112→      <g>\n   113→        {edges.map((edge, i) => {\n   114→          const fromPos = getNodePos(edge.from);\n   115→          const toPos = getNodePos(edge.to);\n   116→          const delay = revealStyle === 'sequential' ? i * 4 : 5;\n   117→          const edgeProgress = spring({ frame, fps, delay, durationFrames: 20, easing: easeOutCubic });\n   118→\n   119→          // Calculate line with offset for node radius\n   120→          const dx = toPos.x - fromPos.x;\n   121→          const dy = toPos.y - fromPos.y;\n   122→          const length = Math.sqrt(dx * dx + dy * dy);\n   123→          const nodeRadius = 24;\n   124→          const startX = fromPos.x + (dx / length) * nodeRadius;\n   125→          const startY = fromPos.y + (dy / length) * nodeRadius;\n   126→          const endX = toPos.x - (dx / length) * nodeRadius;\n   127→          const endY = toPos.y - (dy / length) * nodeRadius;\n   128→\n   129→          // Animated end point\n   130→          const currentEndX = startX + (endX - startX) * edgeProgress;\n   131→          const currentEndY = startY + (endY - startY) * edgeProgress;\n   132→\n   133→          return (\n   134→            <g key={`${edge.from}-${edge.to}`}>\n   135→              <line\n   136→                x1={startX}\n   137→                y1={startY}\n   138→                x2={currentEndX}\n   139→                y2={currentEndY}\n   140→                stroke={getEdgeColor(edge.type)}\n   141→                strokeWidth={edge.type === 'money' ? 3 : 2}\n   142→                strokeDasharray={edge.type === 'hidden' ? '4 4' : undefined}\n   143→                opacity={edgeProgress * 0.8}\n   144→              />\n   145→              {/* Arrow head */}\n   146→              {edgeProgress > 0.5 && (\n   147→                <polygon\n   148→                  points={`0,-4 8,0 0,4`}\n   149→                  fill={getEdgeColor(edge.type)}\n   150→                  opacity={edgeProgress}\n   151→                  transform={`translate(${currentEndX}, ${currentEndY}) rotate(${Math.atan2(dy, dx) * 180 / Math.PI})`}\n   152→                />\n   153→              )}\n   154→              {/* Edge label */}\n   155→              {edge.label && edgeProgress > 0.7 && (\n   156→                <text\n   157→                  x={(startX + endX) / 2}\n   158→                  y={(startY + endY) / 2 - 8}\n   159→                  textAnchor=\"middle\"\n   160→                  className={`text-[9px] font-medium ${isRadar ? 'fill-slate-400' : 'fill-stone-500'}`}\n   161→                  opacity={(edgeProgress - 0.7) * 3.33}\n   162→                >\n   163→                  {edge.label}\n   164→                </text>\n   165→              )}\n   166→            </g>\n   167→          );\n   168→        })}\n   169→      </g>\n   170→\n   171→      {/* Nodes */}\n   172→      <g>\n   173→        {positionedNodes.map((node, i) => {\n   174→          const delay = revealStyle === 'sequential' ? i * 6 : i * 2;\n   175→          const nodeProgress = spring({ frame, fps, delay, durationFrames: 25, easing: easeOutQuart });\n   176→          const colors = getNodeColors(node.type);\n   177→\n   178→          return (\n   179→            <g\n   180→              key={node.id}\n   181→              transform={`translate(${node.x}, ${node.y})`}\n   182→              opacity={nodeProgress}\n   183→            >\n   184→              {/* Glow effect for primary/highlight nodes */}\n   185→              {(node.type === 'primary' || node.type === 'highlight') && (\n   186→                <circle\n   187→                  r={28 * nodeProgress}\n   188→                  className={node.type === 'primary' ? 'fill-cyan-500/20' : 'fill-amber-500/20'}\n   189→                  style={{ filter: 'blur(8px)' }}\n   190→                />\n   191→              )}\n   192→\n   193→              {/* Node circle */}\n   194→              <circle\n   195→                r={20 * nodeProgress}\n   196→                className={`${colors.bg} ${colors.border}`}\n   197→                strokeWidth={2}\n   198→              />\n   199→\n   200→              {/* Node label */}\n   201→              <text\n   202→                y={1}\n   203→                textAnchor=\"middle\"\n   204→                dominantBaseline=\"middle\"\n   205→                className={`text-[10px] font-semibold ${colors.text}`}\n   206→                style={{ transform: `scale(${nodeProgress})` }}\n   207→              >\n   208→                {node.label.length > 8 ? node.label.slice(0, 7) + '…' : node.label}\n   209→              </text>\n   210→\n   211→              {/* Full label below node */}\n   212→              {node.label.length > 8 && (\n   213→                <text\n   214→                  y={32}\n   215→                  textAnchor=\"middle\"\n   216→                  className={`text-[8px] ${isRadar ? 'fill-slate-400' : 'fill-stone-500'}`}\n   217→                  opacity={nodeProgress}\n   218→                >\n   219→                  {node.label}\n   220→                </text>\n   221→              )}\n   222→            </g>\n   223→          );\n   224→        })}\n   225→      </g>\n   226→    </svg>\n   227→  );\n   228→}\n   229→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"bb700aba-f9fc-4283-93cf-561e37220b63","uuid":"79b1b1b1-35eb-451b-8635-34ae598f05fe","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\video\\primitives\\NetworkDiagram.tsx","content":"'use client';\n\nimport { spring, easeOutCubic, easeOutQuart } from '../useVideoPlayback';\n\nexport interface NetworkNode {\n  id: string;\n  label: string;\n  type?: 'primary' | 'secondary' | 'highlight' | 'warning';\n  x?: number;\n  y?: number;\n}\n\nexport interface NetworkEdge {\n  from: string;\n  to: string;\n  label?: string;\n  type?: 'normal' | 'money' | 'suspicious' | 'hidden';\n}\n\ninterface NetworkDiagramProps {\n  nodes: NetworkNode[];\n  edges: NetworkEdge[];\n  frame: number;\n  fps: number;\n  isRadar: boolean;\n  width: number;\n  height: number;\n  /** Animation style: 'radial' reveals from center, 'sequential' reveals one by one */\n  revealStyle?: 'radial' | 'sequential';\n  /** Accent color for highlights */\n  accentColor?: string;\n}\n\n/**\n * Animated network diagram showing nodes and their connections.\n * Used for ActorNetwork and ShellCompanyWeb scenes.\n */\nexport function NetworkDiagram({\n  nodes,\n  edges,\n  frame,\n  fps,\n  isRadar,\n  width,\n  height,\n  revealStyle = 'radial',\n  accentColor = '#06b6d4',\n}: NetworkDiagramProps) {\n  // Calculate node positions if not provided (circular layout)\n  const positionedNodes = nodes.map((node, i) => {\n    if (node.x !== undefined && node.y !== undefined) return node;\n\n    const angle = (i / nodes.length) * Math.PI * 2 - Math.PI / 2;\n    const radius = Math.min(width, height) * 0.35;\n    const centerX = width / 2;\n    const centerY = height / 2;\n\n    return {\n      ...node,\n      x: centerX + Math.cos(angle) * radius,\n      y: centerY + Math.sin(angle) * radius,\n    };\n  });\n\n  // Get node position by id\n  const getNodePos = (id: string) => {\n    const node = positionedNodes.find(n => n.id === id);\n    return node ? { x: node.x!, y: node.y! } : { x: width / 2, y: height / 2 };\n  };\n\n  // Node colors based on type\n  const getNodeColors = (type: NetworkNode['type'] = 'secondary') => {\n    const colors = {\n      primary: {\n        bg: isRadar ? 'fill-cyan-500' : 'fill-blue-500',\n        border: isRadar ? 'stroke-cyan-400' : 'stroke-blue-400',\n        text: isRadar ? 'fill-white' : 'fill-white',\n      },\n      secondary: {\n        bg: isRadar ? 'fill-slate-700' : 'fill-stone-200',\n        border: isRadar ? 'stroke-slate-600' : 'stroke-stone-300',\n        text: isRadar ? 'fill-slate-200' : 'fill-stone-700',\n      },\n      highlight: {\n        bg: isRadar ? 'fill-amber-500' : 'fill-amber-400',\n        border: isRadar ? 'stroke-amber-400' : 'stroke-amber-500',\n        text: isRadar ? 'fill-white' : 'fill-stone-900',\n      },\n      warning: {\n        bg: isRadar ? 'fill-red-500' : 'fill-red-400',\n        border: isRadar ? 'stroke-red-400' : 'stroke-red-500',\n        text: isRadar ? 'fill-white' : 'fill-white',\n      },\n    };\n    return colors[type];\n  };\n\n  // Edge colors based on type\n  const getEdgeColor = (type: NetworkEdge['type'] = 'normal') => {\n    const colors = {\n      normal: isRadar ? '#475569' : '#d6d3d1',\n      money: '#22c55e',\n      suspicious: '#f59e0b',\n      hidden: isRadar ? '#334155' : '#e7e5e4',\n    };\n    return colors[type];\n  };\n\n  return (\n    <svg width={width} height={height} className=\"overflow-visible\">\n      {/* Edges */}\n      <g>\n        {edges.map((edge, i) => {\n          const fromPos = getNodePos(edge.from);\n          const toPos = getNodePos(edge.to);\n          const delay = revealStyle === 'sequential' ? i * 4 : 5;\n          const edgeProgress = spring({ frame, fps, delay, durationFrames: 20, easing: easeOutCubic });\n\n          // Calculate line with offset for node radius\n          const dx = toPos.x - fromPos.x;\n          const dy = toPos.y - fromPos.y;\n          const length = Math.sqrt(dx * dx + dy * dy);\n          const nodeRadius = 24;\n          const startX = fromPos.x + (dx / length) * nodeRadius;\n          const startY = fromPos.y + (dy / length) * nodeRadius;\n          const endX = toPos.x - (dx / length) * nodeRadius;\n          const endY = toPos.y - (dy / length) * nodeRadius;\n\n          // Animated end point\n          const currentEndX = startX + (endX - startX) * edgeProgress;\n          const currentEndY = startY + (endY - startY) * edgeProgress;\n\n          return (\n            <g key={`${edge.from}-${edge.to}`}>\n              <line\n                x1={startX}\n                y1={startY}\n                x2={currentEndX}\n                y2={currentEndY}\n                stroke={getEdgeColor(edge.type)}\n                strokeWidth={edge.type === 'money' ? 3 : 2}\n                strokeDasharray={edge.type === 'hidden' ? '4 4' : undefined}\n                opacity={edgeProgress * 0.8}\n              />\n              {/* Arrow head */}\n              {edgeProgress > 0.5 && (\n                <polygon\n                  points={`0,-4 8,0 0,4`}\n                  fill={getEdgeColor(edge.type)}\n                  opacity={edgeProgress}\n                  transform={`translate(${currentEndX}, ${currentEndY}) rotate(${Math.atan2(dy, dx) * 180 / Math.PI})`}\n                />\n              )}\n              {/* Edge label */}\n              {edge.label && edgeProgress > 0.7 && (\n                <text\n                  x={(startX + endX) / 2}\n                  y={(startY + endY) / 2 - 8}\n                  textAnchor=\"middle\"\n                  className={`text-[9px] font-medium ${isRadar ? 'fill-slate-400' : 'fill-stone-500'}`}\n                  opacity={(edgeProgress - 0.7) * 3.33}\n                >\n                  {edge.label}\n                </text>\n              )}\n            </g>\n          );\n        })}\n      </g>\n\n      {/* Nodes */}\n      <g>\n        {positionedNodes.map((node, i) => {\n          const delay = revealStyle === 'sequential' ? i * 6 : i * 2;\n          const nodeProgress = spring({ frame, fps, delay, durationFrames: 25, easing: easeOutQuart });\n          const colors = getNodeColors(node.type);\n\n          return (\n            <g\n              key={node.id}\n              transform={`translate(${node.x}, ${node.y})`}\n              opacity={nodeProgress}\n            >\n              {/* Glow effect for primary/highlight nodes */}\n              {(node.type === 'primary' || node.type === 'highlight') && (\n                <circle\n                  r={28 * nodeProgress}\n                  className={node.type === 'primary' ? 'fill-cyan-500/20' : 'fill-amber-500/20'}\n                  style={{ filter: 'blur(8px)' }}\n                />\n              )}\n\n              {/* Node circle */}\n              <circle\n                r={20 * nodeProgress}\n                className={`${colors.bg} ${colors.border}`}\n                strokeWidth={2}\n              />\n\n              {/* Node label */}\n              <text\n                y={1}\n                textAnchor=\"middle\"\n                dominantBaseline=\"middle\"\n                className={`text-[10px] font-semibold ${colors.text}`}\n                style={{ transform: `scale(${nodeProgress})` }}\n              >\n                {node.label.length > 8 ? node.label.slice(0, 7) + '…' : node.label}\n              </text>\n\n              {/* Full label below node */}\n              {node.label.length > 8 && (\n                <text\n                  y={32}\n                  textAnchor=\"middle\"\n                  className={`text-[8px] ${isRadar ? 'fill-slate-400' : 'fill-stone-500'}`}\n                  opacity={nodeProgress}\n                >\n                  {node.label}\n                </text>\n              )}\n            </g>\n          );\n        })}\n      </g>\n    </svg>\n  );\n}\n","numLines":229,"startLine":1,"totalLines":229}}}
