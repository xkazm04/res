[2026-01-30T15:49:08.265Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017CpRwXwG4nahFznVtZu3qY","type":"tool_result","content":"     1→/**\n     2→ * Force-directed graph layout algorithm.\n     3→ *\n     4→ * Implements a simple force simulation with:\n     5→ * - Repulsion between all nodes\n     6→ * - Attraction along edges\n     7→ * - Boundary constraints\n     8→ * - Center gravity (optional)\n     9→ */\n    10→\n    11→import type {\n    12→  LayoutNode,\n    13→  ForceNode,\n    14→  LayoutEdge,\n    15→  ForceLayoutConfig,\n    16→  LayoutResult,\n    17→  LayoutDimensions,\n    18→  PositionMap,\n    19→  Point,\n    20→} from './types';\n    21→\n    22→// ============================================================================\n    23→// Default Configuration\n    24→// ============================================================================\n    25→\n    26→const DEFAULT_CONFIG: Required<ForceLayoutConfig> = {\n    27→  iterations: 50,\n    28→  repulsion: 1000,\n    29→  attraction: 0.01,\n    30→  damping: 0.1,\n    31→  minDistance: 1,\n    32→  padding: 40,\n    33→  centerGravity: 0,\n    34→};\n    35→\n    36→// ============================================================================\n    37→// Core Force Simulation\n    38→// ============================================================================\n    39→\n    40→/**\n    41→ * Initialize nodes with positions and velocities.\n    42→ * Places nodes in a circular arrangement to start.\n    43→ */\n    44→export function initializeForceNodes<T extends LayoutNode>(\n    45→  nodes: T[],\n    46→  dimensions: LayoutDimensions\n    47→): ForceNode[] {\n    48→  const { width, height } = dimensions;\n    49→  const centerX = width / 2;\n    50→  const centerY = height / 2;\n    51→  const radius = Math.min(width, height) * 0.35;\n    52→\n    53→  return nodes.map((node, i) => {\n    54→    // Use existing position if provided, otherwise arrange in circle\n    55→    if (node.x !== undefined && node.y !== undefined && node.x !== 0 && node.y !== 0) {\n    56→      return { ...node, vx: 0, vy: 0 };\n    57→    }\n    58→\n    59→    const angle = (i / nodes.length) * Math.PI * 2;\n    60→    return {\n    61→      ...node,\n    62→      x: centerX + Math.cos(angle) * radius,\n    63→      y: centerY + Math.sin(angle) * radius,\n    64→      vx: 0,\n    65→      vy: 0,\n    66→    };\n    67→  });\n    68→}\n    69→\n    70→/**\n    71→ * Apply repulsion forces between all nodes.\n    72→ */\n    73→function applyRepulsion(\n    74→  nodes: ForceNode[],\n    75→  repulsion: number,\n    76→  minDistance: number,\n    77→  damping: number\n    78→): void {\n    79→  for (let i = 0; i < nodes.length; i++) {\n    80→    const nodeA = nodes[i];\n    81→    if (nodeA.fixed) continue;\n    82→\n    83→    for (let j = i + 1; j < nodes.length; j++) {\n    84→      const nodeB = nodes[j];\n    85→      const dx = nodeA.x - nodeB.x;\n    86→      const dy = nodeA.y - nodeB.y;\n    87→      const dist = Math.sqrt(dx * dx + dy * dy) || minDistance;\n    88→      const force = repulsion / (dist * dist);\n    89→      const fx = (dx / dist) * force * damping;\n    90→      const fy = (dy / dist) * force * damping;\n    91→\n    92→      nodeA.x += fx;\n    93→      nodeA.y += fy;\n    94→\n    95→      if (!nodeB.fixed) {\n    96→        nodeB.x -= fx;\n    97→        nodeB.y -= fy;\n    98→      }\n    99→    }\n   100→  }\n   101→}\n   102→\n   103→/**\n   104→ * Apply attraction forces along edges.\n   105→ */\n   106→function applyAttraction(\n   107→  nodes: ForceNode[],\n   108→  edges: LayoutEdge[],\n   109→  attraction: number,\n   110→  nodeMap: Map<string, ForceNode>\n   111→): void {\n   112→  for (const edge of edges) {\n   113→    const nodeA = nodeMap.get(edge.source);\n   114→    const nodeB = nodeMap.get(edge.target);\n   115→    if (!nodeA || !nodeB) continue;\n   116→\n   117→    const dx = nodeB.x - nodeA.x;\n   118→    const dy = nodeB.y - nodeA.y;\n   119→    const dist = Math.sqrt(dx * dx + dy * dy) || 1;\n   120→    const strength = edge.strength ?? 1;\n   121→    const force = dist * attraction * strength;\n   122→    const fx = (dx / dist) * force;\n   123→    const fy = (dy / dist) * force;\n   124→\n   125→    if (!nodeA.fixed) {\n   126→      nodeA.x += fx;\n   127→      nodeA.y += fy;\n   128→    }\n   129→    if (!nodeB.fixed) {\n   130→      nodeB.x -= fx;\n   131→      nodeB.y -= fy;\n   132→    }\n   133→  }\n   134→}\n   135→\n   136→/**\n   137→ * Apply center gravity to pull nodes toward center.\n   138→ */\n   139→function applyCenterGravity(\n   140→  nodes: ForceNode[],\n   141→  centerX: number,\n   142→  centerY: number,\n   143→  strength: number\n   144→): void {\n   145→  if (strength <= 0) return;\n   146→\n   147→  for (const node of nodes) {\n   148→    if (node.fixed) continue;\n   149→    const dx = centerX - node.x;\n   150→    const dy = centerY - node.y;\n   151→    node.x += dx * strength;\n   152→    node.y += dy * strength;\n   153→  }\n   154→}\n   155→\n   156→/**\n   157→ * Constrain nodes to stay within bounds.\n   158→ */\n   159→function applyBounds(\n   160→  nodes: ForceNode[],\n   161→  dimensions: LayoutDimensions,\n   162→  padding: number\n   163→): void {\n   164→  const { width, height } = dimensions;\n   165→  const minX = padding;\n   166→  const maxX = width - padding;\n   167→  const minY = padding;\n   168→  const maxY = height - padding;\n   169→\n   170→  for (const node of nodes) {\n   171→    node.x = Math.max(minX, Math.min(maxX, node.x));\n   172→    node.y = Math.max(minY, Math.min(maxY, node.y));\n   173→  }\n   174→}\n   175→\n   176→/**\n   177→ * Calculate layout bounds from positioned nodes.\n   178→ */\n   179→function calculateBounds(nodes: ForceNode[]): LayoutResult['bounds'] {\n   180→  if (nodes.length === 0) {\n   181→    return { minX: 0, maxX: 0, minY: 0, maxY: 0, width: 0, height: 0 };\n   182→  }\n   183→\n   184→  let minX = Infinity;\n   185→  let maxX = -Infinity;\n   186→  let minY = Infinity;\n   187→  let maxY = -Infinity;\n   188→\n   189→  for (const node of nodes) {\n   190→    const r = node.radius ?? 0;\n   191→    minX = Math.min(minX, node.x - r);\n   192→    maxX = Math.max(maxX, node.x + r);\n   193→    minY = Math.min(minY, node.y - r);\n   194→    maxY = Math.max(maxY, node.y + r);\n   195→  }\n   196→\n   197→  return {\n   198→    minX,\n   199→    maxX,\n   200→    minY,\n   201→    maxY,\n   202→    width: maxX - minX,\n   203→    height: maxY - minY,\n   204→  };\n   205→}\n   206→\n   207→// ============================================================================\n   208→// Public API\n   209→// ============================================================================\n   210→\n   211→/**\n   212→ * Run force-directed layout simulation.\n   213→ *\n   214→ * @param nodes - Nodes to layout (will be cloned, not mutated)\n   215→ * @param edges - Edges connecting nodes\n   216→ * @param dimensions - Container dimensions\n   217→ * @param config - Layout configuration\n   218→ * @returns Layout result with positioned nodes\n   219→ *\n   220→ * @example\n   221→ * const result = forceDirectedLayout(nodes, edges, { width: 400, height: 300 });\n   222→ * // Use result.nodes for positioned nodes\n   223→ */\n   224→export function forceDirectedLayout<T extends LayoutNode>(\n   225→  nodes: T[],\n   226→  edges: LayoutEdge[],\n   227→  dimensions: LayoutDimensions,\n   228→  config: ForceLayoutConfig = {}\n   229→): LayoutResult<T & { x: number; y: number }> {\n   230→  const cfg = { ...DEFAULT_CONFIG, ...config };\n   231→  const { width, height } = dimensions;\n   232→  const centerX = width / 2;\n   233→  const centerY = height / 2;\n   234→\n   235→  // Initialize force nodes\n   236→  const forceNodes = initializeForceNodes(nodes, dimensions);\n   237→  const nodeMap = new Map(forceNodes.map((n) => [n.id, n]));\n   238→\n   239→  // Run simulation\n   240→  for (let iter = 0; iter < cfg.iterations; iter++) {\n   241→    applyRepulsion(forceNodes, cfg.repulsion, cfg.minDistance, cfg.damping);\n   242→    applyAttraction(forceNodes, edges, cfg.attraction, nodeMap);\n   243→    applyCenterGravity(forceNodes, centerX, centerY, cfg.centerGravity);\n   244→    applyBounds(forceNodes, dimensions, cfg.padding);\n   245→  }\n   246→\n   247→  // Map back to original node type with updated positions\n   248→  const resultNodes = nodes.map((originalNode) => {\n   249→    const forceNode = nodeMap.get(originalNode.id);\n   250→    return {\n   251→      ...originalNode,\n   252→      x: forceNode?.x ?? originalNode.x ?? 0,\n   253→      y: forceNode?.y ?? originalNode.y ?? 0,\n   254→    };\n   255→  });\n   256→\n   257→  return {\n   258→    nodes: resultNodes,\n   259→    bounds: calculateBounds(forceNodes),\n   260→  };\n   261→}\n   262→\n   263→/**\n   264→ * Get positions as a Map for quick lookup.\n   265→ *\n   266→ * @param nodes - Nodes with positions\n   267→ * @returns Map of node ID to position\n   268→ */\n   269→export function getPositionMap(nodes: LayoutNode[]): PositionMap {\n   270→  const map = new Map<string, Point>();\n   271→  for (const node of nodes) {\n   272→    map.set(node.id, { x: node.x, y: node.y });\n   273→  }\n   274→  return map;\n   275→}\n   276→\n   277→/**\n   278→ * Create a partial layout update for incremental changes.\n   279→ * Useful for adding/removing nodes without full re-layout.\n   280→ *\n   281→ * @param existingPositions - Current position map\n   282→ * @param newNodes - New nodes to add\n   283→ * @param dimensions - Container dimensions\n   284→ * @returns Position map with new nodes added\n   285→ */\n   286→export function incrementalLayout(\n   287→  existingPositions: PositionMap,\n   288→  newNodes: LayoutNode[],\n   289→  dimensions: LayoutDimensions\n   290→): PositionMap {\n   291→  const { width, height } = dimensions;\n   292→  const centerX = width / 2;\n   293→  const centerY = height / 2;\n   294→  const result = new Map(existingPositions);\n   295→\n   296→  // Add new nodes near center with some randomization\n   297→  for (const node of newNodes) {\n   298→    if (!result.has(node.id)) {\n   299→      const angle = Math.random() * Math.PI * 2;\n   300→      const dist = Math.random() * 50 + 20;\n   301→      result.set(node.id, {\n   302→        x: centerX + Math.cos(angle) * dist,\n   303→        y: centerY + Math.sin(angle) * dist,\n   304→      });\n   305→    }\n   306→  }\n   307→\n   308→  return result;\n   309→}\n   310→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"bb700aba-f9fc-4283-93cf-561e37220b63","uuid":"6142e887-763d-4022-8b88-c2ff4e4b8579","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\lib\\layout\\force-directed.ts","content":"/**\n * Force-directed graph layout algorithm.\n *\n * Implements a simple force simulation with:\n * - Repulsion between all nodes\n * - Attraction along edges\n * - Boundary constraints\n * - Center gravity (optional)\n */\n\nimport type {\n  LayoutNode,\n  ForceNode,\n  LayoutEdge,\n  ForceLayoutConfig,\n  LayoutResult,\n  LayoutDimensions,\n  PositionMap,\n  Point,\n} from './types';\n\n// ============================================================================\n// Default Configuration\n// ============================================================================\n\nconst DEFAULT_CONFIG: Required<ForceLayoutConfig> = {\n  iterations: 50,\n  repulsion: 1000,\n  attraction: 0.01,\n  damping: 0.1,\n  minDistance: 1,\n  padding: 40,\n  centerGravity: 0,\n};\n\n// ============================================================================\n// Core Force Simulation\n// ============================================================================\n\n/**\n * Initialize nodes with positions and velocities.\n * Places nodes in a circular arrangement to start.\n */\nexport function initializeForceNodes<T extends LayoutNode>(\n  nodes: T[],\n  dimensions: LayoutDimensions\n): ForceNode[] {\n  const { width, height } = dimensions;\n  const centerX = width / 2;\n  const centerY = height / 2;\n  const radius = Math.min(width, height) * 0.35;\n\n  return nodes.map((node, i) => {\n    // Use existing position if provided, otherwise arrange in circle\n    if (node.x !== undefined && node.y !== undefined && node.x !== 0 && node.y !== 0) {\n      return { ...node, vx: 0, vy: 0 };\n    }\n\n    const angle = (i / nodes.length) * Math.PI * 2;\n    return {\n      ...node,\n      x: centerX + Math.cos(angle) * radius,\n      y: centerY + Math.sin(angle) * radius,\n      vx: 0,\n      vy: 0,\n    };\n  });\n}\n\n/**\n * Apply repulsion forces between all nodes.\n */\nfunction applyRepulsion(\n  nodes: ForceNode[],\n  repulsion: number,\n  minDistance: number,\n  damping: number\n): void {\n  for (let i = 0; i < nodes.length; i++) {\n    const nodeA = nodes[i];\n    if (nodeA.fixed) continue;\n\n    for (let j = i + 1; j < nodes.length; j++) {\n      const nodeB = nodes[j];\n      const dx = nodeA.x - nodeB.x;\n      const dy = nodeA.y - nodeB.y;\n      const dist = Math.sqrt(dx * dx + dy * dy) || minDistance;\n      const force = repulsion / (dist * dist);\n      const fx = (dx / dist) * force * damping;\n      const fy = (dy / dist) * force * damping;\n\n      nodeA.x += fx;\n      nodeA.y += fy;\n\n      if (!nodeB.fixed) {\n        nodeB.x -= fx;\n        nodeB.y -= fy;\n      }\n    }\n  }\n}\n\n/**\n * Apply attraction forces along edges.\n */\nfunction applyAttraction(\n  nodes: ForceNode[],\n  edges: LayoutEdge[],\n  attraction: number,\n  nodeMap: Map<string, ForceNode>\n): void {\n  for (const edge of edges) {\n    const nodeA = nodeMap.get(edge.source);\n    const nodeB = nodeMap.get(edge.target);\n    if (!nodeA || !nodeB) continue;\n\n    const dx = nodeB.x - nodeA.x;\n    const dy = nodeB.y - nodeA.y;\n    const dist = Math.sqrt(dx * dx + dy * dy) || 1;\n    const strength = edge.strength ?? 1;\n    const force = dist * attraction * strength;\n    const fx = (dx / dist) * force;\n    const fy = (dy / dist) * force;\n\n    if (!nodeA.fixed) {\n      nodeA.x += fx;\n      nodeA.y += fy;\n    }\n    if (!nodeB.fixed) {\n      nodeB.x -= fx;\n      nodeB.y -= fy;\n    }\n  }\n}\n\n/**\n * Apply center gravity to pull nodes toward center.\n */\nfunction applyCenterGravity(\n  nodes: ForceNode[],\n  centerX: number,\n  centerY: number,\n  strength: number\n): void {\n  if (strength <= 0) return;\n\n  for (const node of nodes) {\n    if (node.fixed) continue;\n    const dx = centerX - node.x;\n    const dy = centerY - node.y;\n    node.x += dx * strength;\n    node.y += dy * strength;\n  }\n}\n\n/**\n * Constrain nodes to stay within bounds.\n */\nfunction applyBounds(\n  nodes: ForceNode[],\n  dimensions: LayoutDimensions,\n  padding: number\n): void {\n  const { width, height } = dimensions;\n  const minX = padding;\n  const maxX = width - padding;\n  const minY = padding;\n  const maxY = height - padding;\n\n  for (const node of nodes) {\n    node.x = Math.max(minX, Math.min(maxX, node.x));\n    node.y = Math.max(minY, Math.min(maxY, node.y));\n  }\n}\n\n/**\n * Calculate layout bounds from positioned nodes.\n */\nfunction calculateBounds(nodes: ForceNode[]): LayoutResult['bounds'] {\n  if (nodes.length === 0) {\n    return { minX: 0, maxX: 0, minY: 0, maxY: 0, width: 0, height: 0 };\n  }\n\n  let minX = Infinity;\n  let maxX = -Infinity;\n  let minY = Infinity;\n  let maxY = -Infinity;\n\n  for (const node of nodes) {\n    const r = node.radius ?? 0;\n    minX = Math.min(minX, node.x - r);\n    maxX = Math.max(maxX, node.x + r);\n    minY = Math.min(minY, node.y - r);\n    maxY = Math.max(maxY, node.y + r);\n  }\n\n  return {\n    minX,\n    maxX,\n    minY,\n    maxY,\n    width: maxX - minX,\n    height: maxY - minY,\n  };\n}\n\n// ============================================================================\n// Public API\n// ============================================================================\n\n/**\n * Run force-directed layout simulation.\n *\n * @param nodes - Nodes to layout (will be cloned, not mutated)\n * @param edges - Edges connecting nodes\n * @param dimensions - Container dimensions\n * @param config - Layout configuration\n * @returns Layout result with positioned nodes\n *\n * @example\n * const result = forceDirectedLayout(nodes, edges, { width: 400, height: 300 });\n * // Use result.nodes for positioned nodes\n */\nexport function forceDirectedLayout<T extends LayoutNode>(\n  nodes: T[],\n  edges: LayoutEdge[],\n  dimensions: LayoutDimensions,\n  config: ForceLayoutConfig = {}\n): LayoutResult<T & { x: number; y: number }> {\n  const cfg = { ...DEFAULT_CONFIG, ...config };\n  const { width, height } = dimensions;\n  const centerX = width / 2;\n  const centerY = height / 2;\n\n  // Initialize force nodes\n  const forceNodes = initializeForceNodes(nodes, dimensions);\n  const nodeMap = new Map(forceNodes.map((n) => [n.id, n]));\n\n  // Run simulation\n  for (let iter = 0; iter < cfg.iterations; iter++) {\n    applyRepulsion(forceNodes, cfg.repulsion, cfg.minDistance, cfg.damping);\n    applyAttraction(forceNodes, edges, cfg.attraction, nodeMap);\n    applyCenterGravity(forceNodes, centerX, centerY, cfg.centerGravity);\n    applyBounds(forceNodes, dimensions, cfg.padding);\n  }\n\n  // Map back to original node type with updated positions\n  const resultNodes = nodes.map((originalNode) => {\n    const forceNode = nodeMap.get(originalNode.id);\n    return {\n      ...originalNode,\n      x: forceNode?.x ?? originalNode.x ?? 0,\n      y: forceNode?.y ?? originalNode.y ?? 0,\n    };\n  });\n\n  return {\n    nodes: resultNodes,\n    bounds: calculateBounds(forceNodes),\n  };\n}\n\n/**\n * Get positions as a Map for quick lookup.\n *\n * @param nodes - Nodes with positions\n * @returns Map of node ID to position\n */\nexport function getPositionMap(nodes: LayoutNode[]): PositionMap {\n  const map = new Map<string, Point>();\n  for (const node of nodes) {\n    map.set(node.id, { x: node.x, y: node.y });\n  }\n  return map;\n}\n\n/**\n * Create a partial layout update for incremental changes.\n * Useful for adding/removing nodes without full re-layout.\n *\n * @param existingPositions - Current position map\n * @param newNodes - New nodes to add\n * @param dimensions - Container dimensions\n * @returns Position map with new nodes added\n */\nexport function incrementalLayout(\n  existingPositions: PositionMap,\n  newNodes: LayoutNode[],\n  dimensions: LayoutDimensions\n): PositionMap {\n  const { width, height } = dimensions;\n  const centerX = width / 2;\n  const centerY = height / 2;\n  const result = new Map(existingPositions);\n\n  // Add new nodes near center with some randomization\n  for (const node of newNodes) {\n    if (!result.has(node.id)) {\n      const angle = Math.random() * Math.PI * 2;\n      const dist = Math.random() * 50 + 20;\n      result.set(node.id, {\n        x: centerX + Math.cos(angle) * dist,\n        y: centerY + Math.sin(angle) * dist,\n      });\n    }\n  }\n\n  return result;\n}\n","numLines":310,"startLine":1,"totalLines":310}}}
