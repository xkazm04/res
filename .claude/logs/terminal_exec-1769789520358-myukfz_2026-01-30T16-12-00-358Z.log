      <div className=\"flex gap-3 text-[10px]\">\n    47→          {Object.entries(typeConfig).map(([type, config]) => (\n    48→            <span key={type} className=\"flex items-center gap-1\" style={{ color: config.color }}>\n    49→              {config.icon} {type}\n    50→            </span>\n    51→          ))}\n    52→        </div>\n    53→      </div>\n    54→\n    55→      {/* Timeline track */}\n    56→      <div ref={containerRef} className=\"relative h-20\">\n    57→        {/* Background track */}\n    58→        <div\n    59→          className=\"absolute top-1/2 left-0 right-0 h-0.5 -translate-y-1/2\"\n    60→          style={{ backgroundColor: colors.axisLine }}\n    61→        >\n    62→          {/* Glow effect for radar */}\n    63→          {isRadar && (\n    64→            <div\n    65→              className=\"absolute inset-0 blur-sm\"\n    66→              style={{ backgroundColor: colors.glowColor }}\n    67→            />\n    68→          )}\n    69→        </div>\n    70→\n    71→        {/* Date markers */}\n    72→        <div\n    73→          className=\"absolute top-full left-0 right-0 flex justify-between pt-2 text-[10px]\"\n    74→          style={{ color: colors.textMuted }}\n    75→        >\n    76→          <span>{sortedEvents[0].date.toLocaleDateString()}</span>\n    77→          <span>{sortedEvents[sortedEvents.length - 1].date.toLocaleDateString()}</span>\n    78→        </div>\n    79→\n    80→        {/* Events */}\n    81→        {sortedEvents.map((event, i) => {\n    82→          const pos = getPosition(event.date);\n    83→          const config = typeConfig[event.type];\n    84→          const isHovered = hoveredEvent === event.id;\n    85→\n    86→          return (\n    87→            <motion.div\n    88→              key={event.id}\n    89→              initial={{ scale: 0, opacity: 0 }}\n    90→              animate={{ scale: 1, opacity: 1 }}\n    91→              transition={{ delay: i * 0.05, type: 'spring' }}\n    92→              className=\"absolute top-1/2 -translate-y-1/2 cursor-pointer\"\n    93→              style={{ left: `${pos}%` }}\n    94→              onMouseEnter={() => setHoveredEvent(event.id)}\n    95→              onMouseLeave={() => setHoveredEvent(null)}\n    96→              onClick={() => onEventClick?.(event.id)}\n    97→            >\n    98→              {/* Event node */}\n    99→              <motion.div\n   100→                animate={{ scale: isHovered ? 1.5 : 1 }}\n   101→                className=\"relative w-4 h-4 -ml-2 flex items-center justify-center text-xs\"\n   102→                style={{\n   103→                  color: config.color,\n   104→                  filter: isHovered ? `drop-shadow(0 0 8px ${config.color})` : undefined,\n   105→                }}\n   106→              >\n   107→                {config.icon}\n   108→\n   109→                {/* Confidence ring */}\n   110→                {event.confidence !== undefined && (\n   111→                  <svg className=\"absolute inset-0 w-full h-full -rotate-90\">\n   112→                    <circle\n   113→                      cx=\"8\" cy=\"8\" r=\"6\"\n   114→                      fill=\"none\"\n   115→                      stroke={config.color}\n   116→                      strokeWidth=\"1\"\n   117→                      strokeDasharray={`${event.confidence * 37.7} 37.7`}\n   118→                      opacity={0.5}\n   119→                    />\n   120→                  </svg>\n   121→                )}\n   122→              </motion.div>\n   123→\n   124→              {/* Tooltip */}\n   125→              {isHovered && (\n   126→                <motion.div\n   127→                  initial={{ opacity: 0, y: 5 }}\n   128→                  animate={{ opacity: 1, y: 0 }}\n   129→                  className={`absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 rounded text-[10px] whitespace-nowrap z-10 ${tooltipClasses}`}\n   130→                >\n   131→                  {event.label}\n   132→                </motion.div>\n   133→              )}\n   134→            </motion.div>\n   135→          );\n   136→        })}\n   137→      </div>\n   138→    </div>\n   139→  );\n   140→}\n   141→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"bb700aba-f9fc-4283-93cf-561e37220b63","uuid":"122cb37d-1ab8-4f8a-9112-b84c3296c6d3","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\visualizations\\Timeline.tsx","content":"'use client';\n\nimport { useRef, useState } from 'react';\nimport { motion } from 'framer-motion';\nimport { useVisualizationTheme } from './useVisualizationTheme';\n\ninterface TimelineEvent {\n  id: string;\n  date: Date;\n  label: string;\n  type: 'finding' | 'event' | 'prediction';\n  confidence?: number;\n}\n\ninterface TimelineProps {\n  events: TimelineEvent[];\n  onEventClick?: (eventId: string) => void;\n}\n\nexport function Timeline({ events, onEventClick }: TimelineProps) {\n  const { colors, isRadar, getTimelineTypeConfig, cardClasses, tooltipClasses } = useVisualizationTheme();\n  const containerRef = useRef<HTMLDivElement>(null);\n  const [hoveredEvent, setHoveredEvent] = useState<string | null>(null);\n\n  if (events.length === 0) return null;\n\n  const sortedEvents = [...events].sort((a, b) => a.date.getTime() - b.date.getTime());\n  const minDate = sortedEvents[0].date.getTime();\n  const maxDate = sortedEvents[sortedEvents.length - 1].date.getTime();\n  const range = maxDate - minDate || 1;\n\n  const getPosition = (date: Date) => ((date.getTime() - minDate) / range) * 100;\n\n  const typeConfig = getTimelineTypeConfig();\n\n  return (\n    <div className={`relative p-4 rounded-xl ${cardClasses}`}>\n      {/* Header */}\n      <div className=\"flex items-center justify-between mb-4\">\n        <h4\n          className=\"text-xs font-semibold uppercase tracking-wider\"\n          style={{ color: colors.textSecondary }}\n        >\n          Timeline\n        </h4>\n        <div className=\"flex gap-3 text-[10px]\">\n          {Object.entries(typeConfig).map(([type, config]) => (\n            <span key={type} className=\"flex items-center gap-1\" style={{ color: config.color }}>\n              {config.icon} {type}\n            </span>\n          ))}\n        </div>\n      </div>\n\n      {/* Timeline track */}\n      <div ref={containerRef} className=\"relative h-20\">\n        {/* Background track */}\n        <div\n          className=\"absolute top-1/2 left-0 right-0 h-0.5 -translate-y-1/2\"\n          style={{ backgroundColor: colors.axisLine }}\n        >\n          {/* Glow effect for radar */}\n          {isRadar && (\n            <div\n              className=\"absolute inset-0 blur-sm\"\n              style={{ backgroundColor: colors.glowColor }}\n            />\n          )}\n        </div>\n\n        {/* Date markers */}\n        <div\n          className=\"absolute top-full left-0 right-0 flex justify-between pt-2 text-[10px]\"\n          style={{ color: colors.textMuted }}\n        >\n          <span>{sortedEvents[0].date.toLocaleDateString()}</span>\n          <span>{sortedEvents[sortedEvents.length - 1].date.toLocaleDateString()}</span>\n        </div>\n\n        {/* Events */}\n        {sortedEvents.map((event, i) => {\n          const pos = getPosition(event.date);\n          const config = typeConfig[event.type];\n          const isHovered = hoveredEvent === event.id;\n\n          return (\n            <motion.div\n              key={event.id}\n              initial={{ scale: 0, opacity: 0 }}\n              animate={{ scale: 1, opacity: 1 }}\n              transition={{ delay: i * 0.05, type: 'spring' }}\n              className=\"absolute top-1/2 -translate-y-1/2 cursor-pointer\"\n              style={{ left: `${pos}%` }}\n              onMouseEnter={() => setHoveredEvent(event.id)}\n              onMouseLeave={() => setHoveredEvent(null)}\n              onClick={() => onEventClick?.(event.id)}\n            >\n              {/* Event node */}\n              <motion.div\n                animate={{ scale: isHovered ? 1.5 : 1 }}\n                className=\"relative w-4 h-4 -ml-2 flex items-center justify-center text-xs\"\n                style={{\n                  color: config.color,\n                  filter: isHovered ? `drop-shadow(0 0 8px ${config.color})` : undefined,\n                }}\n              >\n                {config.icon}\n\n                {/* Confidence ring */}\n                {event.confidence !== undefined && (\n                  <svg className=\"absolute inset-0 w-full h-full -rotate-90\">\n                    <circle\n                      cx=\"8\" cy=\"8\" r=\"6\"\n                      fill=\"none\"\n                      stroke={config.color}\n                      strokeWidth=\"1\"\n                      strokeDasharray={`${event.confidence * 37.7} 37.7`}\n                      opacity={0.5}\n                    />\n                  </svg>\n                )}\n              </motion.div>\n\n              {/* Tooltip */}\n              {isHovered && (\n                <motion.div\n                  initial={{ opacity: 0, y: 5 }}\n                  animate={{ opacity: 1, y: 0 }}\n                  className={`absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 rounded text-[10px] whitespace-nowrap z-10 ${tooltipClasses}`}\n                >\n                  {event.label}\n                </motion.div>\n              )}\n            </motion.div>\n          );\n        })}\n      </div>\n    </div>\n  );\n}\n","numLines":141,"startLine":1,"totalLines":141}}}
