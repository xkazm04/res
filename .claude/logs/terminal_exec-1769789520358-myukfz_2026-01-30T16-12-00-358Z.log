[2026-01-30T16:21:55.180Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01W17N2L2DJ4XxXKHZCBFfpn","type":"tool_result","content":"     1→/**\n     2→ * Story Script Generation Library\n     3→ *\n     4→ * Generates cinematic narration scripts from timeline events,\n     5→ * creates chapters, and manages playback timing.\n     6→ */\n     7→\n     8→import type { TimelineEvent, FindingType } from '@/src/types/research';\n     9→\n    10→// ============================================================================\n    11→// Types\n    12→// ============================================================================\n    13→\n    14→export interface StoryEvent extends TimelineEvent {\n    15→  narration: string;\n    16→  duration: number; // Duration in seconds\n    17→  chapter: string;\n    18→  chapterIndex: number;\n    19→  importance: 'major' | 'minor' | 'transitional';\n    20→  contextPoints?: string[];\n    21→}\n    22→\n    23→export interface StoryChapter {\n    24→  id: string;\n    25→  title: string;\n    26→  description: string;\n    27→  startTime: number; // Seconds from start\n    28→  endTime: number;\n    29→  events: StoryEvent[];\n    30→  mood: 'neutral' | 'tension' | 'revelation' | 'resolution' | 'conclusion';\n    31→}\n    32→\n    33→export interface StoryScript {\n    34→  title: string;\n    35→  introduction: string;\n    36→  chapters: StoryChapter[];\n    37→  conclusion: string;\n    38→  totalDuration: number;\n    39→  events: StoryEvent[];\n    40→}\n    41→\n    42→export interface PlaybackState {\n    43→  isPlaying: boolean;\n    44→  currentTime: number;\n    45→  currentEventIndex: number;\n    46→  currentChapterIndex: number;\n    47→  speed: number;\n    48→  volume: number;\n    49→}\n    50→\n    51→export interface ChapterMarker {\n    52→  id: string;\n    53→  title: string;\n    54→  time: number;\n    55→  percentage: number;\n    56→}\n    57→\n    58→// ============================================================================\n    59→// Constants\n    60→// ============================================================================\n    61→\n    62→const BASE_EVENT_DURATION = 5; // seconds per event\n    63→const TRANSITION_DURATION = 2; // seconds between events\n    64→const CHAPTER_INTRO_DURATION = 3; // seconds for chapter title\n    65→const MIN_EVENT_DURATION = 3;\n    66→const MAX_EVENT_DURATION = 10;\n    67→\n    68→// ============================================================================\n    69→// Narration Templates\n    70→// ============================================================================\n    71→\n    72→const FINDING_TYPE_INTROS: Record<FindingType, string[]> = {\n    73→  fact: [\n    74→    'Evidence reveals that',\n    75→    'Research confirms',\n    76→    'Data indicates that',\n    77→    'Analysis shows',\n    78→  ],\n    79→  claim: [\n    80→    'Sources suggest that',\n    81→    'It is claimed that',\n    82→    'Reports indicate',\n    83→    'According to sources,',\n    84→  ],\n    85→  event: [\n    86→    'A significant development occurred:',\n    87→    'This marks a pivotal moment when',\n    88→    'Events unfolded as',\n    89→    'History records that',\n    90→  ],\n    91→  actor: [\n    92→    'A key player emerges:',\n    93→    'Central to this story is',\n    94→    'Notably involved was',\n    95→    'Taking center stage,',\n    96→  ],\n    97→  relationship: [\n    98→    'Connections reveal that',\n    99→    'The relationship between parties shows',\n   100→    'Links were established as',\n   101→    'Investigation uncovered ties:',\n   102→  ],\n   103→  pattern: [\n   104→    'A pattern becomes clear:',\n   105→    'Recurring themes emerge as',\n   106→    'Systematic analysis reveals',\n   107→    'Notable trends indicate',\n   108→  ],\n   109→  gap: [\n   110→    'Questions remain about',\n   111→    'Uncertainty persists regarding',\n   112→    'Missing information suggests',\n   113→    'Further investigation needed:',\n   114→  ],\n   115→  evidence: [\n   116→    'Supporting evidence shows',\n   117→    'Documentation confirms',\n   118→    'Proof emerges that',\n   119→    'Verification reveals',\n   120→  ],\n   121→};\n   122→\n   123→const CHAPTER_MOOD_PHRASES: Record<StoryChapter['mood'], string[]> = {\n   124→  neutral: ['During this period,', 'At this time,', 'In this phase,'],\n   125→  tension: ['Tensions escalated as', 'Conflict emerged when', 'Challenges arose as'],\n   126→  revelation: ['A breakthrough occurred when', 'Discovery revealed that', 'Investigation uncovered'],\n   127→  resolution: ['Clarity emerged as', 'Resolution came when', 'Understanding developed as'],\n   128→  conclusion: ['In conclusion,', 'Ultimately,', 'The investigation concludes that'],\n   129→};\n   130→\n   131→const TRANSITION_PHRASES = [\n   132→  'Meanwhile,',\n   133→  'Subsequently,',\n   134→  'Following this,',\n   135→  'As events continued,',\n   136→  'In the aftermath,',\n   137→  'This led to',\n   138→  'Building upon this,',\n   139→  'Concurrently,',\n   140→];\n   141→\n   142→// ============================================================================\n   143→// Helper Functions\n   144→// ============================================================================\n   145→\n   146→function pickRandom<T>(arr: T[]): T {\n   147→  return arr[Math.floor(Math.random() * arr.length)];\n   148→}\n   149→\n   150→function calculateEventImportance(\n   151→  event: TimelineEvent,\n   152→  allEvents: TimelineEvent[]\n   153→): 'major' | 'minor' | 'transitional' {\n   154→  const confidence = event.confidence ?? 0.5;\n   155→\n   156→  // High confidence events are major\n   157→  if (confidence >= 0.8) return 'major';\n   158→\n   159→  // Events with specific types are more important\n   160→  if (['event', 'fact', 'evidence'].includes(event.findingType)) {\n   161→    return confidence >= 0.5 ? 'major' : 'minor';\n   162→  }\n   163→\n   164→  // Gaps and patterns are transitional\n   165→  if (['gap', 'pattern'].includes(event.findingType)) {\n   166→    return 'transitional';\n   167→  }\n   168→\n   169→  return confidence >= 0.6 ? 'minor' : 'transitional';\n   170→}\n   171→\n   172→function calculateEventDuration(event: StoryEvent): number {\n   173→  const summaryLength = event.summary.length;\n   174→  const baseFromLength = Math.min(MAX_EVENT_DURATION, Math.max(MIN_EVENT_DURATION, summaryLength / 30));\n   175→\n   176→  // Adjust based on importance\n   177→  const importanceMultiplier =\n   178→    event.importance === 'major' ? 1.3 :\n   179→    event.importance === 'minor' ? 1 : 0.8;\n   180→\n   181→  return Math.round(baseFromLength * importanceMultiplier);\n   182→}\n   183→\n   184→function generateEventNarration(event: TimelineEvent, isFirst: boolean, isTransition: boolean): string {\n   185→  const intros = FINDING_TYPE_INTROS[event.findingType] ?? FINDING_TYPE_INTROS.fact;\n   186→  let prefix = '';\n   187→\n   188→  if (isFirst) {\n   189→    prefix = 'Our story begins when ';\n   190→  } else if (isTransition) {\n   191→    prefix = pickRandom(TRANSITION_PHRASES) + ' ';\n   192→  } else {\n   193→    prefix = pickRandom(intros) + ' ';\n   194→  }\n   195→\n   196→  // Clean up the summary for narration\n   197→  let narration = event.summary\n   198→    .replace(/\\s+/g, ' ')\n   199→    .trim();\n   200→\n   201→  // Ensure it ends with proper punctuation\n   202→  if (!/[.!?]$/.test(narration)) {\n   203→    narration += '.';\n   204→  }\n   205→\n   206→  return prefix + narration;\n   207→}\n   208→\n   209→function generateContextPoints(event: TimelineEvent): string[] {\n   210→  const points: string[] = [];\n   211→\n   212→  if (event.confidence !== undefined) {\n   213→    const confPercent = Math.round(event.confidence * 100);\n   214→    if (confPercent >= 80) {\n   215→      points.push('High confidence finding');\n   216→    } else if (confPercent >= 50) {\n   217→      points.push('Moderate confidence');\n   218→    } else {\n   219→      points.push('Requires verification');\n   220→    }\n   221→  }\n   222→\n   223→  // Add date context\n   224→  const eventDate = new Date(event.date);\n   225→  points.push(eventDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }));\n   226→\n   227→  // Add type-specific context\n   228→  switch (event.findingType) {\n   229→    case 'fact':\n   230→      points.push('Verified fact');\n   231→      break;\n   232→    case 'claim':\n   233→      points.push('Unverified claim');\n   234→      break;\n   235→    case 'event':\n   236→      points.push('Key event');\n   237→      break;\n   238→    case 'pattern':\n   239→      points.push('Pattern identified');\n   240→      break;\n   241→    case 'gap':\n   242→      points.push('Information gap');\n   243→      break;\n   244→  }\n   245→\n   246→  return points;\n   247→}\n   248→\n   249→// ============================================================================\n   250→// Chapter Detection\n   251→// ============================================================================\n   252→\n   253→function detectChapters(events: TimelineEvent[]): Array<{ start: number; end: number; mood: StoryChapter['mood'] }> {\n   254→  if (events.length === 0) return [];\n   255→  if (events.length <= 3) {\n   256→    return [{ start: 0, end: events.length - 1, mood: 'neutral' }];\n   257→  }\n   258→\n   259→  const chapters: Array<{ start: number; end: number; mood: StoryChapter['mood'] }> = [];\n   260→  const targetChapterSize = Math.max(3, Math.ceil(events.length / 4));\n   261→\n   262→  let chapterStart = 0;\n   263→  let lastDate = new Date(events[0].date);\n   264→\n   265→  for (let i = 1; i < events.length; i++) {\n   266→    const currentDate = new Date(events[i].date);\n   267→    const daysDiff = (currentDate.getTime() - lastDate.getTime()) / (1000 * 60 * 60 * 24);\n   268→    const eventsInChapter = i - chapterStart;\n   269→\n   270→    // Create new chapter if:\n   271→    // 1. Large time gap (more than 30 days)\n   272→    // 2. We've accumulated enough events\n   273→    const shouldSplit = daysDiff > 30 || eventsInChapter >= targetChapterSize;\n   274→\n   275→    if (shouldSplit && eventsInChapter >= 2) {\n   276→      // Determine mood based on event types in this chapter\n   277→      const chapterEvents = events.slice(chapterStart, i);\n   278→      const mood = determineMood(chapterEvents);\n   279→\n   280→      chapters.push({ start: chapterStart, end: i - 1, mood });\n   281→      chapterStart = i;\n   282→    }\n   283→\n   284→    lastDate = currentDate;\n   285→  }\n   286→\n   287→  // Add final chapter\n   288→  if (chapterStart < events.length) {\n   289→    const finalEvents = events.slice(chapterStart);\n   290→    const mood = chapters.length === 0 ? 'neutral' : 'conclusion';\n   291→    chapters.push({ start: chapterStart, end: events.length - 1, mood });\n   292→  }\n   293→\n   294→  return chapters;\n   295→}\n   296→\n   297→function determineMood(events: TimelineEvent[]): StoryChapter['mood'] {\n   298→  const types = events.map((e) => e.findingType);\n   299→\n   300→  if (types.includes('gap') || types.filter((t) => t === 'claim').length > types.length / 2) {\n   301→    return 'tension';\n   302→  }\n   303→\n   304→  if (types.includes('evidence') || types.filter((t) => t === 'fact').length > types.length / 2) {\n   305→    return 'revelation';\n   306→  }\n   307→\n   308→  if (types.includes('pattern')) {\n   309→    return 'resolution';\n   310→  }\n   311→\n   312→  return 'neutral';\n   313→}\n   314→\n   315→function generateChapterTitle(events: TimelineEvent[], chapterIndex: number, totalChapters: number): string {\n   316→  if (chapterIndex === 0) return 'The Beginning';\n   317→  if (chapterIndex === totalChapters - 1) return 'Conclusion';\n   318→\n   319→  const startDate = new Date(events[0].date);\n   320→  const endDate = new Date(events[events.length - 1].date);\n   321→\n   322→  // Try to generate a meaningful title from the events\n   323→  const eventTypes = new Set(events.map((e) => e.findingType));\n   324→\n   325→  if (eventTypes.has('event')) {\n   326→    return `Key Developments`;\n   327→  }\n   328→  if (eventTypes.has('evidence')) {\n   329→    return `Evidence Emerges`;\n   330→  }\n   331→  if (eventTypes.has('pattern')) {\n   332→    return `Patterns Revealed`;\n   333→  }\n   334→  if (eventTypes.has('gap')) {\n   335→    return `Questions Arise`;\n   336→  }\n   337→\n   338→  // Default to date-based title\n   339→  const monthYear = startDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });\n   340→  return `Chapter ${chapterIndex + 1}: ${monthYear}`;\n   341→}\n   342→\n   343→function generateChapterDescription(events: TimelineEvent[], mood: StoryChapter['mood']): string {\n   344→  const prefix = pickRandom(CHAPTER_MOOD_PHRASES[mood]);\n   345→  const eventCount = events.length;\n   346→\n   347→  if (eventCount === 1) {\n   348→    return `${prefix} a significant development shapes the narrative.`;\n   349→  }\n   350→\n   351→  return `${prefix} ${eventCount} key moments unfold, revealing new insights.`;\n   352→}\n   353→\n   354→// ============================================================================\n   355→// Main Script Generation\n   356→// ============================================================================\n   357→\n   358→/**\n   359→ * Generate a complete story script from timeline events\n   360→ */\n   361→export function generateStoryScript(\n   362→  events: TimelineEvent[],\n   363→  title?: string\n   364→): StoryScript {\n   365→  if (events.length === 0) {\n   366→    return {\n   367→      title: title ?? 'Research Timeline',\n   368→      introduction: 'No events to narrate.',\n   369→      chapters: [],\n   370→      conclusion: '',\n   371→      totalDuration: 0,\n   372→      events: [],\n   373→    };\n   374→  }\n   375→\n   376→  // Sort events by date\n   377→  const sortedEvents = [...events].sort(\n   378→    (a, b) => new Date(a.date).getTime() - new Date(b.date).getTime()\n   379→  );\n   380→\n   381→  // Detect chapters\n   382→  const chapterRanges = detectChapters(sortedEvents);\n   383→\n   384→  // Generate story events with narration\n   385→  const storyEvents: StoryEvent[] = [];\n   386→  let currentTime = 0;\n   387→\n   388→  // Introduction duration\n   389→  currentTime += 5;\n   390→\n   391→  // Process each event\n   392→  sortedEvents.forEach((event, index) => {\n   393→    const isFirst = index === 0;\n   394→    const importance = calculateEventImportance(event, sortedEvents);\n   395→\n   396→    // Find which chapter this event belongs to\n   397→    const chapterRange = chapterRanges.find(\n   398→      (c) => index >= c.start && index <= c.end\n   399→    );\n   400→    const chapterIndex = chapterRanges.indexOf(chapterRange!);\n   401→\n   402→    // Determine if this is a transition point\n   403→    const isTransition =\n   404→      index > 0 &&\n   405→      chapterRanges.findIndex((c) => c.start === index) >= 0;\n   406→\n   407→    const storyEvent: StoryEvent = {\n   408→      ...event,\n   409→      narration: generateEventNarration(event, isFirst, isTransition),\n   410→      duration: 0, // Will be calculated\n   411→      chapter: generateChapterTitle(\n   412→        sortedEvents.slice(chapterRange!.start, chapterRange!.end + 1),\n   413→        chapterIndex,\n   414→        chapterRanges.length\n   415→      ),\n   416→      chapterIndex,\n   417→      importance,\n   418→      contextPoints: generateContextPoints(event),\n   419→    };\n   420→\n   421→    storyEvent.duration = calculateEventDuration(storyEvent);\n   422→    storyEvents.push(storyEvent);\n   423→  });\n   424→\n   425→  // Build chapters\n   426→  const chapters: StoryChapter[] = chapterRanges.map((range, index) => {\n   427→    const chapterEvents = storyEvents.slice(range.start, range.end + 1);\n   428→    const title = generateChapterTitle(\n   429→      sortedEvents.slice(range.start, range.end + 1),\n   430→      index,\n   431→      chapterRanges.length\n   432→    );\n   433→\n   434→    // Calculate chapter timing\n   435→    const chapterStartTime = currentTime;\n   436→    currentTime += CHAPTER_INTRO_DURATION;\n   437→\n   438→    chapterEvents.forEach((event, eventIndex) => {\n   439→      currentTime += event.duration;\n   440→      if (eventIndex < chapterEvents.length - 1) {\n   441→        currentTime += TRANSITION_DURATION;\n   442→      }\n   443→    });\n   444→\n   445→    return {\n   446→      id: `chapter-${index}`,\n   447→      title,\n   448→      description: generateChapterDescription(\n   449→        sortedEvents.slice(range.start, range.end + 1),\n   450→        range.mood\n   451→      ),\n   452→      startTime: chapterStartTime,\n   453→      endTime: currentTime,\n   454→      events: chapterEvents,\n   455→      mood: range.mood,\n   456→    };\n   457→  });\n   458→\n   459→  // Generate introduction\n   460→  const firstDate = new Date(sortedEvents[0].date);\n   461→  const lastDate = new Date(sortedEvents[sortedEvents.length - 1].date);\n   462→  const introduction = generateIntroduction(\n   463→    title ?? 'Research Timeline',\n   464→    firstDate,\n   465→    lastDate,\n   466→    sortedEvents.length\n   467→  );\n   468→\n   469→  // Generate conclusion\n   470→  const conclusion = generateConclusion(sortedEvents, chapters);\n   471→\n   472→  // Add conclusion duration\n   473→  currentTime += 5;\n   474→\n   475→  return {\n   476→    title: title ?? 'Research Timeline',\n   477→    introduction,\n   478→    chapters,\n   479→    conclusion,\n   480→    totalDuration: currentTime,\n   481→    events: storyEvents,\n   482→  };\n   483→}\n   484→\n   485→function generateIntroduction(\n   486→  title: string,\n   487→  startDate: Date,\n   488→  endDate: Date,\n   489→  eventCount: number\n   490→): string {\n   491→  const dateRange = formatDateRange(startDate, endDate);\n   492→  return `Welcome to ${title}. This narrative covers ${eventCount} key events spanning ${dateRange}. Let's explore the timeline and uncover the story within the data.`;\n   493→}\n   494→\n   495→function generateConclusion(events: TimelineEvent[], chapters: StoryChapter[]): string {\n   496→  const majorEvents = events.filter((e) => (e.confidence ?? 0) >= 0.7);\n   497→  const patterns = events.filter((e) => e.findingType === 'pattern');\n   498→  const gaps = events.filter((e) => e.findingType === 'gap');\n   499→\n   500→  let conclusion = 'In summary, this timeline reveals ';\n   501→\n   502→  if (majorEvents.length > 0) {\n   503→    conclusion += `${majorEvents.length} significant findings`;\n   504→  } else {\n   505→    conclusion += `${events.length} events`;\n   506→  }\n   507→\n   508→  if (patterns.length > 0) {\n   509→    conclusion += ` and ${patterns.length} identified patterns`;\n   510→  }\n   511→\n   512→  conclusion += '.';\n   513→\n   514→  if (gaps.length > 0) {\n   515→    conclusion += ` ${gaps.length} areas require further investigation.`;\n   516→  }\n   517→\n   518→  conclusion += ' Thank you for exploring this research narrative.';\n   519→\n   520→  return conclusion;\n   521→}\n   522→\n   523→function formatDateRange(start: Date, end: Date): string {\n   524→  const startStr = start.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });\n   525→  const endStr = end.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });\n   526→\n   527→  if (startStr === endStr) {\n   528→    return startStr;\n   529→  }\n   530→\n   531→  return `from ${startStr} to ${endStr}`;\n   532→}\n   533→\n   534→// ============================================================================\n   535→// Playback Utilities\n   536→// ============================================================================\n   537→\n   538→/**\n   539→ * Get the current event based on playback time\n   540→ */\n   541→export function getCurrentEvent(\n   542→  script: StoryScript,\n   543→  currentTime: number\n   544→): StoryEvent | null {\n   545→  let accumulatedTime = 5; // Introduction\n   546→\n   547→  for (const chapter of script.chapters) {\n   548→    accumulatedTime += CHAPTER_INTRO_DURATION;\n   549→\n   550→    for (let i = 0; i < chapter.events.length; i++) {\n   551→      const event = chapter.events[i];\n   552→      const eventEndTime = accumulatedTime + event.duration;\n   553→\n   554→      if (currentTime >= accumulatedTime && currentTime < eventEndTime) {\n   555→        return event;\n   556→      }\n   557→\n   558→      accumulatedTime = eventEndTime;\n   559→      if (i < chapter.events.length - 1) {\n   560→        accumulatedTime += TRANSITION_DURATION;\n   561→      }\n   562→    }\n   563→  }\n   564→\n   565→  return null;\n   566→}\n   567→\n   568→/**\n   569→ * Get the current chapter based on playback time\n   570→ */\n   571→export function getCurrentChapter(\n   572→  script: StoryScript,\n   573→  currentTime: number\n   574→): StoryChapter | null {\n   575→  for (const chapter of script.chapters) {\n   576→    if (currentTime >= chapter.startTime && currentTime < chapter.endTime) {\n   577→      return chapter;\n   578→    }\n   579→  }\n   580→  return null;\n   581→}\n   582→\n   583→/**\n   584→ * Get chapter markers for the progress bar\n   585→ */\n   586→export function getChapterMarkers(script: StoryScript): ChapterMarker[] {\n   587→  return script.chapters.map((chapter) => ({\n   588→    id: chapter.id,\n   589→    title: chapter.title,\n   590→    time: chapter.startTime,\n   591→    percentage: (chapter.startTime / script.totalDuration) * 100,\n   592→  }));\n   593→}\n   594→\n   595→/**\n   596→ * Calculate progress percentage\n   597→ */\n   598→export function getProgress(currentTime: number, totalDuration: number): number {\n   599→  if (totalDuration === 0) return 0;\n   600→  return Math.min(100, Math.max(0, (currentTime / totalDuration) * 100));\n   601→}\n   602→\n   603→/**\n   604→ * Format time for display (MM:SS)\n   605→ */\n   606→export function formatTime(seconds: number): string {\n   607→  const mins = Math.floor(seconds / 60);\n   608→  const secs = Math.floor(seconds % 60);\n   609→  return `${mins}:${secs.toString().padStart(2, '0')}`;\n   610→}\n   611→\n   612→/**\n   613→ * Get playback state for a specific time\n   614→ */\n   615→export function getPlaybackStateAtTime(\n   616→  script: StoryScript,\n   617→  time: number\n   618→): { phase: 'intro' | 'chapter-intro' | 'event' | 'transition' | 'conclusion'; eventIndex: number; chapterIndex: number } {\n   619→  if (time < 5) {\n   620→    return { phase: 'intro', eventIndex: -1, chapterIndex: -1 };\n   621→  }\n   622→\n   623→  if (time >= script.totalDuration - 5) {\n   624→    return {\n   625→      phase: 'conclusion',\n   626→      eventIndex: script.events.length - 1,\n   627→      chapterIndex: script.chapters.length - 1,\n   628→    };\n   629→  }\n   630→\n   631→  let accumulatedTime = 5;\n   632→\n   633→  for (let ci = 0; ci < script.chapters.length; ci++) {\n   634→    const chapter = script.chapters[ci];\n   635→\n   636→    if (time < accumulatedTime + CHAPTER_INTRO_DURATION) {\n   637→      return { phase: 'chapter-intro', eventIndex: -1, chapterIndex: ci };\n   638→    }\n   639→\n   640→    accumulatedTime += CHAPTER_INTRO_DURATION;\n   641→\n   642→    for (let ei = 0; ei < chapter.events.length; ei++) {\n   643→      const event = chapter.events[ei];\n   644→      const eventEndTime = accumulatedTime + event.duration;\n   645→\n   646→      if (time < eventEndTime) {\n   647→        return { phase: 'event', eventIndex: ei, chapterIndex: ci };\n   648→      }\n   649→\n   650→      accumulatedTime = eventEndTime;\n   651→\n   652→      if (ei < chapter.events.length - 1) {\n   653→        if (time < accumulatedTime + TRANSITION_DURATION) {\n   654→          return { phase: 'transition', eventIndex: ei, chapterIndex: ci };\n   655→        }\n   656→        accumulatedTime += TRANSITION_DURATION;\n   657→      }\n   658→    }\n   659→  }\n   660→\n   661→  return { phase: 'conclusion', eventIndex: script.events.length - 1, chapterIndex: script.chapters.length - 1 };\n   662→}\n   663→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"bb700aba-f9fc-4283-93cf-561e37220b63","uuid":"774d0fea-a40d-42dd-92ee-2197a4afba08","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\lib\\storyScript.ts","content":"/**\n * Story Script Generation Library\n *\n * Generates cinematic narration scripts from timeline events,\n * creates chapters, and manages playback timing.\n */\n\nimport type { TimelineEvent, FindingType } from '@/src/types/research';\n\n// ============================================================================\n// Types\n// ============================================================================\n\nexport interface StoryEvent extends TimelineEvent {\n  narration: string;\n  duration: number; // Duration in seconds\n  chapter: string;\n  chapterIndex: number;\n  importance: 'major' | 'minor' | 'transitional';\n  contextPoints?: string[];\n}\n\nexport interface StoryChapter {\n  id: string;\n  title: string;\n  description: string;\n  startTime: number; // Seconds from start\n  endTime: number;\n  events: StoryEvent[];\n  mood: 'neutral' | 'tension' | 'revelation' | 'resolution' | 'conclusion';\n}\n\nexport interface StoryScript {\n  title: string;\n  introduction: string;\n  chapters: StoryChapter[];\n  conclusion: string;\n  totalDuration: number;\n  events: StoryEvent[];\n}\n\nexport interface PlaybackState {\n  isPlaying: boolean;\n  currentTime: number;\n  currentEventIndex: number;\n  currentChapterIndex: number;\n  speed: number;\n  volume: number;\n}\n\nexport interface ChapterMarker {\n  id: string;\n  title: string;\n  time: number;\n  percentage: number;\n}\n\n// ============================================================================\n// Constants\n// ============================================================================\n\nconst BASE_EVENT_DURATION = 5; // seconds per event\nconst TRANSITION_DURATION = 2; // seconds between events\nconst CHAPTER_INTRO_DURATION = 3; // seconds for chapter title\nconst MIN_EVENT_DURATION = 3;\nconst MAX_EVENT_DURATION = 10;\n\n// ============================================================================\n// Narration Templates\n// ============================================================================\n\nconst FINDING_TYPE_INTROS: Record<FindingType, string[]> = {\n  fact: [\n    'Evidence reveals that',\n    'Research confirms',\n    'Data indicates that',\n    'Analysis shows',\n  ],\n  claim: [\n    'Sources suggest that',\n    'It is claimed that',\n    'Reports indicate',\n    'According to sources,',\n  ],\n  event: [\n    'A significant development occurred:',\n    'This marks a pivotal moment when',\n    'Events unfolded as',\n    'History records that',\n  ],\n  actor: [\n    'A key player emerges:',\n    'Central to this story is',\n    'Notably involved was',\n    'Taking center stage,',\n  ],\n  relationship: [\n    'Connections reveal that',\n    'The relationship between parties shows',\n    'Links were established as',\n    'Investigation uncovered ties:',\n  ],\n  pattern: [\n    'A pattern becomes clear:',\n    'Recurring themes emerge as',\n    'Systematic analysis reveals',\n    'Notable trends indicate',\n  ],\n  gap: [\n    'Questions remain about',\n    'Uncertainty persists regarding',\n    'Missing information suggests',\n    'Further investigation needed:',\n  ],\n  evidence: [\n    'Supporting evidence shows',\n    'Documentation confirms',\n    'Proof emerges that',\n    'Verification reveals',\n  ],\n};\n\nconst CHAPTER_MOOD_PHRASES: Record<StoryChapter['mood'], string[]> = {\n  neutral: ['During this period,', 'At this time,', 'In this phase,'],\n  tension: ['Tensions escalated as', 'Conflict emerged when', 'Challenges arose as'],\n  revelation: ['A breakthrough occurred when', 'Discovery revealed that', 'Investigation uncovered'],\n  resolution: ['Clarity emerged as', 'Resolution came when', 'Understanding developed as'],\n  conclusion: ['In conclusion,', 'Ultimately,', 'The investigation concludes that'],\n};\n\nconst TRANSITION_PHRASES = [\n  'Meanwhile,',\n  'Subsequently,',\n  'Following this,',\n  'As events continued,',\n  'In the aftermath,',\n  'This led to',\n  'Building upon this,',\n  'Concurrently,',\n];\n\n// ============================================================================\n// Helper Functions\n// ============================================================================\n\nfunction pickRandom<T>(arr: T[]): T {\n  return arr[Math.floor(Math.random() * arr.length)];\n}\n\nfunction calculateEventImportance(\n  event: TimelineEvent,\n  allEvents: TimelineEvent[]\n): 'major' | 'minor' | 'transitional' {\n  const confidence = event.confidence ?? 0.5;\n\n  // High confidence events are major\n  if (confidence >= 0.8) return 'major';\n\n  // Events with specific types are more important\n  if (['event', 'fact', 'evidence'].includes(event.findingType)) {\n    return confidence >= 0.5 ? 'major' : 'minor';\n  }\n\n  // Gaps and patterns are transitional\n  if (['gap', 'pattern'].includes(event.findingType)) {\n    return 'transitional';\n  }\n\n  return confidence >= 0.6 ? 'minor' : 'transitional';\n}\n\nfunction calculateEventDuration(event: StoryEvent): number {\n  const summaryLength = event.summary.length;\n  const baseFromLength = Math.min(MAX_EVENT_DURATION, Math.max(MIN_EVENT_DURATION, summaryLength / 30));\n\n  // Adjust based on importance\n  const importanceMultiplier =\n    event.importance === 'major' ? 1.3 :\n    event.importance === 'minor' ? 1 : 0.8;\n\n  return Math.round(baseFromLength * importanceMultiplier);\n}\n\nfunction generateEventNarration(event: TimelineEvent, isFirst: boolean, isTransition: boolean): string {\n  const intros = FINDING_TYPE_INTROS[event.findingType] ?? FINDING_TYPE_INTROS.fact;\n  let prefix = '';\n\n  if (isFirst) {\n    prefix = 'Our story begins when ';\n  } else if (isTransition) {\n    prefix = pickRandom(TRANSITION_PHRASES) + ' ';\n  } else {\n    prefix = pickRandom(intros) + ' ';\n  }\n\n  // Clean up the summary for narration\n  let narration = event.summary\n    .replace(/\\s+/g, ' ')\n    .trim();\n\n  // Ensure it ends with proper punctuation\n  if (!/[.!?]$/.test(narration)) {\n    narration += '.';\n  }\n\n  return prefix + narration;\n}\n\nfunction generateContextPoints(event: TimelineEvent): string[] {\n  const points: string[] = [];\n\n  if (event.confidence !== undefined) {\n    const confPercent = Math.round(event.confidence * 100);\n    if (confPercent >= 80) {\n      points.push('High confidence finding');\n    } else if (confPercent >= 50) {\n      points.push('Moderate confidence');\n    } else {\n      points.push('Requires verification');\n    }\n  }\n\n  // Add date context\n  const eventDate = new Date(event.date);\n  points.push(eventDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }));\n\n  // Add type-specific context\n  switch (event.findingType) {\n    case 'fact':\n      points.push('Verified fact');\n      break;\n    case 'claim':\n      points.push('Unverified claim');\n      break;\n    case 'event':\n      points.push('Key event');\n      break;\n    case 'pattern':\n      points.push('Pattern identified');\n      break;\n    case 'gap':\n      points.push('Information gap');\n      break;\n  }\n\n  return points;\n}\n\n// ============================================================================\n// Chapter Detection\n// ============================================================================\n\nfunction detectChapters(events: TimelineEvent[]): Array<{ start: number; end: number; mood: StoryChapter['mood'] }> {\n  if (events.length === 0) return [];\n  if (events.length <= 3) {\n    return [{ start: 0, end: events.length - 1, mood: 'neutral' }];\n  }\n\n  const chapters: Array<{ start: number; end: number; mood: StoryChapter['mood'] }> = [];\n  const targetChapterSize = Math.max(3, Math.ceil(events.length / 4));\n\n  let chapterStart = 0;\n  let lastDate = new Date(events[0].date);\n\n  for (let i = 1; i < events.length; i++) {\n    const currentDate = new Date(events[i].date);\n    const daysDiff = (currentDate.getTime() - lastDate.getTime()) / (1000 * 60 * 60 * 24);\n    const eventsInChapter = i - chapterStart;\n\n    // Create new chapter if:\n    // 1. Large time gap (more than 30 days)\n    // 2. We've accumulated enough events\n    const shouldSplit = daysDiff > 30 || eventsInChapter >= targetChapterSize;\n\n    if (shouldSplit && eventsInChapter >= 2) {\n      // Determine mood based on event types in this chapter\n      const chapterEvents = events.slice(chapterStart, i);\n      const mood = determineMood(chapterEvents);\n\n      chapters.push({ start: chapterStart, end: i - 1, mood });\n      chapterStart = i;\n    }\n\n    lastDate = currentDate;\n  }\n\n  // Add final chapter\n  if (chapterStart < events.length) {\n    const finalEvents = events.slice(chapterStart);\n    const mood = chapters.length === 0 ? 'neutral' : 'conclusion';\n    chapters.push({ start: chapterStart, end: events.length - 1, mood });\n  }\n\n  return chapters;\n}\n\nfunction determineMood(events: TimelineEvent[]): StoryChapter['mood'] {\n  const types = events.map((e) => e.findingType);\n\n  if (types.includes('gap') || types.filter((t) => t === 'claim').length > types.length / 2) {\n    return 'tension';\n  }\n\n  if (types.includes('evidence') || types.filter((t) => t === 'fact').length > types.length / 2) {\n    return 'revelation';\n  }\n\n  if (types.includes('pattern')) {\n    return 'resolution';\n  }\n\n  return 'neutral';\n}\n\nfunction generateChapterTitle(events: TimelineEvent[], chapterIndex: number, totalChapters: number): string {\n  if (chapterIndex === 0) return 'The Beginning';\n  if (chapterIndex === totalChapters - 1) return 'Conclusion';\n\n  const startDate = new Date(events[0].date);\n  const endDate = new Date(events[events.length - 1].date);\n\n  // Try to generate a meaningful title from the events\n  const eventTypes = new Set(events.map((e) => e.findingType));\n\n  if (eventTypes.has('event')) {\n    return `Key Developments`;\n  }\n  if (eventTypes.has('evidence')) {\n    return `Evidence Emerges`;\n  }\n  if (eventTypes.has('pattern')) {\n    return `Patterns Revealed`;\n  }\n  if (eventTypes.has('gap')) {\n    return `Questions Arise`;\n  }\n\n  // Default to date-based title\n  const monthYear = startDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });\n  return `Chapter ${chapterIndex + 1}: ${monthYear}`;\n}\n\nfunction generateChapterDescription(events: TimelineEvent[], mood: StoryChapter['mood']): string {\n  const prefix = pickRandom(CHAPTER_MOOD_PHRASES[mood]);\n  const eventCount = events.length;\n\n  if (eventCount === 1) {\n    return `${prefix} a significant development shapes the narrative.`;\n  }\n\n  return `${prefix} ${eventCount} key moments unfold, revealing new insights.`;\n}\n\n// ============================================================================\n// Main Script Generation\n// ============================================================================\n\n/**\n * Generate a complete story script from timeline events\n */\nexport function generateStoryScript(\n  events: TimelineEvent[],\n  title?: string\n): StoryScript {\n  if (events.length === 0) {\n    return {\n      title: title ?? 'Research Timeline',\n      introduction: 'No events to narrate.',\n      chapters: [],\n      conclusion: '',\n      totalDuration: 0,\n      events: [],\n    };\n  }\n\n  // Sort events by date\n  const sortedEvents = [...events].sort(\n    (a, b) => new Date(a.date).getTime() - new Date(b.date).getTime()\n  );\n\n  // Detect chapters\n  const chapterRanges = detectChapters(sortedEvents);\n\n  // Generate story events with narration\n  const storyEvents: StoryEvent[] = [];\n  let currentTime = 0;\n\n  // Introduction duration\n  currentTime += 5;\n\n  // Process each event\n  sortedEvents.forEach((event, index) => {\n    const isFirst = index === 0;\n    const importance = calculateEventImportance(event, sortedEvents);\n\n    // Find which chapter this event belongs to\n    const chapterRange = chapterRanges.find(\n      (c) => index >= c.start && index <= c.end\n    );\n    const chapterIndex = chapterRanges.indexOf(chapterRange!);\n\n    // Determine if this is a transition point\n    const isTransition =\n      index > 0 &&\n      chapterRanges.findIndex((c) => c.start === index) >= 0;\n\n    const storyEvent: StoryEvent = {\n      ...event,\n      narration: generateEventNarration(event, isFirst, isTransition),\n      duration: 0, // Will be calculated\n      chapter: generateChapterTitle(\n        sortedEvents.slice(chapterRange!.start, chapterRange!.end + 1),\n        chapterIndex,\n        chapterRanges.length\n      ),\n      chapterIndex,\n      importance,\n      contextPoints: generateContextPoints(event),\n    };\n\n    storyEvent.duration = calculateEventDuration(storyEvent);\n    storyEvents.push(storyEvent);\n  });\n\n  // Build chapters\n  const chapters: StoryChapter[] = chapterRanges.map((range, index) => {\n    const chapterEvents = storyEvents.slice(range.start, range.end + 1);\n    const title = generateChapterTitle(\n      sortedEvents.slice(range.start, range.end + 1),\n      index,\n      chapterRanges.length\n    );\n\n    // Calculate chapter timing\n    const chapterStartTime = currentTime;\n    currentTime += CHAPTER_INTRO_DURATION;\n\n    chapterEvents.forEach((event, eventIndex) => {\n      currentTime += event.duration;\n      if (eventIndex < chapterEvents.length - 1) {\n        currentTime += TRANSITION_DURATION;\n      }\n    });\n\n    return {\n      id: `chapter-${index}`,\n      title,\n      description: generateChapterDescription(\n        sortedEvents.slice(range.start, range.end + 1),\n        range.mood\n      ),\n      startTime: chapterStartTime,\n      endTime: currentTime,\n      events: chapterEvents,\n      mood: range.mood,\n    };\n  });\n\n  // Generate introduction\n  const firstDate = new Date(sortedEvents[0].date);\n  const lastDate = new Date(sortedEvents[sortedEvents.length - 1].date);\n  const introduction = generateIntroduction(\n    title ?? 'Research Timeline',\n    firstDate,\n    lastDate,\n    sortedEvents.length\n  );\n\n  // Generate conclusion\n  const conclusion = generateConclusion(sortedEvents, chapters);\n\n  // Add conclusion duration\n  currentTime += 5;\n\n  return {\n    title: title ?? 'Research Timeline',\n    introduction,\n    chapters,\n    conclusion,\n    totalDuration: currentTime,\n    events: storyEvents,\n  };\n}\n\nfunction generateIntroduction(\n  title: string,\n  startDate: Date,\n  endDate: Date,\n  eventCount: number\n): string {\n  const dateRange = formatDateRange(startDate, endDate);\n  return `Welcome to ${title}. This narrative covers ${eventCount} key events spanning ${dateRange}. Let's explore the timeline and uncover the story within the data.`;\n}\n\nfunction generateConclusion(events: TimelineEvent[], chapters: StoryChapter[]): string {\n  const majorEvents = events.filter((e) => (e.confidence ?? 0) >= 0.7);\n  const patterns = events.filter((e) => e.findingType === 'pattern');\n  const gaps = events.filter((e) => e.findingType === 'gap');\n\n  let conclusion = 'In summary, this timeline reveals ';\n\n  if (majorEvents.length > 0) {\n    conclusion += `${majorEvents.length} significant findings`;\n  } else {\n    conclusion += `${events.length} events`;\n  }\n\n  if (patterns.length > 0) {\n    conclusion += ` and ${patterns.length} identified patterns`;\n  }\n\n  conclusion += '.';\n\n  if (gaps.length > 0) {\n    conclusion += ` ${gaps.length} areas require further investigation.`;\n  }\n\n  conclusion += ' Thank you for exploring this research narrative.';\n\n  return conclusion;\n}\n\nfunction formatDateRange(start: Date, end: Date): string {\n  const startStr = start.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });\n  const endStr = end.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });\n\n  if (startStr === endStr) {\n    return startStr;\n  }\n\n  return `from ${startStr} to ${endStr}`;\n}\n\n// ============================================================================\n// Playback Utilities\n// ============================================================================\n\n/**\n * Get the current event based on playback time\n */\nexport function getCurrentEvent(\n  script: StoryScript,\n  currentTime: number\n): StoryEvent | null {\n  let accumulatedTime = 5; // Introduction\n\n  for (const chapter of script.chapters) {\n    accumulatedTime += CHAPTER_INTRO_DURATION;\n\n    for (let i = 0; i < chapter.events.length; i++) {\n      const event = chapter.events[i];\n      const eventEndTime = accumulatedTime + event.duration;\n\n      if (currentTime >= accumulatedTime && currentTime < eventEndTime) {\n        return event;\n      }\n\n      accumulatedTime = eventEndTime;\n      if (i < chapter.events.length - 1) {\n        accumulatedTime += TRANSITION_DURATION;\n      }\n    }\n  }\n\n  return null;\n}\n\n/**\n * Get the current chapter based on playback time\n */\nexport function getCurrentChapter(\n  script: StoryScript,\n  currentTime: number\n): StoryChapter | null {\n  for (const chapter of script.chapters) {\n    if (currentTime >= chapter.startTime && currentTime < chapter.endTime) {\n      return chapter;\n    }\n  }\n  return null;\n}\n\n/**\n * Get chapter markers for the progress bar\n */\nexport function getChapterMarkers(script: StoryScript): ChapterMarker[] {\n  return script.chapters.map((chapter) => ({\n    id: chapter.id,\n    title: chapter.title,\n    time: chapter.startTime,\n    percentage: (chapter.startTime / script.totalDuration) * 100,\n  }));\n}\n\n/**\n * Calculate progress percentage\n */\nexport function getProgress(currentTime: number, totalDuration: number): number {\n  if (totalDuration === 0) return 0;\n  return Math.min(100, Math.max(0, (currentTime / totalDuration) * 100));\n}\n\n/**\n * Format time for display (MM:SS)\n */\nexport function formatTime(seconds: number): string {\n  const mins = Math.floor(seconds / 60);\n  const secs = Math.floor(seconds % 60);\n  return `${mins}:${secs.toString().padStart(2, '0')}`;\n}\n\n/**\n * Get playback state for a specific time\n */\nexport function getPlaybackStateAtTime(\n  script: StoryScript,\n  time: number\n): { phase: 'intro' | 'chapter-intro' | 'event' | 'transition' | 'conclusion'; eventIndex: number; chapterIndex: number } {\n  if (time < 5) {\n    return { phase: 'intro', eventIndex: -1, chapterIndex: -1 };\n  }\n\n  if (time >= script.totalDuration - 5) {\n    return {\n      phase: 'conclusion',\n      eventIndex: script.events.length - 1,\n      chapterIndex: script.chapters.length - 1,\n    };\n  }\n\n  let accumulatedTime = 5;\n\n  for (let ci = 0; ci < script.chapters.length; ci++) {\n    const chapter = script.chapters[ci];\n\n    if (time < accumulatedTime + CHAPTER_INTRO_DURATION) {\n      return { phase: 'chapter-intro', eventIndex: -1, chapterIndex: ci };\n    }\n\n    accumulatedTime += CHAPTER_INTRO_DURATION;\n\n    for (let ei = 0; ei < chapter.events.length; ei++) {\n      const event = chapter.events[ei];\n      const eventEndTime = accumulatedTime + event.duration;\n\n      if (time < eventEndTime) {\n        return { phase: 'event', eventIndex: ei, chapterIndex: ci };\n      }\n\n      accumulatedTime = eventEndTime;\n\n      if (ei < chapter.events.length - 1) {\n        if (time < accumulatedTime + TRANSITION_DURATION) {\n          return { phase: 'transition', eventIndex: ei, chapterIndex: ci };\n        }\n        accumulatedTime += TRANSITION_DURATION;\n      }\n    }\n  }\n\n  return { phase: 'conclusion', eventIndex: script.events.length - 1, chapterIndex: script.chapters.length - 1 };\n}\n","numLines":663,"startLine":1,"totalLines":663}}}
