abel: string;\n  data: ResearchFinding | KnowledgeEntity | ResearchSource;\n  x?: number;\n  y?: number;\n  pinned?: boolean;\n}\n\nexport interface GraphEdge {\n  id: string;\n  source: string;\n  target: string;\n  type: RelationshipType;\n  strength: number;\n  label?: string;","numLines":30,"startLine":430,"totalLines":545}}}
