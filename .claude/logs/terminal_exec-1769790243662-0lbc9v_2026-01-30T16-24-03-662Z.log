ting SankeyDiagram component"},{"content":"Create EditableCausalChain component","status":"pending","activeForm":"Creating EditableCausalChain component"},{"content":"Create ChainStepEditor component","status":"pending","activeForm":"Creating ChainStepEditor component"},{"content":"Create WhatIfControls component","status":"pending","activeForm":"Creating WhatIfControls component"},{"content":"Create ImpactPropagation component","status":"pending","activeForm":"Creating ImpactPropagation component"},{"content":"Create ChainComparator component","status":"pending","activeForm":"Creating ChainComparator component"},{"content":"Create flow visualizations index","status":"pending","activeForm":"Creating flow visualizations index"},{"content":"Verify TypeScript compilation","status":"pending","activeForm":"Verifying TypeScript compilation"}]}}
