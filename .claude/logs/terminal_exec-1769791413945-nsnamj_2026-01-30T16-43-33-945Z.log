\n    41→        return false;\n    42→      }\n    43→      return true;\n    44→    });\n    45→  }, [findings, searchQuery, filterType, filterConfidence]);\n    46→\n    47→  const sourceMap = useMemo(() => {\n    48→    const map = new Map<string, ResearchSource>();\n    49→    sources.forEach((s) => map.set(s.id, s));\n    50→    return map;\n    51→  }, [sources]);\n    52→\n    53→  // Reset focus when filters change\n    54→  useEffect(() => {\n    55→    setFocusedIndex(-1);\n    56→  }, [searchQuery, filterType, filterConfidence]);\n    57→\n    58→  const toggleExpanded = useCallback((id: string) => {\n    59→    setExpandedIds((prev) => {\n    60→      const next = new Set(prev);\n    61→      if (next.has(id)) {\n    62→        next.delete(id);\n    63→      } else {\n    64→        next.add(id);\n    65→      }\n    66→      return next;\n    67→    });\n    68→  }, []);\n    69→\n    70→  const scrollToFinding = useCallback((index: number) => {\n    71→    const el = findingRefs.current.get(index);\n    72→    if (el) {\n    73→      el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });\n    74→    }\n    75→  }, []);\n    76→\n    77→  // Keyboard navigation\n    78→  useEffect(() => {\n    79→    const handleKeyDown = (e: KeyboardEvent) => {\n    80→      // Only handle if container or its children have focus, or no specific element is focused\n    81→      const activeElement = document.activeElement;\n    82→      const isInContainer = containerRef.current?.contains(activeElement);\n    83→      const isBodyFocused = activeElement === document.body;\n    84→\n    85→      if (!isInContainer && !isBodyFocused) return;\n    86→\n    87→      // Don't interfere with input fields\n    88→      if (activeElement?.tagName === 'INPUT' || activeElement?.tagName === 'TEXTAREA') return;\n    89→\n    90→      switch (e.key) {\n    91→        case 'j':\n    92→        case 'ArrowDown':\n    93→          e.preventDefault();\n    94→          setFocused