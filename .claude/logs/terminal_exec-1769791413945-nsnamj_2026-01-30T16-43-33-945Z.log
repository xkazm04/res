0→        isFocused\n   191→          ? 'border-blue-400 ring-2 ring-blue-100 shadow-sm'\n   192→          : 'border-slate-200'\n   193→      }`}\n   194→      onClick={onFocus}\n   195→    >\n   196→      {/* Header - always visible */}\n   197→      <div\n   198→        className={`flex items-center gap-3 px-4 py-3 cursor-pointer transition-colors ${\n   199→          isFocused ? 'bg-blue-50/50 hover:bg-blue-50' : 'bg-slate-50/50 hover:bg-slate-50'\n   200→        }`}\n   201→        onClick={onToggleExpanded}\n   202→      >\n   203→        <span className={`w-5 h-5 transition-transform ${isFocused ? 'text-blue-500' : 'text-slate-400'} ${isExpanded ? 'rotate-90' : ''}`}>\n   204→          <ChevronRightIcon />\n   205→        </span>\n   206→        <TypeBadge type={finding.finding_type} />\n   207→        <span className=\"flex-1 text-sm text-slate-700 line-clamp-1\">{summary}</span>\n   208→        <ConfidenceBadge score={confidence} />\n   209→      </div>\n   210→\n   211→      {/* Body - expandable */}\n   212→      {isExpanded && (\n   213→        <div className=\"px-4 py-3 border-t border-slate-100\">\n   214→          {/* Full content */}\n   215→          <p className=\"text-sm text-slate-700 leading-relaxed mb-3\">{finding.content}</p>\n   216→\n   217→          {/* Meta row */}\n   218→          <div className=\"flex flex-wrap items-center gap-3 text-xs text-slate-500 mb-3\">\n   219→            {finding.temporal_context && (\n   220→              <span className=\"flex items-center gap-1\">\n   221→                <span className=\"w-3.5 h-3.5\"><ClockIcon /></span>\n   222→                {finding.temporal_context}\n   223→                {finding.event_date && ` • ${new Date(finding.event_date).toLocaleDateString()}`}\n   224→              </span>\n   225→            )}\n   226→            <span className=\"flex items-center gap-1\">\n   227→              Confidence:\n   228→              <span className=\"w-16\"><ProgressBar value={confidence * 100}