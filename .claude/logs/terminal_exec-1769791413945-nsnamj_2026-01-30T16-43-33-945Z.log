  49→  title,\n    50→  description,\n    51→  variant,\n    52→  icon,\n    53→}: {\n    54→  title: string;\n    55→  description: string;\n    56→  variant: AlertVariant;\n    57→  icon?: ReactNode;\n    58→}) {\n    59→  const { getAlert } = useThemedColors();\n    60→\n    61→  return (\n    62→    <div className={`border rounded-lg p-3 ${getAlert(variant)}`}>\n    63→      <div className=\"flex items-center gap-2 font-semibold text-xs mb-1\">\n    64→        {icon && <span className=\"w-3.5 h-3.5\">{icon}</span>}\n    65→        {title}\n    66→      </div>\n    67→      <p className=\"text-[10px] opacity-80\">{description}</p>\n    68→    </div>\n    69→  );\n    70→}\n    71→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"bb700aba-f9fc-4283-93cf-561e37220b63","uuid":"f8ad189e-cbd7-4cea-a0a4-955b9dc35116","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\shared\\Cards.tsx","content":"'use client';\n\nimport { type ReactNode } from 'react';\nimport { useThemedColors, type CardColor, type AlertVariant, progressColors } from './themeColors';\n\n// Quick stat card - theme-aware with centralized colors\nexport function QuickStatCard({\n  label,\n  value,\n  subtext,\n  progress,\n  icon,\n  color,\n  children,\n}: {\n  label: string;\n  value: string | number;\n  subtext?: string;\n  progress?: number;\n  icon: ReactNode;\n  color: CardColor;\n  children?: ReactNode;\n}) {\n  const { getCard, getProgressBg, getProgressColor } = useThemedColors();\n\n  return (\n    <div className={`rounded-lg border p-3 ${getCard(color)}`}>\n      <div className=\"flex items-center justify-between mb-1\">\n        <span className=\"w-4 h-4 opacity-60\">{icon}</span>\n        <span className=\"text-[9px] uppercase tracking-wider opacity-60\">{label}</span>\n      </div>\n      <div className=\"text-xl font-bold\">{value}</div>\n      {subtext && <div className=\"text-[10px] opacity-70 mt-0.5\">{subtext}</div>}\n      {progress !== undefined && (\n        <div className={`h-1 ${getProgressBg()} rounded-full mt-2 overflow-hidden`}>\n          <div\n            className={`h-full rounded-full ${getProgressColor(color)}`}\n            style={{ width: `${progress}%` }}\n          />\n        </div>\n      )}\n      {children && <div className=\"mt-2\">{children}</div>}\n    </div>\n  );\n}\n\n// Alert banner - theme-aware with centralized colors\nexport function AlertBanner({\n  title,\n  description,\n  variant,\n  icon,\n}: {\n  title: string;\n  description: string;\n  variant: AlertVariant;\n  icon?: ReactNode;\n}) {\n  const { getAlert } = useThemedColors();\n\n  return (\n    <div className={`border rounded-lg p-3 ${getAlert(variant)}`}>\n      <div className=\"flex items-center gap-2 font-semibold text-xs mb-1\">\n        {icon && <span className=\"w-3.5 h-3.5\">{icon}</span>}\n        {title}\n      </div>\n      <p className=\"text-[10px] opacity-80\">{description}</p>\n    </div>\n  );\n}\n","numLines":71,"startLine":1,"totalLines":71}}}
