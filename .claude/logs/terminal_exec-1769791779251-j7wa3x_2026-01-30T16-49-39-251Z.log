[2026-01-30T16:50:07.719Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018M7wXQAhBy5aP2L1J3z8Wz","type":"tool_result","content":"     1→'use client';\n     2→\n     3→import { motion, AnimatePresence } from 'framer-motion';\n     4→import { type ReactNode, useId } from 'react';\n     5→import { useReportTheme, useThemeStyles } from './core/ThemeContext';\n     6→import { useFocusTrap } from '@/src/hooks/useFocusTrap';\n     7→\n     8→interface ReportShellProps {\n     9→  children: ReactNode;\n    10→  onClose: () => void;\n    11→  /** ID for aria-labelledby reference (optional) */\n    12→  titleId?: string;\n    13→}\n    14→\n    15→export function ReportShell({ children, onClose, titleId }: ReportShellProps) {\n    16→  const { theme } = useReportTheme();\n    17→  const styles = useThemeStyles();\n    18→  const generatedTitleId = useId();\n    19→  const dialogTitleId = titleId || `report-dialog-${generatedTitleId}`;\n    20→\n    21→  // Focus trap for accessibility - contains tab navigation within modal\n    22→  const focusTrapRef = useFocusTrap<HTMLDivElement>({ enabled: true });\n    23→\n    24→  // Note: Escape key handling is centralized in ReportModal.tsx to avoid duplicate listeners\n    25→\n    26→  return (\n    27→    <AnimatePresence>\n    28→      <motion.div\n    29→        initial={{ opacity: 0 }}\n    30→        animate={{ opacity: 1 }}\n    31→        exit={{ opacity: 0 }}\n    32→        className=\"fixed inset-0 z-50 flex\"\n    33→        role=\"presentation\"\n    34→      >\n    35→        {/* Backdrop - staged cinematic reveal: fade → blur → content */}\n    36→        <motion.div\n    37→          initial={{ opacity: 0, backdropFilter: 'blur(0px)' }}\n    38→          animate={{\n    39→            opacity: 1,\n    40→            backdropFilter: 'blur(8px)',\n    41→          }}\n    42→          transition={{\n    43→            opacity: { duration: 0.15, ease: 'easeOut' },\n    44→            backdropFilter: { duration: 0.2, delay: 0.15, ease: 'easeOut' },\n    45→          }}\n    46→          className={`absolute inset-0 ${theme === 'radar' ? 'bg-black/50' : 'bg-stone-900/50'}`}\n    47→          style={{ WebkitBackdropFilter: 'blur(8px)' }}\n    48→          onClick={onClose}\n    49→          aria-hidden=\"true\"\n    50→        />\n    51→\n    52→        {/* Dialog content with focus trap and ARIA attributes - scales in after backdrop blur */}\n    53→        <motion.div\n    54→          ref={focusTrapRef}\n    55→          initial={{ opacity: 0, scale: 0.92, y: 30 }}\n    56→          animate={{ opacity: 1, scale: 1, y: 0 }}\n    57→          transition={{\n    58→            type: 'spring',\n    59→            damping: 28,\n    60→            stiffness: 350,\n    61→            delay: 0.35, // Wait for backdrop fade (150ms) + blur (200ms)\n    62→          }}\n    63→          className={`relative z-10 flex flex-1 m-4 rounded-2xl overflow-hidden ${styles.bgCard} ${styles.border} border`}\n    64→          role=\"dialog\"\n    65→          aria-modal=\"true\"\n    66→          aria-labelledby={dialogTitleId}\n    67→          tabIndex={-1}\n    68→        >\n    69→          {/* Hidden title for screen readers only when no visible title ID is provided */}\n    70→          {!titleId && <span id={dialogTitleId} className=\"sr-only\">Research Intelligence Report</span>}\n    71→          {theme === 'radar' && <RadarAmbience />}\n    72→          {children}\n    73→        </motion.div>\n    74→      </motion.div>\n    75→    </AnimatePresence>\n    76→  );\n    77→}\n    78→\n    79→// Ambient effects for Radar theme\n    80→function RadarAmbience() {\n    81→  return (\n    82→    <>\n    83→      {/* Gradient overlay */}\n    84→      <div className=\"absolute inset-0 bg-gradient-to-br from-cyan-500/5 via-transparent to-blue-500/5 pointer-events-none\" />\n    85→\n    86→      {/* Scan line effect */}\n    87→      <motion.div\n    88→        className=\"absolute inset-0 pointer-events-none overflow-hidden\"\n    89→        initial={{ opacity: 0.3 }}\n    90→      >\n    91→        <motion.div\n    92→          className=\"absolute left-0 right-0 h-px bg-gradient-to-r from-transparent via-cyan-400/50 to-transparent\"\n    93→          animate={{ top: ['0%', '100%'] }}\n    94→          transition={{ duration: 8, repeat: Infinity, ease: 'linear' }}\n    95→        />\n    96→      </motion.div>\n    97→\n    98→      {/* Corner accents */}\n    99→      <div className=\"absolute top-0 left-0 w-20 h-20 border-l-2 border-t-2 border-cyan-500/30 rounded-tl-2xl pointer-events-none\" />\n   100→      <div className=\"absolute bottom-0 right-0 w-20 h-20 border-r-2 border-b-2 border-cyan-500/30 rounded-br-2xl pointer-events-none\" />\n   101→    </>\n   102→  );\n   103→}\n   104→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"bb700aba-f9fc-4283-93cf-561e37220b63","uuid":"68177761-a328-4a06-b861-d27b370f358d","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\ReportShell.tsx","content":"'use client';\n\nimport { motion, AnimatePresence } from 'framer-motion';\nimport { type ReactNode, useId } from 'react';\nimport { useReportTheme, useThemeStyles } from './core/ThemeContext';\nimport { useFocusTrap } from '@/src/hooks/useFocusTrap';\n\ninterface ReportShellProps {\n  children: ReactNode;\n  onClose: () => void;\n  /** ID for aria-labelledby reference (optional) */\n  titleId?: string;\n}\n\nexport function ReportShell({ children, onClose, titleId }: ReportShellProps) {\n  const { theme } = useReportTheme();\n  const styles = useThemeStyles();\n  const generatedTitleId = useId();\n  const dialogTitleId = titleId || `report-dialog-${generatedTitleId}`;\n\n  // Focus trap for accessibility - contains tab navigation within modal\n  const focusTrapRef = useFocusTrap<HTMLDivElement>({ enabled: true });\n\n  // Note: Escape key handling is centralized in ReportModal.tsx to avoid duplicate listeners\n\n  return (\n    <AnimatePresence>\n      <motion.div\n        initial={{ opacity: 0 }}\n        animate={{ opacity: 1 }}\n        exit={{ opacity: 0 }}\n        className=\"fixed inset-0 z-50 flex\"\n        role=\"presentation\"\n      >\n        {/* Backdrop - staged cinematic reveal: fade → blur → content */}\n        <motion.div\n          initial={{ opacity: 0, backdropFilter: 'blur(0px)' }}\n          animate={{\n            opacity: 1,\n            backdropFilter: 'blur(8px)',\n          }}\n          transition={{\n            opacity: { duration: 0.15, ease: 'easeOut' },\n            backdropFilter: { duration: 0.2, delay: 0.15, ease: 'easeOut' },\n          }}\n          className={`absolute inset-0 ${theme === 'radar' ? 'bg-black/50' : 'bg-stone-900/50'}`}\n          style={{ WebkitBackdropFilter: 'blur(8px)' }}\n          onClick={onClose}\n          aria-hidden=\"true\"\n        />\n\n        {/* Dialog content with focus trap and ARIA attributes - scales in after backdrop blur */}\n        <motion.div\n          ref={focusTrapRef}\n          initial={{ opacity: 0, scale: 0.92, y: 30 }}\n          animate={{ opacity: 1, scale: 1, y: 0 }}\n          transition={{\n            type: 'spring',\n            damping: 28,\n            stiffness: 350,\n            delay: 0.35, // Wait for backdrop fade (150ms) + blur (200ms)\n          }}\n          className={`relative z-10 flex flex-1 m-4 rounded-2xl overflow-hidden ${styles.bgCard} ${styles.border} border`}\n          role=\"dialog\"\n          aria-modal=\"true\"\n          aria-labelledby={dialogTitleId}\n          tabIndex={-1}\n        >\n          {/* Hidden title for screen readers only when no visible title ID is provided */}\n          {!titleId && <span id={dialogTitleId} className=\"sr-only\">Research Intelligence Report</span>}\n          {theme === 'radar' && <RadarAmbience />}\n          {children}\n        </motion.div>\n      </motion.div>\n    </AnimatePresence>\n  );\n}\n\n// Ambient effects for Radar theme\nfunction RadarAmbience() {\n  return (\n    <>\n      {/* Gradient overlay */}\n      <div className=\"absolute inset-0 bg-gradient-to-br from-cyan-500/5 via-transparent to-blue-500/5 pointer-events-none\" />\n\n      {/* Scan line effect */}\n      <motion.div\n        className=\"absolute inset-0 pointer-events-none overflow-hidden\"\n        initial={{ opacity: 0.3 }}\n      >\n        <motion.div\n          className=\"absolute left-0 right-0 h-px bg-gradient-to-r from-transparent via-cyan-400/50 to-transparent\"\n          animate={{ top: ['0%', '100%'] }}\n          transition={{ duration: 8, repeat: Infinity, ease: 'linear' }}\n        />\n      </motion.div>\n\n      {/* Corner accents */}\n      <div className=\"absolute top-0 left-0 w-20 h-20 border-l-2 border-t-2 border-cyan-500/30 rounded-tl-2xl pointer-events-none\" />\n      <div className=\"absolute bottom-0 right-0 w-20 h-20 border-r-2 border-b-2 border-cyan-500/30 rounded-br-2xl pointer-events-none\" />\n    </>\n  );\n}\n","numLines":104,"startLine":1,"totalLines":104}}}
