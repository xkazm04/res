[2026-01-30T16:58:40.435Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KVVxHTjbCyci2ShkDno3R4","type":"tool_result","content":"     1→'use client';\n     2→\n     3→// Badge Components for Report Display\n     4→// Uses centralized theme colors from themeColors.ts\n     5→\n     6→import { useThemedColors } from './themeColors';\n     7→import { getConfidenceLevel, confidenceBadgeColors, confidenceBadgeColorsDark, credibilityBadgeColors, credibilityBadgeColorsDark } from './typeConfig';\n     8→\n     9→export function TypeBadge({ type }: { type: string }) {\n    10→  const { getFindingType } = useThemedColors();\n    11→\n    12→  return (\n    13→    <span className={`inline-block px-2 py-0.5 rounded text-[10px] font-semibold uppercase ${getFindingType(type)}`}>\n    14→      {type.replace('_', ' ')}\n    15→    </span>\n    16→  );\n    17→}\n    18→\n    19→export function SourceTypeBadge({ type }: { type: string }) {\n    20→  const { getSourceType } = useThemedColors();\n    21→\n    22→  return (\n    23→    <span className={`inline-block px-2 py-0.5 rounded text-[10px] font-semibold uppercase ${getSourceType(type)}`}>\n    24→      {type}\n    25→    </span>\n    26→  );\n    27→}\n    28→\n    29→/**\n    30→ * Unified score badge component for confidence and credibility scores.\n    31→ * @param score - Score as 0-1 decimal\n    32→ * @param variant - 'confidence' uses slate for low, 'credibility' uses red for low\n    33→ * @param label - Optional label to display instead of percentage\n    34→ */\n    35→export function ScoreBadge({\n    36→  score,\n    37→  variant = 'confidence',\n    38→  label,\n    39→}: {\n    40→  score: number;\n    41→  variant?: 'confidence' | 'credibility';\n    42→  label?: string;\n    43→}) {\n    44→  const { isRadar } = useThemedColors();\n    45→  const pct = Math.round(score * 100);\n    46→  const level = getConfidenceLevel(score);\n    47→\n    48→  const colors = variant === 'credibility'\n    49→    ? (isRadar ? credibilityBadgeColorsDark : credibilityBadgeColors)\n    50→    : (isRadar ? confidenceBadgeColorsDark : confidenceBadgeColors);\n    51→\n    52→  return (\n    53→    <span className={`inline-block px-2 py-0.5 rounded-full text-[10px] font-semibold ${colors[level]}`}>\n    54→      {label ?? `${pct}%`}\n    55→    </span>\n    56→  );\n    57→}\n    58→\n    59→// Backward-compatible aliases\n    60→export function ConfidenceBadge({ score }: { score: number }) {\n    61→  return <ScoreBadge score={score} variant=\"confidence\" />;\n    62→}\n    63→\n    64→export function CredibilityBadge({ score }: { score: number }) {\n    65→  return <ScoreBadge score={score} variant=\"credibility\" />;\n    66→}\n    67→\n    68→export function PriorityBadge({ priority }: { priority: string }) {\n    69→  const { getPriority } = useThemedColors();\n    70→\n    71→  return (\n    72→    <span className={`inline-block px-2 py-0.5 rounded text-[10px] font-semibold uppercase ${getPriority(priority)}`}>\n    73→      {priority}\n    74→    </span>\n    75→  );\n    76→}\n    77→\n    78→export function StatusBadge({ status }: { status: string }) {\n    79→  const { getStatus } = useThemedColors();\n    80→\n    81→  return (\n    82→    <span className={`inline-block px-2 py-0.5 rounded text-[10px] font-semibold uppercase ${getStatus(status)}`}>\n    83→      {status}\n    84→    </span>\n    85→  );\n    86→}\n    87→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"bb700aba-f9fc-4283-93cf-561e37220b63","uuid":"b8c551cd-ad5a-4d33-b362-60dcaf042045","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\shared\\Badges.tsx","content":"'use client';\n\n// Badge Components for Report Display\n// Uses centralized theme colors from themeColors.ts\n\nimport { useThemedColors } from './themeColors';\nimport { getConfidenceLevel, confidenceBadgeColors, confidenceBadgeColorsDark, credibilityBadgeColors, credibilityBadgeColorsDark } from './typeConfig';\n\nexport function TypeBadge({ type }: { type: string }) {\n  const { getFindingType } = useThemedColors();\n\n  return (\n    <span className={`inline-block px-2 py-0.5 rounded text-[10px] font-semibold uppercase ${getFindingType(type)}`}>\n      {type.replace('_', ' ')}\n    </span>\n  );\n}\n\nexport function SourceTypeBadge({ type }: { type: string }) {\n  const { getSourceType } = useThemedColors();\n\n  return (\n    <span className={`inline-block px-2 py-0.5 rounded text-[10px] font-semibold uppercase ${getSourceType(type)}`}>\n      {type}\n    </span>\n  );\n}\n\n/**\n * Unified score badge component for confidence and credibility scores.\n * @param score - Score as 0-1 decimal\n * @param variant - 'confidence' uses slate for low, 'credibility' uses red for low\n * @param label - Optional label to display instead of percentage\n */\nexport function ScoreBadge({\n  score,\n  variant = 'confidence',\n  label,\n}: {\n  score: number;\n  variant?: 'confidence' | 'credibility';\n  label?: string;\n}) {\n  const { isRadar } = useThemedColors();\n  const pct = Math.round(score * 100);\n  const level = getConfidenceLevel(score);\n\n  const colors = variant === 'credibility'\n    ? (isRadar ? credibilityBadgeColorsDark : credibilityBadgeColors)\n    : (isRadar ? confidenceBadgeColorsDark : confidenceBadgeColors);\n\n  return (\n    <span className={`inline-block px-2 py-0.5 rounded-full text-[10px] font-semibold ${colors[level]}`}>\n      {label ?? `${pct}%`}\n    </span>\n  );\n}\n\n// Backward-compatible aliases\nexport function ConfidenceBadge({ score }: { score: number }) {\n  return <ScoreBadge score={score} variant=\"confidence\" />;\n}\n\nexport function CredibilityBadge({ score }: { score: number }) {\n  return <ScoreBadge score={score} variant=\"credibility\" />;\n}\n\nexport function PriorityBadge({ priority }: { priority: string }) {\n  const { getPriority } = useThemedColors();\n\n  return (\n    <span className={`inline-block px-2 py-0.5 rounded text-[10px] font-semibold uppercase ${getPriority(priority)}`}>\n      {priority}\n    </span>\n  );\n}\n\nexport function StatusBadge({ status }: { status: string }) {\n  const { getStatus } = useThemedColors();\n\n  return (\n    <span className={`inline-block px-2 py-0.5 rounded text-[10px] font-semibold uppercase ${getStatus(status)}`}>\n      {status}\n    </span>\n  );\n}\n","numLines":87,"startLine":1,"totalLines":87}}}
