[2026-01-30T17:07:30.551Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013MjCgzR92hfDR41BmN8Nrq","type":"tool_result","content":"     1→'use client';\n     2→\n     3→/**\n     4→ * React hooks for animations.\n     5→ *\n     6→ * Provides hooks for spring animations, staggered reveals, and other\n     7→ * common animation patterns with theme-awareness.\n     8→ */\n     9→\n    10→import { useState, useEffect, useRef, useCallback, useMemo } from 'react';\n    11→import { spring, timeSpring, physicsSpring, interpolate, type TimeSpringConfig, type PhysicsSpringConfig } from './spring';\n    12→import { easeOutCubic, type EasingFunction } from './easing';\n    13→\n    14→// ============================================================================\n    15→// Types\n    16→// ============================================================================\n    17→\n    18→export interface UseSpringOptions {\n    19→  /** Animation duration in milliseconds */\n    20→  duration?: number;\n    21→  /** Delay before animation starts */\n    22→  delay?: number;\n    23→  /** Easing function */\n    24→  easing?: EasingFunction;\n    25→  /** Whether to animate on initial mount */\n    26→  animateOnMount?: boolean;\n    27→}\n    28→\n    29→export interface UseStaggerOptions extends UseSpringOptions {\n    30→  /** Delay between each item in milliseconds */\n    31→  staggerDelay?: number;\n    32→}\n    33→\n    34→export interface UseRevealOptions extends UseSpringOptions {\n    35→  /** Direction of reveal */\n    36→  direction?: 'left' | 'right' | 'up' | 'down';\n    37→  /** Distance to slide (in pixels) */\n    38→  distance?: number;\n    39→  /** Whether to trigger based on viewport visibility */\n    40→  triggerOnVisible?: boolean;\n    41→}\n    42→\n    43→// ============================================================================\n    44→// useSpring - Animate a value from 0 to 1\n    45→// ============================================================================\n    46→\n    47→/**\n    48→ * Animate a value from 0 to 1 with spring physics.\n    49→ *\n    50→ * @example\n    51→ * const progress = useSpring({ duration: 300, delay: 100 });\n    52→ * return <div style={{ opacity: progress }}>Fading in</div>;\n    53→ */\n    54→export function useSpring(options: UseSpringOptions = {}): number {\n    55→  const {\n    56→    duration = 300,\n    57→    delay = 0,\n    58→    easing = easeOutCubic,\n    59→    animateOnMount = true,\n    60→  } = options;\n    61→\n    62→  const [progress, setProgress] = useState(animateOnMount ? 0 : 1);\n    63→  const startTimeRef = useRef<number | null>(null);\n    64→  const animationRef = useRef<number | null>(null);\n    65→\n    66→  useEffect(() => {\n    67→    if (!animateOnMount) return;\n    68→\n    69→    const animate = (timestamp: number) => {\n    70→      if (!startTimeRef.current) startTimeRef.current = timestamp;\n    71→      const elapsed = timestamp - startTimeRef.current;\n    72→\n    73→      const value = timeSpring(elapsed, { duration, delay, easing });\n    74→      setProgress(value);\n    75→\n    76→      if (value < 1) {\n    77→        animationRef.current = requestAnimationFrame(animate);\n    78→      }\n    79→    };\n    80→\n    81→    animationRef.current = requestAnimationFrame(animate);\n    82→\n    83→    return () => {\n    84→      if (animationRef.current) {\n    85→        cancelAnimationFrame(animationRef.current);\n    86→      }\n    87→    };\n    88→  }, [duration, delay, easing, animateOnMount]);\n    89→\n    90→  return progress;\n    91→}\n    92→\n    93→/**\n    94→ * Manually trigger spring animation.\n    95→ *\n    96→ * @example\n    97→ * const [progress, trigger] = useSpringTrigger({ duration: 300 });\n    98→ * return <button onClick={trigger}>Animate: {progress}</button>;\n    99→ */\n   100→export function useSpringTrigger(\n   101→  options: Omit<UseSpringOptions, 'animateOnMount'> = {}\n   102→): [number, () => void, () => void] {\n   103→  const { duration = 300, delay = 0, easing = easeOutCubic } = options;\n   104→\n   105→  const [progress, setProgress] = useState(0);\n   106→  const startTimeRef = useRef<number | null>(null);\n   107→  const animationRef = useRef<number | null>(null);\n   108→  const isForward = useRef(true);\n   109→\n   110→  const animate = useCallback((timestamp: number) => {\n   111→    if (!startTimeRef.current) startTimeRef.current = timestamp;\n   112→    const elapsed = timestamp - startTimeRef.current;\n   113→\n   114→    let value = timeSpring(elapsed, { duration, delay, easing });\n   115→    if (!isForward.current) value = 1 - value;\n   116→\n   117→    setProgress(value);\n   118→\n   119→    const isComplete = isForward.current ? value >= 1 : value <= 0;\n   120→    if (!isComplete) {\n   121→      animationRef.current = requestAnimationFrame(animate);\n   122→    }\n   123→  }, [duration, delay, easing]);\n   124→\n   125→  const trigger = useCallback(() => {\n   126→    if (animationRef.current) {\n   127→      cancelAnimationFrame(animationRef.current);\n   128→    }\n   129→    isForward.current = true;\n   130→    startTimeRef.current = null;\n   131→    animationRef.current = requestAnimationFrame(animate);\n   132→  }, [animate]);\n   133→\n   134→  const reverse = useCallback(() => {\n   135→    if (animationRef.current) {\n   136→      cancelAnimationFrame(animationRef.current);\n   137→    }\n   138→    isForward.current = false;\n   139→    startTimeRef.current = null;\n   140→    animationRef.current = requestAnimationFrame(animate);\n   141→  }, [animate]);\n   142→\n   143→  useEffect(() => {\n   144→    return () => {\n   145→      if (animationRef.current) {\n   146→        cancelAnimationFrame(animationRef.current);\n   147→      }\n   148→    };\n   149→  }, []);\n   150→\n   151→  return [progress, trigger, reverse];\n   152→}\n   153→\n   154→// ============================================================================\n   155→// useStagger - Staggered animations for lists\n   156→// ============================================================================\n   157→\n   158→/**\n   159→ * Get staggered animation progress for list items.\n   160→ *\n   161→ * @example\n   162→ * const getProgress = useStagger({ staggerDelay: 50, duration: 300 });\n   163→ * return items.map((item, i) => (\n   164→ *   <div key={i} style={{ opacity: getProgress(i) }}>{item}</div>\n   165→ * ));\n   166→ */\n   167→export function useStagger(options: UseStaggerOptions = {}): (index: number) => number {\n   168→  const {\n   169→    duration = 300,\n   170→    delay = 0,\n   171→    staggerDelay = 50,\n   172→    easing = easeOutCubic,\n   173→    animateOnMount = true,\n   174→  } = options;\n   175→\n   176→  const [elapsed, setElapsed] = useState(0);\n   177→  const startTimeRef = useRef<number | null>(null);\n   178→  const animationRef = useRef<number | null>(null);\n   179→\n   180→  useEffect(() => {\n   181→    if (!animateOnMount) return;\n   182→\n   183→    const animate = (timestamp: number) => {\n   184→      if (!startTimeRef.current) startTimeRef.current = timestamp;\n   185→      setElapsed(timestamp - startTimeRef.current);\n   186→      animationRef.current = requestAnimationFrame(animate);\n   187→    };\n   188→\n   189→    animationRef.current = requestAnimationFrame(animate);\n   190→\n   191→    return () => {\n   192→      if (animationRef.current) {\n   193→        cancelAnimationFrame(animationRef.current);\n   194→      }\n   195→    };\n   196→  }, [animateOnMount]);\n   197→\n   198→  const getProgress = useCallback(\n   199→    (index: number) => {\n   200→      const itemDelay = delay + index * staggerDelay;\n   201→      return timeSpring(elapsed, { duration, delay: itemDelay, easing });\n   202→    },\n   203→    [elapsed, delay, staggerDelay, duration, easing]\n   204→  );\n   205→\n   206→  return getProgress;\n   207→}\n   208→\n   209→// ============================================================================\n   210→// useReveal - Slide + fade reveal animation\n   211→// ============================================================================\n   212→\n   213→export interface RevealStyles {\n   214→  opacity: number;\n   215→  transform: string;\n   216→}\n   217→\n   218→/**\n   219→ * Get styles for reveal animation (slide + fade).\n   220→ *\n   221→ * @example\n   222→ * const styles = useReveal({ direction: 'up', distance: 20 });\n   223→ * return <div style={styles}>Revealing content</div>;\n   224→ */\n   225→export function useReveal(options: UseRevealOptions = {}): RevealStyles {\n   226→  const {\n   227→    duration = 400,\n   228→    delay = 0,\n   229→    easing = easeOutCubic,\n   230→    direction = 'up',\n   231→    distance = 20,\n   232→    animateOnMount = true,\n   233→  } = options;\n   234→\n   235→  const progress = useSpring({ duration, delay, easing, animateOnMount });\n   236→\n   237→  const styles = useMemo(() => {\n   238→    const remaining = 1 - progress;\n   239→    const transforms: Record<string, string> = {\n   240→      left: `translateX(${remaining * -distance}px)`,\n   241→      right: `translateX(${remaining * distance}px)`,\n   242→      up: `translateY(${remaining * distance}px)`,\n   243→      down: `translateY(${remaining * -distance}px)`,\n   244→    };\n   245→\n   246→    return {\n   247→      opacity: progress,\n   248→      transform: transforms[direction],\n   249→    };\n   250→  }, [progress, direction, distance]);\n   251→\n   252→  return styles;\n   253→}\n   254→\n   255→// ============================================================================\n   256→// usePhysicsSpring - Physics-based spring with target\n   257→// ============================================================================\n   258→\n   259→/**\n   260→ * Physics-based spring that follows a target value.\n   261→ *\n   262→ * @example\n   263→ * const [value, setTarget] = usePhysicsSpring(0);\n   264→ * return (\n   265→ *   <div\n   266→ *     style={{ transform: `translateX(${value}px)` }}\n   267→ *     onMouseEnter={() => setTarget(100)}\n   268→ *     onMouseLeave={() => setTarget(0)}\n   269→ *   />\n   270→ * );\n   271→ */\n   272→export function usePhysicsSpring(\n   273→  initialValue: number,\n   274→  config: PhysicsSpringConfig = {}\n   275→): [number, (target: number) => void] {\n   276→  const [state, setState] = useState({\n   277→    value: initialValue,\n   278→    target: initialValue,\n   279→    velocity: 0,\n   280→  });\n   281→\n   282→  const animationRef = useRef<number | null>(null);\n   283→  const lastTimeRef = useRef<number | null>(null);\n   284→\n   285→  const setTarget = useCallback((newTarget: number) => {\n   286→    setState((s) => ({ ...s, target: newTarget }));\n   287→  }, []);\n   288→\n   289→  useEffect(() => {\n   290→    const animate = (timestamp: number) => {\n   291→      if (!lastTimeRef.current) lastTimeRef.current = timestamp;\n   292→      const deltaMs = timestamp - lastTimeRef.current;\n   293→      lastTimeRef.current = timestamp;\n   294→\n   295→      setState((s) => {\n   296→        if (Math.abs(s.target - s.value) < 0.01 && Math.abs(s.velocity) < 0.01) {\n   297→          return { ...s, value: s.target, velocity: 0 };\n   298→        }\n   299→\n   300→        const result = physicsSpring(s.value, s.target, s.velocity, deltaMs, config);\n   301→        return { ...s, value: result.value, velocity: result.velocity };\n   302→      });\n   303→\n   304→      animationRef.current = requestAnimationFrame(animate);\n   305→    };\n   306→\n   307→    animationRef.current = requestAnimationFrame(animate);\n   308→\n   309→    return () => {\n   310→      if (animationRef.current) {\n   311→        cancelAnimationFrame(animationRef.current);\n   312→      }\n   313→    };\n   314→  }, [config]);\n   315→\n   316→  return [state.value, setTarget];\n   317→}\n   318→\n   319→// ============================================================================\n   320→// usePulse - Continuous pulsing animation\n   321→// ============================================================================\n   322→\n   323→/**\n   324→ * Continuous pulsing animation for ambient effects.\n   325→ *\n   326→ * @example\n   327→ * const pulse = usePulse({ frequency: 2 }); // 2 cycles per second\n   328→ * return <div style={{ opacity: 0.5 + pulse * 0.5 }}>Pulsing</div>;\n   329→ */\n   330→export function usePulse(options: { frequency?: number } = {}): number {\n   331→  const { frequency = 1 } = options;\n   332→  const [value, setValue] = useState(0);\n   333→  const startTimeRef = useRef<number | null>(null);\n   334→  const animationRef = useRef<number | null>(null);\n   335→\n   336→  useEffect(() => {\n   337→    const animate = (timestamp: number) => {\n   338→      if (!startTimeRef.current) startTimeRef.current = timestamp;\n   339→      const elapsed = (timestamp - startTimeRef.current) / 1000;\n   340→      setValue(Math.sin(elapsed * frequency * Math.PI * 2) * 0.5 + 0.5);\n   341→      animationRef.current = requestAnimationFrame(animate);\n   342→    };\n   343→\n   344→    animationRef.current = requestAnimationFrame(animate);\n   345→\n   346→    return () => {\n   347→      if (animationRef.current) {\n   348→        cancelAnimationFrame(animationRef.current);\n   349→      }\n   350→    };\n   351→  }, [frequency]);\n   352→\n   353→  return value;\n   354→}\n   355→\n   356→// ============================================================================\n   357→// useAnimatedValue - Smooth value transitions\n   358→// ============================================================================\n   359→\n   360→/**\n   361→ * Smoothly animate between numeric values.\n   362→ *\n   363→ * @example\n   364→ * const [displayValue] = useAnimatedValue(count, { duration: 200 });\n   365→ * return <span>{Math.round(displayValue)}</span>;\n   366→ */\n   367→export function useAnimatedValue(\n   368→  targetValue: number,\n   369→  options: TimeSpringConfig = {}\n   370→): [number] {\n   371→  const { duration = 200, easing = easeOutCubic } = options;\n   372→  const [value, setValue] = useState(targetValue);\n   373→  const previousValueRef = useRef(targetValue);\n   374→  const startTimeRef = useRef<number | null>(null);\n   375→  const animationRef = useRef<number | null>(null);\n   376→\n   377→  useEffect(() => {\n   378→    if (targetValue === previousValueRef.current) return;\n   379→\n   380→    const startValue = value;\n   381→    const endValue = targetValue;\n   382→    previousValueRef.current = targetValue;\n   383→\n   384→    if (animationRef.current) {\n   385→      cancelAnimationFrame(animationRef.current);\n   386→    }\n   387→    startTimeRef.current = null;\n   388→\n   389→    const animate = (timestamp: number) => {\n   390→      if (!startTimeRef.current) startTimeRef.current = timestamp;\n   391→      const elapsed = timestamp - startTimeRef.current;\n   392→      const progress = timeSpring(elapsed, { duration, easing });\n   393→\n   394→      setValue(startValue + (endValue - startValue) * progress);\n   395→\n   396→      if (progress < 1) {\n   397→        animationRef.current = requestAnimationFrame(animate);\n   398→      }\n   399→    };\n   400→\n   401→    animationRef.current = requestAnimationFrame(animate);\n   402→\n   403→    return () => {\n   404→      if (animationRef.current) {\n   405→        cancelAnimationFrame(animationRef.current);\n   406→      }\n   407→    };\n   408→  }, [targetValue, duration, easing]);\n   409→\n   410→  return [value];\n   411→}\n   412→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"bb700aba-f9fc-4283-93cf-561e37220b63","uuid":"90b8be09-4e53-43d8-8e87-98a777de19b6","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\lib\\animation\\hooks.ts","content":"'use client';\n\n/**\n * React hooks for animations.\n *\n * Provides hooks for spring animations, staggered reveals, and other\n * common animation patterns with theme-awareness.\n */\n\nimport { useState, useEffect, useRef, useCallback, useMemo } from 'react';\nimport { spring, timeSpring, physicsSpring, interpolate, type TimeSpringConfig, type PhysicsSpringConfig } from './spring';\nimport { easeOutCubic, type EasingFunction } from './easing';\n\n// ============================================================================\n// Types\n// ============================================================================\n\nexport interface UseSpringOptions {\n  /** Animation duration in milliseconds */\n  duration?: number;\n  /** Delay before animation starts */\n  delay?: number;\n  /** Easing function */\n  easing?: EasingFunction;\n  /** Whether to animate on initial mount */\n  animateOnMount?: boolean;\n}\n\nexport interface UseStaggerOptions extends UseSpringOptions {\n  /** Delay between each item in milliseconds */\n  staggerDelay?: number;\n}\n\nexport interface UseRevealOptions extends UseSpringOptions {\n  /** Direction of reveal */\n  direction?: 'left' | 'right' | 'up' | 'down';\n  /** Distance to slide (in pixels) */\n  distance?: number;\n  /** Whether to trigger based on viewport visibility */\n  triggerOnVisible?: boolean;\n}\n\n// ============================================================================\n// useSpring - Animate a value from 0 to 1\n// ============================================================================\n\n/**\n * Animate a value from 0 to 1 with spring physics.\n *\n * @example\n * const progress = useSpring({ duration: 300, delay: 100 });\n * return <div style={{ opacity: progress }}>Fading in</div>;\n */\nexport function useSpring(options: UseSpringOptions = {}): number {\n  const {\n    duration = 300,\n    delay = 0,\n    easing = easeOutCubic,\n    animateOnMount = true,\n  } = options;\n\n  const [progress, setProgress] = useState(animateOnMount ? 0 : 1);\n  const startTimeRef = useRef<number | null>(null);\n  const animationRef = useRef<number | null>(null);\n\n  useEffect(() => {\n    if (!animateOnMount) return;\n\n    const animate = (timestamp: number) => {\n      if (!startTimeRef.current) startTimeRef.current = timestamp;\n      const elapsed = timestamp - startTimeRef.current;\n\n      const value = timeSpring(elapsed, { duration, delay, easing });\n      setProgress(value);\n\n      if (value < 1) {\n        animationRef.current = requestAnimationFrame(animate);\n      }\n    };\n\n    animationRef.current = requestAnimationFrame(animate);\n\n    return () => {\n      if (animationRef.current) {\n        cancelAnimationFrame(animationRef.current);\n      }\n    };\n  }, [duration, delay, easing, animateOnMount]);\n\n  return progress;\n}\n\n/**\n * Manually trigger spring animation.\n *\n * @example\n * const [progress, trigger] = useSpringTrigger({ duration: 300 });\n * return <button onClick={trigger}>Animate: {progress}</button>;\n */\nexport function useSpringTrigger(\n  options: Omit<UseSpringOptions, 'animateOnMount'> = {}\n): [number, () => void, () => void] {\n  const { duration = 300, delay = 0, easing = easeOutCubic } = options;\n\n  const [progress, setProgress] = useState(0);\n  const startTimeRef = useRef<number | null>(null);\n  const animationRef = useRef<number | null>(null);\n  const isForward = useRef(true);\n\n  const animate = useCallback((timestamp: number) => {\n    if (!startTimeRef.current) startTimeRef.current = timestamp;\n    const elapsed = timestamp - startTimeRef.current;\n\n    let value = timeSpring(elapsed, { duration, delay, easing });\n    if (!isForward.current) value = 1 - value;\n\n    setProgress(value);\n\n    const isComplete = isForward.current ? value >= 1 : value <= 0;\n    if (!isComplete) {\n      animationRef.current = requestAnimationFrame(animate);\n    }\n  }, [duration, delay, easing]);\n\n  const trigger = useCallback(() => {\n    if (animationRef.current) {\n      cancelAnimationFrame(animationRef.current);\n    }\n    isForward.current = true;\n    startTimeRef.current = null;\n    animationRef.current = requestAnimationFrame(animate);\n  }, [animate]);\n\n  const reverse = useCallback(() => {\n    if (animationRef.current) {\n      cancelAnimationFrame(animationRef.current);\n    }\n    isForward.current = false;\n    startTimeRef.current = null;\n    animationRef.current = requestAnimationFrame(animate);\n  }, [animate]);\n\n  useEffect(() => {\n    return () => {\n      if (animationRef.current) {\n        cancelAnimationFrame(animationRef.current);\n      }\n    };\n  }, []);\n\n  return [progress, trigger, reverse];\n}\n\n// ============================================================================\n// useStagger - Staggered animations for lists\n// ============================================================================\n\n/**\n * Get staggered animation progress for list items.\n *\n * @example\n * const getProgress = useStagger({ staggerDelay: 50, duration: 300 });\n * return items.map((item, i) => (\n *   <div key={i} style={{ opacity: getProgress(i) }}>{item}</div>\n * ));\n */\nexport function useStagger(options: UseStaggerOptions = {}): (index: number) => number {\n  const {\n    duration = 300,\n    delay = 0,\n    staggerDelay = 50,\n    easing = easeOutCubic,\n    animateOnMount = true,\n  } = options;\n\n  const [elapsed, setElapsed] = useState(0);\n  const startTimeRef = useRef<number | null>(null);\n  const animationRef = useRef<number | null>(null);\n\n  useEffect(() => {\n    if (!animateOnMount) return;\n\n    const animate = (timestamp: number) => {\n      if (!startTimeRef.current) startTimeRef.current = timestamp;\n      setElapsed(timestamp - startTimeRef.current);\n      animationRef.current = requestAnimationFrame(animate);\n    };\n\n    animationRef.current = requestAnimationFrame(animate);\n\n    return () => {\n      if (animationRef.current) {\n        cancelAnimationFrame(animationRef.current);\n      }\n    };\n  }, [animateOnMount]);\n\n  const getProgress = useCallback(\n    (index: number) => {\n      const itemDelay = delay + index * staggerDelay;\n      return timeSpring(elapsed, { duration, delay: itemDelay, easing });\n    },\n    [elapsed, delay, staggerDelay, duration, easing]\n  );\n\n  return getProgress;\n}\n\n// ============================================================================\n// useReveal - Slide + fade reveal animation\n// ============================================================================\n\nexport interface RevealStyles {\n  opacity: number;\n  transform: string;\n}\n\n/**\n * Get styles for reveal animation (slide + fade).\n *\n * @example\n * const styles = useReveal({ direction: 'up', distance: 20 });\n * return <div style={styles}>Revealing content</div>;\n */\nexport function useReveal(options: UseRevealOptions = {}): RevealStyles {\n  const {\n    duration = 400,\n    delay = 0,\n    easing = easeOutCubic,\n    direction = 'up',\n    distance = 20,\n    animateOnMount = true,\n  } = options;\n\n  const progress = useSpring({ duration, delay, easing, animateOnMount });\n\n  const styles = useMemo(() => {\n    const remaining = 1 - progress;\n    const transforms: Record<string, string> = {\n      left: `translateX(${remaining * -distance}px)`,\n      right: `translateX(${remaining * distance}px)`,\n      up: `translateY(${remaining * distance}px)`,\n      down: `translateY(${remaining * -distance}px)`,\n    };\n\n    return {\n      opacity: progress,\n      transform: transforms[direction],\n    };\n  }, [progress, direction, distance]);\n\n  return styles;\n}\n\n// ============================================================================\n// usePhysicsSpring - Physics-based spring with target\n// ============================================================================\n\n/**\n * Physics-based spring that follows a target value.\n *\n * @example\n * const [value, setTarget] = usePhysicsSpring(0);\n * return (\n *   <div\n *     style={{ transform: `translateX(${value}px)` }}\n *     onMouseEnter={() => setTarget(100)}\n *     onMouseLeave={() => setTarget(0)}\n *   />\n * );\n */\nexport function usePhysicsSpring(\n  initialValue: number,\n  config: PhysicsSpringConfig = {}\n): [number, (target: number) => void] {\n  const [state, setState] = useState({\n    value: initialValue,\n    target: initialValue,\n    velocity: 0,\n  });\n\n  const animationRef = useRef<number | null>(null);\n  const lastTimeRef = useRef<number | null>(null);\n\n  const setTarget = useCallback((newTarget: number) => {\n    setState((s) => ({ ...s, target: newTarget }));\n  }, []);\n\n  useEffect(() => {\n    const animate = (timestamp: number) => {\n      if (!lastTimeRef.current) lastTimeRef.current = timestamp;\n      const deltaMs = timestamp - lastTimeRef.current;\n      lastTimeRef.current = timestamp;\n\n      setState((s) => {\n        if (Math.abs(s.target - s.value) < 0.01 && Math.abs(s.velocity) < 0.01) {\n          return { ...s, value: s.target, velocity: 0 };\n        }\n\n        const result = physicsSpring(s.value, s.target, s.velocity, deltaMs, config);\n        return { ...s, value: result.value, velocity: result.velocity };\n      });\n\n      animationRef.current = requestAnimationFrame(animate);\n    };\n\n    animationRef.current = requestAnimationFrame(animate);\n\n    return () => {\n      if (animationRef.current) {\n        cancelAnimationFrame(animationRef.current);\n      }\n    };\n  }, [config]);\n\n  return [state.value, setTarget];\n}\n\n// ============================================================================\n// usePulse - Continuous pulsing animation\n// ============================================================================\n\n/**\n * Continuous pulsing animation for ambient effects.\n *\n * @example\n * const pulse = usePulse({ frequency: 2 }); // 2 cycles per second\n * return <div style={{ opacity: 0.5 + pulse * 0.5 }}>Pulsing</div>;\n */\nexport function usePulse(options: { frequency?: number } = {}): number {\n  const { frequency = 1 } = options;\n  const [value, setValue] = useState(0);\n  const startTimeRef = useRef<number | null>(null);\n  const animationRef = useRef<number | null>(null);\n\n  useEffect(() => {\n    const animate = (timestamp: number) => {\n      if (!startTimeRef.current) startTimeRef.current = timestamp;\n      const elapsed = (timestamp - startTimeRef.current) / 1000;\n      setValue(Math.sin(elapsed * frequency * Math.PI * 2) * 0.5 + 0.5);\n      animationRef.current = requestAnimationFrame(animate);\n    };\n\n    animationRef.current = requestAnimationFrame(animate);\n\n    return () => {\n      if (animationRef.current) {\n        cancelAnimationFrame(animationRef.current);\n      }\n    };\n  }, [frequency]);\n\n  return value;\n}\n\n// ============================================================================\n// useAnimatedValue - Smooth value transitions\n// ============================================================================\n\n/**\n * Smoothly animate between numeric values.\n *\n * @example\n * const [displayValue] = useAnimatedValue(count, { duration: 200 });\n * return <span>{Math.round(displayValue)}</span>;\n */\nexport function useAnimatedValue(\n  targetValue: number,\n  options: TimeSpringConfig = {}\n): [number] {\n  const { duration = 200, easing = easeOutCubic } = options;\n  const [value, setValue] = useState(targetValue);\n  const previousValueRef = useRef(targetValue);\n  const startTimeRef = useRef<number | null>(null);\n  const animationRef = useRef<number | null>(null);\n\n  useEffect(() => {\n    if (targetValue === previousValueRef.current) return;\n\n    const startValue = value;\n    const endValue = targetValue;\n    previousValueRef.current = targetValue;\n\n    if (animationRef.current) {\n      cancelAnimationFrame(animationRef.current);\n    }\n    startTimeRef.current = null;\n\n    const animate = (timestamp: number) => {\n      if (!startTimeRef.current) startTimeRef.current = timestamp;\n      const elapsed = timestamp - startTimeRef.current;\n      const progress = timeSpring(elapsed, { duration, easing });\n\n      setValue(startValue + (endValue - startValue) * progress);\n\n      if (progress < 1) {\n        animationRef.current = requestAnimationFrame(animate);\n      }\n    };\n\n    animationRef.current = requestAnimationFrame(animate);\n\n    return () => {\n      if (animationRef.current) {\n        cancelAnimationFrame(animationRef.current);\n      }\n    };\n  }, [targetValue, duration, easing]);\n\n  return [value];\n}\n","numLines":412,"startLine":1,"totalLines":412}}}
