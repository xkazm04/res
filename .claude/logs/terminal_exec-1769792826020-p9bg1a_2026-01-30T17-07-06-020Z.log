  easeInOutExpo,\n    56→\n    57→  // Sine (gentle)\n    58→  easeInSine,\n    59→  easeOutSine,\n    60→  easeInOutSine,\n    61→\n    62→  // Circ (physical)\n    63→  easeInCirc,\n    64→  easeOutCirc,\n    65→  easeInOutCirc,\n    66→\n    67→  // Back (overshoot)\n    68→  easeInBack,\n    69→  easeOutBack,\n    70→  easeInOutBack,\n    71→\n    72→  // Elastic (bouncy)\n    73→  easeInElastic,\n    74→  easeOutElastic,\n    75→  easeInOutElastic,\n    76→\n    77→  // Bounce\n    78→  easeInBounce,\n    79→  easeOutBounce,\n    80→  easeInOutBounce,\n    81→\n    82→  // Linear\n    83→  linear as linearEasing,\n    84→\n    85→  // Presets\n    86→  easingPresets,\n    87→\n    88→  // Types\n    89→  type EasingFunction,\n    90→} from './easing';\n    91→\n    92→// ============================================================================\n    93→// Spring Physics\n    94→// ============================================================================\n    95→\n    96→export {\n    97→  // Frame-based spring\n    98→  spring,\n    99→  staggeredSpring,\n   100→\n   101→  // Time-based spring\n   102→  timeSpring,\n   103→\n   104→  // Physics spring\n   105→  physicsSpring,\n   106→\n   107→  // Interpolation\n   108→  interpolate,\n   109→  interpolateMultiple,\n   110→\n   111→  // Linear animation\n   112→  linear,\n   113→\n   114→  // Presets\n   115→  springPresets,\n   116→  physicsPresets,\n   117→\n   118→  // Types\n   119→  type SpringConfig,\n   120→  type TimeSpringConfig,\n   121→  type PhysicsSpringConfig,\n   122→  type PhysicsSpringState,\n   123→} from './spring';\n   124→\n   125→// ============================================================================\n   126→// React Hooks\n   127→// ============================================================================\n   128→\n   129→export {\n   130→  // Core hooks\n   131→  useSpring,\n   132→  useSpringTrigger,\n   133→  useStagger,\n   134→  useReveal,\n   135→\n   136→  // Advanced hooks\n   137→  usePhysicsSpring,\n   138→  usePulse,\n   139→  useAnimatedValue,\n   140→\n   141→  // Types\n   142→  type UseSpringOptions,\n   143→  type UseStaggerOptions,\n   144→  type UseRevealOptions,\n   145→  type RevealStyles,\n   146→} from './hooks';\n   147→\n   148→// ============================================================================\n   149→// Transition Components\n   150→// ============================================================================\n   151→\n   152→export {\n   153→  // Basic transitions\n   154→  Crossfade,\n   155→  Slide,\n   156→  Scale,\n   157→  Stagger,\n   158→  Reveal,\n   159→  Zoom,\n   160→\n   161→  // Special effects\n   162→  CountUp,\n   163→  Pulse,\n   164→  Typewriter,\n   165→  FadeInOut,\n   166→\n   167→  // Presets\n   168→  transitionPresets,\n   169→} from './transitions';\n   170→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"bb700aba-f9fc-4283-93cf-561e37220b63","uuid":"32f62e09-b94e-44da-9741-fbf596bdb6d4","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\lib\\animation\\index.ts","content":"/**\n * Unified Animation Library\n *\n * A consolidated animation system providing consistent timing, easing,\n * and transitions across all visualizations and video components.\n *\n * @example\n * // Frame-based animation (video)\n * import { spring, easeOutCubic, Slide, Stagger } from '@/src/lib/animation';\n *\n * function VideoScene({ frame, fps }) {\n *   const progress = spring({ frame, fps, delay: 10, durationFrames: 20 });\n *   return (\n *     <Slide frame={frame} fps={fps} direction=\"up\">\n *       <div style={{ opacity: progress }}>Content</div>\n *     </Slide>\n *   );\n * }\n *\n * @example\n * // React hooks (UI components)\n * import { useSpring, useStagger, useReveal } from '@/src/lib/animation';\n *\n * function AnimatedList({ items }) {\n *   const getProgress = useStagger({ staggerDelay: 50 });\n *   return items.map((item, i) => (\n *     <div key={i} style={{ opacity: getProgress(i) }}>{item}</div>\n *   ));\n * }\n */\n\n// ============================================================================\n// Easing Functions\n// ============================================================================\n\nexport {\n  // Cubic (most common)\n  easeInCubic,\n  easeOutCubic,\n  easeInOutCubic,\n\n  // Quart (dramatic)\n  easeInQuart,\n  easeOutQuart,\n  easeInOutQuart,\n\n  // Quint (most dramatic)\n  easeInQuint,\n  easeOutQuint,\n  easeInOutQuint,\n\n  // Expo (snappy)\n  easeInExpo,\n  easeOutExpo,\n  easeInOutExpo,\n\n  // Sine (gentle)\n  easeInSine,\n  easeOutSine,\n  easeInOutSine,\n\n  // Circ (physical)\n  easeInCirc,\n  easeOutCirc,\n  easeInOutCirc,\n\n  // Back (overshoot)\n  easeInBack,\n  easeOutBack,\n  easeInOutBack,\n\n  // Elastic (bouncy)\n  easeInElastic,\n  easeOutElastic,\n  easeInOutElastic,\n\n  // Bounce\n  easeInBounce,\n  easeOutBounce,\n  easeInOutBounce,\n\n  // Linear\n  linear as linearEasing,\n\n  // Presets\n  easingPresets,\n\n  // Types\n  type EasingFunction,\n} from './easing';\n\n// ============================================================================\n// Spring Physics\n// ============================================================================\n\nexport {\n  // Frame-based spring\n  spring,\n  staggeredSpring,\n\n  // Time-based spring\n  timeSpring,\n\n  // Physics spring\n  physicsSpring,\n\n  // Interpolation\n  interpolate,\n  interpolateMultiple,\n\n  // Linear animation\n  linear,\n\n  // Presets\n  springPresets,\n  physicsPresets,\n\n  // Types\n  type SpringConfig,\n  type TimeSpringConfig,\n  type PhysicsSpringConfig,\n  type PhysicsSpringState,\n} from './spring';\n\n// ============================================================================\n// React Hooks\n// ============================================================================\n\nexport {\n  // Core hooks\n  useSpring,\n  useSpringTrigger,\n  useStagger,\n  useReveal,\n\n  // Advanced hooks\n  usePhysicsSpring,\n  usePulse,\n  useAnimatedValue,\n\n  // Types\n  type UseSpringOptions,\n  type UseStaggerOptions,\n  type UseRevealOptions,\n  type RevealStyles,\n} from './hooks';\n\n// ============================================================================\n// Transition Components\n// ============================================================================\n\nexport {\n  // Basic transitions\n  Crossfade,\n  Slide,\n  Scale,\n  Stagger,\n  Reveal,\n  Zoom,\n\n  // Special effects\n  CountUp,\n  Pulse,\n  Typewriter,\n  FadeInOut,\n\n  // Presets\n  transitionPresets,\n} from './transitions';\n","numLines":170,"startLine":1,"totalLines":170}}}
