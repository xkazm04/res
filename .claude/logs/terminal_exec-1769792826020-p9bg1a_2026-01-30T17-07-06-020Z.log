[2026-01-30T17:07:33.934Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017zujKpJfeSUJCdfwna92tm","type":"tool_result","content":"     1→/**\n     2→ * Spring animation utilities for smooth, physics-based motion.\n     3→ *\n     4→ * Provides both frame-based springs (for video/canvas) and time-based springs\n     5→ * (for React components). All springs use critically damped behavior for\n     6→ * smooth motion without overshoot.\n     7→ */\n     8→\n     9→import { easeOutCubic, type EasingFunction } from './easing';\n    10→\n    11→// ============================================================================\n    12→// Types\n    13→// ============================================================================\n    14→\n    15→export interface SpringConfig {\n    16→  /** Animation duration in frames */\n    17→  durationFrames?: number;\n    18→  /** Delay before animation starts (in frames) */\n    19→  delay?: number;\n    20→  /** Easing function to apply */\n    21→  easing?: EasingFunction;\n    22→}\n    23→\n    24→export interface TimeSpringConfig {\n    25→  /** Animation duration in milliseconds */\n    26→  duration?: number;\n    27→  /** Delay before animation starts (in ms) */\n    28→  delay?: number;\n    29→  /** Easing function to apply */\n    30→  easing?: EasingFunction;\n    31→}\n    32→\n    33→export interface PhysicsSpringConfig {\n    34→  /** Spring stiffness (higher = faster) */\n    35→  stiffness?: number;\n    36→  /** Damping ratio (1 = critical, <1 = bouncy, >1 = overdamped) */\n    37→  damping?: number;\n    38→  /** Object mass (higher = slower) */\n    39→  mass?: number;\n    40→  /** Velocity threshold to consider animation complete */\n    41→  restVelocity?: number;\n    42→  /** Position threshold to consider animation complete */\n    43→  restDelta?: number;\n    44→}\n    45→\n    46→// ============================================================================\n    47→// Default Configurations\n    48→// ============================================================================\n    49→\n    50→const DEFAULT_SPRING_CONFIG: Required<SpringConfig> = {\n    51→  durationFrames: 20,\n    52→  delay: 0,\n    53→  easing: easeOutCubic,\n    54→};\n    55→\n    56→const DEFAULT_TIME_SPRING_CONFIG: Required<TimeSpringConfig> = {\n    57→  duration: 300,\n    58→  delay: 0,\n    59→  easing: easeOutCubic,\n    60→};\n    61→\n    62→const DEFAULT_PHYSICS_CONFIG: Required<PhysicsSpringConfig> = {\n    63→  stiffness: 170,\n    64→  damping: 26,\n    65→  mass: 1,\n    66→  restVelocity: 0.01,\n    67→  restDelta: 0.01,\n    68→};\n    69→\n    70→// ============================================================================\n    71→// Frame-Based Spring (for video/canvas animations)\n    72→// ============================================================================\n    73→\n    74→/**\n    75→ * Calculate spring progress for a given frame.\n    76→ * Returns 0-1 value representing animation progress.\n    77→ *\n    78→ * @example\n    79→ * // In video component\n    80→ * const opacity = spring({ frame, fps: 30, delay: 10, durationFrames: 20 });\n    81→ * // opacity animates from 0 to 1 starting at frame 10, over 20 frames\n    82→ */\n    83→export function spring(params: {\n    84→  frame: number;\n    85→  fps: number;\n    86→  delay?: number;\n    87→  durationFrames?: number;\n    88→  easing?: EasingFunction;\n    89→}): number {\n    90→  const {\n    91→    frame,\n    92→    delay = DEFAULT_SPRING_CONFIG.delay,\n    93→    durationFrames = DEFAULT_SPRING_CONFIG.durationFrames,\n    94→    easing = DEFAULT_SPRING_CONFIG.easing,\n    95→  } = params;\n    96→\n    97→  const adjustedFrame = frame - delay;\n    98→  if (adjustedFrame <= 0) return 0;\n    99→  if (adjustedFrame >= durationFrames) return 1;\n   100→\n   101→  const t = adjustedFrame / durationFrames;\n   102→  return easing(t);\n   103→}\n   104→\n   105→/**\n   106→ * Calculate staggered spring progress for list items.\n   107→ *\n   108→ * @example\n   109→ * items.map((item, i) => {\n   110→ *   const progress = staggeredSpring({ frame, fps: 30, index: i, stagger: 3 });\n   111→ *   return <div style={{ opacity: progress }}>{item}</div>;\n   112→ * });\n   113→ */\n   114→export function staggeredSpring(params: {\n   115→  frame: number;\n   116→  fps: number;\n   117→  index: number;\n   118→  stagger?: number;\n   119→  delay?: number;\n   120→  durationFrames?: number;\n   121→  easing?: EasingFunction;\n   122→}): number {\n   123→  const { index, stagger = 5, delay = 0, ...rest } = params;\n   124→  return spring({ ...rest, delay: delay + index * stagger });\n   125→}\n   126→\n   127→// ============================================================================\n   128→// Time-Based Spring (for React components)\n   129→// ============================================================================\n   130→\n   131→/**\n   132→ * Calculate spring progress for a given timestamp.\n   133→ * Useful for CSS animations and manual animation loops.\n   134→ *\n   135→ * @param elapsed - Milliseconds since animation started\n   136→ * @param config - Spring configuration\n   137→ * @returns Progress value from 0 to 1\n   138→ */\n   139→export function timeSpring(elapsed: number, config: TimeSpringConfig = {}): number {\n   140→  const { duration, delay, easing } = { ...DEFAULT_TIME_SPRING_CONFIG, ...config };\n   141→\n   142→  const adjustedTime = elapsed - delay;\n   143→  if (adjustedTime <= 0) return 0;\n   144→  if (adjustedTime >= duration) return 1;\n   145→\n   146→  const t = adjustedTime / duration;\n   147→  return easing(t);\n   148→}\n   149→\n   150→// ============================================================================\n   151→// Physics-Based Spring (for smooth, natural motion)\n   152→// ============================================================================\n   153→\n   154→export interface PhysicsSpringState {\n   155→  value: number;\n   156→  velocity: number;\n   157→  isComplete: boolean;\n   158→}\n   159→\n   160→/**\n   161→ * Calculate next state for a physics-based spring.\n   162→ * Use this for smooth, natural motion in animation loops.\n   163→ *\n   164→ * @example\n   165→ * let state = { value: 0, velocity: 0, isComplete: false };\n   166→ * function animate() {\n   167→ *   state = physicsSpring(state.value, 1, state.velocity, 16, config);\n   168→ *   element.style.transform = `translateX(${state.value}px)`;\n   169→ *   if (!state.isComplete) requestAnimationFrame(animate);\n   170→ * }\n   171→ */\n   172→export function physicsSpring(\n   173→  current: number,\n   174→  target: number,\n   175→  velocity: number,\n   176→  deltaMs: number,\n   177→  config: PhysicsSpringConfig = {}\n   178→): PhysicsSpringState {\n   179→  const { stiffness, damping, mass, restVelocity, restDelta } = {\n   180→    ...DEFAULT_PHYSICS_CONFIG,\n   181→    ...config,\n   182→  };\n   183→\n   184→  const dt = deltaMs / 1000; // Convert to seconds\n   185→  const displacement = target - current;\n   186→\n   187→  // Spring force: F = -kx - cv\n   188→  const springForce = stiffness * displacement;\n   189→  const dampingForce = damping * velocity;\n   190→  const acceleration = (springForce - dampingForce) / mass;\n   191→\n   192→  // Update velocity and position\n   193→  const newVelocity = velocity + acceleration * dt;\n   194→  const newValue = current + newVelocity * dt;\n   195→\n   196→  // Check if animation is complete\n   197→  const isComplete =\n   198→    Math.abs(newVelocity) < restVelocity && Math.abs(target - newValue) < restDelta;\n   199→\n   200→  return {\n   201→    value: isComplete ? target : newValue,\n   202→    velocity: isComplete ? 0 : newVelocity,\n   203→    isComplete,\n   204→  };\n   205→}\n   206→\n   207→// ============================================================================\n   208→// Interpolation Utilities\n   209→// ============================================================================\n   210→\n   211→/**\n   212→ * Interpolate between two values with optional easing.\n   213→ *\n   214→ * @example\n   215→ * const x = interpolate(progress, [0, 1], [100, 500], { easing: easeOutCubic });\n   216→ */\n   217→export function interpolate(\n   218→  input: number,\n   219→  inputRange: [number, number],\n   220→  outputRange: [number, number],\n   221→  options?: {\n   222→    extrapolateLeft?: 'clamp' | 'extend';\n   223→    extrapolateRight?: 'clamp' | 'extend';\n   224→    easing?: EasingFunction;\n   225→  }\n   226→): number {\n   227→  const [inMin, inMax] = inputRange;\n   228→  const [outMin, outMax] = outputRange;\n   229→  const { extrapolateLeft = 'extend', extrapolateRight = 'extend', easing } = options || {};\n   230→\n   231→  // Clamp input if needed\n   232→  let clampedInput = input;\n   233→  if (extrapolateLeft === 'clamp' && input < inMin) clampedInput = inMin;\n   234→  if (extrapolateRight === 'clamp' && input > inMax) clampedInput = inMax;\n   235→\n   236→  // Calculate normalized progress (0 to 1)\n   237→  let t = (clampedInput - inMin) / (inMax - inMin);\n   238→  t = Math.max(0, Math.min(1, t));\n   239→\n   240→  // Apply easing if provided\n   241→  if (easing) t = easing(t);\n   242→\n   243→  return outMin + t * (outMax - outMin);\n   244→}\n   245→\n   246→/**\n   247→ * Interpolate across multiple values.\n   248→ *\n   249→ * @example\n   250→ * const color = interpolateMultiple(progress, [0, 0.5, 1], ['#ff0000', '#00ff00', '#0000ff']);\n   251→ */\n   252→export function interpolateMultiple(\n   253→  input: number,\n   254→  inputRange: number[],\n   255→  outputRange: number[],\n   256→  options?: { easing?: EasingFunction }\n   257→): number {\n   258→  if (inputRange.length !== outputRange.length || inputRange.length < 2) {\n   259→    throw new Error('Input and output ranges must have the same length and at least 2 values');\n   260→  }\n   261→\n   262→  // Find the segment we're in\n   263→  let segmentIndex = 0;\n   264→  for (let i = 0; i < inputRange.length - 1; i++) {\n   265→    if (input >= inputRange[i] && input <= inputRange[i + 1]) {\n   266→      segmentIndex = i;\n   267→      break;\n   268→    }\n   269→    if (input > inputRange[i + 1]) {\n   270→      segmentIndex = i + 1;\n   271→    }\n   272→  }\n   273→\n   274→  const clampedIndex = Math.min(segmentIndex, inputRange.length - 2);\n   275→  return interpolate(\n   276→    input,\n   277→    [inputRange[clampedIndex], inputRange[clampedIndex + 1]],\n   278→    [outputRange[clampedIndex], outputRange[clampedIndex + 1]],\n   279→    options\n   280→  );\n   281→}\n   282→\n   283→/**\n   284→ * Simple linear animation progress based on frames.\n   285→ */\n   286→export function linear(frame: number, durationFrames: number): number {\n   287→  return Math.min(1, frame / durationFrames);\n   288→}\n   289→\n   290→// ============================================================================\n   291→// Spring Presets\n   292→// ============================================================================\n   293→\n   294→/** Common spring configurations for different use cases */\n   295→export const springPresets = {\n   296→  /** Default - smooth, versatile */\n   297→  default: { durationFrames: 20, easing: easeOutCubic } as SpringConfig,\n   298→\n   299→  /** Snappy - quick response */\n   300→  snappy: { durationFrames: 12, easing: easeOutCubic } as SpringConfig,\n   301→\n   302→  /** Slow - deliberate, dramatic */\n   303→  slow: { durationFrames: 40, easing: easeOutCubic } as SpringConfig,\n   304→\n   305→  /** Gentle - subtle motion */\n   306→  gentle: { durationFrames: 30, easing: easeOutCubic } as SpringConfig,\n   307→\n   308→  /** Stagger item delay */\n   309→  staggerDelay: 5,\n   310→} as const;\n   311→\n   312→/** Physics spring presets for natural motion */\n   313→export const physicsPresets = {\n   314→  /** Default - balanced */\n   315→  default: { stiffness: 170, damping: 26, mass: 1 } as PhysicsSpringConfig,\n   316→\n   317→  /** Gentle - slow, smooth */\n   318→  gentle: { stiffness: 120, damping: 20, mass: 1 } as PhysicsSpringConfig,\n   319→\n   320→  /** Wobbly - playful bounce */\n   321→  wobbly: { stiffness: 180, damping: 12, mass: 1 } as PhysicsSpringConfig,\n   322→\n   323→  /** Stiff - quick, no bounce */\n   324→  stiff: { stiffness: 400, damping: 40, mass: 1 } as PhysicsSpringConfig,\n   325→\n   326→  /** Slow - dramatic, heavy */\n   327→  slow: { stiffness: 100, damping: 30, mass: 2 } as PhysicsSpringConfig,\n   328→} as const;\n   329→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"bb700aba-f9fc-4283-93cf-561e37220b63","uuid":"fbb85834-f183-44af-acfe-7a0c5e10e89f","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\lib\\animation\\spring.ts","content":"/**\n * Spring animation utilities for smooth, physics-based motion.\n *\n * Provides both frame-based springs (for video/canvas) and time-based springs\n * (for React components). All springs use critically damped behavior for\n * smooth motion without overshoot.\n */\n\nimport { easeOutCubic, type EasingFunction } from './easing';\n\n// ============================================================================\n// Types\n// ============================================================================\n\nexport interface SpringConfig {\n  /** Animation duration in frames */\n  durationFrames?: number;\n  /** Delay before animation starts (in frames) */\n  delay?: number;\n  /** Easing function to apply */\n  easing?: EasingFunction;\n}\n\nexport interface TimeSpringConfig {\n  /** Animation duration in milliseconds */\n  duration?: number;\n  /** Delay before animation starts (in ms) */\n  delay?: number;\n  /** Easing function to apply */\n  easing?: EasingFunction;\n}\n\nexport interface PhysicsSpringConfig {\n  /** Spring stiffness (higher = faster) */\n  stiffness?: number;\n  /** Damping ratio (1 = critical, <1 = bouncy, >1 = overdamped) */\n  damping?: number;\n  /** Object mass (higher = slower) */\n  mass?: number;\n  /** Velocity threshold to consider animation complete */\n  restVelocity?: number;\n  /** Position threshold to consider animation complete */\n  restDelta?: number;\n}\n\n// ============================================================================\n// Default Configurations\n// ============================================================================\n\nconst DEFAULT_SPRING_CONFIG: Required<SpringConfig> = {\n  durationFrames: 20,\n  delay: 0,\n  easing: easeOutCubic,\n};\n\nconst DEFAULT_TIME_SPRING_CONFIG: Required<TimeSpringConfig> = {\n  duration: 300,\n  delay: 0,\n  easing: easeOutCubic,\n};\n\nconst DEFAULT_PHYSICS_CONFIG: Required<PhysicsSpringConfig> = {\n  stiffness: 170,\n  damping: 26,\n  mass: 1,\n  restVelocity: 0.01,\n  restDelta: 0.01,\n};\n\n// ============================================================================\n// Frame-Based Spring (for video/canvas animations)\n// ============================================================================\n\n/**\n * Calculate spring progress for a given frame.\n * Returns 0-1 value representing animation progress.\n *\n * @example\n * // In video component\n * const opacity = spring({ frame, fps: 30, delay: 10, durationFrames: 20 });\n * // opacity animates from 0 to 1 starting at frame 10, over 20 frames\n */\nexport function spring(params: {\n  frame: number;\n  fps: number;\n  delay?: number;\n  durationFrames?: number;\n  easing?: EasingFunction;\n}): number {\n  const {\n    frame,\n    delay = DEFAULT_SPRING_CONFIG.delay,\n    durationFrames = DEFAULT_SPRING_CONFIG.durationFrames,\n    easing = DEFAULT_SPRING_CONFIG.easing,\n  } = params;\n\n  const adjustedFrame = frame - delay;\n  if (adjustedFrame <= 0) return 0;\n  if (adjustedFrame >= durationFrames) return 1;\n\n  const t = adjustedFrame / durationFrames;\n  return easing(t);\n}\n\n/**\n * Calculate staggered spring progress for list items.\n *\n * @example\n * items.map((item, i) => {\n *   const progress = staggeredSpring({ frame, fps: 30, index: i, stagger: 3 });\n *   return <div style={{ opacity: progress }}>{item}</div>;\n * });\n */\nexport function staggeredSpring(params: {\n  frame: number;\n  fps: number;\n  index: number;\n  stagger?: number;\n  delay?: number;\n  durationFrames?: number;\n  easing?: EasingFunction;\n}): number {\n  const { index, stagger = 5, delay = 0, ...rest } = params;\n  return spring({ ...rest, delay: delay + index * stagger });\n}\n\n// ============================================================================\n// Time-Based Spring (for React components)\n// ============================================================================\n\n/**\n * Calculate spring progress for a given timestamp.\n * Useful for CSS animations and manual animation loops.\n *\n * @param elapsed - Milliseconds since animation started\n * @param config - Spring configuration\n * @returns Progress value from 0 to 1\n */\nexport function timeSpring(elapsed: number, config: TimeSpringConfig = {}): number {\n  const { duration, delay, easing } = { ...DEFAULT_TIME_SPRING_CONFIG, ...config };\n\n  const adjustedTime = elapsed - delay;\n  if (adjustedTime <= 0) return 0;\n  if (adjustedTime >= duration) return 1;\n\n  const t = adjustedTime / duration;\n  return easing(t);\n}\n\n// ============================================================================\n// Physics-Based Spring (for smooth, natural motion)\n// ============================================================================\n\nexport interface PhysicsSpringState {\n  value: number;\n  velocity: number;\n  isComplete: boolean;\n}\n\n/**\n * Calculate next state for a physics-based spring.\n * Use this for smooth, natural motion in animation loops.\n *\n * @example\n * let state = { value: 0, velocity: 0, isComplete: false };\n * function animate() {\n *   state = physicsSpring(state.value, 1, state.velocity, 16, config);\n *   element.style.transform = `translateX(${state.value}px)`;\n *   if (!state.isComplete) requestAnimationFrame(animate);\n * }\n */\nexport function physicsSpring(\n  current: number,\n  target: number,\n  velocity: number,\n  deltaMs: number,\n  config: PhysicsSpringConfig = {}\n): PhysicsSpringState {\n  const { stiffness, damping, mass, restVelocity, restDelta } = {\n    ...DEFAULT_PHYSICS_CONFIG,\n    ...config,\n  };\n\n  const dt = deltaMs / 1000; // Convert to seconds\n  const displacement = target - current;\n\n  // Spring force: F = -kx - cv\n  const springForce = stiffness * displacement;\n  const dampingForce = damping * velocity;\n  const acceleration = (springForce - dampingForce) / mass;\n\n  // Update velocity and position\n  const newVelocity = velocity + acceleration * dt;\n  const newValue = current + newVelocity * dt;\n\n  // Check if animation is complete\n  const isComplete =\n    Math.abs(newVelocity) < restVelocity && Math.abs(target - newValue) < restDelta;\n\n  return {\n    value: isComplete ? target : newValue,\n    velocity: isComplete ? 0 : newVelocity,\n    isComplete,\n  };\n}\n\n// ============================================================================\n// Interpolation Utilities\n// ============================================================================\n\n/**\n * Interpolate between two values with optional easing.\n *\n * @example\n * const x = interpolate(progress, [0, 1], [100, 500], { easing: easeOutCubic });\n */\nexport function interpolate(\n  input: number,\n  inputRange: [number, number],\n  outputRange: [number, number],\n  options?: {\n    extrapolateLeft?: 'clamp' | 'extend';\n    extrapolateRight?: 'clamp' | 'extend';\n    easing?: EasingFunction;\n  }\n): number {\n  const [inMin, inMax] = inputRange;\n  const [outMin, outMax] = outputRange;\n  const { extrapolateLeft = 'extend', extrapolateRight = 'extend', easing } = options || {};\n\n  // Clamp input if needed\n  let clampedInput = input;\n  if (extrapolateLeft === 'clamp' && input < inMin) clampedInput = inMin;\n  if (extrapolateRight === 'clamp' && input > inMax) clampedInput = inMax;\n\n  // Calculate normalized progress (0 to 1)\n  let t = (clampedInput - inMin) / (inMax - inMin);\n  t = Math.max(0, Math.min(1, t));\n\n  // Apply easing if provided\n  if (easing) t = easing(t);\n\n  return outMin + t * (outMax - outMin);\n}\n\n/**\n * Interpolate across multiple values.\n *\n * @example\n * const color = interpolateMultiple(progress, [0, 0.5, 1], ['#ff0000', '#00ff00', '#0000ff']);\n */\nexport function interpolateMultiple(\n  input: number,\n  inputRange: number[],\n  outputRange: number[],\n  options?: { easing?: EasingFunction }\n): number {\n  if (inputRange.length !== outputRange.length || inputRange.length < 2) {\n    throw new Error('Input and output ranges must have the same length and at least 2 values');\n  }\n\n  // Find the segment we're in\n  let segmentIndex = 0;\n  for (let i = 0; i < inputRange.length - 1; i++) {\n    if (input >= inputRange[i] && input <= inputRange[i + 1]) {\n      segmentIndex = i;\n      break;\n    }\n    if (input > inputRange[i + 1]) {\n      segmentIndex = i + 1;\n    }\n  }\n\n  const clampedIndex = Math.min(segmentIndex, inputRange.length - 2);\n  return interpolate(\n    input,\n    [inputRange[clampedIndex], inputRange[clampedIndex + 1]],\n    [outputRange[clampedIndex], outputRange[clampedIndex + 1]],\n    options\n  );\n}\n\n/**\n * Simple linear animation progress based on frames.\n */\nexport function linear(frame: number, durationFrames: number): number {\n  return Math.min(1, frame / durationFrames);\n}\n\n// ============================================================================\n// Spring Presets\n// ============================================================================\n\n/** Common spring configurations for different use cases */\nexport const springPresets = {\n  /** Default - smooth, versatile */\n  default: { durationFrames: 20, easing: easeOutCubic } as SpringConfig,\n\n  /** Snappy - quick response */\n  snappy: { durationFrames: 12, easing: easeOutCubic } as SpringConfig,\n\n  /** Slow - deliberate, dramatic */\n  slow: { durationFrames: 40, easing: easeOutCubic } as SpringConfig,\n\n  /** Gentle - subtle motion */\n  gentle: { durationFrames: 30, easing: easeOutCubic } as SpringConfig,\n\n  /** Stagger item delay */\n  staggerDelay: 5,\n} as const;\n\n/** Physics spring presets for natural motion */\nexport const physicsPresets = {\n  /** Default - balanced */\n  default: { stiffness: 170, damping: 26, mass: 1 } as PhysicsSpringConfig,\n\n  /** Gentle - slow, smooth */\n  gentle: { stiffness: 120, damping: 20, mass: 1 } as PhysicsSpringConfig,\n\n  /** Wobbly - playful bounce */\n  wobbly: { stiffness: 180, damping: 12, mass: 1 } as PhysicsSpringConfig,\n\n  /** Stiff - quick, no bounce */\n  stiff: { stiffness: 400, damping: 40, mass: 1 } as PhysicsSpringConfig,\n\n  /** Slow - dramatic, heavy */\n  slow: { stiffness: 100, damping: 30, mass: 2 } as PhysicsSpringConfig,\n} as const;\n","numLines":329,"startLine":1,"totalLines":329}}}
