ats.medConfidence} low={stats.lowConfidence} />\n    44→        </QuickStatCard>\n    45→        <QuickStatCard\n    46→          label=\"Avg Confidence\"\n    47→          value={`${stats.avgConfidence}%`}\n    48→          icon={<TargetIcon />}\n    49→          color={stats.avgConfidence >= 80 ? 'emerald' : stats.avgConfidence >= 50 ? 'amber' : 'red'}\n    50→        >\n    51→          <ProgressBar value={stats.avgConfidence} color=\"auto\" size=\"sm\" />\n    52→        </QuickStatCard>\n    53→        <QuickStatCard\n    54→          label=\"Sources\"\n    55→          value={stats.sources}\n    56→          subtext={`${stats.highCredSources} high credibility`}\n    57→          icon={<LinkIcon />}\n    58→          color=\"emerald\"\n    59→        />\n    60→        <QuickStatCard\n    61→          label=\"Perspectives\"\n    62→          value={stats.perspectives}\n    63→          icon={<UsersIcon />}\n    64→          color=\"slate\"\n    65→        />\n    66→        <QuickStatCard\n    67→          label=\"Red Flags\"\n    68→          value={stats.redFlags}\n    69→          subtext={stats.redFlags > 0 ? 'Review needed' : 'Clear'}\n    70→          icon={<AlertIcon />}\n    71→          color={stats.redFlags > 0 ? 'red' : 'slate'}\n    72→        />\n    73→      </div>\n    74→\n    75→      {/* Warnings Banner */}\n    76→      {allWarnings.length > 0 && (\n    77→        <div className=\"bg-gradient-to-br from-amber-50 to-orange-50 border border-amber-200 rounded-lg p-4\">\n    78→          <div className=\"flex items-center gap-2 text-amber-700 font-semibold text-sm mb-2\">\n    79→            <span className=\"w-4 h-4\"><AlertIcon /></span>\n    80→            Warnings ({allWarnings.length})\n    81→          </div>\n    82→          <ul className=\"space-y-1\">\n    83→            {allWarnings.slice(0, 4).map((w, i) => (\n    84→              <li key={i} className=\"text-sm text-amber-800 pl-6 relative before:content-['•'] before:absolute before:left-2 before:text-amber-400\">\n    85→                {w}\n    86→              </li>\n    87→            ))}\n    88→          </ul>\n    89→        </div>\n    90→      )}\n    91→\n    92→      {/* Key Insights */}\n    93→      {allInsights.length > 0 && (\n    94→        <ThemedSection title=\"Key Insights\" count={allInsights.length}>\n    95→          <ul className=\"space-y-2\">\n    96→            {allInsights.slice(0, 6).map((insight, i) => (\n    97→              <li key={i} className=\"flex items-start gap-2 text-sm text-slate-700 pl-3 border-l-2 border-emerald-400 py-1\">\n    98→                {insight}\n    99→              </li>\n   100→            ))}\n   101→          </ul>\n   102→        </ThemedSection>\n   103→      )}\n   104→\n   105→      {/* Recommendations */}\n   106→      {allRecommendations.length > 0 && (\n   107→        <ThemedSection title=\"Recommended Actions\" count={allRecommendations.length}>\n   108→          <div className=\"space-y-2\">\n   109→            {allRecommendations.slice(0, 5).map((rec, i) => (\n   110→              <div key={i} className=\"flex items-start gap-3 p-2 bg-blue-50 rounded-lg\">\n   111→                <span className=\"w-5 h-5 bg-blue-500 text-white rounded-full flex items-center justify-center text-[10px] font-bold flex-shrink-0 mt-0.5\">\n   112→                  {i + 1}\n   113→                </span>\n   114→                <span className=\"text-sm text-slate-700\">{rec}</span>\n   115→              </div>\n   116→            ))}\n   117→          </div>\n   118→        </ThemedSection>\n   119→      )}\n   120→\n   121→      {/* Gaps */}\n   122→      {stats.gaps > 0 && (\n   123→        <ThemedSection title=\"Research Gaps\" count={stats.gaps}>\n   124→          <div className=\"space-y-2\">\n   125→            {session.gaps?.slice(0, 3).map((gap, i) => (\n   126→              <div key={i} className=\"p-3 bg-violet-50 border-l-3 border-violet-500 rounded-r-lg\">\n   127→                <div className=\"flex items-center gap-2 mb-1\">\n   128→                  <span className=\"text-[10px] font-semibold text-violet-600 uppercase px-1.5 py-0.5 bg-violet-100 rounded\">\n   129→                    {gap.gap_type}\n   130→                  </span>\n   131→                  <span className=\"text-[10px] text-violet-500\">{gap.priority} priority</span>\n   132→                </div>\n   133→                <p className=\"text-sm text-slate-700\">{gap.description}</p>\n   134→              </div>\n   135→            ))}\n   136→          </div>\n   137→        </ThemedSection>\n   138→      )}\n   139→    </div>\n   140→  );\n   141→}\n   142→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"bb700aba-f9fc-4283-93cf-561e37220b63","uuid":"aef53234-e9ca-40b0-9ca6-1cdffc07db5c","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\tabs\\OverviewTab.tsx","content":"'use client';\n\nimport type { SessionWithDetails } from '@/src/types/research';\nimport { QuickStatCard, AlertBanner } from '../shared/Cards';\nimport { ThemedSection } from '../ThemedCards';\nimport { ProgressBar, ConfidenceDistribution } from '../shared/ProgressBar';\nimport { DocumentIcon, LinkIcon, UsersIcon, AlertIcon, TargetIcon } from '../shared/Icons';\n\ninterface OverviewTabProps {\n  session: SessionWithDetails;\n  stats: {\n    findings: number;\n    sources: number;\n    perspectives: number;\n    contradictions: number;\n    gaps: number;\n    avgConfidence: number;\n    highConfidence: number;\n    medConfidence: number;\n    lowConfidence: number;\n    redFlags: number;\n    highCredSources: number;\n    entities: number;\n  };\n}\n\nexport function OverviewTab({ session, stats }: OverviewTabProps) {\n  const allInsights = session.perspectives?.flatMap(p => p.key_insights || []) || [];\n  const allWarnings = session.perspectives?.flatMap(p => p.warnings || []) || [];\n  const allRecommendations = session.perspectives?.flatMap(p => p.recommendations || []) || [];\n\n  return (\n    <div className=\"space-y-4\">\n      {/* Stats Grid */}\n      <div className=\"grid grid-cols-2 md:grid-cols-5 gap-3\">\n        <QuickStatCard\n          label=\"Findings\"\n          value={stats.findings}\n          subtext={`${stats.highConfidence} high confidence`}\n          icon={<DocumentIcon />}\n          color=\"blue\"\n        >\n          <ConfidenceDistribution high={stats.highConfidence} medium={stats.medConfidence} low={stats.lowConfidence} />\n        </QuickStatCard>\n        <QuickStatCard\n          label=\"Avg Confidence\"\n          value={`${stats.avgConfidence}%`}\n          icon={<TargetIcon />}\n          color={stats.avgConfidence >= 80 ? 'emerald' : stats.avgConfidence >= 50 ? 'amber' : 'red'}\n        >\n          <ProgressBar value={stats.avgConfidence} color=\"auto\" size=\"sm\" />\n        </QuickStatCard>\n        <QuickStatCard\n          label=\"Sources\"\n          value={stats.sources}\n          subtext={`${stats.highCredSources} high credibility`}\n          icon={<LinkIcon />}\n          color=\"emerald\"\n        />\n        <QuickStatCard\n          label=\"Perspectives\"\n          value={stats.perspectives}\n          icon={<UsersIcon />}\n          color=\"slate\"\n        />\n        <QuickStatCard\n          label=\"Red Flags\"\n          value={stats.redFlags}\n          subtext={stats.redFlags > 0 ? 'Review needed' : 'Clear'}\n          icon={<AlertIcon />}\n          color={stats.redFlags > 0 ? 'red' : 'slate'}\n        />\n      </div>\n\n      {/* Warnings Banner */}\n      {allWarnings.length > 0 && (\n        <div className=\"bg-gradient-to-br from-amber-50 to-orange-50 border border-amber-200 rounded-lg p-4\">\n          <div className=\"flex items-center gap-2 text-amber-700 font-semibold text-sm mb-2\">\n            <span className=\"w-4 h-4\"><AlertIcon /></span>\n            Warnings ({allWarnings.length})\n          </div>\n          <ul className=\"space-y-1\">\n            {allWarnings.slice(0, 4).map((w, i) => (\n              <li key={i} className=\"text-sm text-amber-800 pl-6 relative before:content-['•'] before:absolute before:left-2 before:text-amber-400\">\n                {w}\n              </li>\n            ))}\n          </ul>\n        </div>\n      )}\n\n      {/* Key Insights */}\n      {allInsights.length > 0 && (\n        <ThemedSection title=\"Key Insights\" count={allInsights.length}>\n          <ul className=\"space-y-2\">\n            {allInsights.slice(0, 6).map((insight, i) => (\n              <li key={i} className=\"flex items-start gap-2 text-sm text-slate-700 pl-3 border-l-2 border-emerald-400 py-1\">\n                {insight}\n              </li>\n            ))}\n          </ul>\n        </ThemedSection>\n      )}\n\n      {/* Recommendations */}\n      {allRecommendations.length > 0 && (\n        <ThemedSection title=\"Recommended Actions\" count={allRecommendations.length}>\n          <div className=\"space-y-2\">\n            {allRecommendations.slice(0, 5).map((rec, i) => (\n              <div key={i} className=\"flex items-start gap-3 p-2 bg-blue-50 rounded-lg\">\n                <span className=\"w-5 h-5 bg-blue-500 text-white rounded-full flex items-center justify-center text-[10px] font-bold flex-shrink-0 mt-0.5\">\n                  {i + 1}\n                </span>\n                <span className=\"text-sm text-slate-700\">{rec}</span>\n              </div>\n            ))}\n          </div>\n        </ThemedSection>\n      )}\n\n      {/* Gaps */}\n      {stats.gaps > 0 && (\n        <ThemedSection title=\"Research Gaps\" count={stats.gaps}>\n          <div className=\"space-y-2\">\n            {session.gaps?.slice(0, 3).map((gap, i) => (\n              <div key={i} className=\"p-3 bg-violet-50 border-l-3 border-violet-500 rounded-r-lg\">\n                <div className=\"flex items-center gap-2 mb-1\">\n                  <span className=\"text-[10px] font-semibold text-violet-600 uppercase px-1.5 py-0.5 bg-violet-100 rounded\">\n                    {gap.gap_type}\n                  </span>\n                  <span className=\"text-[10px] text-violet-500\">{gap.priority} priority</span>\n                </div>\n                <p className=\"text-sm text-slate-700\">{gap.description}</p>\n              </div>\n            ))}\n          </div>\n        </ThemedSection>\n      )}\n    </div>\n  );\n}\n","numLines":142,"startLine":1,"totalLines":142}}}
