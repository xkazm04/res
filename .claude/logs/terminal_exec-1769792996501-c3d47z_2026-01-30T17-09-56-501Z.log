g\n3. **Automatic change detection** - `useLensDataChanges()` hook for animation triggers\n4. **Composable** - Lenses can be reordered, extended, or composed declaratively\n5. **Type-safe** - Full TypeScript inference from session data to view props\n6. **Backward compatible** - Legacy tab components still available\n\n### Usage Example\n\n```tsx\nimport { LensProvider, LensTabBar, LensRenderer, registerAllLenses } from '@/src/components/report/tabs';\n\n// Register all lenses once\nregisterAllLenses();\n\nfunction ReportView({ session }) {\n  return (\n    <LensProvider session={session} initialLensId=\"overview\">\n      <LensTabBar variant=\"pills\" />\n      <LensRenderer />\n    </LensProvider>\n  );\n}\n```"}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":286,"cache_read_input_tokens":111777,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":286},"output_tokens":1,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"bb700aba-f9fc-4283-93cf-561e37220b63","uuid":"4527ea0e-f325-471f-a324-afcf6a34de46"}
