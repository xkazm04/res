cted' | 'past' | 'present' | 'prediction';\n    50→\n    51→export type DecompositionStrategy = 'temporal' | 'thematic' | 'actor' | 'hybrid' | 'none';\n    52→\n    53→export type CompositionRole = 'background' | 'primary' | 'synthesis' | 'equal';\n    54→\n    55→export type GapType = 'temporal' | 'actor' | 'topic' | 'evidence' | 'geographic';\n    56→\n    57→export type GapPriority = 'high' | 'medium' | 'low';\n    58→\n    59→export type TopicType = 'domain' | 'event' | 'entity' | 'concept' | 'region' | 'timeperiod';\n    60→\n    61→export type EntityRole = 'subject' | 'object' | 'actor' | 'target' | 'location' | 'mentioned' | 'source' | 'beneficiary';\n    62→\n    63→// ============================================\n    64→// CORE ENTITIES\n    65→// ============================================\n    66→\n    67→export interface ResearchSession {\n    68→  id: string;\n    69→  user_id?: string;\n    70→  workspace_id: string;\n    71→  title: string;\n    72→  query: string;\n    73→  template_type: string;\n    74→  status: SessionStatus;\n    75→  primary_topic_id?: string;\n    76→  topic_ids: string[];\n    77→  parameters: Record<string, unknown>;\n    78→  claim_count: number;\n    79→  source_count: number;\n    80→  /** Thematic group for grouping sessions within templates (e.g., \"Jeffrey Epstein\", \"Cryptocurrency\") */\n    81→  thematic_group?: string;\n    82→  created_at: string;\n    83→  updated_at: string;\n    84→  completed_at?: string;\n    85→}\n    86→\n    87→export interface ResearchFinding {\n    88→  id: string;\n    89→  session_id: string;\n    90→  finding_type: FindingType;\n    91→  content: string;\n    92→  summary?: string;\n    93→  perspective?: string;\n    94→  confidence_score?: number;\n    95→  supporting_sources: string[];\n    96→  temporal_context?: TemporalContext;\n    97→  event_date?: string;\n    98→  date_range_start?: string;\n    99→  date_range_end?: string;\n   100→  related_findings: string[];\n   101→  c