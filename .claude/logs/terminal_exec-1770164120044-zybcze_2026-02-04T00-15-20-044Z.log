tchesConfidenceFilter(f.confidence_score || 0, filterConfidence as ConfidenceFilterOption)) {\n    42→        return false;\n    43→      }\n    44→      return true;\n    45→    });\n    46→  }, [findings, searchQuery, filterType, filterConfidence]);\n    47→\n    48→  const sourceMap = useMemo(() => {\n    49→    const map = new Map<string, ResearchSource>();\n    50→    sources.forEach((s) => map.set(s.id, s));\n    51→    return map;\n    52→  }, [sources]);\n    53→\n    54→  // Reset focus when filters change\n    55→  useEffect(() => {\n    56→    setFocusedIndex(-1);\n    57→  }, [searchQuery, filterType, filterConfidence]);\n    58→\n    59→  const toggleExpanded = useCallback((id: string) => {\n    60→    setExpandedIds((prev) => {\n    61→      const next = new Set(prev);\n    62→      if (next.has(id)) {\n    63→        next.delete(id);\n    64→      } else {\n    65→        next.add(id);\n    66→      }\n    67→      return next;\n    68→    });\n    69→  }, []);\n    70→\n    71→  const scrollToFinding = useCallback((index: number) => {\n    72→    const el = findingRefs.current.get(index);\n    73→    if (el) {\n    74→      el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });\n    75→    }\n    76→  }, []);\n    77→\n    78→  // Keyboard navigation\n    79→  useEffect(() => {\n    80→    const handleKeyDown = (e: KeyboardEvent) => {\n    81→      // Only handle if container or its children have focus, or no specific element is focused\n    82→      const activeElement = document.activeElement;\n    83→      const isInContainer = containerRef.current?.contains(activeElement);\n    84→      const isBodyFocused = activeElement === document.body;\n    85→\n    86→      if (!isInContainer && !isBodyFocused) return;\n    87→\n    88→      // Don't interfere with input fields\n    89→      if (activeElement?.tagName === 'INPUT' || activeElement?.tagName === 'TEXTAREA') return;\n    90→\n    91→      switch (e.key) {\n    92→        case 'j':\n    93→        case 'ArrowDown':\n    94→          e.preventDefault();\n    95→          setFocusedIndex((prev) => {\n    96→            const next = Math.min(prev + 1, filteredFindings.length - 1);\n    97→            scrollToFinding(next);\n    98→            return next;\n    99→          });\n   100→          break;\n   101→        case 'k':\n   102→        case 'ArrowUp':\n   103→          e.preventDefault();\n   104→          setFocusedIndex((prev) => {\n   105→            const next = Math.max(prev - 1, 0);\n   106→            scrollToFinding(next);\n   107→            return next;\n   108→          });\n   109→          break;\n   110→        case 'Enter':\n   111→        case ' ':\n   112→          if (focusedIndex >= 0 && focusedIndex < filteredFindings.length) {\n   113→            e.preventDefault();\n   114→            toggleExpanded(filteredFindings[focusedIndex].id);\n   115→          }\n   116→          break;\n   117→        case 'Escape':\n   118→          setFocusedIndex(-1);\n   119→          break;\n   120→      }\n   121→    };\n   122→\n   123→    document.addEventListener('keydown', handleKeyDown);\n   124→    return () => document.removeEventListener('keydown', handleKeyDown);\n   125→  }, [filteredFindings, focusedIndex, toggleExpanded, scrollToFinding]);\n   126→\n   127→  const setFindingRef = useCallback((index: number, el: HTMLDivElement | null) => {\n   128→    if (el) {\n   129→      findingRefs.current.set(index, el);\n   130→    } else {\n   131→      findingRefs.current.delete(index);\n   132→    }\n   133→  }, []);\n   134→\n   135→  if (filteredFindings.length === 0) {\n   136→    return <EmptyState type=\"search\" title=\"No findings match your filters\" />;\n   137→  }\n   138→\n   139→  return (\n   140→    <ThemedSection title=\"Findings\" count={filteredFindings.length}>\n   141→      <div ref={containerRef} className=\"space-y-2\" tabIndex={-1}>\n   142→        {filteredFindings.map((finding, index) => (\n   143→          <FindingCard\n   144→            key={finding.id}\n   145→            finding={finding}\n   146→            sourceMap={sourceMap}\n   147→            isFocused={focusedIndex === index}\n   148→            isExpanded={expandedIds.has(finding.id)}\n   149→            onToggleExpanded={() => toggleExpanded(finding.id)}\n   150→            onFocus={() => setFocusedIndex(index)}\n   151→            ref={(el) => setFindingRef(index, el)}\n   152→          />\n   153→        ))}\n   154→      </div>\n   155→      {filteredFindings.length > 0 && (\n   156→        <div className=\"mt-3 text-[10px] text-slate-400 flex items-center gap-2\">\n   157→          <kbd className=\"px-1.5 py-0.5 bg-slate-100 border border-slate-200 rounded text-[9px] font-mono\">j</kbd>\n   158→          <kbd className=\"px-1.5 py-0.5 bg-slate-100 border border-slate-200 rounded text-[9px] font-mono\">k</kbd>\n   159→          <span>navigate</span>\n   160→          <kbd className=\"px-1.5 py-0.5 bg-slate-100 border border-slate-200 rounded text-[9px] font-mono\">Enter</kbd>\n   161→          <span>expand</span>\n   162→        </div>\n   163→      )}\n   164→    </ThemedSection>\n   165→  );\n   166→}\n   167→\n   168→interface FindingCardProps {\n   169→  finding: ResearchFinding;\n   170→  sourceMap: Map<string, ResearchSource>;\n   171→  isFocused: boolean;\n   172→  isExpanded: boolean;\n   173→  onToggleExpanded: () => void;\n   174→  onFocus: () => void;\n   175→}\n   176→\n   177→const FindingCard = forwardRef<HTMLDivElement, FindingCardProps>(function FindingCard(\n   178→  { finding, sourceMap, isFocused, isExpanded, onToggleExpanded, onFocus },\n   179→  ref\n   180→) {\n   181→  const supportingSources = finding.supporting_sources || [];\n   182→  const confidence = finding.confidence_score || 0;\n   183→\n   184→  // Get summary (first sentence or first 120 chars)\n   185→  const summary = finding.content.split('.')[0] + '.';\n   186→\n   187→  return (\n   188→    <UniversalCard\n   189→      