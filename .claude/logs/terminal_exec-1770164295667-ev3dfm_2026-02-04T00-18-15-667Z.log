[2026-02-04T00:18:35.622Z] [STDOUT] {"type":"assistant","message":{"model":"claude-opus-4-5-20251101","id":"msg_01Pw5jf6gmAWEntXunTWKshn","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01XbpoFbXQepGndqc97ScdRQ","name":"Read","input":{"file_path":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\visualizations\\network\\AdvancedNetworkGraph.tsx"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":254,"cache_read_input_tokens":50862,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":254},"output_tokens":25,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"d184f0d2-244e-457f-8ea5-4627f2d647f1","uuid":"78d54755-de75-45c9-b843-38daec55e252"}
[2026-02-04T00:18:37.584Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XbpoFbXQepGndqc97ScdRQ","type":"tool_result","content":"     1→'use client';\n     2→\n     3→/**\n     4→ * AdvancedNetworkGraph\n     5→ *\n     6→ * A professional-grade force-directed graph visualization component with:\n     7→ * - WebGL-accelerated canvas rendering for 500+ nodes\n     8→ * - Hierarchical clustering with expandable groups\n     9→ * - Shortest path highlighting\n    10→ * - Multiple layout algorithms\n    11→ * - Edge bundling for dense graphs\n    12→ * - Minimap navigation\n    13→ * - Node search and filtering\n    14→ */\n    15→\n    16→import { useRef, useEffect, useState, useCallback, useMemo } from 'react';\n    17→import { motion, AnimatePresence } from 'framer-motion';\n    18→import { useVisualizationTheme } from '../useVisualizationTheme';\n    19→import { useForceGraph, type LayoutAlgorithm } from '@/src/hooks/useForceGraph';\n    20→import type { GraphNode, GraphEdge, Cluster, BundledEdge } from '@/src/lib/graphAlgorithms';\n    21→import { GraphMinimap } from './GraphMinimap';\n    22→import { LayoutSwitcher } from './LayoutSwitcher';\n    23→import { GraphFilterPanel } from './GraphFilterPanel';\n    24→import { PathFinder } from './PathFinder';\n    25→import { GraphExporter } from './GraphExporter';\n    26→import { cn } from '@/src/lib/utils';\n    27→import {\n    28→  Search,\n    29→  ZoomIn,\n    30→  ZoomOut,\n    31→  Maximize2,\n    32→  RotateCcw,\n    33→  Layers,\n    34→  GitBranch,\n    35→  Filter,\n    36→  X,\n    37→} from 'lucide-react';\n    38→\n    39→// ============================================================================\n    40→// Types\n    41→// ============================================================================\n    42→\n    43→export interface AdvancedNetworkGraphProps {\n    44→  nodes: GraphNode[];\n    45→  edges: GraphEdge[];\n    46→  width?: number;\n    47→  height?: number;\n    48→  className?: string;\n    49→  onNodeClick?: (node: GraphNode) => void;\n    50→  onEdgeClick?: (edge: GraphEdge) => void;\n    51→  showMinimap?: boolean;\n    52→  showControls?: boolean;\n    53→  showSearch?: boolean;\n    54→  enableClustering?: boolean;\n    55→  enableEdgeBundling?: boolean;\n    56→  enablePathFinding?: boolean;\n    57→  initialLayout?: LayoutAlgorithm;\n    58→}\n    59→\n    60→interface RenderContext {\n    61→  ctx: CanvasRenderingContext2D;\n    62→  width: number;\n    63→  height: number;\n    64→  viewState: { zoom: number; panX: number; panY: number };\n    65→  isRadar: boolean;\n    66→  colors: ReturnType<typeof useVisualizationTheme>['colors'];\n    67→  entityColors: ReturnType<typeof useVisualizationTheme>['entityColors'];\n    68→  selection: Set<string>;\n    69→  highlightedNode: string | null;\n    70→  pathNodes: Set<string>;\n    71→  pathEdges: Set<string>;\n    72→  matchingNodeIds: Set<string>;\n    73→  hoveredNode: string | null;\n    74→  clusters: Cluster[];\n    75→  showClusters: boolean;\n    76→}\n    77→\n    78→// ============================================================================\n    79→// Rendering Utilities\n    80→// ============================================================================\n    81→\n    82→function transformPoint(\n    83→  x: number,\n    84→  y: number,\n    85→  viewState: { zoom: number; panX: number; panY: number }\n    86→): { x: number; y: number } {\n    87→  return {\n    88→    x: x * viewState.zoom + viewState.panX,\n    89→    y: y * viewState.zoom + viewState.panY,\n    90→  };\n    91→}\n    92→\n    93→function inverseTransformPoint(\n    94→  screenX: number,\n    95→  screenY: number,\n    96→  viewState: { zoom: number; panX: number; panY: number }\n    97→): { x: number; y: number } {\n    98→  return {\n    99→    x: (screenX - viewState.panX) / viewState.zoom,\n   100→    y: (screenY - viewState.panY) / viewState.zoom,\n   101→  };\n   102→}\n   103→\n   104→function drawClusters(ctx: RenderContext, clusters: Cluster[]): void {\n   105→  const { ctx: c, viewState, isRadar, colors } = ctx;\n   106→\n   107→  clusters.forEach((cluster, i) => {\n   108→    const pos = transformPoint(cluster.x, cluster.y, viewState);\n   109→    const scaledRadius = cluster.radius * viewState.zoom;\n   110→\n   111→    // Cluster background\n   112→    const hue = (i * 137.5) % 360;\n   113→    const clusterColor = isRadar\n   114→      ? `hsla(${hue}, 70%, 50%, 0.08)`\n   115→      : `hsla(${hue}, 60%, 60%, 0.06)`;\n   116→\n   117→    c.beginPath();\n   118→    c.arc(pos.x, pos.y, scaledRadius, 0, Math.PI * 2);\n   119→    c.fillStyle = clusterColor;\n   120→    c.fill();\n   121→\n   122→    // Cluster border\n   123→    c.strokeStyle = isRadar\n   124→      ? `hsla(${hue}, 70%, 50%, 0.3)`\n   125→      : `hsla(${hue}, 60%, 40%, 0.2)`;\n   126→    c.lineWidth = 1;\n   127→    c.setLineDash([4, 4]);\n   128→    c.stroke();\n   129→    c.setLineDash([]);\n   130→\n   131→    // Cluster label\n   132→    if (cluster.label) {\n   133→      c.font = '10px Inter, system-ui, sans-serif';\n   134→      c.fillStyle = colors.textMuted;\n   135→      c.textAlign = 'center';\n   136→      c.fillText(cluster.label, pos.x, pos.y - scaledRadius - 8);\n   137→    }\n   138→  });\n   139→}\n   140→\n   141→function drawEdge(\n   142→  ctx: RenderContext,\n   143→  edge: GraphEdge | BundledEdge,\n   144→  sourceNode: GraphNode,\n   145→  targetNode: GraphNode\n   146→): void {\n   147→  const { ctx: c, viewState, isRadar, colors, selection, pathEdges } = ctx;\n   148→\n   149→  const isInPath = pathEdges.has(edge.id);\n   150→  const isSelected = selection.has(edge.source) || selection.has(edge.target);\n   151→\n   152→  let strokeColor = colors.connectionLine;\n   153→  let lineWidth = 1;\n   154→  let opacity = 0.5;\n   155→\n   156→  if (edge.type === 'contradicts') {\n   157→    strokeColor = colors.contradictionLine;\n   158→    lineWidth = 2;\n   159→  } else if (edge.type === 'supports') {\n   160→    strokeColor = colors.success;\n   161→  }\n   162→\n   163→  if (isInPath) {\n   164→    strokeColor = isRadar ? '#fbbf24' : '#d97706';\n   165→    lineWidth = 3;\n   166→    opacity = 1;\n   167→  } else if (isSelected) {\n   168→    opacity = 0.8;\n   169→    lineWidth = 2;\n   170→  }\n   171→\n   172→  c.strokeStyle = strokeColor;\n   173→  c.lineWidth = lineWidth;\n   174→  c.globalAlpha = opacity;\n   175→\n   176→  const bundled = edge as BundledEdge;\n   177→  if (bundled.controlPoints && bundled.controlPoints.length > 2) {\n   178→    // Draw bundled edge as bezier curve\n   179→    c.beginPath();\n   180→    const start = transformPoint(bundled.controlPoints[0].x, bundled.controlPoints[0].y, viewState);\n   181→    c.moveTo(start.x, start.y);\n   182→\n   183→    for (let i = 1; i < bundled.controlPoints.length - 1; i += 2) {\n   184→      const cp = transformPoint(bundled.controlPoints[i].x, bundled.controlPoints[i].y, viewState);\n   185→      const end = transformPoint(\n   186→        bundled.controlPoints[Math.min(i + 1, bundled.controlPoints.length - 1)].x,\n   187→        bundled.controlPoints[Math.min(i + 1, bundled.controlPoints.length - 1)].y,\n   188→        viewState\n   189→      );\n   190→      c.quadraticCurveTo(cp.x, cp.y, end.x, end.y);\n   191→    }\n   192→    c.stroke();\n   193→  } else {\n   194→    // Draw straight edge\n   195→    const source = transformPoint(sourceNode.x, sourceNode.y, viewState);\n   196→    const target = transformPoint(targetNode.x, targetNode.y, viewState);\n   197→\n   198→    c.beginPath();\n   199→    c.moveTo(source.x, source.y);\n   200→    c.lineTo(target.x, target.y);\n   201→    c.stroke();\n   202→\n   203→    // Arrowhead\n   204→    if (isInPath || isSelected) {\n   205→      const dx = target.x - source.x;\n   206→      const dy = target.y - source.y;\n   207→      const angle = Math.atan2(dy, dx);\n   208→      const arrowSize = 8;\n   209→      const nodeRadius = (targetNode.radius ?? 8) * viewState.zoom;\n   210→\n   211→      const arrowX = target.x - Math.cos(angle) * nodeRadius;\n   212→      const arrowY = target.y - Math.sin(angle) * nodeRadius;\n   213→\n   214→      c.beginPath();\n   215→      c.moveTo(arrowX, arrowY);\n   216→      c.lineTo(\n   217→        arrowX - arrowSize * Math.cos(angle - Math.PI / 6),\n   218→        arrowY - arrowSize * Math.sin(angle - Math.PI / 6)\n   219→      );\n   220→      c.lineTo(\n   221→        arrowX - arrowSize * Math.cos(angle + Math.PI / 6),\n   222→        arrowY - arrowSize * Math.sin(angle + Math.PI / 6)\n   223→      );\n   224→      c.closePath();\n   225→      c.fillStyle = strokeColor;\n   226→      c.fill();\n   227→    }\n   228→  }\n   229→\n   230→  c.globalAlpha = 1;\n   231→}\n   232→\n   233→function drawNode(ctx: RenderContext, node: GraphNode): void {\n   234→  const {\n   235→    ctx: c,\n   236→    viewState,\n   237→    isRadar,\n   238→    colors,\n   239→    entityColors,\n   240→    selection,\n   241→    highlightedNode,\n   242→    pathNodes,\n   243→    matchingNodeIds,\n   244→    hoveredNode,\n   245→  } = ctx;\n   246→\n   247→  const pos = transformPoint(node.x, node.y, viewState);\n   248→  const radius = (node.radius ?? 8) * viewState.zoom;\n   249→  const isSelected = selection.has(node.id);\n   250→  const isHighlighted = highlightedNode === node.id;\n   251→  const isInPath = pathNodes.has(node.id);\n   252→  const isSearchMatch = matchingNodeIds.has(node.id);\n   253→  const isHovered = hoveredNode === node.id;\n   254→\n   255→  // Get color based on type\n   256→  const typeKey = (node.type?.toLowerCase() ?? 'other') as keyof typeof entityColors;\n   257→  let fillColor = entityColors[typeKey] ?? entityColors.other;\n   258→\n   259→  if (isInPath) {\n   260→    fillColor = isRadar ? '#fbbf24' : '#d97706';\n   261→  }\n   262→\n   263→  // Glow effect for highlighted/selected nodes\n   264→  if (isHighlighted || isSelected || isInPath || isSearchMatch) {\n   265→    const gradient = c.createRadialGradient(pos.x, pos.y, radius * 0.5, pos.x, pos.y, radius * 2.5);\n   266→    gradient.addColorStop(0, isRadar ? `${fillColor}40` : `${fillColor}30`);\n   267→    gradient.addColorStop(1, 'transparent');\n   268→    c.fillStyle = gradient;\n   269→    c.beginPath();\n   270→    c.arc(pos.x, pos.y, radius * 2.5, 0, Math.PI * 2);\n   271→    c.fill();\n   272→  }\n   273→\n   274→  // Node shadow\n   275→  if (!isRadar) {\n   276→    c.shadowColor = 'rgba(0,0,0,0.1)';\n   277→    c.shadowBlur = 8;\n   278→    c.shadowOffsetX = 0;\n   279→    c.shadowOffsetY = 2;\n   280→  }\n   281→\n   282→  // Node circle\n   283→  c.beginPath();\n   284→  c.arc(pos.x, pos.y, radius, 0, Math.PI * 2);\n   285→  c.fillStyle = fillColor;\n   286→  c.fill();\n   287→\n   288→  // Node border\n   289→  c.strokeStyle = isSelected || isHighlighted || isHovered\n   290→    ? (isRadar ? '#fff' : '#1c1917')\n   291→    : (isRadar ? 'rgba(255,255,255,0.3)' : 'rgba(0,0,0,0.1)');\n   292→  c.lineWidth = isSelected || isHighlighted ? 2 : 1;\n   293→  c.stroke();\n   294→\n   295→  // Reset shadow\n   296→  c.shadowColor = 'transparent';\n   297→  c.shadowBlur = 0;\n   298→  c.shadowOffsetX = 0;\n   299→  c.shadowOffsetY = 0;\n   300→\n   301→  // Pin indicator\n   302→  if (node.fixed) {\n   303→    c.fillStyle = colors.textPrimary;\n   304→    c.beginPath();\n   305→    c.arc(pos.x + radius * 0.7, pos.y - radius * 0.7, 3, 0, Math.PI * 2);\n   306→    c.fill();\n   307→  }\n   308→\n   309→  // Node label (only show when zoomed in or hovered/selected)\n   310→  if (viewState.zoom > 0.8 || isHovered || isSelected || isHighlighted) {\n   311→    const label = node.label ?? node.id;\n   312→    const maxLen = 12;\n   313→    const displayLabel = label.length > maxLen ? label.slice(0, maxLen - 1) + '…' : label;\n   314→\n   315→    c.font = `${isSelected || isHighlighted ? 'bold ' : ''}${10 * Math.min(viewState.zoom, 1.5)}px Inter, system-ui, sans-serif`;\n   316→    c.textAlign = 'center';\n   317→    c.textBaseline = 'top';\n   318→\n   319→    // Label background\n   320→    const textMetrics = c.measureText(displayLabel);\n   321→    const labelY = pos.y + radius + 4;\n   322→    const padding = 3;\n   323→\n   324→    c.fillStyle = isRadar ? 'rgba(15, 23, 42, 0.8)' : 'rgba(255, 255, 255, 0.9)';\n   325→    c.fillRect(\n   326→      pos.x - textMetrics.width / 2 - padding,\n   327→      labelY - 1,\n   328→      textMetrics.width + padding * 2,\n   329→      12 + padding\n   330→    );\n   331→\n   332→    c.fillStyle = isSelected || isHighlighted ? colors.textPrimary : colors.textSecondary;\n   333→    c.fillText(displayLabel, pos.x, labelY);\n   334→  }\n   335→}\n   336→\n   337→// ============================================================================\n   338→// Main Component\n   339→// ============================================================================\n   340→\n   341→export function AdvancedNetworkGraph({\n   342→  nodes,\n   343→  edges,\n   344→  width: propWidth,\n   345→  height: propHeight,\n   346→  className,\n   347→  onNodeClick,\n   348→  onEdgeClick,\n   349→  showMinimap = true,\n   350→  showControls = true,\n   351→  showSearch = true,\n   352→  enableClustering = true,\n   353→  enableEdgeBundling = false,\n   354→  enablePathFinding = true,\n   355→  initialLayout = 'force',\n   356→}: AdvancedNetworkGraphProps) {\n   357→  // Refs\n   358→  const containerRef = useRef<HTMLDivElement>(null);\n   359→  const canvasRef = useRef<HTMLCanvasElement>(null);\n   360→  const animationFrameRef = useRef<number | undefined>(undefined);\n   361→\n   362→  // Theme\n   363→  const { colors, entityColors, isRadar, cardClasses, surfaceClasses, tooltipClasses } =\n   364→    useVisualizationTheme();\n   365→\n   366→  // Dimensions\n   367→  const [dimensions, setDimensions] = useState({ width: propWidth ?? 800, height: propHeight ?? 600 });\n   368→\n   369→  useEffect(() => {\n   370→    if (propWidth && propHeight) {\n   371→      setDimensions({ width: propWidth, height: propHeight });\n   372→      return;\n   373→    }\n   374→\n   375→    if (!containerRef.current) return;\n   376→\n   377→    const observer = new ResizeObserver((entries) => {\n   378→      const entry = entries[0];\n   379→      if (entry) {\n   380→        setDimensions({\n   381→          width: entry.contentRect.width,\n   382→          height: entry.contentRect.height,\n   383→        });\n   384→      }\n   385→    });\n   386→\n   387→    observer.observe(containerRef.current);\n   388→    return () => observer.disconnect();\n   389→  }, [propWidth, propHeight]);\n   390→\n   391→  // Graph state\n   392→  const graph = useForceGraph({\n   393→    nodes,\n   394→    edges,\n   395→    width: dimensions.width,\n   396→    height: dimensions.height,\n   397→    initialLayout,\n   398→    enableClustering,\n   399→    enableEdgeBundling,\n   400→    onNodeClick,\n   401→    onEdgeClick,\n   402→  });\n   403→\n   404→  // UI state\n   405→  const [showFilterPanel, setShowFilterPanel] = useState(false);\n   406→  const [showPathFinder, setShowPathFinder] = useState(false);\n   407→  const [showClusters, setShowClusters] = useState(true);\n   408→  const [hoveredNode, setHoveredNode] = useState<string | null>(null);\n   409→  const [searchQuery, setSearchQuery] = useState('');\n   410→  const [isDragging, setIsDragging] = useState(false);\n   411→  const [draggedNode, setDraggedNode] = useState<string | null>(null);\n   412→  const [lastPointer, setLastPointer] = useState({ x: 0, y: 0 });\n   413→\n   414→  // Create node map for quick lookup\n   415→  const nodeMap = useMemo(\n   416→    () => new Map(graph.layoutNodes.map((n) => [n.id, n])),\n   417→    [graph.layoutNodes]\n   418→  );\n   419→\n   420→  // Path nodes and edges sets\n   421→  const pathNodes = useMemo(\n   422→    () => new Set(graph.currentPath?.path ?? []),\n   423→    [graph.currentPath]\n   424→  );\n   425→  const pathEdges = useMemo(\n   426→    () => new Set(graph.currentPath?.edges ?? []),\n   427→    [graph.currentPath]\n   428→  );\n   429→\n   430→  // Search results\n   431→  const searchResults = useMemo(() => {\n   432→    if (!searchQuery) return [];\n   433→    return graph.searchNodes(searchQuery);\n   434→  }, [graph, searchQuery]);\n   435→\n   436→  // Render loop\n   437→  useEffect(() => {\n   438→    const canvas = canvasRef.current;\n   439→    if (!canvas) return;\n   440→\n   441→    const ctx = canvas.getContext('2d');\n   442→    if (!ctx) return;\n   443→\n   444→    const dpr = window.devicePixelRatio || 1;\n   445→    canvas.width = dimensions.width * dpr;\n   446→    canvas.height = dimensions.height * dpr;\n   447→    canvas.style.width = `${dimensions.width}px`;\n   448→    canvas.style.height = `${dimensions.height}px`;\n   449→    ctx.scale(dpr, dpr);\n   450→\n   451→    const render = () => {\n   452→      ctx.clearRect(0, 0, dimensions.width, dimensions.height);\n   453→\n   454→      const renderCtx: RenderContext = {\n   455→        ctx,\n   456→        width: dimensions.width,\n   457→        height: dimensions.height,\n   458→        viewState: graph.viewState,\n   459→        isRadar,\n   460→        colors,\n   461→        entityColors,\n   462→        selection: graph.selection.nodes,\n   463→        highlightedNode: graph.highlightedNode,\n   464→        pathNodes,\n   465→        pathEdges,\n   466→        matchingNodeIds: graph.matchingNodeIds,\n   467→        hoveredNode,\n   468→        clusters: graph.clusters,\n   469→        showClusters,\n   470→      };\n   471→\n   472→      // Draw clusters\n   473→      if (showClusters && graph.clusters.length > 0) {\n   474→        drawClusters(renderCtx, graph.clusters);\n   475→      }\n   476→\n   477→      // Draw edges\n   478→      const edgesToDraw = graph.bundledEdges.length > 0 ? graph.bundledEdges : graph.filteredEdges;\n   479→      edgesToDraw.forEach((edge) => {\n   480→        const sourceNode = nodeMap.get(edge.source);\n   481→        const targetNode = nodeMap.get(edge.target);\n   482→        if (sourceNode && targetNode) {\n   483→          drawEdge(renderCtx, edge, sourceNode, targetNode);\n   484→        }\n   485→      });\n   486→\n   487→      // Draw nodes\n   488→      graph.layoutNodes.forEach((node) => {\n   489→        drawNode(renderCtx, node);\n   490→      });\n   491→\n   492→      animationFrameRef.current = requestAnimationFrame(render);\n   493→    };\n   494→\n   495→    render();\n   496→\n   497→    return () => {\n   498→      if (animationFrameRef.current) {\n   499→        cancelAnimationFrame(animationFrameRef.current);\n   500→      }\n   501→    };\n   502→  }, [\n   503→    dimensions,\n   504→    graph.viewState,\n   505→    graph.layoutNodes,\n   506→    graph.filteredEdges,\n   507→    graph.bundledEdges,\n   508→    graph.clusters,\n   509→    graph.selection,\n   510→    graph.highlightedNode,\n   511→    graph.matchingNodeIds,\n   512→    nodeMap,\n   513→    pathNodes,\n   514→    pathEdges,\n   515→    hoveredNode,\n   516→    showClusters,\n   517→    isRadar,\n   518→    colors,\n   519→    entityColors,\n   520→  ]);\n   521→\n   522→  // Pointer handlers\n   523→  const findNodeAtPoint = useCallback(\n   524→    (screenX: number, screenY: number): GraphNode | null => {\n   525→      const point = inverseTransformPoint(screenX, screenY, graph.viewState);\n   526→\n   527→      for (const node of graph.layoutNodes) {\n   528→        const radius = node.radius ?? 8;\n   529→        const dx = point.x - node.x;\n   530→        const dy = point.y - node.y;\n   531→        if (dx * dx + dy * dy <= radius * radius) {\n   532→          return node;\n   533→        }\n   534→      }\n   535→      return null;\n   536→    },\n   537→    [graph.layoutNodes, graph.viewState]\n   538→  );\n   539→\n   540→  const handlePointerDown = useCallback(\n   541→    (e: React.PointerEvent) => {\n   542→      const rect = canvasRef.current?.getBoundingClientRect();\n   543→      if (!rect) return;\n   544→\n   545→      const x = e.clientX - rect.left;\n   546→      const y = e.clientY - rect.top;\n   547→\n   548→      const node = findNodeAtPoint(x, y);\n   549→\n   550→      if (node) {\n   551→        setDraggedNode(node.id);\n   552→        graph.selectNode(node.id, e.shiftKey);\n   553→      }\n   554→\n   555→      setIsDragging(true);\n   556→      setLastPointer({ x: e.clientX, y: e.clientY });\n   557→      (e.target as HTMLElement).setPointerCapture(e.pointerId);\n   558→    },\n   559→    [findNodeAtPoint, graph]\n   560→  );\n   561→\n   562→  const handlePointerMove = useCallback(\n   563→    (e: React.PointerEvent) => {\n   564→      const rect = canvasRef.current?.getBoundingClientRect();\n   565→      if (!rect) return;\n   566→\n   567→      const x = e.clientX - rect.left;\n   568→      const y = e.clientY - rect.top;\n   569→\n   570→      if (isDragging) {\n   571→        if (draggedNode) {\n   572→          // Drag node\n   573→          const point = inverseTransformPoint(x, y, graph.viewState);\n   574→          graph.dragNode(draggedNode, point.x, point.y);\n   575→        } else {\n   576→          // Pan view\n   577→          const dx = e.clientX - lastPointer.x;\n   578→          const dy = e.clientY - lastPointer.y;\n   579→          graph.setViewState({\n   580→            ...graph.viewState,\n   581→            panX: graph.viewState.panX + dx,\n   582→            panY: graph.viewState.panY + dy,\n   583→          });\n   584→        }\n   585→        setLastPointer({ x: e.clientX, y: e.clientY });\n   586→      } else {\n   587→        // Hover\n   588→        const node = findNodeAtPoint(x, y);\n   589→        setHoveredNode(node?.id ?? null);\n   590→      }\n   591→    },\n   592→    [isDragging, draggedNode, lastPointer, graph, findNodeAtPoint]\n   593→  );\n   594→\n   595→  const handlePointerUp = useCallback(\n   596→    (e: React.PointerEvent) => {\n   597→      setIsDragging(false);\n   598→      setDraggedNode(null);\n   599→      (e.target as HTMLElement).releasePointerCapture(e.pointerId);\n   600→    },\n   601→    []\n   602→  );\n   603→\n   604→  const handleWheel = useCallback(\n   605→    (e: React.WheelEvent) => {\n   606→      e.preventDefault();\n   607→      const rect = canvasRef.current?.getBoundingClientRect();\n   608→      if (!rect) return;\n   609→\n   610→      const x = e.clientX - rect.left;\n   611→      const y = e.clientY - rect.top;\n   612→\n   613→      const zoomFactor = e.deltaY > 0 ? 0.9 : 1.1;\n   614→      const newZoom = Math.max(0.1, Math.min(5, graph.viewState.zoom * zoomFactor));\n   615→\n   616→      // Zoom toward cursor\n   617→      const newPanX = x - (x - graph.viewState.panX) * (newZoom / graph.viewState.zoom);\n   618→      const newPanY = y - (y - graph.viewState.panY) * (newZoom / graph.viewState.zoom);\n   619→\n   620→      graph.setViewState({\n   621→        zoom: newZoom,\n   622→        panX: newPanX,\n   623→        panY: newPanY,\n   624→      });\n   625→    },\n   626→    [graph]\n   627→  );\n   628→\n   629→  const handleDoubleClick = useCallback(\n   630→    (e: React.MouseEvent) => {\n   631→      const rect = canvasRef.current?.getBoundingClientRect();\n   632→      if (!rect) return;\n   633→\n   634→      const x = e.clientX - rect.left;\n   635→      const y = e.clientY - rect.top;\n   636→\n   637→      const node = findNodeAtPoint(x, y);\n   638→      if (node) {\n   639→        graph.selectNeighbors(node.id, 1);\n   640→      }\n   641→    },\n   642→    [findNodeAtPoint, graph]\n   643→  );\n   644→\n   645→  return (\n   646→    <div\n   647→      ref={containerRef}\n   648→      className={cn('relative overflow-hidden rounded-xl', cardClasses, className)}\n   649→      style={{ width: propWidth ?? '100%', height: propHeight ?? 400 }}\n   650→    >\n   651→      {/* Canvas */}\n   652→      <canvas\n   653→        ref={canvasRef}\n   654→        className=\"absolute inset-0 cursor-grab active:cursor-grabbing\"\n   655→        onPointerDown={handlePointerDown}\n   656→        onPointerMove={handlePointerMove}\n   657→        onPointerUp={handlePointerUp}\n   658→        onPointerLeave={handlePointerUp}\n   659→        onWheel={handleWheel}\n   660→        onDoubleClick={handleDoubleClick}\n   661→      />\n   662→\n   663→      {/* Progress indicator */}\n   664→      <AnimatePresence>\n   665→        {graph.isComputing && (\n   666→          <motion.div\n   667→            initial={{ opacity: 0 }}\n   668→            animate={{ opacity: 1 }}\n   669→            exit={{ opacity: 0 }}\n   670→            className=\"absolute top-4 left-1/2 -translate-x-1/2 px-4 py-2 rounded-full flex items-center gap-3\"\n   671→            style={{ backgroundColor: colors.surfaceBg }}\n   672→          >\n   673→            <div className=\"w-24 h-1.5 rounded-full overflow-hidden\" style={{ backgroundColor: colors.border }}>\n   674→              <motion.div\n   675→                className=\"h-full rounded-full\"\n   676→                style={{ backgroundColor: colors.primary }}\n   677→                initial={{ width: 0 }}\n   678→                animate={{ width: `${graph.layoutProgress * 100}%` }}\n   679→              />\n   680→            </div>\n   681→            <span className=\"text-xs\" style={{ color: colors.textSecondary }}>\n   682→              {Math.round(graph.layoutProgress * 100)}%\n   683→            </span>\n   684→          </motion.div>\n   685→        )}\n   686→      </AnimatePresence>\n   687→\n   688→      {/* Controls */}\n   689→      {showControls && (\n   690→        <div className={cn('absolute top-3 right-3 flex flex-col gap-1', surfaceClasses, 'p-1 rounded-lg')}>\n   691→          <button\n   692→            onClick={graph.zoomIn}\n   693→            className=\"p-2 rounded hover:bg-white/10 transition-colors\"\n   694→            title=\"Zoom in\"\n   695→          >\n   696→            <ZoomIn size={16} style={{ color: colors.textSecondary }} />\n   697→          </button>\n   698→          <button\n   699→            onClick={graph.zoomOut}\n   700→            className=\"p-2 rounded hover:bg-white/10 transition-colors\"\n   701→            title=\"Zoom out\"\n   702→          >\n   703→            <ZoomOut size={16} style={{ color: colors.textSecondary }} />\n   704→          </button>\n   705→          <button\n   706→            onClick={graph.fitToView}\n   707→            className=\"p-2 rounded hover:bg-white/10 transition-colors\"\n   708→            title=\"Fit to view\"\n   709→          >\n   710→            <Maximize2 size={16} style={{ color: colors.textSecondary }} />\n   711→          </button>\n   712→          <button\n   713→            onClick={graph.resetView}\n   714→            className=\"p-2 rounded hover:bg-white/10 transition-colors\"\n   715→            title=\"Reset view\"\n   716→          >\n   717→            <RotateCcw size={16} style={{ color: colors.textSecondary }} />\n   718→          </button>\n   719→          <div className=\"h-px my-1\" style={{ backgroundColor: colors.border }} />\n   720→          <button\n   721→            onClick={() => setShowClusters(!showClusters)}\n   722→            className={cn('p-2 rounded transition-colors', showClusters && 'bg-white/10')}\n   723→            title=\"Toggle clusters\"\n   724→          >\n   725→            <Layers size={16} style={{ color: showClusters ? colors.primary : colors.textSecondary }} />\n   726→          </button>\n   727→          {enablePathFinding && (\n   728→            <button\n   729→              onClick={() => setShowPathFinder(!showPathFinder)}\n   730→              className={cn('p-2 rounded transition-colors', showPathFinder && 'bg-white/10')}\n   731→              title=\"Find path\"\n   732→            >\n   733→              <GitBranch size={16} style={{ color: showPathFinder ? colors.primary : colors.textSecondary }} />\n   734→            </button>\n   735→          )}\n   736→          <button\n   737→            onClick={() => setShowFilterPanel(!showFilterPanel)}\n   738→            className={cn('p-2 rounded transition-colors', showFilterPanel && 'bg-white/10')}\n   739→            title=\"Filters\"\n   740→          >\n   741→            <Filter size={16} style={{ color: showFilterPanel ? colors.primary : colors.textSecondary }} />\n   742→          </button>\n   743→        </div>\n   744→      )}\n   745→\n   746→      {/* Search bar */}\n   747→      {showSearch && (\n   748→        <div className={cn('absolute top-3 left-3', surfaceClasses, 'rounded-lg')}>\n   749→          <div className=\"relative\">\n   750→            <Search\n   751→              size={14}\n   752→              className=\"absolute left-3 top-1/2 -translate-y-1/2\"\n   753→              style={{ color: colors.textMuted }}\n   754→            />\n   755→            <input\n   756→              type=\"text\"\n   757→              placeholder=\"Search nodes...\"\n   758→              value={searchQuery}\n   759→              onChange={(e) => {\n   760→                setSearchQuery(e.target.value);\n   761→                graph.setFilter({ searchQuery: e.target.value });\n   762→              }}\n   763→              className=\"w-48 pl-9 pr-8 py-2 text-sm rounded-lg bg-transparent border-0 outline-none\"\n   764→              style={{ color: colors.textPrimary }}\n   765→            />\n   766→            {searchQuery && (\n   767→              <button\n   768→                onClick={() => {\n   769→                  setSearchQuery('');\n   770→                  graph.setFilter({ searchQuery: '' });\n   771→                }}\n   772→                className=\"absolute right-2 top-1/2 -translate-y-1/2 p-1 rounded hover:bg-white/10\"\n   773→              >\n   774→                <X size={12} style={{ color: colors.textMuted }} />\n   775→              </button>\n   776→            )}\n   777→          </div>\n   778→\n   779→          {/* Search results dropdown */}\n   780→          <AnimatePresence>\n   781→            {searchResults.length > 0 && searchQuery && (\n   782→              <motion.div\n   783→                initial={{ opacity: 0, y: -4 }}\n   784→                animate={{ opacity: 1, y: 0 }}\n   785→                exit={{ opacity: 0, y: -4 }}\n   786→                className={cn('absolute top-full left-0 right-0 mt-1 rounded-lg overflow-hidden max-h-48 overflow-y-auto', tooltipClasses)}\n   787→              >\n   788→                {searchResults.slice(0, 10).map((node) => (\n   789→                  <button\n   790→                    key={node.id}\n   791→                    onClick={() => {\n   792→                      graph.selectNode(node.id);\n   793→                      graph.highlightNode(node.id);\n   794→                      setSearchQuery('');\n   795→                      graph.setFilter({ searchQuery: '' });\n   796→                    }}\n   797→                    className=\"w-full px-3 py-2 text-left text-sm hover:bg-white/10 transition-colors flex items-center gap-2\"\n   798→                    style={{ color: colors.textPrimary }}\n   799→                  >\n   800→                    <span\n   801→                      className=\"w-2 h-2 rounded-full\"\n   802→                      style={{\n   803→                        backgroundColor: entityColors[(node.type?.toLowerCase() ?? 'other') as keyof typeof entityColors] ?? entityColors.other,\n   804→                      }}\n   805→                    />\n   806→                    {node.label ?? node.id}\n   807→                  </button>\n   808→                ))}\n   809→              </motion.div>\n   810→            )}\n   811→          </AnimatePresence>\n   812→        </div>\n   813→      )}\n   814→\n   815→      {/* Layout switcher */}\n   816→      <LayoutSwitcher\n   817→        currentLayout={graph.currentLayout}\n   818→        onLayoutChange={graph.setLayout}\n   819→        onRunLayout={graph.runLayout}\n   820→        isComputing={graph.isComputing}\n   821→      />\n   822→\n   823→      {/* Filter panel */}\n   824→      <AnimatePresence>\n   825→        {showFilterPanel && (\n   826→          <GraphFilterPanel\n   827→            nodes={nodes}\n   828→            edges={edges}\n   829→            filter={graph.filter}\n   830→            onFilterChange={graph.setFilter}\n   831→            onClose={() => setShowFilterPanel(false)}\n   832→          />\n   833→        )}\n   834→      </AnimatePresence>\n   835→\n   836→      {/* Path finder */}\n   837→      <AnimatePresence>\n   838→        {showPathFinder && (\n   839→          <PathFinder\n   840→            nodes={graph.layoutNodes}\n   841→            currentPath={graph.currentPath}\n   842→            onFindPath={graph.findPath}\n   843→            onClearPath={graph.clearPath}\n   844→            onClose={() => setShowPathFinder(false)}\n   845→          />\n   846→        )}\n   847→      </AnimatePresence>\n   848→\n   849→      {/* Minimap */}\n   850→      {showMinimap && (\n   851→        <GraphMinimap\n   852→          nodes={graph.layoutNodes}\n   853→          edges={graph.filteredEdges}\n   854→          viewState={graph.viewState}\n   855→          containerWidth={dimensions.width}\n   856→          containerHeight={dimensions.height}\n   857→          onViewChange={graph.setViewState}\n   858→        />\n   859→      )}\n   860→\n   861→      {/* Export button */}\n   862→      <GraphExporter\n   863→        canvasRef={canvasRef}\n   864→        graphData={graph.getGraphData()}\n   865→      />\n   866→\n   867→      {/* Hovered node tooltip */}\n   868→      <AnimatePresence>\n   869→        {hoveredNode && !isDragging && (\n   870→          <motion.div\n   871→            initial={{ opacity: 0, y: 4 }}\n   872→            animate={{ opacity: 1, y: 0 }}\n   873→            exit={{ opacity: 0, y: 4 }}\n   874→            className={cn('absolute bottom-4 left-1/2 -translate-x-1/2 px-3 py-2 rounded-lg text-sm pointer-events-none', tooltipClasses)}\n   875→          >\n   876→            {(() => {\n   877→              const node = nodeMap.get(hoveredNode);\n   878→              if (!node) return null;\n   879→              return (\n   880→                <div className=\"flex items-center gap-2\">\n   881→                  <span\n   882→                    className=\"w-2 h-2 rounded-full\"\n   883→                    style={{\n   884→                      backgroundColor: entityColors[(node.type?.toLowerCase() ?? 'other') as keyof typeof entityColors] ?? entityColors.other,\n   885→                    }}\n   886→                  />\n   887→                  <span style={{ color: colors.textPrimary }}>{node.label ?? node.id}</span>\n   888→                  {node.type && (\n   889→                    <span className=\"text-xs\" style={{ color: colors.textMuted }}>\n   890→                      ({node.type})\n   891→                    </span>\n   892→                  )}\n   893→                </div>\n   894→              );\n   895→            })()}\n   896→          </motion.div>\n   897→        )}\n   898→      </AnimatePresence>\n   899→\n   900→      {/* Stats */}\n   901→      <div className=\"absolute bottom-3 left-3 text-[10px]\" style={{ color: colors.textMuted }}>\n   902→        {graph.layoutNodes.length} nodes · {graph.filteredEdges.length} edges\n   903→        {graph.clusters.length > 0 && ` · ${graph.clusters.length} clusters`}\n   904→      </div>\n   905→    </div>\n   906→  );\n   907→}\n   908→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"d184f0d2-244e-457f-8ea5-4627f2d647f1","uuid":"a71ca855-a927-4240-96b1-d22131c8bf03","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\visualizations\\network\\AdvancedNetworkGraph.tsx","content":"'use client';\n\n/**\n * AdvancedNetworkGraph\n *\n * A professional-grade force-directed graph visualization component with:\n * - WebGL-accelerated canvas rendering for 500+ nodes\n * - Hierarchical clustering with expandable groups\n * - Shortest path highlighting\n * - Multiple layout algorithms\n * - Edge bundling for dense graphs\n * - Minimap navigation\n * - Node search and filtering\n */\n\nimport { useRef, useEffect, useState, useCallback, useMemo } from 'react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport { useVisualizationTheme } from '../useVisualizationTheme';\nimport { useForceGraph, type LayoutAlgorithm } from '@/src/hooks/useForceGraph';\nimport type { GraphNode, GraphEdge, Cluster, BundledEdge } from '@/src/lib/graphAlgorithms';\nimport { GraphMinimap } from './GraphMinimap';\nimport { LayoutSwitcher } from './LayoutSwitcher';\nimport { GraphFilterPanel } from './GraphFilterPanel';\nimport { PathFinder } from './PathFinder';\nimport { GraphExporter } from './GraphExporter';\nimport { cn } from '@/src/lib/utils';\nimport {\n  Search,\n  ZoomIn,\n  ZoomOut,\n  Maximize2,\n  RotateCcw,\n  Layers,\n  GitBranch,\n  Filter,\n  X,\n} from 'lucide-react';\n\n// ============================================================================\n// Types\n// ============================================================================\n\nexport interface AdvancedNetworkGraphProps {\n  nodes: GraphNode[];\n  edges: GraphEdge[];\n  width?: number;\n  height?: number;\n  className?: string;\n  onNodeClick?: (node: GraphNode) => void;\n  onEdgeClick?: (edge: GraphEdge) => void;\n  showMinimap?: boolean;\n  showControls?: boolean;\n  showSearch?: boolean;\n  enableClustering?: boolean;\n  enableEdgeBundling?: boolean;\n  enablePathFinding?: boolean;\n  initialLayout?: LayoutAlgorithm;\n}\n\ninterface RenderContext {\n  ctx: CanvasRenderingContext2D;\n  width: number;\n  height: number;\n  viewState: { zoom: number; panX: number; panY: number };\n  isRadar: boolean;\n  colors: ReturnType<typeof useVisualizationTheme>['colors'];\n  entityColors: ReturnType<typeof useVisualizationTheme>['entityColors'];\n  selection: Set<string>;\n  highlightedNode: string | null;\n  pathNodes: Set<string>;\n  pathEdges: Set<string>;\n  matchingNodeIds: Set<string>;\n  hoveredNode: string | null;\n  clusters: Cluster[];\n  showClusters: boolean;\n}\n\n// ============================================================================\n// Rendering Utilities\n// ============================================================================\n\nfunction transformPoint(\n  x: number,\n  y: number,\n  viewState: { zoom: number; panX: number; panY: number }\n): { x: number; y: number } {\n  return {\n    x: x * viewState.zoom + viewState.panX,\n    y: y * viewState.zoom + viewState.panY,\n  };\n}\n\nfunction inverseTransformPoint(\n  screenX: number,\n  screenY: number,\n  viewState: { zoom: number; panX: number; panY: number }\n): { x: number; y: number } {\n  return {\n    x: (screenX - viewState.panX) / viewState.zoom,\n    y: (screenY - viewState.panY) / viewState.zoom,\n  };\n}\n\nfunction drawClusters(ctx: RenderContext, clusters: Cluster[]): void {\n  const { ctx: c, viewState, isRadar, colors } = ctx;\n\n  clusters.forEach((cluster, i) => {\n    const pos = transformPoint(cluster.x, cluster.y, viewState);\n    const scaledRadius = cluster.radius * viewState.zoom;\n\n    // Cluster background\n    const hue = (i * 137.5) % 360;\n    const clusterColor = isRadar\n      ? `hsla(${hue}, 70%, 50%, 0.08)`\n      : `hsla(${hue}, 60%, 60%, 0.06)`;\n\n    c.beginPath();\n    c.arc(pos.x, pos.y, scaledRadius, 0, Math.PI * 2);\n    c.fillStyle = clusterColor;\n    c.fill();\n\n    // Cluster border\n    c.strokeStyle = isRadar\n      ? `hsla(${hue}, 70%, 50%, 0.3)`\n      : `hsla(${hue}, 60%, 40%, 0.2)`;\n    c.lineWidth = 1;\n    c.setLineDash([4, 4]);\n    c.stroke();\n    c.setLineDash([]);\n\n    // Cluster label\n    if (cluster.label) {\n      c.font = '10px Inter, system-ui, sans-serif';\n      c.fillStyle = colors.textMuted;\n      c.textAlign = 'center';\n      c.fillText(cluster.label, pos.x, pos.y - scaledRadius - 8);\n    }\n  });\n}\n\nfunction drawEdge(\n  ctx: RenderContext,\n  edge: GraphEdge | BundledEdge,\n  sourceNode: GraphNode,\n  targetNode: GraphNode\n): void {\n  const { ctx: c, viewState, isRadar, colors, selection, pathEdges } = ctx;\n\n  const isInPath = pathEdges.has(edge.id);\n  const isSelected = selection.has(edge.source) || selection.has(edge.target);\n\n  let strokeColor = colors.connectionLine;\n  let lineWidth = 1;\n  let opacity = 0.5;\n\n  if (edge.type === 'contradicts') {\n    strokeColor = colors.contradictionLine;\n    lineWidth = 2;\n  } else if (edge.type === 'supports') {\n    strokeColor = colors.success;\n  }\n\n  if (isInPath) {\n    strokeColor = isRadar ? '#fbbf24' : '#d97706';\n    lineWidth = 3;\n    opacity = 1;\n  } else if (isSelected) {\n    opacity = 0.8;\n    lineWidth = 2;\n  }\n\n  c.strokeStyle = strokeColor;\n  c.lineWidth = lineWidth;\n  c.globalAlpha = opacity;\n\n  const bundled = edge as BundledEdge;\n  if (bundled.controlPoints && bundled.controlPoints.length > 2) {\n    // Draw bundled edge as bezier curve\n    c.beginPath();\n    const start = transformPoint(bundled.controlPoints[0].x, bundled.controlPoints[0].y, viewState);\n    c.moveTo(start.x, start.y);\n\n    for (let i = 1; i < bundled.controlPoints.length - 1; i += 2) {\n      const cp = transformPoint(bundled.controlPoints[i].x, bundled.controlPoints[i].y, viewState);\n      const end = transformPoint(\n        bundled.controlPoints[Math.min(i + 1, bundled.controlPoints.length - 1)].x,\n        bundled.controlPoints[Math.min(i + 1, bundled.controlPoints.length - 1)].y,\n        viewState\n      );\n      c.quadraticCurveTo(cp.x, cp.y, end.x, end.y);\n    }\n    c.stroke();\n  } else {\n    // Draw straight edge\n    const source = transformPoint(sourceNode.x, sourceNode.y, viewState);\n    const target = transformPoint(targetNode.x, targetNode.y, viewState);\n\n    c.beginPath();\n    c.moveTo(source.x, source.y);\n    c.lineTo(target.x, target.y);\n    c.stroke();\n\n    // Arrowhead\n    if (isInPath || isSelected) {\n      const dx = target.x - source.x;\n      const dy = target.y - source.y;\n      const angle = Math.atan2(dy, dx);\n      const arrowSize = 8;\n      const nodeRadius = (targetNode.radius ?? 8) * viewState.zoom;\n\n      const arrowX = target.x - Math.cos(angle) * nodeRadius;\n      const arrowY = target.y - Math.sin(angle) * nodeRadius;\n\n      c.beginPath();\n      c.moveTo(arrowX, arrowY);\n      c.lineTo(\n        arrowX - arrowSize * Math.cos(angle - Math.PI / 6),\n        arrowY - arrowSize * Math.sin(angle - Math.PI / 6)\n      );\n      c.lineTo(\n        arrowX - arrowSize * Math.cos(angle + Math.PI / 6),\n        arrowY - arrowSize * Math.sin(angle + Math.PI / 6)\n      );\n      c.closePath();\n      c.fillStyle = strokeColor;\n      c.fill();\n    }\n  }\n\n  c.globalAlpha = 1;\n}\n\nfunction drawNode(ctx: RenderContext, node: GraphNode): void {\n  const {\n    ctx: c,\n    viewState,\n    isRadar,\n    colors,\n    entityColors,\n    selection,\n    highlightedNode,\n    pathNodes,\n    matchingNodeIds,\n    hoveredNode,\n  } = ctx;\n\n  const pos = transformPoint(node.x, node.y, viewState);\n  const radius = (node.radius ?? 8) * viewState.zoom;\n  const isSelected = selection.has(node.id);\n  const isHighlighted = highlightedNode === node.id;\n  const isInPath = pathNodes.has(node.id);\n  const isSearchMatch = matchingNodeIds.has(node.id);\n  const isHovered = hoveredNode === node.id;\n\n  // Get color based on type\n  const typeKey = (node.type?.toLowerCase() ?? 'other') as keyof typeof entityColors;\n  let fillColor = entityColors[typeKey] ?? entityColors.other;\n\n  if (isInPath) {\n    fillColor = isRadar ? '#fbbf24' : '#d97706';\n  }\n\n  // Glow effect for highlighted/selected nodes\n  if (isHighlighted || isSelected || isInPath || isSearchMatch) {\n    const gradient = c.createRadialGradient(pos.x, pos.y, radius * 0.5, pos.x, pos.y, radius * 2.5);\n    gradient.addColorStop(0, isRadar ? `${fillColor}40` : `${fillColor}30`);\n    gradient.addColorStop(1, 'transparent');\n    c.fillStyle = gradient;\n    c.beginPath();\n    c.arc(pos.x, pos.y, radius * 2.5, 0, Math.PI * 2);\n    c.fill();\n  }\n\n  // Node shadow\n  if (!isRadar) {\n    c.shadowColor = 'rgba(0,0,0,0.1)';\n    c.shadowBlur = 8;\n    c.shadowOffsetX = 0;\n    c.shadowOffsetY = 2;\n  }\n\n  // Node circle\n  c.beginPath();\n  c.arc(pos.x, pos.y, radius, 0, Math.PI * 2);\n  c.fillStyle = fillColor;\n  c.fill();\n\n  // Node border\n  c.strokeStyle = isSelected || isHighlighted || isHovered\n    ? (isRadar ? '#fff' : '#1c1917')\n    : (isRadar ? 'rgba(255,255,255,0.3)' : 'rgba(0,0,0,0.1)');\n  c.lineWidth = isSelected || isHighlighted ? 2 : 1;\n  c.stroke();\n\n  // Reset shadow\n  c.shadowColor = 'transparent';\n  c.shadowBlur = 0;\n  c.shadowOffsetX = 0;\n  c.shadowOffsetY = 0;\n\n  // Pin indicator\n  if (node.fixed) {\n    c.fillStyle = colors.textPrimary;\n    c.beginPath();\n    c.arc(pos.x + radius * 0.7, pos.y - radius * 0.7, 3, 0, Math.PI * 2);\n    c.fill();\n  }\n\n  // Node label (only show when zoomed in or hovered/selected)\n  if (viewState.zoom > 0.8 || isHovered || isSelected || isHighlighted) {\n    const label = node.label ?? node.id;\n    const maxLen = 12;\n    const displayLabel = label.length > maxLen ? label.slice(0, maxLen - 1) + '…' : label;\n\n    c.font = `${isSelected || isHighlighted ? 'bold ' : ''}${10 * Math.min(viewState.zoom, 1.5)}px Inter, system-ui, sans-serif`;\n    c.textAlign = 'center';\n    c.textBaseline = 'top';\n\n    // Label background\n    const textMetrics = c.measureText(displayLabel);\n    const labelY = pos.y + radius + 4;\n    const padding = 3;\n\n    c.fillStyle = isRadar ? 'rgba(15, 23, 42, 0.8)' : 'rgba(255, 255, 255, 0.9)';\n    c.fillRect(\n      pos.x - textMetrics.width / 2 - padding,\n      labelY - 1,\n      textMetrics.width + padding * 2,\n      12 + padding\n    );\n\n    c.fillStyle = isSelected || isHighlighted ? colors.textPrimary : colors.textSecondary;\n    c.fillText(displayLabel, pos.x, labelY);\n  }\n}\n\n// ============================================================================\n// Main Component\n// ============================================================================\n\nexport function AdvancedNetworkGraph({\n  nodes,\n  edges,\n  width: propWidth,\n  height: propHeight,\n  className,\n  onNodeClick,\n  onEdgeClick,\n  showMinimap = true,\n  showControls = true,\n  showSearch = true,\n  enableClustering = true,\n  enableEdgeBundling = false,\n  enablePathFinding = true,\n  initialLayout = 'force',\n}: AdvancedNetworkGraphProps) {\n  // Refs\n  const containerRef = useRef<HTMLDivElement>(null);\n  const canvasRef = useRef<HTMLCanvasElement>(null);\n  const animationFrameRef = useRef<number | undefined>(undefined);\n\n  // Theme\n  const { colors, entityColors, isRadar, cardClasses, surfaceClasses, tooltipClasses } =\n    useVisualizationTheme();\n\n  // Dimensions\n  const [dimensions, setDimensions] = useState({ width: propWidth ?? 800, height: propHeight ?? 600 });\n\n  useEffect(() => {\n    if (propWidth && propHeight) {\n      setDimensions({ width: propWidth, height: propHeight });\n      return;\n    }\n\n    if (!containerRef.current) return;\n\n    const observer = new ResizeObserver((entries) => {\n      const entry = entries[0];\n      if (entry) {\n        setDimensions({\n          width: entry.contentRect.width,\n          height: entry.contentRect.height,\n        });\n      }\n    });\n\n    observer.observe(containerRef.current);\n    return () => observer.disconnect();\n  }, [propWidth, propHeight]);\n\n  // Graph state\n  const graph = useForceGraph({\n    nodes,\n    edges,\n    width: dimensions.width,\n    height: dimensions.height,\n    initialLayout,\n    enableClustering,\n    enableEdgeBundling,\n    onNodeClick,\n    onEdgeClick,\n  });\n\n  // UI state\n  const [showFilterPanel, setShowFilterPanel] = useState(false);\n  const [showPathFinder, setShowPathFinder] = useState(false);\n  const [showClusters, setShowClusters] = useState(true);\n  const [hoveredNode, setHoveredNode] = useState<string | null>(null);\n  const [searchQuery, setSearchQuery] = useState('');\n  const [isDragging, setIsDragging] = useState(false);\n  const [draggedNode, setDraggedNode] = useState<string | null>(null);\n  const [lastPointer, setLastPointer] = useState({ x: 0, y: 0 });\n\n  // Create node map for quick lookup\n  const nodeMap = useMemo(\n    () => new Map(graph.layoutNodes.map((n) => [n.id, n])),\n    [graph.layoutNodes]\n  );\n\n  // Path nodes and edges sets\n  const pathNodes = useMemo(\n    () => new Set(graph.currentPath?.path ?? []),\n    [graph.currentPath]\n  );\n  const pathEdges = useMemo(\n    () => new Set(graph.currentPath?.edges ?? []),\n    [graph.currentPath]\n  );\n\n  // Search results\n  const searchResults = useMemo(() => {\n    if (!searchQuery) return [];\n    return graph.searchNodes(searchQuery);\n  }, [graph, searchQuery]);\n\n  // Render loop\n  useEffect(() => {\n    const canvas = canvasRef.current;\n    if (!canvas) return;\n\n    const ctx = canvas.getContext('2d');\n    if (!ctx) return;\n\n    const dpr = window.devicePixelRatio || 1;\n    canvas.width = dimensions.width * dpr;\n    canvas.height = dimensions.height * dpr;\n    canvas.style.width = `${dimensions.width}px`;\n    canvas.style.height = `${dimensions.height}px`;\n    ctx.scale(dpr, dpr);\n\n    const render = () => {\n      ctx.clearRect(0, 0, dimensions.width, dimensions.height);\n\n      const renderCtx: RenderContext = {\n        ctx,\n        width: dimensions.width,\n        height: dimensions.height,\n        viewState: graph.viewState,\n        isRadar,\n        colors,\n        entityColors,\n        selection: graph.selection.nodes,\n        highlightedNode: graph.highlightedNode,\n        pathNodes,\n        pathEdges,\n        matchingNodeIds: graph.matchingNodeIds,\n        hoveredNode,\n        clusters: graph.clusters,\n        showClusters,\n      };\n\n      // Draw clusters\n      if (showClusters && graph.clusters.length > 0) {\n        drawClusters(renderCtx, graph.clusters);\n      }\n\n      // Draw edges\n      const edgesToDraw = graph.bundledEdges.length > 0 ? graph.bundledEdges : graph.filteredEdges;\n      edgesToDraw.forEach((edge) => {\n        const sourceNode = nodeMap.get(edge.source);\n        const targetNode = nodeMap.get(edge.target);\n        if (sourceNode && targetNode) {\n          drawEdge(renderCtx, edge, sourceNode, targetNode);\n        }\n      });\n\n      // Draw nodes\n      graph.layoutNodes.forEach((node) => {\n        drawNode(renderCtx, node);\n      });\n\n      animationFrameRef.current = requestAnimationFrame(render);\n    };\n\n    render();\n\n    return () => {\n      if (animationFrameRef.current) {\n        cancelAnimationFrame(animationFrameRef.current);\n      }\n    };\n  }, [\n    dimensions,\n    graph.viewState,\n    graph.layoutNodes,\n    graph.filteredEdges,\n    graph.bundledEdges,\n    graph.clusters,\n    graph.selection,\n    graph.highlightedNode,\n    graph.matchingNodeIds,\n    nodeMap,\n    pathNodes,\n    pathEdges,\n    hoveredNode,\n    showClusters,\n    isRadar,\n    colors,\n    entityColors,\n  ]);\n\n  // Pointer handlers\n  const findNodeAtPoint = useCallback(\n    (screenX: number, screenY: number): GraphNode | null => {\n      const point = inverseTransformPoint(screenX, screenY, graph.viewState);\n\n      for (const node of graph.layoutNodes) {\n        const radius = node.radius ?? 8;\n        const dx = point.x - node.x;\n        const dy = point.y - node.y;\n        if (dx * dx + dy * dy <= radius * radius) {\n          return node;\n        }\n      }\n      return null;\n    },\n    [graph.layoutNodes, graph.viewState]\n  );\n\n  const handlePointerDown = useCallback(\n    (e: React.PointerEvent) => {\n      const rect = canvasRef.current?.getBoundingClientRect();\n      if (!rect) return;\n\n      const x = e.clientX - rect.left;\n      const y = e.clientY - rect.top;\n\n      const node = findNodeAtPoint(x, y);\n\n      if (node) {\n        setDraggedNode(node.id);\n        graph.selectNode(node.id, e.shiftKey);\n      }\n\n      setIsDragging(true);\n      setLastPointer({ x: e.clientX, y: e.clientY });\n      (e.target as HTMLElement).setPointerCapture(e.pointerId);\n    },\n    [findNodeAtPoint, graph]\n  );\n\n  const handlePointerMove = useCallback(\n    (e: React.PointerEvent) => {\n      const rect = canvasRef.current?.getBoundingClientRect();\n      if (!rect) return;\n\n      const x = e.clientX - rect.left;\n      const y = e.clientY - rect.top;\n\n      if (isDragging) {\n        if (draggedNode) {\n          // Drag node\n          const point = inverseTransformPoint(x, y, graph.viewState);\n          graph.dragNode(draggedNode, point.x, point.y);\n        } else {\n          // Pan view\n          const dx = e.clientX - lastPointer.x;\n          const dy = e.clientY - lastPointer.y;\n          graph.setViewState({\n            ...graph.viewState,\n            panX: graph.viewState.panX + dx,\n            panY: graph.viewState.panY + dy,\n          });\n        }\n        setLastPointer({ x: e.clientX, y: e.clientY });\n      } else {\n        // Hover\n        const node = findNodeAtPoint(x, y);\n        setHoveredNode(node?.id ?? null);\n      }\n    },\n    [isDragging, draggedNode, lastPointer, graph, findNodeAtPoint]\n  );\n\n  const handlePointerUp = useCallback(\n    (e: React.PointerEvent) => {\n      setIsDragging(false);\n      setDraggedNode(null);\n      (e.target as HTMLElement).releasePointerCapture(e.pointerId);\n    },\n    []\n  );\n\n  const handleWheel = useCallback(\n    (e: React.WheelEvent) => {\n      e.preventDefault();\n      const rect = canvasRef.current?.getBoundingClientRect();\n      if (!rect) return;\n\n      const x = e.clientX - rect.left;\n      const y = e.clientY - rect.top;\n\n      const zoomFactor = e.deltaY > 0 ? 0.9 : 1.1;\n      const newZoom = Math.max(0.1, Math.min(5, graph.viewState.zoom * zoomFactor));\n\n      // Zoom toward cursor\n      const newPanX = x - (x - graph.viewState.panX) * (newZoom / graph.viewState.zoom);\n      const newPanY = y - (y - graph.viewState.panY) * (newZoom / graph.viewState.zoom);\n\n      graph.setViewState({\n        zoom: newZoom,\n        panX: newPanX,\n        panY: newPanY,\n      });\n    },\n    [graph]\n  );\n\n  const handleDoubleClick = useCallback(\n    (e: React.MouseEvent) => {\n      const rect = canvasRef.current?.getBoundingClientRect();\n      if (!rect) return;\n\n      const x = e.clientX - rect.left;\n      const y = e.clientY - rect.top;\n\n      const node = findNodeAtPoint(x, y);\n      if (node) {\n        graph.selectNeighbors(node.id, 1);\n      }\n    },\n    [findNodeAtPoint, graph]\n  );\n\n  return (\n    <div\n      ref={containerRef}\n      className={cn('relative overflow-hidden rounded-xl', cardClasses, className)}\n      style={{ width: propWidth ?? '100%', height: propHeight ?? 400 }}\n    >\n      {/* Canvas */}\n      <canvas\n        ref={canvasRef}\n        className=\"absolute inset-0 cursor-grab active:cursor-grabbing\"\n        onPointerDown={handlePointerDown}\n        onPointerMove={handlePointerMove}\n        onPointerUp={handlePointerUp}\n        onPointerLeave={handlePointerUp}\n        onWheel={handleWheel}\n        onDoubleClick={handleDoubleClick}\n   