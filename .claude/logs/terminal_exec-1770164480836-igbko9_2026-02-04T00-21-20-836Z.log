[2026-02-04T00:21:48.898Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01C2eW1zLUhn2Sy7pcMC8pqR","type":"tool_result","content":"     1→/**\n     2→ * Graph Algorithms Library\n     3→ *\n     4→ * Contains implementations for:\n     5→ * - Louvain community detection (hierarchical clustering)\n     6→ * - Dijkstra/A* shortest path finding\n     7→ * - Force-Directed Edge Bundling (FDEB)\n     8→ * - Multiple layout algorithms (force, radial, hierarchical)\n     9→ */\n    10→\n    11→// ============================================================================\n    12→// Types\n    13→// ============================================================================\n    14→\n    15→export interface GraphNode {\n    16→  id: string;\n    17→  x: number;\n    18→  y: number;\n    19→  vx?: number;\n    20→  vy?: number;\n    21→  type?: string;\n    22→  label?: string;\n    23→  data?: Record<string, unknown>;\n    24→  radius?: number;\n    25→  fixed?: boolean;\n    26→  clusterId?: string;\n    27→  depth?: number;\n    28→}\n    29→\n    30→export interface GraphEdge {\n    31→  id: string;\n    32→  source: string;\n    33→  target: string;\n    34→  weight?: number;\n    35→  type?: string;\n    36→  label?: string;\n    37→  data?: Record<string, unknown>;\n    38→}\n    39→\n    40→export interface Cluster {\n    41→  id: string;\n    42→  nodes: string[];\n    43→  x: number;\n    44→  y: number;\n    45→  radius: number;\n    46→  parentId?: string;\n    47→  children?: Cluster[];\n    48→  label?: string;\n    49→  color?: string;\n    50→}\n    51→\n    52→export interface PathResult {\n    53→  path: string[];\n    54→  distance: number;\n    55→  edges: string[];\n    56→}\n    57→\n    58→export interface BundledEdge extends GraphEdge {\n    59→  controlPoints: Array<{ x: number; y: number }>;\n    60→}\n    61→\n    62→export interface LayoutConfig {\n    63→  width: number;\n    64→  height: number;\n    65→  padding?: number;\n    66→  iterations?: number;\n    67→  // Force layout specific\n    68→  repulsion?: number;\n    69→  attraction?: number;\n    70→  damping?: number;\n    71→  centerGravity?: number;\n    72→  // Radial layout specific\n    73→  centerNode?: string;\n    74→  levelSeparation?: number;\n    75→  // Hierarchical layout specific\n    76→  direction?: 'TB' | 'BT' | 'LR' | 'RL';\n    77→  nodeSpacing?: number;\n    78→  levelSpacing?: number;\n    79→}\n    80→\n    81→// ============================================================================\n    82→// Louvain Community Detection\n    83→// ============================================================================\n    84→\n    85→interface LouvainNode {\n    86→  id: string;\n    87→  community: number;\n    88→  degree: number;\n    89→  selfLoops: number;\n    90→}\n    91→\n    92→interface LouvainState {\n    93→  nodes: Map<string, LouvainNode>;\n    94→  communities: Map<number, Set<string>>;\n    95→  edges: Map<string, Map<string, number>>;\n    96→  totalWeight: number;\n    97→  resolution: number;\n    98→}\n    99→\n   100→function initLouvainState(\n   101→  nodes: GraphNode[],\n   102→  edges: GraphEdge[],\n   103→  resolution = 1.0\n   104→): LouvainState {\n   105→  const nodeMap = new Map<string, LouvainNode>();\n   106→  const communities = new Map<number, Set<string>>();\n   107→  const edgeMap = new Map<string, Map<string, number>>();\n   108→\n   109→  // Initialize each node in its own community\n   110→  nodes.forEach((node, i) => {\n   111→    nodeMap.set(node.id, {\n   112→      id: node.id,\n   113→      community: i,\n   114→      degree: 0,\n   115→      selfLoops: 0,\n   116→    });\n   117→    communities.set(i, new Set([node.id]));\n   118→    edgeMap.set(node.id, new Map());\n   119→  });\n   120→\n   121→  // Build adjacency with weights\n   122→  let totalWeight = 0;\n   123→  edges.forEach((edge) => {\n   124→    const weight = edge.weight ?? 1;\n   125→    totalWeight += weight;\n   126→\n   127→    const sourceEdges = edgeMap.get(edge.source);\n   128→    const targetEdges = edgeMap.get(edge.target);\n   129→\n   130→    if (sourceEdges && targetEdges) {\n   131→      sourceEdges.set(edge.target, (sourceEdges.get(edge.target) ?? 0) + weight);\n   132→      targetEdges.set(edge.source, (targetEdges.get(edge.source) ?? 0) + weight);\n   133→\n   134→      const sourceNode = nodeMap.get(edge.source);\n   135→      const targetNode = nodeMap.get(edge.target);\n   136→\n   137→      if (sourceNode) sourceNode.degree += weight;\n   138→      if (targetNode) targetNode.degree += weight;\n   139→\n   140→      if (edge.source === edge.target && sourceNode) {\n   141→        sourceNode.selfLoops += weight;\n   142→      }\n   143→    }\n   144→  });\n   145→\n   146→  return {\n   147→    nodes: nodeMap,\n   148→    communities,\n   149→    edges: edgeMap,\n   150→    totalWeight: totalWeight * 2, // Each edge counted twice\n   151→    resolution,\n   152→  };\n   153→}\n   154→\n   155→function modularity(state: LouvainState): number {\n   156→  const m2 = state.totalWeight;\n   157→  if (m2 === 0) return 0;\n   158→\n   159→  let q = 0;\n   160→  state.communities.forEach((members) => {\n   161→    let sumIn = 0;\n   162→    let sumTot = 0;\n   163→\n   164→    members.forEach((nodeId) => {\n   165→      const node = state.nodes.get(nodeId)!;\n   166→      sumTot += node.degree;\n   167→\n   168→      const edges = state.edges.get(nodeId)!;\n   169→      edges.forEach((weight, targetId) => {\n   170→        if (members.has(targetId)) {\n   171→          sumIn += weight;\n   172→        }\n   173→      });\n   174→    });\n   175→\n   176→    q += sumIn / m2 - state.resolution * (sumTot / m2) * (sumTot / m2);\n   177→  });\n   178→\n   179→  return q;\n   180→}\n   181→\n   182→function modularityGain(\n   183→  state: LouvainState,\n   184→  nodeId: string,\n   185→  targetCommunity: number\n   186→): number {\n   187→  const node = state.nodes.get(nodeId)!;\n   188→  const m2 = state.totalWeight;\n   189→  if (m2 === 0) return 0;\n   190→\n   191→  const targetMembers = state.communities.get(targetCommunity);\n   192→  if (!targetMembers) return 0;\n   193→\n   194→  let sumIn = 0;\n   195→  let sumTot = 0;\n   196→\n   197→  targetMembers.forEach((memberId) => {\n   198→    const member = state.nodes.get(memberId)!;\n   199→    sumTot += member.degree;\n   200→  });\n   201→\n   202→  const edges = state.edges.get(nodeId)!;\n   203→  edges.forEach((weight, targetId) => {\n   204→    if (targetMembers.has(targetId)) {\n   205→      sumIn += weight;\n   206→    }\n   207→  });\n   208→\n   209→  const ki = node.degree;\n   210→  const kiIn = sumIn;\n   211→\n   212→  return (\n   213→    (kiIn / m2 - state.resolution * (sumTot * ki) / (m2 * m2)) * 2\n   214→  );\n   215→}\n   216→\n   217→function moveNode(\n   218→  state: LouvainState,\n   219→  nodeId: string,\n   220→  newCommunity: number\n   221→): void {\n   222→  const node = state.nodes.get(nodeId)!;\n   223→  const oldCommunity = node.community;\n   224→\n   225→  // Remove from old community\n   226→  const oldMembers = state.communities.get(oldCommunity);\n   227→  if (oldMembers) {\n   228→    oldMembers.delete(nodeId);\n   229→    if (oldMembers.size === 0) {\n   230→      state.communities.delete(oldCommunity);\n   231→    }\n   232→  }\n   233→\n   234→  // Add to new community\n   235→  let newMembers = state.communities.get(newCommunity);\n   236→  if (!newMembers) {\n   237→    newMembers = new Set();\n   238→    state.communities.set(newCommunity, newMembers);\n   239→  }\n   240→  newMembers.add(nodeId);\n   241→\n   242→  // Update node\n   243→  node.community = newCommunity;\n   244→}\n   245→\n   246→function louvainPass(state: LouvainState): boolean {\n   247→  let improved = false;\n   248→  const nodeIds = Array.from(state.nodes.keys());\n   249→\n   250→  // Randomize order for better convergence\n   251→  for (let i = nodeIds.length - 1; i > 0; i--) {\n   252→    const j = Math.floor(Math.random() * (i + 1));\n   253→    [nodeIds[i], nodeIds[j]] = [nodeIds[j], nodeIds[i]];\n   254→  }\n   255→\n   256→  for (const nodeId of nodeIds) {\n   257→    const node = state.nodes.get(nodeId)!;\n   258→    const currentCommunity = node.community;\n   259→\n   260→    // Find neighboring communities\n   261→    const neighborCommunities = new Set<number>();\n   262→    const edges = state.edges.get(nodeId)!;\n   263→    edges.forEach((_, targetId) => {\n   264→      const target = state.nodes.get(targetId);\n   265→      if (target) {\n   266→        neighborCommunities.add(target.community);\n   267→      }\n   268→    });\n   269→\n   270→    // Find best community\n   271→    let bestCommunity = currentCommunity;\n   272→    let bestGain = 0;\n   273→\n   274→    // First, calculate loss from leaving current community\n   275→    const leaveLoss = -modularityGain(state, nodeId, currentCommunity);\n   276→\n   277→    for (const community of neighborCommunities) {\n   278→      if (community !== currentCommunity) {\n   279→        const gain = modularityGain(state, nodeId, community) + leaveLoss;\n   280→        if (gain > bestGain) {\n   281→          bestGain = gain;\n   282→          bestCommunity = community;\n   283→        }\n   284→      }\n   285→    }\n   286→\n   287→    if (bestCommunity !== currentCommunity && bestGain > 1e-10) {\n   288→      moveNode(state, nodeId, bestCommunity);\n   289→      improved = true;\n   290→    }\n   291→  }\n   292→\n   293→  return improved;\n   294→}\n   295→\n   296→/**\n   297→ * Louvain community detection algorithm.\n   298→ * Returns clusters with assigned node IDs.\n   299→ */\n   300→export function louvainClustering(\n   301→  nodes: GraphNode[],\n   302→  edges: GraphEdge[],\n   303→  resolution = 1.0,\n   304→  maxIterations = 10\n   305→): Cluster[] {\n   306→  if (nodes.length === 0) return [];\n   307→  if (nodes.length === 1) {\n   308→    return [{\n   309→      id: 'cluster-0',\n   310→      nodes: [nodes[0].id],\n   311→      x: nodes[0].x,\n   312→      y: nodes[0].y,\n   313→      radius: nodes[0].radius ?? 20,\n   314→    }];\n   315→  }\n   316→\n   317→  const state = initLouvainState(nodes, edges, resolution);\n   318→\n   319→  // Iterative optimization\n   320→  for (let iter = 0; iter < maxIterations; iter++) {\n   321→    const improved = louvainPass(state);\n   322→    if (!improved) break;\n   323→  }\n   324→\n   325→  // Convert communities to clusters\n   326→  const nodePositions = new Map(nodes.map((n) => [n.id, { x: n.x, y: n.y }]));\n   327→  const clusters: Cluster[] = [];\n   328→\n   329→  state.communities.forEach((members, communityId) => {\n   330→    if (members.size === 0) return;\n   331→\n   332→    const memberArray = Array.from(members);\n   333→    let cx = 0,\n   334→      cy = 0,\n   335→      maxDist = 0;\n   336→\n   337→    memberArray.forEach((nodeId) => {\n   338→      const pos = nodePositions.get(nodeId);\n   339→      if (pos) {\n   340→        cx += pos.x;\n   341→        cy += pos.y;\n   342→      }\n   343→    });\n   344→\n   345→    cx /= memberArray.length;\n   346→    cy /= memberArray.length;\n   347→\n   348→    // Calculate radius\n   349→    memberArray.forEach((nodeId) => {\n   350→      const pos = nodePositions.get(nodeId);\n   351→      if (pos) {\n   352→        const dist = Math.sqrt((pos.x - cx) ** 2 + (pos.y - cy) ** 2);\n   353→        maxDist = Math.max(maxDist, dist);\n   354→      }\n   355→    });\n   356→\n   357→    clusters.push({\n   358→      id: `cluster-${communityId}`,\n   359→      nodes: memberArray,\n   360→      x: cx,\n   361→      y: cy,\n   362→      radius: maxDist + 30,\n   363→    });\n   364→  });\n   365→\n   366→  return clusters;\n   367→}\n   368→\n   369→// ============================================================================\n   370→// Dijkstra Shortest Path\n   371→// ============================================================================\n   372→\n   373→interface DijkstraNode {\n   374→  id: string;\n   375→  distance: number;\n   376→  previous: string | null;\n   377→  previousEdge: string | null;\n   378→}\n   379→\n   380→/**\n   381→ * Priority queue implementation using a binary heap\n   382→ */\n   383→class PriorityQueue<T> {\n   384→  private heap: Array<{ item: T; priority: number }> = [];\n   385→\n   386→  push(item: T, priority: number): void {\n   387→    this.heap.push({ item, priority });\n   388→    this.bubbleUp(this.heap.length - 1);\n   389→  }\n   390→\n   391→  pop(): T | undefined {\n   392→    if (this.heap.length === 0) return undefined;\n   393→    const result = this.heap[0].item;\n   394→    const last = this.heap.pop()!;\n   395→    if (this.heap.length > 0) {\n   396→      this.heap[0] = last;\n   397→      this.bubbleDown(0);\n   398→    }\n   399→    return result;\n   400→  }\n   401→\n   402→  isEmpty(): boolean {\n   403→    return this.heap.length === 0;\n   404→  }\n   405→\n   406→  private bubbleUp(index: number): void {\n   407→    while (index > 0) {\n   408→      const parent = Math.floor((index - 1) / 2);\n   409→      if (this.heap[parent].priority <= this.heap[index].priority) break;\n   410→      [this.heap[parent], this.heap[index]] = [this.heap[index], this.heap[parent]];\n   411→      index = parent;\n   412→    }\n   413→  }\n   414→\n   415→  private bubbleDown(index: number): void {\n   416→    while (true) {\n   417→      const left = 2 * index + 1;\n   418→      const right = 2 * index + 2;\n   419→      let smallest = index;\n   420→\n   421→      if (left < this.heap.length && this.heap[left].priority < this.heap[smallest].priority) {\n   422→        smallest = left;\n   423→      }\n   424→      if (right < this.heap.length && this.heap[right].priority < this.heap[smallest].priority) {\n   425→        smallest = right;\n   426→      }\n   427→\n   428→      if (smallest === index) break;\n   429→      [this.heap[smallest], this.heap[index]] = [this.heap[index], this.heap[smallest]];\n   430→      index = smallest;\n   431→    }\n   432→  }\n   433→}\n   434→\n   435→/**\n   436→ * Dijkstra's shortest path algorithm.\n   437→ * Returns the shortest path between two nodes.\n   438→ */\n   439→export function dijkstraPath(\n   440→  nodes: GraphNode[],\n   441→  edges: GraphEdge[],\n   442→  sourceId: string,\n   443→  targetId: string\n   444→): PathResult | null {\n   445→  const nodeMap = new Map<string, DijkstraNode>();\n   446→  const adjacency = new Map<string, Array<{ nodeId: string; edgeId: string; weight: number }>>();\n   447→\n   448→  // Initialize\n   449→  nodes.forEach((node) => {\n   450→    nodeMap.set(node.id, {\n   451→      id: node.id,\n   452→      distance: node.id === sourceId ? 0 : Infinity,\n   453→      previous: null,\n   454→      previousEdge: null,\n   455→    });\n   456→    adjacency.set(node.id, []);\n   457→  });\n   458→\n   459→  // Build adjacency\n   460→  edges.forEach((edge) => {\n   461→    const weight = edge.weight ?? 1;\n   462→    adjacency.get(edge.source)?.push({\n   463→      nodeId: edge.target,\n   464→      edgeId: edge.id,\n   465→      weight,\n   466→    });\n   467→    adjacency.get(edge.target)?.push({\n   468→      nodeId: edge.source,\n   469→      edgeId: edge.id,\n   470→      weight,\n   471→    });\n   472→  });\n   473→\n   474→  // Priority queue\n   475→  const pq = new PriorityQueue<string>();\n   476→  pq.push(sourceId, 0);\n   477→\n   478→  const visited = new Set<string>();\n   479→\n   480→  while (!pq.isEmpty()) {\n   481→    const currentId = pq.pop()!;\n   482→\n   483→    if (visited.has(currentId)) continue;\n   484→    visited.add(currentId);\n   485→\n   486→    if (currentId === targetId) break;\n   487→\n   488→    const current = nodeMap.get(currentId)!;\n   489→    const neighbors = adjacency.get(currentId) ?? [];\n   490→\n   491→    for (const neighbor of neighbors) {\n   492→      if (visited.has(neighbor.nodeId)) continue;\n   493→\n   494→      const alt = current.distance + neighbor.weight;\n   495→      const neighborNode = nodeMap.get(neighbor.nodeId)!;\n   496→\n   497→      if (alt < neighborNode.distance) {\n   498→        neighborNode.distance = alt;\n   499→        neighborNode.previous = currentId;\n   500→        neighborNode.previousEdge = neighbor.edgeId;\n   501→        pq.push(neighbor.nodeId, alt);\n   502→      }\n   503→    }\n   504→  }\n   505→\n   506→  // Reconstruct path\n   507→  const targetNode = nodeMap.get(targetId);\n   508→  if (!targetNode || targetNode.distance === Infinity) {\n   509→    return null;\n   510→  }\n   511→\n   512→  const path: string[] = [];\n   513→  const pathEdges: string[] = [];\n   514→  let current: string | null = targetId;\n   515→\n   516→  while (current) {\n   517→    path.unshift(current);\n   518→    const pathNodeData: DijkstraNode = nodeMap.get(current)!;\n   519→    if (pathNodeData.previousEdge) {\n   520→      pathEdges.unshift(pathNodeData.previousEdge);\n   521→    }\n   522→    current = pathNodeData.previous;\n   523→  }\n   524→\n   525→  return {\n   526→    path,\n   527→    distance: targetNode.distance,\n   528→    edges: pathEdges,\n   529→  };\n   530→}\n   531→\n   532→/**\n   533→ * Find all shortest paths from a source to all other nodes (BFS for unweighted).\n   534→ */\n   535→export function allShortestPaths(\n   536→  nodes: GraphNode[],\n   537→  edges: GraphEdge[],\n   538→  sourceId: string\n   539→): Map<string, PathResult> {\n   540→  const results = new Map<string, PathResult>();\n   541→\n   542→  for (const node of nodes) {\n   543→    if (node.id !== sourceId) {\n   544→      const result = dijkstraPath(nodes, edges, sourceId, node.id);\n   545→      if (result) {\n   546→        results.set(node.id, result);\n   547→      }\n   548→    }\n   549→  }\n   550→\n   551→  return results;\n   552→}\n   553→\n   554→// ============================================================================\n   555→// Force-Directed Edge Bundling (FDEB)\n   556→// ============================================================================\n   557→\n   558→interface BundlePoint {\n   559→  x: number;\n   560→  y: number;\n   561→  vx: number;\n   562→  vy: number;\n   563→}\n   564→\n   565→function edgeLength(p1: { x: number; y: number }, p2: { x: number; y: number }): number {\n   566→  return Math.sqrt((p2.x - p1.x) ** 2 + (p2.y - p1.y) ** 2);\n   567→}\n   568→\n   569→function edgeCompatibility(\n   570→  e1Start: { x: number; y: number },\n   571→  e1End: { x: number; y: number },\n   572→  e2Start: { x: number; y: number },\n   573→  e2End: { x: number; y: number }\n   574→): number {\n   575→  // Length compatibility\n   576→  const l1 = edgeLength(e1Start, e1End);\n   577→  const l2 = edgeLength(e2Start, e2End);\n   578→  const lavg = (l1 + l2) / 2;\n   579→  const lengthCompat = 2 / (lavg / Math.min(l1, l2) + Math.max(l1, l2) / lavg);\n   580→\n   581→  // Angle compatibility\n   582→  const d1 = { x: e1End.x - e1Start.x, y: e1End.y - e1Start.y };\n   583→  const d2 = { x: e2End.x - e2Start.x, y: e2End.y - e2Start.y };\n   584→  const len1 = Math.sqrt(d1.x ** 2 + d1.y ** 2) || 1;\n   585→  const len2 = Math.sqrt(d2.x ** 2 + d2.y ** 2) || 1;\n   586→  const dot = (d1.x * d2.x + d1.y * d2.y) / (len1 * len2);\n   587→  const angleCompat = Math.abs(dot);\n   588→\n   589→  // Position compatibility\n   590→  const m1 = { x: (e1Start.x + e1End.x) / 2, y: (e1Start.y + e1End.y) / 2 };\n   591→  const m2 = { x: (e2Start.x + e2End.x) / 2, y: (e2Start.y + e2End.y) / 2 };\n   592→  const dist = edgeLength(m1, m2);\n   593→  const posCompat = lavg / (lavg + dist);\n   594→\n   595→  return lengthCompat * angleCompat * posCompat;\n   596→}\n   597→\n   598→/**\n   599→ * Force-directed edge bundling.\n   600→ * Groups edges together based on compatibility.\n   601→ */\n   602→export function bundleEdges(\n   603→  nodes: GraphNode[],\n   604→  edges: GraphEdge[],\n   605→  config: {\n   606→    subdivisions?: number;\n   607→    iterations?: number;\n   608→    compatibility?: number;\n   609→    springConstant?: number;\n   610→  } = {}\n   611→): BundledEdge[] {\n   612→  const {\n   613→    subdivisions = 6,\n   614→    iterations = 50,\n   615→    compatibility = 0.6,\n   616→    springConstant = 0.1,\n   617→  } = config;\n   618→\n   619→  const nodeMap = new Map(nodes.map((n) => [n.id, n]));\n   620→\n   621→  // Create subdivision points for each edge\n   622→  const edgePoints = edges.map((edge) => {\n   623→    const source = nodeMap.get(edge.source)!;\n   624→    const target = nodeMap.get(edge.target)!;\n   625→\n   626→    const points: BundlePoint[] = [];\n   627→    for (let i = 0; i <= subdivisions; i++) {\n   628→      const t = i / subdivisions;\n   629→      points.push({\n   630→        x: source.x + t * (target.x - source.x),\n   631→        y: source.y + t * (target.y - source.y),\n   632→        vx: 0,\n   633→        vy: 0,\n   634→      });\n   635→    }\n   636→\n   637→    return { edge, points, source, target };\n   638→  });\n   639→\n   640→  // Pre-compute compatibility\n   641→  const compatMatrix: number[][] = [];\n   642→  for (let i = 0; i < edgePoints.length; i++) {\n   643→    compatMatrix[i] = [];\n   644→    for (let j = 0; j < edgePoints.length; j++) {\n   645→      if (i === j) {\n   646→        compatMatrix[i][j] = 0;\n   647→      } else if (j < i) {\n   648→        compatMatrix[i][j] = compatMatrix[j][i];\n   649→      } else {\n   650→        const e1 = edgePoints[i];\n   651→        const e2 = edgePoints[j];\n   652→        compatMatrix[i][j] = edgeCompatibility(e1.source, e1.target, e2.source, e2.target);\n   653→      }\n   654→    }\n   655→  }\n   656→\n   657→  // Iterative bundling\n   658→  for (let iter = 0; iter < iterations; iter++) {\n   659→    const stepSize = 0.04 * (1 - iter / iterations);\n   660→\n   661→    for (let i = 0; i < edgePoints.length; i++) {\n   662→      const e1 = edgePoints[i];\n   663→\n   664→      // Skip first and last points (anchored to nodes)\n   665→      for (let p = 1; p < e1.points.length - 1; p++) {\n   666→        const point = e1.points[p];\n   667→        let fx = 0,\n   668→          fy = 0;\n   669→\n   670→        // Spring force to neighbors\n   671→        const prev = e1.points[p - 1];\n   672→        const next = e1.points[p + 1];\n   673→        fx += springConstant * (prev.x + next.x - 2 * point.x);\n   674→        fy += springConstant * (prev.y + next.y - 2 * point.y);\n   675→\n   676→        // Electrostatic force from compatible edges\n   677→        for (let j = 0; j < edgePoints.length; j++) {\n   678→          if (i === j || compatMatrix[i][j] < compatibility) continue;\n   679→\n   680→          const e2 = edgePoints[j];\n   681→          const t = p / subdivisions;\n   682→          const p2 = e2.points[Math.round(t * subdivisions)];\n   683→\n   684→          const dx = p2.x - point.x;\n   685→          const dy = p2.y - point.y;\n   686→          const dist = Math.sqrt(dx ** 2 + dy ** 2) || 1;\n   687→\n   688→          const force = compatMatrix[i][j] / dist;\n   689→          fx += force * dx;\n   690→          fy += force * dy;\n   691→        }\n   692→\n   693→        point.x += fx * stepSize;\n   694→        point.y += fy * stepSize;\n   695→      }\n   696→    }\n   697→  }\n   698→\n   699→  // Convert to bundled edges\n   700→  return edgePoints.map(({ edge, points }) => ({\n   701→    ...edge,\n   702→    controlPoints: points.map((p) => ({ x: p.x, y: p.y })),\n   703→  }));\n   704→}\n   705→\n   706→// ============================================================================\n   707→// Layout Algorithms\n   708→// ============================================================================\n   709→\n   710→/**\n   711→ * Advanced force-directed layout with Barnes-Hut optimization.\n   712→ */\n   713→export function forceLayout(\n   714→  nodes: GraphNode[],\n   715→  edges: GraphEdge[],\n   716→  config: LayoutConfig\n   717→): GraphNode[] {\n   718→  const {\n   719→    width,\n   720→    height,\n   721→    padding = 40,\n   722→    iterations = 100,\n   723→    repulsion = 1000,\n   724→    attraction = 0.01,\n   725→    damping = 0.85,\n   726→    centerGravity = 0.05,\n   727→  } = config;\n   728→\n   729→  const centerX = width / 2;\n   730→  const centerY = height / 2;\n   731→\n   732→  // Clone nodes with initial positions\n   733→  const layoutNodes = nodes.map((node, i) => {\n   734→    const hasPosition = node.x !== undefined && node.y !== undefined && (node.x !== 0 || node.y !== 0);\n   735→    const angle = (i / nodes.length) * Math.PI * 2;\n   736→    const radius = Math.min(width, height) * 0.3;\n   737→\n   738→    return {\n   739→      ...node,\n   740→      x: hasPosition ? node.x : centerX + Math.cos(angle) * radius,\n   741→      y: hasPosition ? node.y : centerY + Math.sin(angle) * radius,\n   742→      vx: 0,\n   743→      vy: 0,\n   744→    };\n   745→  });\n   746→\n   747→  const nodeMap = new Map(layoutNodes.map((n) => [n.id, n]));\n   748→\n   749→  // Simulation\n   750→  for (let iter = 0; iter < iterations; iter++) {\n   751→    const alpha = 1 - iter / iterations;\n   752→\n   753→    // Repulsion (all pairs)\n   754→    for (let i = 0; i < layoutNodes.length; i++) {\n   755→      if (layoutNodes[i].fixed) continue;\n   756→\n   757→      for (let j = i + 1; j < layoutNodes.length; j++) {\n   758→        const n1 = layoutNodes[i];\n   759→        const n2 = layoutNodes[j];\n   760→\n   761→        const dx = n1.x - n2.x;\n   762→        const dy = n1.y - n2.y;\n   763→        const dist = Math.sqrt(dx ** 2 + dy ** 2) || 1;\n   764→        const force = (repulsion * alpha) / (dist ** 2);\n   765→\n   766→        const fx = (dx / dist) * force;\n   767→        const fy = (dy / dist) * force;\n   768→\n   769→        n1.vx! += fx;\n   770→        n1.vy! += fy;\n   771→\n   772→        if (!n2.fixed) {\n   773→          n2.vx! -= fx;\n   774→          n2.vy! -= fy;\n   775→        }\n   776→      }\n   777→    }\n   778→\n   779→    // Attraction (edges)\n   780→    for (const edge of edges) {\n   781→      const source = nodeMap.get(edge.source);\n   782→      const target = nodeMap.get(edge.target);\n   783→      if (!source || !target) continue;\n   784→\n   785→      const dx = target.x - source.x;\n   786→      const dy = target.y - source.y;\n   787→      const dist = Math.sqrt(dx ** 2 + dy ** 2) || 1;\n   788→      const force = dist * attraction * (edge.weight ?? 1) * alpha;\n   789→\n   790→      const fx = (dx / dist) * force;\n   791→      const fy = (dy / dist) * force;\n   792→\n   793→      if (!source.fixed) {\n   794→        source.vx! += fx;\n   795→        source.vy! += fy;\n   796→      }\n   797→      if (!target.fixed) {\n   798→        target.vx! -= fx;\n   799→        target.vy! -= fy;\n   800→      }\n   801→    }\n   802→\n   803→    // Center gravity\n   804→    for (const node of layoutNodes) {\n   805→      if (node.fixed) continue;\n   806→      node.vx! += (centerX - node.x) * centerGravity * alpha;\n   807→      node.vy! += (centerY - node.y) * centerGravity * alpha;\n   808→    }\n   809→\n   810→    // Apply velocities with damping\n   811→    for (const node of layoutNodes) {\n   812→      if (node.fixed) continue;\n   813→      node.vx! *= damping;\n   814→      node.vy! *= damping;\n   815→      node.x += node.vx!;\n   816→      node.y += node.vy!;\n   817→\n   818→      // Bounds\n   819→      node.x = Math.max(padding, Math.min(width - padding, node.x));\n   820→      node.y = Math.max(padding, Math.min(height - padding, node.y));\n   821→    }\n   822→  }\n   823→\n   824→  return layoutNodes;\n   825→}\n   826→\n   827→/**\n   828→ * Radial layout centered on a specific node.\n   829→ */\n   830→export function radialLayout(\n   831→  nodes: GraphNode[],\n   832→  edges: GraphEdge[],\n   833→  config: LayoutConfig\n   834→): GraphNode[] {\n   835→  const {\n   836→    width,\n   837→    height,\n   838→    padding = 40,\n   839→    centerNode,\n   840→    levelSeparation = 80,\n   841→  } = config;\n   842→\n   843→  const centerX = width / 2;\n   844→  const centerY = height / 2;\n   845→  const maxRadius = Math.min(width, height) / 2 - padding;\n   846→\n   847→  // Build adjacency\n   848→  const adjacency = new Map<string, Set<string>>();\n   849→  nodes.forEach((n) => adjacency.set(n.id, new Set()));\n   850→\n   851→  edges.forEach((e) => {\n   852→    adjacency.get(e.source)?.add(e.target);\n   853→    adjacency.get(e.target)?.add(e.source);\n   854→  });\n   855→\n   856→  // BFS from center to assign levels\n   857→  const center = centerNode ?? nodes[0]?.id;\n   858→  if (!center) return nodes;\n   859→\n   860→  const levels = new Map<string, number>();\n   861→  const queue = [center];\n   862→  levels.set(center, 0);\n   863→\n   864→  while (queue.length > 0) {\n   865→    const current = queue.shift()!;\n   866→    const currentLevel = levels.get(current)!;\n   867→\n   868→    adjacency.get(current)?.forEach((neighbor) => {\n   869→      if (!levels.has(neighbor)) {\n   870→        levels.set(neighbor, currentLevel + 1);\n   871→        queue.push(neighbor);\n   872→      }\n   873→    });\n   874→  }\n   875→\n   876→  // Handle disconnected nodes\n   877→  nodes.forEach((n) => {\n   878→    if (!levels.has(n.id)) {\n   879→      levels.set(n.id, Math.max(...levels.values()) + 1);\n   880→    }\n   881→  });\n   882→\n   883→  // Group by level\n   884→  const levelGroups = new Map<number, string[]>();\n   885→  levels.forEach((level, nodeId) => {\n   886→    if (!levelGroups.has(level)) levelGroups.set(level, []);\n   887→    levelGroups.get(level)!.push(nodeId);\n   888→  });\n   889→\n   890→  const maxLevel = Math.max(...levelGroups.keys());\n   891→  const radiusPerLevel = maxRadius / (maxLevel + 1);\n   892→\n   893→  // Position nodes\n   894→  const layoutNodes = nodes.map((node) => {\n   895→    const level = levels.get(node.id) ?? 0;\n   896→    const group = levelGroups.get(level) ?? [];\n   897→    const index = group.indexOf(node.id);\n   898→    const count = group.length;\n   899→\n   900→    let x: number, y: number;\n   901→\n   902→    if (level === 0) {\n   903→      x = centerX;\n   904→      y = centerY;\n   905→    } else {\n   906→      const radius = Math.min(level * levelSeparation, maxRadius);\n   907→      const angle = count === 1 ? 0 : (index / count) * Math.PI * 2 - Math.PI / 2;\n   908→      x = centerX + Math.cos(angle) * radius;\n   909→      y = centerY + Math.sin(angle) * radius;\n   910→    }\n   911→\n   912→    return {\n   913→      ...node,\n   914→      x,\n   915→      y,\n   916→      depth: level,\n   917→    };\n   918→  });\n   919→\n   920→  return layoutNodes;\n   921→}\n   922→\n   923→/**\n   924→ * Hierarchical/tree layout.\n   925→ */\n   926→export function hierarchicalLayout(\n   927→  nodes: GraphNode[],\n   928→  edges: GraphEdge[],\n   929→  config: LayoutConfig\n   930→): GraphNode[] {\n   931→  const {\n   932→    width,\n   933→    height,\n   934→    padding = 40,\n   935→    direction = 'TB',\n   936→    nodeSpacing = 50,\n   937→    levelSpacing = 100,\n   938→  } = config;\n   939→\n   940→  // Build tree structure\n   941→  const adjacency = new Map<string, Set<string>>();\n   942→  const inDegree = new Map<string, number>();\n   943→\n   944→  nodes.forEach((n) => {\n   945→    adjacency.set(n.id, new Set());\n   946→    inDegree.set(n.id, 0);\n   947→  });\n   948→\n   949→  edges.forEach((e) => {\n   950→    adjacency.get(e.source)?.add(e.target);\n   951→    inDegree.set(e.target, (inDegree.get(e.target) ?? 0) + 1);\n   952→  });\n   953→\n   954→  // Find roots (nodes with no incoming edges)\n   955→  const roots = nodes.filter((n) => (inDegree.get(n.id) ?? 0) === 0).map((n) => n.id);\n   956→\n   957→  if (roots.length === 0) {\n   958→    // Cyclic graph, pick first node as root\n   959→    roots.push(nodes[0].id);\n   960→  }\n   961→\n   962→  // BFS to assign levels\n   963→  const levels = new Map<string, number>();\n   964→  const queue = [...roots];\n   965→  roots.forEach((r) => levels.set(r, 0));\n   966→\n   967→  while (queue.length > 0) {\n   968→    const current = queue.shift()!;\n   969→    const currentLevel = levels.get(current)!;\n   970→\n   971→    adjacency.get(current)?.forEach((child) => {\n   972→      if (!levels.has(child)) {\n   973→        levels.set(child, currentLevel + 1);\n   974→        queue.push(child);\n   975→      }\n   976→    });\n   977→  }\n   978→\n   979→  // Handle unvisited nodes\n   980→  nodes.forEach((n) => {\n   981→    if (!levels.has(n.id)) {\n   982→      levels.set(n.id, 0);\n   983→    }\n   984→  });\n   985→\n   986→  // Group by level\n   987→  const levelGroups = new Map<number, string[]>();\n   988→  levels.forEach((level, nodeId) => {\n   989→    if (!levelGroups.has(level)) levelGroups.set(level, []);\n   990→    levelGroups.get(level)!.push(nodeId);\n   991→  });\n   992→\n   993→  const maxLevel = Math.max(...levelGroups.keys());\n   994→  const isHorizontal = direction === 'LR' || direction === 'RL';\n   995→  const isReversed = direction === 'BT' || direction === 'RL';\n   996→\n   997→  const availableWidth = isHorizontal ? height : width;\n   998→  const availableHeight = isHorizontal ? width : height;\n   999→\n  1000→  // Position nodes\n  1001→  const layoutNodes = nodes.map((node) => {\n  1002→    const level = levels.get(node.id) ?? 0;\n  1003→    const group = levelGroups.get(level) ?? [];\n  1004→    const index = group.indexOf(node.id);\n  1005→    const count = group.length;\n  1006→\n  1007→    const groupWidth = (count - 1) * nodeSpacing;\n  1008→    const startOffset = (availableWidth - groupWidth) / 2;\n  1009→\n  1010→    let primary = startOffset + index * nodeSpacing;\n  1011→    let secondary = padding + (isReversed ? maxLevel - level : level) * levelSpacing;\n  1012→\n  1013→    // Clamp to bounds\n  1014→    primary = Math.max(padding, Math.min(availableWidth - padding, primary));\n  1015→    secondary = Math.max(padding, Math.min(availableHeight - padding, secondary));\n  1016→\n  1017→    return {\n  1018→      ...node,\n  1019→      x: isHorizontal ? secondary : primary,\n  1020→      y: isHorizontal ? primary : secondary,\n  1021→      depth: level,\n  1022→    };\n  1023→  });\n  1024→\n  1025→  return layoutNodes;\n  1026→}\n  1027→\n  1028→// ============================================================================\n  1029→// Utility Functions\n  1030→// ============================================================================\n  1031→\n  1032→/**\n  1033→ * Calculate the bounding box of nodes\n  1034→ */\n  1035→export function getBounds(nodes: GraphNode[]): {\n  1036→  minX: number;\n  1037→  maxX: number;\n  1038→  minY: number;\n  1039→  maxY: number;\n  1040→  width: number;\n  1041→  height: number;\n  1042→} {\n  1043→  if (nodes.length === 0) {\n  1044→    return { minX: 0, maxX: 0, minY: 0, maxY: 0, width: 0, height: 0 };\n  1045→  }\n  1046→\n  1047→  let minX = Infinity,\n  1048→    maxX = -Infinity,\n  1049→    minY = Infinity,\n  1050→    maxY = -Infinity;\n  1051→\n  1052→  nodes.forEach((n) => {\n  1053→    const r = n.radius ?? 10;\n  1054→    minX = Math.min(minX, n.x - r);\n  1055→    maxX = Math.max(maxX, n.x + r);\n  1056→    minY = Math.min(minY, n.y - r);\n  1057→    maxY = Math.max(maxY, n.y + r);\n  1058→  });\n  1059→\n  1060→  return {\n  1061→    minX,\n  1062→    maxX,\n  1063→    minY,\n  1064→    maxY,\n  1065→    width: maxX - minX,\n  1066→    height: maxY - minY,\n  1067→  };\n  1068→}\n  1069→\n  1070→/**\n  1071→ * Find nodes connected to a given node within N hops\n  1072→ */\n  1073→export function getNeighborhood(\n  1074→  nodeId: string,\n  1075→  edges: GraphEdge[],\n  1076→  hops = 1\n  1077→): Set<string> {\n  1078→  const result = new Set<string>([nodeId]);\n  1079→  const adjacency = new Map<string, Set<string>>();\n  1080→\n  1081→  edges.forEach((e) => {\n  1082→    if (!adjacency.has(e.source)) adjacency.set(e.source, new Set());\n  1083→    if (!adjacency.has(e.target)) adjacency.set(e.target, new Set());\n  1084→    adjacency.get(e.source)!.add(e.target);\n  1085→    adjacency.get(e.target)!.add(e.source);\n  1086→  });\n  1087→\n  1088→  let frontier = new Set([nodeId]);\n  1089→\n  1090→  for (let i = 0; i < hops; i++) {\n  1091→    const newFrontier = new Set<string>();\n  1092→    frontier.forEach((id) => {\n  1093→      adjacency.get(id)?.forEach((neighbor) => {\n  1094→        if (!result.has(neighbor)) {\n  1095→          result.add(neighbor);\n  1096→          newFrontier.add(neighbor);\n  1097→        }\n  1098→      });\n  1099→    });\n  1100→    frontier = newFrontier;\n  1101→  }\n  1102→\n  1103→  return result;\n  1104→}\n  1105→\n  1106→/**\n  1107→ * Calculate graph statistics\n  1108→ */\n  1109→export function getGraphStats(\n  1110→  nodes: GraphNode[],\n  1111→  edges: GraphEdge[]\n  1112→): {\n  1113→  nodeCount: number;\n  1114→  edgeCount: number;\n  1115→  avgDegree: number;\n  1116→  density: number;\n  1117→  components: number;\n  1118→} {\n  1119→  const nodeCount = nodes.length;\n  1120→  const edgeCount = edges.length;\n  1121→  const avgDegree = nodeCount > 0 ? (edgeCount * 2) / nodeCount : 0;\n  1122→  const maxPossibleEdges = (nodeCount * (nodeCount - 1)) / 2;\n  1123→  const density = maxPossibleEdges > 0 ? edgeCount / maxPossibleEdges : 0;\n  1124→\n  1125→  // Count connected components\n  1126→  const adjacency = new Map<string, Set<string>>();\n  1127→  nodes.forEach((n) => adjacency.set(n.id, new Set()));\n  1128→  edges.forEach((e) => {\n  1129→    adjacency.get(e.source)?.add(e.target);\n  1130→    adjacency.get(e.target)?.add(e.source);\n  1131→  });\n  1132→\n  1133→  const visited = new Set<string>();\n  1134→  let components = 0;\n  1135→\n  1136→  nodes.forEach((n) => {\n  1137→    if (!visited.has(n.id)) {\n  1138→      components++;\n  1139→      const stack = [n.id];\n  1140→      while (stack.length > 0) {\n  1141→        const current = stack.pop()!;\n  1142→        if (visited.has(current)) continue;\n  1143→        visited.add(current);\n  1144→        adjacency.get(current)?.forEach((neighbor) => {\n  1145→          if (!visited.has(neighbor)) stack.push(neighbor);\n  1146→        });\n  1147→      }\n  1148→    }\n  1149→  });\n  1150→\n  1151→  return {\n  1152→    nodeCount,\n  1153→    edgeCount,\n  1154→    avgDegree,\n  1155→    density,\n  1156→    components,\n  1157→  };\n  1158→}\n  1159→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"d184f0d2-244e-457f-8ea5-4627f2d647f1","uuid":"5e924d54-ea45-44c8-9254-e51497765276","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\lib\\graphAlgorithms.ts","content":"/**\n * Graph Algorithms Library\n *\n * Contains implementations for:\n * - Louvain community detection (hierarchical clustering)\n * - Dijkstra/A* shortest path finding\n * - Force-Directed Edge Bundling (FDEB)\n * - Multiple layout algorithms (force, radial, hierarchical)\n */\n\n// ============================================================================\n// Types\n// ============================================================================\n\nexport interface GraphNode {\n  id: string;\n  x: number;\n  y: number;\n  vx?: number;\n  vy?: number;\n  type?: string;\n  label?: string;\n  data?: Record<string, unknown>;\n  radius?: number;\n  fixed?: boolean;\n  clusterId?: string;\n  depth?: number;\n}\n\nexport interface GraphEdge {\n  id: string;\n  source: string;\n  target: string;\n  weight?: number;\n  type?: string;\n  label?: string;\n  data?: Record<string, unknown>;\n}\n\nexport interface Cluster {\n  id: string;\n  nodes: string[];\n  x: number;\n  y: number;\n  radius: number;\n  parentId?: string;\n  children?: Cluster[];\n  label?: string;\n  color?: string;\n}\n\nexport interface PathResult {\n  path: string[];\n  distance: number;\n  edges: string[];\n}\n\nexport interface BundledEdge extends GraphEdge {\n  controlPoints: Array<{ x: number; y: number }>;\n}\n\nexport interface LayoutConfig {\n  width: number;\n  height: number;\n  padding?: number;\n  iterations?: number;\n  // Force layout specific\n  repulsion?: number;\n  attraction?: number;\n  damping?: number;\n  centerGravity?: number;\n  // Radial layout specific\n  centerNode?: string;\n  levelSeparation?: number;\n  // Hierarchical layout specific\n  direction?: 'TB' | 'BT' | 'LR' | 'RL';\n  nodeSpacing?: number;\n  levelSpacing?: number;\n}\n\n// ============================================================================\n// Louvain Community Detection\n// ============================================================================\n\ninterface LouvainNode {\n  id: string;\n  community: number;\n  degree: number;\n  selfLoops: number;\n}\n\ninterface LouvainState {\n  nodes: Map<string, LouvainNode>;\n  communities: Map<number, Set<string>>;\n  edges: Map<string, Map<string, number>>;\n  totalWeight: number;\n  resolution: number;\n}\n\nfunction initLouvainState(\n  nodes: GraphNode[],\n  edges: GraphEdge[],\n  resolution = 1.0\n): LouvainState {\n  const nodeMap = new Map<string, LouvainNode>();\n  const communities = new Map<number, Set<string>>();\n  const edgeMap = new Map<string, Map<string, number>>();\n\n  // Initialize each node in its own community\n  nodes.forEach((node, i) => {\n    nodeMap.set(node.id, {\n      id: node.id,\n      community: i,\n      degree: 0,\n      selfLoops: 0,\n    });\n    communities.set(i, new Set([node.id]));\n    edgeMap.set(node.id, new Map());\n  });\n\n  // Build adjacency with weights\n  let totalWeight = 0;\n  edges.forEach((edge) => {\n    const weight = edge.weight ?? 1;\n    totalWeight += weight;\n\n    const sourceEdges = edgeMap.get(edge.source);\n    const targetEdges = edgeMap.get(edge.target);\n\n    if (sourceEdges && targetEdges) {\n      sourceEdges.set(edge.target, (sourceEdges.get(edge.target) ?? 0) + weight);\n      targetEdges.set(edge.source, (targetEdges.get(edge.source) ?? 0) + weight);\n\n      const sourceNode = nodeMap.get(edge.source);\n      const targetNode = nodeMap.get(edge.target);\n\n      if (sourceNode) sourceNode.degree += weight;\n      if (targetNode) targetNode.degree += weight;\n\n      if (edge.source === edge.target && sourceNode) {\n        sourceNode.selfLoops += weight;\n      }\n    }\n  });\n\n  return {\n    nodes: nodeMap,\n    communities,\n    edges: edgeMap,\n    totalWeight: totalWeight * 2, // Each edge counted twice\n    resolution,\n  };\n}\n\nfunction modularity(state: LouvainState): number {\n  const m2 = state.totalWeight;\n  if (m2 === 0) return 0;\n\n  let q = 0;\n  state.communities.forEach((members) => {\n    let sumIn = 0;\n    let sumTot = 0;\n\n    members.forEach((nodeId) => {\n      const node = state.nodes.get(nodeId)!;\n      sumTot += node.degree;\n\n      const edges = state.edges.get(nodeId)!;\n      edges.forEach((weight, targetId) => {\n        if (members.has(targetId)) {\n          sumIn += weight;\n        }\n      });\n    });\n\n    q += sumIn / m2 - state.resolution * (sumTot / m2) * (sumTot / m2);\n  });\n\n  return q;\n}\n\nfunction modularityGain(\n  state: LouvainState,\n  nodeId: string,\n  targetCommunity: number\n): number {\n  const node = state.nodes.get(nodeId)!;\n  const m2 = state.totalWeight;\n  if (m2 === 0) return 0;\n\n  const targetMembers = state.communities.get(targetCommunity);\n  if (!targetMembers) return 0;\n\n  let sumIn = 0;\n  let sumTot = 0;\n\n  targetMembers.forEach((memberId) => {\n    const member = state.nodes.get(memberId)!;\n    sumTot += member.degree;\n  });\n\n  const edges = state.edges.get(nodeId)!;\n  edges.forEach((weight, targetId) => {\n    if (targetMembers.has(targetId)) {\n      sumIn += weight;\n    }\n  });\n\n  const ki = node.degree;\n  const kiIn = sumIn;\n\n  return (\n    (kiIn / m2 - state.resolution * (sumTot * ki) / (m2 * m2)) * 2\n  );\n}\n\nfunction moveNode(\n  state: LouvainState,\n  nodeId: string,\n  newCommunity: number\n): void {\n  const node = state.nodes.get(nodeId)!;\n  const oldCommunity = node.community;\n\n  // Remove from old community\n  const oldMembers = state.communities.get(oldCommunity);\n  if (oldMembers) {\n    oldMembers.delete(nodeId);\n    if (oldMembers.size === 0) {\n      state.communities.delete(oldCommunity);\n    }\n  }\n\n  // Add to new community\n  let newMembers = state.communities.get(newCommunity);\n  if (!newMembers) {\n    newMembers = new Set();\n    state.communities.set(newCommunity, newMembers);\n  }\n  newMembers.add(nodeId);\n\n  // Update node\n  node.community = newCommunity;\n}\n\nfunction louvainPass(state: LouvainState): boolean {\n  let improved = false;\n  const nodeIds = Array.from(state.nodes.keys());\n\n  // Randomize order for better convergence\n  for (let i = nodeIds.length - 1; i > 0; i--) {\n    const j = Math.floor(Math.random() * (i + 1));\n    [nodeIds[i], nodeIds[j]] = [nodeIds[j], nodeIds[i]];\n  }\n\n  for (const nodeId of nodeIds) {\n    const node = state.nodes.get(nodeId)!;\n    const currentCommunity = node.community;\n\n    // Find neighboring communities\n    const neighborCommunities = new Set<number>();\n    const edges = state.edges.get(nodeId)!;\n    edges.forEach((_, targetId) => {\n      const target = state.nodes.get(targetId);\n      if (target) {\n        neighborCommunities.add(target.community);\n      }\n    });\n\n    // Find best community\n    let bestCommunity = currentCommunity;\n    let bestGain = 0;\n\n    // First, calculate loss from leaving current community\n    const leaveLoss = -modularityGain(state, nodeId, currentCommunity);\n\n    for (const community of neighborCommunities) {\n      if (community !== currentCommunity) {\n        const gain = modularityGain(state, nodeId, community) + leaveLoss;\n        if (gain > bestGain) {\n          bestGain = gain;\n          bestCommunity = community;\n        }\n      }\n    }\n\n    if (bestCommunity !== currentCommunity && bestGain > 1e-10) {\n      moveNode(state, nodeId, bestCommunity);\n      improved = true;\n    }\n  }\n\n  return improved;\n}\n\n/**\n * Louvain community detection algorithm.\n * Returns clusters with assigned node IDs.\n */\nexport function louvainClustering(\n  nodes: GraphNode[],\n  edges: GraphEdge[],\n  resolution = 1.0,\n  maxIterations = 10\n): Cluster[] {\n  if (nodes.length === 0) return [];\n  if (nodes.length === 1) {\n    return [{\n      id: 'cluster-0',\n      nodes: [nodes[0].id],\n      x: nodes[0].x,\n      y: nodes[0].y,\n      radius: nodes[0].radius ?? 20,\n    }];\n  }\n\n  const state = initLouvainState(nodes, edges, resolution);\n\n  // Iterative optimization\n  for (let iter = 0; iter < maxIterations; iter++) {\n    const improved = louvainPass(state);\n    if (!improved) break;\n  }\n\n  // Convert communities to clusters\n  const nodePositions = new Map(nodes.map((n) => [n.id, { x: n.x, y: n.y }]));\n  const clusters: Cluster[] = [];\n\n  state.communities.forEach((members, communityId) => {\n    if (members.size === 0) return;\n\n    const memberArray = Array.from(members);\n    let cx = 0,\n      cy = 0,\n      maxDist = 0;\n\n    memberArray.forEach((nodeId) => {\n      const pos = nodePositions.get(nodeId);\n      if (pos) {\n        cx += pos.x;\n        cy += pos.y;\n      }\n    });\n\n    cx /= memberArray.length;\n    cy /= memberAr