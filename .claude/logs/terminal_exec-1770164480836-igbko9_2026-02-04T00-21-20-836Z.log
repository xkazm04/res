des, reducing layout time from 2-5 seconds to ~50-100ms","session_id":"d184f0d2-244e-457f-8ea5-4627f2d647f1","total_cost_usd":1.2683114999999998,"usage":{"input_tokens":18,"cache_creation_input_tokens":82660,"cache_read_input_tokens":1231239,"output_tokens":5418,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":82660,"ephemeral_5m_input_tokens":0}},"modelUsage":{"claude-opus-4-5-20251101":{"inputTokens":18,"outputTokens":5418,"cacheReadInputTokens":1231239,"cacheCreationInputTokens":82660,"webSearchRequests":0,"costUSD":1.2677844999999999,"contextWindow":200000,"maxOutputTokens":64000},"claude-haiku-4-5-20251001":{"inputTokens":367,"outputTokens":32,"cacheReadInputTokens":0,"cacheCreationInputTokens":0,"webSearchRequests":0,"costUSD":0.0005269999999999999,"contextWindow":200000,"maxOutputTokens":64000}},"permission_denials":[],"uuid":"3dc36f95-b746-43f7-bc51-6ac757d010f7"}
