 concurrent writes"}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":216,"cache_read_input_tokens":117444,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":216},"output_tokens":1,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"d184f0d2-244e-457f-8ea5-4627f2d647f1","uuid":"f6fcf967-ac36-4c0c-a735-05ef987c4a48"}
