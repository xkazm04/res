 *   nextCursor: string | null,","- *   prevCursor: string | null,","+ *   nextCursor: { id: string, createdAt: string } | null,","  *   hasMore: boolean,","- *   totalCount: number (only on first page)","+ *   totalCount: number (cached, refreshes every 60s)","  * }","  */"," export async function GET(request: NextRequest) {"]}],"userModified":false,"replaceAll":false}}
