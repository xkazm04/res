[2026-02-04T00:29:04.399Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01U1P5MPEUcvibiBUrDy5vDY","type":"tool_result","content":"     1→/**\n     2→ * Investigative Template Configuration\n     3→ *\n     4→ * Migrated from: actor/src/templates/investigative.py\n     5→ *\n     6→ * Template for investigative journalism research including:\n     7→ * - Key actors and relationships\n     8→ * - Timeline and events\n     9→ * - Financial trails\n    10→ * - Evidence and patterns\n    11→ */\n    12→\n    13→import { TemplateConfig } from '../types';\n    14→\n    15→export const investigativeConfig: TemplateConfig = {\n    16→  // ---- Identity ----\n    17→  templateId: 'investigative',\n    18→  templateName: 'Investigative Research',\n    19→  description:\n    20→    'Deep investigative journalism with actor and relationship analysis',\n    21→\n    22→  // ---- Search Phase Configuration ----\n    23→  searchIntro:\n    24→    'You are an investigative journalist planning research queries for a deep investigation.',\n    25→\n    26→  searchAngles: [\n    27→    {\n    28→      name: 'KEY ACTORS',\n    29→      items: [\n    30→        'Who are the main people/organizations involved?',\n    31→        'Backgrounds and histories of key individuals',\n    32→        'Corporate structures and ownership',\n    33→      ],\n    34→    },\n    35→    {\n    36→      name: 'TIMELINE',\n    37→      items: [\n    38→        'What events happened and when?',\n    39→        'Sequence of key decisions and actions',\n    40→        'Historical context and precedents',\n    41→      ],\n    42→    },\n    43→    {\n    44→      name: 'LOCATIONS',\n    45→      items: [\n    46→        'Where did key events occur?',\n    47→        'What jurisdictions are involved?',\n    48→        'Geographic patterns and connections',\n    49→      ],\n    50→    },\n    51→    {\n    52→      name: 'MOTIVATIONS',\n    53→      items: [\n    54→        'What are the underlying interests?',\n    55→        'Relationships and alliances',\n    56→        'Conflicts of interest',\n    57→      ],\n    58→    },\n    59→    {\n    60→      name: 'METHODS',\n    61→      items: [\n    62→        'How were things done?',\n    63→        'What mechanisms were used?',\n    64→        'Patterns of behavior or action',\n    65→      ],\n    66→    },\n    67→    {\n    68→      name: 'MONEY TRAIL',\n    69→      items: [\n    70→        'Financial connections and transactions',\n    71→        'Funding sources and flows',\n    72→        'Property and asset movements',\n    73→      ],\n    74→    },\n    75→    {\n    76→      name: 'OFFICIAL RECORDS',\n    77→      items: [\n    78→        'Government filings and registrations',\n    79→        'Court documents and legal proceedings',\n    80→        'Regulatory actions and investigations',\n    81→      ],\n    82→    },\n    83→    {\n    84→      name: 'MEDIA COVERAGE',\n    85→      items: [\n    86→        'News reports and investigations',\n    87→        'Interviews and public statements',\n    88→        'Coverage patterns and omissions',\n    89→      ],\n    90→    },\n    91→    {\n    92→      name: 'NARRATIVE ARCHAEOLOGY',\n    93→      items: [\n    94→        'First appearance of key talking points and claims - trace to origin',\n    95→        'Evolution of story framing over time across different outlets',\n    96→        'Sources that covered vs systematically ignored this story',\n    97→        'Fact-checks: who funded them, what methodology, any conflicts',\n    98→        'PR firms and communications consultants involved',\n    99→      ],\n   100→    },\n   101→    {\n   102→      name: 'INCENTIVE MAPPING',\n   103→      items: [\n   104→        'Financial beneficiaries of current dominant narrative',\n   105→        'Career incentives and revolving doors for key spokespeople',\n   106→        'Funding sources for research, think tanks, and experts cited',\n   107→        'Regulatory capture indicators and agency-industry relationships',\n   108→        'Political donations and lobbying by involved parties',\n   109→      ],\n   110→    },\n   111→    {\n   112→      name: 'TEMPORAL ANALYSIS',\n   113→      items: [\n   114→        'What else happened on the same day that received less coverage',\n   115→        'Timing of announcements relative to other events (Friday news dumps)',\n   116→        'Long-term patterns that short-term coverage obscures',\n   117→        'Seasonal or cyclical patterns in similar events',\n   118→      ],\n   119→    },\n   120→    {\n   121→      name: 'NETWORK INFERENCE',\n   122→      items: [\n   123→        'Board memberships, advisory roles shared between actors',\n   124→        'Conference co-appearances, co-authorships, joint ventures',\n   125→        'Funding flows through foundations, NGOs, and intermediaries',\n   126→        'Social connections: school ties, club memberships, family',\n   127→      ],\n   128→    },\n   129→  ],\n   130→\n   131→  searchDepthGuidance: {\n   132→    quick: 'Focus on 1-3 most critical angles',\n   133→    standard: 'Cover 4-5 key angles with balanced depth',\n   134→    deep: 'Comprehensive coverage of all angles with follow-up queries',\n   135→  },\n   136→\n   137→  // ---- Extraction Phase Configuration ----\n   138→  extractionIntro:\n   139→    'You are an investigative analyst extracting key findings for a deep investigation.',\n   140→\n   141→  findingTypes: [\n   142→    {\n   143→      name: 'actor',\n   144→      displayName: 'Actor',\n   145→      description:\n   146→        'People, organizations, entities involved. Include: name, role, affiliations, significance. Note any aliases or connections.',\n   147→      extractedDataSchema:\n   148→        '{\"name\": \"...\", \"role\": \"...\", \"affiliations\": [...], \"significance\": \"...\", \"aliases\": [...]}',\n   149→      analysisFallback:\n   150→        \"This actor's role and connections warrant further investigation to understand their influence on events.\",\n   151→    },\n   152→    {\n   153→      name: 'event',\n   154→      displayName: 'Event',\n   155→      description:\n   156→        'Key incidents, actions, decisions. Include: date (if known), location, participants, outcome. Note sequence and causation.',\n   157→      extractedDataSchema:\n   158→        '{\"date\": \"...\", \"location\": \"...\", \"participants\": [...], \"outcome\": \"...\", \"causation\": \"...\"}',\n   159→      analysisFallback:\n   160→        'This event is significant in the investigative timeline and may have causal links to other developments.',\n   161→    },\n   162→    {\n   163→      name: 'relationship',\n   164→      displayName: 'Relationship',\n   165→      description:\n   166→        'Connections between actors. Types: personal, professional, political, criminal. Include strength of evidence.',\n   167→      extractedDataSchema:\n   168→        '{\"actor_a\": \"...\", \"actor_b\": \"...\", \"relationship_type\": \"...\", \"evidence_strength\": \"strong/moderate/weak\"}',\n   169→      analysisFallback:\n   170→        'This connection reveals potential coordination or influence that could be relevant to the investigation.',\n   171→    },\n   172→    {\n   173→      name: 'financial',\n   174→      displayName: 'Financial Transaction',\n   175→      description:\n   176→        'ANY money movement: payments, gifts, loans, wire transfers, settlements, property purchases, investments, donations. This is CRITICAL - extract ALL financial amounts mentioned.',\n   177→      extractedDataSchema:\n   178→        '{\"amount\": 0, \"currency\": \"USD\", \"payer\": \"...\", \"payee\": \"...\", \"transaction_date\": \"YYYY-MM-DD\", \"transaction_type\": \"payment/gift/loan/wire_transfer/property/settlement/investment\", \"purpose\": \"...\"}',\n   179→      analysisFallback:\n   180→        'This financial transaction may indicate underlying arrangements that require further scrutiny.',\n   181→    },\n   182→    {\n   183→      name: 'evidence',\n   184→      displayName: 'Evidence',\n   185→      description:\n   186→        'Documents, statements, data points. Include: type, source, significance. Note verification status.',\n   187→      extractedDataSchema:\n   188→        '{\"evidence_type\": \"document/statement/data\", \"source\": \"...\", \"significance\": \"...\", \"verified\": true}',\n   189→      analysisFallback:\n   190→        'This evidence supports key aspects of the investigation and strengthens the evidentiary foundation.',\n   191→    },\n   192→    {\n   193→      name: 'pattern',\n   194→      displayName: 'Pattern',\n   195→      description:\n   196→        'Recurring behaviors, methods, structures. Include: description, frequency, participants.',\n   197→      extractedDataSchema:\n   198→        '{\"description\": \"...\", \"frequency\": \"...\", \"participants\": [...], \"time_span\": \"...\"}',\n   199→      analysisFallback:\n   200→        'This recurring pattern suggests systematic behavior that may indicate intentional coordination.',\n   201→    },\n   202→    {\n   203→      name: 'gap',\n   204→      displayName: 'Gap',\n   205→      description:\n   206→        \"Missing information, unanswered questions. What we don't know and why it matters. Suggested follow-up.\",\n   207→      extractedDataSchema:\n   208→        '{\"question\": \"...\", \"importance\": \"high/medium/low\", \"suggested_followup\": [...]}',\n   209→      analysisFallback:\n   210→        'This information gap limits our ability to draw complete conclusions and should be addressed.',\n   211→    },\n   212→    {\n   213→      name: 'narrative_frame',\n   214→      displayName: 'Narrative Frame',\n   215→      description:\n   216→        'How the story is being framed and told. Includes: dominant narrative, framing choices, language patterns (passive voice, euphemisms), emotional appeals, what is emphasized vs minimized.',\n   217→      extractedDataSchema:\n   218→        '{\"dominant_frame\": \"...\", \"framing_techniques\": [...], \"language_patterns\": [...], \"emphasized\": [...], \"minimized\": [...]}',\n   219→      analysisFallback:\n   220→        'This framing choice shapes how audiences interpret events and may obscure alternative interpretations.',\n   221→    },\n   222→    {\n   223→      name: 'incentive_alignment',\n   224→      displayName: 'Incentive Alignment',\n   225→      description:\n   226→        'Who benefits from this claim or narrative being believed. Follow the money and career incentives. Note conflicts of interest.',\n   227→      extractedDataSchema:\n   228→        '{\"beneficiaries\": [...], \"incentive_type\": \"financial/career/political/reputational\", \"conflicts_of_interest\": [...], \"cui_bono\": \"...\"}',\n   229→      analysisFallback:\n   230→        'Understanding who benefits from a narrative reveals potential bias and motivation.',\n   231→    },\n   232→    {\n   233→      name: 'historical_parallel',\n   234→      displayName: 'Historical Parallel',\n   235→      description:\n   236→        'Similar past events or patterns. Playbook recognition - has this type of situation played out before? What happened then?',\n   237→      extractedDataSchema:\n   238→        '{\"historical_event\": \"...\", \"date\": \"...\", \"similarity_score\": 0.8, \"key_parallels\": [...], \"key_differences\": [...], \"outcome_then\": \"...\"}',\n   239→      analysisFallback:\n   240→        'Historical patterns often repeat; understanding precedents illuminates likely trajectories.',\n   241→    },\n   242→    {\n   243→      name: 'suspicious_timing',\n   244→      displayName: 'Suspicious Timing',\n   245→      description:\n   246→        'Events with convenient timing. What else happened simultaneously? Friday news dumps, holiday releases, distraction events.',\n   247→      extractedDataSchema:\n   248→        '{\"event\": \"...\", \"timing\": \"...\", \"concurrent_events\": [...], \"potential_distraction_from\": \"...\", \"pattern_type\": \"news_dump/distraction/preemption\"}',\n   249→      analysisFallback:\n   250→        'Timing of disclosures and events often reveals strategic intent.',\n   251→    },\n   252→    {\n   253→      name: 'coverage_asymmetry',\n   254→      displayName: 'Coverage Asymmetry',\n   255→      description:\n   256→        'Same event covered very differently by different sources. What do some sources include that others omit? Systematic patterns.',\n   257→      extractedDataSchema:\n   258→        '{\"event\": \"...\", \"source_a\": \"...\", \"source_b\": \"...\", \"included_by_a_only\": [...], \"included_by_b_only\": [...], \"framing_difference\": \"...\"}',\n   259→      analysisFallback:\n   260→        'Differential coverage reveals editorial biases and potentially coordinated narratives.',\n   261→    },\n   262→    {\n   263→      name: 'network_inference',\n   264→      displayName: 'Network Inference',\n   265→      description:\n   266→        'Implied relationships not explicitly documented. Shared board seats, funding connections, social ties, professional networks.',\n   267→      extractedDataSchema:\n   268→        '{\"actor_a\": \"...\", \"actor_b\": \"...\", \"connection_type\": \"board/funding/social/professional\", \"intermediaries\": [...], \"strength\": \"strong/moderate/weak\"}',\n   269→      analysisFallback:\n   270→        'Informal networks often explain coordinated behavior that formal relationships cannot.',\n   271→    },\n   272→  ],\n   273→\n   274→  extractionGuidelines: `CRITICAL: The \"analysis\" field must provide substantive reasoning, not just restate the finding.\n   275→Bad example: \"This is an important financial transaction.\"\n   276→Good example: \"This payment pattern suggests a quid pro quo arrangement because the timing coincides with the policy change. The use of intermediary accounts indicates awareness that direct payment would raise red flags. This connects to the earlier lobbying activity and raises questions about who authorized the payment structure.\"\n   277→\n   278→IMPORTANT:\n   279→- Prioritize extracting ALL financial transactions with specific dollar amounts\n   280→- Note corroboration status for key claims\n   281→- Flag connections that warrant further investigation`,\n   282→\n   283→  analysisInstruction: `YOUR EXPERT ANALYTICAL COMMENTARY (REQUIRED - 2-4 sentences) explaining:\n   284→  * WHY this finding is significant for the investigation\n   285→  * What it IMPLIES about the broader situation\n   286→  * How it CONNECTS to other findings or patterns\n   287→  * What questions it RAISES or answers`,\n   288→\n   289→  // ---- Ordering & Grouping ----\n   290→  priorityFindingTypes: [\n   291→    'financial',\n   292→    'evidence',\n   293→    'actor',\n   294→    'relationship',\n   295→    'pattern',\n   296→    'narrative_frame',\n   297→    'incentive_alignment',\n   298→    'network_inference',\n   299→  ],\n   300→  groupingOrder: [\n   301→    'financial',\n   302→    'actor',\n   303→    'relationship',\n   304→    'evidence',\n   305→    'event',\n   306→    'pattern',\n   307→    'narrative_frame',\n   308→    'incentive_alignment',\n   309→    'historical_parallel',\n   310→    'suspicious_timing',\n   311→    'coverage_asymmetry',\n   312→    'network_inference',\n   313→    'gap',\n   314→  ],\n   315→\n   316→  // ---- Perspectives ----\n   317→  // 9 expert perspectives for deep investigative analysis\n   318→  perspectives: [\n   319→    'forensic_financial', // Follow the money, fraud detection\n   320→    'power_network', // Map influence networks and institutional capture\n   321→    'psychological_behavioral', // Analyze motivations and credibility\n   322→    'legal_liability', // Assess legal exposure and enforcement risk\n   323→    'geopolitical_strategic', // Strategic interests and power dynamics\n   324→    'narrative_analyst', // How stories are framed, meta-narrative analysis\n   325→    'incentive_mapper', // Cui bono analysis, follow the money\n   326→    'historical_pattern', // Pattern recognition across time\n   327→    'omission_detective', // What's NOT being reported and why\n   328→  ],\n   329→\n   330→  // ---- Verification ----\n   331→  // Investigative requires thorough verification on all dimensions\n   332→  // Critical to verify claims, detect cover-ups, and identify spin\n   333→  verificationConfig: {\n   334→    crossReference: 'thorough', // Must corroborate claims\n   335→    biasDetection: 'thorough', // Detect PR spin, cover-ups\n   336→    expertSanityCheck: 'thorough', // Flag implausible claims\n   337→    sourceQuality: 'thorough', // Primary sources critical\n   338→  },\n   339→\n   340→  // ---- Resource Limits ----\n   341→  defaultMaxSearches: 8,\n   342→};\n   343→\n   344→export default investigativeConfig;\n   345→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"d184f0d2-244e-457f-8ea5-4627f2d647f1","uuid":"ed5e71e3-b3ae-4d9d-8ca1-1958591447d5","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\templates\\research\\investigative.ts","content":"/**\n * Investigative Template Configuration\n *\n * Migrated from: actor/src/templates/investigative.py\n *\n * Template for investigative journalism research including:\n * - Key actors and relationships\n * - Timeline and events\n * - Financial trails\n * - Evidence and patterns\n */\n\nimport { TemplateConfig } from '../types';\n\nexport const investigativeConfig: TemplateConfig = {\n  // ---- Identity ----\n  templateId: 'investigative',\n  templateName: 'Investigative Research',\n  description:\n    'Deep investigative journalism with actor and relationship analysis',\n\n  // ---- Search Phase Configuration ----\n  searchIntro:\n    'You are an investigative journalist planning research queries for a deep investigation.',\n\n  searchAngles: [\n    {\n      name: 'KEY ACTORS',\n      items: [\n        'Who are the main people/organizations involved?',\n        'Backgrounds and histories of key individuals',\n        'Corporate structures and ownership',\n      ],\n    },\n    {\n      name: 'TIMELINE',\n      items: [\n        'What events happened and when?',\n        'Sequence of key decisions and actions',\n        'Historical context and precedents',\n      ],\n    },\n    {\n      name: 'LOCATIONS',\n      items: [\n        'Where did key events occur?',\n        'What jurisdictions are involved?',\n        'Geographic patterns and connections',\n      ],\n    },\n    {\n      name: 'MOTIVATIONS',\n      items: [\n        'What are the underlying interests?',\n        'Relationships and alliances',\n        'Conflicts of interest',\n      ],\n    },\n    {\n      name: 'METHODS',\n      items: [\n        'How were things done?',\n        'What mechanisms were used?',\n        'Patterns of behavior or action',\n      ],\n    },\n    {\n      name: 'MONEY TRAIL',\n      items: [\n        'Financial connections and transactions',\n        'Funding sources and flows',\n        'Property and asset movements',\n      ],\n    },\n    {\n      name: 'OFFICIAL RECORDS',\n      items: [\n        'Government filings and registrations',\n        'Court documents and legal proceedings',\n        'Regulatory actions and investigations',\n      ],\n    },\n    {\n      name: 'MEDIA COVERAGE',\n      items: [\n        'News reports and investigations',\n        'Interviews and public statements',\n        'Coverage patterns and omissions',\n      ],\n    },\n    {\n      name: 'NARRATIVE ARCHAEOLOGY',\n      items: [\n        'First appearance of key talking points and claims - trace to origin',\n        'Evolution of story framing over time across different outlets',\n        'Sources that covered vs systematically ignored this story',\n        'Fact-checks: who funded them, what methodology, any conflicts',\n        'PR firms and communications consultants involved',\n      ],\n    },\n    {\n      name: 'INCENTIVE MAPPING',\n      items: [\n        'Financial beneficiaries of current dominant narrative',\n        'Career incentives and revolving doors for key spokespeople',\n        'Funding sources for research, think tanks, and experts cited',\n        'Regulatory capture indicators and agency-industry relationships',\n        'Political donations and lobbying by involved parties',\n      ],\n    },\n    {\n      name: 'TEMPORAL ANALYSIS',\n      items: [\n        'What else happened on the same day that received less coverage',\n        'Timing of announcements relative to other events (Friday news dumps)',\n        'Long-term patterns that short-term coverage obscures',\n        'Seasonal or cyclical patterns in similar events',\n      ],\n    },\n    {\n      name: 'NETWORK INFERENCE',\n      items: [\n        'Board memberships, advisory roles shared between actors',\n        'Conference co-appearances, co-authorships, joint ventures',\n        'Funding flows through foundations, NGOs, and intermediaries',\n        'Social connections: school ties, club memberships, family',\n      ],\n    },\n  ],\n\n  searchDepthGuidance: {\n    quick: 'Focus on 1-3 most critical angles',\n    standard: 'Cover 4-5 key angles with balanced depth',\n    deep: 'Comprehensive coverage of all angles with follow-up queries',\n  },\n\n  // ---- Extraction Phase Configuration ----\n  extractionIntro:\n    'You are an investigative analyst extracting key findings for a deep investigation.',\n\n  findingTypes: [\n    {\n      name: 'actor',\n      displayName: 'Actor',\n      description:\n        'People, organizations, entities involved. Include: name, role, affiliations, significance. Note any aliases or connections.',\n      extractedDataSchema:\n        '{\"name\": \"...\", \"role\": \"...\", \"affiliations\": [...], \"significance\": \"...\", \"aliases\": [...]}',\n      analysisFallback:\n        \"This actor's role and connections warrant further investigation to understand their influence on events.\",\n    },\n    {\n      name: 'event',\n      displayName: 'Event',\n      description:\n        'Key incidents, actions, decisions. Include: date (if known), location, participants, outcome. Note sequence and causation.',\n      extractedDataSchema:\n        '{\"date\": \"...\", \"location\": \"...\", \"participants\": [...], \"outcome\": \"...\", \"causation\": \"...\"}',\n      analysisFallback:\n        'This event is significant in the investigative timeline and may have causal links to other developments.',\n    },\n    {\n      name: 'relationship',\n      displayName: 'Relationship',\n      description:\n        'Connections between actors. Types: personal, professional, political, criminal. Include strength of evidence.',\n      extractedDataSchema:\n        '{\"actor_a\": \"...\", \"actor_b\": \"...\", \"relationship_type\": \"...\", \"evidence_strength\": \"strong/moderate/weak\"}',\n      analysisFallback:\n        'This connection reveals potential coordination or influence that could be relevant to the investigation.',\n    },\n    {\n      name: 'financial',\n      displayName: 'Financial Transaction',\n      description:\n        'ANY money movement: payments, gifts, loans, wire transfers, settlements, property purchases, investments, donations. This is CRITICAL - extract ALL financial amounts mentioned.',\n      extractedDataSchema:\n        '{\"amount\": 0, \"currency\": \"USD\", \"payer\": \"...\", \"payee\": \"...\", \"transaction_date\": \"YYYY-MM-DD\", \"transaction_type\": \"payment/gift/loan/wire_transfer/property/settlement/investment\", \"purpose\": \"...\"}',\n      analysisFallback:\n        'This financial transaction may indicate underlying arrangements that require further scrutiny.',\n    },\n    {\n      name: 'evidence',\n      displayName: 'Evidence',\n      description:\n        'Documents, statements, data points. Include: type, source, significance. Note verification status.',\n      extractedDataSchema:\n        '{\"evidence_type\": \"document/statement/data\", \"source\": \"...\", \"significance\": \"...\", \"verified\": true}',\n      analysisFallback:\n        'This evidence supports key aspects of the investigation and strengthens the evidentiary foundation.',\n    },\n    {\n      name: 'pattern',\n      displayName: 'Pattern',\n      description:\n        'Recurring behaviors, methods, structures. Include: description, frequency, participants.',\n      extractedDataSchema:\n        '{\"description\": \"...\", \"frequency\": \"...\", \"participants\": [...], \"time_span\": \"...\"}',\n      analysisFallback:\n        'This recurring pattern suggests systematic behavior that may indicate intentional coordination.',\n    },\n    {\n      name: 'gap',\n      displayName: 'Gap',\n      description:\n        \"Missing information, unanswered questions. What we don't know and why it matters. Suggested follow-up.\",\n      extractedDataSchema:\n        '{\"question\": \"...\", \"importance\": \"high/medium/low\", \"suggested_followup\": [...]}',\n      analysisFallback:\n        'This information gap limits our ability to draw complete conclusions and should be addressed.',\n    },\n    {\n      name: 'narrative_frame',\n      displayName: 'Narrative Frame',\n      description:\n        'How the story is being framed and told. Includes: dominant narrative, framing choices, language patterns (passive voice, euphemisms), emotional appeals, what is emphasized vs minimized.',\n      extractedDataSchema:\n        '{\"dominant_frame\": \"...\", \"framing_techniques\": [...], \"language_patterns\": [...], \"emphasized\": [...], \"minimized\": [...]}',\n      analysisFallback:\n        'This framing choice shapes how audiences interpret events and may obscure alternative interpretations.',\n    },\n    {\n      name: 'incentive_alignment',\n      displayName: 'Incentive Alignment',\n      description:\n        'Who benefits from this claim or narrative being believed. Follow the money and career incentives. Note conflicts of interest.',\n      extractedDataSchema:\n        '{\"beneficiaries\": [...], \"incentive_type\": \"financial/career/political/reputational\", \"conflicts_of_interest\": [...], \"cui_bono\": \"...\"}',\n      analysisFallback:\n        'Understanding who benefits from a narrative reveals potential bias and motivation.',\n    },\n    {\n      name: 'historical_parallel',\n      displayName: 'Historical Parallel',\n      description:\n        'Similar past events or patterns. Playbook recognition - has this type of situation played out before? What happened then?',\n      extractedDataSchema:\n        '{\"historical_event\": \"...\", \"date\": \"...\", \"similarity_score\": 0.8, \"key_parallels\": [...], \"key_differences\": [...], \"outcome_then\": \"...\"}',\n      analysisFallback:\n        'Historical patterns often repeat; understanding precedents illuminates likely trajectories.',\n    },\n    {\n      name: 'suspicious_timing',\n      displayName: 'Suspicious Timing',\n      description:\n        'Events with convenient timing. What else happened simultaneously? Friday news dumps, holiday releases, distraction events.',\n      extractedDataSchema:\n        '{\"event\": \"...\", \"timing\": \"...\", \"concurrent_events\": [...], \"potential_distraction_from\": \"...\", \"pattern_type\": \"news_dump/distraction/preemption\"}',\n      analysisFallback:\n        'Timing of disclosures and events often reveals strategic intent.',\n    },\n    {\n      name: 'coverage_asymmetry',\n      displayName: 'Coverage Asymmetry',\n      description:\n        'Same event covered very differently by different sources. What do some sources include that others omit? Systematic patterns.',\n      extractedDataSchema:\n        '{\"event\": \"...\", \"source_a\": \"...\", \"source_b\": \"...\", \"included_by_a_only\": [...], \"included_by_b_only\": [...], \"framing_difference\": \"...\"}',\n      analysisFallback:\n        'Differential coverage reveals editorial biases and potentially coordinated narratives.',\n    },\n    {\n      name: 'network_inference',\n      displayName: 'Network Inference',\n      description:\n        'Implied relationships not explicitly documented. Shared board seats, funding connections, social ties, professional networks.',\n      extractedDataSchema:\n        '{\"actor_a\": \"...\", \"actor_b\": \"...\", \"connection_type\": \"board/funding/social/professional\", \"intermediaries\": [...], \"strength\": \"strong/moderate/weak\"}',\n      analysisFallback:\n        'Informal networks often explain coordinated behavior that formal relationships cannot.',\n    },\n  ],\n\n  extractionGuidelines: `CRITICAL: The \"analysis\" field must provide substantive reasoning, not just restate the finding.\nBad example: \"This is an important financial transaction.\"\nGood example: \"This payment pattern suggests a quid pro quo arrangement because the timing coincides with the policy change. The use of intermediary accounts indicates awareness that direct payment would raise red flags. This connects to the earlier lobbying activity and raises questions about who authorized the payment structure.\"\n\nIMPORTANT:\n- Prioritize extracting ALL financial transactions with specific dollar amounts\n- Note corroboration status for key claims\n- Flag connections that warrant further investigation`,\n\n  analysisInstruction: `YOUR EXPERT ANALYTICAL COMMENTARY (REQUIRED - 2-4 sentences) explaining:\n  * WHY this finding is significant for the investigation\n  * What it IMPLIES about the broader situation\n  * How it CONNECTS to other findings or patterns\n  * What questions it RAISES or answers`,\n\n  // ---- Ordering & Grouping ----\n  priorityFindingTypes: [\n    'financial',\n    'evidence',\n    'actor',\n    'relationship',\n    'pattern',\n    'narrative_frame',\n    'incentive_alignment',\n    'network_inference',\n  ],\n  groupingOrder: [\n    'financial',\n    'actor',\n    'relationship',\n    'evidence',\n    'event',\n    'pattern',\n    'narrative_frame',\n    'incentive_alignment',\n    'historical_parallel',\n    'suspicious_timing',\n    'coverage_asymmetry',\n    'network_inference',\n    'gap',\n  ],\n\n  // ---- Perspectives ----\n  // 9 expert perspectives for deep investigative analysis\n  perspectives: [\n    'forensic_financial', // Follow the money, fraud detection\n    'power_network', // Map influence networks and institutional capture\n    'psychological_behavioral', // Analyze motivations and credibility\n    'legal_liability', // Assess legal exposure and enforcement risk\n    'geopolitical_strategic', // Strategic interests and power dynamics\n    'narrative_analyst', // How stories are framed, meta-narrative analysis\n    'incentive_mapper', // Cui bono analysis, follow the money\n    'historical_pattern', // Pattern recognition across time\n    'omission_detective', // What's NOT being reported and why\n  ],\n\n  // ---- Verification ----\n  // Investigative requires thorough verification on all dimensions\n  // Critical to verify claims, detect cover-ups, and identify spin\n  verificationConfig: {\n    crossReference: 'thorough', // Must corroborate claims\n    biasDetection: 'thorough', // Detect PR spin, cover-ups\n    expertSanityCheck: 'thorough', // Flag implausible claims\n    sourceQuality: 'thorough', // Primary sources critical\n  },\n\n  // ---- Resource Limits ----\n  defaultMaxSearches: 8,\n};\n\nexport default investigativeConfig;\n","numLines":345,"startLine":1,"totalLines":345}}}
