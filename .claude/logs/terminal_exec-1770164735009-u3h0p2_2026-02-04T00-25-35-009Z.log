[2026-02-04T00:29:08.977Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016rhLf8YMKrM1LZZ8mPUa2e","type":"tool_result","content":"     1→/**\n     2→ * Legal Research Template Configuration\n     3→ *\n     4→ * Migrated from: actor/src/templates/legal.py\n     5→ *\n     6→ * Template for legal research and regulatory analysis including:\n     7→ * - Case law, statutes, and regulations\n     8→ * - Enforcement actions and litigation history\n     9→ * - Legal commentary and compliance requirements\n    10→ */\n    11→\n    12→import { TemplateConfig } from '../types';\n    13→\n    14→export const legalConfig: TemplateConfig = {\n    15→  // ---- Identity ----\n    16→  templateId: 'legal',\n    17→  templateName: 'Legal Research',\n    18→  description: 'Legal case research, regulatory analysis, and compliance assessment',\n    19→\n    20→  // ---- Search Phase Configuration ----\n    21→  searchIntro:\n    22→    'You are a legal researcher planning comprehensive legal research for a law firm or legal department.',\n    23→\n    24→  searchAngles: [\n    25→    {\n    26→      name: 'CASE LAW',\n    27→      items: [\n    28→        'Relevant federal and state court decisions',\n    29→        'Appellate decisions and precedents',\n    30→        'Recent rulings in this area',\n    31→        'Landmark cases that shaped the law',\n    32→      ],\n    33→    },\n    34→    {\n    35→      name: 'STATUTES AND REGULATIONS',\n    36→      items: [\n    37→        'Applicable federal statutes (U.S. Code)',\n    38→        'State statutes and laws',\n    39→        'Federal regulations (CFR, Federal Register)',\n    40→        'State and local regulations',\n    41→      ],\n    42→    },\n    43→    {\n    44→      name: 'REGULATORY GUIDANCE',\n    45→      items: [\n    46→        'Agency interpretive guidance',\n    47→        'No-action letters, advisory opinions',\n    48→        'Enforcement policy statements',\n    49→        'FAQ and compliance bulletins',\n    50→      ],\n    51→    },\n    52→    {\n    53→      name: 'ENFORCEMENT ACTIONS',\n    54→      items: [\n    55→        'SEC, DOJ, FTC enforcement actions',\n    56→        'State AG actions',\n    57→        'Consent decrees and settlements',\n    58→        'Criminal prosecutions',\n    59→      ],\n    60→    },\n    61→    {\n    62→      name: 'LITIGATION HISTORY',\n    63→      items: [\n    64→        'Active lawsuits and proceedings',\n    65→        'Class action filings',\n    66→        'Qui tam and whistleblower cases',\n    67→        'Arbitration and alternative dispute resolution',\n    68→      ],\n    69→    },\n    70→    {\n    71→      name: 'LEGAL COMMENTARY',\n    72→      items: [\n    73→        'Law review articles and legal scholarship',\n    74→        'Bar association publications',\n    75→        'Legal blog analysis',\n    76→        'Expert commentary',\n    77→      ],\n    78→    },\n    79→    {\n    80→      name: 'REGULATORY FILINGS',\n    81→      items: [\n    82→        'SEC filings (8-K, 10-K risk factors)',\n    83→        'Lobbying disclosures',\n    84→        'Comment letters on proposed rules',\n    85→        'Patent and trademark filings',\n    86→      ],\n    87→    },\n    88→    {\n    89→      name: 'CONTRACTUAL ANALYSIS',\n    90→      items: [\n    91→        'Standard contract terms in this area',\n    92→        'Key contractual provisions',\n    93→        'Industry standard agreements',\n    94→        'Licensing and IP arrangements',\n    95→      ],\n    96→    },\n    97→    {\n    98→      name: 'COMPLIANCE REQUIREMENTS',\n    99→      items: [\n   100→        'Regulatory compliance checklists',\n   101→        'Industry standards and best practices',\n   102→        'Self-regulatory organization rules',\n   103→        'International compliance requirements',\n   104→      ],\n   105→    },\n   106→    {\n   107→      name: 'LEGAL TRENDS',\n   108→      items: [\n   109→        'Proposed legislation',\n   110→        'Regulatory reform initiatives',\n   111→        'Emerging legal theories',\n   112→        'Judicial appointment impacts',\n   113→      ],\n   114→    },\n   115→    {\n   116→      name: 'REGULATORY CAPTURE ANALYSIS',\n   117→      items: [\n   118→        'Revolving door between regulators and regulated entities',\n   119→        'Funding sources for legal scholarship and amicus briefs',\n   120→        'Lobbying expenditures related to relevant regulations',\n   121→        'Agency enforcement patterns and potential selective enforcement',\n   122→      ],\n   123→    },\n   124→  ],\n   125→\n   126→  searchDepthGuidance: {\n   127→    quick: 'Focus on most relevant cases and current regulations',\n   128→    standard: 'Balanced coverage of cases, regulations, and enforcement',\n   129→    deep: 'Comprehensive legal research including commentary and trends',\n   130→  },\n   131→\n   132→  // ---- Extraction Phase Configuration ----\n   133→  extractionIntro:\n   134→    'You are a legal research analyst extracting key findings for legal analysis. CRITICAL: Use EXACT finding_type values specified below - they map to UI components.',\n   135→\n   136→  findingTypes: [\n   137→    {\n   138→      name: 'evidence',\n   139→      displayName: 'Case Law',\n   140→      description:\n   141→        'Court decisions and holdings. Include: case name, court, date, holding. Note precedential value and applicability.',\n   142→      extractedDataSchema:\n   143→        '{\"case_name\": \"...\", \"court\": \"...\", \"date\": \"...\", \"citation\": \"...\", \"holding\": \"...\", \"precedential_value\": \"binding/persuasive\"}',\n   144→      analysisFallback:\n   145→        'This case law finding is relevant for establishing legal precedent in the matter at hand.',\n   146→    },\n   147→    {\n   148→      name: 'fact',\n   149→      displayName: 'Statutes and Regulations',\n   150→      description:\n   151→        'Applicable laws and regulations. Include: statute/regulation name, citation, key provisions. Note effective date and amendments.',\n   152→      extractedDataSchema:\n   153→        '{\"name\": \"...\", \"citation\": \"...\", \"key_provisions\": [...], \"effective_date\": \"...\"}',\n   154→      analysisFallback:\n   155→        'This statutory or regulatory finding establishes the legal framework applicable to the matter.',\n   156→    },\n   157→    {\n   158→      name: 'event',\n   159→      displayName: 'Enforcement/Litigation',\n   160→      description:\n   161→        'Regulatory enforcement, prosecutions, and active lawsuits. Include: agency/parties, date, allegations, outcome. Note penalties, injunctions, and remedies.',\n   162→      extractedDataSchema:\n   163→        '{\"case_type\": \"enforcement/litigation\", \"parties\": \"...\", \"date\": \"...\", \"allegations\": [...], \"outcome\": \"...\", \"penalty\": \"...\"}',\n   164→      analysisFallback:\n   165→        'This enforcement or litigation event provides context for understanding regulatory risk and legal exposure.',\n   166→    },\n   167→    {\n   168→      name: 'claim',\n   169→      displayName: 'Regulatory Guidance',\n   170→      description:\n   171→        'Agency interpretations and guidance. Include: agency, date, topic, key points. Note legal weight and binding nature.',\n   172→      extractedDataSchema:\n   173→        '{\"agency\": \"...\", \"document_type\": \"...\", \"date\": \"...\", \"topic\": \"...\", \"key_points\": [...]}',\n   174→      analysisFallback:\n   175→        'This regulatory guidance helps interpret how agencies apply the law in practice.',\n   176→    },\n   177→    {\n   178→      name: 'pattern',\n   179→      displayName: 'Legal Risk',\n   180→      description:\n   181→        'Identified legal exposure patterns. Include: risk type, likelihood, severity. Note mitigation strategies if mentioned.',\n   182→      extractedDataSchema:\n   183→        '{\"risk_type\": \"...\", \"likelihood\": \"high/medium/low\", \"severity\": \"high/medium/low\", \"mitigation\": [...]}',\n   184→      analysisFallback:\n   185→        'This legal risk pattern should be considered in risk assessment and mitigation planning.',\n   186→    },\n   187→    {\n   188→      name: 'relationship',\n   189→      displayName: 'Legal Precedent',\n   190→      description:\n   191→        'How cases relate to each other. Include: cases involved, relationship type. Note whether overruled or distinguished.',\n   192→      extractedDataSchema:\n   193→        '{\"citing_case\": \"...\", \"cited_case\": \"...\", \"relationship\": \"follows/distinguishes/overrules/questions\"}',\n   194→      analysisFallback:\n   195→        'This precedent relationship helps understand the evolution and current state of the law.',\n   196→    },\n   197→    {\n   198→      name: 'gap',\n   199→      displayName: 'Knowledge Gap',\n   200→      description:\n   201→        'Missing legal research. What additional research is needed. Suggested follow-up sources.',\n   202→      extractedDataSchema:\n   203→        '{\"information_needed\": \"...\", \"importance\": \"high/medium/low\", \"suggested_sources\": [...]}',\n   204→      analysisFallback:\n   205→        'This gap in legal research should be addressed before reaching final conclusions.',\n   206→    },\n   207→    {\n   208→      name: 'regulatory_capture',\n   209→      displayName: 'Regulatory Capture',\n   210→      description:\n   211→        'Evidence of regulatory agencies serving regulated industries. Revolving door, selective enforcement, industry-favorable interpretations.',\n   212→      extractedDataSchema:\n   213→        '{\"agency\": \"...\", \"industry\": \"...\", \"capture_indicator\": \"...\", \"evidence\": \"...\", \"impact\": \"...\"}',\n   214→      analysisFallback:\n   215→        'Regulatory capture undermines the protective function of regulation.',\n   216→    },\n   217→  ],\n   218→\n   219→  extractionGuidelines: `CRITICAL: The \"analysis\" field must provide substantive legal reasoning, not just describe the finding.\n   220→Good example: \"This Supreme Court holding is controlling precedent that directly applies to the current matter. The Court's reasoning suggests a broad interpretation that would likely cover the conduct at issue. However, the concurrence's narrower reading has been adopted by some circuit courts, creating potential for distinguishing arguments.\"\n   221→\n   222→IMPORTANT:\n   223→- Prioritize primary sources (court filings, statutes) over secondary commentary\n   224→- Include specific citations where available\n   225→- Distinguish between established law and emerging interpretations\n   226→- Note jurisdictional limitations of precedents`,\n   227→\n   228→  analysisInstruction: `YOUR EXPERT LEGAL ANALYSIS (REQUIRED - 2-4 sentences) explaining:\n   229→  * The LEGAL SIGNIFICANCE of this finding and how it affects the matter at hand\n   230→  * How this PRECEDENT or REGULATION applies to the specific situation\n   231→  * What RISKS or OPPORTUNITIES this creates from a legal perspective\n   232→  * How this COMPARES to similar cases or regulatory interpretations`,\n   233→\n   234→  // ---- Ordering & Grouping ----\n   235→  priorityFindingTypes: ['evidence', 'fact', 'event', 'pattern', 'claim', 'regulatory_capture'],\n   236→  groupingOrder: ['evidence', 'fact', 'event', 'claim', 'pattern', 'relationship', 'regulatory_capture', 'gap'],\n   237→\n   238→  // ---- Perspectives ----\n   239→  perspectives: [\n   240→    'litigation_strategist', // Case strength, discovery, outcomes\n   241→    'regulatory_expert', // Compliance, enforcement, political factors\n   242→    'legal_liability', // Liability exposure, evidence strength\n   243→    'forensic_financial', // Financial crimes, fraud patterns\n   244→  ],\n   245→\n   246→  // ---- Verification ----\n   247→  // Legal research is more factual - court citations 