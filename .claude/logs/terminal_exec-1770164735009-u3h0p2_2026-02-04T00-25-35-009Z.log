NGINEER,\n    TECH_MARKET_EXPERTS.SENIOR_ENGINEER,\n    TECH_MARKET_EXPERTS.PLATFORM_ENGINEER,\n  ],\n} as const;\n\n// ============================================\n// HELPER FUNCTIONS\n// ============================================\n\n/**\n * Get a subset of perspectives from a set.\n * Useful when granularity limits the number of perspectives.\n *\n * @param set - The perspective set key\n * @param count - Maximum number of perspectives to return\n * @returns Array of perspective strings\n */\nexport function getPerspectives(\n  set: keyof typeof PERSPECTIVE_SETS,\n  count?: number\n): string[] {\n  const perspectives = [...PERSPECTIVE_SETS[set]];\n  return count ? perspectives.slice(0, count) : perspectives;\n}\n\n/**\n * Compose a custom perspective array from multiple expert groups.\n *\n * @param experts - Spread of expert constants\n * @returns Array of perspective strings\n */\nexport function composePerspectives(...experts: string[]): string[] {\n  return experts;\n}\n","structuredPatch":[{"oldStart":191,"oldLines":6,"newStart":191,"newLines":9,"lines":[" export type TechMarketExpert = typeof TECH_MARKET_EXPERTS[keyof typeof TECH_MARKET_EXPERTS];"," export type ConsumerExpert = typeof CONSUMER_EXPERTS[keyof typeof CONSUMER_EXPERTS];"," ","+export type ContractExpert = typeof CONTRACT_EXPERTS[keyof typeof CONTRACT_EXPERTS];","+export type CompetitiveExpert = typeof COMPETITIVE_EXPERTS[keyof typeof COMPETITIVE_EXPERTS];","+"," export type ExpertPerspective =","   | CrossDomainExpert","   | InvestigationExpert"]},{"oldStart":199,"oldLines":7,"newStart":202,"newLines":9,"lines":["   | DueDiligenceExpert","   | ReputationExpert","   | TechMarketExpert","-  | ConsumerExpert;","+  | ConsumerExpert","+  | ContractExpert","+  | CompetitiveExpert;"," "," // ============================================"," // PRE-COMPOSED PERSPECTIVE SETS"]}],"userModified":false,"replaceAll":false}}
