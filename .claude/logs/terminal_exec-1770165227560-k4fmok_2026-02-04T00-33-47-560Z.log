[2026-02-04T00:35:59.861Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LMfbDoJiBYqdVhcihZMzpD","type":"tool_result","content":"     1→'use client';\n     2→\n     3→import { createContext, useContext, useCallback, useReducer, type ReactNode } from 'react';\n     4→\n     5→/**\n     6→ * Focus item types - represents what kind of item is focused\n     7→ */\n     8→export type FocusItemType = 'finding' | 'source' | 'entity' | 'perspective' | 'gap' | 'contradiction';\n     9→\n    10→/**\n    11→ * A focused item in the report\n    12→ */\n    13→export interface FocusItem {\n    14→  type: FocusItemType;\n    15→  id: string;\n    16→  /** Related items that should be highlighted in other views */\n    17→  relatedIds?: {\n    18→    findings?: string[];\n    19→    sources?: string[];\n    20→    entities?: string[];\n    21→  };\n    22→}\n    23→\n    24→/**\n    25→ * Focus state with history for back navigation\n    26→ */\n    27→interface FocusState {\n    28→  /** Currently focused item */\n    29→  current: FocusItem | null;\n    30→  /** Focus history stack for back navigation */\n    31→  history: FocusItem[];\n    32→  /** Maximum history size */\n    33→  maxHistory: number;\n    34→}\n    35→\n    36→type FocusAction =\n    37→  | { type: 'FOCUS'; item: FocusItem }\n    38→  | { type: 'CLEAR' }\n    39→  | { type: 'BACK' }\n    40→  | { type: 'CLEAR_HISTORY' };\n    41→\n    42→function focusReducer(state: FocusState, action: FocusAction): FocusState {\n    43→  switch (action.type) {\n    44→    case 'FOCUS': {\n    45→      // Don't add to history if focusing same item\n    46→      if (state.current?.type === action.item.type && state.current?.id === action.item.id) {\n    47→        return state;\n    48→      }\n    49→\n    50→      const newHistory = state.current\n    51→        ? [...state.history, state.current].slice(-state.maxHistory)\n    52→        : state.history;\n    53→\n    54→      return {\n    55→        ...state,\n    56→        current: action.item,\n    57→        history: newHistory,\n    58→      };\n    59→    }\n    60→\n    61→    case 'CLEAR':\n    62→      return {\n    63→        ...state,\n    64→        current: null,\n    65→      };\n    66→\n    67→    case 'BACK': {\n    68→      if (state.history.length === 0) {\n    69→        return { ...state, current: null };\n    70→      }\n    71→\n    72→      const newHistory = [...state.history];\n    73→      const previous = newHistory.pop();\n    74→\n    75→      return {\n    76→        ...state,\n    77→        current: previous || null,\n    78→        history: newHistory,\n    79→      };\n    80→    }\n    81→\n    82→    case 'CLEAR_HISTORY':\n    83→      return {\n    84→        ...state,\n    85→        history: [],\n    86→      };\n    87→\n    88→    default:\n    89→      return state;\n    90→  }\n    91→}\n    92→\n    93→interface FocusContextValue {\n    94→  /** Currently focused item */\n    95→  focused: FocusItem | null;\n    96→  /** Whether back navigation is available */\n    97→  canGoBack: boolean;\n    98→  /** Focus history length */\n    99→  historyLength: number;\n   100→\n   101→  /** Focus on an item */\n   102→  focus: (item: FocusItem) => void;\n   103→  /** Focus on a finding */\n   104→  focusFinding: (id: string, relatedSourceIds?: string[]) => void;\n   105→  /** Focus on a source */\n   106→  focusSource: (id: string, relatedFindingIds?: string[]) => void;\n   107→  /** Focus on an entity */\n   108→  focusEntity: (id: string, relatedFindingIds?: string[], relatedSourceIds?: string[]) => void;\n   109→  /** Clear current focus */\n   110→  clearFocus: () => void;\n   111→  /** Go back to previous focus */\n   112→  goBack: () => void;\n   113→\n   114→  /** Check if an item is the currently focused item */\n   115→  isFocused: (type: FocusItemType, id: string) => boolean;\n   116→  /** Check if an item is related to the currently focused item (for cross-view highlighting) */\n   117→  isRelated: (type: FocusItemType, id: string) => boolean;\n   118→}\n   119→\n   120→const FocusContext = createContext<FocusContextValue | null>(null);\n   121→\n   122→interface FocusProviderProps {\n   123→  children: ReactNode;\n   124→  /** Maximum history size (default: 20) */\n   125→  maxHistory?: number;\n   126→  /** Callback when focus changes */\n   127→  onFocusChange?: (item: FocusItem | null) => void;\n   128→}\n   129→\n   130→export function FocusProvider({ children, maxHistory = 20, onFocusChange }: FocusProviderProps) {\n   131→  const [state, dispatch] = useReducer(focusReducer, {\n   132→    current: null,\n   133→    history: [],\n   134→    maxHistory,\n   135→  });\n   136→\n   137→  const focus = useCallback((item: FocusItem) => {\n   138→    dispatch({ type: 'FOCUS', item });\n   139→    onFocusChange?.(item);\n   140→  }, [onFocusChange]);\n   141→\n   142→  const focusFinding = useCallback((id: string, relatedSourceIds?: string[]) => {\n   143→    focus({\n   144→      type: 'finding',\n   145→      id,\n   146→      relatedIds: relatedSourceIds ? { sources: relatedSourceIds } : undefined,\n   147→    });\n   148→  }, [focus]);\n   149→\n   150→  const focusSource = useCallback((id: string, relatedFindingIds?: string[]) => {\n   151→    focus({\n   152→      type: 'source',\n   153→      id,\n   154→      relatedIds: relatedFindingIds ? { findings: relatedFindingIds } : undefined,\n   155→    });\n   156→  }, [focus]);\n   157→\n   158→  const focusEntity = useCallback((id: string, relatedFindingIds?: string[], relatedSourceIds?: string[]) => {\n   159→    focus({\n   160→      type: 'entity',\n   161→      id,\n   162→      relatedIds: (relatedFindingIds || relatedSourceIds) ? {\n   163→        findings: relatedFindingIds,\n   164→        sources: relatedSourceIds,\n   165→      } : undefined,\n   166→    });\n   167→  }, [focus]);\n   168→\n   169→  const clearFocus = useCallback(() => {\n   170→    dispatch({ type: 'CLEAR' });\n   171→    onFocusChange?.(null);\n   172→  }, [onFocusChange]);\n   173→\n   174→  const goBack = useCallback(() => {\n   175→    dispatch({ type: 'BACK' });\n   176→    // Note: onFocusChange will be called with the new current item\n   177→    // We need to get the previous item from history\n   178→    if (state.history.length > 0) {\n   179→      onFocusChange?.(state.history[state.history.length - 1]);\n   180→    } else {\n   181→      onFocusChange?.(null);\n   182→    }\n   183→  }, [onFocusChange, state.history]);\n   184→\n   185→  const isFocused = useCallback((type: FocusItemType, id: string) => {\n   186→    return state.current?.type === type && state.current?.id === id;\n   187→  }, [state.current]);\n   188→\n   189→  const isRelated = useCallback((type: FocusItemType, id: string) => {\n   190→    if (!state.current?.relatedIds) return false;\n   191→\n   192→    switch (type) {\n   193→      case 'finding':\n   194→        return state.current.relatedIds.findings?.includes(id) ?? false;\n   195→      case 'source':\n   196→        return state.current.relatedIds.sources?.includes(id) ?? false;\n   197→      case 'entity':\n   198→        return state.current.relatedIds.entities?.includes(id) ?? false;\n   199→      default:\n   200→        return false;\n   201→    }\n   202→  }, [state.current]);\n   203→\n   204→  const value: FocusContextValue = {\n   205→    focused: state.current,\n   206→    canGoBack: state.history.length > 0,\n   207→    historyLength: state.history.length,\n   208→    focus,\n   209→    focusFinding,\n   210→    focusSource,\n   211→    focusEntity,\n   212→    clearFocus,\n   213→    goBack,\n   214→    isFocused,\n   215→    isRelated,\n   216→  };\n   217→\n   218→  return (\n   219→    <FocusContext.Provider value={value}>\n   220→      {children}\n   221→    </FocusContext.Provider>\n   222→  );\n   223→}\n   224→\n   225→/**\n   226→ * Hook to access the focus context\n   227→ * @throws Error if used outside FocusProvider\n   228→ */\n   229→export function useFocus() {\n   230→  const ctx = useContext(FocusContext);\n   231→  if (!ctx) {\n   232→    throw new Error('useFocus must be used within a FocusProvider');\n   233→  }\n   234→  return ctx;\n   235→}\n   236→\n   237→/**\n   238→ * Hook to safely access focus context (returns null if not available)\n   239→ */\n   240→export function useFocusSafe() {\n   241→  return useContext(FocusContext);\n   242→}\n   243→\n   244→/**\n   245→ * Hook to check if an item has focus-related styling\n   246→ * Returns 'focused' | 'related' | null\n   247→ */\n   248→export function useFocusState(type: FocusItemType, id: string): 'focused' | 'related' | null {\n   249→  const ctx = useFocusSafe();\n   250→  if (!ctx) return null;\n   251→\n   252→  if (ctx.isFocused(type, id)) return 'focused';\n   253→  if (ctx.isRelated(type, id)) return 'related';\n   254→  return null;\n   255→}\n   256→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"d184f0d2-244e-457f-8ea5-4627f2d647f1","uuid":"2fd24c37-09ba-4069-aa86-ebac28ebc6d4","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\core\\FocusContext.tsx","content":"'use client';\n\nimport { createContext, useContext, useCallback, useReducer, type ReactNode } from 'react';\n\n/**\n * Focus item types - represents what kind of item is focused\n */\nexport type FocusItemType = 'finding' | 'source' | 'entity' | 'perspective' | 'gap' | 'contradiction';\n\n/**\n * A focused item in the report\n */\nexport interface FocusItem {\n  type: FocusItemType;\n  id: string;\n  /** Related items that should be highlighted in other views */\n  relatedIds?: {\n    findings?: string[];\n    sources?: string[];\n    entities?: string[];\n  };\n}\n\n/**\n * Focus state with history for back navigation\n */\ninterface FocusState {\n  /** Currently focused item */\n  current: FocusItem | null;\n  /** Focus history stack for back navigation */\n  history: FocusItem[];\n  /** Maximum history size */\n  maxHistory: number;\n}\n\ntype FocusAction =\n  | { type: 'FOCUS'; item: FocusItem }\n  | { type: 'CLEAR' }\n  | { type: 'BACK' }\n  | { type: 'CLEAR_HISTORY' };\n\nfunction focusReducer(state: FocusState, action: FocusAction): FocusState {\n  switch (action.type) {\n    case 'FOCUS': {\n      // Don't add to history if focusing same item\n      if (state.current?.type === action.item.type && state.current?.id === action.item.id) {\n        return state;\n      }\n\n      const newHistory = state.current\n        ? [...state.history, state.current].slice(-state.maxHistory)\n        : state.history;\n\n      return {\n        ...state,\n        current: action.item,\n        history: newHistory,\n      };\n    }\n\n    case 'CLEAR':\n      return {\n        ...state,\n        current: null,\n      };\n\n    case 'BACK': {\n      if (state.history.length === 0) {\n        return { ...state, current: null };\n      }\n\n      const newHistory = [...state.history];\n      const previous = newHistory.pop();\n\n      return {\n        ...state,\n        current: previous || null,\n        history: newHistory,\n      };\n    }\n\n    case 'CLEAR_HISTORY':\n      return {\n        ...state,\n        history: [],\n      };\n\n    default:\n      return state;\n  }\n}\n\ninterface FocusContextValue {\n  /** Currently focused item */\n  focused: FocusItem | null;\n  /** Whether back navigation is available */\n  canGoBack: boolean;\n  /** Focus history length */\n  historyLength: number;\n\n  /** Focus on an item */\n  focus: (item: FocusItem) => void;\n  /** Focus on a finding */\n  focusFinding: (id: string, relatedSourceIds?: string[]) => void;\n  /** Focus on a source */\n  focusSource: (id: string, relatedFindingIds?: string[]) => void;\n  /** Focus on an entity */\n  focusEntity: (id: string, relatedFindingIds?: string[], relatedSourceIds?: string[]) => void;\n  /** Clear current focus */\n  clearFocus: () => void;\n  /** Go back to previous focus */\n  goBack: () => void;\n\n  /** Check if an item is the currently focused item */\n  isFocused: (type: FocusItemType, id: string) => boolean;\n  /** Check if an item is related to the currently focused item (for cross-view highlighting) */\n  isRelated: (type: FocusItemType, id: string) => boolean;\n}\n\nconst FocusContext = createContext<FocusContextValue | null>(null);\n\ninterface FocusProviderProps {\n  children: ReactNode;\n  /** Maximum history size (default: 20) */\n  maxHistory?: number;\n  /** Callback when focus changes */\n  onFocusChange?: (item: FocusItem | null) => void;\n}\n\nexport function FocusProvider({ children, maxHistory = 20, onFocusChange }: FocusProviderProps) {\n  const [state, dispatch] = useReducer(focusReducer, {\n    current: null,\n    history: [],\n    maxHistory,\n  });\n\n  const focus = useCallback((item: FocusItem) => {\n    dispatch({ type: 'FOCUS', item });\n    onFocusChange?.(item);\n  }, [onFocusChange]);\n\n  const focusFinding = useCallback((id: string, relatedSourceIds?: string[]) => {\n    focus({\n      type: 'finding',\n      id,\n      relatedIds: relatedSourceIds ? { sources: relatedSourceIds } : undefined,\n    });\n  }, [focus]);\n\n  const focusSource = useCallback((id: string, relatedFindingIds?: string[]) => {\n    focus({\n      type: 'source',\n      id,\n      relatedIds: relatedFindingIds ? { findings: relatedFindingIds } : undefined,\n    });\n  }, [focus]);\n\n  const focusEntity = useCallback((id: string, relatedFindingIds?: string[], relatedSourceIds?: string[]) => {\n    focus({\n      type: 'entity',\n      id,\n      relatedIds: (relatedFindingIds || relatedSourceIds) ? {\n        findings: relatedFindingIds,\n        sources: relatedSourceIds,\n      } : undefined,\n    });\n  }, [focus]);\n\n  const clearFocus = useCallback(() => {\n    dispatch({ type: 'CLEAR' });\n    onFocusChange?.(null);\n  }, [onFocusChange]);\n\n  const goBack = useCallback(() => {\n    dispatch({ type: 'BACK' });\n    // Note: onFocusChange will be called with the new current item\n    // We need to get the previous item from history\n    if (state.history.length > 0) {\n      onFocusChange?.(state.history[state.history.length - 1]);\n    } else {\n      onFocusChange?.(null);\n    }\n  }, [onFocusChange, state.history]);\n\n  const isFocused = useCallback((type: FocusItemType, id: string) => {\n    return state.current?.type === type && state.current?.id === id;\n  }, [state.current]);\n\n  const isRelated = useCallback((type: FocusItemType, id: string) => {\n    if (!state.current?.relatedIds) return false;\n\n    switch (type) {\n      case 'finding':\n        return state.current.relatedIds.findings?.includes(id) ?? false;\n      case 'source':\n        return state.current.relatedIds.sources?.includes(id) ?? false;\n      case 'entity':\n        return state.current.relatedIds.entities?.includes(id) ?? false;\n      default:\n        return false;\n    }\n  }, [state.current]);\n\n  const value: FocusContextValue = {\n    focused: state.current,\n    canGoBack: state.history.length > 0,\n    historyLength: state.history.length,\n    focus,\n    focusFinding,\n    focusSource,\n    focusEntity,\n    clearFocus,\n    goBack,\n    isFocused,\n    isRelated,\n  };\n\n  return (\n    <FocusContext.Provider value={value}>\n      {children}\n    </FocusContext.Provider>\n  );\n}\n\n/**\n * Hook to access the focus context\n * @throws Error if used outside FocusProvider\n */\nexport function useFocus() {\n  const ctx = useContext(FocusContext);\n  if (!ctx) {\n    throw new Error('useFocus must be used within a FocusProvider');\n  }\n  return ctx;\n}\n\n/**\n * Hook to safely access focus context (returns null if not available)\n */\nexport function useFocusSafe() {\n  return useContext(FocusContext);\n}\n\n/**\n * Hook to check if an item has focus-related styling\n * Returns 'focused' | 'related' | null\n */\nexport function useFocusState(type: FocusItemType, id: string): 'focused' | 'related' | null {\n  const ctx = useFocusSafe();\n  if (!ctx) return null;\n\n  if (ctx.isFocused(type, id)) return 'focused';\n  if (ctx.isRelated(type, id)) return 'related';\n  return null;\n}\n","numLines":256,"startLine":1,"totalLines":256}}}
