 borderActive: string;\n    62→\n    63→  // Special effects (radar glow, etc.)\n    64→  glowColor: string;\n    65→  glowStrong: string;\n    66→}\n    67→\n    68→// ============================================\n    69→// Entity Type Colors\n    70→// ============================================\n    71→\n    72→export interface EntityTypeColors {\n    73→  finding: string;\n    74→  source: string;\n    75→  entity: string;\n    76→  perspective: string;\n    77→  person: string;\n    78→  organization: string;\n    79→  location: string;\n    80→  event: string;\n    81→  other: string;\n    82→}\n    83→\n    84→// ============================================\n    85→// Theme Definitions\n    86→// ============================================\n    87→\n    88→const radarColors: VisualizationColors = {\n    89→  // Primary - cyan glow aesthetic\n    90→  primary: '#22d3ee',\n    91→  primaryFill: 'rgba(34, 211, 238, 0.15)',\n    92→  primaryMuted: 'rgba(34, 211, 238, 0.5)',\n    93→\n    94→  // Secondary - violet accent\n    95→  secondary: '#a78bfa',\n    96→  secondaryFill: 'rgba(167, 139, 250, 0.15)',\n    97→\n    98→  // Semantic status\n    99→  success: '#34d399',\n   100→  successFill: 'rgba(52, 211, 153, 0.2)',\n   101→  warning: '#fbbf24',\n   102→  warningFill: 'rgba(251, 191, 36, 0.2)',\n   103→  danger: '#f87171',\n   104→  dangerFill: 'rgba(248, 113, 113, 0.2)',\n   105→\n   106→  // Confidence levels (for heatmaps)\n   107→  confidenceHigh: 'rgba(34, 211, 238, 0.8)',\n   108→  confidenceMedium: 'rgba(52, 211, 153, 0.7)',\n   109→  confidenceLow: 'rgba(251, 191, 36, 0.6)',\n   110→  confidenceVeryLow: 'rgba(251, 146, 60, 0.5)',\n   111→  confidenceCritical: 'rgba(248, 113, 113, 0.4)',\n   112→\n   113→  // Grid and structural\n   114→  gridLine: 'rgba(34, 211, 238, 0.1)',\n   115→  axisLine: 'rgba(34, 211, 238, 0.15)',\n   116→  connectionLine: 'rgba(34, 211, 238, 0.5)',\n   117→  contradictionLine: '#f87171',\n   118→\n   119→  // Backgrounds\n   120→  cardBg: 'rgba(15, 23, 42, 0.6)', // slate-900/60\n   121→  surfaceBg: 'rgba(2, 6, 23, 0.5)', // slate-950/50\n   122→  tooltipBg: 'rgb(30, 41, 59)', // slate-800\n   123→  overlayBg: 'rgba(15, 23, 42, 0.5)',\n   124→\n   125→  // Text\n   126→  textPrimary: 'rgb(241, 245, 249)', // slate-100\n   127→  textSecondary: 'rgb(148, 163, 184)', // slate-400\n   128→  textMuted: 'rgb(100, 116, 139)', // slate-500\n   129→  textOnDark: '#fff',\n   130→  textOnLight: 'rgb(30, 41, 59)',\n   131→\n   132→  // Borders\n   133→  border: 'rgba(34, 211, 238, 0.1)',\n   134→  borderSubtle: 'rgba(255, 255, 255, 0.05)',\n   135→  borderActive: 'rgba(34, 211, 238, 0.3)',\n   136→\n   137→  // Glow effects\n   138→  glowColor: 'rgba(34, 211, 238, 0.3)',\n   139→  glowStrong: 'rgba(34, 211, 238, 0.5)',\n   140→};\n   141→\n   142→const swissColors: VisualizationColors = {\n   143→  // Primary - blue/indigo for clarity\n   144→  primary: '#3b82f6',\n   145→  primaryFill: 'rgba(59, 130, 246, 0.15)',\n   146→  primaryMuted: 'rgba(59, 130, 246, 0.5)',\n   147→\n   148→  // Secondary - violet accent\n   149→  secondary: '#7c3aed',\n   150→  secondaryFill: 'rgba(124, 58, 237, 0.15)',\n   151→\n   152→  // Semantic status\n   153→  success: '#059669',\n   154→  successFill: 'rgba(5, 150, 105, 0.1)',\n   155→  warning: '#d97706',\n   156→  warningFill: 'rgba(217, 119, 6, 0.1)',\n   157→  danger: '#dc2626',\n   158→  dangerFill: 'rgba(220, 38, 38, 0.1)',\n   159→\n   160→  // Confidence levels\n   161→  confidenceHigh: 'rgb(16, 185, 129)',\n   162→  confidenceMedium: 'rgb(34, 197, 94)',\n   163→  confidenceLow: 'rgb(234, 179, 8)',\n   164→  confidenceVeryLow: 'rgb(249, 115, 22)',\n   165→  confidenceCritical: 'rgb(239, 68, 68)',\n   166→\n   167→  // Grid and structural\n   168→  gridLine: 'rgba(0, 0, 0, 0.08)',\n   169→  axisLine: 'rgba(0, 0, 0, 0.1)',\n   170→  connectionLine: 'rgba(99, 102, 241, 0.5)',\n   171→  contradictionLine: '#f87171',\n   172→\n   173→  // Backgrounds\n   174→  cardBg: 'rgb(255, 255, 255)',\n   175→  surfaceBg: 'rgb(250, 250, 249)', // stone-50\n   176→  tooltipBg: 'rgb(255, 255, 255)',\n   177→  overlayBg: 'rgba(250, 250, 249, 0.9)',\n   178→\n   179→  // Text\n   180→  textPrimary: 'rgb(28, 25, 23)', // stone-900\n   181→  textSecondary: 'rgb(120, 113, 108)', // stone-500\n   182→  textMuted: 'rgb(168, 162, 158)', // stone-400\n   183→  textOnDark: '#fff',\n   184→  textOnLight: 'rgb(28, 25, 23)',\n   185→\n   186→  // Borders\n   187→  border: 'rgb(231, 229, 228)', // stone-200\n   188→  borderSubtle: 'rgb(245, 245, 244)', // stone-100\n   189→  borderActive: 'rgb(28, 25, 23)',\n   190→\n   191→  // No glow in swiss (clean shadows instead)\n   192→  glowColor: 'transparent',\n   193→  glowStrong: 'transparent',\n   194→};\n   195→\n   196→const radarEntityColors: EntityTypeColors = {\n   197→  finding: '#22d3ee',\n   198→  source: '#a78bfa',\n   199→  entity: '#fb7185',\n   200→  perspective: '#34d399',\n   201→  person: '#f472b6',\n   202→  organization: '#60a5fa',\n   203→  location: '#34d399',\n   204→  event: '#fbbf24',\n   205→  other: '#a78bfa',\n   206→};\n   207→\n   208→const swissEntityColors: EntityTypeColors = {\n   209→  finding: '#0ea5e9',\n   210→  source: '#7c3aed',\n   211→  entity: '#e11d48',\n   212→  perspective: '#059669',\n   213→  person: '#be185d',\n   214→  organization: '#2563eb',\n   215→  location: '#059669',\n   216→  event: '#d97706',\n   217→  other: '#7c3aed',\n   218→};\n   219→\n   220→// ============================================\n   221→// Theme Configuration Map\n   222→// ============================================\n   223→\n   224→export const visualizationThemes: Record<ReportTheme, {\n   225→  colors: VisualizationColors;\n   226→  entityColors: EntityTypeColors;\n   227→}> = {\n   228→  radar: { colors: radarColors, entityColors: radarEntityColors },\n   229→  swiss: { colors: swissColors, entityColors: swissEntityColors },\n   230→};\n   231→\n   232→// ============================================\n   233→// Utility Functions\n   234→// ============================================\n   235→\n   236→/**\n   237→ * Get confidence color based on value (0-1)\n   238→ */\n   239→export function getConfidenceColor(\n   240→  value: number,\n   241→  colors: VisualizationColors\n   242→): string {\n   243→  if (value >= 0.8) return colors.confidenceHigh;\n   244→  if (value >= 0.6) return colors.confidenceMedium;\n   245→  if (value >= 0.4) return colors.confidenceLow;\n   246→  if (value >= 0.2) return colors.confidenceVeryLow;\n   247→  return colors.confidenceCritical;\n   248→}\n   249→\n   250→/**\n   251→ * Get credibility color based on score (0-1)\n   252→ */\n   253→export function getCredibilityColor(\n   254→  score: number,\n   255→  colors: VisualizationColors\n   256→): string {\n   257→  if (score >= 0.8) return colors.success;\n   258→  if (score >= 0.5) return colors.warning;\n   259→  return colors.danger;\n   260→}\n   261→\n   262→/**\n   263→ * Get status color based on status type\n   264→ */\n   265→export function getStatusColor(\n   266→  status: 'resolved' | 'investigating' | 'unresolved',\n   267→  colors: VisualizationColors\n   268→): { bg: string; text: string; border: string } {\n   269→  switch (status) {\n   270→    case 'resolved':\n   271→      return { bg: colors.successFill, text: colors.success, border: colors.success };\n   272→    case 'investigating':\n   273→      return { bg: colors.warningFill, text: colors.warning, border: colors.warning };\n   274→    case 'unresolved':\n   275→    default:\n   276→      return { bg: colors.dangerFill, text: colors.danger, border: colors.danger };\n   277→  }\n   278→}\n   279→\n   280→/**\n   281→ * Timeline event type configuration\n   282→ */\n   283→export function getTimelineTypeConfig(\n   284→  colors: VisualizationColors\n   285→): Record<'finding' | 'event' | 'prediction', { color: string; icon: string }> {\n   286→  return {\n   287→    finding: { color: colors.primary, icon: '◆' },\n   288→    event: { color: colors.secondary, icon: '●' },\n   289→    prediction: { color: colors.warning, icon: '◇' },\n   290→  };\n   291→}\n   292→\n   293→// ============================================\n   294→// CSS Class Helpers\n   295→// ============================================\n   296→\n   297→/**\n   298→ * Get Tailwind classes for card backgrounds\n   299→ */\n   300→export function getCardClasses(isRadar: boolean): string {\n   301→  return isRadar\n   302→    ? 'bg-slate-900/60 border border-cyan-500/10'\n   303→    : 'bg-white border border-stone-200';\n   304→}\n   305→\n   306→/**\n   307→ * Get Tailwind classes for surface backgrounds\n   308→ */\n   309→export function getSurfaceClasses(isRadar: boolean): string {\n   310→  return isRadar ? 'bg-slate-950/50' : 'bg-stone-50';\n   311→}\n   312→\n   313→/**\n   314→ * Get Tailwind classes for tooltips\n   315→ */\n   316→export function getTooltipClasses(isRadar: boolean): string {\n   317→  return isRadar\n   318→    ? 'bg-slate-800 text-white'\n   319→    : 'bg-white text-stone-800 shadow-lg';\n   320→}\n   321→\n   322→/**\n   323→ * Get Tailwind classes for section headers\n   324→ */\n   325→export function getHeaderClasses(isRadar: boolean): string {\n   326→  return isRadar ? 'text-cyan-400' : 'text-stone-700';\n   327→}\n   328→\n   329→/**\n   330→ * Get Tailwind classes for buttons\n   331→ */\n   332→export function getButtonClasses(isRadar: boolean, isActive: boolean): string {\n   333→  if (isActive) {\n   334→    return isRadar\n   335→      ? 'bg-cyan-500/20 text-cyan-300'\n   336→      : 'bg-stone-800 text-white';\n   337→  }\n   338→  return isRadar\n   339→    ? 'bg-slate-800/50 text-slate-400 hover:text-white'\n   340→    : 'bg-stone-100 text-stone-600 hover:bg-stone-200';\n   341→}\n   342→\n   343→/**\n   344→ * Get glow shadow style for radar theme\n   345→ */\n   346→export function getGlowStyle(\n   347→  color: string,\n   348→  intensity: 'low' | 'medium' | 'high' = 'medium'\n   349→): React.CSSProperties {\n   350→  const radius = intensity === 'low' ? 8 : intensity === 'medium' ? 15 : 25;\n   351→  return {\n   352→    filter: `drop-shadow(0 0 ${radius}px ${color})`,\n   353→  };\n   354→}\n   355→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01XMhYvkxP6sRw1th7ij4ksr","session_id":"d184f0d2-244e-457f-8ea5-4627f2d647f1","uuid":"4cf49940-f33e-4061-ac74-564372c66d9e"}
