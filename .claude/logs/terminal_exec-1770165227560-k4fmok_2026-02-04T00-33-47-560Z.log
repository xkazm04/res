r: (score: number) => string;\n    52→\n    53→  /** Get status-based colors */\n    54→  getStatusColor: (status: 'resolved' | 'investigating' | 'unresolved') => {\n    55→    bg: string;\n    56→    text: string;\n    57→    border: string;\n    58→  };\n    59→\n    60→  /** Get timeline event type config */\n    61→  getTimelineTypeConfig: () => Record<'finding' | 'event' | 'prediction', { color: string; icon: string }>;\n    62→\n    63→  // Tailwind class utilities\n    64→  /** Card background classes */\n    65→  cardClasses: string;\n    66→  /** Surface background classes */\n    67→  surfaceClasses: string;\n    68→  /** Tooltip classes */\n    69→  tooltipClasses: string;\n    70→  /** Header text classes */\n    71→  headerClasses: string;\n    72→  /** Get button classes */\n    73→  getButtonClasses: (isActive: boolean) => string;\n    74→\n    75→  /** Get glow style for radar theme */\n    76→  getGlowStyle: (color: string, intensity?: 'low' | 'medium' | 'high') => React.CSSProperties;\n    77→\n    78→  // ============================================\n    79→  // Semantic Intent Flags\n    80→  // ============================================\n    81→  // Use these to decide WHAT to render, not just HOW to style it\n    82→\n    83→  /** Whether to show uncertainty/confidence ranges */\n    84→  showUncertainty: boolean;\n    85→\n    86→  /** Whether to emphasize data density over readability */\n    87→  emphasizeData: boolean;\n    88→\n    89→  /** Whether to show technical details (timestamps, IDs, raw scores) */\n    90→  showTechnicalDetails: boolean;\n    91→\n    92→  /** Whether to use ambient/glow effects */\n    93→  useAmbientEffects: boolean;\n    94→\n    95→  /** Whether to animate data updates */\n    96→  animateUpdates: boolean;\n    97→\n    98→  /** Whether to prioritize readability over completeness */\n    99→  prioritizeReadability: boolean;\n   100→\n   101→  /** Whether to show inline sources/citations */\n   102→  showInlineSources: boolean;\n   103→\n   104→  /** Whether to highlight contradictions prominently */\n   105→  highlightContradictions: boolean;\n   106→\n   107→  /** Whether deep-dive interactions are enabled */\n   108→  enableDeepDive: boolean;\n   109→\n   110→  /** Whether comparison tools are enabled */\n   111→  enableComparison: boolean;\n   112→\n   113→  /** Full semantic intent object for advanced use */\n   114→  intent: SemanticIntentValue;\n   115→}\n   116→\n   117→/**\n   118→ * Hook for accessing visualization theme colors and utilities.\n   119→ *\n   120→ * @example\n   121→ * ```tsx\n   122→ * function MyVisualization() {\n   123→ *   const { colors, isRadar, getConfidenceColor, cardClasses } = useVisualizationTheme();\n   124→ *\n   125→ *   return (\n   126→ *     <div className={cardClasses}>\n   127→ *       <circle fill={colors.primary} />\n   128→ *       <rect fill={getConfidenceColor(0.85)} />\n   129→ *     </div>\n   130→ *   );\n   131→ * }\n   132→ * ```\n   133→ */\n   134→export function useVisualizationTheme(): UseVisualizationThemeReturn {\n   135→  const { theme } = useReportTheme();\n   136→  const isRadar = theme === 'radar';\n   137→  const intent = useSemanticIntent();\n   138→\n   139→  return useMemo(() => {\n   140→    const themeConfig = visualizationThemes[theme];\n   141→    const { colors, entityColors } = themeConfig;\n   142→\n   143→    return {\n   144→      theme,\n   145→      isRadar,\n   146→      colors,\n   147→      entityColors,\n   148→\n   149→      getEntityColor: (type: string) => {\n   150→        const normalizedType = type.toLowerCase();\n   151→        return entityColors[normalizedType as keyof EntityTypeColors] || entityColors.other;\n   152→      },\n   153→\n   154→      getConfidenceColor: (value: number) => getConfidenceColor(value, colors),\n   155→      getCredibilityColor: (score: number) => getCredibilityColor(score, colors),\n   156→      getStatusColor: (status) => getStatusColor(status, colors),\n   157→      getTimelineTypeConfig: () => getTimelineTypeConfig(colors),\n   158→\n   159→      cardClasses: getCardClasses(isRadar),\n   160→      surfaceClasses: getSurfaceClasses(isRadar),\n   161→      tooltipClasses: getTooltipClasses(isRadar),\n   162→      headerClasses: getHeaderClasses(isRadar),\n   163→      getButtonClasses: (isActive: boolean) => getButtonClasses(isRadar, isActive),\n   164→\n   165→      getGlowStyle: (color: string, intensity?: 'low' | 'medium' | 'high') =>\n   166→        isRadar ? getGlowStyle(color, intensity) : {},\n   167→\n   168→      // Semantic intent flags - use these for behavioral decisions\n   169→      showUncertainty: intent.showUncertainty,\n   170→      emphasizeData: intent.emphasizeData,\n   171→      showTechnicalDetails: intent.showTechnicalDetails,\n   172→      useAmbientEffects: intent.useAmbientEffects,\n   173→      animateUpdates: intent.animateUpdates,\n   174→      prioritizeReadability: intent.prioritizeReadability,\n   175→      showInlineSources: intent.showInlineSources,\n   176→      highlightContradictions: intent.highlightContradictions,\n   177→      enableDeepDive: intent.enableDeepDive,\n   178→      enableComparison: intent.enableComparison,\n   179→      intent,\n   180→    };\n   181→  }, [theme, isRadar, intent]);\n   182→}\n   183→\n   184→// Re-export types for convenience\n   185→export type { VisualizationColors, EntityTypeColors } from './theme';\n   186→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01XMhYvkxP6sRw1th7ij4ksr","session_id":"d184f0d2-244e-457f-8ea5-4627f2d647f1","uuid":"f351e885-cfa2-4307-9a1c-12de9e36269e"}
