= useFilteredData({\n    39→    data: sources,\n    40→    searchQuery,\n    41→    filterFn,\n    42→  });\n    43→\n    44→  // Group by credibility\n    45→  const highCred = filteredSources.filter(s => (s.credibility_score || 0) >= 0.8);\n    46→  const medCred = filteredSources.filter(s => {\n    47→    const c = s.credibility_score || 0;\n    48→    return c >= 0.5 && c < 0.8;\n    49→  });\n    50→  const lowCred = filteredSources.filter(s => (s.credibility_score || 0) < 0.5);\n    51→\n    52→  if (filteredSources.length === 0) {\n    53→    return <EmptyState type=\"search\" title=\"No sources match your filters\" />;\n    54→  }\n    55→\n    56→  return (\n    57→    <div className=\"space-y-4\">\n    58→      {/* Summary bar */}\n    59→      <div className=\"flex items-center gap-4 p-3 bg-white rounded-lg border border-slate-200\">\n    60→        <div className=\"flex-1\">\n    61→          <div className=\"text-xs text-slate-500 mb-1\">Credibility Distribution</div>\n    62→          <div className=\"flex h-2 rounded-full overflow-hidden bg-slate-200\">\n    63→            <div className=\"bg-emerald-500\" style={{ width: `${(highCred.length / filteredSources.length) * 100}%` }} />\n    64→            <div className=\"bg-amber-500\" style={{ width: `${(medCred.length / filteredSources.length) * 100}%` }} />\n    65→            <div className=\"bg-red-500\" style={{ width: `${(lowCred.length / filteredSources.length) * 100}%` }} />\n    66→          </div>\n    67→        </div>\n    68→        <div className=\"flex gap-4 text-xs\">\n    69→          <span className=\"flex items-center gap-1\">\n    70→            <span className=\"w-2 h-2 rounded-full bg-emerald-500\"></span>\n    71→            High: {highCred.length}\n    72→          </span>\n    73→          <span className=\"flex items-center gap-1\">\n    74→            <span className=\"w-2 h-2 rounded-full bg-amber-500\"></span>\n    75→            Medium: {medCred.length}\n    76→          </span>\n    77→          <span className=\"flex items-center gap-1\">\n    78→            <span className=\"w-2 h-2 rounded-full bg-red-500\"></span>\n    79→            Low: {lowCred.length}\n    80→          </span>\n    81→        </div>\n    82→      </div>\n    83→\n    84→      {/* Table */}\n    85→      <ThemedSection title=\"Sources\" count={filteredSources.length}>\n    86→        <div className=\"overflow-x-auto -mx-4\">\n    87→          <table className=\"w-full text-sm\">\n    88→            <thead>\n    89→              <tr className=\"bg-slate-50 border-b border-slate-200\">\n    90→                <th className=\"text-left px-4 py-2 font-semibold text-slate-600 text-xs uppercase\">Source</th>\n    91→                <th className=\"text-left px-4 py-2 font-semibold text-slate-600 text-xs uppercase w-20\">Type</th>\n    92→                <th className=\"text-left px-4 py-2 font-semibold text-slate-600 text-xs uppercase w-28\">Credibility</th>\n    93→                <th className=\"text-left px-4 py-2 font-semibold text-slate-600 text-xs uppercase w-24\">Date</th>\n    94→              </tr>\n    95→            </thead>\n    96→            <tbody>\n    97→              {filteredSources.map((source) => (\n    98→                <SourceRow key={source.id} source={source} />\n    99→              ))}\n   100→            </tbody>\n   101→          </table>\n   102→        </div>\n   103→      </ThemedSection>\n   104→    </div>\n   105→  );\n   106→}\n   107→\n   108→function SourceRow({ source }: { source: ResearchSource }) {\n   109→  const cred = source.credibility_score || 0;\n   110→\n   111→  return (\n   112→    <tr className=\"border-b border-slate-100 hover:bg-slate-50/50 transition-colors\">\n   113→      <td className=\"px-4 py-3\">\n   114→        <a\n   115→          href={source.url}\n   116→          target=\"_blank\"\n   117→          rel=\"noopener noreferrer\"\n   118→          className=\"font-medium text-blue-600 hover:underline line-clamp-1\"\n   119→        >\n   120→          {source.title || source.domain || 'Untitled'}\n   121→        </a>\n   122→        <div className=\"text-xs text-slate-400 truncate max-w-md\">{source.domain}</div>\n   123→        {source.snippet && (\n   124→          <div className=\"text-xs text-slate-500 mt-1 line-clamp-1 italic\">\n   125→            &ldquo;{source.snippet}&rdquo;\n   126→          </div>\n   127→        )}\n   128→      </td>\n   129→      <td className=\"px-4 py-3\">\n   130→        <SourceTypeBadge type={source.source_type || 'unknown'} />\n   131→      </td>\n   132→      <td className=\"px-4 py-3\">\n   133→        <div className=\"flex items-center gap-2\">\n   134→          <ProgressBar value={cred * 100} size=\"sm\" />\n   135→          <span className=\"text-xs font-medium text-slate-600 w-8\">\n   136→            {Math.round(cred * 100)}%\n   137→          </span>\n   138→        </div>\n   139→      </td>\n   140→      <td className=\"px-4 py-3 text-xs text-slate-500\">\n   141→        {source.content_date\n   142→          ? new Date(source.content_date).toLocaleDateString()\n   143→          : '—'}\n   144→      </td>\n   145→    </tr>\n   146→  );\n   147→}\n   148→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"d184f0d2-244e-457f-8ea5-4627f2d647f1","uuid":"24cca8ed-8a17-4b35-b2f2-d61de6a5d89f","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\components\\report\\tabs\\SourcesTab.tsx","content":"'use client';\n\nimport { useCallback, useMemo } from 'react';\nimport type { ResearchSource } from '@/src/types/research';\nimport { ThemedSection } from '../ThemedCards';\nimport { EmptyState } from '../shared/EmptyState';\nimport { SourceTypeBadge, CredibilityBadge } from '../shared/Badges';\nimport { ProgressBar } from '../shared/ProgressBar';\nimport { LinkIcon } from '../shared/Icons';\nimport { matchesConfidenceFilter, type ConfidenceFilterOption } from '../shared/typeConfig';\nimport { useFilteredData } from '@/src/hooks/useFilteredData';\n\ninterface SourcesTabProps {\n  sources: ResearchSource[];\n  searchQuery: string;\n  filterConfidence: string;\n}\n\nexport function SourcesTab({ sources, searchQuery, filterConfidence }: SourcesTabProps) {\n  // Stabilize filter function to prevent re-filtering when only search query changes\n  const filterFn = useCallback(\n    (s: ResearchSource, debouncedQuery: string) => {\n      if (debouncedQuery) {\n        const query = debouncedQuery.toLowerCase();\n        const matchesTitle = s.title?.toLowerCase().includes(query);\n        const matchesDomain = s.domain?.toLowerCase().includes(query);\n        const matchesSnippet = s.snippet?.toLowerCase().includes(query);\n        if (!matchesTitle && !matchesDomain && !matchesSnippet) return false;\n      }\n      if (!matchesConfidenceFilter(s.credibility_score || 0, filterConfidence as ConfidenceFilterOption)) {\n        return false;\n      }\n      return true;\n    },\n    [filterConfidence]\n  );\n\n  const { filteredData: filteredSources } = useFilteredData({\n    data: sources,\n    searchQuery,\n    filterFn,\n  });\n\n  // Group by credibility\n  const highCred = filteredSources.filter(s => (s.credibility_score || 0) >= 0.8);\n  const medCred = filteredSources.filter(s => {\n    const c = s.credibility_score || 0;\n    return c >= 0.5 && c < 0.8;\n  });\n  const lowCred = filteredSources.filter(s => (s.credibility_score || 0) < 0.5);\n\n  if (filteredSources.length === 0) {\n    return <EmptyState type=\"search\" title=\"No sources match your filters\" />;\n  }\n\n  return (\n    <div className=\"space-y-4\">\n      {/* Summary bar */}\n      <div className=\"flex items-center gap-4 p-3 bg-white rounded-lg border border-slate-200\">\n        <div className=\"flex-1\">\n          <div className=\"text-xs text-slate-500 mb-1\">Credibility Distribution</div>\n          <div className=\"flex h-2 rounded-full overflow-hidden bg-slate-200\">\n            <div className=\"bg-emerald-500\" style={{ width: `${(highCred.length / filteredSources.length) * 100}%` }} />\n            <div className=\"bg-amber-500\" style={{ width: `${(medCred.length / filteredSources.length) * 100}%` }} />\n            <div className=\"bg-red-500\" style={{ width: `${(lowCred.length / filteredSources.length) * 100}%` }} />\n          </div>\n        </div>\n        <div className=\"flex gap-4 text-xs\">\n          <span className=\"flex items-center gap-1\">\n            <span className=\"w-2 h-2 rounded-full bg-emerald-500\"></span>\n            High: {highCred.length}\n          </span>\n          <span className=\"flex items-center gap-1\">\n            <span className=\"w-2 h-2 rounded-full bg-amber-500\"></span>\n            Medium: {medCred.length}\n          </span>\n          <span className=\"flex items-center gap-1\">\n            <span className=\"w-2 h-2 rounded-full bg-red-500\"></span>\n            Low: {lowCred.length}\n          </span>\n        </div>\n      </div>\n\n      {/* Table */}\n      <ThemedSection title=\"Sources\" count={filteredSources.length}>\n        <div className=\"overflow-x-auto -mx-4\">\n          <table className=\"w-full text-sm\">\n            <thead>\n              <tr className=\"bg-slate-50 border-b border-slate-200\">\n                <th className=\"text-left px-4 py-2 font-semibold text-slate-600 text-xs uppercase\">Source</th>\n                <th className=\"text-left px-4 py-2 font-semibold text-slate-600 text-xs uppercase w-20\">Type</th>\n                <th className=\"text-left px-4 py-2 font-semibold text-slate-600 text-xs uppercase w-28\">Credibility</th>\n                <th className=\"text-left px-4 py-2 font-semibold text-slate-600 text-xs uppercase w-24\">Date</th>\n              </tr>\n            </thead>\n            <tbody>\n              {filteredSources.map((source) => (\n                <SourceRow key={source.id} source={source} />\n              ))}\n            </tbody>\n          </table>\n        </div>\n      </ThemedSection>\n    </div>\n  );\n}\n\nfunction SourceRow({ source }: { source: ResearchSource }) {\n  const cred = source.credibility_score || 0;\n\n  return (\n    <tr className=\"border-b border-slate-100 hover:bg-slate-50/50 transition-colors\">\n      <td className=\"px-4 py-3\">\n        <a\n          href={source.url}\n          target=\"_blank\"\n          rel=\"noopener noreferrer\"\n          className=\"font-medium text-blue-600 hover:underline line-clamp-1\"\n        >\n          {source.title || source.domain || 'Untitled'}\n        </a>\n        <div className=\"text-xs text-slate-400 truncate max-w-md\">{source.domain}</div>\n        {source.snippet && (\n          <div className=\"text-xs text-slate-500 mt-1 line-clamp-1 italic\">\n            &ldquo;{source.snippet}&rdquo;\n          </div>\n        )}\n      </td>\n      <td className=\"px-4 py-3\">\n        <SourceTypeBadge type={source.source_type || 'unknown'} />\n      </td>\n      <td className=\"px-4 py-3\">\n        <div className=\"flex items-center gap-2\">\n          <ProgressBar value={cred * 100} size=\"sm\" />\n          <span className=\"text-xs font-medium text-slate-600 w-8\">\n            {Math.round(cred * 100)}%\n          </span>\n        </div>\n      </td>\n      <td className=\"px-4 py-3 text-xs text-slate-500\">\n        {source.content_date\n          ? new Date(source.content_date).toLocaleDateString()\n          : '—'}\n      </td>\n    </tr>\n  );\n}\n","numLines":148,"startLine":1,"totalLines":148}}}
