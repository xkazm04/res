acity: 0 },\n    37→  visible: {\n    38→    opacity: 1,\n    39→    transition: {\n    40→      staggerChildren: 0.03,\n    41→    },\n    42→  },\n    43→};\n    44→\n    45→const itemVariants = {\n    46→  hidden: { opacity: 0, y: 10 },\n    47→  visible: { opacity: 1, y: 0 },\n    48→  exit: { opacity: 0, scale: 0.95 },\n    49→};\n    50→\n    51→export function SourcesView({ sources, findings, initialSelectedId }: SourcesViewProps) {\n    52→  const { theme } = useReportTheme();\n    53→  const styles = useThemeStyles();\n    54→  const isRadar = theme === 'radar';\n    55→  const focusCtx = useFocusSafe();\n    56→\n    57→  // Local filter state - no prop drilling from ReportView\n    58→  const [searchQuery, setSearchQuery] = useState('');\n    59→  const [filterConfidence, setFilterConfidence] = useState('all');\n    60→  const debouncedSearchQuery = useDebouncedValue(searchQuery, 150);\n    61→\n    62→  const [viewMode, setViewMode] = useState<ViewMode>('cards');\n    63→  const [selectedSource, setSelectedSource] = useState<string | null>(initialSelectedId || null);\n    64→\n    65→  // Build a map of source ID -> finding IDs that reference it\n    66→  const sourceToFindingsMap = useMemo(() => {\n    67→    const map = new Map<string, string[]>();\n    68→    findings?.forEach(f => {\n    69→      f.supporting_sources?.forEach(srcId => {\n    70→        const existing = map.get(srcId) || [];\n    71→        existing.push(f.id);\n    72→        map.set(srcId, existing);\n    73→      });\n    74→    });\n    75→    return map;\n    76→  }, [findings]);\n    77→\n    78→  // Sync selection when navigating from another view\n    79→  useEffect(() => {\n    80→    if (initialSelectedId) {\n    81→      setSelectedSource(initialSelectedId);\n    82→    }\n    83→  }, [initialSelectedId]);\n    84→\n    85→  // Handle selecting a source and updating global focus\n    86→  const handleSelectSource = useCallback((id: string | null) => {\n    87→    setSelectedSource(id);\n    88→\n    89→    // Update global focus context if available\n    90→    if (focusCtx && id) {\n    91→      const relatedFindingIds = sourceToFindingsMap.get(id);\n    92→      focusCtx.focusSource(id, relatedFindingIds);\n    93→    } else if (focusCtx && !id) {\n    94→      focusCtx.clearFocus();\n    95→    }\n    96→  }, [focusCtx, sourceToFindingsMap]);\n    97→\n    98→  const filtered = useMemo(() => {\n    99→    return sources.filter((s) => {\n   100→      if (debouncedSearchQuery) {\n   101→        const q = debouncedSearchQuery.toLowerCase();\n   102→        if (!s.title?.toLowerCase().includes(q) && !s.domain?.toLowerCase().includes(q)) return false;\n   103→      }\n   104→      if (!matchesConfidenceFilter(s.credibility_score || 0, filterConfidence as ConfidenceFilterOption)) return false;\n   105→      return true;\n   106→    });\n   107→  }, [sources, debouncedSearchQuery, filterConfidence]);\n   108→\n   109→  const stats = useMemo(() => {\n   110→    const high = filtered.filter(s => (s.credibility_score || 0) >= 0.8).length;\n   111→    const med = filtered.filter(s => { const c = s.credibility_score || 0; return c >= 0.5 && c < 0.8; }).length;\n   112→    return { high, med, low: filtered.length - high - med };\n   113→  }, [filtered]);\n   114→\n   115→  if (filtered.length === 0) {\n   116→    return (\n   117→      <EmptyState\n   118→        type=\"search\"\n   119→        title=\"No sources match your filters\"\n   120→        description=\"Try adjusting your search or confidence filters to see more results.\"\n   121→      />\n   122→    );\n   123→  }\n   124→\n   125→  return (\n   126→    <div className=\"space-y-4\">\n   127→      <ViewHeader\n   128→        title=\"Sources\"\n   129→        count={filtered.length}\n   130→        persona=\"source\"\n   131→        actions={<ViewModeToggle options={viewModeOptions} value={viewMode} onChange={setViewMode} />}\n   132→      />\n   133→\n   134→      {/* Inline Toolbar 