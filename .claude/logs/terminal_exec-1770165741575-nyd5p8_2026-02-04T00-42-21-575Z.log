   92→    return (\n    93→      <EmptyState\n    94→        type=\"users\"\n    95→        title=\"No entities extracted\"\n    96→        description=\"The research hasn't identified any people, organizations, or locations yet.\"\n    97→      />\n    98→    );\n    99→  }\n   100→\n   101→  return (\n   102→    <div className=\"space-y-4\">\n   103→      <ViewHeader\n   104→        title=\"Entities\"\n   105→        count={entities.length}\n   106→        persona=\"network\"\n   107→        actions={<ViewModeToggle options={viewModeOptions} value={viewMode} onChange={setViewMode} />}\n   108→      />\n   109→\n   110→      {/* Type filters */}\n   111→      <div className=\"flex gap-2\">\n   112→        <FilterChip label=\"All\" count={entities.length} active={filterType === 'all'} onClick={() => setFilterType('all')} />\n   113→        {(['person', 'organization', 'location', 'event'] as EntityType[]).map(type => (\n   114→          <FilterChip\n   115→            key={type}\n   116→            label={entityTypeConfig[type].icon}\n   117→            count={grouped[type].length}\n   118→            active={filterType === type}\n   119→            onClick={() => setFilterType(type)}\n   120→          />\n   121→        ))}\n   122→      </div>\n   123→\n   124→      {/* Constellation view */}\n   125→      {viewMode === 'constellation' && (\n   126→        <CollapsibleSection\n   127→          sectionId=\"entities-constellation\"\n   128→          title=\"Entity Network\"\n   129→          subtitle=\"Visual representation of entity relationships\"\n   130→          icon=\"🌐\"\n   131→          count={filtered.length}\n   132→          variant=\"card\"\n   133→        >\n   134→          <EntityConstellation\n   135→            entities={filtered}\n   136→            selectedEntity={selectedEntity || undefined}\n   137→            onEntitySelect={handleSelectEntity}\n   138→          />\n   139→        </CollapsibleSection>\n   140→      )}\n   141→\n   142→      {