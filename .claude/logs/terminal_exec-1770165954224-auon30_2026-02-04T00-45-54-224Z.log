[2026-02-04T00:46:35.503Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013tpgLUaqNCtcg5Ba6WvKrB","type":"tool_result","content":"     1→import { createClient } from '@supabase/supabase-js';\n     2→import type {\n     3→  ResearchSession,\n     4→  ResearchFinding,\n     5→  ResearchSource,\n     6→  ResearchPerspective,\n     7→  QueryDecomposition,\n     8→  SubQuery,\n     9→  FindingRelationship,\n    10→  ResearchContradiction,\n    11→  ResearchGap,\n    12→  CausalChain,\n    13→  FindingPerspective,\n    14→  KnowledgeEntity,\n    15→  ClaimRelationship,\n    16→  SessionWithDetails,\n    17→} from '@/src/types/research';\n    18→\n    19→const supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL!;\n    20→const supabaseAnonKey = process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY!;\n    21→\n    22→export const supabase = createClient(supabaseUrl, supabaseAnonKey);\n    23→\n    24→// ============================================\n    25→// SESSION QUERIES\n    26→// ============================================\n    27→\n    28→// Get all sessions (lightweight, for map visualization)\n    29→export async function getAllSessions(): Promise<ResearchSession[]> {\n    30→  const { data, error } = await supabase\n    31→    .from('research_sessions')\n    32→    .select('*')\n    33→    .order('created_at', { ascending: false });\n    34→\n    35→  if (error) {\n    36→    console.error('Error fetching all sessions:', error);\n    37→    return [];\n    38→  }\n    39→  return data || [];\n    40→}\n    41→\n    42→// Get session counts by template type\n    43→export async function getSessionCountsByTemplate(): Promise<Record<string, number>> {\n    44→  const { data, error } = await supabase\n    45→    .from('research_sessions')\n    46→    .select('template_type');\n    47→\n    48→  if (error) {\n    49→    console.error('Error fetching session counts:', error);\n    50→    return {};\n    51→  }\n    52→\n    53→  const counts: Record<string, number> = {};\n    54→  data?.forEach((s) => {\n    55→    counts[s.template_type] = (counts[s.template_type] || 0) + 1;\n    56→  });\n    57→  return counts;\n    58→}\n    59→\n    60→export async function getSession(sessionId: string): Promise<ResearchSession | null> {\n    61→  const { data, error } = await supabase\n    62→    .from('research_sessions')\n    63→    .select('*')\n    64→    .eq('id', sessionId)\n    65→    .single();\n    66→\n    67→  if (error) {\n    68→    console.error('Error fetching session:', error);\n    69→    return null;\n    70→  }\n    71→  return data;\n    72→}\n    73→\n    74→export async function getSessionWithDetails(sessionId: string): Promise<SessionWithDetails | null> {\n    75→  const [\n    76→    sessionResult,\n    77→    findingsResult,\n    78→    sourcesResult,\n    79→    perspectivesResult,\n    80→    decompositionResult,\n    81→    relationshipsResult,\n    82→    contradictionsResult,\n    83→    gapsResult,\n    84→    chainsResult,\n    85→  ] = await Promise.all([\n    86→    supabase.from('research_sessions').select('*').eq('id', sessionId).single(),\n    87→    supabase.from('research_findings').select('*').eq('session_id', sessionId).order('created_at'),\n    88→    supabase.from('research_sources').select('*').eq('session_id', sessionId),\n    89→    supabase.from('research_perspectives').select('*').eq('session_id', sessionId),\n    90→    supabase.from('query_decompositions').select('*').eq('session_id', sessionId).single(),\n    91→    supabase.from('finding_relationships').select('*').eq('session_id', sessionId),\n    92→    supabase.from('research_contradictions').select('*').eq('session_id', sessionId),\n    93→    supabase.from('research_gaps').select('*').eq('session_id', sessionId).order('priority'),\n    94→    supabase.from('causal_chains').select('*').eq('session_id', sessionId),\n    95→  ]);\n    96→\n    97→  if (sessionResult.error) {\n    98→    console.error('Error fetching session:', sessionResult.error);\n    99→    return null;\n   100→  }\n   101→\n   102→  let decomposition: (QueryDecomposition & { sub_queries: SubQuery[] }) | undefined;\n   103→  if (decompositionResult.data) {\n   104→    const { data: subQueries } = await supabase\n   105→      .from('sub_queries')\n   106→      .select('*')\n   107→      .eq('decomposition_id', decompositionResult.data.id)\n   108→      .order('batch_order');\n   109→    decomposition = {\n   110→      ...decompositionResult.data,\n   111→      sub_queries: subQueries || [],\n   112→    };\n   113→  }\n   114→\n   115→  return {\n   116→    ...sessionResult.data,\n   117→    findings: findingsResult.data || [],\n   118→    sources: sourcesResult.data || [],\n   119→    perspectives: perspectivesResult.data || [],\n   120→    decomposition,\n   121→    relationships: relationshipsResult.data || [],\n   122→    contradictions: contradictionsResult.data || [],\n   123→    gaps: gapsResult.data || [],\n   124→    causal_chains: chainsResult.data || [],\n   125→  };\n   126→}\n   127→\n   128→// ============================================\n   129→// FINDINGS QUERIES\n   130→// ============================================\n   131→\n   132→export async function getFindings(sessionId: string): Promise<ResearchFinding[]> {\n   133→  const { data, error } = await supabase\n   134→    .from('research_findings')\n   135→    .select('*')\n   136→    .eq('session_id', sessionId)\n   137→    .order('created_at');\n   138→\n   139→  if (error) {\n   140→    console.error('Error fetching findings:', error);\n   141→    return [];\n   142→  }\n   143→  return data || [];\n   144→}\n   145→\n   146→export async function getFindingWithRelationships(findingId: string) {\n   147→  const [findingResult, relationshipsResult, perspectivesResult] = await Promise.all([\n   148→    supabase.from('research_findings').select('*').eq('id', findingId).single(),\n   149→    supabase\n   150→      .from('finding_relationships')\n   151→      .select('*')\n   152→      .or(`source_finding_id.eq.${findingId},target_finding_id.eq.${findingId}`),\n   153→    supabase.from('finding_perspectives').select('*').eq('finding_id', findingId),\n   154→  ]);\n   155→\n   156→  return {\n   157→    finding: findingResult.data,\n   158→    relationships: relationshipsResult.data || [],\n   159→    perspectives: perspectivesResult.data || [],\n   160→  };\n   161→}\n   162→\n   163→// ============================================\n   164→// SOURCES QUERIES\n   165→// ============================================\n   166→\n   167→export async function getSources(sessionId: string): Promise<ResearchSource[]> {\n   168→  const { data, error } = await supabase\n   169→    .from('research_sources')\n   170→    .select('*')\n   171→    .eq('session_id', sessionId)\n   172→    .order('credibility_score', { ascending: false });\n   173→\n   174→  if (error) {\n   175→    console.error('Error fetching sources:', error);\n   176→    return [];\n   177→  }\n   178→  return data || [];\n   179→}\n   180→\n   181→// ============================================\n   182→// PERSPECTIVES QUERIES\n   183→// ============================================\n   184→\n   185→export async function getPerspectives(sessionId: string): Promise<ResearchPerspective[]> {\n   186→  const { data, error } = await supabase\n   187→    .from('research_perspectives')\n   188→    .select('*')\n   189→    .eq('session_id', sessionId);\n   190→\n   191→  if (error) {\n   192→    console.error('Error fetching perspectives:', error);\n   193→    return [];\n   194→  }\n   195→  return data || [];\n   196→}\n   197→\n   198→export async function getFindingPerspectives(findingId: string): Promise<FindingPerspective[]> {\n   199→  const { data, error } = await supabase\n   200→    .from('finding_perspectives')\n   201→    .select('*')\n   202→    .eq('finding_id', findingId);\n   203→\n   204→  if (error) {\n   205→    console.error('Error fetching finding perspectives:', error);\n   206→    return [];\n   207→  }\n   208→  return data || [];\n   209→}\n   210→\n   211→// ============================================\n   212→// RELATIONSHIPS QUERIES\n   213→// ============================================\n   214→\n   215→export async function getRelationships(sessionId: string): Promise<FindingRelationship[]> {\n   216→  const { data, error } = await supabase\n   217→    .from('finding_relationships')\n   218→    .select('*')\n   219→    .eq('session_id', sessionId);\n   220→\n   221→  if (error) {\n   222→    console.error('Error fetching relationships:', error);\n   223→    return [];\n   224→  }\n   225→  return data || [];\n   226→}\n   227→\n   228→export async function getContradictions(sessionId: string): Promise<ResearchContradiction[]> {\n   229→  const { data, error } = await supabase\n   230→    .from('research_contradictions')\n   231→    .select('*')\n   232→    .eq('session_id', sessionId);\n   233→\n   234→  if (error) {\n   235→    console.error('Error fetching contradictions:', error);\n   236→    return [];\n   237→  }\n   238→  return data || [];\n   239→}\n   240→\n   241→export async function getCausalChains(sessionId: string): Promise<CausalChain[]> {\n   242→  const { data, error } = await supabase\n   243→    .from('causal_chains')\n   244→    .select('*')\n   245→    .eq('session_id', sessionId);\n   246→\n   247→  if (error) {\n   248→    console.error('Error fetching causal chains:', error);\n   249→    return [];\n   250→  }\n   251→  return data || [];\n   252→}\n   253→\n   254→// ============================================\n   255→// GAPS QUERIES\n   256→// ============================================\n   257→\n   258→export async function getGaps(sessionId: string): Promise<ResearchGap[]> {\n   259→  const { data, error } = await supabase\n   260→    .from('research_gaps')\n   261→    .select('*')\n   262→    .eq('session_id', sessionId)\n   263→    .order('priority');\n   264→\n   265→  if (error) {\n   266→    console.error('Error fetching gaps:', error);\n   267→    return [];\n   268→  }\n   269→  return data || [];\n   270→}\n   271→\n   272→// ============================================\n   273→// ENTITIES QUERIES\n   274→// ============================================\n   275→\n   276→export async function getEntitiesForSession(sessionId: string): Promise<KnowledgeEntity[]> {\n   277→  // Get all findings for session, then get linked entities\n   278→  const { data: findings } = await supabase\n   279→    .from('research_findings')\n   280→    .select('knowledge_claim_id')\n   281→    .eq('session_id', sessionId)\n   282→    .not('knowledge_claim_id', 'is', null);\n   283→\n   284→  if (!findings || findings.length === 0) return [];\n   285→\n   286→  const claimIds = findings.map((f) => f.knowledge_claim_id).filter(Boolean);\n   287→\n   288→  const { data: claimEntities } = await supabase\n   289→    .from('claim_entities')\n   290→    .select('entity_id')\n   291→    .in('claim_id', claimIds);\n   292→\n   293→  if (!claimEntities || claimEntities.length === 0) return [];\n   294→\n   295→  const entityIds = [...new Set(claimEntities.map((ce) => ce.entity_id))];\n   296→\n   297→  const { data: entities, error } = await supabase\n   298→    .from('knowledge_entities')\n   299→    .select('*')\n   300→    .in('id', entityIds);\n   301→\n   302→  if (error) {\n   303→    console.error('Error fetching entities:', error);\n   304→    return [];\n   305→  }\n   306→  return entities || [];\n   307→}\n   308→\n   309→// ============================================\n   310→// CLAIM RELATIONSHIPS QUERIES\n   311→// ============================================\n   312→\n   313→export async function getClaimRelationships(claimIds: string[]): Promise<ClaimRelationship[]> {\n   314→  if (claimIds.length === 0) return [];\n   315→\n   316→  const { data, error } = await supabase\n   317→    .from('claim_relationships')\n   318→    .select('*')\n   319→    .or(`source_claim_id.in.(${claimIds.join(',')}),target_claim_id.in.(${claimIds.join(',')})`);\n   320→\n   321→  if (error) {\n   322→    console.error('Error fetching claim relationships:', error);\n   323→    return [];\n   324→  }\n   325→  return data || [];\n   326→}\n   327→\n   328→// ============================================\n   329→// DECOMPOSITION QUERIES\n   330→// ============================================\n   331→\n   332→export async function getDecomposition(sessionId: string): Promise<QueryDecomposition | null> {\n   333→  const { data, error } = await supabase\n   334→    .from('query_decompositions')\n   335→    .select('*')\n   336→    .eq('session_id', sessionId)\n   337→    .single();\n   338→\n   339→  if (error) {\n   340→    console.error('Error fetching decomposition:', error);\n   341→    return null;\n   342→  }\n   343→  return data;\n   344→}\n   345→\n   346→export async function getSubQueries(decompositionId: string): Promise<SubQuery[]> {\n   347→  const { data, error } = await supabase\n   348→    .from('sub_queries')\n   349→    .select('*')\n   350→    .eq('decomposition_id', decompositionId)\n   351→    .order('batch_order');\n   352→\n   353→  if (error) {\n   354→    console.error('Error fetching sub-queries:', error);\n   355→    return [];\n   356→  }\n   357→  return data || [];\n   358→}\n   359→\n   360→// ============================================\n   361→// WRITE OPERATIONS - Research Persistence\n   362→// Uses existing research_sessions, research_findings,\n   363→// research_sources, research_perspectives tables\n   364→// ============================================\n   365→\n   366→export async function createActorSession(\n   367→  session: {\n   368→    id: string;\n   369→    query: string;\n   370→    template: string;\n   371→    status: string;\n   372→    granularity: string;\n   373→    max_searches: number;\n   374→    user_email?: string;\n   375→    progress_phase?: string;\n   376→    progress_percent?: number;\n   377→  }\n   378→): Promise<{ id: string } | null> {\n   379→  const { data, error } = await supabase\n   380→    .from('research_sessions')\n   381→    .insert({\n   382→      id: session.id,\n   383→      title: `Research: ${session.query.slice(0, 50)}...`,\n   384→      query: session.query,\n   385→      template_type: session.template,\n   386→      status: session.status === 'running' ? 'searching' : session.status,\n   387→      parameters: {\n   388→        granularity: session.granularity,\n   389→        max_searches: session.max_searches,\n   390→        user_email: session.user_email,\n   391→        progress_phase: session.progress_phase,\n   392→        progress_percent: session.progress_percent,\n   393→      },\n   394→    })\n   395→    .select('id')\n   396→    .single();\n   397→\n   398→  if (error) {\n   399→    console.error('Error creating research session:', error);\n   400→    return null;\n   401→  }\n   402→  return data;\n   403→}\n   404→\n   405→export async function updateActorSession(\n   406→  sessionId: string,\n   407→  updates: {\n   408→    status?: string;\n   409→    progress_phase?: string;\n   410→    progress_percent?: number;\n   411→    error_message?: string;\n   412→    completed_at?: string;\n   413→  }\n   414→): Promise<boolean> {\n   415→  // Map status to existing schema values\n   416→  const statusMap: Record<string, string> = {\n   417→    running: 'searching',\n   418→    completed: 'completed',\n   419→    failed: 'failed',\n   420→  };\n   421→\n   422→  const updateData: Record<string, unknown> = {};\n   423→\n   424→  if (updates.status) {\n   425→    updateData.status = statusMap[updates.status] || updates.status;\n   426→  }\n   427→\n   428→  if (updates.completed_at) {\n   429→    updateData.completed_at = updates.completed_at;\n   430→  }\n   431→\n   432→  // Store progress info in parameters JSONB\n   433→  if (updates.progress_phase || updates.progress_percent !== undefined || updates.error_message) {\n   434→    // First get current parameters\n   435→    const { data: current } = await supabase\n   436→      .from('research_sessions')\n   437→      .select('parameters')\n   438→      .eq('id', sessionId)\n   439→      .single();\n   440→\n   441→    const currentParams = (current?.parameters as Record<string, unknown>) || {};\n   442→    updateData.parameters = {\n   443→      ...currentParams,\n   444→      ...(updates.progress_phase && { progress_phase: updates.progress_phase }),\n   445→      ...(updates.progress_percent !== undefined && { progress_percent: updates.progress_percent }),\n   446→      ...(updates.error_message && { error_message: updates.error_message }),\n   447→    };\n   448→  }\n   449→\n   450→  const { error } = await supabase\n   451→    .from('research_sessions')\n   452→    .update(updateData)\n   453→    .eq('id', sessionId);\n   454→\n   455→  if (error) {\n   456→    console.error('Error updating research session:', error);\n   457→    return false;\n   458→  }\n   459→  return true;\n   460→}\n   461→\n   462→export async function saveActorFindings(\n   463→  sessionId: string,\n   464→  findings: Array<{\n   465→    finding_id: string;\n   466→    finding_type: string;\n   467→    content: string;\n   468→    summary?: string;\n   469→    confidence_score: number;\n   470→    temporal_context: string;\n   471→    extracted_data?: Record<string, unknown>;\n   472→  }>\n   473→): Promise<boolean> {\n   474→  if (findings.length === 0) return true;\n   475→\n   476→  const { error } = await supabase\n   477→    .from('research_findings')\n   478→    .insert(findings.map(f => ({\n   479→      session_id: sessionId,\n   480→      finding_type: f.finding_type,\n   481→      content: f.content,\n   482→      summary: f.summary,\n   483→      confidence_score: f.confidence_score,\n   484→      temporal_context: f.temporal_context,\n   485→      extracted_data: f.extracted_data,\n   486→    })));\n   487→\n   488→  if (error) {\n   489→    console.error('Error saving research findings:', error);\n   490→    return false;\n   491→  }\n   492→  return true;\n   493→}\n   494→\n   495→export async function saveActorSources(\n   496→  sessionId: string,\n   497→  sources: Array<{\n   498→    url: string;\n   499→    title: string;\n   500→    domain: string;\n   501→    snippet?: string;\n   502→    credibility_score?: number;\n   503→    credibility_label?: string;\n   504→  }>\n   505→): Promise<boolean> {\n   506→  if (sources.length === 0) return true;\n   507→\n   508→  // Generate URL hash for deduplication\n   509→  const hashUrl = (url: string) => {\n   510→    let hash = 0;\n   511→    for (let i = 0; i < url.length; i++) {\n   512→      const char = url.charCodeAt(i);\n   513→      hash = ((hash << 5) - hash) + char;\n   514→      hash = hash & hash;\n   515→    }\n   516→    return hash.toString(16);\n   517→  };\n   518→\n   519→  const { error } = await supabase\n   520→    .from('research_sources')\n   521→    .insert(sources.map(s => ({\n   522→      session_id: sessionId,\n   523→      url: s.url,\n   524→      url_hash: hashUrl(s.url),\n   525→      title: s.title,\n   526→      domain: s.domain,\n   527→      snippet: s.snippet,\n   528→      credibility_score: s.credibility_score,\n   529→      credibility_factors: s.credibility_label ? { label: s.credibility_label } : null,\n   530→    })));\n   531→\n   532→  if (error) {\n   533→    console.error('Error saving research sources:', error);\n   534→    return false;\n   535→  }\n   536→  return true;\n   537→}\n   538→\n   539→export async function saveActorPerspectives(\n   540→  sessionId: string,\n   541→  perspectives: Array<{\n   542→    perspective_type: string;\n   543→    analysis_text: string;\n   544→    key_insights: string[];\n   545→    recommendations: string[];\n   546→    warnings: string[];\n   547→    confidence: number;\n   548→  }>\n   549→): Promise<boolean> {\n   550→  if (perspectives.length === 0) return true;\n   551→\n   552→  // Map custom perspective types to schema-allowed values\n   553→  const perspectiveTypeMap: Record<string, string> = {\n   554→    forensic_financial: 'financial',\n   555→    power_network: 'network',\n   556→    psychological_behavioral: 'psychological',\n   557→    legal_liability: 'political',\n   558→    geopolitical_strategic: 'political',\n   559→    institutional_investor: 'financial',\n   560→    short_seller: 'financial',\n   561→    quantitative_risk: 'financial',\n   562→    activist_investor: 'financial',\n   563→    macro_strategist: 'economic',\n   564→    strategy_consultant: 'economic',\n   565→    industry_insider: 'economic',\n   566→    litigation_strategist: 'political',\n   567→    regulatory_expert: 'political',\n   568→  };\n   569→\n   570→  const { error } = await supabase\n   571→    .from('research_perspectives')\n   572→    .insert(perspectives.map(p => ({\n   573→      session_id: sessionId,\n   574→      perspective_type: perspectiveTypeMap[p.perspective_type] || 'economic',\n   575→      analysis_text: p.analysis_text,\n   576→      key_insights: p.key_insights,\n   577→      recommendations: p.recommendations,\n   578→      warnings: p.warnings,\n   579→      confidence: p.confidence,\n   580→      specialized_data: {\n   581→        original_type: p.perspective_type,\n   582→      },\n   583→    })));\n   584→\n   585→  if (error) {\n   586→    console.error('Error saving research perspectives:', error);\n   587→    return false;\n   588→  }\n   589→  return true;\n   590→}\n   591→\n   592→export async function saveActorReport(\n   593→  sessionId: string,\n   594→  reportMarkdown: string,\n   595→  costSummary: {\n   596→    total_tokens: number;\n   597→    total_cost_usd: number;\n   598→  }\n   599→): Promise<boolean> {\n   600→  // Get current parameters and update with report info\n   601→  const { data: current } = await supabase\n   602→    .from('research_sessions')\n   603→    .select('parameters')\n   604→    .eq('id', sessionId)\n   605→    .single();\n   606→\n   607→  const currentParams = (current?.parameters as Record<string, unknown>) || {};\n   608→\n   609→  const { error } = await supabase\n   610→    .from('research_sessions')\n   611→    .update({\n   612→      status: 'completed',\n   613→      completed_at: new Date().toISOString(),\n   614→      parameters: {\n   615→        ...currentParams,\n   616→        report_markdown: reportMarkdown,\n   617→        total_tokens: costSummary.total_tokens,\n   618→        total_cost_usd: costSummary.total_cost_usd,\n   619→      },\n   620→    })\n   621→    .eq('id', sessionId);\n   622→\n   623→  if (error) {\n   624→    console.error('Error saving research report:', error);\n   625→    return false;\n   626→  }\n   627→  return true;\n   628→}\n   629→\n   630→// ============================================\n   631→// TOPIC QUERIES (for intermediate categorization)\n   632→// ============================================\n   633→\n   634→export interface TopicGroup {\n   635→  id: string;\n   636→  name: string;\n   637→  slug: string;\n   638→  description?: string;\n   639→  topic_type?: string;\n   640→  parent_id?: string;\n   641→  session_count: number;\n   642→  finding_count: number;\n   643→  entity_count: number;\n   644→  sessions?: Array<{\n   645→    id: string;\n   646→    template_type: string;\n   647→    status: string;\n   648→  }>;\n   649→}\n   650→\n   651→export async function getTopicsWithSessionCounts(): Promise<TopicGroup[]> {\n   652→  // Get topics with their linked sessions\n   653→  const { data: topics, error } = await supabase\n   654→    .from('knowledge_topics')\n   655→    .select('*')\n   656→    .order('session_count', { ascending: false });\n   657→\n   658→  if (error) {\n   659→    console.error('Error fetching topics:', error);\n   660→    return [];\n   661→  }\n   662→\n   663→  // For each topic, get linked sessions\n   664→  const topicsWithSessions = await Promise.all(\n   665→    (topics || []).map(async (topic) => {\n   666→      const { data: sessionLinks } = await supabase\n   667→        .from('session_topics')\n   668→        .select('session_id')\n   669→        .eq('topic_id', topic.id);\n   670→\n   671→      let sessions: Array<{ id: string; template_type: string; status: string }> = [];\n   672→      if (sessionLinks && sessionLinks.length > 0) {\n   673→        const sessionIds = sessionLinks.map((l) => l.session_id);\n   674→        const { data: sessionsData } = await supabase\n   675→          .from('research_sessions')\n   676→          .select('id, template_type, status')\n   677→          .in('id', sessionIds);\n   678→        sessions = sessionsData || [];\n   679→      }\n   680→\n   681→      return {\n   682→        ...topic,\n   683→        sessions,\n   684→        session_count: sessions.length || topic.session_count || 0,\n   685→      } as TopicGroup;\n   686→    })\n   687→  );\n   688→\n   689→  return topicsWithSessions.filter((t) => t.session_count > 0);\n   690→}\n   691→\n   692→export async function getTopicHierarchy(): Promise<TopicGroup[]> {\n   693→  const { data, error } = await supabase\n   694→    .from('knowledge_topics')\n   695→    .select('*')\n   696→    .order('path');\n   697→\n   698→  if (error) {\n   699→    console.error('Error fetching topic hierarchy:', error);\n   700→    return [];\n   701→  }\n   702→  return (data || []) as TopicGroup[];\n   703→}\n   704→\n   705→// ============================================\n   706→// ENTITY QUERIES (for intermediate categorization)\n   707→// ============================================\n   708→\n   709→export interface EntityGroup {\n   710→  id: string;\n   711→  canonical_name: string;\n   712→  entity_type: string;\n   713→  aliases: string[];\n   714→  description?: string;\n   715→  mention_count: number;\n   716→  claim_count: number;\n   717→  session_ids: string[];\n   718→}\n   719→\n   720→export async function getEntitiesWithSessions(): Promise<EntityGroup[]> {\n   721→  // Get entities with high mention counts\n   722→  const { data: entities, error } = await supabase\n   723→    .from('knowledge_entities')\n   724→    .select('*')\n   725→    .order('mention_count', { ascending: false })\n   726→    .limit(100);\n   727→\n   728→  if (error) {\n   729→    console.error('Error fetching entities:', error);\n   730→    return [];\n   731→  }\n   732→\n   733→  // For each entity, find linked sessions via claims\n   734→  const entitiesWithSessions = await Promise.all(\n   735→    (entities || []).map(async (entity) => {\n   736→      // Get claims linked to this entity\n   737→      const { data: claimEntities } = await supabase\n   738→        .from('claim_entities')\n   739→        .select('claim_id')\n   740→        .eq('entity_id', entity.id);\n   741→\n   742→      if (!claimEntities || claimEntities.length === 0) {\n   743→        return { ...entity, session_ids: [] } as EntityGroup;\n   744→      }\n   745→\n   746→      const claimIds = claimEntities.map((ce) => ce.claim_id);\n   747→\n   748→      // Get sessions that originated these claims\n   749→      const { data: claims } = await supabase\n   750→        .from('knowledge_claims')\n   751→        .select('origin_session_id')\n   752→        .in('id', claimIds)\n   753→        .not('origin_session_id', 'is', null);\n   754→\n   755→      const sessionIds = [...new Set((claims || []).map((c) => c.origin_session_id).filter(Boolean))];\n   756→\n   757→      return {\n   758→        ...entity,\n   759→        session_ids: sessionIds,\n   760→      } as EntityGroup;\n   761→    })\n   762→  );\n   763→\n   764→  return entitiesWithSessions.filter((e) => e.session_ids.length > 0);\n   765→}\n   766→\n   767→export async function getEntitiesByType(entityType: string): Promise<EntityGroup[]> {\n   768→  const { data, error } = await supabase\n   769→    .from('knowledge_entities')\n   770→    .select('*')\n   771→    .eq('entity_type', entityType)\n   772→    .order('mention_count', { ascending: false })\n   773→    .limit(50);\n   774→\n   775→  if (error) {\n   776→    console.error('Error fetching entities by type:', error);\n   777→    return [];\n   778→  }\n   779→  return (data || []) as EntityGroup[];\n   780→}\n   781→\n   782→// ============================================\n   783→// FINDING TYPE AGGREGATION\n   784→// ============================================\n   785→\n   786→export interface FindingTypeCount {\n   787→  finding_type: string;\n   788→  count: number;\n   789→  avg_confidence: number;\n   790→}\n   791→\n   792→export async function getFindingTypeCounts(sessionId?: string): Promise<FindingTypeCount[]> {\n   793→  let query = supabase\n   794→    .from('research_findings')\n   795→    .select('finding_type, confidence_score');\n   796→\n   797→  if (sessionId) {\n   798→    query = query.eq('session_id', sessionId);\n   799→  }\n   800→\n   801→  const { data, error } = await query;\n   802→\n   803→  if (error) {\n   804→    console.error('Error fetching finding types:', error);\n   805→    return [];\n   806→  }\n   807→\n   808→  // Aggregate by finding_type\n   809→  const typeMap = new Map<string, { count: number; totalConfidence: number }>();\n   810→  (data || []).forEach((f) => {\n   811→    const current = typeMap.get(f.finding_type) || { count: 0, totalConfidence: 0 };\n   812→    typeMap.set(f.finding_type, {\n   813→      count: current.count + 1,\n   814→      totalConfidence: current.totalConfidence + (f.confidence_score || 0),\n   815→    });\n   816→  });\n   817→\n   818→  return Array.from(typeMap.entries()).map(([type, stats]) => ({\n   819→    finding_type: type,\n   820→    count: stats.count,\n   821→    avg_confidence: stats.count > 0 ? stats.totalConfidence / stats.count : 0,\n   822→  }));\n   823→}\n   824→\n   825→// ============================================\n   826→// REAL-TIME SUBSCRIPTIONS\n   827→// ============================================\n   828→\n   829→export function subscribeToSession(\n   830→  sessionId: string,\n   831→  onUpdate: (session: ResearchSession) => void\n   832→) {\n   833→  return supabase\n   834→    .channel(`session:${sessionId}`)\n   835→    .on(\n   836→      'postgres_changes',\n   837→      {\n   838→        event: 'UPDATE',\n   839→        schema: 'public',\n   840→        table: 'research_sessions',\n   841→        filter: `id=eq.${sessionId}`,\n   842→      },\n   843→      (payload) => {\n   844→        onUpdate(payload.new as ResearchSession);\n   845→      }\n   846→    )\n   847→    .subscribe();\n   848→}\n   849→\n   850→export function subscribeToFindings(\n   851→  sessionId: string,\n   852→  onInsert: (finding: ResearchFinding) => void\n   853→) {\n   854→  return supabase\n   855→    .channel(`findings:${sessionId}`)\n   856→    .on(\n   857→      'postgres_changes',\n   858→      {\n   859→        event: 'INSERT',\n   860→        schema: 'public',\n   861→        table: 'research_findings',\n   862→        filter: `session_id=eq.${sessionId}`,\n   863→      },\n   864→      (payload) => {\n   865→        onInsert(payload.new as ResearchFinding);\n   866→      }\n   867→    )\n   868→    .subscribe();\n   869→}\n   870→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"d184f0d2-244e-457f-8ea5-4627f2d647f1","uuid":"589dd73e-2cad-43ab-973f-61500996e352","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\lib\\supabase.ts","content":"import { createClient } from '@supabase/supabase-js';\nimport type {\n  ResearchSession,\n  ResearchFinding,\n  ResearchSource,\n  ResearchPerspective,\n  QueryDecomposition,\n  SubQuery,\n  FindingRelationship,\n  ResearchContradiction,\n  ResearchGap,\n  CausalChain,\n  FindingPerspective,\n  KnowledgeEntity,\n  ClaimRelationship,\n  SessionWithDetails,\n} from '@/src/types/research';\n\nconst supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL!;\nconst supabaseAnonKey = process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY!;\n\nexport const supabase = createClient(supabaseUrl, supabaseAnonKey);\n\n// ============================================\n// SESSION QUERIES\n// ============================================\n\n// Get all sessions (lightweight, for map visualization)\nexport async function getAllSessions(): Promise<ResearchSession[]> {\n  const { data, error } = await supabase\n    .from('research_sessions')\n    .select('*')\n    .order('created_at', { ascending: false });\n\n  if (error) {\n    console.error('Error fetching all sessions:', error);\n    return [];\n  }\n  return data || [];\n}\n\n// Get session counts by template type\nexport async function getSessionCountsByTemplate(): Promise<Record<string, number>> {\n  const { data, error } = await supabase\n    .from('research_sessions')\n    .select('template_type');\n\n  if (error) {\n    console.error('Error fetching session counts:', error);\n    return {};\n  }\n\n  const counts: Record<string, number> = {};\n  data?.forEach((s) => {\n    counts[s.template_type] = (counts[s.template_type] || 0) + 1;\n  });\n  return counts;\n}\n\nexport async function getSession(sessionId: string): Promise<ResearchSession | null> {\n  const { data, error } = await supabase\n    .from('research_sessions')\n    .select('*')\n    .eq('id', sessionId)\n    .single();\n\n  if (error) {\n    console.error('Error fetching session:', error);\n    return null;\n  }\n  return data;\n}\n\nexport async function getSessionWithDetails(sessionId: string): Promise<SessionWithDetails | null> {\n  const [\n    sessionResult,\n    findingsResult,\n    sourcesResult,\n    perspectivesResult,\n    decompositionResult,\n    relationshipsResult,\n    contradictionsResult,\n    gapsResult,\n    chainsResult,\n  ] = await Promise.all([\n    supabase.from('research_sessions').select('*').eq('id', sessionId).single(),\n    supabase.from('research_findings').select('*').eq('session_id', sessionId).order('created_at'),\n    supabase.from('research_sources').select('*').eq('session_id', sessionId),\n    supabase.from('research_perspectives').select('*').eq('session_id', sessionId),\n    supabase.from('query_decompositions').select('*').eq('session_id', sessionId).single(),\n    supabase.from('finding_relationships').select('*').eq('session_id', sessionId),\n    supabase.from('research_contradictions').select('*').eq('session_id', sessionId),\n    supabase.from('research_gaps').select('*').eq('session_id', sessionId).order('priority'),\n    supabase.from('causal_chains').select('*').eq('session_id', sessionId),\n  ]);\n\n  if (sessionResult.error) {\n    console.error('Error fetching session:', sessionResult.error);\n    return null;\n  }\n\n  let decomposition: (QueryDecomposition & { sub_queries: SubQuery[] }) | undefined;\n  if (decompositionResult.data) {\n    const { data: subQueries } = await supabase\n      .from('sub_queries')\n      .select('*')\n      .eq('decomposition_id', decompositionResult.data.id)\n      .order('batch_order');\n    decomposition = {\n      ...decompositionResult.data,\n      sub_queries: subQueries || [],\n    };\n  }\n\n  return {\n    ...sessionResult.data,\n    findings: findingsResult.data || [],\n    sources: sourcesResult.data || [],\n    perspectives: perspectivesResult.data || [],\n    decomposition,\n    relationships: relationshipsResult.data || [],\n    contradictions: contradictionsResult.data || [],\n    gaps: gapsResult.data || [],\n    causal_chains: chainsResult.data || [],\n  };\n}\n\n// ============================================\n// FINDINGS QUERIES\n// ============================================\n\nexport async function getFindings(sessionId: string): Promise<ResearchFinding[]> {\n  const { data, error } = await supabase\n    .from('research_findings')\n    .select('*')\n    .eq('session_id', sessionId)\n    .order('created_at');\n\n  if (error) {\n    console.error('Error fetching findings:', error);\n    return [];\n  }\n  return data || [];\n}\n\nexport async function getFindingWithRelationships(findingId: string) {\n  const [findingResult, relationshipsResult, perspectivesResult] = await Promise.all([\n    supabase.from('research_findings').select('*').eq('id', findingId).single(),\n    supabase\n      .from('finding_relationships')\n      .select('*')\n      .or(`source_finding_id.eq.${findingId},target_finding_id.eq.${findingId}`),\n    supabase.from('finding_perspectives').select('*').eq('finding_id', findingId),\n  ]);\n\n  return {\n    finding: findingResult.data,\n    relationships: relationshipsResult.data || [],\n    perspectives: perspectivesResult.data || [],\n  };\n}\n\n// ============================================\n// SOURCES QUERIES\n// ============================================\n\nexport async function getSources(sessionId: string): Promise<ResearchSource[]> {\n  const { data, error } = await supabase\n    .from('research_sources')\n    .select('*')\n    .eq('session_id', sessionId)\n    .order('credibility_score', { ascending: false });\n\n  if (error) {\n    console.error('Error fetching sources:', error);\n    return [];\n  }\n  return data || [];\n}\n\n// ============================================\n// PERSPECTIVES QUERIES\n// ============================================\n\nexport async function getPerspectives(sessionId: string): Promise<ResearchPerspective[]> {\n  const { data, error } = await supabase\n    .from('research_perspectives')\n    .select('*')\n    .eq('session_id', sessionId);\n\n  if (error) {\n    console.error('Error fetching perspectives:', error);\n    return [];\n  }\n  return data || [];\n}\n\nexport async function getFindingPerspectives(findingId: string): Promise<FindingPerspective[]> {\n  const { data, error } = await supabase\n    .from('finding_perspectives')\n    .select('*')\n    .eq('finding_id', findingId);\n\n  if (error) {\n    console.error('Error fetching finding perspectives:', error);\n    return [];\n  }\n  return data || [];\n}\n\n// ============================================\n// RELATIONSHIPS QUERIES\n// ============================================\n\nexport async function getRelationships(sessionId: string): Promise<FindingRelationship[]> {\n  const { data, error } = await supabase\n    .from('finding_relationships')\n    .select('*')\n    .eq('session_id', sessionId);\n\n  if (error) {\n    console.error('Error fetching relationships:', error);\n    return [];\n  }\n  return data || [];\n}\n\nexport async function getContradictions(sessionId: string): Promise<ResearchContradiction[]> {\n  const { data, error } = await supabase\n    .from('research_contradictions')\n    .select('*')\n    .eq('session_id', sessionId);\n\n  if (error) {\n    console.error('Error fetching contradictions:', error);\n    return [];\n  }\n  return data || [];\n}\n\nexport async function getCausalChains(sessionId: string): Promise<CausalChain[]> {\n  const { data, error } = await supabase\n    .from('causal_chains')\n    .select('*')\n    .eq('session_id', sessionId);\n\n  if (error) {\n    console.error('Error fetching causal chains:', error);\n    return [];\n  }\n  return data || [];\n}\n\n// ============================================\n// GAPS QUERIES\n// ============================================\n\nexport async function getGaps(sessionId: string): Promise<ResearchGap[]> {\n  const { data, error } = await supabase\n    .from('research_gaps')\n    .select('*')\n    .eq('session_id', sessionId)\n    .order('priority');\n\n  if (error) {\n    console.error('Error fetching gaps:', error);\n    return [];\n  }\n  return data || [];\n}\n\n// ============================================\n// ENTITIES QUERIES\n// ============================================\n\nexport async function getEntitiesForSession(sessionId: string): Promise<KnowledgeEntity[]> {\n  // Get all findings for session, then get linked entities\n  const { data: findings } = await supabase\n    .from('research_findings')\n    .select('knowledge_claim_id')\n    .eq('session_id', sessionId)\n    .not('knowledge_claim_id', 'is', null);\n\n  if (!findings || findings.length === 0) return [];\n\n  const claimIds = findings.map((f) => f.knowledge_claim_id).filter(Boolean);\n\n  const { data: claimEntities } = await supabase\n    .from('claim_entities')\n    .select('entity_id')\n    .in('claim_id', claimIds);\n\n  if (!claimEntities || claimEntities.length === 0) return [];\n\n  const entityIds = [...new Set(claimEntities.map((ce) => ce.entity_id))];\n\n  const { data: entities, error } = await supabase\n    .from('knowledge_entities')\n    .select('*')\n    .in('id', entityIds);\n\n  if (error) {\n    console.error('Error fetching entities:', error);\n    return [];\n  }\n  return entities || [];\n}\n\n// ============================================\n// CLAIM RELATIONSHIPS QUERIES\n// ============================================\n\nexport async function getClaimRelationships(claimIds: string[]): Promise<ClaimRelationship[]> {\n  if (claimIds.length === 0) return [];\n\n  const { data, error } = await supabase\n    .from('claim_relationships')\n    .select('*')\n    .or(`source_claim_id.in.(${claimIds.join(',')}),target_claim_id.in.(${claimIds.join(',')})`);\n\n  if (error) {\n    console.error('Error fetching claim relationships:', error);\n    return [];\n  }\n  return data || [];\n}\n\n// ============================================\n// DECOMPOSITION QUERIES\n// ============================================\n\nexport async function getDecomposition(sessionId: string): Promise<QueryDecomposition | null> {\n  const { data, error } = await supabase\n    .from('query_decompositions')\n    .select('*')\n    .eq('session_id', sessionId)\n    .single();\n\n  if (error) {\n    console.error('Error fetching decomposition:', error);\n    return null;\n  }\n  return data;\n}\n\nexport async function getSubQueries(decompositionId: string): Promise<SubQuery[]> {\n  const { data, error } = await supabase\n    .from('sub_queries')\n    .select('*')\n    .eq('decomposition_id', decompositionId)\n    .order('batch_order');\n\n  if (error) {\n    console.error('Error fetching sub-queries:', error);\n    return [];\n  }\n  return data || [];\n}\n\n// ============================================\n// WRITE OPERATIONS - Research Persistence\n// Uses existing research_sessions, research_findings,\n// research_sources, research_perspectives tables\n// ============================================\n\nexport async function createActorSession(\n  session: {\n    id: string;\n    query: string;\n    template: string;\n    status: string;\n    granularity: string;\n    max_searches: number;\n    user_email?: string;\n    progress_phase?: string;\n    progress_percent?: number;\n  }\n): Promise<{ id: string } | null> {\n  const { data, error } = await supabase\n    .from('research_sessions')\n    .insert({\n      id: session.id,\n      title: `Research: ${session.query.slice(0, 50)}...`,\n      query: session.query,\n      template_type: session.template,\n      status: session.status === 'running' ? 'searching' : session.status,\n      parameters: {\n        granularity: session.granularity,\n        max_searches: session.max_searches,\n        user_email: session.user_email,\n        progress_phase: session.progress_phase,\n        progress_percent: session.progress_percent,\n      },\n    })\n    .select('id')\n    .single();\n\n  if (error) {\n    console.error('Error creating research session:', error);\n    return null;\n  }\n  return data;\n}\n\nexport async function updateActorSession(\n  sessionId: string,\n  updates: {\n    status?: string;\n    progress_phase?: string;\n    progress_percent?: number;\n    error_message?: string;\n    completed_at?: string;\n  }\n): Promise<boolean> {\n  // Map status to existing schema values\n  const statusMap: Record<string, string> = {\n    running: 'searching',\n    completed: 'completed',\n    failed: 'failed',\n  };\n\n  const updateData: Record<string, unknown> = {};\n\n  if (updates.status) {\n    updateData.status = statusMap[updates.status] || updates.status;\n  }\n\n  if (updates.completed_at) {\n    updateData.completed_at = updates.completed_at;\n  }\n\n  // Store progress info in parameters JSONB\n  if (updates.progress_phase || updates.progress_percent !== undefined || updates.error_message) {\n    // First get current parameters\n    const { data: current } = await supabase\n      .from('research_sessions')\n      .select('parameters')\n      .eq('id', sessionId)\n      .single();\n\n    const currentParams = (current?.parameters as Record<string, unknown>) || {};\n    updateData.parameters = {\n      ...currentParams,\n      ...(updates.progress_phase && { progress_phase: updates.progress_phase }),\n      ...(updates.progress_percent !== undefined && { progress_percent: updates.progress_percent }),\n      ...(updates.error_message && { error_message: updates.error_message }),\n    };\n  }\n\n  const { error } = await supabase\n    .from('research_sessions')\n    .update(updateData)\n    .eq('id', sessionId);\n\n  if (error) {\n    console.error('Error updating research session:', error);\n    return false;\n  }\n  return true;\n}\n\nexport async function saveActorFindings(\n  sessionId: string,\n  findings: Array<{\n    finding_id: string;\n    finding_type: string;\n    content: string;\n    summary?: string;\n    confidence_score: number;\n    temporal_context: string;\n    extracted_data?: Record<string, unknown>;\n  }>\n): Promise<boolean> {\n  if (findings.length === 0) return true;\n\n  const { error } = await supabase\n    .from('research_findings')\n    .insert(findings.map(f => ({\n      session_id: sessionId,\n      finding_type: f.finding_type,\n      content: f.content,\n      summary: f.summary,\n      confidence_score: f.confidence_score,\n      temporal_context: f.temporal_context,\n      extracted_data: f.extracted_data,\n    })));\n\n  if (error) {\n    console.error('Error saving research findings:', error);\n    return false;\n  }\n  return true;\n}\n\nexport async function saveActorSources(\n  sessionId: string,\n  sources: Array<{\n    url: string;\n    title: string;\n    domain: string;\n    snippet?: string;\n    credibility_score?: number;\n    credibility_label?: string;\n  }>\n): Promise<boolean> {\n  if (sources.length === 0) return true;\n\n  // Generate URL hash for deduplication\n  const hashUrl = (url: string) => {\n    let hash = 0;\n    for (let i = 0; i < url.length; i++) {\n      const char = url.charCodeAt(i);\n      hash = ((hash << 5) - hash) + char;\n      hash = hash & hash;\n    }\n    return hash.toString(16);\n  };\n\n  const { error } = await supabase\n    .from('research_sources')\n    .insert(sources.map(s => ({\n      session_id: sessionId,\n      url: s.url,\n      url_hash: hashUrl(s.url),\n      title: s.title,\n      domain: s.domain,\n      snippet: s.snippet,\n      credibility_score: s.credibility_score,\n      credibility_factors: s.credibility_label ? { label: s.credibility_label } : null,\n    })));\n\n  if (error) {\n    console.error('Error saving research sources:', error);\n    return false;\n  }\n  return true;\n}\n\nexport async function saveActorPerspectives(\n  sessionId: string,\n  perspectives: Array<{\n    perspective_type: string;\n    analysis_text: string;\n    key_insights: string[];\n    recommendations: string[];\n    warnings: string[];\n    confidence: number;\n  }>\n): Promise<boolean> {\n  if (perspectives.length === 0) return true;\n\n  // Map custom perspective types to schema-allowed values\n  const perspectiveTypeMap: Record<string, string> = {\n    forensic_financial: 'financial',\n    power_network: 'network',\n    psychological_behavioral: 'psychological',\n    legal_liability: 'political',\n    geopolitical_strategic: 'political',\n    institutional_investor: 'financial',\n    short_seller: 'financial',\n    quantitative_risk: 'financial',\n    activist_investor: 'financial',\n    macro_strategist: 'economic',\n    strategy_consultant: 'economic',\n    industry_insider: 'economic',\n    litigation_strategist: 'political',\n    regulatory_expert: 'political',\n  };\n\n  const { error } = await supabase\n    .from('research_perspectives')\n    .insert(perspectives.map(p => ({\n      session_id: sessionId,\n      perspective_type: perspectiveTypeMap[p.perspective_type] || 'economic',\n      analysis_text: p.analysis_text,\n      key_insights: p.key_insights,\n      recommendations: p.recommendations,\n      warnings: p.warnings,\n      confidence: p.confidence,\n      specialized_data: {\n        original_type: p.perspective_type,\n      },\n    })));\n\n  if (error) {\n    console.error('Error saving research perspectives:', error);\n    return false;\n  }\n  return true;\n}\n\nexport async function saveActorReport(\n  sessionId: string,\n  reportMarkdown: string,\n  costSummary: {\n    total_tokens: number;\n    total_cost_usd: number;\n  }\n): Promise<boolean> {\n  // Get current parameters and update with report info\n  const { data: current } = await supabase\n    .from('research_sessions')\n    .select('parameters')\n    .eq('id', sessionId)\n    .single();\n\n  const currentParams = (current?.parameters as Record<string, unknown>) || {};\n\n  const { error } = await supabase\n    .from('research_sessions')\n    .update({\n      status: 'completed',\n      completed_at: new Date().toISOString(),\n      parameters: {\n        ...currentParams,\n        report_markdown: reportMarkdown,\n        total_tokens: costSummary.total_tokens,\n        total_cost_usd: costSummary.total_cost_usd,\n      },\n    })\n    .eq('id', sessionId);\n\n  if (error) {\n    console.error('Error saving research report:', error);\n    return false;\n  }\n  return true;\n}\n\n// ============================================\n// TOPIC QUERIES (for intermediate categorization)\n// ============================================\n\nexport interface TopicGroup {\n  id: string;\n  name: string;\n  slug: string;\n  description?: string;\n  topic_type?: string;\n  parent_id?: string;\n  session_count: number;\n  finding_count: number;\n  entity_count: number;\n  sessions?: Array<{\n    id: string;\n    template_type: string;\n    status: string;\n  }>;\n}\n\nexport async function getTopicsWithSessionCounts(): Promise<TopicGroup[]> {\n  // Get topics with their linked sessions\n  const { data: topics, error } = await supabase\n    .from('knowledge_topics')\n    .select('*')\n    .order('session_count', { ascending: false });\n\n  if (error) {\n    console.error('Error fetching topics:', error);\n    return [];\n  }\n\n  // For each topic, get linked sessions\n  const topicsWithSessions = await Promise.all(\n    (topics || []).map(async (topic) => {\n      const { data: sessionLinks } = await supabase\n        .from('session_topics')\n        .select('session_id')\n        .eq('topic_id', topic.id);\n\n      let sessions: Array<{ id: string; template_type: string; status: string }> = [];\n      if (sessionLinks && sessionLinks.length > 0) {\n        const sessionIds = sessionLinks.map((l) => l.session_id);\n        const { data: sessionsData } = await supabase\n          .from('research_sessions')\n          .select('id, template_type, status')\n          .in('id', sessionIds);\n        sessions = sessionsData || [];\n      }\n\n      return {\n        ...topic,\n        sessions,\n        session_count: sessions.length || topic.session_count || 0,\n      } as TopicGroup;\n    })\n  );\n\n  return topicsWithSessions.filter((t) => t.session_count > 0);\n}\n\nexport async function getTopicHierarchy(): Promise<TopicGroup[]> {\n  const { data, error } = await supabase\n    .from('knowledge_topics')\n    .select('*')\n    .order('path');\n\n  if (error) {\n    console.error('Error fetching topic hierarchy:', error);\n    return [];\n  }\n  return (data || []) as TopicGroup[];\n}\n\n// ============================================\n// ENTITY QUERIES (for intermediate categorization)\n// ============================================\n\nexport interface EntityGroup {\n  id: string;\n  canonical_name: string;\n  entity_type: string;\n  aliases: string[];\n  description?: string;\n  mention_count: number;\n  claim_count: number;\n  session_ids: string[];\n}\n\nexport async function getEntitiesWithSessions(): Promise<EntityGroup[]> {\n  // Get entities with high mention counts\n  const { data: entities, error } = await supabase\n    .from('knowledge_entities')\n    .select('*')\n    .order('mention_count', { ascending: false })\n    .limit(100);\n\n  if (error) {\n    console.error('Error fetching entities:', error);\n    return [];\n  }\n\n  // For each entity, find linked sessions via claims\n  const entitiesWithSessions = await Promise.all(\n    (entities || []).map(async (entity) => {\n      // Get claims linked to this entity\n      const { data: claimEntities } = await supabase\n        .from('claim_entities')\n        .select('claim_id')\n        .eq('entity_id', entity.id);\n\n      if (!claimEntities || claimEntities.length === 0) {\n        return { ...entity, session_ids: [] } as EntityGroup;\n      }\n\n      const claimIds = claimEntities.map((ce) => ce.claim_id);\n\n      // Get sessions that originated these claims\n      const { data: claims } = await supabase\n        .from('knowledge_claims')\n        .select('origin_session_id')\n        .in('id', claimIds)\n        .not('origin_session_id', 'is', null);\n\n      const sessionIds = [...new Set((claims || []).map((c) => c.origin_session_id).filter(Boolean))];\n\n      return {\n        ...entity,\n        session_ids: sessionIds,\n      } as EntityGroup;\n    })\n  );\n\n  return entitiesWithSessions.filter((e) => e.session_ids.length > 0);\n}\n\nexport async function getEntitiesByType(entityType: string): Promise<EntityGroup[]> {\n  const { data, error } = await supabase\n    .from('knowledge_entities')\n    .select('*')\n    .eq('entity_type', entityType)\n    .order('mention_count', { ascending: false })\n    .limit(50);\n\n  if (error) {\n    console.error('Error fetching entities by type:', error);\n    return [];\n  }\n  return (data || []) as EntityGroup[];\n}\n\n// ============================================\n// FINDING TYPE AGGREGATION\n// ============================================\n\nexport interface FindingTypeCount {\n  finding_type: string;\n  count: number;\n  avg_confidence: number;\n}\n\nexport async function getFindingTypeCounts(sessionId?: string): Promise<FindingTypeCount[]> {\n  let query = supabase\n    .from('research_findings')\n    .select('finding_type, confidence_score');\n\n  if (sessionId) {\n    query = query.eq('session_id', sessionId);\n  }\n\n  const { data, error } = await query;\n\n  if (error) {\n    console.error('Error fetching finding types:', error);\n    return [];\n  }\n\n  // Aggregate by finding_type\n  const typeMap = new Map<string, { count: number; totalConfidence: number }>();\n  (data || []).forEach((f) => {\n    const current = typeMap.get(f.finding_type) || { count: 0, totalConfidence: 0 };\n    typeMap.set(f.finding_type, {\n      count: current.count + 1,\n      totalConfidence: current.totalConfidence + (f.confidence_score || 0),\n    });\n  });\n\n  return Array.from(typeMap.entries()).map(([type, stats]) => ({\n    finding_type: type,\n    count: stats.count,\n    avg_confidence: stats.count > 0 ? stats.totalConfidence / stats.count : 0,\n  }));\n}\n\n// ============================================\n// REAL-TIME SUBSCRIPTIONS\n// ============================================\n\nexport function subscribeToSession(\n  sessionId: string,\n  onUpdate: (session: ResearchSession) => void\n) {\n  return supabase\n    .channel(`session:${sessionId}`)\n    .on(\n      'postgres_changes',\n      {\n        event: 'UPDATE',\n        schema: 'public',\n        table: 'research_sessions',\n        filter: `id=eq.${sessionId}`,\n      },\n      (payload) => {\n        onUpdate(payload.new as ResearchSession);\n      }\n    )\n    .subscribe();\n}\n\nexport function subscribeToFindings(\n  sessionId: string,\n  onInsert: (finding: ResearchFinding) => void\n) {\n  return supabase\n    .channel(`findings:${sessionId}`)\n    .on(\n      'postgres_changes',\n      {\n        event: 'INSERT',\n        schema: 'public',\n        table: 'research_findings',\n        filter: `session_id=eq.${sessionId}`,\n      },\n      (payload) => {\n        onInsert(payload.new as ResearchFinding);\n      }\n    )\n    .subscribe();\n}\n","numLines":870,"startLine":1,"totalLines":870}}}
