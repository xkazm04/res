[2026-02-04T00:46:26.377Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KEUZe5t6J5abJ84jDXoLo3","type":"tool_result","content":"     1→/**\n     2→ * Type Mapping Utilities\n     3→ *\n     4→ * Maps template-specific finding and perspective types to Supabase schema types.\n     5→ * Preserves original types in extracted_data/specialized_data for template context.\n     6→ */\n     7→\n     8→// ============================================\n     9→// FINDING TYPE MAPPING\n    10→// ============================================\n    11→\n    12→/**\n    13→ * Maps template-specific finding types to Supabase schema-allowed types.\n    14→ *\n    15→ * Schema allows: 'fact', 'claim', 'event', 'actor', 'relationship', 'pattern', 'gap', 'evidence'\n    16→ */\n    17→export const FINDING_TYPE_MAP: Record<string, string> = {\n    18→  // Tech market template types\n    19→  tech_trend: 'pattern',\n    20→  market_trend: 'pattern',\n    21→  adoption_pattern: 'pattern',\n    22→  financial_metric: 'fact',\n    23→  prediction: 'claim',\n    24→  red_flag: 'evidence',\n    25→\n    26→  // Financial template types\n    27→  bullish_signal: 'evidence',\n    28→  bearish_signal: 'evidence',\n    29→  risk: 'pattern',\n    30→  opportunity: 'pattern',\n    31→  catalyst: 'event',\n    32→  valuation_metric: 'fact',\n    33→\n    34→  // Competitive template types\n    35→  competitive_advantage: 'pattern',\n    36→  market_position: 'fact',\n    37→  strategic_move: 'event',\n    38→  weakness: 'gap',\n    39→  threat: 'evidence',\n    40→\n    41→  // Investigative template types\n    42→  actor: 'actor',\n    43→  event: 'event',\n    44→  relationship: 'relationship',\n    45→  financial: 'fact',\n    46→  evidence: 'evidence',\n    47→  pattern: 'pattern',\n    48→  gap: 'gap',\n    49→  connection: 'relationship',\n    50→  transaction: 'event',\n    51→  allegation: 'claim',\n    52→\n    53→  // Due diligence template types\n    54→  risk_factor: 'evidence',\n    55→  compliance_issue: 'evidence',\n    56→  financial_health: 'fact',\n    57→  management_concern: 'evidence',\n    58→  legal_issue: 'evidence',\n    59→  operational_risk: 'pattern',\n    60→\n    61→  // Legal template types\n    62→  legal_precedent: 'fact',\n    63→  ruling: 'event',\n    64→  legal_risk: 'evidence',\n    65→  regulatory_change: 'event',\n    66→  compliance_requirement: 'fact',\n    67→  liability: 'evidence',\n    68→\n    69→  // Contract template types\n    70→  contract_term: 'fact',\n    71→  obligation: 'fact',\n    72→  risk_clause: 'evidence',\n    73→  favorable_term: 'fact',\n    74→  unfavorable_term: 'evidence',\n    75→  missing_protection: 'gap',\n    76→\n    77→  // Reputation template types\n    78→  sentiment: 'pattern',\n    79→  controversy: 'event',\n    80→  positive_coverage: 'evidence',\n    81→  negative_coverage: 'evidence',\n    82→  brand_perception: 'pattern',\n    83→\n    84→  // Purchase decision template types\n    85→  product_feature: 'fact',\n    86→  user_review: 'evidence',\n    87→  price_comparison: 'fact',\n    88→  alternative: 'fact',\n    89→  deal_breaker: 'evidence',\n    90→  recommendation: 'claim',\n    91→\n    92→  // Understanding template types\n    93→  concept: 'fact',\n    94→  explanation: 'fact',\n    95→  example: 'evidence',\n    96→  misconception: 'gap',\n    97→  nuance: 'pattern',\n    98→\n    99→  // Passthrough types (already schema-compliant)\n   100→  fact: 'fact',\n   101→  claim: 'claim',\n   102→\n   103→  // Meta-analytical finding types (deep analysis)\n   104→  narrative_frame: 'pattern', // Framing patterns map to pattern\n   105→  coverage_asymmetry: 'evidence', // Differential coverage is evidence\n   106→  incentive_alignment: 'relationship', // Incentives reveal relationships\n   107→  suspicious_timing: 'event', // Timing is event-related\n   108→  historical_parallel: 'pattern', // Historical patterns\n   109→  network_inference: 'relationship', // Inferred relationships\n   110→  omission: 'gap', // What's NOT reported is a gap\n   111→  talking_point_origin: 'evidence', // First appearance of narratives\n   112→  funding_trace: 'fact', // Money behind research/reports (financial)\n   113→  regulatory_capture: 'relationship', // Regulatory relationships\n   114→  narrative_vs_reality: 'evidence', // Discrepancy between narrative and data\n   115→  smart_money_signal: 'evidence', // Sophisticated investor actions\n   116→  hype_reality_gap: 'evidence', // Marketing vs technical substance\n   117→};\n   118→\n   119→/**\n   120→ * Maps a template-specific finding type to schema-allowed type.\n   121→ *\n   122→ * @param originalType - The original finding type from template output\n   123→ * @returns Object with schemaType for database and originalType for tracking\n   124→ */\n   125→export function mapFindingType(originalType: string): {\n   126→  schemaType: string;\n   127→  originalType: string;\n   128→} {\n   129→  const schemaType = FINDING_TYPE_MAP[originalType] || 'fact';\n   130→  return { schemaType, originalType };\n   131→}\n   132→\n   133→// ============================================\n   134→// PERSPECTIVE TYPE MAPPING\n   135→// ============================================\n   136→\n   137→/**\n   138→ * Maps custom perspective types to Supabase schema-allowed values.\n   139→ *\n   140→ * Schema allows: 'historical', 'political', 'economic', 'psychological', 'military',\n   141→ *                'social', 'technological', 'financial', 'journalist', 'conspirator', 'network'\n   142→ */\n   143→export const PERSPECTIVE_TYPE_MAP: Record<string, string> = {\n   144→  // Investigative perspectives (from Python)\n   145→  forensic_financial: 'financial',\n   146→  power_network: 'network',\n   147→  psychological_behavioral: 'psychological',\n   148→  geopolitical_strategic: 'political',\n   149→  legal_liability: 'political',\n   150→\n   151→  // Financial/Investment perspectives (from Python)\n   152→  institutional_investor: 'financial',\n   153→  short_seller: 'financial',\n   154→  quantitative_risk: 'financial',\n   155→  activist_investor: 'financial',\n   156→  macro_strategist: 'economic',\n   157→\n   158→  // Competitive analysis (from Python)\n   159→  strategy_consultant: 'economic',\n   160→  industry_insider: 'economic',\n   161→\n   162→  // Legal perspectives (from Python)\n   163→  regulatory_expert: 'political',\n   164→  litigation_strategist: 'political',\n   165→\n   166→  // Tech market perspectives (from Python)\n   167→  venture_capitalist: 'financial',\n   168→  startup_founder: 'technological',\n   169→  product_manager: 'technological',\n   170→  developer_advocate: 'technological',\n   171→  open_source_maintainer: 'technological',\n   172→  devrel_engineer: 'technological',\n   173→  senior_engineer: 'technological',\n   174→  platform_engineer: 'technological',\n   175→\n   176→  // Contract analysis (from Python)\n   177→  contract_auditor: 'financial',\n   178→  procurement_investigator: 'political',\n   179→  forensic_accountant: 'financial',\n   180→  regulatory_compliance: 'political',\n   181→  industry_benchmarker: 'economic',\n   182→\n   183→  // Additional perspectives for other templates\n   184→  market_analyst: 'economic',\n   185→  risk_analyst: 'financial',\n   186→  compliance_officer: 'political',\n   187→  consumer_advocate: 'social',\n   188→  industry_expert: 'economic',\n   189→  technical_reviewer: 'technological',\n   190→  security_researcher: 'technological',\n   191→  data_scientist: 'technological',\n   192→  ux_researcher: 'social',\n   193→  business_analyst: 'economic',\n   194→  investment_banker: 'financial',\n   195→  hedge_fund_manager: 'financial',\n   196→  retail_investor: 'financial',\n   197→  financial_journalist: 'journalist',\n   198→  investigative_journalist: 'journalist',\n   199→  academic_researcher: 'historical',\n   200→  policy_analyst: 'political',\n   201→  government_official: 'political',\n   202→  labor_economist: 'economic',\n   203→  environmental_analyst: 'social',\n   204→  ethics_researcher: 'social',\n   205→  historian: 'historical',\n   206→  sociologist: 'social',\n   207→  psychologist: 'psychological',\n   208→  legal_scholar: 'political',\n   209→  defense_analyst: 'military',\n   210→  intelligence_analyst: 'military',\n   211→  conspiracy_theorist: 'conspirator',\n   212→  whistleblower: 'journalist',\n   213→  insider: 'network',\n   214→  connected_source: 'network',\n   215→\n   216→  // New analytical perspectives (deep analysis)\n   217→  narrative_analyst: 'journalist', // Narrative analysis is journalism-adjacent\n   218→  incentive_mapper: 'financial', // Incentive mapping is financial analysis\n   219→  historical_pattern: 'historical', // Historical pattern recognition\n   220→  omission_detective: 'journalist', // Omission detection is investigative journalism\n   221→  contrarian_synthesizer: 'financial', // Contrarian views (like short_seller)\n   222→};\n   223→\n   224→/**\n   225→ * Valid perspective types allowed by the Supabase schema.\n   226→ */\n   227→export const VALID_PERSPECTIVE_TYPES = new Set([\n   228→  'historical',\n   229→  'political',\n   230→  'economic',\n   231→  'psychological',\n   232→  'military',\n   233→  'social',\n   234→  'technological',\n   235→  'financial',\n   236→  'journalist',\n   237→  'conspirator',\n   238→  'network',\n   239→]);\n   240→\n   241→/**\n   242→ * Maps a template-specific perspective type to schema-allowed type.\n   243→ *\n   244→ * @param originalType - The original perspective type from template output\n   245→ * @returns Object with schemaType for database and originalType for tracking\n   246→ */\n   247→export function mapPerspectiveType(originalType: string): {\n   248→  schemaType: string;\n   249→  originalType: string;\n   250→} {\n   251→  // If already a valid schema type, use it directly\n   252→  if (VALID_PERSPECTIVE_TYPES.has(originalType)) {\n   253→    return { schemaType: originalType, originalType };\n   254→  }\n   255→\n   256→  const schemaType = PERSPECTIVE_TYPE_MAP[originalType] || 'economic';\n   257→  return { schemaType, originalType };\n   258→}\n   259→\n   260→// ============================================\n   261→// TEMPORAL CONTEXT MAPPING\n   262→// ============================================\n   263→\n   264→/**\n   265→ * Maps template temporal contexts to Supabase schema-allowed values.\n   266→ *\n   267→ * Schema allows: 'past', 'present', 'ongoing', 'prediction'\n   268→ */\n   269→const TEMPORAL_CONTEXT_MAP: Record<string, string> = {\n   270→  historical: 'past',\n   271→  current: 'present',\n   272→  predicted: 'prediction',\n   273→  future: 'prediction',\n   274→  recent: 'present',\n   275→  // Passthrough values\n   276→  past: 'past',\n   277→  present: 'present',\n   278→  ongoing: 'ongoing',\n   279→  prediction: 'prediction',\n   280→};\n   281→\n   282→/**\n   283→ * Maps temporal context to schema-allowed values.\n   284→ *\n   285→ * @param context - The original temporal context from template output\n   286→ * @returns Schema-allowed temporal context string\n   287→ */\n   288→export function mapTemporalContext(context: string | undefined): string {\n   289→  if (!context) return 'present';\n   290→  return TEMPORAL_CONTEXT_MAP[context] || context || 'present';\n   291→}\n   292→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"d184f0d2-244e-457f-8ea5-4627f2d647f1","uuid":"a277a5fd-7920-40cf-8d88-852edc5289af","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\templates\\persistence\\typeMapping.ts","content":"/**\n * Type Mapping Utilities\n *\n * Maps template-specific finding and perspective types to Supabase schema types.\n * Preserves original types in extracted_data/specialized_data for template context.\n */\n\n// ============================================\n// FINDING TYPE MAPPING\n// ============================================\n\n/**\n * Maps template-specific finding types to Supabase schema-allowed types.\n *\n * Schema allows: 'fact', 'claim', 'event', 'actor', 'relationship', 'pattern', 'gap', 'evidence'\n */\nexport const FINDING_TYPE_MAP: Record<string, string> = {\n  // Tech market template types\n  tech_trend: 'pattern',\n  market_trend: 'pattern',\n  adoption_pattern: 'pattern',\n  financial_metric: 'fact',\n  prediction: 'claim',\n  red_flag: 'evidence',\n\n  // Financial template types\n  bullish_signal: 'evidence',\n  bearish_signal: 'evidence',\n  risk: 'pattern',\n  opportunity: 'pattern',\n  catalyst: 'event',\n  valuation_metric: 'fact',\n\n  // Competitive template types\n  competitive_advantage: 'pattern',\n  market_position: 'fact',\n  strategic_move: 'event',\n  weakness: 'gap',\n  threat: 'evidence',\n\n  // Investigative template types\n  actor: 'actor',\n  event: 'event',\n  relationship: 'relationship',\n  financial: 'fact',\n  evidence: 'evidence',\n  pattern: 'pattern',\n  gap: 'gap',\n  connection: 'relationship',\n  transaction: 'event',\n  allegation: 'claim',\n\n  // Due diligence template types\n  risk_factor: 'evidence',\n  compliance_issue: 'evidence',\n  financial_health: 'fact',\n  management_concern: 'evidence',\n  legal_issue: 'evidence',\n  operational_risk: 'pattern',\n\n  // Legal template types\n  legal_precedent: 'fact',\n  ruling: 'event',\n  legal_risk: 'evidence',\n  regulatory_change: 'event',\n  compliance_requirement: 'fact',\n  liability: 'evidence',\n\n  // Contract template types\n  contract_term: 'fact',\n  obligation: 'fact',\n  risk_clause: 'evidence',\n  favorable_term: 'fact',\n  unfavorable_term: 'evidence',\n  missing_protection: 'gap',\n\n  // Reputation template types\n  sentiment: 'pattern',\n  controversy: 'event',\n  positive_coverage: 'evidence',\n  negative_coverage: 'evidence',\n  brand_perception: 'pattern',\n\n  // Purchase decision template types\n  product_feature: 'fact',\n  user_review: 'evidence',\n  price_comparison: 'fact',\n  alternative: 'fact',\n  deal_breaker: 'evidence',\n  recommendation: 'claim',\n\n  // Understanding template types\n  concept: 'fact',\n  explanation: 'fact',\n  example: 'evidence',\n  misconception: 'gap',\n  nuance: 'pattern',\n\n  // Passthrough types (already schema-compliant)\n  fact: 'fact',\n  claim: 'claim',\n\n  // Meta-analytical finding types (deep analysis)\n  narrative_frame: 'pattern', // Framing patterns map to pattern\n  coverage_asymmetry: 'evidence', // Differential coverage is evidence\n  incentive_alignment: 'relationship', // Incentives reveal relationships\n  suspicious_timing: 'event', // Timing is event-related\n  historical_parallel: 'pattern', // Historical patterns\n  network_inference: 'relationship', // Inferred relationships\n  omission: 'gap', // What's NOT reported is a gap\n  talking_point_origin: 'evidence', // First appearance of narratives\n  funding_trace: 'fact', // Money behind research/reports (financial)\n  regulatory_capture: 'relationship', // Regulatory relationships\n  narrative_vs_reality: 'evidence', // Discrepancy between narrative and data\n  smart_money_signal: 'evidence', // Sophisticated investor actions\n  hype_reality_gap: 'evidence', // Marketing vs technical substance\n};\n\n/**\n * Maps a template-specific finding type to schema-allowed type.\n *\n * @param originalType - The original finding type from template output\n * @returns Object with schemaType for database and originalType for tracking\n */\nexport function mapFindingType(originalType: string): {\n  schemaType: string;\n  originalType: string;\n} {\n  const schemaType = FINDING_TYPE_MAP[originalType] || 'fact';\n  return { schemaType, originalType };\n}\n\n// ============================================\n// PERSPECTIVE TYPE MAPPING\n// ============================================\n\n/**\n * Maps custom perspective types to Supabase schema-allowed values.\n *\n * Schema allows: 'historical', 'political', 'economic', 'psychological', 'military',\n *                'social', 'technological', 'financial', 'journalist', 'conspirator', 'network'\n */\nexport const PERSPECTIVE_TYPE_MAP: Record<string, string> = {\n  // Investigative perspectives (from Python)\n  forensic_financial: 'financial',\n  power_network: 'network',\n  psychological_behavioral: 'psychological',\n  geopolitical_strategic: 'political',\n  legal_liability: 'political',\n\n  // Financial/Investment perspectives (from Python)\n  institutional_investor: 'financial',\n  short_seller: 'financial',\n  quantitative_risk: 'financial',\n  activist_investor: 'financial',\n  macro_strategist: 'economic',\n\n  // Competitive analysis (from Python)\n  strategy_consultant: 'economic',\n  industry_insider: 'economic',\n\n  // Legal perspectives (from Python)\n  regulatory_expert: 'political',\n  litigation_strategist: 'political',\n\n  // Tech market perspectives (from Python)\n  venture_capitalist: 'financial',\n  startup_founder: 'technological',\n  product_manager: 'technological',\n  developer_advocate: 'technological',\n  open_source_maintainer: 'technological',\n  devrel_engineer: 'technological',\n  senior_engineer: 'technological',\n  platform_engineer: 'technological',\n\n  // Contract analysis (from Python)\n  contract_auditor: 'financial',\n  procurement_investigator: 'political',\n  forensic_accountant: 'financial',\n  regulatory_compliance: 'political',\n  industry_benchmarker: 'economic',\n\n  // Additional perspectives for other templates\n  market_analyst: 'economic',\n  risk_analyst: 'financial',\n  compliance_officer: 'political',\n  consumer_advocate: 'social',\n  industry_expert: 'economic',\n  technical_reviewer: 'technological',\n  security_researcher: 'technological',\n  data_scientist: 'technological',\n  ux_researcher: 'social',\n  business_analyst: 'economic',\n  investment_banker: 'financial',\n  hedge_fund_manager: 'financial',\n  retail_investor: 'financial',\n  financial_journalist: 'journalist',\n  investigative_journalist: 'journalist',\n  academic_researcher: 'historical',\n  policy_analyst: 'political',\n  government_official: 'political',\n  labor_economist: 'economic',\n  environmental_analyst: 'social',\n  ethics_researcher: 'social',\n  historian: 'historical',\n  sociologist: 'social',\n  psychologist: 'psychological',\n  legal_scholar: 'political',\n  defense_analyst: 'military',\n  intelligence_analyst: 'military',\n  conspiracy_theorist: 'conspirator',\n  whistleblower: 'journalist',\n  insider: 'network',\n  connected_source: 'network',\n\n  // New analytical perspectives (deep analysis)\n  narrative_analyst: 'journalist', // Narrative analysis is journalism-adjacent\n  incentive_mapper: 'financial', // Incentive mapping is financial analysis\n  historical_pattern: 'historical', // Historical pattern recognition\n  omission_detective: 'journalist', // Omission detection is investigative journalism\n  contrarian_synthesizer: 'financial', // Contrarian views (like short_seller)\n};\n\n/**\n * Valid perspective types allowed by the Supabase schema.\n */\nexport const VALID_PERSPECTIVE_TYPES = new Set([\n  'historical',\n  'political',\n  'economic',\n  'psychological',\n  'military',\n  'social',\n  'technological',\n  'financial',\n  'journalist',\n  'conspirator',\n  'network',\n]);\n\n/**\n * Maps a template-specific perspective type to schema-allowed type.\n *\n * @param originalType - The original perspective type from template output\n * @returns Object with schemaType for database and originalType for tracking\n */\nexport function mapPerspectiveType(originalType: string): {\n  schemaType: string;\n  originalType: string;\n} {\n  // If already a valid schema type, use it directly\n  if (VALID_PERSPECTIVE_TYPES.has(originalType)) {\n    return { schemaType: originalType, originalType };\n  }\n\n  const schemaType = PERSPECTIVE_TYPE_MAP[originalType] || 'economic';\n  return { schemaType, originalType };\n}\n\n// ============================================\n// TEMPORAL CONTEXT MAPPING\n// ============================================\n\n/**\n * Maps template temporal contexts to Supabase schema-allowed values.\n *\n * Schema allows: 'past', 'present', 'ongoing', 'prediction'\n */\nconst TEMPORAL_CONTEXT_MAP: Record<string, string> = {\n  historical: 'past',\n  current: 'present',\n  predicted: 'prediction',\n  future: 'prediction',\n  recent: 'present',\n  // Passthrough values\n  past: 'past',\n  present: 'present',\n  ongoing: 'ongoing',\n  prediction: 'prediction',\n};\n\n/**\n * Maps temporal context to schema-allowed values.\n *\n * @param context - The original temporal context from template output\n * @returns Schema-allowed temporal context string\n */\nexport function mapTemporalContext(context: string | undefined): string {\n  if (!context) return 'present';\n  return TEMPORAL_CONTEXT_MAP[context] || context || 'present';\n}\n","numLines":292,"startLine":1,"totalLines":292}}}
