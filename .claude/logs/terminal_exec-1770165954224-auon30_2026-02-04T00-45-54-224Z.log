[2026-02-04T00:47:09.500Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018xwaV5tbxkycZcu1mTbswM","type":"tool_result","content":"     1→/**\n     2→ * Central Expert Perspectives Library\n     3→ *\n     4→ * Reusable expert perspective definitions shared across research templates.\n     5→ * Templates import from here instead of duplicating perspective strings.\n     6→ *\n     7→ * Benefits:\n     8→ * - Single source of truth for perspective names\n     9→ * - Enables A/B testing prompt variations\n    10→ * - Easier auditing of what each template uses\n    11→ * - Type safety for perspective references\n    12→ */\n    13→\n    14→// ============================================\n    15→// EXPERT PERSPECTIVE CONSTANTS\n    16→// ============================================\n    17→\n    18→/**\n    19→ * Cross-domain analysis experts used across multiple template types.\n    20→ * These perspectives provide broadly applicable analytical frameworks.\n    21→ */\n    22→export const CROSS_DOMAIN_EXPERTS = {\n    23→  /** Financial forensics and accounting analysis */\n    24→  FORENSIC_FINANCIAL: 'forensic_financial',\n    25→  /** Legal liability and compliance assessment */\n    26→  LEGAL_LIABILITY: 'legal_liability',\n    27→  /** Geopolitical and strategic context analysis */\n    28→  GEOPOLITICAL_STRATEGIC: 'geopolitical_strategic',\n    29→  /** Power structures and relationship networks */\n    30→  POWER_NETWORK: 'power_network',\n    31→  /** Behavioral and psychological pattern analysis */\n    32→  PSYCHOLOGICAL_BEHAVIORAL: 'psychological_behavioral',\n    33→  /** Narrative construction and framing analysis */\n    34→  NARRATIVE_ANALYST: 'narrative_analyst',\n    35→} as const;\n    36→\n    37→/**\n    38→ * Investigation-focused experts for deep-dive research.\n    39→ */\n    40→export const INVESTIGATION_EXPERTS = {\n    41→  /** Historical pattern recognition and precedent analysis */\n    42→  HISTORICAL_PATTERN: 'historical_pattern',\n    43→  /** Incentive structure and motivation mapping */\n    44→  INCENTIVE_MAPPER: 'incentive_mapper',\n    45→  /** Detection of missing information and gaps */\n    46→  OMISSION_DETECTIVE: 'omission_detective',\n    47→  /** Intelligence analysis and synthesis */\n    48→  INTELLIGENCE_ANALYST: 'intelligence_analyst',\n    49→  /** Fact verification and accuracy checking */\n    50→  FACT_CHECKER: 'fact_checker',\n    51→  /** Historical context and precedent */\n    52→  HISTORIAN: 'historian',\n    53→} as const;\n    54→\n    55→/**\n    56→ * Financial market experts for investment and market analysis.\n    57→ */\n    58→export const FINANCIAL_EXPERTS = {\n    59→  /** Institutional investment perspective */\n    60→  INSTITUTIONAL_INVESTOR: 'institutional_investor',\n    61→  /** Short-selling and bearish analysis */\n    62→  SHORT_SELLER: 'short_seller',\n    63→  /** Quantitative risk assessment */\n    64→  QUANTITATIVE_RISK: 'quantitative_risk',\n    65→  /** Activist shareholder perspective */\n    66→  ACTIVIST_INVESTOR: 'activist_investor',\n    67→  /** Macroeconomic strategy analysis */\n    68→  MACRO_STRATEGIST: 'macro_strategist',\n    69→} as const;\n    70→\n    71→/**\n    72→ * Legal and regulatory experts for compliance and litigation.\n    73→ */\n    74→export const LEGAL_EXPERTS = {\n    75→  /** Litigation strategy and case assessment */\n    76→  LITIGATION_STRATEGIST: 'litigation_strategist',\n    77→  /** Regulatory compliance and policy analysis */\n    78→  REGULATORY_EXPERT: 'regulatory_expert',\n    79→  /** Contract analysis and negotiation */\n    80→  CONTRACT_ANALYST: 'contract_analyst',\n    81→  /** Employment and labor law specialist */\n    82→  EMPLOYMENT_SPECIALIST: 'employment_specialist',\n    83→} as const;\n    84→\n    85→/**\n    86→ * Due diligence and business analysis experts.\n    87→ */\n    88→export const DUE_DILIGENCE_EXPERTS = {\n    89→  /** Due diligence investigation specialist */\n    90→  DUE_DILIGENCE_ANALYST: 'due_diligence_analyst',\n    91→  /** Industry insider knowledge and context */\n    92→  INDUSTRY_INSIDER: 'industry_insider',\n    93→  /** Competitive intelligence and market position */\n    94→  COMPETITIVE_ANALYST: 'competitive_analyst',\n    95→  /** Strategic risk assessment */\n    96→  RISK_ANALYST: 'risk_analyst',\n    97→} as const;\n    98→\n    99→/**\n   100→ * Reputation and media analysis experts.\n   101→ */\n   102→export const REPUTATION_EXPERTS = {\n   103→  /** Crisis communication and management */\n   104→  CRISIS_COMMUNICATOR: 'crisis_communicator',\n   105→  /** Media coverage and sentiment analysis */\n   106→  MEDIA_ANALYST: 'media_analyst',\n   107→  /** Stakeholder perception and relations */\n   108→  STAKEHOLDER_ANALYST: 'stakeholder_analyst',\n   109→  /** Brand and reputation management */\n   110→  BRAND_STRATEGIST: 'brand_strategist',\n   111→  /** Consumer protection and scam detection */\n   112→  CONSUMER_PROTECTION: 'consumer_protection',\n   113→  /** Reputation pattern analysis */\n   114→  REPUTATION_ANALYST: 'reputation_analyst',\n   115→  /** Industry comparative assessment */\n   116→  INDUSTRY_BENCHMARKER: 'industry_benchmarker',\n   117→} as const;\n   118→\n   119→/**\n   120→ * Technology market analysis experts.\n   121→ */\n   122→export const TECH_MARKET_EXPERTS = {\n   123→  /** Venture capital and startup investment */\n   124→  VENTURE_CAPITALIST: 'venture_capitalist',\n   125→  /** Startup founding and scaling perspective */\n   126→  STARTUP_FOUNDER: 'startup_founder',\n   127→  /** Product management and roadmap strategy */\n   128→  PRODUCT_MANAGER: 'product_manager',\n   129→  /** Developer relations and advocacy */\n   130→  DEVELOPER_ADVOCATE: 'developer_advocate',\n   131→  /** Open source project maintenance */\n   132→  OPEN_SOURCE_MAINTAINER: 'open_source_maintainer',\n   133→  /** Developer relations engineering */\n   134→  DEVREL_ENGINEER: 'devrel_en