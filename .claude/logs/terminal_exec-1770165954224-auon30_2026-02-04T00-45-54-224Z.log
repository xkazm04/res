[2026-02-04T00:47:02.930Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DtH72RNoNZvagxNxvQVHz7","type":"tool_result","content":"     1→/**\n     2→ * Investigative Template Configuration\n     3→ *\n     4→ * Migrated from: actor/src/templates/investigative.py\n     5→ *\n     6→ * Template for investigative journalism research including:\n     7→ * - Key actors and relationships\n     8→ * - Timeline and events\n     9→ * - Financial trails\n    10→ * - Evidence and patterns\n    11→ */\n    12→\n    13→import { TemplateConfig } from '../types';\n    14→import { PERSPECTIVE_SETS } from '../prompts/experts';\n    15→\n    16→export const investigativeConfig: TemplateConfig = {\n    17→  // ---- Identity ----\n    18→  templateId: 'investigative',\n    19→  templateName: 'Investigative Research',\n    20→  description:\n    21→    'Deep investigative journalism with actor and relationship analysis',\n    22→\n    23→  // ---- Search Phase Configuration ----\n    24→  searchIntro:\n    25→    'You are an investigative journalist planning research queries for a deep investigation.',\n    26→\n    27→  searchAngles: [\n    28→    {\n    29→      name: 'KEY ACTORS',\n    30→      items: [\n    31→        'Who are the main people/organizations involved?',\n    32→        'Backgrounds and histories of key individuals',\n    33→        'Corporate structures and ownership',\n    34→      ],\n    35→    },\n    36→    {\n    37→      name: 'TIMELINE',\n    38→      items: [\n    39→        'What events happened and when?',\n    40→        'Sequence of key decisions and actions',\n    41→        'Historical context and precedents',\n    42→      ],\n    43→    },\n    44→    {\n    45→      name: 'LOCATIONS',\n    46→      items: [\n    47→        'Where did key events occur?',\n    48→        'What jurisdictions are involved?',\n    49→        'Geographic patterns and connections',\n    50→      ],\n    51→    },\n    52→    {\n    53→      name: 'MOTIVATIONS',\n    54→      items: [\n    55→        'What are the underlying interests?',\n    56→        'Relationships and alliances',\n    57→        'Conflicts of interest',\n    58→      ],\n    59→    },\n    60→    {\n    61→      name: 'METHODS',\n    62→      items: [\n    63→        'How were things done?',\n    64→        'What mechanisms were used?',\n    65→        'Patterns of behavior or action',\n    66→      ],\n    67→    },\n    68→    {\n    69→      name: 'MONEY TRAIL',\n    70→      items: [\n    71→        'Financial connections and transactions',\n    72→        'Funding sources and flows',\n    73→        'Property and asset movements',\n    74→      ],\n    75→    },\n    76→    {\n    77→      name: 'OFFICIAL RECORDS',\n    78→      items: [\n    79→        'Government filings and registrations',\n    80→        'Court documents and legal proceedings',\n    81→        'Regulatory actions and investigations',\n    82→      ],\n    83→    },\n    84→    {\n    85→      name: 'MEDIA COVERAGE',\n    86→      items: [\n    87→        'News reports and investigations',\n    88→        'Interviews and public statements',\n    89→        'Coverage patterns and omissions',\n    90→      ],\n    91→    },\n    92→    {\n    93→      name: 'NARRATIVE ARCHAEOLOGY',\n    94→      items: [\n    95→        'First appearance of key talking points and claims - trace to origin',\n    96→        'Evolution of story framing over time across different outlets',\n    97→        'Sources that covered vs systematically ignored this story',\n    98→        'Fact-checks: who funded them, what methodology, any conflicts',\n    99→        'PR firms and communications consultants involved',\n   100→      ],\n   101→    },\n   102→    {\n   103→      name: 'INCENTIVE MAPPING',\n   104→      items: [\n   105→        'Financial beneficiaries of current dominant narrative',\n   106→        'Career incentives and revolving doors for key spokespeople',\n   107→        'Funding sources for research, think tanks, and experts cited',\n   108→        'Regulatory capture indicators and agency-industry relationships',\n   109→        'Political donations and lobbying by involved parties',\n   110→      ],\n   111→    },\n   112→    {\n   113→      name: 'TEMPORAL ANALYSIS',\n   114→      items: [\n   115→        'What else happened on the same day that received less coverage',\n   116→        'Timing of announcements relative to other events (Friday news dumps)',\n   117→        'Long-term patterns that short-term coverage obscures',\n   118→        'Seasonal or cyclical patterns in similar events',\n   119→      ],\n   120→    },\n   121→    {\n   122→      name: 'NETWORK INFERENCE',\n   123→      items: [\n   124→        'Board memberships, advisory roles shared between actors',\n   125→        'Conference co-appearances, co-authorships, joint ventures',\n   126→        'Funding flows through foundations, NGOs, and intermediaries',\n   127→        'Social connections: school ties, club memberships, family',\n   128→      ],\n   129→    },\n   130→  ],\n   131→\n   132→  searchDepthGuidance: {\n   133→    quick: 'Focus on 1-3 most critical angles',\n   134→    standard: 'Cover 4-5 key angles with balanced depth',\n   135→    deep: 'Comprehensive coverage of all angles with follow-up queries',\n   136→  },\n   137→\n   138→  // ---- Extraction Phase Configuration ----\n   139→  extractionIntro:\n   140→    'You are an investigative analyst extracting key findings for a deep investigation.',\n   141→\n   142→  findingTypes: [\n   143→    {\n   144→      name: 'actor',\n   145→      displayName: 'Actor',\n   146→      description:\n   147→        'People, organizations, entities involved. Include: name, role, affiliations, significance. Note any aliases or connections.',\n   148→      extractedDataSchema:\n   149→        '{\"name\": \"...\", \"role\": \"...\", \"affiliations\": [...], \"significance\": \"...\", \"aliases\": [...]}',\n   150→      analysisFallback:\n   151→        \"This actor's role and connections warrant further investigation to understand their influence on events.\",\n   152→    },\n   153→    {\n   154→      name: 'event',\n   155→      displayName: 'Event',\n   156→      description:\n   157→        'Key incidents, actions, decisions. Include: date (if known), location, participants, outcome. Note sequence and causation.',\n   158→      extractedDataSchema:\n   159→        '{\"date\": \"...\", \"location\": \"...\", \"participants\": [...], \"outcome\": \"...\", \"causation\": \"...\"}',\n   160→      analysisFallback:\n   161→        'This event is significant in the investigative timeline and may have causal links to other developments.',\n   162→    },\n   163→    {\n   164→      name: 'relationship',\n   165→      displayName: 'Relationship',\n   166→      description:\n   167→        'Connections between actors. Types: personal, professional, political, criminal. Include strength of evidence.',\n   168→      extractedDataSchema:\n   169→        '{\"actor_a\": \"...\", \"actor_b\": \"...\", \"relationship_type\": \"...\", \"evidence_strength\": \"strong/moderate/weak\"}',\n   170→      analysisFallback:\n   171→        'This connection reveals potential coordination or influence that could be relevant to the investigation.',\n   172→    },\n   173→    {\n   174→      name: 'financial',\n   175→      displayName: 'Financial Transaction',\n   176→      description:\n   177→        'ANY money movement: payments, gifts, loans, wire transfers, settlements, property purchases, investments, donations. This is CRITICAL - extract ALL financial amounts mentioned.',\n   178→      extractedDataSchema:\n   179→        '{\"amount\": 0, \"currency\": \"USD\", \"payer\": \"...\", \"payee\": \"...\", \"transaction_date\": \"YYYY-MM-DD\", \"transaction_type\": \"payment/gift/loan/wire_transfer/property/settlement/investment\", \"purpose\": \"...\"}',\n   180→      analysisFallback:\n   181→        'This financial transaction may indicate underlying arrangements that require further scrutiny.',\n   182→    },\n   183→    {\n   184→      name: 'evidence',\n   185→      displayName: 'Evidence',\n   186→      description:\n   187→        'Documents, statements, data points. Include: type, source, significance. Note verification status.',\n   188→      extractedDataSchema:\n   189→        '{\"evidence_type\": \"document/statement/data\", \"source\": \"...\", \"significance\": \"...\", \"verified\": true}',\n   190→      analysisFallback:\n   191→        'This evidence supports key aspects of the investigation and strengthens the evidentiary foundation.',\n   192→    },\n   193→    {\n   194→      name: 'pattern',\n   195→      displayName: 'Pattern',\n   196→      description:\n   197→        'Recurring behaviors, methods, structures. Include: description, frequency, participants.',\n   198→      extractedDataSchema:\n   199→        '{\"description\": \"...\", \"frequency\": \"...\", \"participants\": [...], \"time_span\": \"...\"}',\n   200→      analysisFallback:\n   201→        'This recurring pattern suggests systematic behavior that may indicate intentional coordination.',\n   202→    },\n   203→    {\n   204→      name: 'gap',\n   205→      displayName: 'Gap',\n   206→      description:\n   207→        \"Missing information, unanswered questions. What we don't know and why it matters. Suggested follow-up.\",\n   208→      extractedDataSchema:\n   209→        '{\"question\": \"...\", \"importance\": \"high/medium/low\", \"suggested_followup\": [...]}',\n   210→      analysisFallback:\n   211→        'This information gap limits our ability to draw complete conclusions and should be addressed.',\n   212→    },\n   213→    {\n   214→      name: 'narrative_frame',\n   215→      displayName: 'Narrative Frame',\n   216→      description:\n   217→        'How the story is being framed and told. Includes: dominant narrative, framing choices, language patterns (passive voice, euphemisms), emotional appeals, what is emphasized vs minimized.',\n   218→      extractedDataSchema:\n   219→        '{\"dominant_frame\": \"...\", \"framing_techniques\": [...], \"language_patterns\": [...], \"emphasized\": [...], \"minimized\": [...]}',\n   220→      analysisFallback:\n   221→        'This framing choice shapes how audiences interpret events and may obscure alternative interpretations.',\n   222→    },\n   223→    {\n   224→      name: 'incentive_alignment',\n   225→      displayName: 'Incentive Alignment',\n   226→      description:\n   227→        'Who benefits from this claim or narrative being believed. Follow the money and career incentives. Note conflicts of interest.',\n   228→      extractedDataSchema:\n   229→        '{\"beneficiaries\": [...], \"incentive_type\": \"financial/career/political/reputational\", \"conflicts_of_interest\": [...], \"cui_bono\": \"...\"}',\n   230→      analysisFallback:\n   231→        'Understanding who benefits from a narrative reveals potential bias and motivation.',\n   232→    },\n   233→    {\n   234→      name: 'historical_parallel',\n   235→      displayName: 'Historical Parallel',\n   236→      description:\n   237→        'Similar past events or patterns. Playbook recognition - has this type of situation played out before? What happened then?',\n   238→      extractedDataSchema:\n   239→        '{\"historical_event\": \"...\", \"date\": \"...\", \"similarity_score\": 0.8, \"key_parallels\": [...], \"key_differences\": [...], \"outcome_then\": \"...\"}',\n   240→      analysisFallback:\n   241→        'Historical patterns often repeat; understanding precedents illuminates likely trajectories.',\n   242→    },\n   243→    {\n   244→      name: 'suspicious_timing',\n   245→      displayName: 'Suspicious Timing',\n   246→      description:\n   247→        'Events with convenient timing. What else happened simultaneously? Friday news dumps, holiday releases, distraction events.',\n   248→      extractedDataSchema:\n   249→        '{\"event\": \"...\", \"timing\": \"...\", \"concurrent_events\": [...], \"potential_distraction_from\": \"...\", \"pattern_type\": \"news_dump/distraction/preemption\"}',\n   250→      analysisFallback:\n   251→        'Timing of disclosures and events often reveals strategic intent.',\n   252→    },\n   253→    {\n   254→      name: 'coverage_asymmetry',\n   255→      displayName: 'Coverage Asymmetry',\n   256→      description:\n   257→        'Same event covered very differently by different sources. What do some sources include that others omit? Systematic patterns.',\n   258→      extractedDataSchema:\n   259→        '{\"event\": \"...\", \"source_a\": \"...\", \"source_b\": \"...\", \"included_by_a_only\": [...], \"included_by_b_only\": [...], \"framing_difference\": \"...\"}',\n   260→      analysisFallback:\n   261→        'Differential coverage reveals editorial biases and potentially coordinated narratives.',\n   262→    },\n   263→    {\n   264→      name: 'network_inference',\n   265→      displayName: 'Network Inference',\n   266→      description:\n   267→        'Implied relationships not explicitly documented. Shared board seats, funding connections, social ties, professional networks.',\n   268→      extractedDataSchema:\n   269→        '{\"actor_a\": \"...\", \"actor_b\": \"...\", \"connection_type\": \"board/funding/social/professional\", \"intermediaries\": [...], \"strength\": \"strong/moderate/weak\"}',\n   270→      analysisFallback:\n   271→        'Informal networks often explain coordinated behavior that formal relationships cannot.',\n   272→    },\n   273→  ],\n   274→\n   275→  extractionGuidelines: `CRITICAL: The \"analysis\" field must provide substantive reasoning, not just restate the finding.\n   276→Bad example: \"This is an important financial transaction.\"\n   277→Good example: \"This payment pattern suggests a quid pro quo arrangement because the timing coincides with the policy change. The use of intermediary accounts indicates awareness that direct payment would raise red flags. This connects to the earlier lobbying activity and raises questions about who authorized the payment structure.\"\n   278→\n   279→IMPORTANT:\n   280→- Prioritize extracting ALL financial transactions with specific dollar amounts\n   281→- Note corroboration status for key claims\n   282→- Flag connections that warrant further investigation`,\n   283→\n   284→  analysisInstruction: `YOUR EXPERT ANALYTICAL COMMENTARY (REQUIRED - 2-4 sentences) explaining:\n   285→  * WHY this finding is significant for the investigation\n   286→  * What it IMPLIES about the broader situation\n   287→  * How it CONNECTS to other findings or patterns\n   288→  * What questions it RAISES or answers`,\n   289→\n   290→  // ---- Ordering & Grouping ----\n   291→  priorityFindingTypes: [\n   292→    'financial',\n   293→    'evidence',\n   294→    'actor',\n   295→    'relationship',\n   296→    'pattern',\n   297→    'narrative_frame',\n   298→    'incentive_alignment',\n   299→    'network_inference',\n   300→  ],\n   301→  groupingOrder: [\n   302→    'financial',\n   303→    'actor',\n   304→    'relationship',\n   305→    'evidence',\n   306→    'event',\n   307→    'pattern',\n   308→    'narrative_frame',\n   309→    'incentive_alignment',\n   310→    'historical_parallel',\n   311→    'suspicious_timing',\n   312→    'coverage_asymmetry',\n   313→    'network_inference',\n   314→    'gap',\n   315→  ],\n   316→\n   317→  // ---- Perspectives ----\n   318→  // 9 expert perspectives for deep investigative analysis\n   319→  perspectives: [...PERSPECTIVE_SETS.investigative],\n   320→\n   321→  // ---- Verification ----\n   322→  // Investigative requires thorough verification on all dimensions\n   323→  // Critical to verify claims, detect cover-ups, and identify spin\n   324→  verificationConfig: {\n   325→    crossReference: 'thorough', // Must corroborate claims\n   326→    biasDetection: 'thorough', // Detect PR spin, cover-ups\n   327→    expertSanityCheck: 'thorough', // Flag implausible claims\n   328→    sourceQuality: 'thorough', // Primary sources critical\n   329→  },\n   330→\n   331→  // ---- Resource Limits ----\n   332→  defaultMaxSearches: 8,\n   333→};\n   334→\n   335→export default investigativeConfig;\n   336→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"d184f0d2-244e-457f-8ea5-4627f2d647f1","uuid":"ebd32c1b-e309-4cb7-9b1d-d26c205fb69a","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\templates\\research\\investigative.ts","content":"/**\n * Investigative Template Configuration\n *\n * Migrated from: actor/src/templates/investigative.py\n *\n * Template for investigative journalism research including:\n * - Key actors and relationships\n * - Timeline and events\n * - Financial trails\n * - Evidence and patterns\n */\n\nimport { TemplateConfig } from '../types';\nimport { PERSPECTIVE_SETS } from '../prompts/experts';\n\nexport const investigativeConfig: TemplateConfig = {\n  // ---- Identity ----\n  templateId: 'investigative',\n  templateName: 'Investigative Research',\n  description:\n    'Deep investigative journalism with actor and relationship analysis',\n\n  // ---- Search Phase Configuration ----\n  searchIntro:\n    'You are an investigative journalist planning research queries for a deep investigation.',\n\n  searchAngles: [\n    {\n      name: 'KEY ACTORS',\n      items: [\n        'Who are the main people/organizations involved?',\n        'Backgrounds and histories of key individuals',\n        'Corporate structures and ownership',\n      ],\n    },\n    {\n      name: 'TIMELINE',\n      items: [\n        'What events happened and when?',\n        'Sequence of key decisions and actions',\n        'Historical context and precedents',\n      ],\n    },\n    {\n      name: 'LOCATIONS',\n      items: [\n        'Where did key events occur?',\n        'What jurisdictions are involved?',\n        'Geographic patterns and connections',\n      ],\n    },\n    {\n      name: 'MOTIVATIONS',\n      items: [\n        'What are the underlying interests?',\n        'Relationships and alliances',\n        'Conflicts of interest',\n      ],\n    },\n    {\n      name: 'METHODS',\n      items: [\n        'How were things done?',\n        'What mechanisms were used?',\n        'Patterns of behavior or action',\n      ],\n    },\n    {\n      name: 'MONEY TRAIL',\n      items: [\n        'Financial connections and transactions',\n        'Funding sources and flows',\n        'Property and asset movements',\n      ],\n    },\n    {\n      name: 'OFFICIAL RECORDS',\n      items: [\n        'Government filings and registrations',\n        'Court documents and legal proceedings',\n        'Regulatory actions and investigations',\n      ],\n    },\n    {\n      name: 'MEDIA COVERAGE',\n      items: [\n        'News reports and investigations',\n        'Interviews and public statements',\n        'Coverage patterns and omissions',\n      ],\n    },\n    {\n      name: 'NARRATIVE ARCHAEOLOGY',\n      items: [\n        'First appearance of key talking points and claims - trace to origin',\n        'Evolution of story framing over time across different outlets',\n        'Sources that covered vs systematically ignored this story',\n        'Fact-checks: who funded them, what methodology, any conflicts',\n        'PR firms and communications consultants involved',\n      ],\n    },\n    {\n      name: 'INCENTIVE MAPPING',\n      items: [\n        'Financial beneficiaries of current dominant narrative',\n        'Career incentives and revolving doors for key spokespeople',\n        'Funding sources for research, think tanks, and experts cited',\n        'Regulatory capture indicators and agency-industry relationships',\n        'Political donations and lobbying by involved parties',\n      ],\n    },\n    {\n      name: 'TEMPORAL ANALYSIS',\n      items: [\n        'What else happened on the same day that received less coverage',\n        'Timing of announcements relative to other events (Friday news dumps)',\n        'Long-term patterns that short-term coverage obscures',\n        'Seasonal or cyclical patterns in similar events',\n      ],\n    },\n    {\n      name: 'NETWORK INFERENCE',\n      items: [\n        'Board memberships, advisory roles shared between actors',\n        'Conference co-appearances, co-authorships, joint ventures',\n        'Funding flows through foundations, NGOs, and intermediaries',\n        'Social connections: school ties, club memberships, family',\n      ],\n    },\n  ],\n\n  searchDepthGuidance: {\n    quick: 'Focus on 1-3 most critical angles',\n    standard: 'Cover 4-5 key angles with balanced depth',\n    deep: 'Comprehensive coverage of all angles with follow-up queries',\n  },\n\n  // ---- Extraction Phase Configuration ----\n  extractionIntro:\n    'You are an investigative analyst extracting key findings for a deep investigation.',\n\n  findingTypes: [\n    {\n      name: 'actor',\n      displayName: 'Actor',\n      description:\n        'People, organizations, entities involved. Include: name, role, affiliations, significance. Note any aliases or connections.',\n      extractedDataSchema:\n        '{\"name\": \"...\", \"role\": \"...\", \"affiliations\": [...], \"significance\": \"...\", \"aliases\": [...]}',\n      analysisFallback:\n        \"This actor's role and connections warrant further investigation to understand their influence on events.\",\n    },\n    {\n      name: 'event',\n      displayName: 'Event',\n      description:\n        'Key incidents, actions, decisions. Include: date (if known), location, participants, outcome. Note sequence and causation.',\n      extractedDataSchema:\n        '{\"date\": \"...\", \"location\": \"...\", \"participants\": [...], \"outcome\": \"...\", \"causation\": \"...\"}',\n      analysisFallback:\n        'This event is significant in the investigative timeline and may have causal links to other developments.',\n    },\n    {\n      name: 'relationship',\n      displayName: 'Relationship',\n      description:\n        'Connections between actors. Types: personal, professional, political, criminal. Include strength of evidence.',\n      extractedDataSchema:\n        '{\"actor_a\": \"...\", \"actor_b\": \"...\", \"relationship_type\": \"...\", \"evidence_strength\": \"strong/moderate/weak\"}',\n      analysisFallback:\n        'This connection reveals potential coordination or influence that could be relevant to the investigation.',\n    },\n    {\n      name: 'financial',\n      displayName: 'Financial Transaction',\n      description:\n        'ANY money movement: payments, gifts, loans, wire transfers, settlements, property purchases, investments, donations. This is CRITICAL - extract ALL financial amounts mentioned.',\n      extractedDataSchema:\n        '{\"amount\": 0, \"currency\": \"USD\", \"payer\": \"...\", \"payee\": \"...\", \"transaction_date\": \"YYYY-MM-DD\", \"transaction_type\": \"payment/gift/loan/wire_transfer/property/settlement/investment\", \"purpose\": \"...\"}',\n      analysisFallback:\n        'This financial transaction may indicate underlying arrangements that require further scrutiny.',\n    },\n    {\n      name: 'evidence',\n      displayName: 'Evidence',\n      description:\n        'Documents, statements, data points. Include: type, source, significance. Note verification status.',\n      extractedDataSchema:\n        '{\"evidence_type\": \"document/statement/data\", \"source\": \"...\", \"significance\": \"...\", \"verified\": true}',\n      analysisFallback:\n        'This evidence supports key aspects of the investigation and strengthens the evidentiary foundation.',\n    },\n    {\n      name: 'pattern',\n      displayName: 'Pattern',\n      description:\n        'Recurring behaviors, methods, structures. Include: description, frequency, participants.',\n      extractedDataSchema:\n        '{\"description\": \"...\", \"frequency\": \"...\", \"participants\": [...], \"time_span\": \"...\"}',\n      analysisFallback:\n        'This recurring pattern suggests systematic behavior that may indicate intentional coordination.',\n    },\n    {\n      name: 'gap',\n      displayName: 'Gap',\n      description:\n        \"Missing information, unanswered questions. What we don't know and why it matters. Suggested follow-up.\",\n      extractedDataSchema:\n        '{\"question\": \"...\", \"importance\": \"high/medium/low\", \"suggested_followup\": [...]}',\n      analysisFallback:\n        'This information gap limits our ability to draw complete conclusions and should be addressed.',\n    },\n    {\n      name: 'narrative_frame',\n      displayName: 'Narrative Frame',\n      description:\n        'How the story is being framed and told. Includes: dominant narrative, framing choices, language patterns (passive voice, euphemisms), emotional appeals, what is emphasized vs minimized.',\n      extractedDataSchema:\n        '{\"dominant_frame\": \"...\", \"framing_techniques\": [...], \"language_patterns\": [...], \"emphasized\": [...], \"minimized\": [...]}',\n      analysisFallback:\n        'This framing choice shapes how audiences interpret events and may obscure alternative interpretations.',\n    },\n    {\n      name: 'incentive_alignment',\n      displayName: 'Incentive Alignment',\n      description:\n        'Who benefits from this claim or narrative being believed. Follow the money and career incentives. Note conflicts of interest.',\n      extractedDataSchema:\n        '{\"beneficiaries\": [...], \"incentive_type\": \"financial/career/political/reputational\", \"conflicts_of_interest\": [...], \"cui_bono\": \"...\"}',\n      analysisFallback:\n        'Understanding who benefits from a narrative reveals potential bias and motivation.',\n    },\n    {\n      name: 'historical_parallel',\n      displayName: 'Historical Parallel',\n      description:\n        'Similar past events or patterns. Playbook recognition - has this type of situation played out before? What happened then?',\n      extractedDataSchema:\n        '{\"historical_event\": \"...\", \"date\": \"...\", \"similarity_score\": 0.8, \"key_parallels\": [...], \"key_differences\": [...], \"outcome_then\": \"...\"}',\n      analysisFallback:\n        'Historical patterns often repeat; understanding precedents illuminates likely trajectories.',\n    },\n    {\n      name: 'suspicious_timing',\n      displayName: 'Suspicious Timing',\n      description:\n        'Events with convenient timing. What else happened simultaneously? Friday news dumps, holiday releases, distraction events.',\n      extractedDataSchema:\n        '{\"event\": \"...\", \"timing\": \"...\", \"concurrent_events\": [...], \"potential_distraction_from\": \"...\", \"pattern_type\": \"news_dump/distraction/preemption\"}',\n      analysisFallback:\n        'Timing of disclosures and events often reveals strategic intent.',\n    },\n    {\n      name: 'coverage_asymmetry',\n      displayName: 'Coverage Asymmetry',\n      description:\n        'Same event covered very differently by different sources. What do some sources include that others omit? Systematic patterns.',\n      extractedDataSchema:\n        '{\"event\": \"...\", \"source_a\": \"...\", \"source_b\": \"...\", \"included_by_a_only\": [...], \"included_by_b_only\": [...], \"framing_difference\": \"...\"}',\n      analysisFallback:\n        'Differential coverage reveals editorial biases and potentially coordinated narratives.',\n    },\n    {\n      name: 'network_inference',\n      displayName: 'Network Inference',\n      description:\n        'Implied relationships not explicitly documented. Shared board seats, funding connections, social ties, professional networks.',\n      extractedDataSchema:\n        '{\"actor_a\": \"...\", \"actor_b\": \"...\", \"connection_type\": \"board/funding/social/professional\", \"intermediaries\": [...], \"strength\": \"strong/moderate/weak\"}',\n      analysisFallback:\n        'Informal networks often explain coordinated behavior that formal relationships cannot.',\n    },\n  ],\n\n  extractionGuidelines: `CRITICAL: The \"analysis\" field must provide substantive reasoning, not just restate the finding.\nBad example: \"This is an important financial transaction.\"\nGood example: \"This payment pattern suggests a quid pro quo arrangement because the timing coincides with the policy change. The use of intermediary accounts indicates awareness that direct payment would raise red flags. This connects to the earlier lobbying activity and raises questions about who authorized the payment structure.\"\n\nIMPORTANT:\n- Prioritize extracting ALL financial transactions with specific dollar amounts\n- Note corroboration status for key claims\n- Flag connections that warrant further investigation`,\n\n  analysisInstruction: `YOUR EXPERT ANALYTICAL COMMENTARY (REQUIRED - 2-4 sentences) explaining:\n  * WHY this finding is significant for the investigation\n  * What it IMPLIES about the broader situation\n  * How it CONNECTS to other findings or patterns\n  * What questions it RAISES or answers`,\n\n  // ---- Ordering & Grouping ----\n  priorityFindingTypes: [\n    'financial',\n    'evidence',\n    'actor',\n    'relationship',\n    'pattern',\n    'narrative_frame',\n    'incentive_alignment',\n    'network_inference',\n  ],\n  groupingOrder: [\n    'financial',\n    'actor',\n    'relationship',\n    'evidence',\n    'event',\n    'pattern',\n    'narrative_frame',\n    'incentive_alignment',\n    'historical_parallel',\n    'suspicious_timing',\n    'coverage_asymmetry',\n    'network_inference',\n    'gap',\n  ],\n\n  // ---- Perspectives ----\n  // 9 expert perspectives for deep investigative analysis\n  perspectives: [...PERSPECTIVE_SETS.investigative],\n\n  // ---- Verification ----\n  // Investigative requires thorough verification on all dimensions\n  // Critical to verify claims, detect cover-ups, and identify spin\n  verificationConfig: {\n    crossReference: 'thorough', // Must corroborate claims\n    biasDetection: 'thorough', // Detect PR spin, cover-ups\n    expertSanityCheck: 'thorough', // Flag implausible claims\n    sourceQuality: 'thorough', // Primary sources critical\n  },\n\n  // ---- Resource Limits ----\n  defaultMaxSearches: 8,\n};\n\nexport default investigativeConfig;\n","numLines":336,"startLine":1,"totalLines":336}}}
