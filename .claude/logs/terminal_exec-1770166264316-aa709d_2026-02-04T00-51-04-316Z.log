[2026-02-04T00:51:36.332Z] [STDOUT] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SKXPx4tJzxV7dmoNMFLzU8","type":"tool_result","content":"     1→import { create } from 'zustand';\n     2→import type { ResearchSession, SessionWithDetails } from '@/src/types/research';\n     3→import { MOCK_SESSIONS, USE_MOCK_DATA } from '@/src/lib/mockData';\n     4→import {\n     5→  getSessionCache,\n     6→  type AggregatesData,\n     7→  type TemplateData,\n     8→  type TopicData,\n     9→  type SessionSummary,\n    10→} from '@/src/lib/sessionCache';\n    11→import { getSessionIndex } from '@/src/lib/sessionIndex';\n    12→\n    13→// ============================================\n    14→// APP STATE - Unified store for Research Map\n    15→// ============================================\n    16→\n    17→// Topic type with sessions for intermediate categorization\n    18→export interface TopicWithSessions {\n    19→  id: string;\n    20→  name: string;\n    21→  slug: string;\n    22→  description?: string;\n    23→  topic_type?: string;\n    24→  parent_id?: string;\n    25→  session_count: number;\n    26→  finding_count: number;\n    27→  entity_count: number;\n    28→  sessions: Array<{\n    29→    id: string;\n    30→    title: string;\n    31→    template_type: string;\n    32→    status: string;\n    33→    claim_count: number;\n    34→    source_count: number;\n    35→  }>;\n    36→  children?: TopicWithSessions[];\n    37→}\n    38→\n    39→// Pagination state for infinite loading\n    40→interface PaginationState {\n    41→  cursor: string | null;\n    42→  hasMore: boolean;\n    43→  loading: boolean;\n    44→}\n    45→\n    46→interface AppState {\n    47→  // Sessions data (for map visualization)\n    48→  sessions: ResearchSession[];\n    49→  sessionsLoading: boolean;\n    50→  sessionsError: string | null;\n    51→\n    52→  // Aggregates for initial fast load\n    53→  aggregates: AggregatesData | null;\n    54→  aggregatesLoading: boolean;\n    55→\n    56→  // Pagination state per context\n    57→  sessionsPagination: PaginationState;\n    58→  templatePagination: Record<string, PaginationState>;\n    59→  topicPagination: Record<string, PaginationState>;\n    60→\n    61→  // Topics data (for intermediate categorization)\n    62→  topics: TopicWithSessions[];\n    63→  topicsLoading: boolean;\n    64→  topicsError: string | null;\n    65→\n    66→  // Current selected session (for report modal)\n    67→  currentSession: SessionWithDetails | null;\n    68→  currentSessionLoading: boolean;\n    69→  currentSessionError: string | null;\n    70→  isReportModalOpen: boolean;\n    71→\n    72→  // Map navigation state\n    73→  mapZoomPath: string[]; // Breadcrumb path: ['root', 'financial', 'topic-1']\n    74→  mapSelectedNode: string | null;\n    75→\n    76→  // Actions - Basic\n    77→  fetchSessions: () => Promise<void>;\n    78→  fetchTopics: () => Promise<void>;\n    79→  fetchSession: (id: string) => Promise<void>;\n    80→  setMapZoomPath: (path: string[]) => void;\n    81→  setMapSelectedNode: (nodeId: string | null) => void;\n    82→  openReportModal: (sessionId: string) => Promise<void>;\n    83→  closeReportModal: () => void;\n    84→  clearCurrentSession: () => void;\n    85→\n    86→  // Actions - Scalable Data Loading\n    87→  fetchAggregates: () => Promise<void>;\n    88→  fetchSessionsByTemplate: (template: string, loadMore?: boolean) => Promise<void>;\n    89→  fetchSessionsByTopic: (topicId: string, loadMore?: boolean) => Promise<void>;\n    90→  loadMoreSessions: () => Promise<void>;\n    91→  searchSessions: (query: string) => SessionSummary[];\n    92→  invalidateCache: () => void;\n    93→}\n    94→\n    95→export const useAppStore = create<AppState>((set, get) => ({\n    96→  // Initial state\n    97→  sessions: [],\n    98→  sessionsLoading: false,\n    99→  sessionsError: null,\n   100→\n   101→  aggregates: null,\n   102→  aggregatesLoading: false,\n   103→\n   104→  sessionsPagination: { cursor: null, hasMore: true, loading: false },\n   105→  templatePagination: {},\n   106→  topicPagination: {},\n   107→\n   108→  topics: [],\n   109→  topicsLoading: false,\n   110→  topicsError: null,\n   111→\n   112→  currentSession: null,\n   113→  currentSessionLoading: false,\n   114→  currentSessionError: null,\n   115→  isReportModalOpen: false,\n   116→\n   117→  mapZoomPath: ['root'],\n   118→  mapSelectedNode: null,\n   119→\n   120→  // Fetch aggregates for fast initial map render\n   121→  fetchAggregates: async () => {\n   122→    const cache = getSessionCache();\n   123→\n   124→    // Check cache first\n   125→    const cached = cache.getAggregates();\n   126→    if (cached) {\n   127→      set({ aggregates: cached, aggregatesLoading: false });\n   128→      return;\n   129→    }\n   130→\n   131→    set({ aggregatesLoading: true });\n   132→\n   133→    try {\n   134→      const response = await fetch('/api/sessions/aggregates');\n   135→\n   136→      if (!response.ok) {\n   137→        throw new Error(`HTTP ${response.status}: ${response.statusText}`);\n   138→      }\n   139→\n   140→      const data: AggregatesData = await response.json();\n   141→      cache.setAggregates(data);\n   142→      set({ aggregates: data, aggregatesLoading: false });\n   143→    } catch (error) {\n   144→      console.error('Error fetching aggregates:', error);\n   145→      set({ aggregatesLoading: false });\n   146→    }\n   147→  },\n   148→\n   149→  // Fetch all sessions for the map via API route (with pagination)\n   150→  fetchSessions: async () => {\n   151→    const { sessionsPagination } = get();\n   152→    if (sessionsPagination.loading) return;\n   153→\n   154→    set({\n   155→      sessionsLoading: true,\n   156→      sessionsError: null,\n   157→      sessionsPagination: { ...sessionsPagination, loading: true },\n   158→    });\n   159→\n   160→    try {\n   161→      // Use mock data if explicitly enabled\n   162→      if (USE_MOCK_DATA) {\n   163→        set({\n   164→          sessions: MOCK_SESSIONS,\n   165→          sessionsLoading: false,\n   166→          sessionsPagination: { cursor: null, hasMore: false, loading: false },\n   167→        });\n   168→        return;\n   169→      }\n   170→\n   171→      const response = await fetch('/api/sessions?limit=50');\n   172→\n   173→      if (!response.ok) {\n   174→        throw new Error(`HTTP ${response.status}: ${response.statusText}`);\n   175→      }\n   176→\n   177→      const data = await response.json();\n   178→      const sessions: ResearchSession[] = data.sessions || [];\n   179→\n   180→      // Fall back to mock data if no real sessions\n   181→      if (sessions.length === 0) {\n   182→        console.log('No real sessions found, using mock data for demo');\n   183→        set({\n   184→          sessions: MOCK_SESSIONS,\n   185→          sessionsLoading: false,\n   186→          sessionsPagination: { cursor: null, hasMore: false, loading: false },\n   187→        });\n   188→        return;\n   189→      }\n   190→\n   191→      // Add to session index for search\n   192→      const index = getSessionIndex();\n   193→      index.addSessions(sessions.map(s => ({\n   194→        id: s.id,\n   195→        title: s.title,\n   196→        query: s.query,\n   197→        template_type: s.template_type,\n   198→        status: s.status,\n   199→        primary_topic_id: s.primary_topic_id,\n   200→        claim_count: s.claim_count,\n   201→        source_count: s.source_count,\n   202→        created_at: s.created_at,\n   203→      })));\n   204→\n   205→      set({\n   206→        sessions,\n   207→        sessionsLoading: false,\n   208→        sessionsPagination: {\n   209→          cursor: data.nextCursor,\n   210→          hasMore: data.hasMore,\n   211→          loading: false,\n   212→        },\n   213→      });\n   214→    } catch (error) {\n   215→      console.error('Error fetching sessions:', error);\n   216→      // Fall back to mock data on error for demo purposes\n   217→      console.log('Database error, using mock data for demo');\n   218→      set({\n   219→        sessions: MOCK_SESSIONS,\n   220→        sessionsLoading: false,\n   221→        sessionsPagination: { cursor: null, hasMore: false, loading: false },\n   222→      });\n   223→    }\n   224→  },\n   225→\n   226→  // Load more sessions (pagination)\n   227→  loadMoreSessions: async () => {\n   228→    const { sessions, sessionsPagination } = get();\n   229→    if (!sessionsPagination.hasMore || sessionsPagination.loading) return;\n   230→\n   231→    set({ sessionsPagination: { ...sessionsPagination, loading: true } });\n   232→\n   233→    try {\n   234→      const url = sessionsPagination.cursor\n   235→        ? `/api/sessions?cursor=${sessionsPagination.cursor}&limit=50`\n   236→        : '/api/sessions?limit=50';\n   237→\n   238→      const response = await fetch(url);\n   239→\n   240→      if (!response.ok) {\n   241→        throw new Error(`HTTP ${response.status}: ${response.statusText}`);\n   242→      }\n   243→\n   244→      const data = await response.json();\n   245→      const newSessions: ResearchSession[] = data.sessions || [];\n   246→\n   247→      // Add to session index\n   248→      const index = getSessionIndex();\n   249→      index.addSessions(newSessions.map(s => ({\n   250→        id: s.id,\n   251→        title: s.title,\n   252→        query: s.query,\n   253→        template_type: s.template_type,\n   254→        status: s.status,\n   255→        primary_topic_id: s.primary_topic_id,\n   256→        claim_count: s.claim_count,\n   257→        source_count: s.source_count,\n   258→        created_at: s.created_at,\n   259→      })));\n   260→\n   261→      set({\n   262→        sessions: [...sessions, ...newSessions],\n   263→        sessionsPagination: {\n   264→          cursor: data.nextCursor,\n   265→          hasMore: data.hasMore,\n   266→          loading: false,\n   267→        },\n   268→      });\n   269→    } catch (error) {\n   270→      console.error('Error loading more sessions:', error);\n   271→      set({ sessionsPagination: { ...sessionsPagination, loading: false } });\n   272→    }\n   273→  },\n   274→\n   275→  // Fetch sessions by template (for drill-down)\n   276→  fetchSessionsByTemplate: async (template: string, loadMore = false) => {\n   277→    const cache = getSessionCache();\n   278→    const { templatePagination } = get();\n   279→\n   280→    // Check cache first (if not loading more)\n   281→    if (!loadMore) {\n   282→      const cached = cache.getTemplateData(template);\n   283→      if (cached) {\n   284→        // Add to index if not already\n   285→        const index = getSessionIndex();\n   286→        index.addSessions(cached.sessions);\n   287→        return;\n   288→      }\n   289→    }\n   290→\n   291→    const pagination = templatePagination[template] || { cursor: null, hasMore: true, loading: false };\n   292→    if (pagination.loading || (!loadMore && cache.hasTemplateData(template))) return;\n   293→\n   294→    set({\n   295→      templatePagination: {\n   296→        ...templatePagination,\n   297→        [template]: { ...pagination, loading: true },\n   298→      },\n   299→    });\n   300→\n   301→    try {\n   302→      const cursor = loadMore ? pagination.cursor : null;\n   303→      const url = cursor\n   304→        ? `/api/sessions/by-template/${template}?cursor=${cursor}&limit=50`\n   305→        : `/api/sessions/by-template/${template}?limit=50`;\n   306→\n   307→      const response = await fetch(url);\n   308→\n   309→      if (!response.ok) {\n   310→        throw new Error(`HTTP ${response.status}: ${response.statusText}`);\n   311→      }\n   312→\n   313→      const data = await response.json();\n   314→\n   315→      // Add to index\n   316→      const index = getSessionIndex();\n   317→      index.addSessions(data.sessions);\n   318→\n   319→      if (loadMore) {\n   320→        cache.appendTemplateData(template, data.sessions, data.nextCursor, data.hasMore);\n   321→      } else {\n   322→        cache.setTemplateData(template, {\n   323→          sessions: data.sessions,\n   324→          topics: data.topics || [],\n   325→          cursor: data.nextCursor,\n   326→          hasMore: data.hasMore,\n   327→          totalCount: data.totalCount,\n   328→          fetchedAt: Date.now(),\n   329→        });\n   330→      }\n   331→\n   332→      set({\n   333→        templatePagination: {\n   334→          ...templatePagination,\n   335→          [template]: {\n   336→            cursor: data.nextCursor,\n   337→            hasMore: data.hasMore,\n   338→            loading: false,\n   339→          },\n   340→        },\n   341→      });\n   342→    } catch (error) {\n   343→      console.error(`Error fetching sessions for template ${template}:`, error);\n   344→      set({\n   345→        templatePagination: {\n   346→          ...templatePagination,\n   347→          [template]: { ...pagination, loading: false },\n   348→        },\n   349→      });\n   350→    }\n   351→  },\n   352→\n   353→  // Fetch sessions by topic (for drill-down)\n   354→  fetchSessionsByTopic: async (topicId: string, loadMore = false) => {\n   355→    const cache = getSessionCache();\n   356→    const { topicPagination } = get();\n   357→\n   358→    // Check cache first (if not loading more)\n   359→    if (!loadMore) {\n   360→      const cached = cache.getTopicData(topicId);\n   361→      if (cached) {\n   362→        const index = getSessionIndex();\n   363→        index.addSessions(cached.sessions);\n   364→        return;\n   365→      }\n   366→    }\n   367→\n   368→    const pagination = topicPagination[topicId] || { cursor: null, hasMore: true, loading: false };\n   369→    if (pagination.loading || (!loadMore && cache.hasTopicData(topicId))) return;\n   370→\n   371→    set({\n   372→      topicPagination: {\n   373→        ...topicPagination,\n   374→        [topicId]: { ...pagination, loading: true },\n   375→      },\n   376→    });\n   377→\n   378→    try {\n   379→      const cursor = loadMore ? pagination.cursor : null;\n   380→      const url = cursor\n   381→        ? `/api/sessions/by-topic/${topicId}?cursor=${cursor}&limit=50`\n   382→        : `/api/sessions/by-topic/${topicId}?limit=50`;\n   383→\n   384→      const response = await fetch(url);\n   385→\n   386→      if (!response.ok) {\n   387→        throw new Error(`HTTP ${response.status}: ${response.statusText}`);\n   388→      }\n   389→\n   390→      const data = await response.json();\n   391→\n   392→      // Add to index\n   393→      const index = getSessionIndex();\n   394→      index.addSessions(data.sessions);\n   395→\n   396→      if (loadMore) {\n   397→        cache.appendTopicData(topicId, data.sessions, data.nextCursor, data.hasMore);\n   398→      } else {\n   399→        cache.setTopicData(topicId, {\n   400→          sessions: data.sessions,\n   401→          cursor: data.nextCursor,\n   402→          hasMore: data.hasMore,\n   403→          totalCount: data.totalCount,\n   404→          fetchedAt: Date.now(),\n   405→        });\n   406→      }\n   407→\n   408→      set({\n   409→        topicPagination: {\n   410→          ...topicPagination,\n   411→          [topicId]: {\n   412→            cursor: data.nextCursor,\n   413→            hasMore: data.hasMore,\n   414→            loading: false,\n   415→          },\n   416→        },\n   417→      });\n   418→    } catch (error) {\n   419→      console.error(`Error fetching sessions for topic ${topicId}:`, error);\n   420→      set({\n   421→        topicPagination: {\n   422→          ...topicPagination,\n   423→          [topicId]: { ...pagination, loading: false },\n   424→        },\n   425→      });\n   426→    }\n   427→  },\n   428→\n   429→  // Search sessions using the index\n   430→  searchSessions: (query: string): SessionSummary[] => {\n   431→    const index = getSessionIndex();\n   432→    return index.search(query, { limit: 50 });\n   433→  },\n   434→\n   435→  // Invalidate all caches\n   436→  invalidateCache: () => {\n   437→    const cache = getSessionCache();\n   438→    cache.clearAll();\n   439→\n   440→    const index = getSessionIndex();\n   441→    index.clear();\n   442→\n   443→    set({\n   444→      aggregates: null,\n   445→      sessionsPagination: { cursor: null, hasMore: true, loading: false },\n   446→      templatePagination: {},\n   447→      topicPagination: {},\n   448→    });\n   449→  },\n   450→\n   451→  // Fetch all topics for intermediate categorization\n   452→  fetchTopics: async () => {\n   453→    set({ topicsLoading: true, topicsError: null });\n   454→\n   455→    try {\n   456→      const response = await fetch('/api/topics');\n   457→\n   458→      if (!response.ok) {\n   459→        throw new Error(`HTTP ${response.status}: ${response.statusText}`);\n   460→      }\n   461→\n   462→      const data = await response.json();\n   463→      const topics: TopicWithSessions[] = data.topics || [];\n   464→\n   465→      set({ topics, topicsLoading: false });\n   466→    } catch (error) {\n   467→      console.error('Error fetching topics:', error);\n   468→      set({\n   469→        topicsError: error instanceof Error ? error.message : 'Failed to fetch topics',\n   470→        topicsLoading: false,\n   471→        topics: [],\n   472→      });\n   473→    }\n   474→  },\n   475→\n   476→  // Fetch a single session with full details via API route\n   477→  fetchSession: async (id: string) => {\n   478→    set({ currentSessionLoading: true, currentSessionError: null });\n   479→\n   480→    try {\n   481→      const response = await fetch(`/api/sessions/${id}`);\n   482→\n   483→      if (!response.ok) {\n   484→        if (response.status === 404) {\n   485→          set({\n   486→            currentSessionError: 'Session not found',\n   487→            currentSessionLoading: false,\n   488→          });\n   489→          return;\n   490→        }\n   491→        throw new Error(`HTTP ${response.status}: ${response.statusText}`);\n   492→      }\n   493→\n   494→      const session: SessionWithDetails = await response.json();\n   495→      set({ currentSession: session, currentSessionLoading: false });\n   496→    } catch (error) {\n   497→      console.error('Error fetching session:', error);\n   498→      set({\n   499→        currentSessionError: error instanceof Error ? error.message : 'Failed to fetch session',\n   500→        currentSessionLoading: false,\n   501→      });\n   502→    }\n   503→  },\n   504→\n   505→  // Map navigation\n   506→  setMapZoomPath: (path: string[]) => {\n   507→    set({ mapZoomPath: path });\n   508→  },\n   509→\n   510→  setMapSelectedNode: (nodeId: string | null) => {\n   511→    set({ mapSelectedNode: nodeId });\n   512→  },\n   513→\n   514→  // Report modal\n   515→  openReportModal: async (sessionId: string) => {\n   516→    set({ isReportModalOpen: true, currentSessionLoading: true });\n   517→    await get().fetchSession(sessionId);\n   518→  },\n   519→\n   520→  closeReportModal: () => {\n   521→    set({ isReportModalOpen: false });\n   522→  },\n   523→\n   524→  clearCurrentSession: () => {\n   525→    set({\n   526→      currentSession: null,\n   527→      currentSessionError: null,\n   528→      isReportModalOpen: false,\n   529→    });\n   530→  },\n   531→}));\n   532→\n   533→// ============================================\n   534→// DERIVED DATA HELPERS\n   535→// ============================================\n   536→\n   537→// Group sessions by template type\n   538→export function groupSessionsByTemplate(sessions: ResearchSession[]): Record<string, ResearchSession[]> {\n   539→  return sessions.reduce((acc, session) => {\n   540→    const template = session.template_type || 'unknown';\n   541→    if (!acc[template]) {\n   542→      acc[template] = [];\n   543→    }\n   544→    acc[template].push(session);\n   545→    return acc;\n   546→  }, {} as Record<string, ResearchSession[]>);\n   547→}\n   548→\n   549→// Get template display name\n   550→export function getTemplateDisplayName(template: string): string {\n   551→  const displayNames: Record<string, string> = {\n   552→    investigative: 'Investigative',\n   553→    financial: 'Financial',\n   554→    competitive: 'Competitive',\n   555→    tech_market: 'Tech Market',\n   556→    legal: 'Legal',\n   557→    due_diligence: 'Due Diligence',\n   558→    contract: 'Contract',\n   559→    purchase_decision: 'Purchase Decision',\n   560→    reputation: 'Reputation',\n   561→    understanding: 'Understanding',\n   562→  };\n   563→  return displayNames[template] || template.replace(/_/g, ' ');\n   564→}\n   565→\n   566→// Get template color\n   567→export function getTemplateColor(template: string): string {\n   568→  const colors: Record<string, string> = {\n   569→    investigative: '#E03131',\n   570→    financial: '#228BE6',\n   571→    competitive: '#7950F2',\n   572→    tech_market: '#2F9E44',\n   573→    legal: '#1864AB',\n   574→    due_diligence: '#F59F00',\n   575→    contract: '#862E9C',\n   576→    purchase_decision: '#E8590C',\n   577→    reputation: '#C2255C',\n   578→    understanding: '#0B7285',\n   579→  };\n   580→  return colors[template] || '#8A8987';\n   581→}\n   582→\n   583→// Extract topic from query (simple heuristic)\n   584→export function extractTopicFromQuery(query: string): string {\n   585→  // Remove common research prefixes\n   586→  const cleaned = query\n   587→    .replace(/^(research|analyze|investigate|understand|compare)\\s+/i, '')\n   588→    .replace(/\\s+(market|analysis|report|overview)$/i, '');\n   589→\n   590→  // Truncate to reasonable length\n   591→  if (cleaned.length > 50) {\n   592→    return cleaned.substring(0, 47) + '...';\n   593→  }\n   594→  return cleaned;\n   595→}\n   596→\n   597→// Calculate statistics for sessions\n   598→export function calculateSessionStats(sessions: ResearchSession[]) {\n   599→  const totalSessions = sessions.length;\n   600→  const totalFindings = sessions.reduce((sum, s) => sum + (s.claim_count || 0), 0);\n   601→  const totalSources = sessions.reduce((sum, s) => sum + (s.source_count || 0), 0);\n   602→  const completedSessions = sessions.filter(s => s.status === 'completed').length;\n   603→\n   604→  const byTemplate = groupSessionsByTemplate(sessions);\n   605→  const templateCounts = Object.entries(byTemplate).map(([template, items]) => ({\n   606→    template,\n   607→    count: items.length,\n   608→    color: getTemplateColor(template),\n   609→  }));\n   610→\n   611→  return {\n   612→    totalSessions,\n   613→    totalFindings,\n   614→    totalSources,\n   615→    completedSessions,\n   616→    templateCounts,\n   617→  };\n   618→}\n   619→\n   620→// ============================================\n   621→// TOPIC-BASED GROUPING HELPERS\n   622→// ============================================\n   623→\n   624→// Group sessions by topic within a template\n   625→export function groupSessionsByTopic(\n   626→  sessions: ResearchSession[],\n   627→  topics: TopicWithSessions[]\n   628→): Record<string, { topic: TopicWithSessions; sessions: ResearchSession[] }> {\n   629→  const result: Record<string, { topic: TopicWithSessions; sessions: ResearchSession[] }> = {};\n   630→\n   631→  // Create a map of session_id to topic\n   632→  const sessionToTopic = new Map<string, TopicWithSessions>();\n   633→  topics.forEach(topic => {\n   634→    topic.sessions?.forEach(s => {\n   635→      sessionToTopic.set(s.id, topic);\n   636→    });\n   637→  });\n   638→\n   639→  // Group sessions\n   640→  sessions.forEach(session => {\n   641→    const topic = sessionToTopic.get(session.id);\n   642→    if (topic) {\n   643→      if (!result[topic.id]) {\n   644→        result[topic.id] = { topic, sessions: [] };\n   645→      }\n   646→      result[topic.id].sessions.push(session);\n   647→    }\n   648→  });\n   649→\n   650→  return result;\n   651→}\n   652→\n   653→// Get topics that belong to a specific template\n   654→export function getTopicsForTemplate(\n   655→  template: string,\n   656→  topics: TopicWithSessions[]\n   657→): TopicWithSessions[] {\n   658→  return topics.filter(topic =>\n   659→    topic.sessions?.some(s => s.template_type === template)\n   660→  );\n   661→}\n   662→\n   663→// Get sessions without a topic (uncategorized)\n   664→export function getUncategorizedSessions(\n   665→  sessions: ResearchSession[],\n   666→  topics: TopicWithSessions[]\n   667→): ResearchSession[] {\n   668→  const categorizedIds = new Set<string>();\n   669→  topics.forEach(topic => {\n   670→    topic.sessions?.forEach(s => categorizedIds.add(s.id));\n   671→  });\n   672→\n   673→  return sessions.filter(s => !categorizedIds.has(s.id));\n   674→}\n   675→\n   676→// Get finding type counts for display\n   677→export function getFindingTypeIcon(type: string): string {\n   678→  const icons: Record<string, string> = {\n   679→    fact: 'check-circle',\n   680→    claim: 'message-circle',\n   681→    event: 'calendar',\n   682→    actor: 'user',\n   683→    relationship: 'link',\n   684→    pattern: 'trending-up',\n   685→    gap: 'alert-circle',\n   686→    evidence: 'file-text',\n   687→  };\n   688→  return icons[type] || 'circle';\n   689→}\n   690→\n   691→export function getFindingTypeColor(type: string): string {\n   692→  const colors: Record<string, string> = {\n   693→    fact: '#2563EB',\n   694→    claim: '#7C3AED',\n   695→    event: '#059669',\n   696→    actor: '#DC2626',\n   697→    relationship: '#D97706',\n   698→    pattern: '#0891B2',\n   699→    gap: '#6B7280',\n   700→    evidence: '#16A34A',\n   701→  };\n   702→  return colors[type] || '#6B7280';\n   703→}\n   704→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"d184f0d2-244e-457f-8ea5-4627f2d647f1","uuid":"ad200bef-d667-41ed-98e9-f69f8e12b416","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\mkdol\\dolla\\res\\src\\stores\\appStore.ts","content":"import { create } from 'zustand';\nimport type { ResearchSession, SessionWithDetails } from '@/src/types/research';\nimport { MOCK_SESSIONS, USE_MOCK_DATA } from '@/src/lib/mockData';\nimport {\n  getSessionCache,\n  type AggregatesData,\n  type TemplateData,\n  type TopicData,\n  type SessionSummary,\n} from '@/src/lib/sessionCache';\nimport { getSessionIndex } from '@/src/lib/sessionIndex';\n\n// ============================================\n// APP STATE - Unified store for Research Map\n// ============================================\n\n// Topic type with sessions for intermediate categorization\nexport interface TopicWithSessions {\n  id: string;\n  name: string;\n  slug: string;\n  description?: string;\n  topic_type?: string;\n  parent_id?: string;\n  session_count: number;\n  finding_count: number;\n  entity_count: number;\n  sessions: Array<{\n    id: string;\n    title: string;\n    template_type: string;\n    status: string;\n    claim_count: number;\n    source_count: number;\n  }>;\n  children?: TopicWithSessions[];\n}\n\n// Pagination state for infinite loading\ninterface PaginationState {\n  cursor: string | null;\n  hasMore: boolean;\n  loading: boolean;\n}\n\ninterface AppState {\n  // Sessions data (for map visualization)\n  sessions: ResearchSession[];\n  sessionsLoading: boolean;\n  sessionsError: string | null;\n\n  // Aggregates for initial fast load\n  aggregates: AggregatesData | null;\n  aggregatesLoading: boolean;\n\n  // Pagination state per context\n  sessionsPagination: PaginationState;\n  templatePagination: Record<string, PaginationState>;\n  topicPagination: Record<string, PaginationState>;\n\n  // Topics data (for intermediate categorization)\n  topics: TopicWithSessions[];\n  topicsLoading: boolean;\n  topicsError: string | null;\n\n  // Current selected session (for report modal)\n  currentSession: SessionWithDetails | null;\n  currentSessionLoading: boolean;\n  currentSessionError: string | null;\n  isReportModalOpen: boolean;\n\n  // Map navigation state\n  mapZoomPath: string[]; // Breadcrumb path: ['root', 'financial', 'topic-1']\n  mapSelectedNode: string | null;\n\n  // Actions - Basic\n  fetchSessions: () => Promise<void>;\n  fetchTopics: () => Promise<void>;\n  fetchSession: (id: string) => Promise<void>;\n  setMapZoomPath: (path: string[]) => void;\n  setMapSelectedNode: (nodeId: string | null) => void;\n  openReportModal: (sessionId: string) => Promise<void>;\n  closeReportModal: () => void;\n  clearCurrentSession: () => void;\n\n  // Actions - Scalable Data Loading\n  fetchAggregates: () => Promise<void>;\n  fetchSessionsByTemplate: (template: string, loadMore?: boolean) => Promise<void>;\n  fetchSessionsByTopic: (topicId: string, loadMore?: boolean) => Promise<void>;\n  loadMoreSessions: () => Promise<void>;\n  searchSessions: (query: string) => SessionSummary[];\n  invalidateCache: () => void;\n}\n\nexport const useAppStore = create<AppState>((set, get) => ({\n  // Initial state\n  sessions: [],\n  sessionsLoading: false,\n  sessionsError: null,\n\n  aggregates: null,\n  aggregatesLoading: false,\n\n  sessionsPagination: { cursor: null, hasMore: true, loading: false },\n  templatePagination: {},\n  topicPagination: {},\n\n  topics: [],\n  topicsLoading: false,\n  topicsError: null,\n\n  currentSession: null,\n  currentSessionLoading: false,\n  currentSessionError: null,\n  isReportModalOpen: false,\n\n  mapZoomPath: ['root'],\n  mapSelectedNode: null,\n\n  // Fetch aggregates for fast initial map render\n  fetchAggregates: async () => {\n    const cache = getSessionCache();\n\n    // Check cache first\n    const cached = cache.getAggregates();\n    if (cached) {\n      set({ aggregates: cached, aggregatesLoading: false });\n      return;\n    }\n\n    set({ aggregatesLoading: true });\n\n    try {\n      const response = await fetch('/api/sessions/aggregates');\n\n      if (!response.ok) {\n        throw new Error(`HTTP ${response.status}: ${response.statusText}`);\n      }\n\n      const data: AggregatesData = await response.json();\n      cache.setAggregates(data);\n      set({ aggregates: data, aggregatesLoading: false });\n    } catch (error) {\n      console.error('Error fetching aggregates:', error);\n      set({ aggregatesLoading: false });\n    }\n  },\n\n  // Fetch all sessions for the map via API route (with pagination)\n  fetchSessions: async () => {\n    const { sessionsPagination } = get();\n    if (sessionsPagination.loading) return;\n\n    set({\n      sessionsLoading: true,\n      sessionsError: null,\n      sessionsPagination: { ...sessionsPagination, loading: true },\n    });\n\n    try {\n      // Use mock data if explicitly enabled\n      if (USE_MOCK_DATA) {\n        set({\n          sessions: MOCK_SESSIONS,\n          sessionsLoading: false,\n          sessionsPagination: { cursor: null, hasMore: false, loading: false },\n        });\n        return;\n      }\n\n      const response = await fetch('/api/sessions?limit=50');\n\n      if (!response.ok) {\n        throw new Error(`HTTP ${response.status}: ${response.statusText}`);\n      }\n\n      const data = await response.json();\n      const sessions: ResearchSession[] = data.sessions || [];\n\n      // Fall back to mock data if no real sessions\n      if (sessions.length === 0) {\n        console.log('No real sessions found, using mock data for demo');\n        set({\n          sessions: MOCK_SESSIONS,\n          sessionsLoading: false,\n          sessionsPagination: { cursor: null, hasMore: false, loading: false },\n        });\n        return;\n      }\n\n      // Add to session index for search\n      const index = getSessionIndex();\n      index.addSessions(sessions.map(s => ({\n        id: s.id,\n        title: s.title,\n        query: s.query,\n        template_type: s.template_type,\n        status: s.status,\n        primary_topic_id: s.primary_topic_id,\n        claim_count: s.claim_count,\n        source_count: s.source_count,\n        created_at: s.created_at,\n      })));\n\n      set({\n        sessions,\n        sessionsLoading: false,\n        sessionsPagination: {\n          cursor: data.nextCursor,\n          hasMore: data.hasMore,\n          loading: false,\n        },\n      });\n    } catch (error) {\n      console.error('Error fetching sessions:', error);\n      // Fall back to mock data on error for demo purposes\n      console.log('Database error, using mock data for demo');\n      set({\n        sessions: MOCK_SESSIONS,\n        sessionsLoading: false,\n        sessionsPagination: { cursor: null, hasMore: false, loading: false },\n      });\n    }\n  },\n\n  // Load more sessions (pagination)\n  loadMoreSessions: async () => {\n    const { sessions, sessionsPagination } = get();\n    if (!sessionsPagination.hasMore || sessionsPagination.loading) return;\n\n    set({ sessionsPagination: { ...sessionsPagination, loading: true } });\n\n    try {\n      const url = sessionsPagination.cursor\n        ? `/api/sessions?cursor=${sessionsPagination.cursor}&limit=50`\n        : '/api/sessions?limit=50';\n\n      const response = await fetch(url);\n\n      if (!response.ok) {\n        throw new Error(`HTTP ${response.status}: ${response.statusText}`);\n      }\n\n      const data = await response.json();\n      const newSessions: ResearchSession[] = data.sessions || [];\n\n      // Add to session index\n      const index = getSessionIndex();\n      index.addSessions(newSessions.map(s => ({\n        id: s.id,\n        title: s.title,\n        query: s.query,\n        template_type: s.template_type,\n        status: s.status,\n        primary_topic_id: s.primary_topic_id,\n        claim_count: s.claim_count,\n        source_count: s.source_count,\n        created_at: s.created_at,\n      })));\n\n      set({\n        sessions: [...sessions, ...newSessions],\n        sessionsPagination: {\n          cursor: data.nextCursor,\n          hasMore: data.hasMore,\n          loading: false,\n        },\n      });\n    } catch (error) {\n      console.error('Error loading more sessions:', error);\n      set({ sessionsPagination: { ...sessionsPagination, loading: false } });\n    }\n  },\n\n  // Fetch sessions by template (for drill-down)\n  fetchSessionsByTemplate: async (template: string, loadMore = false) => {\n    const cache = getSessionCache();\n    const { templatePagination } = get();\n\n    // Check cache first (if not loading more)\n    if (!loadMore) {\n      const cached = cache.getTemplateData(template);\n      if (cached) {\n        // Add to index if not already\n        const index = getSessionIndex();\n        index.addSessions(cached.sessions);\n        return;\n      }\n    }\n\n    const pagination = templatePagination[template] || { cursor: null, hasMore: true, loading: false };\n    if (pagination.loading || (!loadMore && cache.hasTemplateData(template))) return;\n\n    set({\n      templatePagination: {\n        ...templatePagination,\n        [template]: { ...pagination, loading: true },\n      },\n    });\n\n    try {\n      const cursor = loadMore ? pagination.cursor : null;\n      const url = cursor\n        ? `/api/sessions/by-template/${template}?cursor=${cursor}&limit=50`\n        : `/api/sessions/by-template/${template}?limit=50`;\n\n      const response = await fetch(url);\n\n      if (!response.ok) {\n        throw new Error(`HTTP ${response.status}: ${response.statusText}`);\n      }\n\n      const data = await response.json();\n\n      // Add to index\n      const index = getSessionIndex();\n      index.addSessions(data.sessions);\n\n      if (loadMore) {\n        cache.appendTemplateData(template, data.sessions, data.nextCursor, data.hasMore);\n      } else {\n        cache.setTemplateData(template, {\n          sessions: data.sessions,\n          topics: data.topics || [],\n          cursor: data.nextCursor,\n          hasMore: data.hasMore,\n          totalCount: data.totalCount,\n          fetchedAt: Date.now(),\n        });\n      }\n\n      set({\n        templatePagination: {\n          ...templatePagination,\n          [template]: {\n            cursor: data.nextCursor,\n            hasMore: data.hasMore,\n            loading: false,\n          },\n        },\n      });\n    } catch (error) {\n      console.error(`Error fetching sessions for template ${template}:`, error);\n      set({\n        templatePagination: {\n          ...templatePagination,\n          [template]: { ...pagination, loading: false },\n        },\n      });\n    }\n  },\n\n  // Fetch sessions by topic (for drill-down)\n  fetchSessionsByTopic: async (topicId: string, loadMore = false) => {\n    const cache = getSessionCache();\n    const { topicPagination } = get();\n\n    // Check cache first (if not loading more)\n    if (!loadMore) {\n      const cached = cache.getTopicData(topicId);\n      if (cached) {\n        const index = getSessionIndex();\n        index.addSessions(cached.sessions);\n        return;\n      }\n    }\n\n    const pagination = topicPagination[topicId] || { cursor: null, hasMore: true, loading: false };\n    if (pagination.loading || (!loadMore && cache.hasTopicData(topicId))) return;\n\n    set({\n      topicPagination: {\n        ...topicPagination,\n        [topicId]: { ...pagination, loading: true },\n      },\n    });\n\n    try {\n      const cursor = loadMore ? pagination.cursor : null;\n      const url = cursor\n        ? `/api/sessions/by-topic/${topicId}?cursor=${cursor}&limit=50`\n        : `/api/sessions/by-topic/${topicId}?limit=50`;\n\n      const response = await fetch(url);\n\n      if (!response.ok) {\n        throw new Error(`HTTP ${response.status}: ${response.statusText}`);\n      }\n\n      const data = await response.json();\n\n      // Add to index\n      const index = getSessionIndex();\n      index.addSessions(data.sessions);\n\n      if (loadMore) {\n        cache.appendTopicData(topicId, data.sessions, data.nextCursor, data.hasMore);\n      } else {\n        cache.setTopicData(topicId, {\n          sessions: data.sessions,\n          cursor: data.nextCursor,\n          hasMore: data.hasMore,\n          totalCount: data.totalCount,\n          fetchedAt: Date.now(),\n        });\n      }\n\n      set({\n        topicPagination: {\n          ...topicPagination,\n          [topicId]: {\n            cursor: data.nextCursor,\n            hasMore: data.hasMore,\n            loading: false,\n          },\n        },\n      });\n    } catch (error) {\n      console.error(`Error fetching sessions for topic ${topicId}:`, error);\n      set({\n        topicPagination: {\n          ...topicPagination,\n          [topicId]: { ...pagination, loading: false },\n        },\n      });\n    }\n  },\n\n  // Search sessions using the index\n  searchSessions: (query: string): SessionSummary[] => {\n    const index = getSessionIndex();\n    return index.search(query, { limit: 50 });\n  },\n\n  // Invalidate all caches\n  invalidateCache: () => {\n    const cache = getSessionCache();\n    cache.clearAll();\n\n    const index = getSessionIndex();\n    index.clear();\n\n    set({\n      aggregates: null,\n      sessionsPagination: { cursor: null, hasMore: true, loading: false },\n      templatePagination: {},\n      topicPagination: {},\n    });\n  },\n\n  // Fetch all topics for intermediate categorization\n  fetchTopics: async () => {\n    set({ topicsLoading: true, topicsError: null });\n\n    try {\n      const response = await fetch('/api/topics');\n\n      if (!response.ok) {\n        throw new Error(`HTTP ${response.status}: ${response.statusText}`);\n      }\n\n      const data = await response.json();\n      const topics: TopicWithSessions[] = data.topics || [];\n\n      set({ topics, topicsLoading: false });\n    } catch (error) {\n      console.error('Error fetching topics:', error);\n      set({\n        topicsError: error instanceof Error ? error.message : 'Failed to fetch topics',\n        topicsLoading: false,\n        topics: [],\n      });\n    }\n  },\n\n  // Fetch a single session with full details via API route\n  fetchSession: async (id: string) => {\n    set({ currentSessionLoading: true, currentSessionError: null });\n\n    try {\n      const response = await fetch(`/api/sessions/${id}`);\n\n      if (!response.ok) {\n        if (response.status === 404) {\n          set({\n            currentSessionError: 'Session not found',\n            currentSessionLoading: false,\n          });\n          return;\n        }\n        throw new Error(`HTTP ${response.status}: ${response.statusText}`);\n      }\n\n      const session: SessionWithDetails = await response.json();\n      set({ currentSession: session, currentSessionLoading: false });\n    } catch (error) {\n      console.error('Error fetching session:', error);\n      set({\n        currentSessionError: error instanceof Error ? error.message : 'Failed to fetch session',\n        currentSessionLoading: false,\n      });\n    }\n  },\n\n  // Map navigation\n  setMapZoomPath: (path: string[]) => {\n    set({ mapZoomPath: path });\n  },\n\n  setMapSelectedNode: (nodeId: string | null) => {\n    set({ mapSelectedNode: nodeId });\n  },\n\n  // Report modal\n  openReportModal: async (sessionId: string) => {\n    set({ isReportModalOpen: true, currentSessionLoading: true });\n    await get().fetchSession(sessionId);\n  },\n\n  closeReportModal: () => {\n    set({ isReportModalOpen: false });\n  },\n\n  clearCurrentSession: () => {\n    set({\n      currentSession: null,\n      currentSessionError: null,\n      isReportModalOpen: false,\n    });\n  },\n}));\n\n// ============================================\n// DERIVED DATA HELPERS\n// ============================================\n\n// Group sessions by template type\nexport function groupSessionsByTemplate(sessions: ResearchSession[]): Record<string, ResearchSession[]> {\n  return sessions.reduce((acc, session) => {\n    const template = session.template_type || 'unknown';\n    if (!acc[template]) {\n      acc[template] = [];\n    }\n    acc[template].push(session);\n    return acc;\n  }, {} as Record<string, ResearchSession[]>);\n}\n\n// Get template display name\nexport function getTemplateDisplayName(template: string): string {\n  const displayNames: Record<string, string> = {\n    investigative: 'Investigative',\n    financial: 'Financial',\n    competitive: 'Competitive',\n    tech_market: 'Tech Market',\n    legal: 'Legal',\n    due_diligence: 'Due Diligence',\n    contract: 'Contract',\n    purchase_decision: 'Purchase Decision',\n    reputation: 'Reputation',\n    understanding: 'Understanding',\n  };\n  return displayNames[template] || template.replace(/_/g, ' ');\n}\n\n// Get template color\nexport function getTemplateColor(template: string): string {\n  const colors: Record<string, string> = {\n    investigative: '#E03131',\n    financial: '#228BE6',\n    competitive: '#7950F2',\n    tech_market: '#2F9E44',\n    legal: '#1864AB',\n    due_diligence: '#F59F00',\n    contract: '#862E9C',\n    purchase_decision: '#E8590C',\n    reputation: '#C2255C',\n    understanding: '#0B7285',\n  };\n  return colors[template] || '#8A8987';\n}\n\n// Extract topic from query (simple heuristic)\nexport function extractTopicFromQuery(query: string): string {\n  // Remove common research prefixes\n  const cleaned = query\n    .replace(/^(research|analyze|investigate|understand|compare)\\s+/i, '')\n    .replace(/\\s+(market|analysis|report|overview)$/i, '');\n\n  // Truncate to reasonable length\n  if (cleaned.length > 50) {\n    return cleaned.substring(0, 47) + '...';\n  }\n  return cleaned;\n}\n\n// Calculate statistics for sessions\nexport function calculateSessionStats(sessions: ResearchSession[]) {\n  const totalSessions = sessions.length;\n  const totalFindings = sessions.reduce((sum, s) => sum + (s.claim_count || 0), 0);\n  const totalSources = sessions.reduce((sum, s) => sum + (s.source_count || 0), 0);\n  const completedSessions = sessions.filter(s => s.status === 'completed').length;\n\n  const byTemplate = groupSessionsByTemplate(sessions);\n  const templateCounts = Object.entries(byTemplate).map(([template, items]) => ({\n    template,\n    count: items.length,\n    color: getTemplateColor(template),\n  }));\n\n  return {\n    totalSessions,\n    totalFindings,\n    totalSources,\n    completedSessions,\n    templateCounts,\n  };\n}\n\n// ============================================\n// TOPIC-BASED GROUPING HELPERS\n// ============================================\n\n// Group sessions by topic within a template\nexport function groupSessionsByTopic(\n  sessions: ResearchSession[],\n  topics: TopicWithSessions[]\n): Record<string, { topic: TopicWithSessions; sessions: ResearchSession[] }> {\n  const result: Record<string, { topic: TopicWithSessions; sessions: ResearchSession[] }> = {};\n\n  // Create a map of session_id to topic\n  const sessionToTopic = new Map<string, TopicWithSessions>();\n  topics.forEach(topic => {\n    topic.sessions?.forEach(s => {\n      sessionToTopic.set(s.id, topic);\n    });\n  });\n\n  // Group sessions\n  sessions.forEach(session => {\n    const topic = sessionToTopic.get(session.id);\n    if (topic) {\n      if (!result[topic.id]) {\n        result[topic.id] = { topic, sessions: [] };\n      }\n      result[topic.id].sessions.push(session);\n    }\n  });\n\n  return result;\n}\n\n// Get topics that belong to a specific template\nexport function getTopicsForTemplate(\n  template: string,\n  topics: TopicWithSessions[]\n): TopicWithSessions[] {\n  return topics.filter(topic =>\n    topic.sessions?.some(s => s.template_type === template)\n  );\n}\n\n// Get sessions without a topic (uncategorized)\nexport function getUncategorizedSessions(\n  sessions: ResearchSession[],\n  topics: TopicWithSessions[]\n): ResearchSession[] {\n  const categorizedIds = new Set<string>();\n  topics.forEach(topic => {\n    topic.sessions?.forEach(s => categorizedIds.add(s.id));\n  });\n\n  return sessions.filter(s => !categorizedIds.has(s.id));\n}\n\n// Get finding type counts for display\nexport function getFindingTypeIcon(type: string): string {\n  const icons: Record<string, string> = {\n    fact: 'check-circle',\n    claim: 'message-circle',\n    event: 'calendar',\n    actor: 'user',\n    relationship: 'link',\n    pattern: 'trending-up',\n    gap: 'alert-circle',\n    evidence: 'file-text',\n  };\n  return icons[type] || 'circle';\n}\n\nexport function getFindingTypeColor(type: string): string {\n  const colors: Record<string, string> = {\n    fact: '#2563EB',\n    claim: '#7C3AED',\n    event: '#059669',\n    actor: '#DC2626',\n    relationship: '#D97706',\n    pattern: '#0891B2',\n    gap: '#6B7280',\n    evidence: '#16A34A',\n  };\n  return colors[type] || '#6B7280';\n}\n","numLines":704,"startLine":1,"totalLines":704}}}
