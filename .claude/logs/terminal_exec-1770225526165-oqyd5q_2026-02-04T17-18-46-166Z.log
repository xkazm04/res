-1770224844221","structure-rules","scan-contexts","research-whistleblower-israeli-military-used-google-gemini--1770224848314","frontend-design:frontend-design","compact","context","cost","init","pr-comments","release-notes","review","security-review","insights"],"apiKeySource":"none","claude_code_version":"2.1.31","output_style":"default","agents":["Bash","general-purpose","statusline-setup","Explore","Plan","gsd-plan-checker","gsd-research-synthesizer","gsd-phase-researcher","gsd-integration-checker","gsd-executor","gsd-debugger","gsd-codebase-mapper","gsd-planner","gsd-project-researcher","gsd-roadmapper","gsd-verifier"],"skills":["keybindings-help","debug","frontend-design:frontend-design"],"plugins":[{"name":"frontend-design","path":"C:\\Users\\mkdol\\.claude\\plugins\\cache\\claude-plugins-official\\frontend-design\\27d2b86d72da"}],"uuid":"9fb4bf7b-e229-4363-b0d4-94672c249167"}
