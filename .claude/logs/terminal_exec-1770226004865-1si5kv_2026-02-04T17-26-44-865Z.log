n:frontend-design","compact","context","cost","init","pr-comments","release-notes","review","security-review","insights"],"apiKeySource":"none","claude_code_version":"2.1.31","output_style":"default","agents":["Bash","general-purpose","statusline-setup","Explore","Plan","gsd-verifier","gsd-roadmapper","gsd-research-synthesizer","gsd-project-researcher","gsd-planner","gsd-plan-checker","gsd-phase-researcher","gsd-integration-checker","gsd-executor","gsd-debugger","gsd-codebase-mapper"],"skills":["keybindings-help","debug","frontend-design:frontend-design"],"plugins":[{"name":"frontend-design","path":"C:\\Users\\mkdol\\.claude\\plugins\\cache\\claude-plugins-official\\frontend-design\\27d2b86d72da"}],"uuid":"66d51a27-13b3-47d4-9f2d-49c1ed5e1da5"}
