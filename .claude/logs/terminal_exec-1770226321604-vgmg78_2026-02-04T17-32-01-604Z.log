notes","review","security-review","insights"],"apiKeySource":"none","claude_code_version":"2.1.31","output_style":"default","agents":["Bash","general-purpose","statusline-setup","Explore","Plan","gsd-phase-researcher","gsd-integration-checker","gsd-executor","gsd-debugger","gsd-codebase-mapper","gsd-project-researcher","gsd-planner","gsd-plan-checker","gsd-roadmapper","gsd-research-synthesizer","gsd-verifier"],"skills":["keybindings-help","debug","frontend-design:frontend-design"],"plugins":[{"name":"frontend-design","path":"C:\\Users\\mkdol\\.claude\\plugins\\cache\\claude-plugins-official\\frontend-design\\27d2b86d72da"}],"uuid":"3d86f1ae-34cf-4223-9395-4055e9e2fbc0"}
