aude_code_version":"2.1.31","output_style":"default","agents":["Bash","general-purpose","statusline-setup","Explore","Plan","gsd-plan-checker","gsd-phase-researcher","gsd-integration-checker","gsd-executor","gsd-debugger","gsd-codebase-mapper","gsd-roadmapper","gsd-research-synthesizer","gsd-verifier","gsd-project-researcher","gsd-planner"],"skills":["keybindings-help","debug","frontend-design:frontend-design"],"plugins":[{"name":"frontend-design","path":"C:\\Users\\mkdol\\.claude\\plugins\\cache\\claude-plugins-official\\frontend-design\\27d2b86d72da"}],"uuid":"66f3b477-c633-4205-abb4-093443f059a5"}
